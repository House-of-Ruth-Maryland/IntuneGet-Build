# /etc/default/intuneget-deploy (copied from IntuneGet-Build deploy/systemd).
# Settings for intuneget-deploy and the cron timers. No secrets here: the cron
# secret lives in /etc/intuneget/cron-auth.header.

# Where the app listens on this VM (the published port in docker-compose.yml).
APP_URL=http://127.0.0.1:3000

# The image to deploy (required), for example <registry>.azurecr.io/intuneget.
# The VM signs in to Azure Container Registry with its managed identity (AcrPull).
IMAGE_REPO=

# Defaults, change only if the server layout changes:
# COMPOSE_DIR=/opt/intuneget
# ENV_FILE=/opt/intuneget/.env.local
# SERVICE=web
# DATA_DIR=/var/lib/docker/volumes/intuneget_intuneget-data/_data
# KEEP_BACKUPS=5
# HEALTH_TIMEOUT=300

# Nightly off-site backup (intuneget-backup): the Azure Storage container URL, for example
# https://<account>.blob.core.windows.net/<container>. Set on the VM only.
BACKUP_CONTAINER_URL=
