+  if(method!=='GET')calls.push({method,url,body:init?.body?JSON.parse(String(init.body)):undefined});
+  if(url.endsWith('/assign')){if(failAssign)return Response.json({error:{message:'Rejected'}},{status:400});groups=(JSON.parse(String(init?.body)).mobileAppAssignments);return new Response(null,{status:204});}
+  if(url.endsWith('/assignments'))return Response.json({value:groups});
+  if(url.endsWith('/relationships'))return Response.json({value:links});
+  if(url.endsWith('/updateRelationships'))return new Response(null,{status:204});
+  if(method==='DELETE')return new Response(null,{status:204});
+  return Response.json({id:APP,'@odata.type':'#microsoft.graph.win32LobApp',displayName:'Example',publisher:'Example Co',displayVersion:'1.0'});
+ }));
+});
+afterEach(()=>{closeSqliteDb();vi.unstubAllGlobals();});
+describe('retire an app',()=>{
+ it('requires sign-in',async()=>{state.auth=false;expect((await get()).status).toBe(401);expect((await post({action:'preview',appId:APP})).status).toBe(401);});
+ it('previews the groups now and after, and changes nothing',async()=>{
+  const {preview}=await (await post({action:'preview',appId:APP})).json();
+  expect(preview.groups[0]).toMatch(/Required/);expect(preview.after[0]).toMatch(/Uninstall/);expect(calls).toEqual([]);
+ });
+ it('requires confirmation and a fresh review',async()=>{
+  const {preview}=await (await post({action:'preview',appId:APP})).json();
+  expect((await post({action:'start',appId:APP,token:preview.token})).status).toBe(400);
+  groups=[...groups,{...required(),id:'a2',target:{'@odata.type':'#microsoft.graph.groupAssignmentTarget',groupId:OLDER}}];
+  expect((await post({action:'start',appId:APP,token:preview.token,confirmed:true})).status).toBe(409);
+  expect(calls).toEqual([]);expect(sqliteRetirements.latest('tenant',APP)).toBeNull();
+ });
+ it('changes the groups to Uninstall and holds every deployment of the app',async()=>{
+  expect((await start()).status).toBe(200);
+  expect(calls).toHaveLength(1);
+  expect((calls[0].body as {mobileAppAssignments:Array<{intent:string}>}).mobileAppAssignments.map((a)=>a.intent)).toEqual(['uninstall']);
+  expect(await pilotHold('tenant','Example.App')).toMatch(/being retired/);
+  await expect(sqliteDb.jobs.create({user_id:'staff',tenant_id:'tenant',winget_id:'Example.App',version:'2.0',display_name:'Example',installer_type:'exe',installer_url:'https://example.invalid/app.exe',package_config:{},status:'queued'})).rejects.toThrow(/being retired/);
+  const status=await (await get()).json();
+  expect(status.retirement).toMatchObject({phase:'uninstalling',startedBy:'staff@example.test'});
+  expect(status.counts).toMatchObject({installed:1});
