+const APP='11111111-1111-4111-8111-111111111111',G1='22222222-2222-4222-8222-222222222222',OLDER='44444444-4444-4444-8444-444444444444';
+let groups:Array<Record<string,unknown>>;let calls:Array<{method:string;url:string;body?:unknown}>;let report:unknown[][];let links:unknown[];let failAssign:boolean;
+const required=()=>({id:'a1',intent:'required',target:{'@odata.type':'#microsoft.graph.groupAssignmentTarget',groupId:G1},settings:{'@odata.type':'#microsoft.graph.win32LobAppAssignmentSettings',notifications:'showAll'}});
+const post=(body:unknown)=>POST(new NextRequest('http://localhost/api/hrm/retire',{method:'POST',body:JSON.stringify(body),headers:{Authorization:'Bearer fixture'}}));
+const get=()=>GET(new NextRequest(`http://localhost/api/hrm/retire?appId=${APP}`,{headers:{Authorization:'Bearer fixture'}}));
+async function start(){const {preview}=await (await post({action:'preview',appId:APP})).json();return post({action:'start',appId:APP,token:preview.token,confirmed:true});}
+beforeEach(async()=>{
+ closeSqliteDb();state.auth=true;groups=[required()];calls=[];report=[['Installed']];links=[{targetId:OLDER,targetType:'child'}];failAssign=false;
+ const job=await sqliteDb.jobs.create({user_id:'staff',tenant_id:'tenant',winget_id:'Example.App',version:'1.0',display_name:'Example',installer_type:'exe',installer_url:'https://example.invalid/app.exe',package_config:{},status:'queued'});
