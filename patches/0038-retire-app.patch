diff --git a/components/hrm/RetirePanel.tsx b/components/hrm/RetirePanel.tsx
new file mode 100644
index 000000000..c4da7e459
--- /dev/null
+++ b/components/hrm/RetirePanel.tsx
@@ -0,0 +1,151 @@
+'use client';
+// HRM patch 0038: retire an app. Change its groups to Uninstall, wait for devices to report it gone,
+// then delete it from Intune. Cancel retiring puts the saved groups back. Counts only, never devices.
+import { useState } from 'react';
+import { Archive } from 'lucide-react';
+import { Button } from '@/components/ui/button';
+import { Dialog, DialogContent, DialogHeader, DialogTitle, DialogDescription, DialogFooter } from '@/components/ui/dialog';
+import { useRetire } from '@/hooks/useRetire';
+import type { RetirePreview } from '@/lib/hrm/retire';
+
+export const RETIRE_LABELS = {
+  open: 'Retire app',
+  confirm: 'I understand this uninstalls the app from these groups',
+  start: 'Uninstall from these groups',
+  startEmpty: 'Start retiring',
+  keep: 'Keep it for now',
+  remove: 'Delete from Intune',
+  force: 'Delete even though devices still report it',
+  cancel: 'Cancel retiring',
+} as const;
+
+const when = (iso: string) => new Date(iso).toLocaleString('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' });
+
+export function RetirePanel({ appId, onDeleted }: { appId: string; onDeleted?: () => void }) {
+  const { data, action } = useRetire(appId);
+  const [open, setOpen] = useState(false);
+  const [review, setReview] = useState<RetirePreview | null>(null);
+  const [confirmed, setConfirmed] = useState(false);
+  const [force, setForce] = useState(false);
+  const [confirmDelete, setConfirmDelete] = useState(false);
+  if (!data?.supported) return null;
+  const retirement = data.retirement?.phase === 'uninstalling' ? data.retirement : null;
+
+  if (retirement) {
+    const c = data.counts;
+    const remaining = c ? c.installed + c.pending : null;
+    const ready = remaining === 0;
+    return (
+      <div className="rounded-lg border border-status-warning/30 bg-status-warning/5 p-3">
+        <h4 className="text-sm font-semibold text-text-primary mb-1">Retiring this app</h4>
+        <p className="text-sm text-text-secondary">
+          Since {when(retirement.startedAt)}, by {retirement.startedBy}. Its groups are set to Uninstall, and updates and deployments for it are held.
+        </p>
+        {c ? (
+          <p className="mt-2 text-sm text-text-secondary">
+            Intune reports: {c.installed} still installed · {c.pending} pending · {c.failed} failed · {c.notApplicable + c.other} other.
+            {ready ? ' Devices report it gone, so it can be deleted.' : ' Devices check in over the next hours; refresh to see the latest.'}
+          </p>
+        ) : (
+          <p className="mt-2 text-sm text-text-muted">Couldn&apos;t read the uninstall results from Intune just now.</p>
+        )}
+        {c && c.failed > 0 && <p className="mt-1 text-sm text-status-error">{c.failed === 1 ? '1 device' : `${c.failed} devices`} failed to uninstall. Check Install results above before deleting.</p>}
+        {action.error && <p role="alert" className="mt-2 text-sm text-status-error">{action.error.message}</p>}
+        {confirmDelete ? (
+          <div className="mt-3 space-y-2">
+            <p className="text-sm text-text-primary">Delete {retirement.displayName} v{retirement.version} from Intune? This can&apos;t be undone. Links from this app to apps it replaces or depends on are removed first.</p>
+            {!ready && (
+              <label className="flex items-start gap-2 text-sm text-text-primary">
+                <input type="checkbox" className="mt-1" checked={force} onChange={(e) => setForce(e.target.checked)} />
+                {RETIRE_LABELS.force}
+              </label>
+            )}
+            <div className="flex gap-2">
+              <Button size="sm" variant="destructive" disabled={action.isPending || (!ready && !force)}
+                onClick={() => action.mutate({ action: 'delete', id: retirement.id, force: !ready && force }, { onSuccess: () => onDeleted?.() })}>
+                {action.isPending ? 'Deleting…' : RETIRE_LABELS.remove}
+              </Button>
+              <Button size="sm" variant="ghost" disabled={action.isPending} onClick={() => { setConfirmDelete(false); setForce(false); }}>{RETIRE_LABELS.keep}</Button>
+            </div>
+          </div>
+        ) : (
+          <div className="mt-3 flex flex-wrap gap-2">
+            <Button size="sm" variant="outline" className="border-overlay/10" disabled={action.isPending} onClick={() => { action.reset(); setConfirmDelete(true); }}>{RETIRE_LABELS.remove}</Button>
+            <Button size="sm" variant="ghost" disabled={action.isPending} onClick={() => action.mutate({ action: 'cancel', id: retirement.id })}>
+              {action.isPending ? 'Putting groups back…' : RETIRE_LABELS.cancel}
+            </Button>
+          </div>
+        )}
+        <div className="mt-3 text-xs text-text-muted">
+          <p>Cancel retiring puts these groups back, so Required groups install it again:</p>
+          {retirement.savedGroups.length > 0
+            ? <ul className="mt-1 list-disc pl-5">{retirement.savedGroups.map((g) => <li key={g}>{g}</li>)}</ul>
+            : <p className="mt-1">No groups.</p>}
+        </div>
+      </div>
+    );
+  }
+
+  const openReview = () => {
+    action.reset(); setReview(null); setConfirmed(false); setOpen(true);
+    action.mutate({ action: 'preview' }, { onSuccess: (r) => setReview(r.preview ?? null) });
+  };
+
+  return (
+    <div>
+      <h4 className="text-sm font-semibold text-text-secondary mb-2">{RETIRE_LABELS.open}</h4>
+      <p className="text-sm text-text-secondary">When HRM stops using this app: uninstall it from its groups, then delete it from Intune once devices report it gone.</p>
+      {data.hold ? (
+        <p className="mt-2 text-sm text-status-warning">{data.hold}</p>
+      ) : (
+        <Button variant="outline" size="sm" className="mt-2 border-overlay/10" onClick={openReview}>
+          <Archive className="w-4 h-4 mr-2" />
+          {RETIRE_LABELS.open}
+        </Button>
+      )}
+      <Dialog open={open} onOpenChange={(value) => { if (!action.isPending) setOpen(value); }}>
+        <DialogContent className="max-w-lg">
+          <DialogHeader>
+            <DialogTitle>Retire {review?.displayName ?? 'this app'}</DialogTitle>
+            <DialogDescription>
+              Every group changes to Uninstall, so Intune removes the app from those devices and users. Updates and deployments for it are held until you delete it or cancel.
+            </DialogDescription>
+          </DialogHeader>
+          <div className="space-y-3 px-6 py-4">
+          {action.isPending && !review && <p role="status" className="text-sm text-text-muted">Reading the app and its groups in Intune…</p>}
+          {review && (
+            <div className="space-y-3 text-sm">
+              {review.groups.length === 0 ? (
+                <p className="text-text-secondary">This copy has no groups, so nothing is uninstalled. After you start, you can delete it from Intune.</p>
+              ) : (
+                <>
+                  <p className="text-text-secondary">Now:</p>
+                  <ul className="list-disc pl-5 text-text-primary">{review.groups.map((g) => <li key={g}>{g}</li>)}</ul>
+                  <p className="text-text-secondary">After:</p>
+                  <ul className="list-disc pl-5 text-text-primary">{review.after.map((g) => <li key={g}>{g}</li>)}</ul>
+                </>
+              )}
+              <p className="text-text-muted">Devices that got the app another way (installed by hand, or from another copy) also uninstall it if they are in these groups. Other copies of the app in Intune are not changed.</p>
+              {review.groups.length > 0 && (
+                <label className="flex items-start gap-2 text-text-primary">
+                  <input type="checkbox" className="mt-1" checked={confirmed} onChange={(e) => setConfirmed(e.target.checked)} />
+                  {RETIRE_LABELS.confirm}
+                </label>
+              )}
+            </div>
+          )}
+          {action.error && <p role="alert" className="text-sm text-status-error">{action.error.message}</p>}
+          </div>
+          {review && (
+            <DialogFooter>
+            <Button variant="destructive" disabled={(review.groups.length > 0 && !confirmed) || action.isPending}
+              onClick={() => action.mutate({ action: 'start', token: review.token, confirmed: true }, { onSuccess: () => setOpen(false) })}>
+              {action.isPending ? 'Changing groups…' : review.groups.length > 0 ? RETIRE_LABELS.start : RETIRE_LABELS.startEmpty}
+            </Button>
+            </DialogFooter>
+          )}
+        </DialogContent>
+      </Dialog>
+    </div>
+  );
+}
