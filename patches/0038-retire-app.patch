+ it('forgets the reservation when Intune refuses the Uninstall groups',async()=>{
+  failAssign=true;const response=await start();expect(response.status).toBe(424);expect((await response.json()).error).toMatch(/Nothing was changed. Intune said: Rejected/);
+  expect(sqliteRetirements.latest('tenant',APP)).toBeNull();expect(await pilotHold('tenant','Example.App')).toBeNull();
+ });
+ it('cancel puts the saved groups back, only when Intune still shows the Uninstall groups',async()=>{
+  await start();const id=(await (await get()).json()).retirement.id;
+  const uninstall=groups;groups=[];
+  expect((await post({action:'cancel',appId:APP,id})).status).toBe(409);
+  groups=uninstall;
+  expect((await post({action:'cancel',appId:APP,id})).status).toBe(200);
+  expect(groups.map((g)=>g.intent)).toEqual(['required']);
+  expect(sqliteRetirements.latest('tenant',APP)?.phase).toBe('cancelled');
+  expect(await pilotHold('tenant','Example.App')).toBeNull();
+ });
+ it('deletes only once devices report it gone (or when confirmed), clearing its own links first',async()=>{
+  await sqliteDb.updatePolicies.upsert({user_id:'staff',tenant_id:'tenant',winget_id:'Example.App',policy_type:'auto_update',is_enabled:true,updated_at:new Date().toISOString()});
+  await start();const id=(await (await get()).json()).retirement.id;calls=[];
+  const waiting=await post({action:'delete',appId:APP,id});
+  expect(waiting.status).toBe(409);expect((await waiting.json()).error).toMatch(/1 installed and 0 pending/);expect(calls).toEqual([]);
+  report=[['Not installed']];
+  expect((await post({action:'delete',appId:APP,id})).status).toBe(200);
+  expect(calls.map((c)=>c.method+' '+c.url.split('/').pop())).toEqual([`POST updateRelationships`,`DELETE ${APP}`]);
+  expect(sqliteRetirements.latest('tenant',APP)?.phase).toBe('deleted');
+  expect((await sqliteDb.updatePolicies.getByKey('staff','tenant','Example.App'))?.policy_type).toBe('ignore');
+ });
+ it('lets staff delete anyway with confirmation, but never when another app replaces it',async()=>{
+  await start();const id=(await (await get()).json()).retirement.id;
+  links=[{targetId:OLDER,targetType:'parent',targetDisplayName:'Example (newer copy)'}];
+  const refused=await post({action:'delete',appId:APP,id,force:true});
+  expect(refused.status).toBe(409);expect((await refused.json()).error).toMatch(/Example \(newer copy\) replaces or depends on this app/);
+  links=[];
+  expect((await post({action:'delete',appId:APP,id,force:true})).status).toBe(200);
+ });
+ it('refuses to retire an app in an active pilot',async()=>{
+  sqlitePilotRollouts.reserve({id:'pilot',tenant_id:'tenant',winget_id:'Example.App',display_name:'Example',group_id:G1,group_name:'Pilot',previous_app_id:APP,previous_version:'1.0',created_at:new Date().toISOString()});
+  expect((await (await get()).json()).hold).toMatch(/pilot/);
+  expect((await post({action:'preview',appId:APP})).status).toBe(409);
+ });
+});
diff --git a/app/api/hrm/retire/route.ts b/app/api/hrm/retire/route.ts
new file mode 100644
index 000000000..b34963aef
--- /dev/null
+++ b/app/api/hrm/retire/route.ts
@@ -0,0 +1,207 @@
+// HRM patch 0038: retire an app from Intune.
+//   GET  ?appId=  this copy's retirement (if any), live install counts while uninstalling, and anything that blocks starting
+//   POST { action: 'preview', appId }  read the copy and its groups from Intune; returns a review token
+//   POST { action: 'start', appId, token, confirmed: true }  change every group to Uninstall
+//   POST { action: 'cancel', appId, id }  put the saved groups back (only if Intune still shows the Uninstall groups)
+//   POST { action: 'delete', appId, id, force? }  delete the app from Intune once devices report it gone
+// Everything is checked against Intune again before a change. Failures use 409/424, because
+// Cloudflare replaces 502 with its own page. Messages carry app names and versions only.
+import { NextRequest, NextResponse } from 'next/server';
+import { parseAccessToken } from '@/lib/auth-utils';
+import { isSqliteMode } from '@/lib/db';
+import { getServicePrincipalToken } from '@/lib/intune/graph-client';
+import { GUID, summarizeAssignments } from '@/lib/hrm/app-insights';
+import { pilotGraph, PilotError } from '@/lib/hrm/pilot-graph';
+import type { GraphAssignment } from '@/lib/hrm/duplicates';
+import { retireToken, sameGroups, toUninstallAssignments, type RetirePreview, type RetireStatus } from '@/lib/hrm/retire';
+import type { Retirement } from '@/lib/hrm/retire-store';
+
+export const maxDuration = 120;
+const BETA = 'https://graph.microsoft.com/beta';
+const reply = (body: unknown, status = 200) => NextResponse.json(body, { status, headers: { 'Cache-Control': 'private, no-store' } });
+type User = NonNullable<Awaited<ReturnType<typeof parseAccessToken>>>;
+
+async function intuneReason(response: Response): Promise<string> {
+  const body = (await response.json().catch(() => null)) as { error?: { message?: string } } | null;
+  const message = body?.error?.message?.split('\n')[0]?.trim();
+  return message ? ` Intune said: ${message.slice(0, 200)}` : '';
+}
+
+async function connect(user: User) {
+  const token = await getServicePrincipalToken(user.tenantId);
+  if (!token) throw new PilotError("Couldn't reach Intune. Try again.", 424);
+  const graph = pilotGraph(token, fetch, 'Could not read this app from Intune completely. Nothing was changed.');
+  const call = (path: string, init: RequestInit) => fetch(`${BETA}${path}`, {
+    ...init, cache: 'no-store', signal: AbortSignal.timeout(30000),
+    headers: { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json' },
+  });
+  return {
+    ...graph,
+    async setGroups(appId: string, rows: GraphAssignment[]) {
+      const response = await call(`/deviceAppManagement/mobileApps/${appId}/assign`, { method: 'POST', body: JSON.stringify({ mobileAppAssignments: graph.input(rows) }) });
+      return response.ok ? null : await intuneReason(response);
+    },
+    async relationships(appId: string) {
+      const response = await call(`/deviceAppManagement/mobileApps/${appId}/relationships`, { method: 'GET' });
+      if (!response.ok) throw new PilotError("Couldn't read this app's links in Intune. Nothing was deleted.", 424);
+      const body = await response.json();
+      if (!Array.isArray(body.value) || body['@odata.nextLink']) throw new PilotError("Couldn't read this app's links in Intune. Nothing was deleted.", 424);
+      return body.value as Array<{ targetId: string; targetDisplayName?: string; targetType?: string }>;
+    },
+    async clearOwnLinks(appId: string) {
+      const response = await call(`/deviceAppManagement/mobileApps/${appId}/updateRelationships`, { method: 'POST', body: JSON.stringify({ relationships: [] }) });
+      return response.ok ? null : await intuneReason(response);
+    },
+    async remove(appId: string) {
+      const response = await call(`/deviceAppManagement/mobileApps/${appId}`, { method: 'DELETE' });
+      return response.ok ? null : await intuneReason(response);
+    },
+  };
+}
+
+async function stores() {
+  const { sqliteRetirements, sqlitePilotRollouts, sqliteAppInsights } = await import('@/lib/db/sqlite');
+  return { retire: sqliteRetirements, pilots: sqlitePilotRollouts, insights: sqliteAppInsights };
+}
+
+async function blockedStart(user: User, appId: string): Promise<string | null> {
+  const { retire, pilots, insights } = await stores();
+  if (retire.holdsApp(user.tenantId, appId)) return 'This app is already being retired.';
+  if (pilots.holdsApp(user.tenantId, appId)) return 'This app is part of an active pilot. Finish it in App updates first.';
+  const family = insights.family(user.tenantId, appId);
+  if (family && pilots.active(user.tenantId, family)) return 'A pilot is active for this app. Finish it in App updates first.';
+  return null;
+}
+
+/** Record a change IntuneGet made, so it isn't flagged as an unexplained group change. Optional. */
+async function note(user: User, appId: string, name: string, version: string, rows: GraphAssignment[], actor: string, exists = true) {
+  try {
+    const { insights } = await stores();
+    const family = insights.family(user.tenantId, appId);
+    if (!family) return;
+    insights.observe(user.tenantId, { appId, wingetId: family, displayName: name, version, exists, assignments: summarizeAssignments(rows), checkedAt: new Date().toISOString() }, actor, true);
+  } catch { /* Activity is optional; the checked Intune change stands. */ }
+}
+
+const view = (r: Retirement): RetireStatus['retirement'] => ({
+  id: r.id, phase: r.phase, displayName: r.display_name, version: r.version, startedBy: r.started_by, startedAt: r.started_at,
+  finishedAt: r.finished_at, savedGroups: summarizeAssignments(r.saved_assignments).map((a) => a.label),
+});
+
+async function preview(user: User, appId: string): Promise<RetirePreview & { rows: GraphAssignment[] }> {
+  const hold = await blockedStart(user, appId);
+  if (hold) throw new PilotError(hold);
+  const graph = await connect(user);
+  const [app, rows] = await Promise.all([graph.app(appId), graph.assignments(appId)]);
+  return {
+    token: retireToken(app.id, app.displayVersion ?? '', rows),
+    appId: app.id, displayName: app.displayName, version: app.displayVersion ?? '',
+    groups: summarizeAssignments(rows).map((a) => a.label),
+    after: summarizeAssignments(toUninstallAssignments(rows)).map((a) => a.label),
+    checkedAt: new Date().toISOString(),
+    rows,
+  };
+}
+
+export async function GET(request: NextRequest) {
+  const user = await parseAccessToken(request.headers.get('Authorization'));
+  if (!user) return reply({ error: 'Authentication required' }, 401);
+  if (!isSqliteMode()) return reply({ supported: false, retirement: null } satisfies RetireStatus);
+  const appId = new URL(request.url).searchParams.get('appId') ?? '';
+  if (!GUID.test(appId)) return reply({ error: 'Invalid app' }, 400);
+  const { retire } = await stores();
+  const latest = retire.latest(user.tenantId, appId);
+  let counts: RetireStatus['counts'] = null;
+  if (latest?.phase === 'uninstalling') {
+    try {
+      const { topErrors: _errors, ...rest } = await (await connect(user)).counts(appId);
+      void _errors;
+      counts = rest;
+    } catch { counts = null; }
+  }
+  return reply({ supported: true, retirement: latest ? view(latest) : null, counts, hold: latest?.phase === 'uninstalling' ? null : await blockedStart(user, appId) } satisfies RetireStatus);
+}
+
+export async function POST(request: NextRequest) {
+  const user = await parseAccessToken(request.headers.get('Authorization'));
+  if (!user) return reply({ error: 'Authentication required' }, 401);
+  if (!isSqliteMode()) return reply({ error: 'Retiring an app needs this server’s SQLite mode.' }, 409);
+  const body = (await request.json().catch(() => null)) as Record<string, unknown> | null;
+  const appId = typeof body?.appId === 'string' ? body.appId : '';
+  if (!body || !['preview', 'start', 'cancel', 'delete'].includes(String(body.action)) || !GUID.test(appId)) return reply({ error: 'Invalid request' }, 400);
+  const actor = user.userEmail || 'a staff member';
+  try {
+    if (body.action === 'preview') {
+      const { rows: _rows, ...shown } = await preview(user, appId);
+      void _rows;
+      return reply({ preview: shown });
+    }
+
+    const { retire, insights } = await stores();
+
+    if (body.action === 'start') {
+      if (body.confirmed !== true || typeof body.token !== 'string' || !/^[a-f0-9]{64}$/.test(body.token)) throw new PilotError('Review the groups and confirm first.', 400);
+      const checked = await preview(user, appId);
+      if (checked.token !== body.token) throw new PilotError('The app or its groups changed after your review. Review again before retiring it.');
+      const uninstall = toUninstallAssignments(checked.rows);
+      const id = crypto.randomUUID();
+      try {
+        retire.reserve({ id, tenant_id: user.tenantId, app_id: checked.appId, winget_id: insights.family(user.tenantId, checked.appId), display_name: checked.displayName,
+          version: checked.version, saved_assignments: checked.rows, uninstall_assignments: uninstall, started_by: actor, started_at: new Date().toISOString() });
+      } catch (error) {
+        throw new PilotError(error instanceof Error && /still running/.test(error.message) ? 'A deployment for this app is still running. Check Deployments.' : 'This app is already being retired.');
+      }
+      const graph = await connect(user);
+      const refused = uninstall.length > 0 ? await graph.setGroups(checked.appId, uninstall) : null;
+      if (refused !== null) {
+        retire.release(user.tenantId, id);
+        throw new PilotError(`Intune didn't accept the Uninstall groups. Nothing was changed.${refused}`, 424);
+      }
+      retire.started(user.tenantId, id);
+      await note(user, checked.appId, checked.displayName, checked.version, uninstall, `Retirement started by ${actor}: groups changed to Uninstall`);
+      console.log(JSON.stringify({ route: '/api/hrm/retire', action: 'start', app: checked.appId, groups: uninstall.length }));
+      return reply({ started: true, id });
+    }
+
+    const row = retire.active(user.tenantId, appId);
+    if (!row || row.id !== body.id || row.phase !== 'uninstalling') throw new PilotError('This retirement is no longer open. Refresh the app.');
+    const graph = await connect(user);
+    const [app, live] = await Promise.all([graph.app(row.app_id), graph.assignments(row.app_id)]);
+
+    if (body.action === 'cancel') {
+      if (!sameGroups(live, row.uninstall_assignments)) throw new PilotError("The app's groups changed in Intune since retiring started, so they weren't put back. Set them in Intune, then cancel again.");
+      const refused = await graph.setGroups(row.app_id, row.saved_assignments);
+      if (refused !== null) throw new PilotError(`Intune didn't accept the saved groups. The app still has its Uninstall groups.${refused}`, 424);
+      retire.finish(user.tenantId, row.id, 'cancelled', actor);
+      await note(user, row.app_id, app.displayName, app.displayVersion ?? '', row.saved_assignments, `Retirement cancelled by ${actor}: groups put back`);
+      return reply({ cancelled: true });
+    }
+
+    // delete
+    const counts = await graph.counts(row.app_id);
+    const remaining = counts.installed + counts.pending;
+    if (remaining > 0 && body.force !== true) {
+      throw new PilotError(`${counts.installed} installed and ${counts.pending} pending devices still report this app. Wait for them, or confirm deleting anyway.`);
+    }
+    const links = await graph.relationships(row.app_id);
+    const parents = links.filter((r) => r.targetType === 'parent');
+    if (parents.length > 0) {
+      const names = [...new Set(parents.map((r) => r.targetDisplayName || 'another app'))].join(', ');
+      throw new PilotError(`${names} replaces or depends on this app, so Intune won't delete it. Remove that link in Intune first. Nothing was deleted.`);
+    }
+    if (links.some((r) => r.targetType === 'child')) {
+      const refused = await graph.clearOwnLinks(row.app_id);
+      if (refused !== null) throw new PilotError(`Intune didn't remove this app's links. Nothing was deleted.${refused}`, 424);
+    }
+    const refused = await graph.remove(row.app_id);
+    if (refused !== null) throw new PilotError(`Intune didn't delete it.${refused}`, 424);
+    retire.finish(user.tenantId, row.id, 'deleted', actor);
+    if (row.winget_id) retire.ignoreUpdates(user.tenantId, row.winget_id);
+    await note(user, row.app_id, app.displayName, app.displayVersion ?? '', [], `Retired and deleted from Intune by ${actor}`, false);
+    console.log(JSON.stringify({ route: '/api/hrm/retire', action: 'delete', app: row.app_id, remaining }));
+    return reply({ deleted: true });
+  } catch (error) {
+    if (error instanceof PilotError) return reply({ error: error.message }, error.status);
+    return reply({ error: 'Could not complete the retirement step. Refresh the app and try again.' }, 409);
+  }
+}
