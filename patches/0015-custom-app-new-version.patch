index 000000000..3dff265dd
--- /dev/null
+++ b/app/api/hrm/new-version/route.test.ts
@@ -0,0 +1,42 @@
+import { NextRequest } from 'next/server';
+import { beforeEach, describe, expect, it, vi } from 'vitest';
+const mocks = vi.hoisted(() => ({ auth: vi.fn(), job: vi.fn() }));
+vi.mock('@/lib/auth-utils', () => ({ parseAccessToken: mocks.auth }));
+vi.mock('@/lib/db', () => ({ getDatabase: () => ({ jobs: { getById: mocks.job } }) }));
+import { GET } from './route';
+
+const JOB_ID = '46f79300-d116-40c4-9650-a288efb35f42';
+const request = (jobId = JOB_ID) => new NextRequest(`http://localhost/api/hrm/new-version?jobId=${jobId}`);
+const job = (over = {}) => ({ id: JOB_ID, tenant_id: 'tenant-1', status: 'deployed', winget_id: 'Custom.ContosoLtd.ContosoEditor',
+  display_name: 'Contoso Editor', version: '1.2.0', installer_type: 'msi', intune_app_id: 'intune-app-1', package_config: {}, ...over });
+
+beforeEach(() => {
+  vi.clearAllMocks();
+  mocks.auth.mockResolvedValue({ userId: 'user-1', tenantId: 'tenant-1' });
+  mocks.job.mockResolvedValue(job());
+});
+
+describe('new-version route', () => {
+  it('requires sign-in and a valid job id', async () => {
+    mocks.auth.mockResolvedValue(null);
+    expect((await GET(request())).status).toBe(401);
+    mocks.auth.mockResolvedValue({ userId: 'user-1', tenantId: 'tenant-1' });
+    expect((await GET(request('not-a-job'))).status).toBe(400);
+  });
+
+  it("returns this tenant's deployed custom app and is never cached", async () => {
+    const response = await GET(request());
+    expect(response.status).toBe(200);
+    expect(response.headers.get('cache-control')).toBe('private, no-store');
+    expect(await response.json()).toMatchObject({ jobId: JOB_ID, previousVersion: '1.2.0' });
+  });
+
+  it.each([
+    ['another tenant', { tenant_id: 'tenant-2' }],
+    ['a WinGet app', { winget_id: 'Google.Chrome' }],
+    ['a job that never deployed', { status: 'failed' }],
+  ])('treats %s as not found', async (_label, over) => {
+    mocks.job.mockResolvedValue(job(over));
+    expect((await GET(request())).status).toBe(404);
+  });
+});
diff --git a/app/api/hrm/new-version/route.ts b/app/api/hrm/new-version/route.ts
new file mode 100644
index 000000000..ca83c1890
--- /dev/null
+++ b/app/api/hrm/new-version/route.ts
@@ -0,0 +1,21 @@
+// HRM patch 0015: settings for the next version of a custom app, from the job that deployed it.
+
+import { NextRequest, NextResponse } from 'next/server';
+import { getDatabase } from '@/lib/db';
+import { parseAccessToken } from '@/lib/auth-utils';
+import { isCustomAppId, newVersionPrefill } from '@/lib/hrm/new-version';
+
+export async function GET(request: NextRequest) {
+  const user = await parseAccessToken(request.headers.get('Authorization'));
+  if (!user) return NextResponse.json({ error: 'Authentication required' }, { status: 401 });
+
+  const jobId = new URL(request.url).searchParams.get('jobId') ?? '';
+  if (!/^[0-9a-f-]{36}$/i.test(jobId)) return NextResponse.json({ error: 'Invalid job' }, { status: 400 });
+
+  const job = await getDatabase().jobs.getById(jobId);
+  // Only this tenant's deployed custom apps; anything else looks like "not found".
+  if (!job || job.tenant_id !== user.tenantId || job.status !== 'deployed' || !isCustomAppId(job.winget_id)) {
+    return NextResponse.json({ error: 'Not a custom app deployed from IntuneGet' }, { status: 404 });
+  }
+  return NextResponse.json(newVersionPrefill(job), { headers: { 'Cache-Control': 'private, no-store' } });
+}
