diff --git a/lib/hrm/new-version.ts b/lib/hrm/new-version.ts
new file mode 100644
index 000000000..f0ad3f0a5
--- /dev/null
+++ b/lib/hrm/new-version.ts
@@ -0,0 +1,81 @@
+/**
+ * HRM patch 0015: deploying a new version of a custom app.
+ *
+ * A custom app (an installer that isn't in WinGet) has no catalog entry to
+ * update from. Its last IntuneGet deployment has everything a new version
+ * needs except the version and download link: the installer settings, the
+ * groups, and the Intune app the new version should supersede.
+ */
+
+import type { PackagingJob } from '@/lib/db/types';
+import type { CustomAppInput, CustomInstallerType } from '@/lib/custom-app';
+import type { PackageAssignment } from '@/types/upload';
+import type { AppRelationship } from '@/types/intune';
+import { compareVersions } from '@/lib/version-compare';
+
+export interface NewVersionPrefill {
+  jobId: string;
+  previousVersion: string;
+  input: Omit<CustomAppInput, 'version' | 'installerUrl' | 'sha256'>;
+  assignments: PackageAssignment[];
+  supersede: AppRelationship | null;
+}
+
+const INSTALLER_TYPES: CustomInstallerType[] = ['exe', 'msi', 'inno', 'nullsoft', 'burn'];
+
+export function isCustomAppId(wingetId: string | null | undefined): boolean {
+  return /^Custom\./.test(wingetId ?? '');
+}
+
+/** The IntuneGet job an Intune app was deployed by, from the app's notes. */
+export function jobIdFromNotes(notes: string | null | undefined): string | null {
+  return /IntuneGet deployment job:\s*([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})/i.exec(notes ?? '')?.[1] ?? null;
+}
+
+/** The switches after the installer itself: `msiexec /i "x.msi" /qn` -> `/qn`, `"setup.exe" /S` -> `/S`. */
+export function switchesFromInstallCommand(command: string | null | undefined): string {
+  const text = (command ?? '').trim();
+  const msi = /^msiexec(?:\.exe)?\s+\/i\s+(?:"[^"]*"|\S+)\s*(.*)$/i.exec(text);
+  if (msi) return msi[1].trim();
+  const exe = /^(?:"[^"]*"|\S+)\s*(.*)$/.exec(text);
+  return exe ? exe[1].trim() : '';
+}
+
+/** IntuneGet's generated uninstall commands are left out so they are generated again for the new installer. */
+function customUninstall(command: string | null | undefined): string {
+  const text = (command ?? '').trim();
+  if (!text || /^REGISTRY_UNINSTALL:/i.test(text) || /^msiexec(?:\.exe)?\s+\/x\b/i.test(text)) return '';
+  return text;
+}
+
+export function newVersionPrefill(job: PackagingJob): NewVersionPrefill {
+  const config = (job.package_config ?? {}) as Record<string, unknown>;
+  const type = (job.installer_type ?? 'exe') as CustomInstallerType;
+  const assignments = Array.isArray(config.assignments) ? (config.assignments as PackageAssignment[]) : [];
+  return {
+    jobId: job.id,
+    previousVersion: job.version,
+    input: {
+      displayName: job.display_name,
+      publisher: job.publisher || '',
+      installerType: INSTALLER_TYPES.includes(type) ? type : 'exe',
+      architecture: (job.architecture || 'x64') as CustomAppInput['architecture'],
+      installScope: job.install_scope === 'user' ? 'user' : 'machine',
+      silentSwitches: switchesFromInstallCommand(job.install_command),
+      uninstallCommand: customUninstall(job.uninstall_command),
+      description: typeof config.description === 'string' ? config.description : '',
+      iconUrl: typeof config.iconPath === 'string' ? config.iconPath : '',
+    },
+    assignments,
+    supersede: job.intune_app_id
+      ? { relationshipType: 'supersedence', supersedenceType: 'update', targetId: job.intune_app_id,
+          targetDisplayName: job.display_name, targetVersion: job.version }
+      : null,
+  };
+}
+
+/** Whether a "duplicate" is really a newer version of the app already in Intune. */
+export function isNewerVersion(existingVersion: string | null | undefined, version: string | null | undefined): boolean {
+  if (!existingVersion || !version) return false;
+  return compareVersions(version, existingVersion) > 0;
+}
