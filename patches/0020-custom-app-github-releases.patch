+  async get(tenantId, intuneAppId) {
+    const row = getDb().prepare('SELECT * FROM hrm_custom_releases WHERE tenant_id = ? AND intune_app_id = ?').get(tenantId, intuneAppId);
+    return (row as CustomRelease | undefined) ?? null;
