+
+// HRM patch 0020: custom apps installed from a GitHub release
+describe('custom app GitHub releases', () => {
+  const OLD = 'https://github.com/example-org/example-app/releases/download/v1.0.0/example-app-1.0.0.msi';
+  const NEW = 'https://github.com/example-org/example-app/releases/download/v1.1.0/example-app-1.1.0.msi';
+  const githubFetch = (tag: string) =>
+    vi.fn(async () => Response.json({
+      tag_name: tag,
+      html_url: `https://github.com/example-org/example-app/releases/tag/${tag}`,
+      assets: [{ name: `example-app-${tag.slice(1)}.msi`, browser_download_url: tag === 'v1.1.0' ? NEW : OLD }],
+    })) as unknown as typeof fetch;
+
+  async function seedCustom(db: Awaited<ReturnType<typeof load>>['db']) {
+    const job = await db.jobs.create({ user_id: 'u1', tenant_id: 't1', winget_id: 'Custom.ExampleOrg.ExampleApp', version: '1.0.0',
+      display_name: 'Example App', installer_type: 'msi', installer_url: OLD, installer_sha256: 'A'.repeat(64), status: 'queued' });
+    await db.uploadHistory.create({ id: 'custom-history', user_id: 'u1', winget_id: 'Custom.ExampleOrg.ExampleApp', version: '1.0.0',
+      display_name: 'Example App', intune_app_id: 'custom-app-1', intune_tenant_id: 't1', packaging_job_id: job.id });
+    return job;
+  }
+
+  it('lists a newer release as an update and remembers it for the custom app form', async () => {
+    const { db, runSqliteUpdateCheck } = await load();
+    const { sqliteCustomReleases } = await import('@/lib/db/sqlite');
+    const job = await seedCustom(db);
+    getAppsByWingetIdsMock.mockResolvedValue([]);
+    const summary = await runSqliteUpdateCheck(db, { customReleases: { store: sqliteCustomReleases, fetchImpl: githubFetch('v1.1.0') } });
+    expect(summary.available).toBe(1);
+    expect(await db.updateCheckResults.list('u1', { includeDismissed: true })).toMatchObject([
+      { winget_id: 'Custom.ExampleOrg.ExampleApp', current_version: '1.0.0', latest_version: '1.1.0' },
+    ]);
+    expect(await sqliteCustomReleases.get('t1', 'custom-app-1')).toMatchObject({ job_id: job.id, version: '1.1.0', installer_url: NEW });
+    expect(getLatestInstallerInfoMock).not.toHaveBeenCalled();
+  });
+
+  it('clears the update once the release is no longer newer, and keeps it when the release check is not run', async () => {
+    const { db, runSqliteUpdateCheck } = await load();
+    const { sqliteCustomReleases } = await import('@/lib/db/sqlite');
+    await seedCustom(db);
+    getAppsByWingetIdsMock.mockResolvedValue([]);
+    await runSqliteUpdateCheck(db, { customReleases: { store: sqliteCustomReleases, fetchImpl: githubFetch('v1.1.0') } });
+    await runSqliteUpdateCheck(db);
+    expect(await db.updateCheckResults.list('u1', { includeDismissed: true })).toHaveLength(1);
+    await runSqliteUpdateCheck(db, { customReleases: { store: sqliteCustomReleases, fetchImpl: githubFetch('v1.0.0') } });
+    expect(await db.updateCheckResults.list('u1', { includeDismissed: true })).toHaveLength(0);
+    expect(await sqliteCustomReleases.get('t1', 'custom-app-1')).toBeNull();
+  });
+});
