+import { expectedAssetNames, findCustomAppReleases, parseGithubReleaseUrl, versionFromTag } from '../github-releases';
+
+const OLD_URL = 'https://github.com/example-org/example-app/releases/download/v0.15.0/example-app-0.15.0-windows-x64.msi';
+const NEW_URL = 'https://github.com/example-org/example-app/releases/download/v0.16.0/example-app-0.16.0-windows-x64.msi';
+const DIGEST = 'a'.repeat(64);
+
+const job = (overrides: Partial<PackagingJob> = {}) =>
+  ({ id: '11111111-1111-1111-1111-111111111111', installer_url: OLD_URL, ...overrides }) as PackagingJob;
+
+function deployment(overrides: Partial<UploadHistoryRecord> = {}): UploadHistoryRecord {
+  return {
+    id: 'h1', packaging_job_id: '11111111-1111-1111-1111-111111111111', user_id: 'user-one', winget_id: 'Custom.ExampleOrg.ExampleApp',
+    version: '0.15.0', display_name: 'Example App', publisher: 'Example Org', intune_app_id: '00000000-0000-0000-0000-00000000000a',
+    intune_app_url: null, intune_tenant_id: 'tenant-one', app_source: 'custom', deployed_at: '2026-10-01T00:00:00Z', ...overrides,
+  };
+}
+
+function github(release: Record<string, unknown> | null, status = 200) {
+  return vi.fn(async () => (release ? Response.json(release, { status }) : new Response('', { status: 404 }))) as unknown as typeof fetch;
+}
+
+const latest = {
+  tag_name: 'v0.16.0',
+  html_url: 'https://github.com/example-org/example-app/releases/tag/v0.16.0',
+  assets: [
+    { name: 'example-app-0.16.0-windows-x64.msi', browser_download_url: NEW_URL, digest: `sha256:${DIGEST}` },
+    { name: 'example-app-0.16.0-macos.dmg', browser_download_url: 'https://github.com/example-org/example-app/releases/download/v0.16.0/example-app-0.16.0-macos.dmg' },
+  ],
+};
+
+describe('GitHub release links', () => {
+  it('reads owner, repository, tag and file from a release download link', () => {
+    expect(parseGithubReleaseUrl(OLD_URL)).toEqual({ owner: 'example-org', repo: 'example-app', tag: 'v0.15.0', file: 'example-app-0.15.0-windows-x64.msi' });
+  });
+
+  it.each([
+    'http://github.com/example-org/example-app/releases/download/v1/x.msi',
+    'https://github.example.test/example-org/example-app/releases/download/v1/x.msi',
+    'https://github.com/example-org/example-app/archive/v1.zip',
+    'https://downloads.example.test/x.msi',
+    null,
+  ])('ignores %s', (url) => expect(parseGithubReleaseUrl(url)).toBeNull());
+
+  it('works out the new file name from the old one', () => {
+    const source = parseGithubReleaseUrl(OLD_URL)!;
+    expect(expectedAssetNames(source, '0.15.0', 'v0.16.0')).toContain('example-app-0.16.0-windows-x64.msi');
+    expect(versionFromTag('v2.1')).toBe('2.1');
+    expect(versionFromTag('release-2')).toBe('release-2');
+  });
+});
+
+describe('finding new releases of custom apps', () => {
+  it('finds a newer release with the matching file and its SHA-256', async () => {
+    const found = await findCustomAppReleases([deployment()], async () => job(), { fetchImpl: github(latest), now: new Date('2026-11-02T08:30:00Z') });
+    expect(found).toHaveLength(1);
+    expect(found[0].release).toMatchObject({
