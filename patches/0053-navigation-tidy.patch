+// HRM patch 0053: the sidebar's groups. Routes are unchanged; only the grouping and order are HRM's.
+// Home on its own, then the pages grouped by job. Items not listed here (none
+// today) are dropped rather than shown in a random place.
+export const HRM_NAV_LAYOUT: { label?: string; hrefs: string[] }[] = [
+  { hrefs: ['/dashboard'] },
+  { label: 'Apps', hrefs: ['/dashboard/apps', '/dashboard/inventory', '/dashboard/unmanaged'] },
+  { label: 'Updates', hrefs: ['/dashboard/updates'] },
+  { label: 'Activity', hrefs: ['/dashboard/uploads', '/dashboard/reports'] },
+  { label: 'Support', hrefs: ['/dashboard/help'] },
+];
+
+export function hrmNavGroups<T extends { href: string }>(items: T[], support: T[]): { label?: string; items: T[] }[] {
+  const byHref = new Map([...items, ...support].map((item) => [item.href, item]));
+  return HRM_NAV_LAYOUT
+    .map((group) => ({ label: group.label, items: group.hrefs.flatMap((href) => byHref.get(href) ?? []) }))
+    .filter((group) => group.items.length > 0);
+}
+
+// Press G, then the key, to open a page. Listed in sidebar order; upstream's D, A, U, I, R and S
+// keep their meaning, and P (App updates; U was taken), V (Discovered apps) and H (Help) are added.
+export const GO_TO_SHORTCUTS: { key: string; href: string; name: string }[] = [
+  { key: 'd', href: '/dashboard', name: 'Home' },
+  { key: 'a', href: '/dashboard/apps', name: 'App catalog' },
+  { key: 'i', href: '/dashboard/inventory', name: 'Inventory' },
+  { key: 'v', href: '/dashboard/unmanaged', name: 'Discovered apps' },
+  { key: 'p', href: '/dashboard/updates', name: 'App updates' },
+  { key: 'u', href: '/dashboard/uploads', name: 'Deployments' },
+  { key: 'r', href: '/dashboard/reports', name: 'Reports' },
+  { key: 's', href: '/dashboard/settings', name: 'Settings' },
+  { key: 'h', href: '/dashboard/help', name: 'Help' },
+];
+
+export function goToShortcutHref(key: string): string | null {
+  return GO_TO_SHORTCUTS.find((shortcut) => shortcut.key === key.toLowerCase())?.href ?? null;
+}
