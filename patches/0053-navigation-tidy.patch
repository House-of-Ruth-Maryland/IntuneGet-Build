diff --git a/lib/hrm/__tests__/navigation.test.ts b/lib/hrm/__tests__/navigation.test.ts
new file mode 100644
index 000000000..2a6a9e74c
--- /dev/null
+++ b/lib/hrm/__tests__/navigation.test.ts
@@ -0,0 +1,84 @@
+// @vitest-environment happy-dom
+import { act, createElement } from 'react';
+import { createRoot, type Root } from 'react-dom/client';
+import { afterEach, describe, expect, it, vi } from 'vitest';
+import { GO_TO_SHORTCUTS, goToShortcutHref, hrmNavGroups, HRM_NAV_LAYOUT } from '../navigation';
+
+const push = vi.hoisted(() => vi.fn());
+vi.mock('next/navigation', () => ({ useRouter: () => ({ push }) }));
+
+import { SHORTCUT_HINTS, useKeyboardShortcuts } from '@/hooks/useKeyboardShortcuts';
+
+// HRM patch 0053: sidebar groups by job, and G shortcuts for the pages HRM uses most.
+const item = (href: string) => ({ href, name: href });
+const SIDEBAR_ITEMS = ['/dashboard', '/dashboard/apps', '/dashboard/uploads', '/dashboard/unmanaged', '/dashboard/inventory', '/dashboard/updates', '/dashboard/reports'].map(item);
+
+describe('sidebar groups', () => {
+  it('groups the same pages as Apps, Updates, Activity and Support', () => {
+    const groups = hrmNavGroups(SIDEBAR_ITEMS, [item('/dashboard/help')]);
+    expect(groups.map((g) => [g.label ?? null, g.items.map((i) => i.href)])).toEqual([
+      [null, ['/dashboard']],
+      ['Apps', ['/dashboard/apps', '/dashboard/inventory', '/dashboard/unmanaged']],
+      ['Updates', ['/dashboard/updates']],
+      ['Activity', ['/dashboard/uploads', '/dashboard/reports']],
+      ['Support', ['/dashboard/help']],
+    ]);
+  });
+
+  it('keeps every page exactly once and drops empty groups', () => {
+    const hrefs = HRM_NAV_LAYOUT.flatMap((g) => g.hrefs);
+    expect(new Set(hrefs).size).toBe(hrefs.length);
+    expect(hrmNavGroups([item('/dashboard')], []).map((g) => g.label ?? null)).toEqual([null]);
+  });
+
+  it('never shows hidden pages it was not given', () => {
+    const groups = hrmNavGroups(SIDEBAR_ITEMS.filter((i) => i.href !== '/dashboard/reports'), []);
+    expect(groups.find((g) => g.label === 'Activity')?.items.map((i) => i.href)).toEqual(['/dashboard/uploads']);
+  });
+});
+
+describe('G shortcuts', () => {
+  it('keeps upstream keys and adds App updates, Discovered apps and Help', () => {
+    expect(goToShortcutHref('d')).toBe('/dashboard');
+    expect(goToShortcutHref('u')).toBe('/dashboard/uploads');
+    expect(goToShortcutHref('p')).toBe('/dashboard/updates');
+    expect(goToShortcutHref('v')).toBe('/dashboard/unmanaged');
+    expect(goToShortcutHref('h')).toBe('/dashboard/help');
+    expect(goToShortcutHref('x')).toBeNull();
+    expect(new Set(GO_TO_SHORTCUTS.map((s) => s.key)).size).toBe(GO_TO_SHORTCUTS.length);
+  });
+
+  it('lists every G shortcut in the Keyboard shortcuts hints, without cart wording', () => {
+    const descriptions = SHORTCUT_HINTS.map((h) => h.description);
+    expect(descriptions).toEqual(expect.arrayContaining(['Go to App updates', 'Go to Discovered apps', 'Go to Help']));
+    expect(SHORTCUT_HINTS.find((h) => h.description === 'Go to App updates')?.keys).toEqual(['G', 'P']);
+    expect(descriptions.join(' ')).not.toMatch(/cart/i);
+  });
+
+  describe('in the page', () => {
+    let root: Root | undefined;
+    afterEach(async () => { await act(async () => root?.unmount()); document.body.innerHTML = ''; push.mockReset(); });
+
+    async function mount() {
+      (globalThis as { IS_REACT_ACT_ENVIRONMENT?: boolean }).IS_REACT_ACT_ENVIRONMENT = true;
+      function Probe() { useKeyboardShortcuts({ onCommandPalette: vi.fn(), onToggleCart: vi.fn() }); return null; }
+      const container = document.createElement('div'); document.body.append(container);
+      root = createRoot(container);
+      await act(async () => root!.render(createElement(Probe)));
+    }
+    const press = (key: string) => document.dispatchEvent(new KeyboardEvent('keydown', { key, bubbles: true, cancelable: true }));
+
+    it.each([['p', '/dashboard/updates'], ['v', '/dashboard/unmanaged'], ['h', '/dashboard/help'], ['i', '/dashboard/inventory']])('G then %s opens %s', async (key, href) => {
+      await mount();
+      press('g'); press(key);
+      expect(push).toHaveBeenCalledWith(href);
+    });
+
+    it('ignores the keys while typing in a field', async () => {
+      await mount();
+      const input = document.createElement('input'); document.body.append(input); input.focus();
+      press('g'); press('p');
+      expect(push).not.toHaveBeenCalled();
+    });
+  });
+});
