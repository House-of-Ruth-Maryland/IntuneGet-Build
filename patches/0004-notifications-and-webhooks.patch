@@ -0,0 +1,66 @@
+/**
+ * HRM patch 0019: "devices failed to install" messages for each webhook type.
+ * Counts and Microsoft's error descriptions only; never device or user names.
+ */
+
+import { appUrl } from '@/lib/hrm/site';
+import type { InstallStatusRecord } from '@/lib/hrm/install-status';
+import type { WebhookType } from '@/types/notifications';
+import { formatSimpleAlert } from './simple-alert';
+
+export interface InstallFailureWebhookData {
+  event: 'install_failures';
+  timestamp: string;
+  app_url?: string;
+  apps: Array<{
+    display_name: string;
+    intune_app_id: string;
+    failed: number;
+    previous_failed: number;
+    installed: number;
+    pending: number;
+    top_errors: Array<{ code: string; description: string; count: number }>;
+  }>;
+}
+
+export function buildInstallFailureData(records: InstallStatusRecord[], now = new Date()): InstallFailureWebhookData {
+  return {
+    event: 'install_failures',
+    timestamp: now.toISOString(),
+    app_url: appUrl(),
+    apps: records.map((r) => ({
+      display_name: r.display_name,
+      intune_app_id: r.intune_app_id,
+      failed: r.failed,
+      previous_failed: r.previous_failed,
+      installed: r.installed,
+      pending: r.pending,
+      top_errors: r.topErrors,
+    })),
+  };
+}
+
+const devices = (n: number) => `${n} device${n === 1 ? '' : 's'}`;
+
+function title(data: InstallFailureWebhookData): string {
+  return data.apps.length === 1
+    ? `${data.apps[0].display_name}: ${devices(data.apps[0].failed)} failed to install`
+    : `${data.apps.length} apps have devices that failed to install`;
+}
+
+function lines(data: InstallFailureWebhookData): string[] {
+  return data.apps.map((app) => {
+    const reason = app.top_errors[0]?.description || app.top_errors[0]?.code;
+    return `${app.display_name}: ${app.failed} failed, ${app.installed} installed${reason ? `. ${reason}` : ''}`;
+  });
+}
+
+export function formatInstallFailurePayload(webhookType: WebhookType, data: InstallFailureWebhookData): unknown {
+  return formatSimpleAlert(webhookType, {
+    data, title: title(data), lines: lines(data), timestamp: data.timestamp,
+    // HRM patch 0032: a single app links straight to its details
+    link: !data.app_url ? undefined : data.apps.length === 1
+      ? { label: 'Open in Inventory', url: `${data.app_url}/dashboard/inventory?app=${encodeURIComponent(data.apps[0].intune_app_id)}` }
+      : { label: 'Open Inventory', url: `${data.app_url}/dashboard/inventory` },
+  });
+}
