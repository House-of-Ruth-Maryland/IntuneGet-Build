@@ -0,0 +1,55 @@
+/**
+ * HRM patch 0032: one alert layout for every webhook type: a title, a few lines and one link.
+ * Used by install-failure and paused auto-update alerts. Counts, app names and versions only.
+ */
+import type { WebhookType } from '@/types/notifications';
+
+export interface SimpleAlert<T> {
+  data: T;
+  title: string;
+  lines: string[];
+  link?: { label: string; url: string };
+  timestamp: string;
+  tone?: 'warning' | 'attention';
+}
+
+const DISCORD_COLOR = { warning: 0xf59e0b, attention: 0xef4444 };
+const escapeSlack = (text: string) => text.replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' })[c]!);
+
+export function formatSimpleAlert<T>(webhookType: WebhookType, alert: SimpleAlert<T>): unknown {
+  const { data, title, lines, link, timestamp, tone = 'warning' } = alert;
+  switch (webhookType) {
+    case 'teams':
+      return {
+        type: 'message',
+        data,
+        attachments: [{
+          contentType: 'application/vnd.microsoft.card.adaptive',
+          content: {
+            $schema: 'http://adaptivecards.io/schemas/adaptive-card.json',
+            type: 'AdaptiveCard',
+            version: '1.4',
+            body: [
+              { type: 'TextBlock', text: title, size: 'Large', weight: 'Bolder', color: tone === 'attention' ? 'Attention' : 'Warning', wrap: true },
+              ...lines.map((text) => ({ type: 'TextBlock', text, wrap: true })),
+            ],
+            actions: link ? [{ type: 'Action.OpenUrl', title: link.label, url: link.url }] : [],
+          },
+        }],
+      };
+    case 'slack':
+      return {
+        data,
+        blocks: [
+          { type: 'header', text: { type: 'plain_text', text: title, emoji: true } },
+          { type: 'section', text: { type: 'mrkdwn', text: escapeSlack(lines.join('\n')) } },
+          ...(link ? [{ type: 'context', elements: [{ type: 'mrkdwn', text: `<${link.url}|${link.label}>` }] }] : []),
+        ],
+      };
+    case 'discord':
+      return { data, embeds: [{ title, url: link?.url, description: lines.join('\n'), color: DISCORD_COLOR[tone], footer: { text: 'IntuneGet' }, timestamp }] };
+    case 'custom':
+    default:
+      return data;
+  }
+}
