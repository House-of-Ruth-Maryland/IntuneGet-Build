@@ -0,0 +1,28 @@
+/**
+ * HRM patch 0019: tell every enabled webhook when apps' failed install counts go up.
+ * Like deployment results, this is server-wide (SQLite mode serves one tenant).
+ */
+
+import type { sqliteWebhooks as SqliteWebhooks } from '@/lib/db/sqlite';
+import type { InstallStatusRecord } from '@/lib/hrm/install-status';
+import { buildInstallFailureData, formatInstallFailurePayload } from '@/lib/webhooks/install-failure-formatters';
+import { deliverFormattedWebhook } from '@/lib/webhooks/service';
+
+export type InstallFailureWebhookStore = Pick<typeof SqliteWebhooks, 'listAllEnabled' | 'recordResult'>;
+
+export async function notifyInstallFailures(
+  records: InstallStatusRecord[],
+  store: InstallFailureWebhookStore,
+  now = new Date()
+): Promise<{ webhooksSent: number; errors: string[] }> {
+  const summary = { webhooksSent: 0, errors: [] as string[] };
+  if (records.length === 0) return summary;
+  const data = buildInstallFailureData(records, now);
+  for (const webhook of await store.listAllEnabled()) {
+    const result = await deliverFormattedWebhook(webhook, formatInstallFailurePayload(webhook.webhook_type, data));
+    await store.recordResult(webhook.id, result.success);
+    if (result.success) summary.webhooksSent++;
+    else summary.errors.push(`Webhook ${webhook.name} failed: ${result.error}`);
+  }
+  return summary;
+}
diff --git a/lib/notifications/notify-sqlite.ts b/lib/notifications/notify-sqlite.ts
new file mode 100644
index 000000000..92af7aa61
--- /dev/null
+++ b/lib/notifications/notify-sqlite.ts
@@ -0,0 +1,103 @@
+/**
+ * Webhook notifications for self-hosted SQLite deployments.
+ *
+ * Mirrors the webhook half of notifyUserOfPendingUpdates against the local
+ * database. Email preferences, user profiles, and notification history live
+ * only in Supabase, so this path delivers webhooks and nothing else.
+ */
+
+import type { DatabaseAdapter } from '@/lib/db/types';
+import type { sqliteWebhooks as SqliteWebhooks } from '@/lib/db/sqlite';
+import { deliverWebhook } from '@/lib/webhooks/service';
+import type { AppUpdate, NotificationPayload, UpdateCheckResult } from '@/types/notifications';
+import { shouldSkipUpdate } from '@/types/update-policies';
+
+export interface SqliteNotifySummary {
+  webhooksSent: number;
+  updatesProcessed: number;
+  channelUsers: number;
+  errors: string[];
+}
+
+/**
+ * Deliver every pending update to its owner's enabled webhooks and mark the
+ * delivered updates notified. As in the hosted path, updates skipped by an
+ * ignore or pin policy stay pending, and updates no webhook accepted are
+ * retried on the next run.
+ */
+export async function notifySqliteWebhooks(
+  db: DatabaseAdapter,
+  webhooks: typeof SqliteWebhooks
+): Promise<SqliteNotifySummary> {
+  const summary: SqliteNotifySummary = { webhooksSent: 0, updatesProcessed: 0, channelUsers: 0, errors: [] };
+  const userIds = await webhooks.listUsersWithEnabled();
+  summary.channelUsers = userIds.length;
+
+  for (const userId of userIds) {
+    const pending = await webhooks.listPendingUpdates(userId);
+    if (pending.length === 0) continue;
+
+    const policies = await db.updatePolicies.list(userId);
+    const policyByApp = new Map(policies.map((policy) => [`${policy.tenant_id}:${policy.winget_id}`, policy]));
+    const updates = pending.filter(
+      (u) => !shouldSkipUpdate(policyByApp.get(`${u.tenant_id}:${u.winget_id}`), u.latest_version)
+    );
+    if (updates.length === 0) continue;
+
+    const tenantUpdates = new Map<string, UpdateCheckResult[]>();
+    updates.forEach((u) => {
+      if (!tenantUpdates.has(u.tenant_id)) {
+        tenantUpdates.set(u.tenant_id, []);
+      }
+      tenantUpdates.get(u.tenant_id)!.push(u);
+    });
+
+    const userWebhooks = await webhooks.listEnabled(userId);
+    const notifiedIds: string[] = [];
+
+    for (const [tenantId, tenantUpdateList] of tenantUpdates) {
+      const appUpdates: AppUpdate[] = tenantUpdateList.map((u) => ({
+        app_name: u.display_name,
+        winget_id: u.winget_id,
+        intune_app_id: u.intune_app_id,
+        current_version: u.current_version,
+        latest_version: u.latest_version,
+        is_critical: u.is_critical,
+      }));
+
+      const payload: NotificationPayload = {
+        event: 'app_updates_available',
+        timestamp: new Date().toISOString(),
+        tenant_id: tenantId,
+        updates: appUpdates,
+        summary: { total: appUpdates.length, critical: appUpdates.filter((u) => u.is_critical).length },
+      };
+
+      let delivered = false;
+      for (const webhook of userWebhooks) {
+        const result = await deliverWebhook(webhook, payload);
+        await webhooks.recordResult(webhook.id, result.success);
+        // Keep the in-memory count current so the circuit breaker sees
+        // failures from earlier tenants in this run.
+        webhook.failure_count = result.success ? 0 : webhook.failure_count + 1;
+        if (!result.success) webhook.last_failure_at = new Date().toISOString();
+
+        if (result.success) {
+          delivered = true;
+          summary.webhooksSent++;
+        } else {
+          summary.errors.push(`Webhook ${webhook.name} failed: ${result.error}`);
+        }
+      }
+
+      if (delivered) {
+        notifiedIds.push(...tenantUpdateList.map((u) => u.id));
+      }
+    }
+
+    await webhooks.markNotified(notifiedIds);
+    summary.updatesProcessed += notifiedIds.length;
+  }
+
+  return summary;
+}
