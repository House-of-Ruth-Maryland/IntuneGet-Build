diff --git a/app/api/webhooks/route.sqlite.test.ts b/app/api/webhooks/route.sqlite.test.ts
new file mode 100644
index 000000000..f864e8b2e
--- /dev/null
+++ b/app/api/webhooks/route.sqlite.test.ts
@@ -0,0 +1,132 @@
+import { NextRequest } from 'next/server';
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { mkdtempSync, rmSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+
+// Test addresses don't resolve in DNS; keep the no-network checks (HRM address guard).
+vi.mock('@/lib/webhooks/address-guard', async (importOriginal) => {
+  const actual = await importOriginal<typeof import('@/lib/webhooks/address-guard')>();
+  return { ...actual, checkWebhookDestination: async (url: string) => actual.checkWebhookUrlShape(url) };
+});
+
+const parseAccessTokenMock = vi.hoisted(() => vi.fn());
+vi.mock('@/lib/auth-utils', () => ({ parseAccessToken: parseAccessTokenMock }));
+
+let tempDir: string;
+let list: typeof import('@/app/api/webhooks/route');
+let item: typeof import('@/app/api/webhooks/[id]/route');
+let test: typeof import('@/app/api/webhooks/[id]/test/route');
+let cron: typeof import('@/app/api/cron/send-notifications/route');
+
+beforeEach(async () => {
+  vi.resetModules();
+  tempDir = mkdtempSync(join(tmpdir(), 'intuneget-webhooks-'));
+  process.env.DATABASE_MODE = 'sqlite';
+  process.env.DATABASE_PATH = join(tempDir, 'app.db');
+  process.env.CRON_SECRET = 'cron-fixture';
+  parseAccessTokenMock.mockReset();
+  parseAccessTokenMock.mockResolvedValue({ userId: 'u1' });
+  vi.stubGlobal('fetch', vi.fn(async () => new Response('ok', { status: 200 })));
+  vi.doMock('@/lib/db', async () => {
+    const sqlite = await import('@/lib/db/sqlite');
+    return { getDatabase: () => sqlite.sqliteDb, isSqliteMode: () => true, resetDatabaseInstance: () => {} };
+  });
+  list = await import('@/app/api/webhooks/route');
+  item = await import('@/app/api/webhooks/[id]/route');
+  test = await import('@/app/api/webhooks/[id]/test/route');
+  cron = await import('@/app/api/cron/send-notifications/route');
+});
+
+afterEach(async () => {
+  const { closeSqliteDb } = await import('@/lib/db/sqlite');
+  closeSqliteDb();
+  rmSync(tempDir, { recursive: true, force: true });
+  delete process.env.DATABASE_MODE;
+  delete process.env.DATABASE_PATH;
+  delete process.env.CRON_SECRET;
+  vi.unstubAllGlobals();
+});
+
+const request = (url: string, method = 'GET', body?: unknown) => new NextRequest(`http://localhost${url}`, {
+  method, headers: { Authorization: 'Bearer test', 'Content-Type': 'application/json' },
+  body: body === undefined ? undefined : JSON.stringify(body),
+});
+const params = (id: string) => ({ params: Promise.resolve({ id }) });
+const valid = { name: ' Teams alerts ', url: 'https://example.test/hook', webhook_type: 'teams', secret: 'fixture-secret' };
+
+async function create(body: unknown = valid) {
+  return list.POST(request('/api/webhooks', 'POST', body));
+}
+
+describe('webhooks in SQLite mode', () => {
+  it('creates, lists, updates and deletes a webhook with the secret masked', async () => {
+    const created = await create();
+    expect(created.status).toBe(201);
+    const { webhook } = await created.json();
+    expect(webhook).toMatchObject({ name: 'Teams alerts', webhook_type: 'teams', secret: '********', headers: {}, is_enabled: true, failure_count: 0 });
+
+    expect((await (await list.GET(request('/api/webhooks'))).json()).webhooks).toHaveLength(1);
+
+    const updated = await item.PUT(request(`/api/webhooks/${webhook.id}`, 'PUT', { is_enabled: false, secret: null, headers: { 'X-Fixture': '1' } }), params(webhook.id));
+    expect(await updated.json()).toEqual({ webhook: expect.objectContaining({ is_enabled: false, secret: null, headers: { 'X-Fixture': '1' } }) });
+
+    expect((await item.DELETE(request(`/api/webhooks/${webhook.id}`, 'DELETE'), params(webhook.id))).status).toBe(200);
+    expect((await item.GET(request(`/api/webhooks/${webhook.id}`), params(webhook.id))).status).toBe(404);
+  });
+
+  it('keeps webhooks private to their owner', async () => {
+    const { webhook } = await (await create()).json();
+    parseAccessTokenMock.mockResolvedValue({ userId: 'u2' });
+    expect((await (await list.GET(request('/api/webhooks'))).json()).webhooks).toEqual([]);
+    expect((await item.GET(request(`/api/webhooks/${webhook.id}`), params(webhook.id))).status).toBe(404);
+    expect((await item.PUT(request(`/api/webhooks/${webhook.id}`, 'PUT', { name: 'x' }), params(webhook.id))).status).toBe(404);
+    expect((await test.POST(request(`/api/webhooks/${webhook.id}/test`, 'POST'), params(webhook.id))).status).toBe(404);
+    await item.DELETE(request(`/api/webhooks/${webhook.id}`, 'DELETE'), params(webhook.id));
+    parseAccessTokenMock.mockResolvedValue({ userId: 'u1' });
+    expect((await item.GET(request(`/api/webhooks/${webhook.id}`), params(webhook.id))).status).toBe(200);
+  });
+
+  it('enforces the ten webhook limit', async () => {
+    for (let i = 0; i < 10; i++) expect((await create()).status).toBe(201);
+    expect((await create()).status).toBe(400);
+  });
+
+  it('sends a test payload and records the result', async () => {
+    const { webhook } = await (await create()).json();
+    const response = await test.POST(request(`/api/webhooks/${webhook.id}/test`, 'POST'), params(webhook.id));
+    expect(await response.json()).toMatchObject({ success: true, statusCode: 200 });
+    expect(fetch).toHaveBeenCalledWith('https://example.test/hook', expect.anything());
+    const stored = (await (await item.GET(request(`/api/webhooks/${webhook.id}`), params(webhook.id))).json()).webhook;
+    expect(stored.last_success_at).toEqual(expect.any(String));
+  });
+
+  it('delivers pending updates once and again when a newer version appears', async () => {
+    await create();
+    const { sqliteDb } = await import('@/lib/db/sqlite');
+    const detected = { user_id: 'u1', tenant_id: 't1', winget_id: 'Vendor.App', intune_app_id: 'i1', display_name: 'Vendor App', current_version: '1.0', latest_version: '2.0' };
+    await sqliteDb.updateCheckResults.upsert(detected);
+    const run = async () => (await cron.GET(new Request('http://localhost/api/cron/send-notifications', { headers: { authorization: 'Bearer cron-fixture' } }))).json();
+
+    expect(await run()).toMatchObject({ mode: 'sqlite', webhooksSent: 1, updatesProcessed: 1 });
+    expect(await run()).toMatchObject({ webhooksSent: 0, updatesProcessed: 0 });
+
+    await sqliteDb.updateCheckResults.upsert(detected);
+    expect(await run()).toMatchObject({ webhooksSent: 0 });
+    await sqliteDb.updateCheckResults.upsert({ ...detected, latest_version: '3.0' });
+    expect(await run()).toMatchObject({ webhooksSent: 1, updatesProcessed: 1 });
+  });
+
+  it('leaves ignored apps pending and rejects an unauthenticated run', async () => {
+    await create();
+    const { sqliteDb } = await import('@/lib/db/sqlite');
+    await sqliteDb.updateCheckResults.upsert({ user_id: 'u1', tenant_id: 't1', winget_id: 'Vendor.App', intune_app_id: 'i1', display_name: 'Vendor App', current_version: '1.0', latest_version: '2.0' });
+    await sqliteDb.updatePolicies.upsert({ user_id: 'u1', tenant_id: 't1', winget_id: 'Vendor.App', policy_type: 'ignore' });
+
+    const unauthorized = await cron.GET(new Request('http://localhost/api/cron/send-notifications'));
+    expect(unauthorized.status).toBe(401);
+    const response = await cron.GET(new Request('http://localhost/api/cron/send-notifications', { headers: { authorization: 'Bearer cron-fixture' } }));
+    expect(await response.json()).toMatchObject({ webhooksSent: 0, updatesProcessed: 0 });
+    expect(fetch).not.toHaveBeenCalled();
+  });
+});
