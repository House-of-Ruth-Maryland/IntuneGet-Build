+const data = (apps: InstallFailureWebhookData['apps']): InstallFailureWebhookData => ({ event: 'install_failures', timestamp: '2026-11-05T12:00:00Z', app_url: 'https://intuneget.example.test', apps });
+const teamsLink = (payload: unknown) => (payload as { attachments: Array<{ content: { actions: Array<{ title: string; url: string }> } }> }).attachments[0].content.actions[0];
+describe('alert links (HRM patch 0032)', () => {
+  it('links one app straight to its Inventory details', () => {
+    expect(teamsLink(formatInstallFailurePayload('teams', data([app('11111111-1111-4111-8111-111111111111')])))).toEqual({ type: 'Action.OpenUrl', title: 'Open in Inventory', url: 'https://intuneget.example.test/dashboard/inventory?app=11111111-1111-4111-8111-111111111111' });
+  });
+  it('links several apps to Inventory, and every webhook type keeps the same data', () => {
+    const many = data([app('a'), app('b')]);
+    expect(teamsLink(formatInstallFailurePayload('teams', many)).url).toBe('https://intuneget.example.test/dashboard/inventory');
+    for (const type of ['slack', 'discord'] as const) expect((formatInstallFailurePayload(type, many) as { data: unknown }).data).toEqual(many);
+    expect(formatInstallFailurePayload('custom', many)).toEqual(many);
