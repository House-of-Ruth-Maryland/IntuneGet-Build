+/**
+ * Effective row summaries for app setup, checks and staff experience.
+ * Shared by the deploy panel (PackageConfig) and the cart editor
+ * (CartItemConfig) so the two always describe the same settings the same way.
+ */
+import type { PSADTConfig } from '@/types/psadt';
+import { installExperience, type PackagingPath } from './install-experience';
+
+const plural = (n: number, one: string, many: string) => `${n} ${n === 1 ? one : many}`;
+
+export interface SettingsSummaryInput {
+  config: PSADTConfig;
+  espProfiles: unknown[];
+  relationships: unknown[];
+  categories: Array<{ displayName: string }>;
+  /** Description, install or uninstall command differ from what the app started with. */
+  descriptionOrCommandsChanged: boolean;
+  customDetectionActive?: boolean;
+  packagingPath?: PackagingPath;
+}
+
+export function settingsSummaries({ config, espProfiles, relationships, categories, descriptionOrCommandsChanged, customDetectionActive = false, packagingPath = 'github' }: SettingsSummaryInput) {
+  const experience = installExperience(config, packagingPath);
+  return {
+    detection: customDetectionActive ? 'Your own rules' : 'Automatic',
+    esp: espProfiles.length ? `Required on ${plural(espProfiles.length, 'setup profile', 'setup profiles')}` : 'Not required',
+    dependencies: relationships.length ? plural(relationships.length, 'linked app', 'linked apps') : 'None',
+    category: categories.map((c) => c.displayName).join(', ') || 'None',
+    behavior: `${experience.processes ? plural(experience.processes, 'app to close', 'apps to close') : 'No apps to close'} · ${!experience.known ? 'packaging not verified' : packagingPath === 'local' ? 'Intune restarts suppressed' : { Suppress: 'Intune restarts suppressed', Prompt: 'restart by return code', Force: 'Intune restart forced' }[config.restartBehavior] ?? 'Intune restarts suppressed'}`,
+    advanced: descriptionOrCommandsChanged || config.postInstallCommands?.length || config.postUninstallCommands?.length ? 'Changed' : 'Default',
+    deferral: experience.deferral,
+    progress: experience.progress || experience.notifications ? 'On' : 'Off',
+    prompts: experience.messages ? plural(experience.enabledMessages, 'enabled message', 'enabled messages') : 'None enabled',
+    restart: experience.restartPrompt ? 'Countdown enabled' : 'Off',
+    diskspace: config.checkDiskSpace ? (config.requiredDiskSpace !== undefined ? `${config.requiredDiskSpace} MB` : 'Package size') : 'Off',
+    branding: config.brandingCompanyName || config.brandingWelcomeMessage || config.brandingAccentColor || config.brandingLogoPath || config.brandingLogoDarkPath || config.brandingBannerPath ? 'Custom' : 'Default',
+  };
+}
