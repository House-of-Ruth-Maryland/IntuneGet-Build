@@ -0,0 +1,95 @@
+import { NextRequest } from 'next/server';
+import { beforeEach, describe, expect, it, vi } from 'vitest';
+const mocks = vi.hoisted(() => ({ auth: vi.fn(), jobs: vi.fn(), status: vi.fn(), installs: vi.fn(), history: vi.fn(), kept: vi.fn(), retiring: vi.fn() }));
+vi.mock('@/lib/auth-utils', () => ({ parseAccessToken: mocks.auth }));
+vi.mock('@/lib/db', () => ({ getDatabase: () => ({ jobs: { getAnalyticsJobs: mocks.jobs }, uploadHistory: { listAll: mocks.history } }) }));
+vi.mock('@/lib/hrm/install-status-check', () => ({ listInstallStatus: mocks.installs }));
+vi.mock('@/lib/hrm/home', async (original) => ({ ...(await original<typeof import('@/lib/hrm/home')>()), readServerStatus: mocks.status }));
+// HRM patch 0042: only read when DATABASE_MODE is sqlite.
+vi.mock('@/lib/db/sqlite', () => ({
+  sqliteRetirements: { activeAppIds: mocks.retiring },
+  sqliteRollbackReadiness: { gaps: () => [] },
+  sqliteAppInsights: { tracked: () => [] },
+  sqliteOldCopies: { kept: mocks.kept },
+}));
+import { GET } from './route';
+
+const request = () => new NextRequest('http://localhost/api/hrm/home');
+beforeEach(() => {
+  vi.clearAllMocks();
+  mocks.auth.mockResolvedValue({ userId: 'caller', tenantId: 'token-tenant' });
+  mocks.jobs.mockResolvedValue([]);
+  mocks.status.mockResolvedValue({ reported: false, reason: 'missing' });
+  mocks.installs.mockResolvedValue([]);
+  mocks.history.mockResolvedValue([]);
+});
+
+describe('HRM home route', () => {
+  it('requires sign-in before reading anything', async () => {
+    mocks.auth.mockResolvedValue(null);
+    expect((await GET(request())).status).toBe(401);
+    expect(mocks.jobs).not.toHaveBeenCalled();
+    expect(mocks.status).not.toHaveBeenCalled();
+  });
+
+  it('reads only the signed-in tenant and is never cached', async () => {
+    const response = await GET(request());
+    expect(mocks.jobs).toHaveBeenCalledWith({ tenantId: 'token-tenant' });
+    expect(response.headers.get('cache-control')).toBe('private, no-store');
+    expect(await response.json()).toEqual({ attention: { failedRecent: 0, stuck: 0 }, server: { reported: false, reason: 'missing' }, installFailures: [], unreached: [], rollbackGaps: [], oldCopiesKept: [], appAccess: 'not_limited' });
+    expect(mocks.installs).toHaveBeenCalledWith('token-tenant');
+  });
+
+  // HRM patch 0056
+  it('says whether sign-in is limited to the IT admins group', async () => {
+    vi.stubEnv('HRM_ADMIN_GROUP_IDS', '00000000-0000-4000-8000-0000000000a1');
+    try {
+      expect(await (await GET(request())).json()).toMatchObject({ appAccess: 'limited' });
+    } finally {
+      vi.unstubAllEnvs();
+    }
+  });
+
+  it('still returns server status when the job query fails', async () => {
+    mocks.jobs.mockRejectedValue(new Error('db busy'));
+    expect(await (await GET(request())).json()).toMatchObject({ attention: null, server: { reported: false } });
+  });
+
+  it('lists only apps with failed installs, by name and count', async () => {
+    mocks.installs.mockResolvedValue([
+      { display_name: 'Example Reader', intune_app_id: '00000000-0000-0000-0000-000000000001', failed: 3, installed: 40 },
+      { display_name: 'Example Zip', intune_app_id: '00000000-0000-0000-0000-000000000002', failed: 0, installed: 43 },
+    ]);
+    expect((await (await GET(request())).json()).installFailures).toEqual([
+      { displayName: 'Example Reader', intuneAppId: '00000000-0000-0000-0000-000000000001', failed: 3 },
+    ]);
+  });
+  it('lists apps that reach no devices, only from the signed-in tenant (HRM patch 0032)', async () => {
+    const recent = new Date(Date.now() - 60 * 60 * 1000).toISOString();
+    const old = new Date(Date.now() - 5 * 24 * 60 * 60 * 1000).toISOString();
+    mocks.installs.mockResolvedValue([{ intune_app_id: 'app-a', display_name: 'App A', installed: 0, pending: 0, failed: 0, checked_at: recent }]);
+    mocks.history.mockResolvedValue([
+      { intune_tenant_id: 'other-tenant', intune_app_id: 'app-a', deployed_at: recent },
+      { intune_tenant_id: 'token-tenant', intune_app_id: 'app-a', deployed_at: old },
+    ]);
+    expect((await (await GET(request())).json()).unreached).toEqual([{ displayName: 'App A', intuneAppId: 'app-a', deployedAt: old }]);
+  });
+
+  it('lists old copies IntuneGet could not remove, for the signed-in tenant only, leaving out copies being retired', async () => {
+    const before = process.env.DATABASE_MODE;
+    process.env.DATABASE_MODE = 'sqlite';
+    try {
+      const A = '00000000-0000-0000-0000-00000000000a', B = '00000000-0000-0000-0000-00000000000b', N = '00000000-0000-0000-0000-00000000000c';
+      mocks.retiring.mockReturnValue([B]);
+      mocks.kept.mockReturnValue([
+        { app_id: A, display_name: 'Example Reader', version: '1.0', newest_app_id: N, reason: 'This copy has a group the newest copy doesn\'t.' },
+        { app_id: B, display_name: 'Example Zip', version: '2.0', newest_app_id: N, reason: 'x' },
+      ]);
+      const body = await (await GET(request())).json();
+      expect(mocks.kept).toHaveBeenCalledWith('token-tenant');
+      expect(body.oldCopiesKept).toEqual([{ displayName: 'Example Reader', intuneAppId: A, version: '1.0', newestAppId: N, reason: 'This copy has a group the newest copy doesn\'t.' }]);
+    } finally {
+      if (before === undefined) delete process.env.DATABASE_MODE; else process.env.DATABASE_MODE = before;
+    }
+  });
+});
