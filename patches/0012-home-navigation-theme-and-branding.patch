+'use client';
+
+// HRM patch 0058 (David's choice 4B): one row of App updates' status strip. The row shows the setting's
+// state and the next action; the details and editing live in the row's dialog.
+
+import type { ReactNode } from 'react';
+
+export function StripPill({ tone, children }: { tone: 'ok' | 'warn' | 'muted'; children: ReactNode }) {
+  const tones = {
+    ok: 'bg-status-success/10 text-status-success',
+    warn: 'bg-status-warning/10 text-status-warning',
+    muted: 'bg-overlay/5 text-text-muted',
+  };
+  return <span className={`shrink-0 rounded-full px-2 py-0.5 text-xs font-medium ${tones[tone]}`}>{children}</span>;
+}
+
+export function StatusStripRow({ label, summary, status, action, children }: {
+  label: string;
+  summary: ReactNode;
+  status?: ReactNode;
+  action?: ReactNode;
+  children?: ReactNode;
+}) {
+  return (
+    <section aria-label={label} className="space-y-2 p-4">
+      <div className="flex flex-wrap items-center gap-x-4 gap-y-2">
+        <h3 className="w-full shrink-0 text-sm font-semibold text-text-primary sm:w-44">{label}</h3>
+        <div className="min-w-0 flex-1 text-sm text-text-secondary">{summary}</div>
+        {status}
+        {action}
+      </div>
+      {children}
+    </section>
+  );
+}
