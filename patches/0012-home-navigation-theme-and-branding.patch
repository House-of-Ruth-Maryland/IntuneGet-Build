+/**
+ * HRM patch 0036: the current setting of each row under More settings and What staff see during
+ * install, in a few words. Shared by the deploy panel (PackageConfig) and the cart editor
+ * (CartItemConfig) so the two always describe the same settings the same way.
+ */
+import type { PSADTConfig } from '@/types/psadt';
+
+const plural = (n: number, one: string, many: string) => `${n} ${n === 1 ? one : many}`;
+
+export interface SettingsSummaryInput {
+  config: PSADTConfig;
+  espProfiles: unknown[];
+  relationships: unknown[];
+  categories: Array<{ displayName: string }>;
+  /** Description, install or uninstall command differ from what the app started with. */
+  descriptionOrCommandsChanged: boolean;
+  customDetectionActive?: boolean;
+}
+
+export function settingsSummaries({ config, espProfiles, relationships, categories, descriptionOrCommandsChanged, customDetectionActive = false }: SettingsSummaryInput) {
+  return {
+    detection: customDetectionActive ? 'Your own rules' : 'Automatic',
+    esp: espProfiles.length ? `Required on ${plural(espProfiles.length, 'setup profile', 'setup profiles')}` : 'Not required',
+    dependencies: relationships.length ? plural(relationships.length, 'linked app', 'linked apps') : 'None',
+    category: categories.map((c) => c.displayName).join(', ') || 'None',
+    behavior: config.installAfterRestartBeta ? 'After next restart · Beta' : `${{ Silent: 'Silent', NonInteractive: 'Progress only', Auto: 'Installer decides' }[config.deployMode || 'Silent'] ?? 'Silent'}, ${
+      { Suppress: 'no restart', Prompt: 'asks to restart', Force: 'restarts' }[config.restartBehavior] ?? 'no restart'}`,
+    advanced: descriptionOrCommandsChanged || config.postInstallCommands?.length || config.postUninstallCommands?.length ? 'Changed' : 'Default',
+    deferral: config.allowDefer ? `Up to ${plural(config.deferTimes, 'time', 'times')}` : 'Off',
+    progress: config.progressDialog?.enabled || config.balloonTips?.length ? 'On' : 'Off',
+    prompts: config.customPrompts?.length ? plural(config.customPrompts.length, 'message', 'messages') : 'None',
+    restart: config.restartPrompt?.enabled ? 'On' : 'Off',
+    diskspace: config.checkDiskSpace ? (config.requiredDiskSpace ? `${config.requiredDiskSpace} MB` : 'On') : 'Off',
+    branding: config.brandingCompanyName || config.brandingWelcomeTitle || config.brandingLogoPath ? 'Custom' : 'Default',
+  };
+}
diff --git a/lib/hrm/site.ts b/lib/hrm/site.ts
new file mode 100644
index 000000000..4173edc02
--- /dev/null
+++ b/lib/hrm/site.ts
@@ -0,0 +1,59 @@
+/**
+ * HRM patch: this server is HRM's internal tool behind Cloudflare Access, so
+ * the public marketing site (home page, pricing, blog, docs...) has no
+ * audience. Its pages stay in the code, unchanged, and the request proxy
+ * sends them to the dashboard instead.
+ */
+
+// Top-level routes of app/(marketing). '/' is the landing page.
+const MARKETING_PREFIXES = [
+  '/about', '/apps', '/blog', '/docs', '/pricing', '/privacy', '/qa', '/roadmap', '/security', '/terms',
+];
+
+export const HOME_PATH = '/dashboard';
+
+export function isMarketingPath(pathname: string): boolean {
+  if (pathname === '/') return true;
+  return MARKETING_PREFIXES.some((prefix) => pathname === prefix || pathname.startsWith(`${prefix}/`));
+}
+
+// HRM patch 0036: upstream sections hidden from the sidebar (SCCM migration, public app requests,
+// MSP) still opened by typing the address. Their pages stay in the code; the proxy sends them Home.
+// HRM patch 0051: upstream's Account page too. No menu links to it, and Settings > General already
+// shows the signed-in account and the Intune connection.
+const HIDDEN_DASHBOARD_PREFIXES = ['/dashboard/sccm', '/dashboard/app-requests', '/dashboard/msp', '/dashboard/account'];
+
+export function isHiddenDashboardPath(pathname: string): boolean {
+  return HIDDEN_DASHBOARD_PREFIXES.some((prefix) => pathname === prefix || pathname.startsWith(`${prefix}/`));
+}
+
+// Search engines are told to skip everything; the sitemap is never served.
+export function isCrawlerPath(pathname: string): boolean {
+  return pathname === '/robots.txt' || pathname === '/sitemap.xml' || pathname.startsWith('/sitemap/');
+}
+
+export const ROBOTS_TXT = 'User-agent: *\nDisallow: /\n';
+
+/**
+ * HRM patch 0036: this server's own https address (origin only), shared by webhook links and the
+ * IT dashboard status report. Reads NEXT_PUBLIC_URL first (the variable upstream's compose file
+ * sets) and falls back to NEXT_PUBLIC_APP_URL, taking the first one that is a plain https address.
+ * Paths, query strings and fragments are dropped; addresses with credentials or http are ignored,
+ * so compose's default http://localhost:3000 doesn't hide a valid NEXT_PUBLIC_APP_URL.
+ */
+export function serverHttpsOrigin(env: Record<string, string | undefined> = process.env): string | undefined {
+  for (const name of ['NEXT_PUBLIC_URL', 'NEXT_PUBLIC_APP_URL']) {
+    const value = (env[name] ?? '').trim();
+    if (!value) continue;
+    try {
+      const url = new URL(value);
+      if (url.protocol === 'https:' && !url.username && !url.password) return url.origin;
+    } catch { /* not a URL: try the next variable */ }
+  }
+  return undefined;
+}
+
+/** HRM patch 0019: this server's own https address, for links in Custom webhook messages. */
+export function appUrl(): string | undefined {
+  return serverHttpsOrigin();
+}
