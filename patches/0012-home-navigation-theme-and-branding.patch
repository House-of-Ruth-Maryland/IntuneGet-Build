+import { afterEach, describe, expect, it } from 'vitest';
+import { mkdtemp, rm, writeFile } from 'fs/promises';
+import os from 'os';
+import path from 'path';
+import type { AnalyticsJob } from '@/lib/db/types';
+import { attentionCounts, interpretServerStatus, readServerStatus } from '../home';
+
+const NOW = new Date('2026-10-27T12:00:00Z');
+const file = (over: Record<string, unknown> = {}) => JSON.stringify({
+  generatedAt: '2026-10-27T11:58:00Z',
+  version: 'v0.8.2-hrm.9',
+  startedAt: '2026-10-27T10:00:00Z',
+  lastDeploy: { time: '2026-10-27T10:00:00Z', result: 'deployed', from: 'v0.8.2-hrm.8', to: 'v0.8.2-hrm.9' },
+  lastBackup: { at: '2026-10-27T09:59:00Z', sizeKb: 90000 },
+  disk: { totalKb: 1000, usedKb: 600 },
+  updateCheck: { result: 'success', at: '2026-10-27T07:30:00Z' },
+  notifications: { result: 'success', at: '2026-10-27T08:00:00Z' },
+  tunnel: { version: '2026.10.4', running: true, lastUpdate: { result: 'success', at: '2026-10-27T00:00:00Z' } },
+  ...over,
+});
+
+describe('server status file', () => {
+  it('reports a healthy server', () => {
+    const status = interpretServerStatus(file(), NOW);
+    expect(status).toMatchObject({ reported: true, version: 'v0.8.2-hrm.9', diskWarning: false, problems: [] });
+  });
+
+  // HRM patch 0057
+  it('reports a failing version sync after deploy as a problem', () => {
+    const failing = { ok: false, at: '2026-10-27T11:00:00Z', detail: 'Fixture detail.' };
+    expect(interpretServerStatus(file({ checks: { versionSync: failing } }), NOW)).toMatchObject({ problems: ['versionSync'] });
+    expect(interpretServerStatus(file({ checks: { versionSync: { ...failing, ok: true } } }), NOW)).toMatchObject({ problems: [] });
+    expect(interpretServerStatus(file({ checks: { versionSync: null } }), NOW)).toMatchObject({ problems: [] });
+  });
+
+  it('never guesses when the file is missing, unreadable or old', () => {
+    expect(interpretServerStatus(null, NOW)).toEqual({ reported: false, reason: 'missing' });
+    expect(interpretServerStatus('{not json', NOW)).toEqual({ reported: false, reason: 'unreadable' });
+    expect(interpretServerStatus('{}', NOW)).toEqual({ reported: false, reason: 'unreadable' });
+    expect(interpretServerStatus(file({ generatedAt: '2026-10-27T11:40:00Z' }), NOW)).toMatchObject({ reported: false, reason: 'stale' });
+  });
+
+  it('flags disk, deploy, timers and the tunnel', () => {
+    const status = interpretServerStatus(file({
+      disk: { totalKb: 100, usedKb: 90 },
+      lastDeploy: { time: '2026-10-27T10:00:00Z', result: 'rolled_back', from: 'a', to: 'b' },
+      updateCheck: { result: 'exit-code', at: '2026-10-27T07:30:00Z' },
+      notifications: { result: 'timeout', at: null },
+      tunnel: { version: '2026.10.4', running: false, lastUpdate: { result: 'success', at: null } },
+    }), NOW);
+    expect(status.reported && status.problems).toEqual(['disk', 'deploy', 'updateCheck', 'notifications', 'tunnel']);
+  });
+
+  it('treats a waiting deploy as normal and a failed tunnel update as a warning', () => {
+    const status = interpretServerStatus(file({
+      lastDeploy: { time: '2026-10-27T10:00:00Z', result: 'waiting', from: 'a', to: 'b' },
+      tunnel: { version: '2026.10.4', running: true, lastUpdate: { result: 'exit-code', at: null } },
+    }), NOW);
+    expect(status.reported && status.problems).toEqual(['tunnelUpdate']);
+  });
+});
+
+describe('needs attention counts', () => {
+  const job = (status: string, created: string) => ({ id: created, user_id: 'u', user_email: null, status, completed_at: null, created_at: created, winget_id: 'Example.App', display_name: 'Example', intune_app_url: null }) as unknown as AnalyticsJob;
+
+  it('counts failures from the last 7 days and jobs pending for over 2 hours', () => {
+    const counts = attentionCounts([
+      job('failed', '2026-10-26T12:00:00Z'),
+      job('failed', '2026-10-10T12:00:00Z'),
+      job('packaging', '2026-10-27T09:00:00Z'),
+      job('queued', '2026-10-27T11:30:00Z'),
+      job('uploading', '2026-10-27T08:00:00Z'),
+      job('deployed', '2026-10-27T01:00:00Z'),
+      job('failed', 'not a date'),
+    ], NOW);
+    expect(counts).toEqual({ failedRecent: 1, stuck: 2 });
+  });
+});
+
+// HRM patch 0021
+describe('off-site backup status', () => {
+  it('is fine after a recent success and a problem when failed, missing or old', () => {
+    const ok = interpretServerStatus(file({ offsiteBackup: { result: 'success', at: '2026-10-27T05:30:00Z' } }), NOW);
+    expect(ok).toMatchObject({ problems: [] });
+    expect(interpretServerStatus(file({ offsiteBackup: { result: 'failed', at: '2026-10-27T05:30:00Z' } }), NOW)).toMatchObject({ problems: ['offsiteBackup'] });
+    expect(interpretServerStatus(file({ offsiteBackup: null }), NOW)).toMatchObject({ problems: ['offsiteBackup'] });
+    expect(interpretServerStatus(file({ offsiteBackup: { result: 'success', at: '2026-10-25T05:30:00Z' } }), NOW)).toMatchObject({ problems: ['offsiteBackup'] });
+  });
+
+  it('says nothing when the server does not report it yet', () => {
+    expect(interpretServerStatus(file(), NOW)).toMatchObject({ problems: [] });
+  });
+});
+
+// HRM patch 0036: Home reads the status file with the same 32 KB bound as the status report.
+describe('readServerStatus', () => {
+  const originalPath = process.env.DATABASE_PATH;
+  let dir: string | undefined;
+  afterEach(async () => {
+    if (originalPath === undefined) delete process.env.DATABASE_PATH;
+    else process.env.DATABASE_PATH = originalPath;
+    if (dir) await rm(dir, { recursive: true, force: true });
+    dir = undefined;
+  });
+
+  it('reports a missing file as missing and an oversized one as unreadable', async () => {
+    dir = await mkdtemp(path.join(os.tmpdir(), 'hrm-home-'));
+    process.env.DATABASE_PATH = path.join(dir, 'intuneget.db');
+    expect(await readServerStatus()).toEqual({ reported: false, reason: 'missing' });
+    await writeFile(path.join(dir, 'hrm-status.json'), ' '.repeat(32_769));
+    expect(await readServerStatus()).toEqual({ reported: false, reason: 'unreadable' });
+  });
+});
