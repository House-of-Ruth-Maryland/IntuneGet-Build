@@ -0,0 +1,43 @@
+// HRM patch 0053: the sidebar's groups. Routes are unchanged; only the grouping and order are HRM's.
+// Home on its own, then the pages grouped by job. Items not listed here (none
+// today) are dropped rather than shown in a random place.
+// HRM patch 0058 (David's choice 2B): every label groups more than one page. App updates sits with
+// the apps it updates, and Help is unlabelled at the bottom, next to Settings. The page is called
+// App updates everywhere, the sidebar included, so text that says "App updates" can be found.
+export const HRM_NAV_LAYOUT: { label?: string; hrefs: string[] }[] = [
+  { hrefs: ['/dashboard', '/dashboard/inventory', '/dashboard/updates', '/dashboard/uploads', '/dashboard/settings'] },
+  { hrefs: ['/dashboard/help'] },
+];
+const PRIMARY_NAMES: Record<string, string> = { '/dashboard/inventory': 'Apps', '/dashboard/updates': 'App updates', '/dashboard/uploads': 'Activity', '/dashboard/settings': 'Settings' };
+export const APP_PAGES = [{ href: '/dashboard/inventory', name: 'Inventory' }, { href: '/dashboard/apps', name: 'App catalog' }, { href: '/dashboard/unmanaged', name: 'Discovered apps' }];
+export const ACTIVITY_PAGES = [{ href: '/dashboard/uploads', name: 'Deployments' }, { href: '/dashboard/reports', name: 'Reports' }];
+export function sectionPages(path: string) {
+  return APP_PAGES.some(page => path === page.href || path.startsWith(page.href + '/')) ? APP_PAGES : ACTIVITY_PAGES.some(page => path === page.href || path.startsWith(page.href + '/')) ? ACTIVITY_PAGES : [];
+}
+export function primaryNavActive(href: string, path: string) {
+  if (href === '/dashboard/inventory') return sectionPages(path) === APP_PAGES;
+  if (href === '/dashboard/uploads') return sectionPages(path) === ACTIVITY_PAGES;
+  return path === href || (href !== '/dashboard' && href !== '/dashboard/msp' && path.startsWith(href + '/'));
+}
+export function hrmNavGroups<T extends { href: string }>(items: T[], support: T[]): { label?: string; items: T[] }[] {
+  const byHref = new Map([...items, ...support].map(item => [item.href, item]));
+  return HRM_NAV_LAYOUT.map(group => ({ label: group.label, items: group.hrefs.flatMap(href => { const item = byHref.get(href); return item ? [{ ...item, ...(PRIMARY_NAMES[href] ? { name: PRIMARY_NAMES[href] } : {}) }] : []; }) })).filter(group => group.items.length > 0);
+}
+
+// Press G, then the key, to open a page. Listed in sidebar order; upstream's D, A, U, I, R and S
+// keep their meaning, and P (App updates; U was taken), V (Discovered apps) and H (Help) are added.
+export const GO_TO_SHORTCUTS: { key: string; href: string; name: string }[] = [
+  { key: 'd', href: '/dashboard', name: 'Home' },
+  { key: 'a', href: '/dashboard/apps', name: 'App catalog' },
+  { key: 'i', href: '/dashboard/inventory', name: 'Inventory' },
+  { key: 'v', href: '/dashboard/unmanaged', name: 'Discovered apps' },
+  { key: 'p', href: '/dashboard/updates', name: 'App updates' },
+  { key: 'u', href: '/dashboard/uploads', name: 'Deployments' },
+  { key: 'r', href: '/dashboard/reports', name: 'Reports' },
+  { key: 's', href: '/dashboard/settings', name: 'Settings' },
+  { key: 'h', href: '/dashboard/help', name: 'Help' },
+];
+
+export function goToShortcutHref(key: string): string | null {
+  return GO_TO_SHORTCUTS.find((shortcut) => shortcut.key === key.toLowerCase())?.href ?? null;
+}
