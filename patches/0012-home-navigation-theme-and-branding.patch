+// HRM patch 0058: at phone width the menu button must sit above the sticky page header,
+// and the open menu's backdrop and panel must still cover it.
+import { readFileSync } from 'node:fs';
+import { join } from 'node:path';
+import { describe, expect, it } from 'vitest';
+
+const root = join(__dirname, '..', '..', '..');
+const sidebar = readFileSync(join(root, 'components/dashboard/Sidebar.tsx'), 'utf8');
+const layout = readFileSync(join(root, 'app/(app)/dashboard/layout.tsx'), 'utf8');
+const z = (classes: string) => Number(/\bz-(\d+)\b/.exec(classes)?.[1]);
+const classesOf = (source: string, pattern: RegExp) => pattern.exec(source)?.[1] ?? '';
+
+describe('phone menu layering', () => {
+  it('keeps the menu button above the header and below the open menu', () => {
+    const button = z(classesOf(sidebar, /className="([^"]*)"\s*aria-label="Open sidebar"/));
+    const header = z(classesOf(layout, /<header className="([^"]*sticky[^"]*)"/));
+    const backdrop = z(classesOf(sidebar, /className="(fixed inset-0[^"]*)"/));
+    const panel = z(classesOf(sidebar, /'(fixed top-0 left-0[^']*lg:hidden)'/));
+    expect(header).toBeGreaterThan(0);
+    expect(button).toBeGreaterThan(header);
+    expect(backdrop).toBeGreaterThanOrEqual(button);
+    expect(panel).toBeGreaterThan(backdrop);
+  });
+});
