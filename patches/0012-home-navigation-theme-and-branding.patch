@@ -0,0 +1,23 @@
+// HRM patch: Home page data (needs attention counts and server status).
+
+import { NextRequest, NextResponse } from 'next/server';
+import { parseAccessToken } from '@/lib/auth-utils';
+import { readServerStatus } from '@/lib/hrm/home';
+// HRM patch 0055: the attention lists are shared with the MCP read API.
+import { readTenantAttention } from '@/lib/hrm/attention';
+// HRM patch 0056: Server status says when sign-in isn't limited to the IT admins group.
+import { adminAccessState } from '@/lib/hrm/admin-access';
+
+export async function GET(request: NextRequest) {
+  const user = await parseAccessToken(request.headers.get('Authorization'));
+  if (!user) return NextResponse.json({ error: 'Authentication required' }, { status: 401 });
+
+  const [server, { attention, installFailures, unreached, rollbackGaps, oldCopiesKept }] = await Promise.all([
+    readServerStatus(),
+    readTenantAttention(user.tenantId),
+  ]);
+  return NextResponse.json(
+    { attention, server, installFailures, unreached, rollbackGaps, oldCopiesKept, appAccess: adminAccessState() },
+    { headers: { 'Cache-Control': 'private, no-store' } },
+  );
+}
