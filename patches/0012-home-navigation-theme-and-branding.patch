+// @vitest-environment happy-dom
+// HRM patch 0057: Server status shows Version sync after deploy like the other checks.
+import { act, createElement } from 'react';
+import { createRoot, type Root } from 'react-dom/client';
+import { afterEach, beforeEach, expect, it } from 'vitest';
+import { interpretServerStatus } from '@/lib/hrm/home';
+import { deployResultLabel, ServerStatusCard } from './ServerStatusCard';
+(globalThis as typeof globalThis & { IS_REACT_ACT_ENVIRONMENT: boolean }).IS_REACT_ACT_ENVIRONMENT = true;
+
+const status = (checks: Record<string, unknown>) => interpretServerStatus(JSON.stringify({
+  generatedAt: new Date().toISOString(), version: 'v0.8.5-hrm.1', startedAt: null, lastDeploy: null, lastBackup: null,
+  disk: { totalKb: 100, usedKb: 10 }, updateCheck: { result: null, at: null }, notifications: { result: null, at: null },
+  tunnel: { version: null, running: true, lastUpdate: { result: null, at: null } }, checks,
+}));
+
+let root: Root;
+beforeEach(() => { const node = document.createElement('div'); document.body.append(node); root = createRoot(node); });
+afterEach(async () => { await act(async () => root.unmount()); document.body.innerHTML = ''; });
+const row = (label: string) => [...document.querySelectorAll('dt')].find((dt) => dt.textContent === label)?.parentElement?.textContent ?? null;
+
+it('shows Working, or Failing with the reason', async () => {
+  await act(async () => root.render(createElement(ServerStatusCard, { status: status({ versionSync: { ok: true, at: null, detail: null } }) })));
+  expect(row('Version sync after deploy')).toContain('Working');
+  expect(document.body.textContent).toContain('Healthy');
+  await act(async () => root.render(createElement(ServerStatusCard, { status: status({ versionSync: { ok: false, at: null, detail: 'Fixture reason.' } }) })));
+  expect(row('Version sync after deploy')).toContain('Failing');
+  expect(row('Version sync after deploy')).toContain('Fixture reason.');
+  expect(document.body.textContent).toContain('1 needs a look');
+});
+
+// HRM patch 0058 (choice 3B): failing checks first, Version in view, healthy rows in a collapsed group.
+it('lists checks that need a look first and folds the healthy ones away', async () => {
+  await act(async () => root.render(createElement(ServerStatusCard, {
+    status: status({ versionSync: { ok: false, at: null, detail: 'Fixture reason.' }, intuneReads: { ok: true, at: null, detail: null } }),
+    appAccess: 'not_limited',
+  })));
+  const labels = [...document.querySelectorAll('dt')].map((dt) => dt.textContent);
+  expect(labels.slice(0, 3)).toEqual(['Version sync after deploy', 'Who can sign in', 'Version']);
+  expect(document.body.textContent).toContain('2 need a look');
+  expect(row('Who can sign in')).toContain('Not limited to a group');
+  const all = document.querySelector('[data-testid="server-status-all-checks"]') as HTMLDetailsElement;
+  expect(all.open).toBe(false);
+  expect(all.querySelector('summary')?.textContent).toMatch(/^All checks \(\d+ working\)/);
+  expect(all.textContent).toContain('Intune reads');
+  expect(all.textContent).not.toContain('Version sync after deploy');
+});
+
+it('words deploy results and a late status report plainly', async () => {
+  expect(deployResultLabel('rolled_back')).toBe('Rolled back');
+  expect(deployResultLabel('rollback_failed')).toBe('Rollback failed');
+  expect(deployResultLabel('backup_failed')).toBe('Backup failed');
+  expect(deployResultLabel('something_new')).toBe('Failed');
+  await act(async () => root.render(createElement(ServerStatusCard, { status: { reported: false, reason: 'stale', generatedAt: new Date(Date.now() - 3 * 3600_000).toISOString() } })));
+  expect(document.body.textContent).toContain('Last status report 3 h ago.');
+});
+
+it('hides the row until the server reports it', async () => {
+  await act(async () => root.render(createElement(ServerStatusCard, { status: status({}) })));
+  expect(row('Version sync after deploy')).toBeNull();
+});
diff --git a/components/hrm/ServerStatusCard.tsx b/components/hrm/ServerStatusCard.tsx
new file mode 100644
index 000000000..680c66078
--- /dev/null
+++ b/components/hrm/ServerStatusCard.tsx
@@ -0,0 +1,182 @@
+'use client';
+
+// HRM patch: the Home page's server status card.
+
+import { Server, Loader2 } from 'lucide-react';
+import type { ServerStatus } from '@/lib/hrm/home';
+
+function relative(iso: string | null | undefined, now = Date.now()): string {
+  const at = iso ? Date.parse(iso) : NaN;
+  if (!Number.isFinite(at)) return 'Never';
+  const minutes = Math.max(0, Math.round((now - at) / 60000));
+  if (minutes < 60) return minutes <= 1 ? 'Just now' : `${minutes} min ago`;
+  const hours = Math.round(minutes / 60);
+  if (hours < 48) return `${hours} h ago`;
+  return `${Math.round(hours / 24)} days ago`;
+}
+
+function size(kb: number): string {
+  return kb >= 1024 * 1024 ? `${(kb / 1024 / 1024).toFixed(1)} GB` : `${Math.round(kb / 1024)} MB`;
+}
+
+function Pill({ tone, children }: { tone: 'ok' | 'warn' | 'bad'; children: React.ReactNode }) {
+  const tones = {
+    ok: 'bg-status-success/10 text-status-success',
+    warn: 'bg-status-warning/10 text-status-warning',
+    bad: 'bg-status-error/10 text-status-error',
+  };
+  return <span className={`text-xs font-medium px-2 py-0.5 rounded-full ${tones[tone]}`}>{children}</span>;
+}
+
+function Row({ label, children }: { label: string; children: React.ReactNode }) {
+  return (
+    <div className="flex items-center justify-between gap-3 py-2 border-t border-overlay/5 first:border-t-0">
+      <dt className="text-sm text-text-muted">{label}</dt>
+      <dd className="text-sm text-text-primary text-right">{children}</dd>
+    </div>
+  );
+}
+
+/** HRM patch 0058: the deploy script's result codes, as words. */
+export function deployResultLabel(result: string): string {
+  const labels: Record<string, string> = {
+    rolled_back: 'Rolled back',
+    rollback_failed: 'Rollback failed',
+    backup_failed: 'Backup failed',
+    refused: 'Refused',
+  };
+  return labels[result] ?? 'Failed';
+}
+
+type Access = 'limited' | 'not_limited';
+interface StatusRow { key: string; label: string; problem: boolean; content: React.ReactNode }
+
+// HRM patch 0056: whether sign-in is limited to the IT admins group (HRM_ADMIN_GROUP_IDS on the VM).
+function accessRow(appAccess?: Access): StatusRow | null {
+  if (!appAccess) return null;
+  return {
+    key: 'appAccess',
+    label: 'Who can sign in',
+    problem: appAccess !== 'limited',
+    content: appAccess === 'limited' ? <Pill tone="ok">IT admins group</Pill> : <Pill tone="warn">Not limited to a group</Pill>,
+  };
+}
+
+function rowsFor(status: Extract<ServerStatus, { reported: true }>, appAccess?: Access): StatusRow[] {
+  const has = (key: string) => status.problems.includes(key);
+  const rows: Array<StatusRow | null> = [
+    {
+      key: 'deploy',
+      label: 'Last deploy',
+      problem: has('deploy'),
+      content: status.lastDeploy ? (
+        <span className="inline-flex items-center gap-2">
+          {relative(status.lastDeploy.time)}
+          {has('deploy') && <Pill tone="bad">{deployResultLabel(status.lastDeploy.result)}</Pill>}
+        </span>
+      ) : 'Never',
+    },
+    // HRM patch 0021: the nightly off-site copy, next to the copy taken before each deploy
+    status.offsiteBackup !== undefined ? {
+      key: 'offsiteBackup',
+      label: 'Off-site backup',
+      problem: has('offsiteBackup'),
+      content: has('offsiteBackup') ? (
+        <Pill tone="bad">{status.offsiteBackup?.result === 'failed' ? 'Failed' : status.offsiteBackup ? `Last ran ${relative(status.offsiteBackup.at)}` : 'None yet'}</Pill>
+      ) : relative(status.offsiteBackup?.at ?? null),
+    } : null,
+    { key: 'backup', label: 'Backup before deploy', problem: false, content: status.lastBackup ? `${relative(status.lastBackup.at)}, ${size(status.lastBackup.sizeKb)}` : 'None yet' },
+    { key: 'updateCheck', label: 'Update check', problem: has('updateCheck'), content: has('updateCheck') ? <Pill tone="bad">Failed</Pill> : relative(status.updateCheck.at) },
+    { key: 'notifications', label: 'Update alerts', problem: has('notifications'), content: has('notifications') ? <Pill tone="bad">Failed</Pill> : relative(status.notifications.at) },
+    // HRM patch 0032: whether the server can still read what it needs from Intune; patch 0057 adds Version sync after deploy
+    ...([['intuneReads', 'Intune reads'], ['intuneSelfTest', 'Intune self-test'], ['scheduledUpdates', 'Scheduled updates'], ['versionSync', 'Version sync after deploy']] as const).map(([key, label]): StatusRow | null => {
+      const check = status.checks?.[key];
+      if (!check) return null;
+      return {
+        key,
+        label,
+        problem: !check.ok,
+        content: check.ok ? <Pill tone="ok">Working</Pill> : (
+          <span className="inline-flex flex-col items-end gap-1 text-right">
+            <Pill tone="bad">Failing</Pill>
+            {check.detail && <span className="text-xs text-text-muted max-w-xs break-words">{check.detail}</span>}
+          </span>
+        ),
+      };
+    }),
+    {
+      key: 'disk',
+      label: 'Disk',
+      problem: status.diskWarning,
+      content: status.diskWarning ? <Pill tone="warn">{Math.round(status.diskRatio * 100)}% used</Pill> : `${Math.round(status.diskRatio * 100)}% used`,
+    },
+    {
+      key: 'tunnel',
+      label: 'Tunnel',
+      problem: has('tunnel') || has('tunnelUpdate'),
+      content: has('tunnel') ? <Pill tone="bad">Not running</Pill> : has('tunnelUpdate') ? <Pill tone="warn">Update failed</Pill> : (
+        <span className="inline-flex items-center gap-2">
+          {status.tunnel.version ?? ''}
+          <Pill tone="ok">Running</Pill>
+        </span>
+      ),
+    },
+    accessRow(appAccess),
+  ];
+  return rows.filter((row): row is StatusRow => row !== null);
+}
+
+const needLabel = (count: number) => (count === 1 ? '1 needs a look' : `${count} need a look`);
+
+/**
+ * HRM patch 0058 (David's choice 3B): checks that need a look come first, with their reason, and
+ * Version stays in view. Healthy checks sit in a collapsed All checks group.
+ */
+export function ServerStatusCard({ status, loading, appAccess }: { status?: ServerStatus; loading?: boolean; appAccess?: Access }) {
+  const rows = status?.reported ? rowsFor(status, appAccess) : [];
+  const problems = rows.filter((row) => row.problem);
+  const healthy = rows.filter((row) => !row.problem);
+  const access = accessRow(appAccess);
+  return (
+    <section aria-labelledby="server-status-title" className="glass-light rounded-xl p-5 border-t-4 border-t-accent-violet-bright">
+      <div className="flex items-center gap-2 mb-3">
+        <Server className="w-5 h-5 text-accent-cyan" aria-hidden="true" />
+        <h2 id="server-status-title" className="text-lg font-semibold text-text-primary">Server status</h2>
+        {status?.reported && (
+          <span className="ml-auto">{problems.length === 0 ? <Pill tone="ok">Healthy</Pill> : <Pill tone="warn">{needLabel(problems.length)}</Pill>}</span>
+        )}
+      </div>
+
+      {loading && !status ? (
+        <Loader2 className="w-5 h-5 text-text-secondary animate-spin" aria-label="Loading server status" />
+      ) : !status?.reported ? (
+        <>
+          <p className="text-sm text-text-muted">
+            {status?.reason === 'stale'
+              ? `Last status report ${relative(status.generatedAt)}. The server's status timer may have stopped.`
+              : 'Status not reported. The status timer on the server may not be installed yet.'}
+          </p>
+          {access && <dl className="mt-2"><Row label={access.label}>{access.content}</Row></dl>}
+        </>
+      ) : (
+        <>
+          <dl>
+            {problems.map((row) => <Row key={row.key} label={row.label}>{row.content}</Row>)}
+            <Row label="Version">{status.version ?? 'Unknown'}</Row>
+          </dl>
+          {healthy.length > 0 && (
+            <details className="mt-2 group" data-testid="server-status-all-checks">
+              <summary className="cursor-pointer rounded text-sm text-accent-cyan hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-cyan">
+                All checks ({healthy.length} working)
+                <span className="block text-xs text-text-muted">{healthy.slice(0, 4).map((row) => row.label).join(', ')}{healthy.length > 4 ? '…' : ''}</span>
+              </summary>
+              <dl className="mt-2">
+                {healthy.map((row) => <Row key={row.key} label={row.label}>{row.content}</Row>)}
+              </dl>
+            </details>
+          )}
+        </>
+      )}
+    </section>
+  );
+}
