+'use client';
+
+// HRM patch: Home page data from /api/hrm/home.
+
+import { useQuery } from '@tanstack/react-query';
+import { useMicrosoftAuth } from '@/hooks/useMicrosoftAuth';
+import type { ServerStatus } from '@/lib/hrm/home';
+
+export interface HrmHomeData {
+  attention: { failedRecent: number; stuck: number } | null;
+  server: ServerStatus;
+  // HRM patch 0019
+  installFailures?: Array<{ displayName: string; intuneAppId: string; failed: number }>;
+  // HRM patch 0032
+  unreached?: Array<{ displayName: string; intuneAppId: string; deployedAt: string }>;
+  // HRM patch 0039: newest copies whose previous installer is gone or has changed
+  rollbackGaps?: Array<{ displayName: string; intuneAppId: string; previousVersion: string }>;
+  // HRM patch 0042: old copies IntuneGet couldn't remove after an update
+  oldCopiesKept?: Array<{ displayName: string; intuneAppId: string; version: string; newestAppId: string; reason: string }>;
+  // HRM patch 0056: whether sign-in is limited to the IT admins group
+  appAccess?: 'limited' | 'not_limited';
+}
+
+export function useHrmHome() {
+  const { getAccessToken, isAuthenticated } = useMicrosoftAuth();
+  return useQuery<HrmHomeData>({
+    queryKey: ['hrm', 'home'],
+    queryFn: async () => {
+      const token = await getAccessToken();
+      if (!token) throw new Error('Not authenticated');
+      const response = await fetch('/api/hrm/home', { headers: { Authorization: `Bearer ${token}` } });
+      if (!response.ok) throw new Error('Failed to load the Home page');
+      return response.json();
+    },
+    enabled: isAuthenticated,
+    refetchInterval: 60 * 1000,
+  });
+}
