@@ -0,0 +1,97 @@
+// @vitest-environment happy-dom
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { act, createElement } from 'react';
+import { createRoot, type Root } from 'react-dom/client';
+
+const push = vi.fn();
+const state = vi.hoisted(() => ({ path: '/dashboard' }));
+vi.mock('next/navigation', () => ({ useRouter: () => ({ push }), usePathname: () => state.path }));
+vi.mock('gt-next', () => ({ T: ({ children }: { children: unknown }) => children }));
+
+import { CommandPalette } from '../CommandPalette';
+
+// HRM patch: the palette must take the keyboard as soon as it opens.
+describe('CommandPalette keyboard', () => {
+  let container: HTMLDivElement;
+  let root: Root;
+  const onOpenChange = vi.fn();
+
+  beforeEach(async () => {
+    (globalThis as { IS_REACT_ACT_ENVIRONMENT?: boolean }).IS_REACT_ACT_ENVIRONMENT = true;
+    Element.prototype.scrollIntoView = vi.fn();
+    push.mockReset();
+    state.path = '/dashboard';
+    onOpenChange.mockReset();
+    container = document.createElement('div');
+    document.body.appendChild(container);
+    root = createRoot(container);
+    await act(async () => {
+      root.render(createElement(CommandPalette, { open: true, onOpenChange }));
+    });
+  });
+
+  afterEach(async () => {
+    await act(async () => root.unmount());
+    container.remove();
+  });
+
+  const input = () => document.querySelector<HTMLInputElement>('[cmdk-input]')!;
+  const selected = () => document.querySelector('[cmdk-item][data-selected="true"]')?.textContent;
+  const key = async (k: string) => {
+    await act(async () => {
+      document.activeElement!.dispatchEvent(new KeyboardEvent('keydown', { key: k, bubbles: true, cancelable: true }));
+    });
+  };
+
+  it('opens as a labelled dialog with the cursor in the search box', () => {
+    expect(document.querySelector('[role="dialog"]')).not.toBeNull();
+    expect(document.activeElement).toBe(input());
+  });
+
+  it('moves through the commands with the arrow keys and opens one with Enter', async () => {
+    expect(selected()).toBe('Home');
+    await key('ArrowDown');
+    expect(selected()).toBe('App catalog');
+    await key('ArrowUp');
+    expect(selected()).toBe('Home');
+    await key('ArrowDown');
+    await key('Enter');
+    expect(push).toHaveBeenCalledWith('/dashboard/apps');
+    expect(onOpenChange).toHaveBeenCalledWith(false);
+  });
+
+  // HRM patch 0053: pages in the sidebar's order, and the new G shortcuts listed.
+  it('lists pages in sidebar order and shows the new G shortcuts', () => {
+    const pages = [...document.querySelectorAll('[cmdk-item]:not([aria-disabled="true"])')].map((el) => el.textContent);
+    expect(pages).toEqual(['Home', 'App catalog', 'Inventory', 'Discovered apps', 'App updates', 'Deployments', 'Reports', 'New version checks', 'Automatic publishing window', 'How automatic updates install guide', 'Installation settings guide', 'Settings', 'Help']);
+    const text = document.querySelector('[role="dialog"]')!.textContent;
+    for (const hint of ['Go to App updates', 'Go to Discovered apps', 'Go to Help']) expect(text).toContain(hint);
+  });
+
+  it('offers scoped review links only for a concrete app workspace', async () => {
+    expect(document.body.textContent).not.toContain('Review future updates');
+    state.path = '/dashboard/inventory/11111111-1111-4111-8111-111111111111';
+    await act(async () => root.render(createElement(CommandPalette, { open: true, onOpenChange })));
+    const next = [...document.querySelectorAll<HTMLElement>('[cmdk-item]')].find(el => el.textContent === 'Review future updates')!;
+    expect(next.getAttribute('data-value')).toContain('edit next rollout');
+    await act(async () => next.click());
+    expect(push).toHaveBeenCalledWith(state.path + '#next-rollout');
+  });
+
+  it('closes with Escape', async () => {
+    await key('Escape');
+    expect(onOpenChange).toHaveBeenCalledWith(false);
+  });
+
+  it.each(['installer decides', 'progress only', 'more settings', 'toolkit windows'])('finds the installation guide through %s and opens its stable link', async (alias) => {
+    await act(async () => {
+      Object.getOwnPropertyDescriptor(HTMLInputElement.prototype, 'value')!.set!.call(input(), alias);
+      input().dispatchEvent(new Event('input', { bubbles: true }));
+    });
+    const guide = [...document.querySelectorAll<HTMLElement>('[cmdk-item]')].find(el => el.textContent === 'Installation settings guide');
+    expect(guide).toBeDefined();
+    expect(guide!.getAttribute('data-value')).toContain(alias);
+    await act(async () => guide!.click());
+    expect(push).toHaveBeenCalledWith('/dashboard/help#install-settings');
+  });
+});
