@@ -0,0 +1,19 @@
+'use client';
+import Link from 'next/link';
+import { usePathname } from 'next/navigation';
+import { motion, useReducedMotion } from 'framer-motion';
+import { sectionPages } from '@/lib/hrm/navigation';
+
+/** Section routes remain ordinary links, preserving bookmarks and browser history. */
+export function SectionNavigation() {
+  const path = usePathname();
+  const pages = sectionPages(path);
+  const reduced = useReducedMotion();
+  if (!pages.length) return null;
+  return <nav aria-label={pages[0].name === 'Inventory' ? 'Apps pages' : 'Activity pages'} className="mb-5 flex flex-wrap gap-1 border-b border-overlay/10 pb-3">{pages.map(page => {
+    const active = path === page.href || path.startsWith(page.href + '/');
+    return <Link key={page.href} href={page.href} aria-current={active ? path === page.href ? 'page' : 'location' : undefined} className={`relative rounded-lg px-3 py-2 text-sm font-medium transition-colors motion-reduce:transition-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-cyan ${active ? 'text-accent-cyan dark:text-accent-cyan-bright font-semibold' : 'text-text-secondary hover:bg-overlay/5 hover:text-text-primary'}`}>
+      {active && <motion.span layoutId={reduced ? undefined : 'section-page'} transition={reduced ? { duration: 0 } : { duration: 0.15 }} className="absolute inset-0 rounded-lg bg-accent-cyan/12 dark:bg-accent-cyan/20 ring-1 ring-inset ring-accent-cyan/25 dark:ring-accent-cyan/35" aria-hidden="true" />}<span className="relative">{page.name}</span>
+    </Link>;
+  })}</nav>;
+}
