new file mode 100644
index 000000000..11c2d2f6c
--- /dev/null
+++ b/hooks/use-database-mode.ts
@@ -0,0 +1,23 @@
+'use client';
+
+import { useEffect, useState } from 'react';
+
+// HRM patch 0035: which database the server runs, read once from /api/health.
+// null until known. Used to hide options that only take effect in Supabase mode.
+let cached: Promise<'sqlite' | 'supabase' | null> | null = null;
+
+export function useDatabaseMode(): 'sqlite' | 'supabase' | null {
+  const [mode, setMode] = useState<'sqlite' | 'supabase' | null>(null);
+  useEffect(() => {
+    let active = true;
+    cached ??= fetch('/api/health', { cache: 'no-store' })
+      .then((res) => (res.ok || res.status === 503 ? res.json() : null))
+      .then((body: { databaseMode?: unknown } | null) =>
+        body?.databaseMode === 'sqlite' || body?.databaseMode === 'supabase' ? body.databaseMode : null)
+      .catch(() => null)
+      .then((value) => { if (value === null) cached = null; return value; });
+    cached.then((value) => { if (active) setMode(value); });
+    return () => { active = false; };
+  }, []);
+  return mode;
+}
