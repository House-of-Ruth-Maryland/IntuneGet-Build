+  it('still sends signed-out visitors of the dashboard to sign-in', async () => {
+    const response = await get('/dashboard');
+    expect(new URL(response.headers.get('location')!).pathname).toBe('/auth/signin');
+  });
+});
+
+// HRM patch 0036: one address for webhook links and the status report.
+describe('serverHttpsOrigin', () => {
+  it('prefers NEXT_PUBLIC_URL and falls back to NEXT_PUBLIC_APP_URL', () => {
+    expect(serverHttpsOrigin({ NEXT_PUBLIC_URL: 'https://a.example.test', NEXT_PUBLIC_APP_URL: 'https://b.example.test' })).toBe('https://a.example.test');
+    expect(serverHttpsOrigin({ NEXT_PUBLIC_APP_URL: 'https://b.example.test/' })).toBe('https://b.example.test');
+  });
+
+  it('skips an http or credential-bearing NEXT_PUBLIC_URL', () => {
+    expect(serverHttpsOrigin({ NEXT_PUBLIC_URL: 'http://localhost:3000', NEXT_PUBLIC_APP_URL: 'https://b.example.test' })).toBe('https://b.example.test');
+    expect(serverHttpsOrigin({ NEXT_PUBLIC_URL: 'https://u:p@a.example.test' })).toBeUndefined();
+  });
+
+  it('keeps only the origin and rejects junk', () => {
+    expect(serverHttpsOrigin({ NEXT_PUBLIC_URL: 'https://a.example.test/x?y=1#z' })).toBe('https://a.example.test');
+    expect(serverHttpsOrigin({ NEXT_PUBLIC_URL: 'not a url' })).toBeUndefined();
+    expect(serverHttpsOrigin({})).toBeUndefined();
+  });
+});
+
+// HRM patch 0036: hidden upstream sections don't open by address either.
+describe('hidden dashboard sections', () => {
+  it('redirects SCCM, app requests, MSP and Account pages to Home', async () => {
+    for (const path of ['/dashboard/sccm', '/dashboard/sccm/new', '/dashboard/app-requests', '/dashboard/msp', '/dashboard/msp/team', '/dashboard/account']) {
+      const response = await get(path);
+      expect(response.status, path).toBe(307);
+      expect(new URL(response.headers.get('location')!).pathname, path).toBe('/dashboard');
+    }
+  });
+
+  it('leaves similar-looking and visible pages alone', () => {
+    for (const path of ['/dashboard', '/dashboard/settings', '/dashboard/mspx', '/dashboard/sccm-help', '/api/msp/tenants', '/dashboard/accounts-report', '/api/account']) {
+      expect(isHiddenDashboardPath(path), path).toBe(false);
+    }
+  });
+});
diff --git a/lib/hrm/home.ts b/lib/hrm/home.ts
new file mode 100644
index 000000000..c9fc01031
--- /dev/null
+++ b/lib/hrm/home.ts
@@ -0,0 +1,164 @@
+/**
+ * HRM patch: data for the Home page's "Needs attention" and "Server status".
+ *
+ * The VM writes hrm-status.json next to the database every 5 minutes
+ * (IntuneGet-Build deploy/intuneget-status.sh). The app only reads it.
+ */
+
+import { open } from 'fs/promises';
+import path from 'path';
+import type { AnalyticsJob, UploadHistoryRecord } from '@/lib/db/types';
+import type { InstallStatusRecord } from './install-status';
+
+export const STATUS_STALE_AFTER_MS = 15 * 60 * 1000;
+export const STUCK_AFTER_MS = 2 * 60 * 60 * 1000;
+export const RECENT_FAILURE_MS = 7 * 24 * 60 * 60 * 1000;
+export const DISK_WARNING_RATIO = 0.85;
+// HRM patch 0021: the off-site backup runs nightly; no success for 36 hours is a problem.
+export const OFFSITE_STALE_AFTER_MS = 36 * 60 * 60 * 1000;
+
+interface UnitRun { result: string | null; at: string | null }
+/** HRM patch 0032: a verdict the VM status script already worked out; null when not set up. */
+export interface StatusCheck { ok: boolean; at: string | null; detail: string | null }
+// HRM patch 0057 adds versionSync: App updates not corrected after 2 or more deploys in 24 hours.
+export const STATUS_CHECKS = ['intuneReads', 'intuneSelfTest', 'scheduledUpdates', 'versionSync'] as const;
+export type StatusCheckKey = (typeof STATUS_CHECKS)[number];
+
+export interface ServerStatusFile {
+  generatedAt: string;
+  version: string | null;
+  startedAt: string | null;
+  lastDeploy: { time: string; result: string; from: string; to: string } | null;
+  lastBackup: { at: string | null; sizeKb: number } | null;
+  // HRM patch 0021: the nightly copy to Azure Storage (deploy/intuneget-backup.py)
+  offsiteBackup?: { result: string | null; at: string | null; compressedBytes?: number } | null;
+  disk: { totalKb: number; usedKb: number };
+  updateCheck: UnitRun;
+  notifications: UnitRun;
+  tunnel: { version: string | null; running: boolean; lastUpdate: UnitRun };
+  checks?: Partial<Record<StatusCheckKey, StatusCheck | null>>;
+}
+
+export type ServerStatus =
+  | { reported: false; reason: 'missing' | 'stale' | 'unreadable'; generatedAt?: string }
+  | ({ reported: true; diskRatio: number; diskWarning: boolean; problems: string[] } & ServerStatusFile);
+
+export function statusFilePath(): string {
+  const dbPath = process.env.DATABASE_PATH || './data/intuneget.db';
+  return path.join(path.dirname(dbPath), 'hrm-status.json');
+}
+
+/** Interprets the status file. Anything old or malformed is "not reported", never guessed. */
+export function interpretServerStatus(raw: string | null, now = new Date()): ServerStatus {
+  if (raw === null) return { reported: false, reason: 'missing' };
+  let file: ServerStatusFile;
+  try {
+    file = JSON.parse(raw);
+    if (!file || typeof file.generatedAt !== 'string' || !file.disk) throw new Error('shape');
+  } catch {
+    return { reported: false, reason: 'unreadable' };
+  }
+  const generated = Date.parse(file.generatedAt);
+  if (!Number.isFinite(generated) || now.getTime() - generated > STATUS_STALE_AFTER_MS) {
+    return { reported: false, reason: 'stale', generatedAt: file.generatedAt };
+  }
+  const diskRatio = file.disk.totalKb > 0 ? file.disk.usedKb / file.disk.totalKb : 0;
+  const problems: string[] = [];
+  if (diskRatio >= DISK_WARNING_RATIO) problems.push('disk');
+  if (file.lastDeploy && !['deployed', 'waiting'].includes(file.lastDeploy.result)) problems.push('deploy');
+  if (file.updateCheck?.result && file.updateCheck.result !== 'success') problems.push('updateCheck');
+  if (file.notifications?.result && file.notifications.result !== 'success') problems.push('notifications');
+  if (file.offsiteBackup !== undefined) {
+    const at = Date.parse(file.offsiteBackup?.at ?? '');
+    if (file.offsiteBackup?.result !== 'success' || !Number.isFinite(at) || now.getTime() - at > OFFSITE_STALE_AFTER_MS) {
+      problems.push('offsiteBackup');
+    }
+  }
+  for (const key of STATUS_CHECKS) if (file.checks?.[key]?.ok === false) problems.push(key);
+  if (!file.tunnel?.running) problems.push('tunnel');
+  else if (file.tunnel.lastUpdate?.result && file.tunnel.lastUpdate.result !== 'success') problems.push('tunnelUpdate');
+  return { ...file, reported: true, diskRatio, diskWarning: diskRatio >= DISK_WARNING_RATIO, problems };
+}
+
+// HRM patch 0036: Home and the IT dashboard status report read the status file through one
+// bounded reader, so neither parses more than 32 KB.
+export const STATUS_FILE_MAX_BYTES = 32_768;
+export class StatusFileTooLargeError extends Error {
+  constructor() { super('Report unavailable'); }
+}
+
+/** The status file's text, or null when it doesn't exist. Throws if it is over 32 KB or unreadable. */
+export async function readStatusFileText(signal?: AbortSignal): Promise<string | null> {
+  let file;
+  try {
+    file = await open(statusFilePath(), 'r');
+  } catch (error) {
+    if ((error as NodeJS.ErrnoException).code === 'ENOENT') return null;
+    throw error;
+  }
+  try {
+    signal?.throwIfAborted();
+    if ((await file.stat()).size > STATUS_FILE_MAX_BYTES) throw new StatusFileTooLargeError();
+    const buffer = Buffer.alloc(STATUS_FILE_MAX_BYTES + 1);
+    const { bytesRead } = await file.read(buffer, 0, buffer.length, 0);
+    signal?.throwIfAborted();
+    if (bytesRead > STATUS_FILE_MAX_BYTES) throw new StatusFileTooLargeError();
+    return buffer.toString('utf8', 0, bytesRead);
+  } finally {
+    await file.close();
+  }
+}
+
+export async function readServerStatus(now = new Date()): Promise<ServerStatus> {
+  let raw: string | null = null;
+  try {
+    raw = await readStatusFileText();
+  } catch (error) {
+    if (error instanceof StatusFileTooLargeError) return { reported: false, reason: 'unreadable' };
+    raw = null;
+  }
+  return interpretServerStatus(raw, now);
+}
+
+const PENDING = new Set(['queued', 'packaging', 'uploading']);
+
+/** Tenant-wide failures in the last 7 days and jobs pending for more than 2 hours. */
+export function attentionCounts(jobs: Pick<AnalyticsJob, 'status' | 'created_at'>[], now = new Date()) {
+  let failedRecent = 0;
+  let stuck = 0;
+  for (const job of jobs) {
+    const created = Date.parse(job.created_at ?? '');
+    if (!Number.isFinite(created)) continue;
+    const age = now.getTime() - created;
+    if (job.status === 'failed' && age <= RECENT_FAILURE_MS) failedRecent++;
+    else if (PENDING.has(job.status) && age > STUCK_AFTER_MS) stuck++;
+  }
+  return { failedRecent, stuck };
+}
+
+// HRM patch 0032: an app deployed this long ago that no device has, installs or is trying to install.
+export const UNREACHED_AFTER_MS = 3 * 24 * 60 * 60 * 1000;
+const FRESH_COUNTS_MS = 2 * 24 * 60 * 60 * 1000;
+
+/**
+ * Deployed apps that reach no devices: Intune reports nothing installed, pending or failed. Usually an
+ * empty group, a group with no devices or a wrong assignment. Only recent counts and the newest copy
+ * of each app count, so an old copy or a stale check never raises it.
+ */
+export function unreachedApps(
+  installs: Pick<InstallStatusRecord, 'intune_app_id' | 'display_name' | 'installed' | 'pending' | 'failed' | 'checked_at'>[],
+  deployments: Pick<UploadHistoryRecord, 'intune_app_id' | 'deployed_at'>[],
+  now = new Date(),
+): Array<{ displayName: string; intuneAppId: string; deployedAt: string }> {
+  const deployedAt = new Map<string, string>();
+  for (const d of deployments) if (d.intune_app_id && d.deployed_at && !deployedAt.has(d.intune_app_id.toLowerCase())) deployedAt.set(d.intune_app_id.toLowerCase(), d.deployed_at);
+  return installs.flatMap((app) => {
+    const at = deployedAt.get(app.intune_app_id.toLowerCase());
+    const deployed = Date.parse(at ?? '');
+    const checked = Date.parse(app.checked_at);
+    if (!at || !Number.isFinite(deployed) || now.getTime() - deployed < UNREACHED_AFTER_MS) return [];
+    if (!Number.isFinite(checked) || now.getTime() - checked > FRESH_COUNTS_MS) return [];
+    if (app.installed + app.pending + app.failed > 0) return [];
+    return [{ displayName: app.display_name, intuneAppId: app.intune_app_id, deployedAt: at }];
+  });
+}
