+import { beforeEach, afterEach, expect, it, vi } from 'vitest';
+import { NextRequest } from 'next/server';
+const state=vi.hoisted(()=>{vi.stubEnv('DATABASE_MODE','sqlite');vi.stubEnv('DATABASE_PATH',':memory:');return {auth:true};});
+vi.mock('@/lib/auth-utils',()=>({parseAccessToken:async()=>state.auth?{userId:'owner',tenantId:'tenant'}:null}));
+vi.mock('@/lib/db',async()=>({getDatabase:() => sqliteDb}));
+import { sqliteDb,closeSqliteDb } from '@/lib/db/sqlite';
+import { POST } from './route';
+const call=(body={})=>POST(new NextRequest('http://localhost/api/package/clear-history',{method:'POST',body:JSON.stringify(body)}));
+const create=(status:string,user='owner')=>sqliteDb.jobs.create({user_id:user,tenant_id:'tenant',winget_id:'Example.App',version:'1',display_name:'Example',installer_type:'msi',installer_url:'https://example.invalid/a.msi',status});
+beforeEach(()=>{closeSqliteDb();state.auth=true;});afterEach(()=>closeSqliteDb());
+it('archives cancelled and QA-failed history but preserves active jobs, foreign jobs and audit rows',async()=>{
+ const cancelled=await create('cancelled'),qa=await create('qa_failed'),active=await create('packaging'),foreign=await create('cancelled','other');
+ const response=await call();expect(response.status).toBe(200);expect(await response.json()).toMatchObject({archivedCount:2});
+ expect(await sqliteDb.jobs.getById(cancelled.id)).toMatchObject({status:'cancelled',archived_at:expect.any(String)});
+ expect((await sqliteDb.jobs.getById(qa.id))?.archived_at).toBeTruthy();
+ expect((await sqliteDb.jobs.getById(active.id))?.archived_at).toBeNull();
+ expect((await sqliteDb.jobs.getById(foreign.id))?.archived_at).toBeNull();
+ expect((await (await call()).json()).archivedCount).toBe(0);
+});
+it('rejects clearing active statuses and requires authentication',async()=>{
+ const active=await create('queued');expect((await call({statuses:['queued']})).status).toBe(400);
+ state.auth=false;expect((await call()).status).toBe(401);expect((await sqliteDb.jobs.getById(active.id))?.archived_at).toBeNull();
+});
+it('clears only cancellations when that outcome is selected',async()=>{
+ const cancelled=await create('cancelled'),failed=await create('failed');
+ const response=await call({statuses:['cancelled']});
+ expect(await response.json()).toMatchObject({archivedCount:1});
+ expect((await sqliteDb.jobs.getById(cancelled.id))?.archived_at).toBeTruthy();
+ expect((await sqliteDb.jobs.getById(failed.id))?.archived_at).toBeNull();
+});
