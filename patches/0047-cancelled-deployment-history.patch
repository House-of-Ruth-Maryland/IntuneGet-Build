@@ -0,0 +1,21 @@
+import { expect, it } from 'vitest';
+import { deploymentCounts, deploymentFilter, matchesDeploymentFilter, isTerminalDeployment, clearableDeploymentStatuses } from '../deployment-status';
+it('keeps cancellation out of failures while including failed installation tests', () => {
+  const statuses=['queued','awaiting_qa','deployed','failed','qa_failed','cancelled'];
+  expect(deploymentCounts(statuses.map(status=>({status})))).toEqual({total:6,active:2,completed:1,failed:2,cancelled:1});
+  expect(statuses.filter(status=>matchesDeploymentFilter(status,'failed'))).toEqual(['failed','qa_failed']);
+  expect(statuses.filter(status=>matchesDeploymentFilter(status,'cancelled'))).toEqual(['cancelled']);
+  expect(isTerminalDeployment('cancelled')).toBe(true);
+  expect(isTerminalDeployment('awaiting_qa')).toBe(false);
+});
+it('accepts cancelled bookmarks and preserves the old pending alias', () => {
+  expect(deploymentFilter('cancelled')).toBe('cancelled');
+  expect(deploymentFilter('pending')).toBe('active');
+  expect(deploymentFilter('unknown')).toBe('all');
+});
+
+it('limits clearing to the selected finished outcome and never active jobs',()=>{
+ expect(clearableDeploymentStatuses('cancelled')).toEqual(['cancelled']);
+ expect(clearableDeploymentStatuses('failed')).toEqual(['failed','qa_failed']);
+ expect(clearableDeploymentStatuses('active')).toEqual([]);
+});
diff --git a/lib/hrm/deployment-status.ts b/lib/hrm/deployment-status.ts
new file mode 100644
index 000000000..23bca92e9
--- /dev/null
+++ b/lib/hrm/deployment-status.ts
@@ -0,0 +1,28 @@
+/** Shared display/archival groups. Cancellation is a distinct finished outcome. */
+export const DEPLOYMENT_FILTERS = ['all', 'active', 'completed', 'failed', 'cancelled'] as const;
+export type DeploymentFilter = typeof DEPLOYMENT_FILTERS[number];
+export const ACTIVE_DEPLOYMENT_STATUSES: readonly string[] = ['blocked_upstream', 'awaiting_qa', 'queued', 'packaging', 'uploading'];
+export const COMPLETED_DEPLOYMENT_STATUSES: readonly string[] = ['completed', 'deployed', 'duplicate_skipped'];
+export const FAILED_DEPLOYMENT_STATUSES: readonly string[] = ['failed', 'qa_failed'];
+export const TERMINAL_DEPLOYMENT_STATUSES: readonly string[] = [...COMPLETED_DEPLOYMENT_STATUSES, ...FAILED_DEPLOYMENT_STATUSES, 'cancelled'];
+export const isActiveDeployment = (status: string) => ACTIVE_DEPLOYMENT_STATUSES.includes(status);
+export const isTerminalDeployment = (status: string) => TERMINAL_DEPLOYMENT_STATUSES.includes(status);
+export function deploymentFilter(value: string | null): DeploymentFilter {
+  if (value === 'pending') return 'active';
+  return DEPLOYMENT_FILTERS.includes(value as DeploymentFilter) ? value as DeploymentFilter : 'all';
+}
+export function matchesDeploymentFilter(status: string, filter: DeploymentFilter): boolean {
+  if (filter === 'all') return true;
+  if (filter === 'active') return isActiveDeployment(status);
+  if (filter === 'completed') return COMPLETED_DEPLOYMENT_STATUSES.includes(status);
+  if (filter === 'failed') return FAILED_DEPLOYMENT_STATUSES.includes(status);
+  return status === 'cancelled';
+}
+export function deploymentCounts(jobs: { status: string }[]) {
+  return { total: jobs.length, active: jobs.filter(j => isActiveDeployment(j.status)).length,
+    completed: jobs.filter(j => COMPLETED_DEPLOYMENT_STATUSES.includes(j.status)).length,
+    failed: jobs.filter(j => FAILED_DEPLOYMENT_STATUSES.includes(j.status)).length,
+    cancelled: jobs.filter(j => j.status === 'cancelled').length };
+}
+/** Clearing a filtered list never hides a different finished outcome. */
+export const clearableDeploymentStatuses = (filter: DeploymentFilter) => TERMINAL_DEPLOYMENT_STATUSES.filter(status => matchesDeploymentFilter(status, filter));
