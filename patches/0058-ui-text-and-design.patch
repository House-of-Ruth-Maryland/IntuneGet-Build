+// @vitest-environment happy-dom
+// HRM patch 0058 (choice 5B): the No access page shows the signed-in account and offers another one.
+import { act, createElement } from 'react';
+import { createRoot, type Root } from 'react-dom/client';
+import { afterEach, beforeEach, expect, it, vi } from 'vitest';
+import { AccessDenied, HRM_SUPPORT_URL } from './AccessDenied';
+(globalThis as typeof globalThis & { IS_REACT_ACT_ENVIRONMENT: boolean }).IS_REACT_ACT_ENVIRONMENT = true;
+
+let root: Root;
+beforeEach(() => { const node = document.createElement('div'); document.body.append(node); root = createRoot(node); });
+afterEach(async () => { await act(async () => root.unmount()); document.body.innerHTML = ''; });
+const button = (label: string) => [...document.querySelectorAll('button')].find((b) => b.textContent?.trim() === label);
+
+it('names the account, links HRM Support and offers another account', async () => {
+  const onSwitchAccount = vi.fn();
+  const onSignOut = vi.fn();
+  await act(async () => root.render(createElement(AccessDenied, { account: 'staff@example.test', onRetry: vi.fn(), onSwitchAccount, onSignOut })));
+  expect(document.querySelector('h1')?.textContent).toBe('No access to IntuneGet');
+  expect(document.body.textContent).toContain('Ask HRM Support (opens in a new tab) to add you to the IT admins group.');
+  expect(document.body.textContent).not.toContain('https://');
+  expect(document.querySelector('a')?.getAttribute('href')).toBe(HRM_SUPPORT_URL);
+  expect(document.querySelector('[data-testid="access-denied-account"]')?.textContent).toBe('Signed in as staff@example.test');
+  expect(button('Try again')).toBeUndefined();
+  await act(async () => button('Sign in with another account')!.click());
+  expect(onSwitchAccount).toHaveBeenCalledOnce();
+  await act(async () => button('Sign out')!.click());
+  expect(onSignOut).toHaveBeenCalledOnce();
+});
+
+it('says what to do when the check failed, and hides the account line when unknown', async () => {
+  const onRetry = vi.fn();
+  await act(async () => root.render(createElement(AccessDenied, { unavailable: true, account: null, onRetry, onSwitchAccount: vi.fn(), onSignOut: vi.fn() })));
+  expect(document.querySelector('h1')?.textContent).toBe("Couldn't check your access");
+  expect(document.body.textContent).toContain('Try again in a minute. If this keeps happening, tell HRM Support');
+  expect(document.querySelector('[data-testid="access-denied-account"]')).toBeNull();
+  await act(async () => button('Try again')!.click());
+  expect(onRetry).toHaveBeenCalledOnce();
+});
