+describe('failure cutoff (HRM patch 0032)', () => {
+  it('keeps counting failures when a new attempt starts, so 3 in a row turn auto-update off', async () => {
+    const { db, runSqliteUpdateCheck } = await load();
+    const policy = await seedDeployment(db);
+    getAppsByWingetIdsMock.mockResolvedValue([{ winget_id: 'Vendor.App', name: 'Vendor App', latest_version: '1.1.0' }]);
+    getLatestInstallerInfoMock.mockResolvedValue(installerResolution());
+    for (let attempt = 1; attempt <= 3; attempt++) {
+      expect((await runSqliteUpdateCheck(db)).triggered).toBe(1);
+      const queued = (await db.jobs.getByTenantId('t1')).find((j) => j.status === 'queued')!;
+      await db.jobs.update(queued.id, { status: 'failed', error_code: 'PACKAGE_CREATION_FAILED', error_message: 'packaging failed', completed_at: new Date().toISOString() });
+      // The cooldown is about pace, not this rule.
+      const { closeSqliteDb } = await import('@/lib/db/sqlite');
+      closeSqliteDb();
+      const Database = (await import('better-sqlite3')).default;
+      const raw = new Database(process.env.DATABASE_PATH!);
+      raw.prepare("UPDATE auto_update_history SET triggered_at = '2000-01-01T00:00:00Z'").run();
+      raw.close();
+      expect(await db.updatePolicies.getById(policy.id, 'u1')).toMatchObject({ consecutive_failures: attempt, is_enabled: attempt < 3 });
+    }
+    expect((await runSqliteUpdateCheck(db)).triggered).toBe(0);
+  });
+});
