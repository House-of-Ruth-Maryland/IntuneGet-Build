+function fallbackGroups(groups: string[]): ManualReviewGroup[] {
+  return groups.map((entry, index) => {
+    const parts = entry.split(' · ');
+    const label = parts[0] || entry;
+    const rawIntent = (parts[1] || '').trim().toLowerCase();
+    const intent: ManualReviewGroup['intent'] =
+      rawIntent === 'excluded' ? 'excluded'
+        : rawIntent === 'required' ? 'required'
+          : rawIntent === 'available' || rawIntent === 'availablewithoutenrollment' ? 'available'
+            : rawIntent === 'uninstall' ? 'uninstall'
+              : 'other';
+    const intentLabel =
+      intent === 'excluded' ? 'Excluded'
+        : intent === 'required' ? 'Required'
+          : intent === 'available' ? 'Available'
+            : intent === 'uninstall' ? 'Uninstall'
+              : parts[1] || 'Assigned';
+    const filter = parts.length > 2 ? parts.slice(2).join(' · ') : null;
+    return { id: String(index), label, intent, intentLabel, filter };
+  });
