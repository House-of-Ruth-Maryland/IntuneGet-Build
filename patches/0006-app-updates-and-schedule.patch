+describe('update schedule and blackouts (HRM patch 0030)', () => {
+  beforeEach(() => { vi.stubEnv('DATABASE_MODE', 'sqlite'); });
+  afterEach(() => { vi.unstubAllEnvs(); });
+  // Wednesday 2026-11-04, 10 AM Maryland time
+  const morning = new Date('2026-11-04T15:00:00Z');
+  const evening = new Date('2026-11-04T23:30:00Z');
+  async function scheduled() {
+    const loaded = await load();
+    const { sqliteUpdateSchedule } = await import('@/lib/db/sqlite');
+    const { runSqliteScheduledUpdates } = await import('@/lib/auto-update/sqlite');
+    await seedDeployment(loaded.db);
+    getAppsByWingetIdsMock.mockResolvedValue([{ winget_id: 'Vendor.App', name: 'Vendor App', latest_version: '1.1.0' }]);
+    getLatestInstallerInfoMock.mockResolvedValue(installerResolution());
+    return { ...loaded, store: sqliteUpdateSchedule, runSqliteScheduledUpdates };
+  }
+
+  it('starts updates as before when no schedule is set, and the hourly run does nothing', async () => {
+    const { db, runSqliteUpdateCheck, runSqliteScheduledUpdates } = await scheduled();
+    expect(await runSqliteScheduledUpdates(db, { now: morning })).toMatchObject({ tenants: 0, triggered: 0 });
+    expect(await runSqliteUpdateCheck(db, { now: morning })).toMatchObject({ available: 1, triggered: 1, held: 0 });
+  });
+
+  it('holds a due update outside the schedule, then the hourly run starts it once the schedule opens', async () => {
+    const { db, store, runSqliteUpdateCheck, runSqliteScheduledUpdates } = await scheduled();
+    store.save('t1', { enabled: true, days: [1, 2, 3, 4], startHour: 18, endHour: 22 });
+    expect(await runSqliteUpdateCheck(db, { now: morning })).toMatchObject({ available: 1, triggered: 0, held: 1 });
+    expect(await db.jobs.getByTenantId('t1')).toHaveLength(0);
+    expect(await runSqliteScheduledUpdates(db, { now: morning })).toMatchObject({ tenants: 0, triggered: 0 });
+    expect(await runSqliteScheduledUpdates(db, { now: evening })).toMatchObject({ tenants: 1, triggered: 1 });
+    expect(await db.jobs.getByTenantId('t1')).toHaveLength(1);
+    // Already started for this version: the next hour starts nothing new.
+    expect(await runSqliteScheduledUpdates(db, { now: new Date(evening.getTime() + 3600000) })).toMatchObject({ triggered: 0 });
+  });
+
+  it('holds updates during a blackout even inside the schedule', async () => {
+    const { db, store, runSqliteScheduledUpdates, runSqliteUpdateCheck } = await scheduled();
+    store.save('t1', { enabled: true, days: [0, 1, 2, 3, 4, 5, 6], startHour: 0, endHour: 24 });
+    store.addBlackout('t1', { startsOn: '2026-11-04', endsOn: '2026-11-04', label: 'Month-end close' });
+    expect(await runSqliteUpdateCheck(db, { now: evening })).toMatchObject({ triggered: 0, held: 1 });
+    expect(await runSqliteScheduledUpdates(db, { now: evening })).toMatchObject({ tenants: 0, triggered: 0 });
+    expect(await runSqliteScheduledUpdates(db, { now: new Date('2026-11-05T05:00:00Z') })).toMatchObject({ tenants: 1, triggered: 1 });
+  });
+
+  it('still finds versions while paused, creates no jobs in either runner, and resumes normally', async () => {
+    const { db, store, runSqliteUpdateCheck, runSqliteScheduledUpdates } = await scheduled();
+    store.setPaused('t1', true);
+    expect(await runSqliteUpdateCheck(db, { now: morning })).toMatchObject({ available: 1, triggered: 0, held: 1 });
+    expect(await runSqliteScheduledUpdates(db, { now: morning })).toMatchObject({ triggered: 0 });
+    expect(await db.jobs.getByTenantId('t1')).toHaveLength(0);
+    store.save('t1', { enabled: true, days: [0,1,2,3,4,5,6], startHour: 0, endHour: 24 });
+    expect(await runSqliteScheduledUpdates(db, { now: evening })).toMatchObject({ triggered: 0 });
+    expect(store.get('t1').paused).toBe(true);
+    store.setPaused('t1', false);
+    expect(await runSqliteScheduledUpdates(db, { now: evening })).toMatchObject({ triggered: 1 });
+  });
+
+  it('only applies a tenant schedule to that tenant', async () => {
+    const { db, store, runSqliteUpdateCheck } = await scheduled();
+    store.save('another-tenant', { enabled: true, days: [6], startHour: 1, endHour: 2 });
+    expect(await runSqliteUpdateCheck(db, { now: morning })).toMatchObject({ triggered: 1, held: 0 });
+  });
+});
