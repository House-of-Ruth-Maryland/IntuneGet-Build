+vi.mock('@/hooks/useUpdateSchedule', () => ({ useUpdateSchedule: () => ({ data: { supported: true, schedule: Object.assign(state.schedule, { paused: state.paused }), blackouts: [], window: { open: !state.paused } }, action: { mutate: state.mutate, reset: state.reset, isPending: false } }) }));
+import { UpdateSchedule } from './UpdateSchedule';
+(globalThis as typeof globalThis & { IS_REACT_ACT_ENVIRONMENT: boolean }).IS_REACT_ACT_ENVIRONMENT = true;
+let root: Root;
+const button = (label: string) => [...document.querySelectorAll('button')].find(b => b.textContent === label)!;
+const showApps = vi.fn();
+const render = () => act(async () => root.render(createElement(UpdateSchedule, { appsOn: 12, onShowApps: showApps })));
+beforeEach(async () => { state.paused = false; Object.assign(state.schedule, { enabled: false, days: [0, 1, 2, 3, 4, 5, 6], startHour: 0, endHour: 24 }); state.mutate.mockReset(); showApps.mockReset(); const node = document.createElement('div'); document.body.append(node); root = createRoot(node); await render(); });
+afterEach(async () => { await act(async () => root.unmount()); document.body.innerHTML = ''; });
+// HRM patch 0058 (choice 4B): one strip row with the state and next action; details in the dialog.
+it('shows the schedule as one strip row with the apps that have Automatic updates on', async () => {
+  const row = document.querySelector('section[aria-label="Update schedule"]')!;
+  expect(row.textContent).toContain('Deploys to Intune when a new version is found');
+  expect(row.textContent).toContain('On');
+  await act(async () => button('12 apps with Automatic updates on').click());
+  expect(showApps).toHaveBeenCalledOnce();
+  expect(document.body.textContent).not.toContain('Check for new versions');
