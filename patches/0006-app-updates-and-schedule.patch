+    expect(parseGithubReleaseUrl(OLD_URL)).toEqual({ owner: 'example-org', repo: 'example-app', tag: 'v0.15.0', file: 'example-app-0.15.0-windows-x64.msi' });
+  });
+
+  it.each([
+    'http://github.com/example-org/example-app/releases/download/v1/x.msi',
+    'https://github.example.test/example-org/example-app/releases/download/v1/x.msi',
+    'https://github.com/example-org/example-app/archive/v1.zip',
+    'https://downloads.example.test/x.msi',
+    null,
+  ])('ignores %s', (url) => expect(parseGithubReleaseUrl(url)).toBeNull());
+
+  it('works out the new file name from the old one', () => {
+    const source = parseGithubReleaseUrl(OLD_URL)!;
+    expect(expectedAssetNames(source, '0.15.0', 'v0.16.0')).toContain('example-app-0.16.0-windows-x64.msi');
+    expect(versionFromTag('v2.1')).toBe('2.1');
+    expect(versionFromTag('release-2')).toBe('release-2');
+  });
+});
+
+describe('finding new releases of custom apps', () => {
+  it('finds a newer release with the matching file and its SHA-256', async () => {
+    const found = await findCustomAppReleases([deployment()], async () => job(), { fetchImpl: github(latest), now: new Date('2026-11-02T08:30:00Z') });
+    expect(found).toHaveLength(1);
+    expect(found[0].release).toMatchObject({
+      version: '0.16.0', installer_url: NEW_URL, installer_sha256: DIGEST, job_id: job().id,
+      release_url: 'https://github.com/example-org/example-app/releases/tag/v0.16.0',
+    });
+  });
+
+  it('skips releases that are not newer, have no matching file, or are pre-releases', async () => {
+    const check = (release: Record<string, unknown> | null) =>
+      findCustomAppReleases([deployment()], async () => job(), { fetchImpl: github(release) });
+    expect(await check({ ...latest, tag_name: 'v0.15.0' })).toEqual([]);
+    expect(await check({ ...latest, assets: [latest.assets[1]] })).toEqual([]);
+    expect(await check({ ...latest, prerelease: true })).toEqual([]);
+    expect(await check(null)).toEqual([]);
+  });
+
+  it('only looks at custom apps installed from a GitHub release, once per repository', async () => {
+    const fetchImpl = github(latest);
+    await findCustomAppReleases(
+      [
+        deployment(),
+        deployment({ id: 'h2', intune_app_id: '00000000-0000-0000-0000-00000000000b', intune_tenant_id: 'tenant-two' }),
+        deployment({ id: 'h3', winget_id: 'Example.CatalogApp' }),
+        deployment({ id: 'h4', packaging_job_id: '22222222-2222-2222-2222-222222222222' }),
+      ],
+      async (id) => (id === '22222222-2222-2222-2222-222222222222' ? job({ installer_url: 'https://downloads.example.test/x.msi' }) : job()),
+      { fetchImpl }
+    );
+    expect(fetchImpl).toHaveBeenCalledTimes(1);
+    expect((fetchImpl as unknown as ReturnType<typeof vi.fn>).mock.calls[0][0]).toBe('https://api.github.com/repos/example-org/example-app/releases/latest');
+  });
+
+  it('keeps going when GitHub fails', async () => {
+    const fetchImpl = vi.fn(async () => new Response('rate limited', { status: 403 })) as unknown as typeof fetch;
+    expect(await findCustomAppReleases([deployment()], async () => job(), { fetchImpl })).toEqual([]);
+  });
+});
