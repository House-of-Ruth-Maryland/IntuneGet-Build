+import { describe, expect, it } from 'vitest';
+import { hourLabel, scheduleSummary, windowLabel } from './UpdateSchedule';
+describe('update schedule wording (HRM patch 0030)', () => {
+  it('names hours plainly', () => {
+    expect([0, 1, 12, 13, 24].map(hourLabel)).toEqual(['midnight', '1 AM', 'noon', '1 PM', 'midnight']);
+  });
+  it('summarises schedules in Maryland time', () => {
+    expect(scheduleSummary({ enabled: false, days: [], startHour: 0, endHour: 24 })).toBe('Updates can deploy at any time.');
+    const start = 'Allowed deployment hours: ';
+    expect(scheduleSummary({ enabled: true, days: [0, 1, 2, 3, 4, 5, 6], startHour: 0, endHour: 24 })).toBe(`${start}Every day, all day, Maryland time.`);
+    expect(scheduleSummary({ enabled: true, days: [1, 2, 3, 4], startHour: 18, endHour: 22 })).toBe(`${start}Mon, Tue, Wed, Thu, 6 PM to 10 PM, Maryland time.`);
+    expect(scheduleSummary({ enabled: true, days: [5], startHour: 20, endHour: 6 })).toBe(`${start}Fri, 8 PM to 6 AM the next day, Maryland time.`);
+  });
+  it('names the publishing window in a few words for the status bar', () => {
+    expect(windowLabel({ enabled: false, days: [], startHour: 0, endHour: 24 })).toBe('Anytime');
+    expect(windowLabel({ enabled: true, days: [0, 1, 2, 3, 4, 5, 6], startHour: 0, endHour: 24 })).toBe('Every day, all day');
+    expect(windowLabel({ enabled: true, days: [5, 1, 2, 3, 4], startHour: 19, endHour: 5 })).toBe('Mon to Fri, 7 PM to 5 AM');
+    expect(windowLabel({ enabled: true, days: [1, 3], startHour: 18, endHour: 22 })).toBe('Mon, Wed, 6 PM to 10 PM');
+    expect(windowLabel({ enabled: true, days: [0, 6], startHour: 0, endHour: 12 })).toBe('Sun, Sat, midnight to noon');
+  });
+});
