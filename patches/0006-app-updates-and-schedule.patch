+
+  // Bulk / modal layout
+  const unassignedRows = rows.filter(row => !row.error && row.groups.length === 0);
+
+  return (
+    <div className="px-6 py-4 max-h-[50vh] overflow-y-auto space-y-3" aria-label="Effective update settings">
+      {unassignedRows.length > 0 && rows.length > 1 && (
+        <div role="status" className="flex items-start gap-2.5 rounded-lg border border-status-warning/40 bg-status-warning/10 p-3 text-xs text-text-primary">
+          <AlertTriangle className="h-4 w-4 text-status-warning shrink-0 mt-0.5" aria-hidden="true" />
+          <span>
+            {unassignedRows.length === 1 ? '1 app has' : `${unassignedRows.length} apps have`} no assigned groups. Assign groups or confirm below before starting.
+          </span>
+        </div>
+      )}
+      {rows.map(row => (
+        <section key={row.wingetId} className="rounded-lg border border-overlay/10 bg-bg-elevated/50 p-3.5 text-sm space-y-2">
+          <div className="flex flex-wrap items-baseline justify-between gap-2">
+            <h3 className="font-semibold text-text-primary">{row.displayName || row.wingetId}</h3>
+            {!row.error && (
+              <span className="text-xs font-mono text-text-secondary">{row.fromVersion} → {row.toVersion}</span>
+            )}
+          </div>
+          {row.error ? (
+            <p role="alert" className="text-status-error">{row.error}</p>
+          ) : (
+            <>
+              <p className="text-xs text-text-secondary">
+                {row.source === 'curated' ? 'Curated' : 'Saved app settings'} · {row.behavior} · Restart: {row.restart}
+              </p>
+              {row.groups.length === 0 ? (
+                renderUnassignedSoftGate(row)
+              ) : (
+                <p className="text-xs text-text-primary">
+                  {(row.structuredGroups ?? fallbackGroups(row.groups)).map((g, i) => (
+                    <span key={g.id}>
+                      {i > 0 && '; '}
+                      {g.label} · {g.intentLabel}
+                      {g.filter ? ` (${g.filter})` : ''}
+                    </span>
+                  ))}
+                </p>
+              )}
+              <p className="text-xs text-text-secondary">
+                {row.structuredDates && row.structuredDates.length > 0
+                  ? row.structuredDates.map(d => `${d.groupLabel}: available ${formatTimingClock(d.startDateTime, d.useLocalTime) ?? 'ASAP'} · deadline ${formatTimingClock(d.deadlineDateTime, d.useLocalTime) ?? 'ASAP'}`).join('; ')
+                  : row.dates.length ? row.dates.join('; ') : 'Install dates: ASAP'}
+              </p>
+              {renderDateReview(row)}
+            </>
+          )}
+        </section>
+      ))}
+      {rows.some(row => row.error) && (
+        <Button variant="outline" size="sm" onClick={() => setRetry(v => v + 1)}>Retry review</Button>
+      )}
+      <p className="text-xs text-text-muted">
+        Starting sends a new app version to Intune. Device installation follows its assignments and check-in.
+      </p>
+      {editGroupsAppId && (
+        <EditAssignments
+          appId={editGroupsAppId}
+          open={Boolean(editGroupsAppId)}
+          onOpenChange={open => { if (!open) setEditGroupsAppId(null); }}
+          onSaved={() => setRetry(v => v + 1)}
+        />
+      )}
+    </div>
+  );
+}
