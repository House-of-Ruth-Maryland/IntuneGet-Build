diff --git a/components/hrm/VersionDiscovery.tsx b/components/hrm/VersionDiscovery.tsx
new file mode 100644
index 000000000..f7764f9cf
--- /dev/null
+++ b/components/hrm/VersionDiscovery.tsx
@@ -0,0 +1,70 @@
+'use client';
+import Link from 'next/link';
+import { useQuery } from '@tanstack/react-query';
+import { useMicrosoftAuth } from '@/hooks/useMicrosoftAuth';
+import { useDatabaseMode } from '@/hooks/use-database-mode';
+import { Tooltip, TooltipContent, TooltipProvider, TooltipTrigger } from '@/components/ui/tooltip';
+
+export const VERSION_CHECK_TIMES = 'Daily at 3:30 AM and 3:30 PM, Maryland time';
+const ELSEWHERE: { what: string; detail: string; href?: string; link?: string }[] = [
+  { what: 'Who gets an app', detail: 'Groups, set per app.', href: '/dashboard/inventory', link: 'Open Apps, then the app' },
+  { what: 'Install dates', detail: 'When a version becomes available and when it must install, set per app.', href: '/dashboard/inventory', link: 'Open Apps, then the app' },
+  { what: 'Which apps update on their own', detail: 'Auto-update, Notify only or Ignore, set per app.', href: '/dashboard/updates', link: 'Open App updates' },
+  { what: 'When automatic updates deploy to Intune', detail: 'Days and hours, or a pause, for all apps.', href: '/dashboard/updates#automatic-updates', link: 'Open App updates' },
+  { what: 'How automatic updates install', detail: 'Whether staff can postpone, for all apps or one app.', href: '/dashboard/updates#automatic-updates', link: 'Open App updates' },
+];
+// Settings > General: nothing here is a setting. It lists what is changed on other pages and what is
+// fixed on the server, so no read-only fact looks like a control. The "app-updates" id is kept for
+// older links.
+export function VersionDiscoverySettings() {
+  const mode = useDatabaseMode();
+  return <section id="app-updates" aria-labelledby="set-elsewhere" className="scroll-mt-24 border-t border-overlay/10 px-1 pt-6">
+    <details className="group rounded-xl border border-overlay/10 bg-bg-surface/60 px-4 py-3">
+      <summary className="flex cursor-pointer list-none flex-wrap items-center justify-between gap-2 text-sm font-semibold text-text-secondary hover:text-text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-cyan rounded">
+        <h2 id="set-elsewhere" className="text-sm font-semibold">Not set on this page</h2>
+        <span className="text-xs font-normal text-text-muted group-open:hidden">Show where updates, groups and dates are changed</span>
+        <span className="hidden text-xs font-normal text-text-muted group-open:inline">Hide</span>
+      </summary>
+      <dl className="mt-3 divide-y divide-overlay/10 border-t border-overlay/10 text-sm">
+        {ELSEWHERE.map(row => <div key={row.what} className="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 py-2.5">
+          <div className="min-w-0"><dt className="font-medium text-text-primary">{row.what}</dt><dd className="text-text-secondary">{row.detail}</dd></div>
+          {row.href && <dd><Link href={row.href} className="text-accent-cyan hover:underline">{row.link}</Link></dd>}
+        </div>)}
+        <div className="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 py-2.5">
+          <div className="min-w-0"><dt className="font-medium text-text-primary">New version checks</dt><dd className="text-text-secondary">{VERSION_CHECK_TIMES}. Fixed on the server.</dd></div>
+          <dd><Link href="/dashboard/updates#version-checks" className="text-accent-cyan hover:underline">See the last check in App updates</Link></dd>
+        </div>
+        {mode === 'sqlite' && <div className="py-2.5"><dt className="font-medium text-text-primary">What an update replaces</dt><dd className="text-text-secondary">An update replaces the previous version and keeps its groups. Fixed on this server.</dd></div>}
+      </dl>
+    </details>
+  </section>;
+}
+interface CheckStatus { supported: boolean; reported: boolean; lastAttemptAt: string | null; result: string | null; nextExpectedAt: string }
+export const clock = (value: string) => new Date(value).toLocaleString('en-US', { timeZone: 'America/New_York', month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' });
+/** The last and next new-version check, shared by the header and the empty list. */
+export function useVersionCheckStatus() {
+  const { getAccessToken, isAuthenticated, account } = useMicrosoftAuth();
+  return useQuery<CheckStatus>({ queryKey: ['hrm', 'version-check-status', account?.tenantId, account?.localAccountId], enabled: isAuthenticated, staleTime: 60000,
+    queryFn: async () => {
+      const token = await getAccessToken();
+      if (!token) throw new Error('Sign in to view version check status.');
+      const response = await fetch('/api/hrm/version-check-status', { headers: { Authorization: `Bearer ${token}` } });
+      if (!response.ok || !response.headers.get('content-type')?.includes('application/json')) throw new Error('Version check status unavailable.');
+      return response.json();
+    } });
+}
+export function VersionCheckStatus({ compact = false }: { compact?: boolean } = {}) {
+  const query = useVersionCheckStatus();
+  if (query.data?.supported === false) return null;
+  const status = query.data;
+  if (compact) {
+    // App updates' header: when the last check ran, with the fixed schedule on hover or keyboard focus.
+    const failed = !!status?.lastAttemptAt && status.result !== 'success';
+    const text = query.isLoading ? 'Checking status…' : query.error ? 'Check status unavailable' : status?.lastAttemptAt ? `${failed ? 'Last check did not complete' : 'Checked'} ${clock(status.lastAttemptAt)}` : 'Last check not reported';
+    return <TooltipProvider delayDuration={150}><Tooltip>
+      <TooltipTrigger asChild><span tabIndex={0} aria-label={`New version checks: ${text}`} className={`cursor-help whitespace-nowrap rounded-sm text-xs underline decoration-dotted underline-offset-4 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-cyan ${failed || query.error ? 'text-status-warning decoration-status-warning/60' : 'text-text-muted decoration-text-muted'}`}>{text}</span></TooltipTrigger>
+      <TooltipContent className="max-w-80 border border-overlay/10 text-sm font-normal leading-relaxed">{VERSION_CHECK_TIMES}. Fixed on the server.{status?.nextExpectedAt ? ` Next check: ${clock(status.nextExpectedAt)}.` : ''} A check finds new versions and can start Auto-update deployments to Intune. It does not install anything on computers itself.</TooltipContent>
+    </Tooltip></TooltipProvider>;
+  }
+  return <div className="flex flex-wrap items-center gap-x-4 gap-y-2 p-4 text-sm text-text-secondary" aria-label="New version checks"><span className="font-medium text-text-primary">New version checks</span><span>{query.isLoading ? 'Loading check status…' : query.error ? 'Check status unavailable' : status?.lastAttemptAt ? `Last check attempt: ${clock(status.lastAttemptAt)} Maryland time · ${status.result === 'success' ? 'completed' : status.result || 'outcome unknown'}` : 'Last check not reported'}</span>{status?.nextExpectedAt && <span>Next expected check: {clock(status.nextExpectedAt)} Maryland time</span>}<span className="text-xs text-text-muted">{VERSION_CHECK_TIMES}. Fixed on the server. A check finds new versions and can start Auto-update deployments to Intune. It does not install anything on computers itself.</span></div>;
+}
