+    const first = await (await get()).json();
+    expect(first).toMatchObject({ supported: true, schedule: { enabled: false }, blackouts: [], window: { open: true } });
+    const saved = await post({ action: 'save', schedule: { enabled: true, days: [1, 2], startHour: 20, endHour: 6, extra: 'ignored' } });
