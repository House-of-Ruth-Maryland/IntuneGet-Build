+// @vitest-environment happy-dom
+// HRM patch 0051: Settings' update switches only where they take effect; a link to App updates on SQLite.
+import { afterEach, describe, expect, it, vi } from 'vitest';
+import { act, createElement } from 'react';
+import { createRoot, type Root } from 'react-dom/client';
+
+(globalThis as { IS_REACT_ACT_ENVIRONMENT?: boolean }).IS_REACT_ACT_ENVIRONMENT = true;
+
+let root: Root | null = null;
+let container: HTMLDivElement | null = null;
+
+afterEach(() => {
+  act(() => root?.unmount());
+  container?.remove();
+  root = null;
+  container = null;
+  vi.unstubAllGlobals();
+  vi.resetModules();
+});
+
+async function renderWithMode(databaseMode: string | null) {
+  vi.stubGlobal('fetch', vi.fn(async () => (databaseMode === null
+    ? Promise.reject(new Error('offline'))
+    : new Response(JSON.stringify({ databaseMode }), { status: 200 }))));
+  const { UpdateBehaviorSettings } = await import('./UpdateBehaviorSettings');
+  container = document.createElement('div');
+  document.body.appendChild(container);
+  root = createRoot(container);
+  await act(async () => {
+    root!.render(createElement(UpdateBehaviorSettings, null, createElement('p', null, 'Carry over assignments')));
+  });
+  await act(async () => { await new Promise((r) => setTimeout(r, 0)); });
+  return container;
+}
+
+describe('UpdateBehaviorSettings', () => {
+  it('shows no card on a SQLite server, where the switches do nothing', async () => {
+    expect((await renderWithMode('sqlite')).textContent).toBe('');
+  });
+
+  it('shows the switches on a Supabase server, where they take effect', async () => {
+    const el = await renderWithMode('supabase');
+    expect(el.textContent).toBe('Carry over assignments');
+  });
+
+  it('shows nothing while the mode cannot be read', async () => {
+    expect((await renderWithMode(null)).textContent).toBe('');
+  });
+});
+
+// Settings > General lists what is changed elsewhere as plain text with links: no card, switch or
+// button, and nothing named "App updates" that is not the App updates page.
+describe('VersionDiscoverySettings (Not set on this page)', () => {
+  async function renderList(databaseMode: string) {
+    vi.stubGlobal('fetch', vi.fn(async () => new Response(JSON.stringify({ databaseMode }), { status: 200 })));
+    vi.doMock('@/hooks/useMicrosoftAuth', () => ({ useMicrosoftAuth: () => ({ getAccessToken: async () => null, isAuthenticated: false, account: null }) }));
+    const { VersionDiscoverySettings } = await import('./VersionDiscovery');
+    container = document.createElement('div');
+    document.body.appendChild(container);
+    root = createRoot(container);
+    await act(async () => { root!.render(createElement(VersionDiscoverySettings)); });
+    await act(async () => { await new Promise((r) => setTimeout(r, 0)); });
+    return container;
+  }
+
+  it('says where each thing is changed and offers no control', async () => {
+    const el = await renderList('sqlite');
+    expect(el.querySelector('h2')?.textContent).toBe('Not set on this page');
+    expect(el.querySelectorAll('button, input, select, [role="switch"]')).toHaveLength(0);
+    const rows = [...el.querySelectorAll('dt')].map((dt) => dt.textContent);
+    expect(rows).toEqual(['Who gets an app', 'Install dates', 'Which apps update on their own', 'When automatic updates deploy to Intune', 'How automatic updates install', 'New version checks', 'What an update replaces']);
+    const links = [...el.querySelectorAll('a')].map((a) => [a.textContent, a.getAttribute('href')]);
+    expect(links).toContainEqual(['Open App updates', '/dashboard/updates']);
+    expect(links).toContainEqual(['Open Apps, then the app', '/dashboard/inventory']);
+    expect(el.textContent).toContain('Daily at 3:30 AM and 3:30 PM, Maryland time. Fixed on the server.');
+    expect(el.textContent).toContain('An update replaces the previous version and keeps its groups.');
+    expect(el.textContent).not.toContain('This is informational');
+    // Older links to Settings' "App updates" card still land here.
+    expect(el.querySelector('#app-updates')).not.toBeNull();
+  });
+
+  it('leaves out the fixed replace rule where the Supabase switches decide it', async () => {
+    const el = await renderList('supabase');
+    expect(el.textContent).not.toContain('What an update replaces');
+  });
+});
diff --git a/components/hrm/UpdateBehaviorSettings.tsx b/components/hrm/UpdateBehaviorSettings.tsx
