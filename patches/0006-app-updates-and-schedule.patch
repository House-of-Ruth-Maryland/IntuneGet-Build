diff --git a/app/api/hrm/update-schedule/route.ts b/app/api/hrm/update-schedule/route.ts
new file mode 100644
index 000000000..f9a323f7f
--- /dev/null
+++ b/app/api/hrm/update-schedule/route.ts
@@ -0,0 +1,55 @@
+import { NextRequest, NextResponse } from 'next/server';
+import { parseAccessToken } from '@/lib/auth-utils';
+import { isSqliteMode } from '@/lib/db';
+import { BLACKOUT_LABEL_MAX, blackoutError, scheduleError, updateWindowState, type UpdateSchedule } from '@/lib/hrm/update-window';
+
+/** HRM patch 0030: the tenant's update schedule and blackouts. */
+const reply = (body: unknown, status = 200) => NextResponse.json(body, { status, headers: { 'Cache-Control': 'private, no-store' } });
+const GUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
+
+async function view(tenant: string) {
+  const { sqliteUpdateSchedule: store } = await import('@/lib/db/sqlite');
+  const schedule = store.get(tenant);
+  const blackouts = store.blackouts(tenant);
+  return { supported: true, schedule, blackouts, window: updateWindowState(schedule, blackouts) };
+}
+
+export async function GET(request: NextRequest) {
+  const user = await parseAccessToken(request.headers.get('Authorization'));
+  if (!user) return reply({ error: 'Authentication required' }, 401);
+  if (!isSqliteMode()) return reply({ supported: false });
+  return reply(await view(user.tenantId));
+}
+
+export async function POST(request: NextRequest) {
+  const user = await parseAccessToken(request.headers.get('Authorization'));
+  if (!user) return reply({ error: 'Authentication required' }, 401);
+  if (!isSqliteMode()) return reply({ error: 'Update schedules need this server’s SQLite mode.' }, 409);
+  const body = await request.json().catch(() => null);
+  const { sqliteUpdateSchedule: store } = await import('@/lib/db/sqlite');
+  if (body?.action === 'setPaused') {
+    if (typeof body.paused !== 'boolean') return reply({ error: 'Choose pause or resume.' }, 400);
+    store.setPaused(user.tenantId, body.paused);
+    return reply(await view(user.tenantId));
+  }
+  if (body?.action === 'save') {
+    const s = body.schedule as UpdateSchedule;
+    const error = scheduleError(s);
+    if (error) return reply({ error }, 400);
+    store.save(user.tenantId, { enabled: s.enabled, days: s.days, startHour: s.startHour, endHour: s.endHour });
+    return reply(await view(user.tenantId));
+  }
+  if (body?.action === 'addBlackout') {
+    const b = { startsOn: body.startsOn, endsOn: body.endsOn, label: typeof body.label === 'string' ? body.label.slice(0, BLACKOUT_LABEL_MAX + 1) : '' };
+    const error = blackoutError(b);
+    if (error) return reply({ error }, 400);
+    try { store.addBlackout(user.tenantId, b); } catch (e) { return reply({ error: e instanceof Error ? e.message : 'Could not add the blackout.' }, 409); }
+    return reply(await view(user.tenantId));
+  }
+  if (body?.action === 'removeBlackout') {
+    if (typeof body.id !== 'string' || !GUID.test(body.id)) return reply({ error: 'Invalid blackout.' }, 400);
+    if (!store.removeBlackout(user.tenantId, body.id)) return reply({ error: 'This blackout was already removed.' }, 404);
+    return reply(await view(user.tenantId));
+  }
+  return reply({ error: 'Invalid action' }, 400);
+}
