+it('keeps Resume on the row while paused', async () => {
+  state.paused = true;
+  await render();
+  const row = document.querySelector('section[aria-label="Update schedule"]')!;
+  expect(row.textContent).toContain('Paused for all apps');
+  expect(row.textContent).toContain('Paused');
+  await act(async () => button('Resume automatic updates').click());
+  expect(state.mutate.mock.calls[0][0]).toEqual({ action: 'setPaused', paused: false });
