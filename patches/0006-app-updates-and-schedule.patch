+// @vitest-environment happy-dom
+import { act, createElement, type ReactNode } from 'react';
+import { createRoot, type Root } from 'react-dom/client';
+import { afterEach, beforeEach, expect, it, vi } from 'vitest';
+
+const auth = vi.hoisted(() => ({ getAccessToken: vi.fn(async () => 'fixture-token') }));
+const panelCallbacks = vi.hoisted(() => ({ onGroupsSaved: undefined as (() => void) | undefined, onDatesSaved: undefined as (() => void) | undefined }));
+vi.mock('@/hooks/useMicrosoftAuth', () => ({ useMicrosoftAuth: () => auth }));
+vi.mock('next/link', () => ({ default: ({ href, children, className }: { href: string; children: ReactNode; className?: string }) => createElement('a', { href, className }, children) }));
+vi.mock('./EditAssignments', () => ({
+  EditAssignments: ({ appId, open, onSaved }: { appId: string; open?: boolean; onSaved?: () => void }) => {
+    panelCallbacks.onGroupsSaved = onSaved;
+    return open ? createElement('div', { role: 'dialog', 'data-panel': 'edit-groups' }, `Edit groups for ${appId}`) : null;
+  },
+}));
+vi.mock('./AppTimingPanel', async (importOriginal) => {
+  const actual = await importOriginal<typeof import('./AppTimingPanel')>();
+  return {
+    ...actual,
+    AppTimingPanel: ({ appId, open, onSaved }: { appId: string; open?: boolean; onSaved?: () => void }) => {
+      panelCallbacks.onDatesSaved = onSaved;
+      return open ? createElement('div', { role: 'dialog', 'data-panel': 'edit-dates' }, `Edit dates for ${appId}`) : null;
+    },
+  };
+});
+
+import { ManualUpdateReview, type ManualReviewSummary } from './ManualUpdateReview';
+
+let root: Root;
+const ready = vi.fn();
+const summaryChange = vi.fn<(s: ManualReviewSummary | null) => void>();
+(globalThis as typeof globalThis & { IS_REACT_ACT_ENVIRONMENT: boolean }).IS_REACT_ACT_ENVIRONMENT = true;
+
+const row = {
+  wingetId: 'Example.App',
+  displayName: 'Example app',
+  fromVersion: '1',
+  toVersion: '2',
+  source: 'saved' as const,
+  sourceAppId: '11111111-1111-4111-8111-111111111111',
+  behavior: 'No toolkit windows',
+  restart: 'Suppressed',
+  groups: ['Example group · Required'],
+  structuredGroups: [{ id: 'a1', label: 'Example group', intent: 'required' as const, intentLabel: 'Required' }],
+  dates: ['Example group · Required: deadline 2020-01-01 · UTC'],
+  structuredDates: [{ groupLabel: 'Example group', intent: 'Required', startDateTime: null, deadlineDateTime: '2020-01-01T00:00:00Z', useLocalTime: false }],
+  installCounts: { installed: 10, failed: 1, pending: 2, notInstalled: 0, notApplicable: 0, other: 0, checkedAt: '2026-11-26T15:30:00Z' },
+  dateReviewRequired: true,
+  token: 'review-token',
+};
+
+beforeEach(() => {
+  ready.mockReset();
+  summaryChange.mockReset();
+  panelCallbacks.onGroupsSaved = undefined;
+  panelCallbacks.onDatesSaved = undefined;
+  const node = document.createElement('div');
+  document.body.append(node);
+  root = createRoot(node);
+});
+afterEach(async () => {
+  await act(async () => root.unmount());
+  document.body.innerHTML = '';
+  vi.unstubAllGlobals();
+});
+
+async function render(props: Partial<Parameters<typeof ManualUpdateReview>[0]> = {}) {
+  await act(async () => {
+    root.render(createElement(ManualUpdateReview, {
+      updates: [{ winget_id: 'Example.App', tenant_id: 'fixture' }],
+      onReady: ready,
+      onSummaryChange: summaryChange,
+      ...props,
+    }));
+    await new Promise(resolve => setTimeout(resolve, 0));
+  });
+}
+
+it('requires an explicit past-date choice and forwards only a reviewed request', async () => {
+  const fetch = vi.fn(async () => Response.json({ rows: [row] }));
+  vi.stubGlobal('fetch', fetch);
+  await render();
+  expect(ready.mock.lastCall?.[0]).toBeNull();
+  expect(document.body.textContent).toContain('Required');
+  await act(async () => document.querySelector<HTMLInputElement>('input[type="radio"]')!.click());
+  expect(ready.mock.lastCall?.[0]).toEqual([{ winget_id: 'Example.App', tenant_id: 'fixture', reviewToken: 'review-token', expiredDates: 'keep' }]);
+  expect(fetch.mock.calls).toHaveLength(1);
+});
+
+it('blocks starting on a per-app read failure and offers a fresh review', async () => {
+  const fetch = vi.fn(async () => Response.json({ rows: [{ wingetId: 'Example.App', error: 'Could not read assignments.' }] }));
+  vi.stubGlobal('fetch', fetch);
+  await render();
+  expect(ready.mock.lastCall?.[0]).toBeNull();
+  expect(document.querySelector('[role="alert"]')?.textContent).toContain('Could not read');
+  const button = [...document.querySelectorAll('button')].find(button => button.textContent === 'Retry review')!;
+  await act(async () => {
+    button.click();
+    await new Promise(resolve => setTimeout(resolve, 0));
+  });
+  expect(fetch.mock.calls).toHaveLength(2);
+});
+
+it('renders the structured slide-over sections and refreshes after inline Edit groups or Edit dates saves', async () => {
+  const fetch = vi.fn(async () => Response.json({ rows: [{ ...row, dateReviewRequired: false }] }));
+  vi.stubGlobal('fetch', fetch);
+  const onStartPilot = vi.fn();
+  await render({ layout: 'sheet', canStartPilot: true, onStartPilot });
+  const text = document.body.textContent ?? '';
+  expect(text).toContain('Who gets it');
+  expect(text).toContain('Example group');
+  expect(text).toContain('10 installed');
+  expect(text).toContain('1 failed');
+  expect(text).toContain('2 pending');
+  expect(text).toContain('When it installs');
+  expect(text).toContain('Jan 1, 2020');
+  expect(text).toContain('How it installs');
+  expect(text).toContain('Install prompts');
+  expect(text).toContain('No toolkit windows');
+  expect(text).toContain('Suppressed');
+  expect(text).toContain('Open app workspace');
+  expect(summaryChange.mock.lastCall?.[0]?.primaryLabel).toBe('Send update to Intune');
+
+  const pilotBtn = [...document.querySelectorAll('button')].find(b => b.textContent?.includes('Test with a pilot group'))!;
+  await act(async () => pilotBtn.click());
+  expect(onStartPilot).toHaveBeenCalledOnce();
+
+  const editGroupsBtn = [...document.querySelectorAll('button')].find(b => b.textContent === 'Edit groups')!;
+  await act(async () => editGroupsBtn.click());
+  expect(document.querySelector('[data-panel="edit-groups"]')).not.toBeNull();
+  await act(async () => {
+    panelCallbacks.onGroupsSaved?.();
+    await new Promise(resolve => setTimeout(resolve, 0));
+  });
+  expect(fetch.mock.calls).toHaveLength(2);
+
+  const editDatesBtn = [...document.querySelectorAll('button')].find(b => b.textContent === 'Edit dates')!;
+  await act(async () => editDatesBtn.click());
+  expect(document.querySelector('[data-panel="edit-dates"]')).not.toBeNull();
+  await act(async () => {
+    panelCallbacks.onDatesSaved?.();
+    await new Promise(resolve => setTimeout(resolve, 0));
+  });
+  expect(fetch.mock.calls).toHaveLength(3);
+});
+
+it('soft-gates unassigned apps until explicitly confirmed and offers Assign groups', async () => {
+  const unassignedRow = {
+    ...row,
+    groups: [],
+    structuredGroups: [],
+    dates: [],
+    structuredDates: [],
+    dateReviewRequired: false,
+  };
+  const fetch = vi.fn(async () => Response.json({ rows: [unassignedRow] }));
+  vi.stubGlobal('fetch', fetch);
+  await render({ layout: 'sheet' });
+  expect(document.body.textContent).toContain('No groups assigned');
+  expect(summaryChange.mock.lastCall?.[0]?.isUnassigned).toBe(true);
+  expect(summaryChange.mock.lastCall?.[0]?.primaryLabel).toBe('Upload unassigned version');
+  // Blocked until explicit confirmation checkbox is ticked.
