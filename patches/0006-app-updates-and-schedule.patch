diff --git a/hooks/useUpdateSchedule.ts b/hooks/useUpdateSchedule.ts
new file mode 100644
index 000000000..e9171e045
--- /dev/null
+++ b/hooks/useUpdateSchedule.ts
@@ -0,0 +1,25 @@
+'use client';
+import { useMutation, useQuery, useQueryClient } from '@tanstack/react-query';
+import { useMicrosoftAuth } from './useMicrosoftAuth';
+import type { UpdateBlackout, UpdateSchedule, UpdateWindowState } from '@/lib/hrm/update-window';
+
+/** HRM patch 0030 */
+export interface UpdateScheduleView { supported: boolean; schedule?: UpdateSchedule; blackouts?: UpdateBlackout[]; window?: UpdateWindowState }
+
+export function useUpdateSchedule() {
+  const { getAccessToken, isAuthenticated, account } = useMicrosoftAuth();
+  const client = useQueryClient();
+  const key = ['hrm', 'update-schedule', account?.tenantId, account?.localAccountId];
+  const request = async (body?: Record<string, unknown>) => {
+    const token = await getAccessToken();
+    if (!token) throw new Error('Sign in again to view the update schedule.');
+    const response = await fetch('/api/hrm/update-schedule', { method: body ? 'POST' : 'GET', headers: { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json' }, ...(body ? { body: JSON.stringify(body) } : {}) });
+    if (response.redirected || !response.headers.get('content-type')?.includes('application/json')) throw new Error('Your sign-in expired. Reload and sign in again.');
+    const data = await response.json();
+    if (!response.ok) throw new Error(data.error || 'Could not load the update schedule.');
+    return data as UpdateScheduleView;
+  };
+  const query = useQuery({ queryKey: key, queryFn: () => request(), enabled: isAuthenticated, staleTime: 30000, refetchInterval: 60000 });
+  const action = useMutation({ mutationFn: request, onSuccess: (data) => client.setQueryData(key, data) });
+  return { ...query, action };
+}
