+++ b/components/hrm/UpdateBehaviorSettings.tsx
@@ -0,0 +1,25 @@
+'use client';
+
+import type { ReactNode } from 'react';
+import Link from 'next/link';
+import { useDatabaseMode } from '@/hooks/use-database-mode';
+
+// HRM patch 0051: Settings > General's "Carry over assignments" and "Supersede previous version on
+// update" take effect only in Supabase mode (same gate as patch 0035). On a SQLite server, Update and
+// automatic updates always replace the previous version and keep its groups, so the switches are
+// replaced by one line pointing to App updates, where update behavior is set. Nothing shows until the
+// mode is known.
+export function UpdateBehaviorSettings({ children }: { children: ReactNode }) {
+  const mode = useDatabaseMode();
+  if (mode === 'supabase') return <>{children}</>;
+  if (mode !== 'sqlite') return null;
+  return (
+    <section className="glass-light rounded-xl p-6 border border-overlay/5">
+      <p className="text-text-primary font-medium">Update behavior</p>
+      <p className="text-sm text-text-muted">
+        Updates replace the previous version and keep its groups. Change timing in{' '}
+        <Link href="/dashboard/updates" className="text-accent-cyan hover:underline">App updates</Link>.
+      </p>
+    </section>
+  );
+}
