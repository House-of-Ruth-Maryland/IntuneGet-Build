@@ -0,0 +1,52 @@
+// @vitest-environment happy-dom
+// HRM patch 0036: ignored apps have no update card, so this list is the way to change them back.
+import { act, createElement, type ReactNode } from 'react';
+import { createRoot, type Root } from 'react-dom/client';
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+vi.mock('gt-next', () => ({ T: ({ children }: { children: ReactNode }) => children }));
+vi.mock('@/components/ui/dialog', () => {
+  const pass = ({ children }: { children: ReactNode }) => children;
+  return { Dialog: pass, DialogContent: pass, DialogDescription: pass, DialogHeader: pass, DialogTitle: pass };
+});
+const selector = vi.hoisted(() => ({ props: [] as Array<Record<string, unknown>> }));
+vi.mock('@/components/updates/UpdatePolicySelector', () => ({
+  UpdatePolicySelector: (props: Record<string, unknown>) => { selector.props.push(props); return null; },
+}));
+import { AutoUpdateAppsModal } from './AutoUpdateAppsModal';
+import type { AppUpdatePolicy } from '@/types/update-policies';
+
+let root: Root;
+(globalThis as typeof globalThis & { IS_REACT_ACT_ENVIRONMENT: boolean }).IS_REACT_ACT_ENVIRONMENT = true;
+beforeEach(() => { const el = document.createElement('div'); document.body.append(el); root = createRoot(el); selector.props = []; });
+afterEach(async () => { await act(async () => root.unmount()); document.body.innerHTML = ''; });
+
+const policy = (over: Partial<AppUpdatePolicy>): AppUpdatePolicy => ({
+  id: 'p-1', user_id: 'user', tenant_id: 'tenant', winget_id: 'Example.App', policy_type: 'ignore', auto_update_scope: 'all',
+  pinned_version: null, deployment_config: null, original_upload_history_id: null, last_auto_update_at: null,
+  last_auto_update_version: null, is_enabled: true, consecutive_failures: 0, created_at: '', updated_at: '', ...over,
+} as AppUpdatePolicy);
+
+describe('AutoUpdateAppsModal', () => {
+  it('lists ignored apps and changes their policy back', async () => {
+    const change = vi.fn(async () => {});
+    const ignored = policy({});
+    await act(async () => root.render(createElement(AutoUpdateAppsModal, { variant: 'ignored', open: true, onOpenChange: vi.fn(), policies: [ignored], onPolicyChange: change })));
+    expect(document.body.textContent).toContain('Ignored apps');
+    expect(document.body.textContent).toContain('Example.App');
+    await (selector.props[0].onPolicyChange as (t: string) => Promise<void>)('notify');
+    expect(change).toHaveBeenCalledWith(ignored, 'notify', undefined);
+  });
+
+  it('marks auto-update turned off by failures so it can be turned back on', async () => {
+    await act(async () => root.render(createElement(AutoUpdateAppsModal, { open: true, onOpenChange: vi.fn(), onPolicyChange: vi.fn(),
+      policies: [policy({ policy_type: 'auto_update', is_enabled: false, consecutive_failures: 3 })] })));
+    expect(document.body.textContent).toContain('Auto-update on');
+    expect(document.body.textContent).toContain('Auto-update off after 3 failures');
+    expect(selector.props.at(-1)?.isEnabled).toBe(false);
+  });
+
+  it('uses the policy names in the empty text', async () => {
+    await act(async () => root.render(createElement(AutoUpdateAppsModal, { open: true, onOpenChange: vi.fn(), onPolicyChange: vi.fn(), policies: [] })));
+    expect(document.body.textContent).toContain('No apps use Auto-update yet.');
+  });
+});
