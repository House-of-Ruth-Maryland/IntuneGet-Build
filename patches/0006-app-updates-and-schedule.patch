@@ -0,0 +1,47 @@
+// HRM patch 0057: the verdict the VM status script copies into hrm-status.json.
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+
+const mocks = vi.hoisted(() => ({ listRecent: vi.fn() }));
+vi.mock('@/lib/db', () => ({ getDatabase: () => ({ versionSyncEvents: { listRecent: mocks.listRecent } }) }));
+
+import { GET } from './route';
+
+const request = (auth?: string) => new Request('http://localhost/api/cron/version-sync-status', { headers: auth ? { authorization: auth } : {} });
+const minutesAgo = (m: number) => new Date(Date.now() - m * 60_000).toISOString();
+
+beforeEach(() => {
+  process.env.CRON_SECRET = 'fixture-cron-secret';
+  mocks.listRecent.mockReset();
+});
+afterEach(() => { delete process.env.CRON_SECRET; });
+
+describe('GET /api/cron/version-sync-status', () => {
+  it('needs the cron secret', async () => {
+    expect((await GET(request())).status).toBe(401);
+    expect((await GET(request('Bearer wrong'))).status).toBe(401);
+    delete process.env.CRON_SECRET;
+    expect((await GET(request('Bearer '))).status).toBe(401);
+    expect(mocks.listRecent).not.toHaveBeenCalled();
+  });
+
+  it('answers the verdict', async () => {
+    mocks.listRecent.mockResolvedValue([
+      { at: minutesAgo(5), appId: 'Vendor.App', result: 'failed', code: 'database_busy' },
+      { at: minutesAgo(60), appId: 'Vendor.Other', result: 'failed', code: 'unknown' },
+    ]);
+    const response = await GET(request('Bearer fixture-cron-secret'));
+    expect(response.status).toBe(200);
+    expect(response.headers.get('Cache-Control')).toBe('no-store');
+    const body = await response.json();
+    expect(body.versionSync).toMatchObject({ ok: false, at: expect.any(String) });
+    expect(body.versionSync.detail).toContain('database busy');
+    expect(JSON.stringify(body)).not.toContain('Vendor.');
+  });
+
+  it('answers 503 without error text when the database fails', async () => {
+    mocks.listRecent.mockRejectedValue(new Error('FORBIDDEN detail'));
+    const response = await GET(request('Bearer fixture-cron-secret'));
+    expect(response.status).toBe(503);
+    expect(await response.text()).not.toContain('FORBIDDEN');
+  });
+});
diff --git a/app/api/cron/version-sync-status/route.ts b/app/api/cron/version-sync-status/route.ts
new file mode 100644
index 000000000..b33b7d4ef
--- /dev/null
+++ b/app/api/cron/version-sync-status/route.ts
@@ -0,0 +1,26 @@
+/**
+ * HRM patch 0057: the "Version sync after deploy" verdict for the VM status script.
+ *
+ * deploy/intuneget-status.sh reads this every 5 minutes with the cron secret and copies the answer
+ * into hrm-status.json as checks.versionSync, which Home, the watchdog and the IT dashboard report
+ * read. Read-only; it answers counts and a fixed reason only.
+ */
+import { NextResponse } from 'next/server';
+import { getDatabase } from '@/lib/db';
+import { versionSyncVerdict } from '@/lib/hrm/version-sync-health';
+
+export const dynamic = 'force-dynamic';
+
+export async function GET(request: Request) {
+  const cronSecret = process.env.CRON_SECRET;
+  if (!cronSecret || request.headers.get('authorization') !== `Bearer ${cronSecret}`) {
+    return NextResponse.json({ error: 'Unauthorized' }, { status: 401 });
+  }
+  try {
+    const events = await getDatabase().versionSyncEvents.listRecent();
+    return NextResponse.json({ versionSync: versionSyncVerdict(events) }, { headers: { 'Cache-Control': 'no-store' } });
+  } catch {
+    // The status script keeps its last verdict when this fails; never return error text.
+    return NextResponse.json({ error: 'Unavailable' }, { status: 503, headers: { 'Cache-Control': 'no-store' } });
+  }
+}
diff --git a/app/api/hrm/manual-update-review/route.ts b/app/api/hrm/manual-update-review/route.ts
new file mode 100644
index 000000000..9cd4f1dd4
--- /dev/null
+++ b/app/api/hrm/manual-update-review/route.ts
@@ -0,0 +1,22 @@
+import {NextRequest,NextResponse} from 'next/server';
+import {parseAccessToken} from '@/lib/auth-utils';
+import {getDatabase,isSqliteMode} from '@/lib/db';
+import {readManualUpdateReview,type ManualReviewInput} from '@/lib/hrm/manual-update-review';
+export const maxDuration=300;
+const reply=(body:unknown,status=200)=>NextResponse.json(body,{status,headers:{'Cache-Control':'private, no-store'}});
+/** Read-only preview: no policy, job or assignment writes. */
+export async function POST(request:NextRequest){
+ const user=await parseAccessToken(request.headers.get('Authorization'));
+ if(!user)return reply({error:'Authentication required'},401);
+ if(!isSqliteMode())return reply({error:'This review requires SQLite packaging mode.'},409);
+ const body=await request.json().catch(()=>null);
+ if(!Array.isArray(body?.updates)||!body.updates.length||body.updates.length>10)return reply({error:'Review 1 to 10 updates per request.'},400);
+ const rows=[];
+ for(let i=0;i<body.updates.length;i+=3){
+  const part=await Promise.all(body.updates.slice(i,i+3).map(async(input:ManualReviewInput)=>{
+   if(typeof input?.winget_id!=='string'||input.winget_id.length>256||input.tenant_id!==user.tenantId)return {wingetId:input?.winget_id,error:'This update belongs to another tenant or is invalid.'};
+   try{return (await readManualUpdateReview(getDatabase(),user,input)).row}catch(error){return {wingetId:input.winget_id,error:error instanceof Error?error.message:'Could not review this update.'}}
+  }));rows.push(...part);
+ }
+ return reply({rows});
+}
