+describe('installers that failed their check (HRM patch 0031)', () => {
+  beforeEach(() => { vi.stubEnv('DATABASE_MODE', 'sqlite'); });
+  afterEach(() => { vi.unstubAllEnvs(); });
+  async function failedEarlier(code: string, message: string, sha = 'ABCDEF') {
+    const loaded = await load();
+    await seedDeployment(loaded.db);
+    getAppsByWingetIdsMock.mockResolvedValue([{ winget_id: 'Vendor.App', name: 'Vendor App', latest_version: '1.1.0' }]);
+    getLatestInstallerInfoMock.mockResolvedValue(installerResolution());
+    const job = await loaded.db.jobs.create({ user_id: 'u1', tenant_id: 't1', winget_id: 'Vendor.App', version: '1.1.0', display_name: 'Vendor App',
+      installer_type: 'exe', installer_url: 'https://example.com/app.exe', installer_sha256: sha, status: 'queued' });
+    await loaded.db.jobs.update(job.id, { status: 'failed', error_code: code, error_message: message, completed_at: new Date().toISOString() });
+    return loaded;
+  }
+  it.each([
+    ['HASH_MISMATCH', 'bytes changed'],
+    ['MANIFEST_UNAVAILABLE', 'gone'],
+    ['WORKFLOW_DISPATCH_FAILED', 'The publisher currently serves different bytes for Vendor.App 1.1.0. The deployment was quarantined before the packaging pipeline started.'],
+    ['WORKFLOW_DISPATCH_FAILED', 'Version 1.1.0 of Vendor App is no longer available from WinGet. Review the current version to update your selection.'],
+  ])('does not retry the same version and installer after %s', async (code, message) => {
+    const { db, runSqliteUpdateCheck } = await failedEarlier(code, message);
+    expect(await runSqliteUpdateCheck(db)).toMatchObject({ available: 1, triggered: 0, skipped: 1 });
+    expect((await db.jobs.getByTenantId('t1')).filter((j) => j.status === 'queued')).toHaveLength(0);
+  });
+  it('tries again when WinGet corrects the checksum', async () => {
+    const { db, runSqliteUpdateCheck } = await failedEarlier('HASH_MISMATCH', 'bytes changed', 'OLDHASH');
+    expect(await runSqliteUpdateCheck(db)).toMatchObject({ triggered: 1 });
+  });
+  it('still retries after an ordinary dispatch failure', async () => {
+    const { db, runSqliteUpdateCheck } = await failedEarlier('WORKFLOW_DISPATCH_FAILED', 'GitHub returned 502');
+    expect(await runSqliteUpdateCheck(db)).toMatchObject({ triggered: 1 });
+  });
+});
