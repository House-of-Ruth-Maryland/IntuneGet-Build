@@ -0,0 +1,151 @@
+'use client';
+import Link from 'next/link';
+import { useEffect, useState } from 'react';
+import { AlertTriangle } from 'lucide-react';
+import { useUpdateSchedule } from '@/hooks/useUpdateSchedule';
+import { Dialog, DialogTrigger, DialogContent, DialogHeader, DialogTitle, DialogDescription } from '@/components/ui/dialog';
+import { Button } from '@/components/ui/button';
+import { BLACKOUT_LABEL_MAX, DAY_NAMES, type UpdateSchedule as Schedule } from '@/lib/hrm/update-window';
+import { StripPill } from './StatusStripRow';
+import { VERSION_CHECK_TIMES } from './VersionDiscovery';
+
+/** HRM patch 0030: when automatic updates and pilot rollouts may start. */
+const secondary = 'text-sm text-accent-cyan hover:underline disabled:opacity-50';
+const field = 'rounded-md border border-overlay/15 bg-bg-elevated px-2 py-1 text-sm text-text-primary';
+
+export function hourLabel(hour: number): string {
+  if (hour === 0 || hour === 24) return 'midnight';
+  if (hour === 12) return 'noon';
+  return hour < 12 ? `${hour} AM` : `${hour - 12} PM`;
+}
+
+export function scheduleSummary(s: Schedule): string {
+  // HRM patch 0036: without a schedule, automatic updates start when the twice-daily check finds them.
+  if (!s.enabled) return 'Updates can deploy at any time.';
+  const days = s.days.length === 7 ? 'Every day' : s.days.map((d) => DAY_NAMES[d].slice(0, 3)).join(', ');
+  const hours = s.startHour === 0 && s.endHour === 24 ? 'all day' : `${hourLabel(s.startHour)} to ${hourLabel(s.endHour)}${s.endHour < s.startHour ? ' the next day' : ''}`;
+  return `Allowed deployment hours: ${days}, ${hours}, Maryland time.`;
+}
+
+/** The publishing window in a few words for App updates' status bar, such as "Mon to Fri, 7 PM to 5 AM". */
+export function windowLabel(s: Schedule): string {
+  if (!s.enabled) return 'Anytime';
+  const days = [...s.days].sort((a, b) => a - b);
+  const short = (d: number) => DAY_NAMES[d].slice(0, 3);
+  const run = days.length >= 3 && days.every((d, i) => i === 0 || d === days[i - 1] + 1);
+  const dayText = days.length === 7 ? 'Every day' : run ? `${short(days[0])} to ${short(days[days.length - 1])}` : days.map(short).join(', ');
+  const hours = s.startHour === 0 && s.endHour === 24 ? 'all day' : `${hourLabel(s.startHour)} to ${hourLabel(s.endHour)}`;
+  return `${dayText}, ${hours}`;
+}
+
+const OPEN_EVENT = 'hrm:open-publishing-window';
+/** Opens the publishing window panel from the paused alert above the list. */
+export function openPublishingWindow() { window.dispatchEvent(new Event(OPEN_EVENT)); }
+
+/** Above the update list, only while automatic updates are paused, so a pause is never missed. */
+export function AutomaticUpdatesPausedAlert() {
+  const { data, action } = useUpdateSchedule();
+  if (data?.supported === false || !data?.schedule?.paused) return null;
+  return <div role="status" className="flex flex-wrap items-center justify-between gap-3 rounded-xl border border-status-warning/30 bg-status-warning/10 px-4 py-2.5 text-sm">
+    <span className="flex min-w-0 items-center gap-2.5"><AlertTriangle className="h-4 w-4 shrink-0 text-status-warning" aria-hidden="true" /><span className="font-medium text-text-primary">Automatic updates are paused for all apps.</span><span className="hidden text-text-secondary sm:inline">Review update and Update all still work.</span></span>
+    <span className="flex flex-wrap items-center gap-2">
+      <Button variant="outline" size="sm" className="whitespace-nowrap" disabled={action.isPending} onClick={() => action.mutate({ action: 'setPaused', paused: false })}>{action.isPending ? 'Saving…' : 'Resume automatic updates'}</Button>
+      <Button variant="ghost" size="sm" className="whitespace-nowrap text-accent-cyan hover:text-accent-cyan" onClick={openPublishingWindow}>Edit publishing window</Button>
+    </span>
+    {action.error && <p role="alert" className="w-full text-sm text-status-error">{action.error.message}</p>}
+  </div>;
+}
+
+const formatDate = (d: string) => new Date(`${d}T12:00:00Z`).toLocaleDateString('en-US', { timeZone: 'UTC', month: 'short', day: 'numeric', year: 'numeric' });
+
+export function UpdateSchedule({ appsOn, onShowApps }: { appsOn?: number; onShowApps?: () => void } = {}) {
+  const { data, error, isLoading, action } = useUpdateSchedule();
+  const [editing, setEditing] = useState(false);
+  const [draft, setDraft] = useState<Schedule | null>(null);
+  const [blackout, setBlackout] = useState({ startsOn: '', endsOn: '', label: '' });
+  useEffect(() => { if (data?.schedule && !editing) setDraft(data.schedule); }, [data?.schedule, editing]);
+  const schedule = data?.schedule;
+  useEffect(() => {
+    const open = () => { if (!schedule || action.isPending) return; action.reset(); setDraft(schedule); setEditing(true); };
+    window.addEventListener(OPEN_EVENT, open);
+    return () => window.removeEventListener(OPEN_EVENT, open);
+  }, [schedule, action]);
+  if (data?.supported === false) return null;
+  const w = data?.window;
+  const hours = Array.from({ length: 25 }, (_, h) => h);
+  const editor = draft && (<div className="space-y-3 rounded-lg border border-overlay/10 p-3 text-sm">
+      <label className="flex gap-2"><input type="checkbox" checked={draft.enabled} onChange={(e) => setDraft({ ...draft, enabled: e.target.checked })} />Restrict deploying to selected days and hours</label>
+      <p className="text-xs text-text-muted">Leave unchecked to deploy at any time. To stop automatic updates, press Pause automatic updates.</p>
+      <fieldset disabled={!draft.enabled} className="space-y-3 disabled:opacity-50">
+        <legend className="sr-only">Days and hours</legend>
+        <div className="flex flex-wrap gap-3">{DAY_NAMES.map((name, d) => <label key={name} className="flex gap-1"><input type="checkbox" checked={draft.days.includes(d)} onChange={(e) => setDraft({ ...draft, days: e.target.checked ? [...draft.days, d].sort() : draft.days.filter((x) => x !== d) })} />{name.slice(0, 3)}</label>)}</div>
+        <div className="flex flex-wrap items-center gap-2">
+          <label className="flex items-center gap-2">From <select className={field} value={draft.startHour} onChange={(e) => setDraft({ ...draft, startHour: Number(e.target.value) })}>{hours.slice(0, 24).map((h) => <option key={h} value={h}>{hourLabel(h)}</option>)}</select></label>
+          <label className="flex items-center gap-2">to <select className={field} value={draft.endHour} onChange={(e) => setDraft({ ...draft, endHour: Number(e.target.value) })}>{hours.slice(1).map((h) => <option key={h} value={h}>{hourLabel(h)}</option>)}</select></label>
+          <span className="text-text-muted">Maryland time. An end before the start runs past midnight.</span>
+        </div>
+      </fieldset>
+      <div className="flex gap-3"><Button disabled={action.isPending} onClick={() => action.mutate({ action: 'save', schedule: draft }, { onSuccess: () => setEditing(false) })}>{action.isPending ? 'Saving…' : 'Save schedule'}</Button>
+        <button className={secondary} disabled={action.isPending} onClick={() => { action.reset(); setEditing(false); }}>Cancel</button></div>
+    </div>);
+  const blackouts = data?.blackouts && <div className="space-y-2">
+      <h3 className="text-sm font-medium text-text-primary">Blackouts</h3>
+      <p className="text-sm text-text-secondary">No automatic updates or pilots start on these dates, whatever the schedule says. Use them for busy periods such as month-end.</p>
+      {data.blackouts.length === 0 && <p className="text-sm text-text-muted">No current or upcoming blackouts.</p>}
