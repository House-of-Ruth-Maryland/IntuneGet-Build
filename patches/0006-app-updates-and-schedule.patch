@@ -0,0 +1,26 @@
+/**
+ * HRM patch 0057: the "Version sync after deploy" verdict for the VM status script.
+ *
+ * deploy/intuneget-status.sh reads this every 5 minutes with the cron secret and copies the answer
+ * into hrm-status.json as checks.versionSync, which Home, the watchdog and the IT dashboard report
+ * read. Read-only; it answers counts and a fixed reason only.
+ */
+import { NextResponse } from 'next/server';
+import { getDatabase } from '@/lib/db';
+import { versionSyncVerdict } from '@/lib/hrm/version-sync-health';
+
+export const dynamic = 'force-dynamic';
+
+export async function GET(request: Request) {
+  const cronSecret = process.env.CRON_SECRET;
+  if (!cronSecret || request.headers.get('authorization') !== `Bearer ${cronSecret}`) {
+    return NextResponse.json({ error: 'Unauthorized' }, { status: 401 });
+  }
+  try {
+    const events = await getDatabase().versionSyncEvents.listRecent();
+    return NextResponse.json({ versionSync: versionSyncVerdict(events) }, { headers: { 'Cache-Control': 'no-store' } });
+  } catch {
+    // The status script keeps its last verdict when this fails; never return error text.
+    return NextResponse.json({ error: 'Unavailable' }, { status: 503, headers: { 'Cache-Control': 'no-store' } });
+  }
+}
