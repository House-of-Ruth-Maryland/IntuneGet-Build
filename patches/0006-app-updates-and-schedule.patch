@@ -0,0 +1,129 @@
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { NextRequest } from 'next/server';
+import { mkdtempSync, rmSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+
+const auth = vi.hoisted(() => vi.fn());
+vi.mock('@/lib/auth-utils', () => ({ parseAccessToken: auth }));
+vi.mock('@/lib/supabase', () => ({ getServerClientOrNull: () => null }));
+let directory: string;
+let db: typeof import('@/lib/db/sqlite').sqliteDb;
+let available: typeof import('./route');
+let policies: typeof import('@/app/api/update-policies/route');
+let policy: typeof import('@/app/api/update-policies/[id]/route');
+let history: typeof import('@/app/api/updates/history/route');
+
+const request = (path: string, body?: unknown, method = 'GET') => new NextRequest(`http://localhost${path}`, {
+  method, headers: { Authorization: 'Bearer fixture', 'Content-Type': 'application/json' },
+  ...(body ? { body: JSON.stringify(body) } : {}),
+});
+const signIn = (userId: string, tenantId = 'tenant-one') => auth.mockResolvedValue({ userId, tenantId, userEmail: `${userId}@example.test` });
+
+beforeEach(async () => {
+  vi.resetModules();
+  directory = mkdtempSync(join(tmpdir(), 'tenant-updates-'));
+  vi.stubEnv('DATABASE_PATH', join(directory, 'fixture.db'));
+  vi.stubEnv('DATABASE_MODE', 'sqlite');
+  ({ sqliteDb: db } = await import('@/lib/db/sqlite'));
+  vi.doMock('@/lib/db', () => ({ getDatabase: () => db, isSqliteMode: () => true }));
+  available = await import('./route');
+  policies = await import('@/app/api/update-policies/route');
+  policy = await import('@/app/api/update-policies/[id]/route');
+  history = await import('@/app/api/updates/history/route');
+  signIn('participant-01');
+});
+afterEach(async () => {
+  (await import('@/lib/db/sqlite')).closeSqliteDb();
+  vi.unstubAllEnvs();
+  rmSync(directory, { recursive: true, force: true });
+});
+
+async function seed() {
+  const row = await db.updateCheckResults.upsert({ user_id: 'participant-01', tenant_id: 'tenant-one', winget_id: 'Example.App', intune_app_id: 'fixture-app', display_name: 'Example app', current_version: '1.0', latest_version: '2.0', is_critical: true });
+  const sharedPolicy = await db.updatePolicies.upsert({ user_id: 'participant-01', tenant_id: 'tenant-one', winget_id: 'Example.App', policy_type: 'notify' });
+  await db.autoUpdateHistory.create({ policy_id: sharedPolicy.id, from_version: '0.5', to_version: '1.0', update_type: 'minor', status: 'completed' });
+  return { row, sharedPolicy };
+}
+
+describe('authorized tenant update views', () => {
+  it('shares deployed-app badges and the latest saved config across authors, without leaking foreign deployments', async () => {
+    const { GET: deployed } = await import('@/app/api/intune/apps/deployed/route');
+    const { GET: config } = await import('@/app/api/intune/apps/deployed/config/route');
+    const job = await db.jobs.create({ user_id: 'participant-01', tenant_id: 'tenant-one', winget_id: 'Example.App', version: '1.0', display_name: 'Example app', status: 'deployed', installer_type: 'exe', installer_url: 'https://example.test/app.exe', intune_app_id: 'fixture-app', package_config: { displayName: 'Example app' } });
+    await db.jobs.update(job.id, { intune_app_id: 'fixture-app' });
+    await db.uploadHistory.create({ user_id: 'participant-01', intune_tenant_id: 'tenant-one', winget_id: 'Example.App', version: '1.0', display_name: 'Example app', intune_app_id: 'fixture-app', packaging_job_id: job.id });
+    const read = async () => Promise.all([
+      deployed(request('/api/intune/apps/deployed')).then(r => r.json()),
+      config(request('/api/intune/apps/deployed/config?wingetId=Example.App')).then(r => r.json()),
+    ]);
+    const first = await read();
+    expect(first).toMatchObject([{ deployedWingetIds: ['Example.App'], count: 1 }, { config: { displayName: 'Example app' }, intuneAppId: 'fixture-app' }]);
+    signIn('participant-02');
+    expect(await read()).toEqual(first);
+    const { buildDeploymentConfigFromAdapter } = await import('@/lib/update-policies/build-deployment-config');
+    expect(await buildDeploymentConfigFromAdapter(db, { userId: 'participant-02', tenantId: 'tenant-one', wingetId: 'Example.App', latestVersion: '2.0' })).toMatchObject({ status: 'ok', deploymentConfig: { displayName: 'Example app' } });
+    signIn('participant-03', 'tenant-two');
+    expect(await read()).toMatchObject([{ deployedWingetIds: [], count: 0 }, { config: null, intuneAppId: null }]);
+  });
+
+  it('gives two users identical updates, badge/Home counts, policies and activity, with no foreign tenant results', async () => {
+    const { sharedPolicy } = await seed();
+    const view = async () => Promise.all([
+      available.GET(request('/api/updates/available')).then(r => r.json()),
+      policies.GET(request('/api/update-policies')).then(r => r.json()),
+      history.GET(request('/api/updates/history')).then(r => r.json()),
+      policy.GET(request('/api/update-policies/id'), { params: Promise.resolve({ id: sharedPolicy.id }) }).then(r => r.json()),
+    ]);
+    const first = await view();
+    expect(first[0]).toMatchObject({ count: 1, criticalCount: 1, updates: [{ policy: { id: sharedPolicy.id } }] });
+    expect(first[2]).toMatchObject({ count: 1 });
+    signIn('participant-02');
+    expect(await view()).toEqual(first);
+    signIn('participant-03', 'tenant-two');
+    const foreign = await view();
+    expect(foreign.slice(0, 3).map(v => v.count)).toEqual([0, 0, 0]);
+    expect(foreign[3]).toEqual({ error: 'Policy not found' });
+    for (const path of ['/api/updates/available', '/api/update-policies', '/api/updates/history']) {
+      const handler = path.includes('available') ? available.GET : path.includes('history') ? history.GET : policies.GET;
+      expect((await handler(request(`${path}?tenant_id=tenant-one`))).status).toBe(403);
+    }
+    auth.mockResolvedValue(null);
+    expect((await available.GET(request('/api/updates/available'))).status).toBe(401);
+  });
+
+  it('shares dismiss/restore and policy changes while refusing foreign IDs and tenant writes', async () => {
+    const { row, sharedPolicy } = await seed();
+    signIn('participant-02');
+    expect(await (await available.PATCH(request('/api/updates/available', { update_ids: [row.id], action: 'dismiss' }, 'PATCH'))).json()).toMatchObject({ updated: 1 });
+    signIn('participant-01');
+    expect(await (await available.GET(request('/api/updates/available'))).json()).toMatchObject({ count: 0 });
+    signIn('participant-02');
+    await available.PATCH(request('/api/updates/available', { update_ids: [row.id], action: 'restore' }, 'PATCH'));
+    const saved = await policies.POST(request('/api/update-policies', { tenant_id: 'tenant-one', winget_id: 'Example.App', policy_type: 'ignore' }, 'POST'));
+    expect(await saved.json()).toMatchObject({ created: false, policy: { id: sharedPolicy.id, user_id: 'participant-01' } });
+    signIn('participant-01');
+    expect(await (await available.GET(request('/api/updates/available'))).json()).toMatchObject({ count: 0 });
+    signIn('participant-03', 'tenant-two');
+    expect(await (await available.PATCH(request('/api/updates/available', { update_ids: [row.id], action: 'dismiss' }, 'PATCH'))).json()).toMatchObject({ updated: 0 });
+    expect((await policies.POST(request('/api/update-policies', { tenant_id: 'tenant-one', winget_id: 'Example.App', policy_type: 'notify' }, 'POST'))).status).toBe(403);
+    expect((await policy.PATCH(request('/api/update-policies/id', { policy_type: 'notify' }, 'PATCH'), { params: Promise.resolve({ id: sharedPolicy.id }) })).status).toBe(404);
+    expect((await policy.DELETE(request('/api/update-policies/id', undefined, 'DELETE'), { params: Promise.resolve({ id: sharedPolicy.id }) })).status).toBe(404);
+    expect((await db.updatePolicies.getByKey('participant-01', 'tenant-one', 'Example.App'))?.policy_type).toBe('ignore');
+  });
+
+  it('uses the newest legacy tenant policy and check once, applying dismissal before counts', async () => {
+    const { row } = await seed();
+    const newer = '2099-01-01T00:00:00.000Z';
+    await db.updateCheckResults.upsert({ ...row, id: 'newer-check', user_id: 'participant-02', updated_at: newer, dismissed_at: newer });
+    await db.updatePolicies.upsert({ user_id: 'participant-02', tenant_id: 'tenant-one', winget_id: 'Example.App', policy_type: 'ignore', updated_at: newer });
+    for (const user of ['participant-01', 'participant-02']) {
+      signIn(user);
+      expect(await (await available.GET(request('/api/updates/available'))).json()).toMatchObject({ count: 0, criticalCount: 0 });
+      expect(await db.updateCheckResults.list(user, { tenantId: 'tenant-one', includeDismissed: true })).toHaveLength(1);
+      expect(await db.updatePolicies.list(user, 'tenant-one')).toMatchObject([{ policy_type: 'ignore' }]);
+      expect((await db.updatePolicies.getByKey(user, 'tenant-one', 'Example.App'))?.policy_type).toBe('ignore');
+    }
+    expect(await db.updatePolicies.listAll()).toHaveLength(1);
+  });
+});
