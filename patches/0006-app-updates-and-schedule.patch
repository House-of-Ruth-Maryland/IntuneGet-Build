+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { mkdtempSync, rmSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+const deliver = vi.hoisted(() => vi.fn(async () => ({ success: true })));
+vi.mock('@/lib/webhooks/service', () => ({ deliverFormattedWebhook: deliver }));
+let dir: string;
+beforeEach(() => { vi.resetModules(); deliver.mockClear(); deliver.mockResolvedValue({ success: true }); dir = mkdtempSync(join(tmpdir(), 'intuneget-paused-')); process.env.DATABASE_PATH = join(dir, 'app.db'); });
+afterEach(async () => { (await import('@/lib/db/sqlite')).closeSqliteDb(); rmSync(dir, { recursive: true, force: true }); delete process.env.DATABASE_PATH; });
+async function setup() {
+  const { sqliteDb: db, sqliteWebhooks } = await import('@/lib/db/sqlite');
+  const { alertPausedAutoUpdates } = await import('../paused-auto-update');
+  const webhooks = vi.spyOn(sqliteWebhooks, 'listAllEnabled').mockResolvedValue([{ id: 'w1', name: 'IT Ops', webhook_type: 'teams' }] as never);
+  vi.spyOn(sqliteWebhooks, 'recordResult').mockResolvedValue(undefined as never);
+  const policy = await db.updatePolicies.upsert({ user_id: 'u', tenant_id: 't', winget_id: 'Vendor.App', policy_type: 'auto_update', is_enabled: false, consecutive_failures: 3, deployment_config: { displayName: 'Vendor App' } });
+  return { db, policy, alert: () => alertPausedAutoUpdates(db), webhooks };
+}
+describe('paused auto-update alert (HRM patch 0032)', () => {
+  it('posts once per pause, naming the app, and again after a later pause', async () => {
+    const { db, policy, alert } = await setup();
+    expect(await alert()).toEqual({ paused: 1, alerted: 1 });
+    const card = JSON.stringify((deliver.mock.calls[0] as unknown[])[1]);
+    expect(card).toContain('Auto-update turned off for Vendor App');
+    expect(card).toContain('3 failed updates in a row');
+    expect(await alert()).toEqual({ paused: 1, alerted: 0 });
+    await db.updatePolicies.update(policy.id, 'u', { is_enabled: true, consecutive_failures: 0 });
+    expect(await alert()).toEqual({ paused: 0, alerted: 0 });
+    await db.updatePolicies.update(policy.id, 'u', { is_enabled: false, consecutive_failures: 3 });
+    expect(await alert()).toEqual({ paused: 1, alerted: 1 });
+    expect(deliver).toHaveBeenCalledTimes(2);
+  });
+  it('tries again at the next check when no webhook accepted it', async () => {
+    const { alert } = await setup();
+    deliver.mockResolvedValueOnce({ success: false, error: 'down' } as never);
+    expect(await alert()).toEqual({ paused: 1, alerted: 0 });
+    expect(await alert()).toEqual({ paused: 1, alerted: 1 });
+  });
+  it('ignores policies turned off by staff', async () => {
+    const { db, policy, alert } = await setup();
+    await db.updatePolicies.update(policy.id, 'u', { consecutive_failures: 0 });
+    expect(await alert()).toEqual({ paused: 0, alerted: 0 });
+    expect(deliver).not.toHaveBeenCalled();
+  });
+});
