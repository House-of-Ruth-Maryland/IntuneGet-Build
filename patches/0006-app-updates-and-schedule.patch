diff --git a/lib/hrm/__tests__/version-sync-health.test.ts b/lib/hrm/__tests__/version-sync-health.test.ts
new file mode 100644
index 000000000..af98aecf0
--- /dev/null
+++ b/lib/hrm/__tests__/version-sync-health.test.ts
@@ -0,0 +1,97 @@
+// HRM patch 0057: the "Version sync after deploy" verdict.
+import { describe, expect, it, vi } from 'vitest';
+import {
+  recentVersionSyncEvents,
+  recordUpdateCheckCorrection,
+  UPDATE_CHECK_ENTRY,
+  versionSyncErrorCode,
+  versionSyncVerdict,
+  VERSION_SYNC_KEEP,
+  type VersionSyncEvent,
+} from '@/lib/hrm/version-sync-health';
+
+const now = new Date('2026-11-03T12:00:00.000Z');
+const hoursAgo = (h: number) => new Date(now.getTime() - h * 3_600_000).toISOString();
+const failed = (h: number, code: VersionSyncEvent['code'] = 'database_busy'): VersionSyncEvent => ({ at: hoursAgo(h), appId: 'Vendor.App', result: 'failed', code });
+const ok = (h: number): VersionSyncEvent => ({ at: hoursAgo(h), appId: 'Vendor.App', result: 'ok', code: null });
+
+describe('versionSyncVerdict', () => {
+  it('works with nothing recorded', () => {
+    expect(versionSyncVerdict([], now)).toEqual({ ok: true, at: null, detail: null });
+  });
+
+  it('stays working after one failure', () => {
+    expect(versionSyncVerdict([failed(1)], now)).toEqual({ ok: true, at: hoursAgo(1), detail: null });
+  });
+
+  it('fails at 2 failures in the last 24 hours, with a plain reason', () => {
+    const verdict = versionSyncVerdict([failed(1, 'timeout'), failed(20)], now);
+    expect(verdict.ok).toBe(false);
+    expect(verdict.at).toBe(hoursAgo(1));
+    expect(verdict.detail).toBe('App updates missed 2 deploys in 24 hours (timed out). The next update check corrects it.');
+  });
+
+  it('does not count failures older than 24 hours', () => {
+    expect(versionSyncVerdict([failed(1), failed(25)], now).ok).toBe(true);
+  });
+
+  it('clears when a later sync succeeds', () => {
+    expect(versionSyncVerdict([ok(0.5), failed(1), failed(2)], now)).toEqual({ ok: true, at: hoursAgo(0.5), detail: null });
+  });
+
+  it('fails again after 2 more failures following that success', () => {
+    expect(versionSyncVerdict([failed(0.1), ok(0.5), failed(1), failed(2)], now).ok).toBe(true);
+    expect(versionSyncVerdict([failed(0.1), failed(0.2), ok(0.5), failed(1)], now).ok).toBe(false);
+  });
+
+  it('reads entries in any order', () => {
+    expect(versionSyncVerdict([failed(2), ok(0.5), failed(1)], now).ok).toBe(true);
+  });
+});
+
+describe('recentVersionSyncEvents', () => {
+  it('keeps only the newest entries from the last 7 days', () => {
+    const many = Array.from({ length: VERSION_SYNC_KEEP + 10 }, (_, i) => failed(i));
+    const kept = recentVersionSyncEvents([...many, failed(24 * 8), { ...ok(1), at: 'not a time' }], now);
+    expect(kept).toHaveLength(VERSION_SYNC_KEEP);
+    expect(kept[0].at).toBe(hoursAgo(0));
+  });
+});
+
+describe('versionSyncErrorCode', () => {
+  it('maps errors to fixed codes', () => {
+    expect(versionSyncErrorCode(Object.assign(new Error('x'), { code: 'SQLITE_BUSY' }))).toBe('database_busy');
+    expect(versionSyncErrorCode(Object.assign(new Error('x'), { code: 'SQLITE_LOCKED_SHAREDCACHE' }))).toBe('database_busy');
+    expect(versionSyncErrorCode(Object.assign(new Error('x'), { code: 'SQLITE_CONSTRAINT' }))).toBe('database_error');
+    expect(versionSyncErrorCode({ code: 'PGRST301', message: 'x' })).toBe('database_error');
+    expect(versionSyncErrorCode({ code: '23505', message: 'x' })).toBe('database_error');
+    expect(versionSyncErrorCode({ code: '40P01', message: 'x' })).toBe('database_error');
+    for (const code of ['EPERM', 'EBUSY', 'EPIPE', 'EACCES']) expect(versionSyncErrorCode(Object.assign(new Error('x'), { code }))).toBe('unknown');
+    expect(versionSyncErrorCode(Object.assign(new Error('x'), { name: 'TimeoutError' }))).toBe('timeout');
+    expect(versionSyncErrorCode(new Error('fixture detail'))).toBe('unknown');
+    expect(versionSyncErrorCode(null)).toBe('unknown');
+    expect(versionSyncErrorCode('text')).toBe('unknown');
+  });
+});
+
+describe('recordUpdateCheckCorrection', () => {
+  it('records a success after a full update check, which clears the check', async () => {
+    const events: VersionSyncEvent[] = [failed(2), failed(3)];
+    const store = { record: vi.fn(async (event: VersionSyncEvent) => { events.unshift(event); }) };
+    expect(versionSyncVerdict(events, now).ok).toBe(false);
+    await expect(recordUpdateCheckCorrection(store, {}, new Date(hoursAgo(1)))).resolves.toBe(true);
+    expect(store.record).toHaveBeenCalledWith({ at: hoursAgo(1), appId: UPDATE_CHECK_ENTRY, result: 'ok', code: null });
+    expect(versionSyncVerdict(events, now)).toEqual({ ok: true, at: hoursAgo(1), detail: null });
+    // New failures after the check raise it again by the same rule.
+    events.unshift(failed(0.5), failed(0.25));
+    expect(versionSyncVerdict(events, now).ok).toBe(false);
+  });
+
+  it('records nothing when the catalog was unreadable, and never throws', async () => {
+    const store = { record: vi.fn(async () => {}) };
+    await expect(recordUpdateCheckCorrection(store, { catalogUnavailable: true }, now)).resolves.toBe(false);
+    expect(store.record).not.toHaveBeenCalled();
+    const failing = { record: vi.fn(async () => { throw new Error('fixture'); }) };
+    await expect(recordUpdateCheckCorrection(failing, {}, now)).resolves.toBe(false);
+  });
+});
diff --git a/lib/hrm/deployed-version-sync.ts b/lib/hrm/deployed-version-sync.ts
new file mode 100644
index 000000000..af6ae0e29
--- /dev/null
+++ b/lib/hrm/deployed-version-sync.ts
@@ -0,0 +1,81 @@
+/**
+ * HRM patch 0049: keep detected updates true as soon as a deployment finishes.
+ *
+ * The update check (3:30 AM and 3:30 PM) records "app X is on v1, v2 is out" for the newest copy of
+ * each app in each tenant (patch 0024). A deployment of v2 used to leave that row saying v1 until the
+ * next check. These helpers decide what the row should say once a new copy is deployed, and whether a
+ * stored row is already out of date when it is read, so both database adapters behave the same.
+ */
+import { compareVersions } from '@/lib/version-compare';
+import type { DeployedCopy, UpdateCheckResult, UploadHistoryRecord } from '@/lib/db/types';
+
+export type { DeployedCopy };
+
+export interface DeployedVersionSyncPlan {
+  /** Rows to delete (every row for the app when the new copy is current). */
+  deleteIds: string[];
+  /** The single row that replaces them, on the new copy, or null when the app is up to date. */
+  replacement: UpdateCheckResult | null;
+}
+
+function isMajorBump(current: string, latest: string): boolean {
+  const currentMajor = Number.parseInt(current.split('.')[0] ?? '', 10);
+  const latestMajor = Number.parseInt(latest.split('.')[0] ?? '', 10);
+  return Number.isFinite(currentMajor) && Number.isFinite(latestMajor) && latestMajor > currentMajor;
+}
+
+/**
+ * Plan the change to one tenant's update rows for an app after a new copy of it is deployed.
+ * Rows already at or below the deployed version are removed. Otherwise one row is kept, moved to the
+ * new copy (patch 0024: only the newest copy has a row) with the deployed version as its current
+ * version. Its id, dismissed and notified state stay, because the version it offers did not change.
+ */
+export function planDeployedVersionSync(
+  rows: UpdateCheckResult[],
+  deployed: DeployedCopy,
+  now: string
+): DeployedVersionSyncPlan {
+  const matching = rows.filter((row) => row.tenant_id === deployed.tenantId && row.winget_id === deployed.wingetId);
+  if (matching.length === 0) return { deleteIds: [], replacement: null };
+
+  const reference = [...matching].sort((a, b) => {
+    const byVersion = compareVersions(b.latest_version, a.latest_version);
+    return byVersion !== 0 ? byVersion : String(b.updated_at).localeCompare(String(a.updated_at));
+  })[0];
+  const deleteIds = matching.map((row) => row.id);
+
+  if (compareVersions(reference.latest_version, deployed.version) <= 0) {
+    return { deleteIds, replacement: null };
+  }
+
+  return {
+    deleteIds,
+    replacement: {
+      ...reference,
+      user_id: deployed.userId,
+      intune_app_id: deployed.intuneAppId,
+      display_name: deployed.displayName || reference.display_name,
+      current_version: deployed.version,
+      is_critical: isMajorBump(deployed.version, reference.latest_version),
+      updated_at: now,
+    },
+  };
+}
+
+/**
+ * Read-time safety net: the version an update row should show, given the newest deployment of the
+ * app in its tenant. Only a deployment made after the row was last written counts, so a newer copy
+ * that was later deleted in Intune (and skipped by the check, patch 0023) never hides a real update.
+ */
+export function effectiveCurrentVersion(
+  row: Pick<UpdateCheckResult, 'current_version' | 'updated_at'>,
+  newest: Pick<UploadHistoryRecord, 'version' | 'deployed_at'> | null
+): string {
+  if (!newest?.version || !newest.deployed_at) return row.current_version;
+  const deployedAt = Date.parse(newest.deployed_at);
+  const writtenAt = Date.parse(row.updated_at);
+  if (!Number.isFinite(deployedAt) || !Number.isFinite(writtenAt) || deployedAt <= writtenAt) {
+    return row.current_version;
+  }
+  return compareVersions(newest.version, row.current_version) > 0 ? newest.version : row.current_version;
+}
diff --git a/lib/hrm/github-releases.ts b/lib/hrm/github-releases.ts
new file mode 100644
index 000000000..8672cd10f
--- /dev/null
+++ b/lib/hrm/github-releases.ts
@@ -0,0 +1,155 @@
+/**
+ * HRM patch 0020: new GitHub releases of custom apps.
+ *
+ * A custom app installed from a GitHub release download
+ * (https://github.com/<owner>/<repo>/releases/download/<tag>/<file>) is
+ * checked against the repository's latest release (GitHub's public API, no
+ * token; drafts and pre-releases are never "latest"). When it's newer and has
+ * the same file with the version swapped, it shows in App updates with
+ * "Deploy new version", which opens the custom app form already filled in.
+ * Nothing is deployed automatically.
+ */
+
+import type { PackagingJob, UploadHistoryRecord } from '@/lib/db/types';
+import { isCustomAppId } from '@/lib/hrm/new-version';
+import { compareVersions } from '@/lib/version-compare';
+
+export interface GithubReleaseSource {
+  owner: string;
+  repo: string;
+  tag: string;
+  file: string;
+}
+
+export interface CustomRelease {
+  tenant_id: string;
+  intune_app_id: string;
+  job_id: string;
+  version: string;
+  installer_url: string;
+  installer_sha256: string | null;
+  release_url: string;
+  checked_at: string;
+}
+
+export interface CustomReleaseStore {
+  save(release: CustomRelease): Promise<void>;
+  get(tenantId: string, intuneAppId: string): Promise<CustomRelease | null>;
+  removeMissing(keep: Array<{ tenantId: string; intuneAppId: string }>): Promise<void>;
+}
+
+const NAME = /^[A-Za-z0-9_.-]{1,100}$/;
+
+export function parseGithubReleaseUrl(url: string | null | undefined): GithubReleaseSource | null {
+  let parsed: URL;
+  try {
+    parsed = new URL(url ?? '');
+  } catch {
+    return null;
+  }
+  if (parsed.protocol !== 'https:' || parsed.hostname !== 'github.com') return null;
+  const parts = parsed.pathname.split('/').filter(Boolean).map(decodeURIComponent);
+  if (parts.length !== 6 || parts[2] !== 'releases' || parts[3] !== 'download') return null;
+  const [owner, repo, , , tag, file] = parts;
+  if (!NAME.test(owner) || !NAME.test(repo) || !tag || !file) return null;
+  return { owner, repo, tag, file };
+}
+
+/** "v0.16.0" -> "0.16.0"; tags like "release-2" stay as they are. */
+export function versionFromTag(tag: string): string {
+  return tag.replace(/^v(?=\d)/i, '');
+}
+
+/** The file name the new release should have: the old name with the old version or tag swapped. */
+export function expectedAssetNames(source: GithubReleaseSource, oldVersion: string, newTag: string): string[] {
+  const newVersion = versionFromTag(newTag);
+  const names = new Set<string>();
+  if (oldVersion && source.file.includes(oldVersion)) names.add(source.file.split(oldVersion).join(newVersion));
+  if (source.file.includes(source.tag)) names.add(source.file.split(source.tag).join(newTag));
+  const oldTagVersion = versionFromTag(source.tag);
+  if (oldTagVersion && source.file.includes(oldTagVersion)) names.add(source.file.split(oldTagVersion).join(newVersion));
+  // A name without any version (setup.exe) is the same file in every release.
+  if (names.size === 0) names.add(source.file);
+  return [...names];
+}
+
+interface GithubRelease {
+  tag_name?: string;
+  html_url?: string;
+  draft?: boolean;
+  prerelease?: boolean;
+  assets?: Array<{ name?: string; browser_download_url?: string; digest?: string | null }>;
+}
+
+export async function fetchLatestRelease(
+  source: Pick<GithubReleaseSource, 'owner' | 'repo'>,
+  fetchImpl: typeof fetch = fetch
+): Promise<GithubRelease | null | undefined> {
+  const response = await fetchImpl(`https://api.github.com/repos/${source.owner}/${source.repo}/releases/latest`, {
+    headers: { Accept: 'application/vnd.github+json', 'User-Agent': 'IntuneGet-HRM', 'X-GitHub-Api-Version': '2022-11-28' },
+    redirect: 'error',
+  });
+  if (response.status === 404) return null;
+  if (!response.ok) throw new Error(`GitHub returned ${response.status}`);
+  return (await response.json()) as GithubRelease;
+}
+
+export interface ReleaseFinding {
+  deployment: UploadHistoryRecord;
+  release: CustomRelease;
+}
+
+/**
+ * Checks the newest deployment of each custom app. Only apps whose last job
+ * came from a GitHub release download are looked up, once per repository.
+ */
+export async function findCustomAppReleases(
+  deployments: UploadHistoryRecord[],
+  getJob: (id: string) => Promise<PackagingJob | null>,
+  // HRM patch 0024: told about apps whose repository couldn't be checked, so their existing update is kept
+  options: { fetchImpl?: typeof fetch; now?: Date; onUnchecked?: (deployment: UploadHistoryRecord) => void } = {}
+): Promise<ReleaseFinding[]> {
+  const nowIso = (options.now ?? new Date()).toISOString();
+  const latestByRepo = new Map<string, Promise<GithubRelease | null | undefined>>();
+  const findings: ReleaseFinding[] = [];
+
+  for (const deployment of deployments) {
+    if (!isCustomAppId(deployment.winget_id) || !deployment.packaging_job_id || !deployment.intune_tenant_id) continue;
+    const job = await getJob(deployment.packaging_job_id).catch(() => null);
+    const source = parseGithubReleaseUrl(job?.installer_url);
+    if (!job || !source) continue;
+
+    const repoKey = `${source.owner}/${source.repo}`.toLowerCase();
+    if (!latestByRepo.has(repoKey)) latestByRepo.set(repoKey, fetchLatestRelease(source, options.fetchImpl).catch(() => undefined));
+    const latest = await latestByRepo.get(repoKey)!;
+    if (latest === undefined) {
+      options.onUnchecked?.(deployment);
+      continue;
+    }
+    if (!latest?.tag_name || latest.draft || latest.prerelease) continue;
+
+    const version = versionFromTag(latest.tag_name);
+    if (compareVersions(version, deployment.version) <= 0) continue;
+
+    const wanted = expectedAssetNames(source, deployment.version, latest.tag_name);
+    const asset = (latest.assets ?? []).find((a) => a.name && wanted.includes(a.name));
+    const download = asset?.browser_download_url;
+    if (!download || !parseGithubReleaseUrl(download)) continue;
+
+    findings.push({
+      deployment,
+      release: {
+        tenant_id: deployment.intune_tenant_id,
+        intune_app_id: deployment.intune_app_id,
+        job_id: job.id,
+        version,
+        installer_url: download,
+        // GitHub publishes each asset's SHA-256 as "sha256:<hex>" (newer releases only).
+        installer_sha256: /^sha256:([0-9a-f]{64})$/i.exec(asset?.digest ?? '')?.[1]?.toLowerCase() ?? null,
+        release_url: latest.html_url && /^https:\/\/github\.com\//.test(latest.html_url) ? latest.html_url : `https://github.com/${source.owner}/${source.repo}/releases`,
+        checked_at: nowIso,
+      },
+    });
+  }
+  return findings;
+}
diff --git a/lib/hrm/manual-update.ts b/lib/hrm/manual-update.ts
new file mode 100644
index 000000000..beb376bbc
--- /dev/null
+++ b/lib/hrm/manual-update.ts
@@ -0,0 +1,165 @@
+/**
+ * HRM patch: Update and Update All on a SQLite server.
+ *
+ * Upstream's /api/updates/trigger only has a Supabase implementation. This is
+ * the same flow on the database adapter: find the detected update, use (or
+ * create) the app's update policy with the settings of its last IntuneGet
+ * deployment, create the job with upstream's SQLite trigger (which keeps the
+ * curated, licence, prior-deployment and Intune approval checks), then start
+ * the GitHub packaging run. A manual press skips the rate limits and the
+ * patch/minor/major scope, as upstream's hosted manual trigger does.
+ */
+
+import { pilotHold } from './pilot-guard';
+import type { DatabaseAdapter } from '@/lib/db/types';
+import { getLatestInstallerInfo } from '@/lib/auto-update/trigger';
+import { triggerSqliteAutoUpdate } from '@/lib/auto-update/sqlite';
+import { buildDeploymentConfigFromAdapter } from '@/lib/update-policies/build-deployment-config';
+import { isSelfUpdatingApp } from '@/lib/self-updating-apps';
+import type { AppUpdatePolicy, DeploymentConfig, TriggerUpdateResponse } from '@/types/update-policies';
+import { dispatchUpdateJob } from './update-dispatch';
+
+type Result = TriggerUpdateResponse['results'][number];
+
+async function policyWithConfig(
+  db: DatabaseAdapter,
+  userId: string,
+  tenantId: string,
+  wingetId: string,
+  latestVersion: string,
+): Promise<AppUpdatePolicy | string> {
+  const existing = await db.updatePolicies.getByKey(userId, tenantId, wingetId);
+  if (existing?.deployment_config && existing.original_upload_history_id) return existing;
+
+  const built = await buildDeploymentConfigFromAdapter(db, { userId, tenantId, wingetId, latestVersion });
+  if (built.status !== 'ok') {
+    return built.status === 'orphaned_job'
+      ? 'Could not retrieve the saved deployment configuration for this app.'
+      : 'This app needs a prior IntuneGet deployment before it can be updated from here.';
+  }
+  const saved = existing
+    ? await db.updatePolicies.update(existing.id, userId, {
+        deployment_config: built.deploymentConfig,
+        original_upload_history_id: built.originalUploadHistoryId,
+        updated_at: new Date().toISOString(),
+      })
+    : await db.updatePolicies.upsert({
+        user_id: userId,
+        tenant_id: tenantId,
+        winget_id: wingetId,
+        policy_type: 'notify',
+        deployment_config: built.deploymentConfig,
+        original_upload_history_id: built.originalUploadHistoryId,
+        is_enabled: true,
+        updated_at: new Date().toISOString(),
+      });
+  return saved ?? 'Failed to save the update policy.';
+}
+
+export async function updateOne(
+  db: DatabaseAdapter,
+  user: { userId: string; tenantId: string; userEmail?: string | null },
+  req: { winget_id: string; tenant_id: string },
+  batch: boolean,
+  pilot?: { id: string; groupId: string; sourceAppId?: string; sourceVersion?: string },
+): Promise<Result> {
+  const fail = (error: string, extra: Partial<Result> = {}): Result => ({ winget_id: req.winget_id, tenant_id: req.tenant_id, success: false, error, ...extra });
+
+  const held = await pilotHold(user.tenantId, req.winget_id, pilot?.id);
+  if (held) return fail(held, { skipped: true });
+
+  // One organisation per server: only the signed-in tenant can be updated.
+  if (req.tenant_id !== user.tenantId) return fail('This update belongs to another tenant.');
+  if (isSelfUpdatingApp(req.winget_id)) {
+    return fail(`${req.winget_id} keeps itself up to date on the device (Click-to-Run); IntuneGet does not deploy updates for it. Refresh the updates list to remove it.`);
+  }
+
+  // HRM patch 0024: one update at a time per app, so a double press or Update All can't create two Intune apps
+  const running = (await db.jobs.getByTenantId(req.tenant_id, 200).catch(() => []))
+    .find((job) => job.winget_id === req.winget_id && ['queued', 'packaging', 'uploading'].includes(job.status));
+  if (running) return fail('An update for this app is already running. Check Deployments.', { skipped: true });
+
+  const detected = (await db.updateCheckResults.list(user.userId, { tenantId: req.tenant_id, includeDismissed: true }))
+    .find((row) => row.winget_id === req.winget_id);
+  if (!detected) return fail('Update not found');
+
+  const policy = await policyWithConfig(db, user.userId, req.tenant_id, req.winget_id, detected.latest_version);
+  if (typeof policy === 'string') return fail(policy);
+  const config = policy.deployment_config as DeploymentConfig;
+
+  const resolution = await getLatestInstallerInfo(null as never, req.winget_id, config?.architecture, config?.installScope);
+  if (!resolution.ok) return fail(resolution.failure.message);
+  const info = resolution.info;
+
+  // The newest deployment holds the Intune app to supersede; the stored check result can be stale.
+  const latestUpload = await db.uploadHistory.getLatest(user.userId, req.tenant_id, req.winget_id);
+
+  // A manual press deploys whatever the policy type is; nothing is written back to the policy type.
+  // HRM patch 0024: nor by automatic-update failures (three of them switch auto-update off, not the button).
+  const manualPolicy: AppUpdatePolicy = { ...policy, policy_type: 'auto_update', is_enabled: true, consecutive_failures: 0 };
+  const triggered = await triggerSqliteAutoUpdate(db, manualPolicy, {
+    sourceType: info.sourceType,
+    curatedReleaseId: info.curatedReleaseId,
+    wingetId: req.winget_id,
+    currentVersion: pilot?.sourceVersion ?? latestUpload?.version ?? detected.current_version,
+    latestVersion: info.latestVersion,
+    currentIntuneAppId: pilot?.sourceAppId ?? latestUpload?.intune_app_id ?? detected.intune_app_id ?? null,
+    displayName: info.displayName,
+    installerUrl: info.installerUrl,
+    installerSha256: info.installerSha256,
+    installerType: info.installerType,
+    installCommand: info.installCommand ?? '',
+    uninstallCommand: info.uninstallCommand ?? '',
+    installScope: info.installScope ?? null,
+    nestedInstallerType: info.nestedInstallerType,
+    nestedInstallerPath: info.nestedInstallerPath,
+    installerSuccessCodes: info.installerSuccessCodes,
+  }, { skipRateLimits: true, bypassUpdateScope: true, pilot });
+
+  if (!triggered.success || !triggered.packagingJobId) {
+    return fail(triggered.error || triggered.skipReason || 'Unknown error', {
+      skipped: triggered.skipped || undefined,
+      code: triggered.code as Result['code'],
+    });
+  }
+
+  if (pilot) {
+    const { sqlitePilotRollouts } = await import('@/lib/db/sqlite');
+    sqlitePilotRollouts.attach(user.tenantId, pilot.id, triggered.packagingJobId);
+  }
+
+  // Record who pressed Update: the job (and the Teams card, Recent deployments) shows it.
+  if (user.userEmail) await db.jobs.update(triggered.packagingJobId, { user_email: user.userEmail });
+
+  const dispatch = await dispatchUpdateJob(db, triggered.packagingJobId, { batch });
+  if (!dispatch.dispatched && dispatch.reason !== 'local-packager') {
+    return fail(dispatch.message, { skipped: dispatch.reason === 'qa-hold' || undefined });
+  }
+  return { winget_id: req.winget_id, tenant_id: req.tenant_id, success: true, packaging_job_id: triggered.packagingJobId };
+}
+
+export async function runSqliteManualUpdates(
+  db: DatabaseAdapter,
+  user: { userId: string; tenantId: string; userEmail?: string | null },
+  requests: { winget_id: string; tenant_id: string }[],
+): Promise<TriggerUpdateResponse> {
+  const response: TriggerUpdateResponse = { success: true, triggered: 0, failed: 0, results: [] };
+  // HRM patch 0024: the same app twice in one request (Update All with two copies) is updated once
+  const seen = new Set<string>();
+  for (const req of requests) {
+    const key = `${req.tenant_id}|${req.winget_id}`;
+    if (seen.has(key)) continue;
+    seen.add(key);
+    let result: Result;
+    try {
+      result = await updateOne(db, user, req, requests.length > 1);
+    } catch (error) {
+      result = { winget_id: req.winget_id, tenant_id: req.tenant_id, success: false, error: error instanceof Error ? error.message : 'Unknown error' };
+    }
+    if (result.success) response.triggered++;
+    else response.failed++;
+    response.results.push(result);
+  }
+  response.success = response.failed === 0;
+  return response;
+}
diff --git a/lib/hrm/paused-auto-update.ts b/lib/hrm/paused-auto-update.ts
new file mode 100644
index 000000000..819640892
--- /dev/null
+++ b/lib/hrm/paused-auto-update.ts
@@ -0,0 +1,64 @@
+/**
+ * HRM patch 0032: tell IT Ops when auto-update turns itself off for an app after repeated failures.
+ * Upstream silently disabled the policy (and, before 0032, never reached the limit). One alert per
+ * pause; turning auto-update back on clears it, so a later pause alerts again.
+ */
+import type Database from 'better-sqlite3';
+import type { DatabaseAdapter } from '@/lib/db/types';
+import { DEFAULT_SAFETY_CONFIG, type AppUpdatePolicy, type DeploymentConfig } from '@/types/update-policies';
+import { formatSimpleAlert } from '@/lib/webhooks/simple-alert';
+import { deliverFormattedWebhook } from '@/lib/webhooks/service';
+import { appUrl } from './site';
+
+export function createPausedAlertStore(getDb: () => Database.Database) {
+  return {
+    alerted(policyIds: string[]): Set<string> {
+      if (policyIds.length === 0) return new Set();
+      const rows = getDb().prepare(`SELECT policy_id FROM hrm_paused_auto_update_alerts WHERE policy_id IN (${policyIds.map(() => '?').join(',')})`).all(...policyIds) as Array<{ policy_id: string }>;
+      return new Set(rows.map((r) => r.policy_id));
+    },
+    mark(policyIds: string[], at: string) {
+      const db = getDb();
+      const insert = db.prepare('INSERT OR REPLACE INTO hrm_paused_auto_update_alerts (policy_id, alerted_at) VALUES (?, ?)');
+      db.transaction(() => { for (const id of policyIds) insert.run(id, at); })();
+    },
+    /** Forget every policy that isn't paused any more. */
+    keepOnly(pausedIds: string[]) {
+      const db = getDb();
+      if (pausedIds.length === 0) { db.prepare('DELETE FROM hrm_paused_auto_update_alerts').run(); return; }
+      db.prepare(`DELETE FROM hrm_paused_auto_update_alerts WHERE policy_id NOT IN (${pausedIds.map(() => '?').join(',')})`).run(...pausedIds);
+    },
+  };
+}
+
+export const isPausedByFailures = (p: AppUpdatePolicy) =>
+  p.policy_type === 'auto_update' && !p.is_enabled && p.consecutive_failures >= DEFAULT_SAFETY_CONFIG.maxConsecutiveFailures;
+
+export async function alertPausedAutoUpdates(db: DatabaseAdapter, now = new Date()) {
+  const { sqlitePausedAlerts: store, sqliteWebhooks: webhooks } = await import('@/lib/db/sqlite');
+  const paused = (await db.updatePolicies.listAll()).filter(isPausedByFailures);
+  store.keepOnly(paused.map((p) => p.id));
+  const done = store.alerted(paused.map((p) => p.id));
+  const fresh = paused.filter((p) => !done.has(p.id));
+  if (fresh.length === 0) return { paused: paused.length, alerted: 0 };
+  const names = fresh.map((p) => (p.deployment_config as DeploymentConfig | null)?.displayName || p.winget_id);
+  const base = appUrl();
+  const data = { event: 'auto_update_paused', timestamp: now.toISOString(), app_url: base, apps: fresh.map((p, i) => ({ display_name: names[i], winget_id: p.winget_id, failures: p.consecutive_failures })) };
+  let sent = 0;
+  for (const webhook of await webhooks.listAllEnabled()) {
+    const result = await deliverFormattedWebhook(webhook, formatSimpleAlert(webhook.webhook_type, {
+      data, timestamp: data.timestamp, tone: 'attention',
+      title: fresh.length === 1 ? `Auto-update turned off for ${names[0]}` : `Auto-update turned off for ${fresh.length} apps`,
+      lines: [
+        ...data.apps.map((a) => `${a.display_name}: ${a.failures} failed updates in a row`),
+        'Check the failed deployments, fix the cause, then turn auto-update back on in App updates.',
+      ],
+      link: base ? { label: 'Open Deployments', url: `${base}/dashboard/uploads?status=failed` } : undefined,
+    }));
+    await webhooks.recordResult(webhook.id, result.success);
+    if (result.success) sent++;
+  }
+  // Only a delivered alert counts; otherwise the next check tries again.
+  if (sent > 0) store.mark(fresh.map((p) => p.id), now.toISOString());
+  return { paused: paused.length, alerted: sent > 0 ? fresh.length : 0 };
+}
diff --git a/lib/hrm/replacement.ts b/lib/hrm/replacement.ts
new file mode 100644
index 000000000..ec774bee2
--- /dev/null
+++ b/lib/hrm/replacement.ts
@@ -0,0 +1,21 @@
+/**
+ * HRM patch 0024: Deploy again on a deployed app replaces it instead of adding a second copy.
+ * The new app supersedes the old one (update), gets the groups chosen in the panel (or, when none
+ * were chosen, the old app's current groups), and the old app's groups are removed so devices
+ * aren't targeted twice.
+ */
+
+const GUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
+
+export function replacementInputs(item: unknown) {
+  const id = (item as { replacesIntuneAppId?: unknown } | null)?.replacesIntuneAppId;
+  if (typeof id !== 'string' || !GUID.test(id)) return {};
+  const assignments = (item as { assignments?: unknown[] }).assignments;
+  return {
+    sourceIntuneAppId: id,
+    carryOverAssignments: !(Array.isArray(assignments) && assignments.length > 0),
+    removeAssignmentsFromPreviousApp: true,
+    autoSupersede: true,
+    supersedenceType: 'update',
+  };
+}
diff --git a/lib/hrm/update-dispatch.ts b/lib/hrm/update-dispatch.ts
new file mode 100644
index 000000000..dc6c24f35
--- /dev/null
+++ b/lib/hrm/update-dispatch.ts
@@ -0,0 +1,172 @@
+/**
+ * HRM patch: start the GitHub packaging run for a queued update job.
+ *
+ * On a SQLite server upstream creates update jobs (manual Update and
+ * auto-update) as 'queued' for a local packager. With PACKAGER_MODE=github
+ * nothing picks them up. This builds the workflow inputs from the job itself,
+ * the same fields the hosted update route sends, and dispatches it through
+ * triggerPackagingWorkflow with the installation-test gate (requireQaPass), as
+ * hosted updates do.
+ */
+
+import type { DatabaseAdapter, PackagingJob } from '@/lib/db/types';
+import { getAppConfig } from '@/lib/config';
+import { getFeatureFlags } from '@/lib/features';
+import { isGitHubActionsConfigured, triggerPackagingWorkflow, type WorkflowInputs } from '@/lib/github-actions';
+import { sanitizeAssignmentsForDispatch } from '@/lib/assignment-intents';
+import { buildIntuneAppDescription } from '@/lib/intune-description';
+import { extractSilentSwitches } from '@/lib/msp/silent-switches';
+import { describeQaGateError, isQaGateError } from '@/lib/qa/gate';
+import { dispatchFailureFields } from '@/lib/hrm/dispatch-failure';
+
+export type UpdateDispatchResult =
+  | { dispatched: true; runUrl?: string }
+  | { dispatched: false; reason: 'local-packager' | 'not-configured' | 'qa-hold' | 'error' | 'missing-job'; message: string };
+
+type PackageConfig = Record<string, unknown> & {
+  assignments?: unknown[];
+  categories?: unknown[];
+  requirementRules?: unknown[];
+  relationships?: unknown[];
+  psadtConfig?: unknown;
+  sourceIntuneAppId?: string | null;
+  forceCreate?: boolean;
+  description?: string;
+  sourceType?: 'winget' | 'custom' | 'curated';
+  curatedReleaseId?: string;
+  nestedInstallerType?: string;
+  nestedInstallerPath?: string;
+  installerSuccessCodes?: WorkflowInputs['installerSuccessCodes'];
+};
+
+const json = (value: unknown) => (value === undefined || value === null ? undefined : JSON.stringify(value));
+
+/** Workflow inputs for an update job. Supersede and carry over its groups whenever it replaces an IntuneGet app. */
+export function buildUpdateWorkflowInputs(job: PackagingJob, callbackUrl: string): WorkflowInputs {
+  const config = (job.package_config ?? {}) as PackageConfig;
+  const installerType = job.installer_type || 'exe';
+  const replacesApp = Boolean(config.sourceIntuneAppId);
+  const pilot = typeof config.pilotRolloutId === 'string';
+  const requirementRules = Array.isArray(config.requirementRules) ? config.requirementRules : [];
+  return {
+    sourceType: config.sourceType,
+    curatedReleaseId: config.curatedReleaseId,
+    jobId: job.id,
+    tenantId: job.tenant_id ?? '',
+    wingetId: job.winget_id,
+    displayName: job.display_name,
+    description: buildIntuneAppDescription({
+      description: config.description,
+      fallback: `Deployed via IntuneGet from Winget: ${job.winget_id}`,
+    }),
+    publisher: job.publisher || 'Unknown Publisher',
+    version: job.version,
+    architecture: job.architecture || 'x64',
+    installerUrl: job.installer_url || '',
+    installerSha256: job.installer_sha256 || '',
+    installerType,
+    nestedInstallerType: config.nestedInstallerType,
+    nestedInstallerPath: config.nestedInstallerPath,
+    installerSuccessCodes: config.installerSuccessCodes,
+    silentSwitches: extractSilentSwitches(job.install_command || '', installerType, config.nestedInstallerType),
+    uninstallCommand: job.uninstall_command || '',
+    callbackUrl,
+    detectionRules: json(job.detection_rules ?? undefined),
+    psadtConfig: json(config.psadtConfig),
+    // HRM patch 0024: an update that replaces an app sends no group list, so the workflow copies that
+    // app's current groups from Intune instead of a stale snapshot (and then moves them off the old app).
+    assignments: (pilot || !replacesApp) && Array.isArray(config.assignments)
+      ? JSON.stringify(sanitizeAssignmentsForDispatch(config.assignments as never, requirementRules.length > 0))
+      : undefined,
+    categories: json(config.categories),
+    // HRM patch 0024: the new version joins the same Enrollment Status Page profiles
+    espProfiles: json((config as Record<string, unknown>).espProfiles),
+    requirementRules: requirementRules.length ? JSON.stringify(requirementRules) : undefined,
+    relationships: Array.isArray(config.relationships) && config.relationships.length ? JSON.stringify(config.relationships) : undefined,
+    installScope: job.install_scope === 'user' ? 'user' : 'machine',
+    forceCreate: config.forceCreate !== false,
+    sourceIntuneAppId: config.sourceIntuneAppId || undefined,
+    // HRM default (2026-10-28): updates replace the previous version and keep its groups.
+    carryOverAssignments: replacesApp && !pilot,
+    removeAssignmentsFromPreviousApp: replacesApp && !pilot,
+    autoSupersede: replacesApp,
+    // HRM patch 0037: going back to a previous version uses Replace, which uninstalls the current version first.
+    supersedenceType: replacesApp ? (config.hrmRollback ? 'replace' : 'update') : undefined,
+  };
+}
+
+/** HRM patch 0024: an update that never started is posted like a failed deployment, so it isn't missed. */
+async function alertNotStarted(db: DatabaseAdapter, jobId: string, stage: string): Promise<void> {
+  const job = await db.jobs.getById(jobId).catch(() => null);
+  if (!job) return;
+  const { notifyDeploymentWebhooks } = await import('@/lib/notifications/notify-deployment');
+  await notifyDeploymentWebhooks({ ...job, status: 'failed', error_stage: stage }).catch(() => null);
+}
+
+function callbackUrl(): string {
+  const base = getAppConfig().app.url || 'http://localhost:3000';
+  return `${base}/api/package/callback`;
+}
+
+/** Dispatch one queued update job. Never throws; the job records the outcome. */
+export async function dispatchUpdateJob(
+  db: DatabaseAdapter,
+  jobId: string,
+  options: { batch?: boolean } = {}
+): Promise<UpdateDispatchResult> {
+  if (getFeatureFlags().localPackager) {
+    return { dispatched: false, reason: 'local-packager', message: 'Queued for the local packager' };
+  }
+  if (!isGitHubActionsConfigured()) {
+    return { dispatched: false, reason: 'not-configured', message: 'GitHub packaging is not configured on this server' };
+  }
+  const job = await db.jobs.getById(jobId);
+  if (!job) return { dispatched: false, reason: 'missing-job', message: 'The update job no longer exists' };
+
+  const now = () => new Date().toISOString();
+  // Auto-update and manual update jobs carry their history row; a job that never starts closes it.
+  const historyId = ((job.package_config ?? {}) as PackageConfig).autoUpdateHistoryId as string | undefined;
+  const closeHistory = async (status: 'failed' | 'cancelled', message: string) => {
+    if (!historyId) return;
+    await db.autoUpdateHistory.update(historyId, { status, error_message: message, completed_at: now() }).catch(() => null);
+  };
+  try {
+    const result = await triggerPackagingWorkflow(buildUpdateWorkflowInputs(job, callbackUrl()), undefined, {
+      skipRunCapture: Boolean(options.batch),
+      requireQaPass: true,
+    });
+    await db.jobs.update(jobId, {
+      status: 'packaging',
+      status_message: 'Update packaging started',
+      packaging_started_at: now(),
+      ...(result.runId ? { github_run_id: result.runId.toString(), github_run_url: result.runUrl } : {}),
+    });
+    return { dispatched: true, runUrl: result.runUrl };
+  } catch (error) {
+    if (isQaGateError(error)) {
+      // Same as the hosted route: a test or security hold cancels the job with its reason.
+      const message = describeQaGateError(error);
+      await db.jobs.update(jobId, {
+        status: 'cancelled',
+        // HRM patch 0024: on this server a hold is the test's verdict, not a wait
+        status_message: "Held: the installation test didn't pass",
+        error_message: message,
+        cancelled_at: now(),
+        completed_at: now(),
+      });
+      await closeHistory('cancelled', message);
+      await alertNotStarted(db, jobId, 'installation test');
+      return { dispatched: false, reason: 'qa-hold', message };
+    }
+    const message = error instanceof Error ? error.message : 'Unknown error';
+    await db.jobs.update(jobId, {
+      status: 'failed',
+      ...dispatchFailureFields(error),
+      error_message: message,
+      completed_at: now(),
+    });
+    await closeHistory('failed', message);
+    await alertNotStarted(db, jobId, 'start');
+    return { dispatched: false, reason: 'error', message };
+  }
+}
diff --git a/lib/hrm/update-gate.ts b/lib/hrm/update-gate.ts
