@@ -0,0 +1,14 @@
+import { NextRequest, NextResponse } from 'next/server';
+import { parseAccessToken } from '@/lib/auth-utils';
+import { isSqliteMode } from '@/lib/db';
+import { readServerStatus } from '@/lib/hrm/home';
+import { nextVersionCheck } from '@/lib/hrm/version-check';
+export async function GET(request: NextRequest) {
+  if (!await parseAccessToken(request.headers.get('Authorization'))) return NextResponse.json({ error: 'Authentication required' }, { status: 401 });
+  const headers = { 'Cache-Control': 'private, no-store' };
+  if (!isSqliteMode()) return NextResponse.json({ supported: false }, { headers });
+  const status = await readServerStatus();
+  return NextResponse.json({ supported: true, lastAttemptAt: status.reported ? status.updateCheck?.at ?? null : null,
+    result: status.reported ? status.updateCheck?.result ?? null : null,
+    reported: status.reported, nextExpectedAt: nextVersionCheck() }, { headers });
+}
