+      await db.jobs.update(queued.id, { status: 'failed', error_code: 'PACKAGE_CREATION_FAILED', error_message: 'packaging failed', completed_at: new Date().toISOString() });
+      // The cooldown is about pace, not this rule.
+      const { closeSqliteDb } = await import('@/lib/db/sqlite');
+      closeSqliteDb();
+      const Database = (await import('better-sqlite3')).default;
+      const raw = new Database(process.env.DATABASE_PATH!);
