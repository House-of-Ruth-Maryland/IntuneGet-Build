--- /dev/null
+++ b/components/updates/CartUpdatePolicyPicker.test.ts
@@ -0,0 +1,62 @@
+// @vitest-environment happy-dom
+// HRM patch 0035: "Keep the same groups on each new version" only where it takes effect.
+import { afterEach, describe, expect, it, vi } from 'vitest';
+import { act, createElement } from 'react';
+import { createRoot, type Root } from 'react-dom/client';
+
+(globalThis as { IS_REACT_ACT_ENVIRONMENT?: boolean }).IS_REACT_ACT_ENVIRONMENT = true;
+
+let root: Root | null = null;
+let container: HTMLDivElement | null = null;
+
+afterEach(() => {
+  act(() => root?.unmount());
+  container?.remove();
+  root = null;
+  container = null;
+  vi.unstubAllGlobals();
+  vi.resetModules();
+});
+
+async function renderWithMode(databaseMode: string | null) {
+  vi.stubGlobal('fetch', vi.fn(async () => (databaseMode === null
+    ? Promise.reject(new Error('offline'))
+    : new Response(JSON.stringify({ databaseMode }), { status: 200 }))));
+  const { CartUpdatePolicyPicker } = await import('./CartUpdatePolicyPicker');
+  container = document.createElement('div');
+  document.body.appendChild(container);
+  root = createRoot(container);
+  await act(async () => {
+    root!.render(createElement(CartUpdatePolicyPicker, { value: 'auto_update', onChange: () => {}, carryOverAssignments: true, onCarryOverAssignmentsChange: () => {} }));
+  });
+  await act(async () => { await new Promise((r) => setTimeout(r, 0)); });
+  return container.textContent ?? '';
+}
+
+describe('CartUpdatePolicyPicker group choice', () => {
+  it('hides the choice on a SQLite server, where every update keeps its groups', async () => {
+    const text = await renderWithMode('sqlite');
+    expect(text).not.toContain('Keep the same groups on each new version');
+    expect(text).toContain('Each one replaces the previous version and keeps its groups.');
+  });
+
+  it('shows the choice on a Supabase server, where it takes effect', async () => {
+    const text = await renderWithMode('supabase');
+    expect(text).toContain('Keep the same groups on each new version');
+    expect(text).not.toContain('keeps its groups.');
+  });
+
+  // HRM patch 0036: the same policy names as App updates, and a true hint about where to change it.
+  it('uses the App updates policy names', async () => {
+    const text = await renderWithMode('sqlite');
+    for (const label of ['Notify only', 'Auto-update', 'Ignore']) expect(text).toContain(label);
+    expect(text).not.toContain('Tell me');
+    expect(text).not.toContain('Update automatically');
+    expect(text).not.toContain('at any time in App updates');
+    expect(text).toContain('Ignored apps');
+  });
+
+  it('hides the choice when the mode cannot be read', async () => {
+    expect(await renderWithMode(null)).not.toContain('Keep the same groups on each new version');
+  });
+});
