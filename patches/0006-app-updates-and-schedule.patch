@@ -0,0 +1,264 @@
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { mkdtempSync, rmSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+
+const mocks = vi.hoisted(() => ({
+  trigger: vi.fn(),
+  configured: vi.fn(() => true),
+  localPackager: { value: false },
+  installer: vi.fn(),
+  catalogApps: vi.fn(),
+  qaGate: { value: false },
+}));
+vi.mock('@/lib/github-actions', async (original) => ({
+  ...(await original<object>()),
+  triggerPackagingWorkflow: mocks.trigger,
+  isGitHubActionsConfigured: mocks.configured,
+}));
+vi.mock('@/lib/features', async (original) => {
+  const actual = await original<typeof import('@/lib/features')>();
+  return { ...actual, getFeatureFlags: () => ({ ...actual.getFeatureFlags(), localPackager: mocks.localPackager.value }) };
+});
+vi.mock('@/lib/auto-update/trigger', () => ({ getLatestInstallerInfo: mocks.installer }));
+vi.mock('@/lib/catalog', () => ({
+  getCatalogSource: () => ({ getAppsByWingetIds: mocks.catalogApps, getAppForInstaller: vi.fn() }),
+}));
+vi.mock('@/lib/qa/gate', async (original) => ({
+  ...(await original<object>()),
+  isQaGateError: () => mocks.qaGate.value,
+  describeQaGateError: () => 'Installer flagged by the installation test',
+}));
+vi.mock('@/lib/graph-token', () => ({ acquireGraphToken: vi.fn(() => { throw new Error('no Graph in tests'); }) }));
+
+let dir: string;
+const USER = { userId: 'user-1', tenantId: 'tenant-1', userEmail: 'admin.one@example.test' };
+
+beforeEach(() => {
+  vi.resetModules();
+  dir = mkdtempSync(join(tmpdir(), 'hrm-updates-'));
+  process.env.DATABASE_PATH = join(dir, 'app.db');
+  mocks.trigger.mockReset().mockResolvedValue({ runId: 42, runUrl: 'https://github.example.test/run/42' });
+  mocks.configured.mockReturnValue(true);
+  mocks.localPackager.value = false;
+  mocks.qaGate.value = false;
+  mocks.installer.mockReset().mockResolvedValue({
+    ok: true,
+    info: {
+      wingetId: 'Vendor.App', currentVersion: '', latestVersion: '1.1.0', displayName: 'Vendor App',
+      installerUrl: 'https://example.test/app-1.1.0.exe', installerSha256: 'AB'.repeat(32), installerType: 'exe',
+      installCommand: 'app.exe /S', uninstallCommand: 'app.exe /uninstall', installScope: 'machine',
+    },
+  });
+  mocks.catalogApps.mockReset().mockResolvedValue([{ winget_id: 'Vendor.App', latest_version: '1.1.0' }]);
+});
+afterEach(async () => {
+  (await import('@/lib/db/sqlite')).closeSqliteDb();
+  rmSync(dir, { recursive: true, force: true });
+  delete process.env.DATABASE_PATH;
+});
+
+const deploymentConfig = {
+  displayName: 'Vendor App', publisher: 'Vendor', architecture: 'x64', installerType: 'exe',
+  installCommand: 'app.exe /S', uninstallCommand: 'app.exe /uninstall', installScope: 'machine', detectionRules: [],
+  assignments: [{ type: 'group', groupId: 'group-1', intent: 'required' }],
+};
+
+async function load() {
+  const { sqliteDb: db } = await import('@/lib/db/sqlite');
+  return {
+    db,
+    dispatch: await import('../update-dispatch'),
+    manual: await import('../manual-update'),
+    check: await import('@/lib/auto-update/sqlite'),
+  };
+}
+
+/** A previous IntuneGet deployment of 1.0.0 plus a detected 1.1.0, as the update check leaves them. */
+async function seed(db: Awaited<ReturnType<typeof load>>['db'], wingetId = 'Vendor.App') {
+  const job = await db.jobs.create({
+    user_id: USER.userId, tenant_id: USER.tenantId, winget_id: wingetId, version: '1.0.0',
+    display_name: 'Vendor App', publisher: 'Vendor', architecture: 'x64', installer_type: 'exe',
+    installer_url: 'https://example.test/app-1.0.0.exe', install_command: 'app.exe /S', uninstall_command: 'app.exe /uninstall',
+    install_scope: 'machine', status: 'deployed', package_config: deploymentConfig as never,
+  });
+  await db.uploadHistory.create({
+    id: `history-${wingetId}`, user_id: USER.userId, winget_id: wingetId, version: '1.0.0', display_name: 'Vendor App',
+    intune_app_id: 'intune-app-1', intune_tenant_id: USER.tenantId, packaging_job_id: job.id,
+  });
+  await db.updateCheckResults.upsert({
+    user_id: USER.userId, tenant_id: USER.tenantId, winget_id: wingetId, intune_app_id: 'intune-app-1',
+    display_name: 'Vendor App', current_version: '1.0.0', latest_version: '1.1.0', is_critical: false, is_managed: true,
+  });
+}
+
+describe('update workflow inputs', () => {
+  it('supersede and carry over groups when the update replaces an IntuneGet app', async () => {
+    const { dispatch } = await load();
+    const job = { id: 'job-1', tenant_id: 'tenant-1', winget_id: 'Vendor.App', version: '1.1.0', display_name: 'Vendor App',
+      publisher: 'Vendor', architecture: 'x64', installer_type: 'exe', installer_url: 'https://example.test/a.exe',
+      installer_sha256: 'AB', install_command: 'app.exe /S', uninstall_command: 'app.exe /x', install_scope: 'machine',
+      detection_rules: [], package_config: { sourceIntuneAppId: 'intune-app-1', assignments: deploymentConfig.assignments } } as never;
+    const inputs = dispatch.buildUpdateWorkflowInputs(job, 'https://intune.example.test/api/package/callback');
+    expect(inputs).toMatchObject({
+      jobId: 'job-1', tenantId: 'tenant-1', version: '1.1.0', sourceIntuneAppId: 'intune-app-1',
+      autoSupersede: true, supersedenceType: 'update', carryOverAssignments: true, removeAssignmentsFromPreviousApp: true,
+      callbackUrl: 'https://intune.example.test/api/package/callback', installScope: 'machine',
+    });
+    // HRM patch 0024: no group list, so the workflow copies the replaced app's current groups
+    expect(inputs.assignments).toBeUndefined();
+    const fresh = dispatch.buildUpdateWorkflowInputs({ ...(job as object), package_config: {} } as never, 'x');
+    expect(fresh).toMatchObject({ autoSupersede: false, carryOverAssignments: false, supersedenceType: undefined });
+  });
+});
+
+describe('Update and Update All on SQLite', () => {
