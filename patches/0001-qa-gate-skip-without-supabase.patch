+describe('enforceQaGate without Supabase (HRM self-hosted SQLite)', () => {
+  const request = { wingetId: 'OpenJS.NodeJS', version: '26.7.0', architecture: 'x64', installerSha256, packageProfileSha256 };
+  beforeEach(() => {
+    supabaseConfiguredMock.mockReturnValue(false);
+    getQaResultMock.mockReset();
+    getPackageResultMock.mockReset();
+    getPackageCompatibilityBlockMock.mockReset();
+  });
+
+  it('never queries Supabase', async () => {
+    getQaResultMock.mockResolvedValue({ ...failedRow, outcome: 'Passed' });
+    await expect(enforceQaGate(request)).resolves.toBeUndefined();
+    expect(getPackageResultMock).not.toHaveBeenCalled();
+    expect(getPackageCompatibilityBlockMock).not.toHaveBeenCalled();
+  });
+
+  it('blocks a version the catalog snapshot marks malicious, even with an override', async () => {
+    getQaResultMock.mockResolvedValue({ ...failedRow, outcome: 'Passed', virustotal_malicious: 3 });
+    await expect(enforceQaGate(request)).rejects.toBeInstanceOf(QaSecurityGateError);
+    await expect(enforceQaGate({ ...request, qaOverride: true })).rejects.toBeInstanceOf(QaSecurityGateError);
+  });
+
+  it('blocks a version whose snapshot test failed unless overridden', async () => {
+    getQaResultMock.mockResolvedValue(failedRow);
+    await expect(enforceQaGate(request)).rejects.toBeInstanceOf(QaGateError);
+    await expect(enforceQaGate({ ...request, qaOverride: true })).resolves.toBeUndefined();
+    await expect(enforceQaGate({ ...request, qaOverride: true, requirePassed: true })).rejects.toBeInstanceOf(QaGateError);
+  });
+
+  it('allows versions the snapshot has no verdict for', async () => {
+    getQaResultMock.mockResolvedValue(null);
+    await expect(enforceQaGate(request)).resolves.toBeUndefined();
+    getQaResultMock.mockResolvedValue({ ...failedRow, tested_version: '26.6.0' });
+    await expect(enforceQaGate(request)).resolves.toBeUndefined();
+  });
+});
