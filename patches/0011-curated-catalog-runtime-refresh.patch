@@ -0,0 +1,43 @@
+/**
+ * HRM patch: a newer signed curated catalog from the data folder.
+ *
+ * The curated catalog is a signed list built into the image that expires
+ * 7 days after upstream signs it, so a self-hosted image stops serving it a
+ * week after its release. The VM downloads upstream's latest signed list
+ * daily (IntuneGet-Build deploy/intuneget-curated-refresh.sh) next to the
+ * database. This only reads that file; the caller still verifies its
+ * signature against the keys built into the image, and its expiry, and falls
+ * back to the built-in list when it doesn't verify.
+ */
+
+import { readFileSync, statSync } from 'fs';
+import path from 'path';
+
+const MAX_BYTES = 20 * 1024 * 1024;
+
+let cached: { file: string; mtimeMs: number; size: number; envelope: unknown } | null = null;
+
+export function refreshedCatalogPath(): string {
+  const dbPath = process.env.DATABASE_PATH || './data/intuneget.db';
+  return path.join(path.dirname(dbPath), 'curated-catalog.json');
+}
+
+/** The downloaded envelope, or null when there is none or it can't be read. */
+export function readRefreshedCatalog(): unknown | null {
+  const file = refreshedCatalogPath();
+  try {
+    const { mtimeMs, size } = statSync(file);
+    if (size > MAX_BYTES) return null;
+    if (cached && cached.file === file && cached.mtimeMs === mtimeMs && cached.size === size) return cached.envelope;
+    const envelope = JSON.parse(readFileSync(file, 'utf8'));
+    cached = { file, mtimeMs, size, envelope };
+    return envelope;
+  } catch {
+    return null;
+  }
+}
+
+/** Test hook. */
+export function resetRefreshedCatalogCache() {
+  cached = null;
+}
