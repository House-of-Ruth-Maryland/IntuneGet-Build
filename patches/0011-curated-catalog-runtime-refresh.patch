diff --git a/lib/hrm/__tests__/curated-refresh.test.ts b/lib/hrm/__tests__/curated-refresh.test.ts
new file mode 100644
index 000000000..b1ef75e9b
--- /dev/null
+++ b/lib/hrm/__tests__/curated-refresh.test.ts
@@ -0,0 +1,92 @@
+import { mkdtempSync, rmSync, writeFileSync } from 'fs';
+import { tmpdir } from 'os';
+import path from 'path';
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { releaseFixture, signedFixture } from '@/lib/curated-catalog/test-fixtures';
+import { resetRefreshedCatalogCache } from '../curated-refresh';
+
+const state = vi.hoisted(() => ({ envelope: {} as Record<string, unknown> }));
+vi.mock('@/catalog/curated/catalog.json', () => ({ default: state.envelope }));
+import { getCuratedCatalog } from '@/lib/curated-catalog/server';
+
+const DAY = 86_400_000;
+let dir: string;
+const setBuiltIn = (envelope: object) => {
+  Object.keys(state.envelope).forEach((key) => delete state.envelope[key]);
+  Object.assign(state.envelope, envelope);
+};
+const download = (content: string) => {
+  writeFileSync(path.join(dir, 'curated-catalog.json'), content);
+  resetRefreshedCatalogCache();
+};
+
+// signedFixture always uses keyId 'unit-test'; rename so two fixtures can both be trusted.
+const withKeyId = (fixture: ReturnType<typeof signedFixture>, keyId: string) => ({
+  envelope: { ...fixture.envelope, keyId },
+  keys: { [keyId]: fixture.keys['unit-test'] },
+});
+
+beforeEach(() => {
+  dir = mkdtempSync(path.join(tmpdir(), 'curated-refresh-'));
+  vi.stubEnv('DATABASE_PATH', path.join(dir, 'intuneget.db'));
+  resetRefreshedCatalogCache();
+  vi.useFakeTimers({ now: new Date('2026-10-20T12:00:00Z'), toFake: ['Date'] });
+});
+afterEach(() => {
+  vi.useRealTimers();
+  vi.unstubAllEnvs();
+  rmSync(dir, { recursive: true, force: true });
+});
+
+describe('curated catalog refreshed by the VM', () => {
+  it('serves the downloaded list once the built-in one has expired', () => {
+    const builtIn = withKeyId(signedFixture(), 'built-in');
+    vi.setSystemTime(new Date('2026-10-22T12:00:00Z'));
+    const fresh = withKeyId(signedFixture([releaseFixture(undefined, '121.0.0.0')]), 'fresh');
+    setBuiltIn(builtIn.envelope);
+    vi.stubEnv('CURATED_CATALOG_PUBLIC_KEYS', JSON.stringify({ ...builtIn.keys, ...fresh.keys }));
+    expect(() => getCuratedCatalog()).toThrow();
+    download(JSON.stringify(fresh.envelope));
+    const { payload, entries } = getCuratedCatalog();
+    expect(payload.generatedAt).toBe(fresh.envelope.payload.generatedAt);
+    expect(entries.find((entry) => entry.release)?.release?.candidate.version).toBe('121.0.0.0');
+  });
+
+  it('ignores a downloaded list that is tampered with, signed by an unknown key, or unreadable', () => {
+    const builtIn = withKeyId(signedFixture(), 'built-in');
+    setBuiltIn(builtIn.envelope);
+    vi.setSystemTime(new Date('2026-10-20T13:00:00Z'));
+    const fresh = withKeyId(signedFixture([releaseFixture(undefined, '121.0.0.0')]), 'fresh');
+    vi.stubEnv('CURATED_CATALOG_PUBLIC_KEYS', JSON.stringify({ ...builtIn.keys, ...fresh.keys }));
+
+    const tampered = structuredClone(fresh.envelope) as typeof fresh.envelope;
+    tampered.payload.releases[0].candidate.version = '999.0.0.0';
+    download(JSON.stringify(tampered));
+    expect(getCuratedCatalog().payload.generatedAt).toBe(builtIn.envelope.payload.generatedAt);
+
+    download(JSON.stringify({ ...fresh.envelope, keyId: 'someone-else' }));
+    expect(getCuratedCatalog().payload.generatedAt).toBe(builtIn.envelope.payload.generatedAt);
+
+    download('{not json');
+    expect(getCuratedCatalog().payload.generatedAt).toBe(builtIn.envelope.payload.generatedAt);
+  });
+
+  it('keeps the built-in list when it is newer than the download', () => {
+    const older = withKeyId(signedFixture(), 'older');
+    vi.setSystemTime(new Date('2026-10-20T15:00:00Z'));
+    const builtIn = withKeyId(signedFixture(), 'built-in');
+    setBuiltIn(builtIn.envelope);
+    vi.stubEnv('CURATED_CATALOG_PUBLIC_KEYS', JSON.stringify({ ...builtIn.keys, ...older.keys }));
+    download(JSON.stringify(older.envelope));
+    expect(getCuratedCatalog().payload.generatedAt).toBe(builtIn.envelope.payload.generatedAt);
+  });
+
+  it('behaves as before when nothing was downloaded', () => {
+    const builtIn = withKeyId(signedFixture(), 'built-in');
+    setBuiltIn(builtIn.envelope);
+    vi.stubEnv('CURATED_CATALOG_PUBLIC_KEYS', JSON.stringify(builtIn.keys));
+    expect(getCuratedCatalog().payload.generatedAt).toBe(builtIn.envelope.payload.generatedAt);
+    vi.setSystemTime(new Date(Date.now() + 2 * DAY));
+    expect(() => getCuratedCatalog()).toThrow(/expired/);
+  });
+});
