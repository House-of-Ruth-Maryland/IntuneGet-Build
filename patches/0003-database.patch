+import {describe,it,expect,vi} from 'vitest';
+vi.stubEnv('DATABASE_PATH', ':memory:');
+import {sqliteDb} from '../sqlite';
+describe('real SQLite deployment visibility',()=>{
+ it('shares tenant jobs across owners, excludes foreign and archived jobs and caps at 50',async()=>{
+  for(let i=0;i<55;i++) await sqliteDb.jobs.create({id:`shared-${i}`,user_id:i%2?'owner':'colleague',tenant_id:'shared',winget_id:'Example.App',version:'1',display_name:'Example',installer_type:'exe',installer_url:'https://example.invalid/app.exe',status:'deployed'});
+  await sqliteDb.jobs.create({id:'foreign',user_id:'foreign-owner',tenant_id:'foreign',winget_id:'Example.App',version:'1',display_name:'Foreign',installer_type:'exe',installer_url:'https://example.invalid/app.exe',status:'deployed'});
+  await sqliteDb.jobs.update('shared-0',{archived_at:new Date().toISOString()});
+  const all=await sqliteDb.jobs.getByTenantId('shared',100);
+  expect(all).toHaveLength(54);
+  expect(new Set(all.map(j=>j.user_id))).toEqual(new Set(['owner','colleague']));
+  expect(all.every(j=>j.tenant_id==='shared' && j.id!=='shared-0')).toBe(true);
+  expect(await sqliteDb.jobs.getByTenantId('shared',50)).toHaveLength(50);
+  for(const user of ['owner','colleague']) expect((await sqliteDb.jobs.getByUserId(user,50)).every(j=>j.user_id===user)).toBe(true);
+ });
+});
