diff --git a/supabase/migrations/20261121000000_discovery_dispatch_guard.sql b/supabase/migrations/20261121000000_discovery_dispatch_guard.sql
new file mode 100644
index 000000000..acd867fda
--- /dev/null
+++ b/supabase/migrations/20261121000000_discovery_dispatch_guard.sql
@@ -0,0 +1,23 @@
+-- Serialize ordinary catalog/discovery jobs across browsers and server processes.
+-- Existing duplicates are retained; forceCreate permits history, never an active job.
+CREATE OR REPLACE FUNCTION public.hrm_discovery_dispatch_guard() RETURNS trigger
+LANGUAGE plpgsql SET search_path = public AS $$
+BEGIN
+  IF NEW.package_config->'deploymentOrigin'->>'kind' IN ('catalog','discovery')
+     AND NEW.status::text NOT IN ('deployed','completed','failed','cancelled','duplicate_skipped','qa_failed') THEN
+    PERFORM pg_advisory_xact_lock(hashtextextended(NEW.tenant_id::text || ':' || lower(trim(NEW.winget_id)),0));
+    IF EXISTS (SELECT 1 FROM public.packaging_jobs j
+      WHERE j.tenant_id = NEW.tenant_id AND lower(trim(j.winget_id)) = lower(trim(NEW.winget_id))
+      AND COALESCE(j.app_source,'win32') != 'store'
+      AND COALESCE(j.package_config->>'appSource','win32') != 'store'
+      AND COALESCE(j.package_config->>'sourceType','winget') != 'custom'
+      AND j.package_config->>'hrmRemoval' IS NULL
+      AND (j.status::text NOT IN ('deployed','completed','failed','cancelled','duplicate_skipped','qa_failed')
+        OR ((j.status::text = 'deployed' OR (j.status::text IN ('failed','cancelled') AND (j.intune_app_id IS NOT NULL OR j.upload_started_at IS NOT NULL OR j.error_stage = 'upload' OR j.error_message LIKE 'Job timed out after %'))) AND COALESCE(NEW.package_config->>'forceCreate','false') != 'true')))
+    THEN RAISE EXCEPTION 'Review existing deployment: package already queued or previously deployed'; END IF;
+  END IF;
+  RETURN NEW;
+END $$;
+DROP TRIGGER IF EXISTS hrm_discovery_dispatch_guard ON public.packaging_jobs;
+CREATE TRIGGER hrm_discovery_dispatch_guard BEFORE INSERT ON public.packaging_jobs
+FOR EACH ROW EXECUTE FUNCTION public.hrm_discovery_dispatch_guard();
