+import { beforeEach, expect, it, vi } from 'vitest';
+const fixture = vi.hoisted(() => ({ requests: [] as {table: string; field: string; tenant: string; start: number}[], fail: false }));
+vi.mock('@/lib/supabase', () => ({ createServerClient: () => ({ from: (table: string) => {
+  let field = '', tenant = '', start = 0;
+  const query = { select: () => query, eq: (f: string, t: string) => { field = f; tenant = t; return query; }, order: () => query,
+    range: (offset: number) => { start = offset; return query; }, abortSignal: async () => {
+      fixture.requests.push({ table, field, tenant, start });
+      if (fixture.fail) return { error: new Error('offline'), data: null };
+      const data = table === 'packaging_jobs'
+        ? (start === 0 ? Array.from({ length: 500 }, (_, n) => ({ id: `job-${n}`, tenant_id: tenant, status: 'failed' })) : [{ id: 'older', tenant_id: tenant, status: 'deployed' }])
+        : [{ id: 'historical', intune_tenant_id: tenant, packaging_job_id: null, winget_id: 'Vendor.App', version: '1', intune_app_id: 'copy' }];
+      return { data, error: null };
+    } };
+  return query;
+} }) }));
+import { supabaseDb } from '../supabase-adapter';
+beforeEach(() => { fixture.requests.length = 0; fixture.fail = false; });
+it('reads the complete authorized tenant history across hosted page limits and preserves orphan evidence', async () => {
+  const rows = await supabaseDb.jobs.getDiscoveryJobs('customer');
+  expect(rows).toHaveLength(502);
+  expect(rows.at(-1)).toMatchObject({ historyOnly: true, tenant_id: 'customer', winget_id: 'Vendor.App', status: 'deployed' });
+  expect(fixture.requests).toEqual([
+    { table: 'packaging_jobs', field: 'tenant_id', tenant: 'customer', start: 0 },
+    { table: 'packaging_jobs', field: 'tenant_id', tenant: 'customer', start: 500 },
+    { table: 'upload_history', field: 'intune_tenant_id', tenant: 'customer', start: 0 },
+  ]);
+});
+it('does not substitute an empty deployment history for a hosted read failure', async () => {
+  fixture.fail = true;
+  await expect(supabaseDb.jobs.getDiscoveryJobs('customer')).rejects.toThrow('offline');
+});
