+++ b/lib/db/discovery-evidence.ts
@@ -0,0 +1,11 @@
+import type { DiscoveryJobEvidence, UploadHistoryRecord } from './types';
+
+/** Lost legacy job metadata cannot prove installation intent, so these copies remain unverified. */
+export function orphanDeploymentEvidence(history: UploadHistoryRecord[], jobs: DiscoveryJobEvidence[]): DiscoveryJobEvidence[] {
+  const ids = new Set(jobs.map(j => j.id));
+  return history.filter(h => !h.packaging_job_id || !ids.has(h.packaging_job_id)).map(h => ({
+    id: `history:${h.id}`, tenant_id: h.intune_tenant_id, winget_id: h.winget_id, version: h.version,
+    status: 'deployed', intune_app_id: h.intune_app_id, app_source: null, package_config: null,
+    upload_started_at: null, error_stage: null, error_message: null, historyOnly: true,
+  }));
+}
diff --git a/lib/db/hrm-upstream-upgrade.test.ts b/lib/db/hrm-upstream-upgrade.test.ts
new file mode 100644
index 000000000..c9c0cfab3
--- /dev/null
+++ b/lib/db/hrm-upstream-upgrade.test.ts
@@ -0,0 +1,23 @@
+import Database from 'better-sqlite3';
+import {expect,it} from 'vitest';
+import {MIGRATIONS,runSqliteMigrations} from './sqlite-migrations';
+function seed(db:Database.Database,version:number){for(const migration of MIGRATIONS.filter(row=>row.version<=version)){migration.up(db);db.pragma(`user_version=${migration.version}`)}}
+it.each([26,27])('preserves existing HRM version %i data while adding callback ownership',version=>{
+ const db=new Database(':memory:');try{
+  seed(db,version);
+  const config=JSON.stringify({assignments:[{type:'group',groupId:'fixture-group',intent:'available'}],psadtConfig:{allowDefer:true,deferDays:3}});
+  db.prepare('INSERT INTO app_update_policies(id,user_id,tenant_id,winget_id,policy_type,deployment_config,is_enabled) VALUES(?,?,?,?,?,?,?)').run('policy','fixture-user','fixture-tenant','Example.App','auto_update',config,1);
+  db.prepare('INSERT INTO packaging_jobs(id,user_id,winget_id,version,display_name,installer_type,installer_url,status,package_config) VALUES(?,?,?,?,?,?,?,?,?)').run('job','fixture-user','Example.App','1.0','Example app','exe','https://example.test/app.exe','deployed',config);
+  const before=db.prepare('SELECT * FROM app_update_policies').all();
+  runSqliteMigrations(db);runSqliteMigrations(db);
+  expect(db.pragma('user_version',{simple:true})).toBe(28);expect(db.prepare('SELECT * FROM app_update_policies').all()).toEqual(before);
+  expect(db.prepare('SELECT package_config,callback_run_id FROM packaging_jobs WHERE id=?').get('job')).toEqual({package_config:config,callback_run_id:null});
+  expect((db.pragma('table_info(hrm_installation_policies)') as {name:string}[]).some(row=>row.name==='restart_pilot_target')).toBe(true);
+ }finally{db.close()}
+});
+it('handles an existing plain upstream v0.8.6 version9 database without skipping HRM webhooks',()=>{
+ const db=new Database(':memory:');try{seed(db,8);db.exec('ALTER TABLE packaging_jobs ADD COLUMN callback_run_id TEXT');db.pragma('user_version=9');runSqliteMigrations(db);expect(db.prepare("SELECT name FROM sqlite_master WHERE name='webhook_configurations'").get()).toBeTruthy();expect(db.pragma('user_version',{simple:true})).toBe(28)}finally{db.close()}
+});
+it('creates the complete combined schema on a fresh installation',()=>{
