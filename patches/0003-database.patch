diff --git a/lib/db/__tests__/sqlite-deployed-version-sync.test.ts b/lib/db/__tests__/sqlite-deployed-version-sync.test.ts
new file mode 100644
index 000000000..9774b803c
--- /dev/null
+++ b/lib/db/__tests__/sqlite-deployed-version-sync.test.ts
@@ -0,0 +1,108 @@
+// HRM patch 0049: detected updates are corrected as soon as a new copy is deployed.
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { mkdtempSync, rmSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+
+let tempDir: string;
+
+beforeEach(() => {
+  vi.resetModules();
+  tempDir = mkdtempSync(join(tmpdir(), 'intuneget-sync-'));
+  process.env.DATABASE_PATH = join(tempDir, 'app.db');
+});
+
+afterEach(async () => {
+  const { closeSqliteDb } = await import('@/lib/db/sqlite');
+  closeSqliteDb();
+  rmSync(tempDir, { recursive: true, force: true });
+  delete process.env.DATABASE_PATH;
+});
+
+async function seed() {
+  const { sqliteDb } = await import('@/lib/db/sqlite');
+  const row = await sqliteDb.updateCheckResults.upsert({
+    user_id: 'u1', tenant_id: 't1', winget_id: 'Vendor.App', intune_app_id: 'app-1',
+    display_name: 'Vendor App', current_version: '1.0.0', latest_version: '2.0.0', is_critical: true,
+    notified_at: '2026-01-01T00:00:00.000Z', dismissed_at: '2026-01-02T00:00:00.000Z',
+  });
+  await sqliteDb.updateCheckResults.upsert({
+    user_id: 'u1', tenant_id: 't2', winget_id: 'Vendor.App', intune_app_id: 'app-9',
+    display_name: 'Vendor App', current_version: '1.0.0', latest_version: '2.0.0',
+  });
+  return { db: sqliteDb, row };
+}
+
+const all = async (db: Awaited<ReturnType<typeof seed>>['db'], userId: string, tenantId: string) =>
+  db.updateCheckResults.list(userId, { tenantId, includeDismissed: true });
+
+describe('sqlite syncDeployedVersion', () => {
+  it('removes the row when the deployed version reaches the latest, in that tenant only', async () => {
+    const { db } = await seed();
+    const result = await db.updateCheckResults.syncDeployedVersion({
+      userId: 'u2', tenantId: 't1', wingetId: 'Vendor.App', intuneAppId: 'app-2', version: '2.0.0', displayName: 'Vendor App',
+    });
+    expect(result).toEqual({ removed: 1, updated: 0 });
+    expect(await all(db, 'u1', 't1')).toHaveLength(0);
+    expect(await all(db, 'u1', 't2')).toHaveLength(1);
+  });
+
+  it('moves the row to the new copy and keeps its id, dismissed and notified state', async () => {
+    const { db, row } = await seed();
+    await db.updateCheckResults.upsert({
+      user_id: 'u3', tenant_id: 't1', winget_id: 'Vendor.App', intune_app_id: 'app-0',
+      // A lower latest version, so the kept row never depends on which upsert ran in a later
+      // millisecond (ties are broken by updated_at; see the tie-break test below).
+      display_name: 'Vendor App', current_version: '0.9.0', latest_version: '1.8.0',
+    });
+    const result = await db.updateCheckResults.syncDeployedVersion({
+      userId: 'u2', tenantId: 't1', wingetId: 'Vendor.App', intuneAppId: 'app-2', version: '1.5.0', displayName: 'Vendor App',
+    });
+    expect(result.updated).toBe(1);
+    expect(await all(db, 'u1', 't1')).toHaveLength(0);
+    expect(await all(db, 'u3', 't1')).toHaveLength(0);
+    const [moved] = await all(db, 'u2', 't1');
+    expect(moved).toMatchObject({
+      id: row.id, intune_app_id: 'app-2', current_version: '1.5.0', latest_version: '2.0.0', is_critical: true,
+      notified_at: '2026-01-01T00:00:00.000Z', dismissed_at: '2026-01-02T00:00:00.000Z',
+    });
+  });
+
+  it('keeps the most recently written row when two rows offer the same version', async () => {
+    vi.useFakeTimers({ toFake: ['Date'] });
+    try {
+      vi.setSystemTime(new Date('2026-03-01T00:00:00.000Z'));
+      const { db } = await seed();
+      vi.setSystemTime(new Date('2026-03-01T00:00:01.000Z'));
+      const later = await db.updateCheckResults.upsert({
+        user_id: 'u3', tenant_id: 't1', winget_id: 'Vendor.App', intune_app_id: 'app-0',
+        display_name: 'Vendor App', current_version: '0.9.0', latest_version: '2.0.0',
+      });
+      vi.setSystemTime(new Date('2026-03-01T00:00:02.000Z'));
+      await db.updateCheckResults.syncDeployedVersion({
+        userId: 'u2', tenantId: 't1', wingetId: 'Vendor.App', intuneAppId: 'app-2', version: '1.5.0', displayName: 'Vendor App',
+      });
+      const [moved] = await all(db, 'u2', 't1');
+      expect(moved).toMatchObject({ id: later.id, notified_at: null, dismissed_at: null });
+    } finally {
+      vi.useRealTimers();
+    }
+  });
+
+  it('does nothing when the app has no detected update', async () => {
+    const { sqliteDb } = await import('@/lib/db/sqlite');
+    const result = await sqliteDb.updateCheckResults.syncDeployedVersion({
+      userId: 'u1', tenantId: 't1', wingetId: 'Vendor.Other', intuneAppId: 'app-5', version: '1.0.0', displayName: 'Other',
+    });
+    expect(result).toEqual({ removed: 0, updated: 0 });
+  });
+
+  it('finds the newest deployment in a tenant whoever made it', async () => {
+    const { sqliteDb } = await import('@/lib/db/sqlite');
+    await sqliteDb.uploadHistory.create({ user_id: 'u1', intune_tenant_id: 't1', winget_id: 'Vendor.App', version: '1.0.0', display_name: 'Vendor App', intune_app_id: 'a', deployed_at: '2026-01-01T00:00:00.000Z' });
+    await sqliteDb.uploadHistory.create({ user_id: 'u2', intune_tenant_id: 't1', winget_id: 'Vendor.App', version: '1.1.0', display_name: 'Vendor App', intune_app_id: 'b', deployed_at: '2026-01-03T00:00:00.000Z' });
+    await sqliteDb.uploadHistory.create({ user_id: 'u2', intune_tenant_id: 't2', winget_id: 'Vendor.App', version: '9.0.0', display_name: 'Vendor App', intune_app_id: 'c', deployed_at: '2026-01-04T00:00:00.000Z' });
+    expect((await sqliteDb.uploadHistory.getLatestInTenant('t1', 'Vendor.App'))?.intune_app_id).toBe('b');
+    expect(await sqliteDb.uploadHistory.getLatestInTenant('t1', 'Vendor.None')).toBeNull();
+  });
+});
diff --git a/lib/db/__tests__/sqlite-version-sync-events.test.ts b/lib/db/__tests__/sqlite-version-sync-events.test.ts
new file mode 100644
index 000000000..49d6d17d9
--- /dev/null
+++ b/lib/db/__tests__/sqlite-version-sync-events.test.ts
@@ -0,0 +1,50 @@
+// HRM patch 0057: recent version sync results are kept in SQLite, old ones removed on write.
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { mkdtempSync, rmSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import Database from 'better-sqlite3';
+import { VERSION_SYNC_KEEP } from '@/lib/hrm/version-sync-health';
+
+let tempDir: string;
+
+beforeEach(() => {
+  vi.resetModules();
+  tempDir = mkdtempSync(join(tmpdir(), 'intuneget-sync-events-'));
+  process.env.DATABASE_PATH = join(tempDir, 'app.db');
+});
+
+afterEach(async () => {
+  const { closeSqliteDb } = await import('@/lib/db/sqlite');
+  closeSqliteDb();
+  rmSync(tempDir, { recursive: true, force: true });
+  delete process.env.DATABASE_PATH;
+});
+
+describe('sqlite versionSyncEvents', () => {
+  it('records results and lists them newest first', async () => {
+    const { sqliteDb } = await import('@/lib/db/sqlite');
+    const base = Date.now();
+    await sqliteDb.versionSyncEvents.record({ at: new Date(base - 60_000).toISOString(), appId: 'Vendor.App', result: 'failed', code: 'database_busy' });
+    await sqliteDb.versionSyncEvents.record({ at: new Date(base).toISOString(), appId: 'Vendor.Other', result: 'ok', code: null });
+    expect(await sqliteDb.versionSyncEvents.listRecent()).toEqual([
+      { at: new Date(base).toISOString(), appId: 'Vendor.Other', result: 'ok', code: null },
+      { at: new Date(base - 60_000).toISOString(), appId: 'Vendor.App', result: 'failed', code: 'database_busy' },
+    ]);
+  });
+
+  it('keeps only recent entries', async () => {
+    const { sqliteDb } = await import('@/lib/db/sqlite');
+    const base = Date.now();
+    await sqliteDb.versionSyncEvents.record({ at: new Date(base - 8 * 86_400_000).toISOString(), appId: 'Vendor.Old', result: 'failed', code: 'unknown' });
+    for (let i = 0; i < VERSION_SYNC_KEEP + 5; i++) {
+      await sqliteDb.versionSyncEvents.record({ at: new Date(base - (VERSION_SYNC_KEEP + 5 - i) * 1000).toISOString(), appId: 'Vendor.App', result: 'ok', code: null });
+    }
+    const events = await sqliteDb.versionSyncEvents.listRecent();
+    expect(events).toHaveLength(VERSION_SYNC_KEEP);
+    expect(events.some((event) => event.appId === 'Vendor.Old')).toBe(false);
+    const raw = new Database(process.env.DATABASE_PATH!, { readonly: true });
+    expect((raw.prepare('SELECT COUNT(*) AS n FROM hrm_version_sync_events').get() as { n: number }).n).toBe(VERSION_SYNC_KEEP);
+    raw.close();
+  });
+});
