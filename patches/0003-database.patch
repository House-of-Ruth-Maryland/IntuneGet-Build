+import { readFileSync } from 'node:fs';
+import { PGlite } from '@electric-sql/pglite';
+import { expect, it } from 'vitest';
+
+it('enforces the hosted guard for existing history, active jobs, tenant scope and explicit second copies', async () => {
+  const db = new PGlite();
+  try {
+    await db.exec(`CREATE TABLE packaging_jobs (id text PRIMARY KEY, tenant_id text, winget_id text,
+      status text, intune_app_id text, upload_started_at timestamptz, error_stage text, error_message text, app_source text DEFAULT 'win32', package_config jsonb DEFAULT '{}');`);
+    await db.exec(readFileSync(new URL('../../supabase/migrations/20261121000000_discovery_dispatch_guard.sql', import.meta.url), 'utf8'));
+    const insert = (id: string, tenant: string, status: string, conf: object) => db.query(
+      'INSERT INTO packaging_jobs(id,tenant_id,winget_id,status,package_config) VALUES ($1,$2,$3,$4,$5)',
+      [id, tenant, 'Vendor.App', status, JSON.stringify(conf)]);
+    const origin = { deploymentOrigin: { kind: 'catalog', tenantId: 'tenant', packageId: 'Vendor.App' } };
+    await insert('old', 'tenant', 'deployed', {});
+    await expect(insert('blocked-history', 'tenant', 'queued', origin)).rejects.toThrow(/previously deployed/);
+    await insert('another-tenant', 'other', 'queued', origin);
+    await insert('explicit', 'tenant', 'queued', { ...origin, forceCreate: true });
+    await expect(insert('blocked-active', 'tenant', 'queued', { ...origin, forceCreate: true })).rejects.toThrow(/already queued/);
+    await db.exec("UPDATE packaging_jobs SET status='cancelled' WHERE id='explicit'");
+    await insert('retry-after-cancel', 'tenant', 'queued', { ...origin, forceCreate: true });
+    await insert('removal', 'tenant', 'queued', { deploymentOrigin: { kind: 'removal' }, hrmRemoval: {} });
+  } finally { await db.close(); }
+}, 30_000);
