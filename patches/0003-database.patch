@@ -0,0 +1,53 @@
+import { afterEach, describe, expect, it, vi } from 'vitest';
+const { fetchMock } = vi.hoisted(() => ({ fetchMock: vi.fn() }));
+vi.mock('@/lib/supabase', async () => {
+  const { createClient } = await import('@supabase/supabase-js');
+  return { createServerClient: () => createClient('https://database.example.test', 'fixture-key', {
+    auth: { persistSession: false, autoRefreshToken: false }, global: { fetch: fetchMock },
+  }) };
+});
+import { supabaseDb as db } from '@/lib/db/supabase-adapter';
+afterEach(() => vi.clearAllMocks());
+
+describe('Supabase tenant update queries', () => {
+  it('uses the same tenant filter for two authors and a distinct filter for another tenant', async () => {
+    fetchMock.mockImplementation(async () => Response.json([]));
+    for (const user of ['participant-01', 'participant-02']) {
+      await db.updateCheckResults.list(user, { tenantId: 'tenant-one' });
+      await db.updatePolicies.list(user, 'tenant-one');
+    }
+    await db.updateCheckResults.list('participant-03', { tenantId: 'tenant-two' });
+    const urls = fetchMock.mock.calls.map(call => new URL(String(call[0])));
+    for (const url of urls.slice(0, 4)) {
+      expect(url.searchParams.get('tenant_id')).toBe('eq.tenant-one');
+      expect(url.searchParams.has('user_id')).toBe(false);
+    }
+    expect(urls[0].toString()).toBe(urls[2].toString());
+    expect(urls[1].toString()).toBe(urls[3].toString());
+    expect(urls[4].searchParams.get('tenant_id')).toBe('eq.tenant-two');
+  });
+
+  it('resolves legacy duplicates before dismissal/critical filtering, and uses the newest policy', async () => {
+    const base = { tenant_id: 'tenant-one', winget_id: 'Example.App', intune_app_id: 'fixture-app', id: 'older', updated_at: '2026-01-01', dismissed_at: null, is_critical: true };
+    fetchMock.mockResolvedValueOnce(Response.json([base, { ...base, id: 'newer', updated_at: '2026-02-01', dismissed_at: '2026-02-01', is_critical: false }]));
+    expect(await db.updateCheckResults.list('participant-02', { tenantId: 'tenant-one', criticalOnly: true })).toEqual([]);
+    const url = new URL(String(fetchMock.mock.calls[0][0]));
+    expect(url.searchParams.has('dismissed_at')).toBe(false);
+    expect(url.searchParams.has('is_critical')).toBe(false);
+    fetchMock.mockResolvedValueOnce(Response.json([{ ...base, policy_type: 'notify' }, { ...base, id: 'newer', updated_at: '2026-02-01', policy_type: 'ignore' }]));
+    expect(await db.updatePolicies.list('participant-02', 'tenant-one')).toMatchObject([{ policy_type: 'ignore' }]);
+  });
+
+  it('scopes policy IDs and dismissals to the authenticated tenant', async () => {
+    fetchMock.mockImplementation(async () => Response.json(null));
+    await db.updatePolicies.getById('policy-id', 'participant-02', 'tenant-one');
+    await db.updatePolicies.update('policy-id', 'participant-02', { policy_type: 'ignore' }, 'tenant-one');
+    await db.updatePolicies.delete('policy-id', 'participant-02', 'tenant-one');
+    await db.updateCheckResults.setDismissed(['check-id'], 'participant-02', '2026-01-01', 'tenant-one');
+    for (const call of fetchMock.mock.calls) {
+      const url = new URL(String(call[0]));
+      expect(url.searchParams.get('tenant_id')).toBe('eq.tenant-one');
+      expect(url.searchParams.has('user_id')).toBe(false);
+    }
+  });
+});
diff --git a/lib/db/tenant-updates.ts b/lib/db/tenant-updates.ts
new file mode 100644
index 000000000..13e0203a0
--- /dev/null
+++ b/lib/db/tenant-updates.ts
@@ -0,0 +1,11 @@
+/** Shared tenant views of legacy, author-attributed update records. */
+export function newestTenantRows<T extends { tenant_id: string; winget_id: string; id: string; updated_at: string }>(rows: T[], copy = false): T[] {
+  const newest = new Map<string, T>();
+  for (const row of rows) {
+    const app = row as T & { intune_app_id?: string };
+    const key = JSON.stringify([row.tenant_id, row.winget_id.toLowerCase(), ...(copy ? [app.intune_app_id?.toLowerCase()] : [])]);
+    const seen = newest.get(key);
+    if (!seen || row.updated_at > seen.updated_at || (row.updated_at === seen.updated_at && row.id > seen.id)) newest.set(key, row);
+  }
+  return [...newest.values()].sort((a, b) => (b.updated_at ?? '').localeCompare(a.updated_at ?? '') || (b.id ?? '').localeCompare(a.id ?? ''));
+}
