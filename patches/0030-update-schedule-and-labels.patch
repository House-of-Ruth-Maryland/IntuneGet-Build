diff --git a/app/api/cron/start-scheduled-updates/route.ts b/app/api/cron/start-scheduled-updates/route.ts
new file mode 100644
index 000000000..67afb9d16
--- /dev/null
+++ b/app/api/cron/start-scheduled-updates/route.ts
@@ -0,0 +1,24 @@
+/**
+ * HRM patch 0030: hourly. Starts automatic updates that were held for a tenant's update schedule,
+ * once the schedule is open and no blackout applies. Tenants without a schedule are untouched.
+ */
+import { NextResponse } from 'next/server';
+import { getDatabase, isSqliteMode } from '@/lib/db';
+import { runSqliteScheduledUpdates } from '@/lib/auto-update/sqlite';
+import { listWin32AppIds } from '@/lib/hrm/intune-app-ids';
+
+export const maxDuration = 300;
+
+export async function GET(request: Request) {
+  const cronSecret = process.env.CRON_SECRET;
+  if (!cronSecret || request.headers.get('authorization') !== `Bearer ${cronSecret}`) {
+    return NextResponse.json({ error: 'Unauthorized' }, { status: 401 });
+  }
+  if (!isSqliteMode()) return NextResponse.json({ success: true, skipped: 'Update schedules need SQLite mode' });
+  try {
+    const summary = await runSqliteScheduledUpdates(getDatabase(), { existingAppIds: listWin32AppIds });
+    return NextResponse.json({ success: true, ...summary });
+  } catch (error) {
+    return NextResponse.json({ error: error instanceof Error ? error.message : 'Scheduled update run failed' }, { status: 500 });
+  }
+}
