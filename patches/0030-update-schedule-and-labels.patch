diff --git a/lib/hrm/update-gate.ts b/lib/hrm/update-gate.ts
new file mode 100644
index 000000000..0fa3a8215
--- /dev/null
+++ b/lib/hrm/update-gate.ts
@@ -0,0 +1,8 @@
+import { DEFAULT_SCHEDULE, updateWindowState, type UpdateWindowState } from './update-window';
+
+/** HRM patch 0030: the tenant's update window right now. Always open outside SQLite mode. */
+export async function updateWindowFor(tenant: string, now = new Date()): Promise<UpdateWindowState> {
+  if (process.env.DATABASE_MODE?.toLowerCase() !== 'sqlite') return updateWindowState(DEFAULT_SCHEDULE, [], now);
+  const { sqliteUpdateSchedule } = await import('@/lib/db/sqlite');
+  return updateWindowState(sqliteUpdateSchedule.get(tenant), sqliteUpdateSchedule.blackouts(tenant, now), now);
+}
diff --git a/lib/hrm/update-schedule-store.ts b/lib/hrm/update-schedule-store.ts
new file mode 100644
index 000000000..6951d9126
--- /dev/null
+++ b/lib/hrm/update-schedule-store.ts
@@ -0,0 +1,45 @@
+import type Database from 'better-sqlite3';
+import { DEFAULT_SCHEDULE, marylandTime, type UpdateBlackout, type UpdateSchedule } from './update-window';
+
+/** HRM patch 0030: one update schedule per tenant, plus its blackout dates. */
+export function createUpdateScheduleStore(getDb: () => Database.Database) {
+  return {
+    get(tenant: string): UpdateSchedule {
+      const row = getDb().prepare('SELECT enabled, days, start_hour, end_hour FROM hrm_update_schedule WHERE tenant_id = ?').get(tenant) as
+        { enabled: number; days: string; start_hour: number; end_hour: number } | undefined;
+      if (!row) return { ...DEFAULT_SCHEDULE };
+      let days: number[] = DEFAULT_SCHEDULE.days;
+      try { days = JSON.parse(row.days); } catch { /* keep every day */ }
+      return { enabled: row.enabled === 1, days, startHour: row.start_hour, endHour: row.end_hour };
+    },
+    save(tenant: string, s: UpdateSchedule) {
+      getDb().prepare(`INSERT INTO hrm_update_schedule (tenant_id, enabled, days, start_hour, end_hour, updated_at) VALUES (?,?,?,?,?,?)
+        ON CONFLICT(tenant_id) DO UPDATE SET enabled = excluded.enabled, days = excluded.days, start_hour = excluded.start_hour,
+        end_hour = excluded.end_hour, updated_at = excluded.updated_at`)
+        .run(tenant, s.enabled ? 1 : 0, JSON.stringify([...s.days].sort()), s.startHour, s.endHour, new Date().toISOString());
+    },
+    /** Current and future blackouts, soonest first. Past ones are not shown and are removed after 30 days. */
+    blackouts(tenant: string, now = new Date()): UpdateBlackout[] {
+      const db = getDb();
+      const today = marylandTime(now).date;
+      const cutoff = marylandTime(new Date(now.getTime() - 30 * 24 * 60 * 60 * 1000)).date;
+      db.prepare('DELETE FROM hrm_update_blackouts WHERE tenant_id = ? AND ends_on < ?').run(tenant, cutoff);
+      return db.prepare('SELECT id, starts_on AS startsOn, ends_on AS endsOn, label FROM hrm_update_blackouts WHERE tenant_id = ? AND ends_on >= ? ORDER BY starts_on, ends_on LIMIT 50')
+        .all(tenant, today) as UpdateBlackout[];
+    },
+    addBlackout(tenant: string, b: Omit<UpdateBlackout, 'id'>): UpdateBlackout {
+      const db = getDb();
+      const id = crypto.randomUUID();
+      db.transaction(() => {
+        const count = (db.prepare('SELECT COUNT(*) AS n FROM hrm_update_blackouts WHERE tenant_id = ?').get(tenant) as { n: number }).n;
+        if (count >= 50) throw new Error('Remove an old blackout before adding another (limit 50).');
+        db.prepare('INSERT INTO hrm_update_blackouts (id, tenant_id, starts_on, ends_on, label, created_at) VALUES (?,?,?,?,?,?)')
+          .run(id, tenant, b.startsOn, b.endsOn, b.label.trim(), new Date().toISOString());
+      }).immediate();
+      return { id, startsOn: b.startsOn, endsOn: b.endsOn, label: b.label.trim() };
+    },
+    removeBlackout(tenant: string, id: string) {
+      return getDb().prepare('DELETE FROM hrm_update_blackouts WHERE tenant_id = ? AND id = ?').run(tenant, id).changes === 1;
+    },
+  };
+}
diff --git a/lib/hrm/update-window.ts b/lib/hrm/update-window.ts
new file mode 100644
index 000000000..7e7ea63fa
--- /dev/null
+++ b/lib/hrm/update-window.ts
@@ -0,0 +1,116 @@
+/**
+ * HRM patch 0030: when automatic updates and pilot rollouts may start.
+ *
+ * Times are Maryland time (America/New_York). A schedule allows some weekdays and a window of hours
+ * (start inclusive, end exclusive; an end before the start runs past midnight and belongs to the day
+ * it started). Blackouts are whole Maryland dates, inclusive, and always win over the schedule.
+ */
+export const UPDATE_TIME_ZONE = 'America/New_York';
+export const DAY_NAMES = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'] as const;
+export const BLACKOUT_LABEL_MAX = 60;
+
+export interface UpdateSchedule {
+  enabled: boolean;
+  days: number[];
+  startHour: number;
+  endHour: number;
+}
+
+export interface UpdateBlackout {
+  id: string;
+  startsOn: string;
+  endsOn: string;
+  label: string;
+}
+
+export interface UpdateWindowState {
+  open: boolean;
+  /** Plain sentence for staff; null when open. */
+  reason: string | null;
+  blackout: UpdateBlackout | null;
+  /** Next time updates may start (ISO), or null when open now or nothing opens within 62 days. */
+  nextOpen: string | null;
+}
+
+export const DEFAULT_SCHEDULE: UpdateSchedule = { enabled: false, days: [0, 1, 2, 3, 4, 5, 6], startHour: 0, endHour: 24 };
+
+const DATE = /^\d{4}-\d{2}-\d{2}$/;
+const HOUR = 60 * 60 * 1000;
+const parts = new Intl.DateTimeFormat('en-US', {
+  timeZone: UPDATE_TIME_ZONE, year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', hourCycle: 'h23', weekday: 'short',
+});
+const WEEKDAYS: Record<string, number> = { Sun: 0, Mon: 1, Tue: 2, Wed: 3, Thu: 4, Fri: 5, Sat: 6 };
+
+export function marylandTime(at: Date): { date: string; weekday: number; hour: number } {
+  const p = Object.fromEntries(parts.formatToParts(at).map((x) => [x.type, x.value]));
+  return { date: `${p.year}-${p.month}-${p.day}`, weekday: WEEKDAYS[p.weekday], hour: Number(p.hour) % 24 };
+}
+
+export function isValidDate(value: unknown): value is string {
+  if (typeof value !== 'string' || !DATE.test(value)) return false;
+  const d = new Date(`${value}T12:00:00Z`);
+  return !Number.isNaN(d.getTime()) && d.toISOString().slice(0, 10) === value;
+}
+
+/** Returns a staff-facing error, or null when the schedule can be saved. */
+export function scheduleError(s: unknown): string | null {
+  const v = s as Partial<UpdateSchedule> | null;
+  if (!v || typeof v.enabled !== 'boolean') return 'Invalid schedule.';
+  if (!Array.isArray(v.days) || v.days.some((d) => !Number.isInteger(d) || d < 0 || d > 6) || new Set(v.days).size !== v.days.length)
+    return 'Choose days from Sunday to Saturday.';
+  if (!Number.isInteger(v.startHour) || !Number.isInteger(v.endHour) || v.startHour! < 0 || v.startHour! > 23 || v.endHour! < 1 || v.endHour! > 24)
+    return 'Choose a start and end hour.';
+  if (v.startHour === v.endHour) return 'The start and end hour must be different.';
+  if (v.enabled && v.days.length === 0) return 'Choose at least 1 day, or turn the schedule off.';
+  return null;
+}
+
+export function blackoutError(b: unknown): string | null {
+  const v = b as Partial<UpdateBlackout> | null;
+  if (!v || !isValidDate(v.startsOn) || !isValidDate(v.endsOn)) return 'Choose a start and end date.';
+  if (v.endsOn < v.startsOn) return 'The end date must be on or after the start date.';
+  if (typeof v.label !== 'string' || !v.label.trim() || v.label.trim().length > BLACKOUT_LABEL_MAX)
+    return `Give the blackout a short name (up to ${BLACKOUT_LABEL_MAX} characters).`;
+  const start = Date.parse(`${v.startsOn}T00:00:00Z`), end = Date.parse(`${v.endsOn}T00:00:00Z`);
+  if (end - start > 92 * 24 * HOUR) return 'A blackout can last up to 93 days.';
+  return null;
+}
+
+function scheduleAllows(s: UpdateSchedule, at: Date): boolean {
+  if (!s.enabled) return true;
+  const { weekday, hour } = marylandTime(at);
+  const days = new Set(s.days);
+  if (s.startHour < s.endHour) return days.has(weekday) && hour >= s.startHour && hour < s.endHour;
+  // Overnight window: the late part belongs to today, the early part to the day before.
+  if (hour >= s.startHour) return days.has(weekday);
+  if (hour < s.endHour) return days.has((weekday + 6) % 7);
+  return false;
+}
+
+function blackoutAt(blackouts: UpdateBlackout[], at: Date): UpdateBlackout | null {
+  const { date } = marylandTime(at);
+  return blackouts.find((b) => b.startsOn <= date && date <= b.endsOn) ?? null;
+}
+
+export function formatMarylandTime(iso: string): string {
+  return new Intl.DateTimeFormat('en-US', {
+    timeZone: UPDATE_TIME_ZONE, weekday: 'long', month: 'long', day: 'numeric', hour: 'numeric', minute: '2-digit',
+  }).format(new Date(iso));
+}
+
+export function updateWindowState(schedule: UpdateSchedule, blackouts: UpdateBlackout[], now = new Date()): UpdateWindowState {
+  const blackout = blackoutAt(blackouts, now);
+  if (!blackout && scheduleAllows(schedule, now)) return { open: true, reason: null, blackout: null, nextOpen: null };
+  // Hour by hour is exact for whole-hour windows and handles daylight saving changes.
+  const hourStart = new Date(Math.floor(now.getTime() / HOUR) * HOUR);
+  let nextOpen: string | null = null;
+  for (let i = 1; i <= 62 * 24; i += 1) {
+    const at = new Date(hourStart.getTime() + i * HOUR);
+    if (!blackoutAt(blackouts, at) && scheduleAllows(schedule, at)) { nextOpen = at.toISOString(); break; }
+  }
+  const until = nextOpen ? ` until ${formatMarylandTime(nextOpen)} Maryland time` : '';
+  const reason = blackout
+    ? `Updates are paused for the blackout "${blackout.label}"${until}.`
+    : `Updates are outside the update schedule${until}.`;
+  return { open: false, reason, blackout, nextOpen };
+}
