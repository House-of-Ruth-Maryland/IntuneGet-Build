+++ b/lib/hrm/__tests__/update-schedule-store.test.ts
@@ -0,0 +1,33 @@
+import { afterEach, beforeEach, describe, expect, it } from 'vitest';
+import Database from 'better-sqlite3';
+import { runSqliteMigrations } from '@/lib/db/sqlite-migrations';
+import { createUpdateScheduleStore } from '../update-schedule-store';
+let db: Database.Database; let store: ReturnType<typeof createUpdateScheduleStore>;
+beforeEach(() => { db = new Database(':memory:'); runSqliteMigrations(db); store = createUpdateScheduleStore(() => db); });
+afterEach(() => db.close());
+describe('update schedule store (HRM patch 0030)', () => {
+  it('defaults to off and keeps schedules per tenant', () => {
+    expect(store.get('tenant')).toEqual({ enabled: false, days: [0, 1, 2, 3, 4, 5, 6], startHour: 0, endHour: 24 });
+    store.save('tenant', { enabled: true, days: [4, 1], startHour: 18, endHour: 22 });
+    store.save('tenant', { enabled: true, days: [5, 1], startHour: 20, endHour: 6 });
+    expect(store.get('tenant')).toEqual({ enabled: true, days: [1, 5], startHour: 20, endHour: 6 });
+    expect(store.get('other').enabled).toBe(false);
+  });
+  it('lists current and future blackouts only for the tenant, and prunes old ones', () => {
+    const now = new Date('2026-11-04T15:00:00Z');
+    store.addBlackout('tenant', { startsOn: '2026-11-30', endsOn: '2026-12-02', label: ' Month-end close ' });
+    store.addBlackout('tenant', { startsOn: '2026-11-01', endsOn: '2026-11-04', label: 'Ends today' });
+    store.addBlackout('tenant', { startsOn: '2026-10-28', endsOn: '2026-11-03', label: 'Ended yesterday' });
+    store.addBlackout('tenant', { startsOn: '2026-09-01', endsOn: '2026-09-02', label: 'Long past' });
+    store.addBlackout('other', { startsOn: '2026-11-30', endsOn: '2026-11-30', label: 'Other tenant' });
+    expect(store.blackouts('tenant', now).map((b) => b.label)).toEqual(['Ends today', 'Month-end close']);
+    expect((db.prepare("SELECT COUNT(*) AS n FROM hrm_update_blackouts WHERE tenant_id = 'tenant'").get() as { n: number }).n).toBe(3);
+    const [first] = store.blackouts('tenant', now);
+    expect(store.removeBlackout('other', first.id)).toBe(false);
+    expect(store.removeBlackout('tenant', first.id)).toBe(true);
+  });
+  it('limits each tenant to 50 blackouts', () => {
+    for (let i = 0; i < 50; i += 1) store.addBlackout('tenant', { startsOn: '2026-12-01', endsOn: '2026-12-01', label: `B${i}` });
+    expect(() => store.addBlackout('tenant', { startsOn: '2026-12-01', endsOn: '2026-12-01', label: 'One more' })).toThrow(/limit 50/);
+  });
+});
diff --git a/lib/hrm/__tests__/update-window.test.ts b/lib/hrm/__tests__/update-window.test.ts
new file mode 100644
index 000000000..ad65f5ca6
--- /dev/null
+++ b/lib/hrm/__tests__/update-window.test.ts
@@ -0,0 +1,61 @@
+import { describe, expect, it } from 'vitest';
+import { blackoutError, marylandTime, scheduleError, updateWindowState, type UpdateSchedule } from '../update-window';
+
+// 2026-11-04 is a Wednesday. Maryland is UTC-5 in November and UTC-4 in July.
+const at = (iso: string) => new Date(iso);
+const evenings: UpdateSchedule = { enabled: true, days: [1, 2, 3, 4], startHour: 18, endHour: 22 };
+const overnight: UpdateSchedule = { enabled: true, days: [3], startHour: 22, endHour: 5 };
+
+describe('update window (HRM patch 0030)', () => {
+  it('reads Maryland time across daylight saving', () => {
+    expect(marylandTime(at('2026-11-04T23:30:00Z'))).toEqual({ date: '2026-11-04', weekday: 3, hour: 18 });
+    expect(marylandTime(at('2026-07-01T22:00:00Z'))).toMatchObject({ hour: 18 });
+    expect(marylandTime(at('2026-11-05T03:00:00Z'))).toEqual({ date: '2026-11-04', weekday: 3, hour: 22 });
+  });
+  it('is always open without a schedule or blackout', () => {
+    expect(updateWindowState({ enabled: false, days: [], startHour: 18, endHour: 22 }, [], at('2026-11-08T12:00:00Z')).open).toBe(true);
+  });
+  it('opens only on chosen days and hours, end exclusive', () => {
+    expect(updateWindowState(evenings, [], at('2026-11-04T23:00:00Z')).open).toBe(true); // Wed 6 PM
+    expect(updateWindowState(evenings, [], at('2026-11-05T02:59:00Z')).open).toBe(true); // Wed 9:59 PM
+    expect(updateWindowState(evenings, [], at('2026-11-05T03:00:00Z')).open).toBe(false); // Wed 10 PM
+    const closed = updateWindowState(evenings, [], at('2026-11-06T23:00:00Z')); // Fri 6 PM
+    expect(closed).toMatchObject({ open: false, blackout: null, nextOpen: '2026-11-09T23:00:00.000Z' });
+    expect(closed.reason).toMatch(/outside the update schedule until Monday, November 9.*6:00 PM Maryland time/);
+  });
+  it('gives the early hours of an overnight window to the day it started', () => {
+    expect(updateWindowState(overnight, [], at('2026-11-05T03:00:00Z')).open).toBe(true); // Wed 10 PM
+    expect(updateWindowState(overnight, [], at('2026-11-05T09:00:00Z')).open).toBe(true); // Thu 4 AM
+    expect(updateWindowState(overnight, [], at('2026-11-05T10:00:00Z')).open).toBe(false); // Thu 5 AM
+    expect(updateWindowState(overnight, [], at('2026-11-04T09:00:00Z')).open).toBe(false); // Wed 4 AM belongs to Tue
+  });
+  it('lets a blackout win over the schedule, inclusive of both Maryland dates', () => {
+    const b = [{ id: 'b', startsOn: '2026-11-04', endsOn: '2026-11-05', label: 'Month-end close' }];
+    const state = updateWindowState(evenings, b, at('2026-11-04T23:00:00Z'));
+    expect(state).toMatchObject({ open: false, blackout: { label: 'Month-end close' }, nextOpen: '2026-11-09T23:00:00.000Z' });
+    expect(state.reason).toMatch(/^Updates are paused for the blackout "Month-end close" until/);
+    // 11 PM Thursday UTC is still Thursday in Maryland; 5 AM Friday UTC is Friday 0:00 Maryland.
+    expect(updateWindowState({ ...evenings, enabled: false }, b, at('2026-11-06T04:59:00Z')).open).toBe(false);
+    expect(updateWindowState({ ...evenings, enabled: false }, b, at('2026-11-06T05:00:00Z')).open).toBe(true);
+  });
+  it('reports no next opening when nothing opens within 62 days', () => {
+    const b = [{ id: 'b', startsOn: '2026-11-01', endsOn: '2027-02-01', label: 'Freeze' }];
+    const state = updateWindowState(evenings, b, at('2026-11-04T23:00:00Z'));
+    expect(state).toMatchObject({ open: false, nextOpen: null });
+    expect(state.reason).toBe('Updates are paused for the blackout "Freeze".');
+  });
+  it('validates schedules and blackouts', () => {
+    expect(scheduleError(evenings)).toBeNull();
+    expect(scheduleError({ ...evenings, days: [] })).toMatch(/at least 1 day/);
+    expect(scheduleError({ ...evenings, enabled: false, days: [] })).toBeNull();
+    expect(scheduleError({ ...evenings, startHour: 5, endHour: 5 })).toMatch(/different/);
+    expect(scheduleError({ ...evenings, days: [7] })).toMatch(/Sunday to Saturday/);
+    expect(scheduleError({ ...evenings, endHour: 25 })).toMatch(/hour/);
+    expect(blackoutError({ startsOn: '2026-11-30', endsOn: '2026-12-02', label: 'Month-end close' })).toBeNull();
+    expect(blackoutError({ startsOn: '2026-12-02', endsOn: '2026-11-30', label: 'x' })).toMatch(/on or after/);
+    expect(blackoutError({ startsOn: '2026-02-30', endsOn: '2026-03-01', label: 'x' })).toMatch(/date/);
+    expect(blackoutError({ startsOn: '2026-11-30', endsOn: '2026-11-30', label: ' ' })).toMatch(/short name/);
+    expect(blackoutError({ startsOn: '2026-11-30', endsOn: '2026-11-30', label: 'x'.repeat(61) })).toMatch(/60/);
+    expect(blackoutError({ startsOn: '2026-01-01', endsOn: '2026-06-01', label: 'x' })).toMatch(/93 days/);
+  });
+});
