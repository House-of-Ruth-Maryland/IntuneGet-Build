+'use client';
+import { useEffect, useState } from 'react';
+import { useUpdateSchedule } from '@/hooks/useUpdateSchedule';
+import { Button } from '@/components/ui/button';
+import { BLACKOUT_LABEL_MAX, DAY_NAMES, type UpdateSchedule as Schedule } from '@/lib/hrm/update-window';
+
+/** HRM patch 0030: when automatic updates and pilot rollouts may start. */
+const secondary = 'text-sm text-accent-cyan hover:underline disabled:opacity-50';
+const field = 'rounded-md border border-overlay/15 bg-bg-elevated px-2 py-1 text-sm text-text-primary';
+
+export function hourLabel(hour: number): string {
+  if (hour === 0 || hour === 24) return 'midnight';
+  if (hour === 12) return 'noon';
+  return hour < 12 ? `${hour} AM` : `${hour - 12} PM`;
+}
+
+export function scheduleSummary(s: Schedule): string {
+  if (!s.enabled) return 'Any day, any time.';
+  const days = s.days.length === 7 ? 'Every day' : s.days.map((d) => DAY_NAMES[d].slice(0, 3)).join(', ');
+  const hours = s.startHour === 0 && s.endHour === 24 ? 'all day' : `${hourLabel(s.startHour)} to ${hourLabel(s.endHour)}${s.endHour < s.startHour ? ' the next day' : ''}`;
+  return `${days}, ${hours}, Maryland time.`;
+}
+
+const formatDate = (d: string) => new Date(`${d}T12:00:00Z`).toLocaleDateString('en-US', { timeZone: 'UTC', month: 'short', day: 'numeric', year: 'numeric' });
+
+export function UpdateSchedule() {
+  const { data, error, isLoading, action } = useUpdateSchedule();
+  const [editing, setEditing] = useState(false);
+  const [draft, setDraft] = useState<Schedule | null>(null);
+  const [blackout, setBlackout] = useState({ startsOn: '', endsOn: '', label: '' });
+  useEffect(() => { if (data?.schedule && !editing) setDraft(data.schedule); }, [data?.schedule, editing]);
+  if (data?.supported === false) return null;
+  const w = data?.window;
+  const hours = Array.from({ length: 25 }, (_, h) => h);
+  return <section aria-label="Update schedule" className="rounded-xl border border-overlay/10 bg-bg-surface p-4 space-y-3">
+    <div className="flex items-center justify-between"><h2 className="font-semibold text-text-primary">Update schedule</h2>
+      {data?.schedule && !editing && <button className={secondary} onClick={() => { action.reset(); setDraft(data.schedule!); setEditing(true); }}>Change schedule</button>}</div>
+    {isLoading && <p className="text-sm text-text-muted">Loading the update schedule…</p>}
+    {error && <p role="alert" className="text-sm text-status-error">{error.message}</p>}
+    {w && <p className={`text-sm font-medium ${w.open ? 'text-status-success' : 'text-status-warning'}`}>{w.open ? 'Automatic updates and pilots can start now.' : w.reason}</p>}
+    {data?.schedule && !editing && <p className="text-sm text-text-secondary">Automatic updates and pilot rollouts start: {scheduleSummary(data.schedule)}{data.schedule.enabled ? ' Updates found outside these times wait and start within an hour of the schedule opening.' : ''} Update and Update all still work at any time.</p>}
+    {editing && draft && <div className="space-y-3 rounded-lg border border-overlay/10 p-3 text-sm">
+      <label className="flex gap-2"><input type="checkbox" checked={draft.enabled} onChange={(e) => setDraft({ ...draft, enabled: e.target.checked })} />Only start automatic updates and pilots at these times</label>
+      <fieldset disabled={!draft.enabled} className="space-y-3 disabled:opacity-50">
+        <legend className="sr-only">Days and hours</legend>
+        <div className="flex flex-wrap gap-3">{DAY_NAMES.map((name, d) => <label key={name} className="flex gap-1"><input type="checkbox" checked={draft.days.includes(d)} onChange={(e) => setDraft({ ...draft, days: e.target.checked ? [...draft.days, d].sort() : draft.days.filter((x) => x !== d) })} />{name.slice(0, 3)}</label>)}</div>
+        <div className="flex flex-wrap items-center gap-2">
+          <label className="flex items-center gap-2">From <select className={field} value={draft.startHour} onChange={(e) => setDraft({ ...draft, startHour: Number(e.target.value) })}>{hours.slice(0, 24).map((h) => <option key={h} value={h}>{hourLabel(h)}</option>)}</select></label>
+          <label className="flex items-center gap-2">to <select className={field} value={draft.endHour} onChange={(e) => setDraft({ ...draft, endHour: Number(e.target.value) })}>{hours.slice(1).map((h) => <option key={h} value={h}>{hourLabel(h)}</option>)}</select></label>
+          <span className="text-text-muted">Maryland time. An end before the start runs past midnight.</span>
+        </div>
+      </fieldset>
+      {action.error && <p role="alert" className="text-status-error">{action.error.message}</p>}
+      <div className="flex gap-3"><Button disabled={action.isPending} onClick={() => action.mutate({ action: 'save', schedule: draft }, { onSuccess: () => setEditing(false) })}>{action.isPending ? 'Saving…' : 'Save schedule'}</Button>
+        <button className={secondary} disabled={action.isPending} onClick={() => { action.reset(); setEditing(false); }}>Cancel</button></div>
+    </div>}
+    {data?.blackouts && <div className="space-y-2">
+      <h3 className="text-sm font-medium text-text-primary">Blackouts</h3>
+      <p className="text-sm text-text-secondary">No automatic updates or pilots start on these dates, whatever the schedule says. Use them for busy periods such as month-end.</p>
+      {data.blackouts.length === 0 && <p className="text-sm text-text-muted">No current or upcoming blackouts.</p>}
+      <ul className="space-y-1 text-sm">{data.blackouts.map((b) => <li key={b.id} className="flex flex-wrap items-center gap-3"><span className="text-text-primary">{b.label}</span><span className="text-text-secondary">{formatDate(b.startsOn)}{b.endsOn !== b.startsOn ? ` to ${formatDate(b.endsOn)}` : ''}</span>
+        <button className={secondary} disabled={action.isPending} onClick={() => action.mutate({ action: 'removeBlackout', id: b.id })}>Remove blackout</button></li>)}</ul>
+      <form className="flex flex-wrap items-end gap-2 text-sm" onSubmit={(e) => { e.preventDefault(); action.mutate({ action: 'addBlackout', ...blackout }, { onSuccess: () => setBlackout({ startsOn: '', endsOn: '', label: '' }) }); }}>
+        <label className="flex flex-col gap-1">Name<input className={field} maxLength={BLACKOUT_LABEL_MAX} placeholder="Month-end close" value={blackout.label} onChange={(e) => setBlackout({ ...blackout, label: e.target.value })} /></label>
+        <label className="flex flex-col gap-1">First day<input type="date" className={field} value={blackout.startsOn} onChange={(e) => setBlackout({ ...blackout, startsOn: e.target.value, endsOn: blackout.endsOn || e.target.value })} /></label>
+        <label className="flex flex-col gap-1">Last day<input type="date" className={field} value={blackout.endsOn} onChange={(e) => setBlackout({ ...blackout, endsOn: e.target.value })} /></label>
+        <Button type="submit" variant="outline" disabled={action.isPending}>Add blackout</Button>
+      </form>
+      {!editing && action.error && <p role="alert" className="text-sm text-status-error">{action.error.message}</p>}
+    </div>}
+  </section>;
+}
