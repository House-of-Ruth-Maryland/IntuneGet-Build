+/** Shared, browser-safe app activity and assignment comparison types. */
+export interface AssignmentSummary { key: string; label: string; installs: boolean }
+export interface AssignmentChange { before: AssignmentSummary[]; after: AssignmentSummary[]; observedAt: string }
+export interface AppObservation {
+  appId: string; wingetId: string; displayName: string; exists: boolean; version: string;
+  assignments: AssignmentSummary[]; checkedAt: string;
+}
+export interface AppSnapshot extends AppObservation {
+  change: AssignmentChange | null; revision: number; reviewedRevision: number;
+}
+export interface AppActivity { id: string; at: string; title: string; detail: string; actor: string; appId: string }
+export interface AppInsights { supported: boolean; snapshot: AppSnapshot | null; activity: AppActivity[] }
+export const GUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
+
+// Ignore Graph's generated assignment ID and object key order. Keep filters,
+// exclusions, intent, deadlines and notifications: each changes who/how an app reaches.
+function stable(value: unknown): unknown {
+  if (Array.isArray(value)) return value.map(stable);
+  if (value && typeof value === 'object') return Object.fromEntries(Object.entries(value)
+    .filter(([key]) => !key.startsWith('@odata.')).sort(([a], [b]) => a.localeCompare(b))
+    .map(([key, v]) => [key, stable(v)]));
+  return value;
+}
+function describeSettings(value: unknown, prefix = ''): string {
+  if (!value || typeof value !== 'object') return '';
+  return Object.entries(value).filter(([key, v]) => !key.startsWith('@odata.') && v !== null && v !== undefined)
+    .map(([key, v]) => {
+      const label = key.replace(/([a-z])([A-Z])/g, '$1 $2').toLowerCase();
+      const path = prefix ? `${prefix}, ${label}` : label;
+      if (typeof v === 'object') return describeSettings(v, path);
+      const text = typeof v === 'boolean' ? (v ? 'Yes' : 'No') : String(v).replace(/([a-z])([A-Z])/g, '$1 $2');
+      return `${path}: ${text}`;
+    }).filter(Boolean).join(' · ');
+}
+export function summarizeAssignments(rows: unknown[], names: Record<string, string> = {}): AssignmentSummary[] {
+  const entries = rows.map((row) => {
+    if (!row || typeof row !== 'object') throw new Error('Invalid assignment');
+    const r = row as Record<string, unknown>;
+    const target = r.target as Record<string, unknown> | undefined;
+    if (!target || typeof target['@odata.type'] !== 'string' || typeof r.intent !== 'string') throw new Error('Incomplete assignment');
+    const type = target['@odata.type'];
+    const id = typeof target.groupId === 'string' ? target.groupId.toLowerCase() : '';
+    const name = type.includes('allDevices') ? 'All devices' : type.includes('allUsers') ? 'All users' : id ? (names[id] || `Group ${id}`) : 'Unknown target';
+    const intent = ({ required: 'Required', available: 'Available', uninstall: 'Uninstall', availableWithoutEnrollment: 'Available without enrollment' } as Record<string, string>)[r.intent] ?? r.intent;
+    const excluded = type.includes('exclusionGroup');
+    const filter = typeof target.deviceAndAppManagementAssignmentFilterId === 'string' && target.deviceAndAppManagementAssignmentFilterId
+      ? ` · ${String(target.deviceAndAppManagementAssignmentFilterType)} filter ${target.deviceAndAppManagementAssignmentFilterId}` : '';
+    const options = describeSettings(r.settings);
+    return {
+      key: JSON.stringify(stable({ intent: r.intent, target: { ...target, groupId: id || undefined, targetType: type }, settings: r.settings ?? null })),
+      label: `${excluded ? 'Excluded ' : ''}${name} · ${intent}${filter}${options ? ` · ${options}` : ''}`,
+      installs: !excluded && (r.intent === 'required' || r.intent === 'available' || r.intent === 'availableWithoutEnrollment'),
+    };
+  });
+  return [...new Map(entries.map((e) => [e.key, e])).values()].sort((a, b) => a.key.localeCompare(b.key));
+}
+export function assignmentsEqual(a: AssignmentSummary[], b: AssignmentSummary[]) {
+  return JSON.stringify(a.map((e) => e.key).sort()) === JSON.stringify(b.map((e) => e.key).sort());
+}
+export function needsReview(s: AppSnapshot) {
+  return !s.exists || !s.assignments.some((a) => a.installs) || (s.change !== null && s.reviewedRevision < s.revision);
+}
