+++ b/lib/hrm/__tests__/app-insights.test.ts
@@ -0,0 +1,110 @@
+import { afterEach, beforeEach, describe, expect, it } from 'vitest';
+import Database from 'better-sqlite3';
+import { runSqliteMigrations } from '@/lib/db/sqlite-migrations';
+import { createAppInsightsStore } from '../app-insights-store';
+import { summarizeAssignments, needsReview, type AppObservation } from '../app-insights';
+
+const A = '11111111-1111-4111-8111-111111111111';
+const B = '22222222-2222-4222-8222-222222222222';
+const group = (id = A, intent = 'required', extra = {}) => ({ id: 'generated-id', intent, target: { '@odata.type': '#microsoft.graph.groupAssignmentTarget', groupId: id }, settings: null, ...extra });
+let db: Database.Database;
+let store: ReturnType<typeof createAppInsightsStore>;
+const obs = (overrides: Partial<AppObservation> = {}): AppObservation => ({ appId: A, wingetId: 'Example.App', displayName: 'Example', exists: true, version: '1', assignments: summarizeAssignments([group()]), checkedAt: '2026-01-01T12:00:00Z', ...overrides });
+function deployment(appId = A, tenant = 'tenant', at = '2026-01-01T10:00:00Z') {
+  db.prepare(`INSERT INTO upload_history (id, user_id, winget_id, version, display_name, intune_app_id, intune_tenant_id, deployed_at) VALUES (?, 'staff', 'Example.App', '1', 'Example', ?, ?, ?)`)
+    .run(`${appId}-${tenant}`, appId, tenant, at);
+}
+beforeEach(() => { db = new Database(':memory:'); runSqliteMigrations(db); store = createAppInsightsStore(() => db); deployment(); });
+afterEach(() => db.close());
+
+describe('app observations and activity', () => {
+  it('establishes a baseline without a change warning and ignores assignment IDs, order and label changes', () => {
+    const first = store.observe('tenant', obs());
+    expect(needsReview(first)).toBe(false);
+    const next = store.observe('tenant', obs({ assignments: summarizeAssignments([group(A.toUpperCase(), 'required', { id: 'another-id' })], { [A]: 'Renamed group' }), checkedAt: '2026-01-02T12:00:00Z' }));
+    expect(next.revision).toBe(0);
+    expect(store.alerts('tenant')).toEqual([]);
+    expect(store.activity('tenant', 'Example.App')).toHaveLength(2); // baseline + existing deployment
+  });
+  it('keeps changes until reviewed, and rejects a review of an older revision', () => {
+    store.observe('tenant', obs());
+    store.observe('tenant', obs({ assignments: [], checkedAt: '2026-01-02T12:00:00Z' }));
+    const third = store.observe('tenant', obs({ assignments: summarizeAssignments([group(B)]), checkedAt: '2026-01-03T12:00:00Z' }));
+    expect(third.change?.before).toEqual(obs().assignments);
+    expect(third.change?.after).toEqual(third.assignments);
+    expect(store.review('tenant', A, 1)).toBe(false);
+    expect(store.review('tenant', A, 2)).toBe(true);
+    expect(store.alerts('tenant')).toEqual([]);
+    // Another observation with the same assignments does not revive the warning.
+    store.observe('tenant', { ...third, checkedAt: '2026-01-04T12:00:00Z' });
+    expect(store.alerts('tenant')).toEqual([]);
+  });
+  it('records known changes with their actor without creating a new drift warning', () => {
+    store.observe('tenant', obs());
+    store.observe('tenant', obs({ assignments: summarizeAssignments([group(B)]), checkedAt: '2026-01-02T12:00:00Z' }), 'Saved in IntuneGet by a staff member', true);
+    expect(store.alerts('tenant')).toEqual([]);
+    expect(store.activity('tenant', 'Example.App')[0]).toMatchObject({ actor: 'Saved in IntuneGet by a staff member', title: 'Groups or assignment settings changed' });
+  });
+  it('detects exclusion, intent, filter, and assignment-setting changes', () => {
+    store.observe('tenant', obs());
+    const changes = [group(A, 'available'), group(A, 'available', { target: { '@odata.type': '#microsoft.graph.exclusionGroupAssignmentTarget', groupId: A } }), group(A, 'available', { target: { '@odata.type': '#microsoft.graph.groupAssignmentTarget', groupId: A, deviceAndAppManagementAssignmentFilterId: B, deviceAndAppManagementAssignmentFilterType: 'include' } }), group(A, 'available', { settings: { notifications: 'hideAll' } })];
+    changes.forEach((g, i) => expect(store.observe('tenant', obs({ assignments: summarizeAssignments([g]), checkedAt: `2026-01-0${i + 2}T12:00:00Z` })).revision).toBe(i + 1));
+  });
+  it('does not treat uninstall or exclusion assignments as receiving installations', () => {
+    expect(needsReview(store.observe('tenant', obs({ assignments: summarizeAssignments([group(A, 'uninstall')]) })))).toBe(true);
+    expect(needsReview(store.observe('tenant', obs({ assignments: summarizeAssignments([group(A, 'required', { target: { '@odata.type': '#microsoft.graph.exclusionGroupAssignmentTarget', groupId: A } })]), checkedAt: '2026-01-02T12:00:00Z' })))).toBe(true);
+  });
+  it('keeps missing and empty-group warnings after review, preserves last groups, and deduplicates missing checks', () => {
+    store.observe('tenant', obs({ version: '2' }));
+    const absent = store.observe('tenant', obs({ exists: false, assignments: [], checkedAt: '2026-01-02T12:00:00Z' }));
+    expect(absent.version).toBe('2');
+    expect(absent.assignments).toEqual(obs().assignments);
+    store.observe('tenant', obs({ exists: false, assignments: [], checkedAt: '2026-01-03T12:00:00Z' }));
+    expect(store.activity('tenant', 'Example.App').filter((e) => e.title === 'No longer in Intune')).toHaveLength(1);
+    expect(store.review('tenant', A, absent.revision)).toBe(true);
+    expect(store.alerts('tenant')).toHaveLength(1);
+    store.observe('tenant', obs({ assignments: [], checkedAt: '2026-01-04T12:00:00Z' }));
+    store.review('tenant', A, store.snapshot('tenant', A)!.revision);
+    expect(store.alerts('tenant')).toHaveLength(1);
+  });
+  it('shows only the newest deployed copy in warnings, with timeline history across versions', () => {
+    store.observe('tenant', obs({ assignments: [] }));
+    deployment(B, 'tenant', '2026-01-02T10:00:00Z');
+    store.observe('tenant', obs({ appId: B, checkedAt: '2026-01-02T12:00:00Z' }));
+    expect(store.alerts('tenant')).toEqual([]);
+    expect(store.tracked('tenant').map((a) => a.appId)).toEqual([B]);
+    expect(store.activity('tenant', 'Example.App').filter((e) => e.title === 'Deployed to Intune')).toHaveLength(2);
+  });
+  it('records only changed install counts and never includes device/user records', () => {
+    const counts = { installed: 5, failed: 2, pending: 1, notApplicable: 0, other: 0 };
+    store.install('tenant', A, '2026-01-01T12:00:00Z', counts);
+    store.install('tenant', A, '2026-01-02T12:00:00Z', counts);
+    store.install('tenant', A, '2026-01-03T12:00:00Z', { ...counts, failed: 0 });
+    expect(store.activity('tenant', 'Example.App').filter((e) => e.title === 'Install results')).toHaveLength(2);
+    expect(store.activity('tenant', 'Example.App')[0].detail).toContain('0 failed');
+  });
+  it('records both version and group changes observed together', () => {
+    store.observe('tenant', obs());
+    store.observe('tenant', obs({ version: '2', assignments: [], checkedAt: '2026-01-02T12:00:00Z' }));
+    const events = store.activity('tenant', 'Example.App');
+    expect(events.some((e) => e.title === 'Version changed in Intune' && e.detail === 'Version 1 to 2')).toBe(true);
+    expect(events.some((e) => e.title === 'Groups or assignment settings changed')).toBe(true);
+  });
+
+  it('isolates tenant snapshots, reviews, history and alerts', () => {
+    store.observe('tenant', obs({ assignments: [] }));
+    expect(store.snapshot('other', A)).toBeNull();
+    expect(store.family('other', A)).toBeNull();
+    expect(store.activity('other', 'Example.App')).toEqual([]);
+    expect(store.review('other', A, 0)).toBe(false);
+    expect(store.alerts('other')).toEqual([]);
+  });
+  it('rejects stale observations and bounds stored activity', () => {
+    store.observe('tenant', obs({ checkedAt: '2026-01-02T12:00:00Z' }));
+    store.observe('tenant', obs({ assignments: [], checkedAt: '2026-01-01T12:00:00Z' }));
+    expect(store.snapshot('tenant', A)?.assignments).toEqual(obs().assignments);
+    for (let i = 0; i < 210; i++) store.install('tenant', A, new Date(Date.UTC(2026, 0, 3, 0, i)).toISOString(), { installed: i, failed: 0, pending: 0, notApplicable: 0, other: 0 });
+    expect((db.prepare('SELECT COUNT(*) AS n FROM hrm_app_activity').get() as { n: number }).n).toBe(200);
+    expect(store.activity('tenant', 'Example.App')).toHaveLength(100);
+  });
+});
