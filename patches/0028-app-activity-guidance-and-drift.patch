diff --git a/lib/hrm/install-error-guidance.ts b/lib/hrm/install-error-guidance.ts
new file mode 100644
index 000000000..17fc3cb5b
--- /dev/null
+++ b/lib/hrm/install-error-guidance.ts
@@ -0,0 +1,40 @@
+/** Checked against Microsoft Learn. Guidance suggests checks, never a diagnosis. */
+export const WIN32_TROUBLESHOOT = 'https://learn.microsoft.com/en-us/intune/app-management/deployment/troubleshoot-win32';
+const MSI = 'https://learn.microsoft.com/en-us/windows/win32/msi/error-codes';
+export interface InstallGuidance { title: string; steps: string[]; source: string }
+export function normalizeInstallCode(input: string): string | null {
+  const value = input.trim();
+  if (!/^(?:0x[0-9a-f]{1,8}|-?\d{1,10})$/i.test(value)) return null;
+  const n = Number(value);
+  if (!Number.isInteger(n) || n < -2147483648 || n > 4294967295) return null;
+  return `0x${(n >>> 0).toString(16).toUpperCase().padStart(8, '0')}`;
+}
+const GENERIC: InstallGuidance = { title: 'Check the installation details', steps: [
+  'Open this app in Intune, then Device install status and a failed installation.',
+  'Read the reported error and collect installation logs before changing the package.',
+], source: WIN32_TROUBLESHOOT };
+const GUIDANCE: Record<string, InstallGuidance> = {
+  '0x87D1041C': { title: 'Intune could not detect the installed app', steps: [
+    'Check whether the app is present and whether it updated itself or was removed.',
+    'Compare the detection rule with the installed version, file or registry location and install context.',
+  ], source: WIN32_TROUBLESHOOT },
+  '0x80070643': { title: 'The installer reported a failure', steps: [
+    'Read the installer log to find the underlying failure; this code does not identify one cause.',
+    'Check the silent command, prerequisites and whether it runs as System or the signed-in user.',
+  ], source: MSI },
+  '0x80070652': { title: 'Another installation is running', steps: [
+    'Let the other installation finish, then check the next Intune attempt.',
+    'If it persists, check the installer logs for an installation that has stopped responding.',
+  ], source: MSI },
+  '0x80070666': { title: 'Another version is already installed', steps: [
+    'Compare the installed version with this package and check the vendor’s supported upgrade path.',
+    'Review replacement and detection settings before deploying again.',
+  ], source: MSI },
+};
+// Raw Windows Installer exit codes and HRESULT-wrapped equivalents.
+GUIDANCE['0x00000643'] = GUIDANCE['0x80070643'];
+GUIDANCE['0x00000652'] = GUIDANCE['0x80070652'];
+GUIDANCE['0x00000666'] = GUIDANCE['0x80070666'];
+export function installErrorGuidance(code: string): InstallGuidance {
+  return GUIDANCE[normalizeInstallCode(code) ?? ''] ?? GENERIC;
+}
