+import { describe, expect, it, vi } from 'vitest';
+import { readObservation, checkAppInsights } from '../app-insights-check';
+import type { AppInsightsStore } from '../app-insights-store';
+const A = '11111111-1111-4111-8111-111111111111';
+const app = { tenantId: 'tenant', appId: A, wingetId: 'Example.App', displayName: 'Example', version: '1' };
+const base = `https://graph.microsoft.com/beta/deviceAppManagement/mobileApps/${A}/assignments`;
+const signal = () => AbortSignal.timeout(10000);
+
+describe('safe Intune observations', () => {
+  it('reads every assignment page before saving a snapshot', async () => {
+    const fetchImpl = vi.fn().mockResolvedValueOnce(Response.json({ id: A, displayVersion: '2' }))
+      .mockResolvedValueOnce(Response.json({ value: [{ intent: 'required', target: { '@odata.type': '#microsoft.graph.allDevicesAssignmentTarget' } }], '@odata.nextLink': `${base}?$skiptoken=two` }))
+      .mockResolvedValueOnce(Response.json({ value: [] }));
+    const observation = await readObservation(app, 'token', signal(), fetchImpl);
+    expect(observation).toMatchObject({ exists: true, version: '2' });
+    expect(observation.assignments).toHaveLength(1);
+    expect(fetchImpl).toHaveBeenCalledTimes(3);
+  });
+  it('only marks an app missing on its own 404', async () => {
+    const fetchImpl = vi.fn().mockResolvedValue(new Response(null, { status: 404 }));
+    expect(await readObservation(app, 'token', signal(), fetchImpl)).toMatchObject({ exists: false });
+    expect(fetchImpl).toHaveBeenCalledTimes(1);
+  });
+  it.each([401, 403, 429, 500])('preserves state on HTTP %s', async (status) => {
+    await expect(readObservation(app, 'token', signal(), vi.fn().mockResolvedValue(new Response(null, { status })))).rejects.toThrow();
+  });
+  it.each([{ value: null }, { value: [], '@odata.nextLink': 'https://evil.example.test/assignments' }])('rejects incomplete assignments and untrusted continuation links', async (page) => {
+    const fetchImpl = vi.fn().mockResolvedValueOnce(Response.json({ id: A })).mockResolvedValueOnce(Response.json(page));
+    await expect(readObservation(app, 'token', signal(), fetchImpl)).rejects.toThrow();
+    expect(fetchImpl).toHaveBeenCalledTimes(2);
+  });
+  it('does not turn an assignment 404 into an app deletion', async () => {
+    const fetchImpl = vi.fn().mockResolvedValueOnce(Response.json({ id: A })).mockResolvedValueOnce(new Response(null, { status: 404 }));
+    await expect(readObservation(app, 'token', signal(), fetchImpl)).rejects.toThrow();
+  });
+  it('does not save any observation after a partial or failed read', async () => {
+    const observe = vi.fn();
+    const store = { tracked: () => [app], observe } as unknown as AppInsightsStore;
+    const result = await checkAppInsights(store, { token: async () => 'token', fetchImpl: vi.fn().mockRejectedValue(new Error('offline')) });
+    expect(result).toEqual({ checked: 0, errors: 1 });
+    expect(observe).not.toHaveBeenCalled();
+  });
+  it('scopes manual checks to the tenant and optional app', async () => {
+    const tracked = vi.fn(() => [app]);
+    const observe = vi.fn();
+    const store = { tracked, observe } as unknown as AppInsightsStore;
+    const fetchImpl = vi.fn().mockResolvedValueOnce(Response.json({ id: A })).mockResolvedValueOnce(Response.json({ value: [] }));
+    expect(await checkAppInsights(store, { tenantId: 'tenant', appId: A, token: async () => 'token', fetchImpl })).toEqual({ checked: 1, errors: 0 });
+    expect(tracked).toHaveBeenCalledWith('tenant', A);
+    expect(observe).toHaveBeenCalledWith('tenant', expect.objectContaining({ appId: A }), undefined, undefined);
+  });
+});
diff --git a/lib/hrm/__tests__/app-insights.test.ts b/lib/hrm/__tests__/app-insights.test.ts
