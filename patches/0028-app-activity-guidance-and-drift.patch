+import { act, createElement } from 'react';
+import { createRoot, type Root } from 'react-dom/client';
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { summarizeAssignments, type AppSnapshot } from '@/lib/hrm/app-insights';
+const state = vi.hoisted(() => ({ value: {} as Record<string, unknown>, mutate: vi.fn() }));
+vi.mock('@/hooks/useAppInsights', () => ({ useAppInsights: () => state.value }));
+import { AppDriftPanel, AppActivityTimeline } from './AppInsights';
+const A = '11111111-1111-4111-8111-111111111111';
+let root: Root;
+(globalThis as typeof globalThis & { IS_REACT_ACT_ENVIRONMENT: boolean }).IS_REACT_ACT_ENVIRONMENT = true;
+const snapshot = (): AppSnapshot => ({ appId: A, wingetId: 'Example.App', displayName: 'Example', exists: true, version: '2', checkedAt: '2026-01-02T12:00:00Z', assignments: [], revision: 3, reviewedRevision: 2, change: { before: summarizeAssignments([{ intent: 'required', target: { '@odata.type': '#microsoft.graph.allDevicesAssignmentTarget' } }]), after: [], observedAt: '2026-01-02T12:00:00Z' } });
+beforeEach(() => { const el = document.createElement('div'); document.body.append(el); root = createRoot(el); state.mutate.mockReset(); state.value = { data: { supported: true, alerts: [snapshot()] }, action: { mutate: state.mutate } }; });
+afterEach(async () => { await act(async () => root.unmount()); document.body.innerHTML = ''; });
+describe('activity and drift screens', () => {
+  it('shows the before/after difference, last successful check, and reviews the displayed revision', async () => {
+    await act(async () => root.render(createElement(AppDriftPanel, { onOpen: vi.fn() })));
+    expect(document.body.textContent).toContain('Previously'); expect(document.body.textContent).toContain('All devices'); expect(document.body.textContent).toContain('Now');
+    expect(document.body.textContent).toContain('Last successful check');
+    const review = [...document.querySelectorAll('button')].find((b) => b.textContent === 'Mark reviewed')!;
+    await act(async () => review.click());
+    expect(state.mutate).toHaveBeenCalledWith({ action: 'review', appId: A, revision: 3 });
+  });
+  it('offers activity when the app is gone and keeps persistent missing warnings after review', async () => {
+    state.value.data = { supported: true, alerts: [{ ...snapshot(), exists: false, reviewedRevision: 3 }] };
+    const open = vi.fn(); await act(async () => root.render(createElement(AppDriftPanel, { onOpen: open })));
+    expect(document.body.textContent).toContain('no longer in Intune');
+    const activity = [...document.querySelectorAll('button')].find((b) => b.textContent === 'Open activity')!;
+    await act(async () => activity.click()); expect(open).toHaveBeenCalledWith(A);
+    expect(document.body.textContent).not.toContain('Mark reviewed');
+  });
+  it('renders saved text safely and distinguishes errors from empty history', async () => {
+    state.value = { data: { supported: true, activity: [{ id: '1', at: '2026-01-02T12:00:00Z', title: 'Deployed to Intune', detail: '<img src=x>', actor: 'IntuneGet' }] }, action: {} };
+    await act(async () => root.render(createElement(AppActivityTimeline, { appId: A })));
+    expect(document.body.textContent).toContain('<img src=x>'); expect(document.querySelector('img')).toBeNull();
