+import { closeSqliteDb, sqliteDb } from '@/lib/db/sqlite';
+import { GET, POST } from './route';
+const request = (body?: unknown) => new NextRequest('http://localhost/api/hrm/installation-policy', { method: body ? 'POST' : 'GET', ...(body ? { body: JSON.stringify(body) } : {}) });
+beforeEach(() => { closeSqliteDb(); state.auth = true; state.tenant = 'one'; });
+afterEach(() => closeSqliteDb());
+it('requires authentication before reading or saving', async () => {
+  state.auth = false; expect((await GET(request())).status).toBe(401); expect((await POST(request({}))).status).toBe(401);
+});
+it('saves only the signed-in tenant and rejects unknown apps and invalid rules', async () => {
+  expect((await POST(request({ action: 'save', appId: '', tenantId: 'two', policy: { mode: 'prompt', days: 3 } }))).status).toBe(200);
+  expect((await (await GET(request())).json()).shared).toEqual({ mode: 'prompt', days: 3 });
+  state.tenant = 'two'; expect((await (await GET(request())).json()).shared.mode).toBe('existing'); state.tenant = 'one';
+  expect((await POST(request({ action: 'save', appId: 'Unknown.App', policy: { mode: 'silent', days: 3 } }))).status).toBe(404);
+  expect((await POST(request({ action: 'save', appId: '', policy: { mode: 'prompt', days: 0 } }))).status).toBe(400);
+  expect((await POST(request({ action: 'inherit', appId: '' }))).status).toBe(400);
+});
+it('sets and removes an exception only for a matching auto-update app', async () => {
+  await sqliteDb.updatePolicies.upsert({ user_id: 'staff', tenant_id: 'one', winget_id: 'Vendor.App', policy_type: 'auto_update', is_enabled: true });
+  const saved = await POST(request({ action: 'save', appId: 'vendor.APP', policy: { mode: 'silent', days: 3, ignored: 'value' } }));
+  expect(saved.status).toBe(200); expect((await saved.json()).exceptions).toEqual([{ appId: 'vendor.app', mode: 'silent', days: 3 }]);
+  state.tenant = 'two'; expect((await POST(request({ action: 'inherit', appId: 'Vendor.App' }))).status).toBe(404); state.tenant = 'one';
