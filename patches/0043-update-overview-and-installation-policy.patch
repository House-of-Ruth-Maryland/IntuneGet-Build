@@ -0,0 +1,38 @@
+import { describe, expect, it } from 'vitest';
+import Database from 'better-sqlite3';
+import { runSqliteMigrations } from '@/lib/db/sqlite-migrations';
+import { applyInstallationPolicy, installationPolicyError } from '../installation-policy';
+import { createInstallationPolicyStore } from '../installation-policy-store';
+import { DEFAULT_PSADT_CONFIG } from '@/types/psadt';
+describe('automatic installation policy', () => {
+  it('resolves tenant-wide inheritance, case-insensitive exceptions and reverting an exception', () => {
+    const db = new Database(':memory:'); runSqliteMigrations(db);
+    const store = createInstallationPolicyStore(() => db);
+    expect(store.effective('one', 'Vendor.App').mode).toBe('existing');
+    store.save('one', '', { mode: 'prompt', days: 3 });
+    store.save('one', 'Vendor.App', { mode: 'silent', days: 3 });
+    expect(store.effective('one', 'vendor.APP').mode).toBe('silent');
+    expect(store.effective('one', 'Other.App')).toEqual({ mode: 'prompt', days: 3 });
+    expect(store.effective('two', 'Vendor.App').mode).toBe('existing');
+    store.remove('two', 'Vendor.App');
+    expect(store.exceptions('one')).toHaveLength(1);
+    store.remove('one', 'VENDOR.APP');
+    expect(store.effective('one', 'Vendor.App')).toEqual({ mode: 'prompt', days: 3 });
+    expect(() => store.remove('one', '')).toThrow(); db.close();
+  });
+  it('keeps installer safety settings while replacing old deadlines and giving a fresh day-based choice period', () => {
+    const original = { ...DEFAULT_PSADT_CONFIG, installCommand: 'trusted install', restartBehavior: 'Suppress' as const,
+      deferDays: 1, deferTimes: 1, deferDeadline: '2025-01-01', forceCloseProcessesCountdown: 10,
+      processesToClose: [{ name: 'example', description: 'Example' }], customDetection: true };
+    expect(applyInstallationPolicy(original, { mode: 'existing', days: 3 })).toBe(original);
+    const config = applyInstallationPolicy(original, { mode: 'prompt', days: 3 })!;
+    expect(config).toMatchObject({ installCommand: 'trusted install', restartBehavior: 'Suppress', customDetection: true,
+      allowDefer: true, deferDays: 3, deferTimes: 1000, deployMode: 'Auto', closeCountdown: 300, processesToClose: original.processesToClose });
+    expect(config.deferDeadline).toBeUndefined(); expect(config.forceCloseProcessesCountdown).toBeUndefined();
+    expect(original.deferDeadline).toBe('2025-01-01');
+    expect(applyInstallationPolicy(config, { mode: 'silent', days: 3 })).toMatchObject({ allowDefer: false, deployMode: 'Silent', deferDays: undefined });
+  });
+  it.each([null, [], {}, { mode: 'prompt', days: 0 }, { mode: 'prompt', days: 1.5 }, { mode: 'prompt', days: 15 }, { mode: 'login', days: 3 }])('rejects invalid policy %j', value => {
+    expect(installationPolicyError(value)).not.toBeNull();
+  });
+});
