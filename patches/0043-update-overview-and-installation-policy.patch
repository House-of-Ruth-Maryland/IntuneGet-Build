+          </div>
+          <DialogFooter><Button variant="ghost" disabled={action.isPending} onClick={() => setOpen(false)}>Close</Button><Button disabled={action.isPending || saved} onClick={() => action.mutate({ action: selected && inherit ? 'inherit' : 'save', appId: selected, policy: draft }, { onSuccess: () => setSaved(true) })}>{action.isPending ? 'Saving…' : selected ? inherit ? 'Use shared policy' : 'Save app exception' : 'Save shared policy'}</Button></DialogFooter>
+        </DialogContent>
+      </Dialog>
+    </div>
+    {isLoading && <p className="text-sm text-text-muted">Loading installation timing…</p>}
+    {error && <p role="alert" className="text-sm text-status-error">{error.message}</p>}
+    {data?.shared && <><p className="text-sm text-text-primary">{installationPolicySummary(data.shared)}.</p><div className="flex flex-wrap items-center gap-3 text-xs text-text-muted"><span>Future automatic updates only</span><span>{exceptions.length} app {exceptions.length === 1 ? 'exception' : 'exceptions'}</span><Link href="/dashboard/inventory" className="text-accent-cyan hover:underline">View device installation results</Link></div></>}
+    {exceptions.length > 0 && <ul className="divide-y divide-overlay/10">{exceptions.map(exception => <li key={exception.appId} className="flex flex-wrap justify-between gap-2 py-2 text-sm"><div><span className="text-text-primary">{apps.find(a => a.winget_id.toLowerCase() === exception.appId.toLowerCase())?.deployment_config?.displayName || exception.appId}</span><p className="text-xs text-text-muted">{installationPolicySummary(exception)}</p></div><button className="text-xs text-accent-cyan hover:underline" onClick={() => { choose(exception.appId); setOpen(true); }}>Edit app exception</button></li>)}</ul>}
+  </section>;
+}
+
+/** Reuses the shared query cache so cards name their actual inherited rule. */
+export function AutoUpdateTimingSummary({ appId }: { appId: string }) {
+  const { data } = useInstallationPolicy();
+  if (!data?.shared) return null;
+  const exception = data.exceptions?.find(p => p.appId.toLowerCase() === appId.toLowerCase());
+  return <p className="mt-2 text-xs text-text-secondary"><span className="font-medium">{exception ? 'App exception' : 'Shared policy'}:</span> {installationPolicySummary(exception ?? data.shared)}. Applies to the next automatic release.</p>;
+}
