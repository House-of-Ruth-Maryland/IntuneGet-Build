diff --git a/lib/hrm/installation-policy-store.ts b/lib/hrm/installation-policy-store.ts
new file mode 100644
index 000000000..3adc375e0
--- /dev/null
+++ b/lib/hrm/installation-policy-store.ts
@@ -0,0 +1,24 @@
+import type Database from 'better-sqlite3';
+import { DEFAULT_INSTALLATION_POLICY, type InstallationPolicy } from './installation-policy';
+export function createInstallationPolicyStore(getDb: () => Database.Database) {
+  const read = (tenant: string, app: string): InstallationPolicy | null => {
+    const row = getDb().prepare('SELECT mode, days FROM hrm_installation_policies WHERE tenant_id = ? AND app_id = ? COLLATE NOCASE').get(tenant, app) as InstallationPolicy | undefined;
+    return row ?? null;
+  };
+  return {
+    shared: (tenant: string) => read(tenant, '') ?? { ...DEFAULT_INSTALLATION_POLICY },
+    effective: (tenant: string, app: string) => read(tenant, app) ?? read(tenant, '') ?? { ...DEFAULT_INSTALLATION_POLICY },
+    exceptions(tenant: string) {
+      return getDb().prepare('SELECT app_id AS appId, mode, days FROM hrm_installation_policies WHERE tenant_id = ? AND app_id != ? ORDER BY app_id').all(tenant, '') as (InstallationPolicy & { appId: string })[];
+    },
+    save(tenant: string, app: string, policy: InstallationPolicy) {
+      getDb().prepare(`INSERT INTO hrm_installation_policies (tenant_id, app_id, mode, days, updated_at) VALUES (?, ?, ?, ?, ?)
+        ON CONFLICT(tenant_id, app_id) DO UPDATE SET mode = excluded.mode, days = excluded.days, updated_at = excluded.updated_at`)
+        .run(tenant, app.toLowerCase(), policy.mode, policy.days, new Date().toISOString());
+    },
+    remove(tenant: string, app: string) {
+      if (!app) throw new Error('The shared policy cannot be removed.');
+      getDb().prepare('DELETE FROM hrm_installation_policies WHERE tenant_id = ? AND app_id = ? COLLATE NOCASE').run(tenant, app);
+    },
+  };
+}
diff --git a/lib/hrm/installation-policy.ts b/lib/hrm/installation-policy.ts
new file mode 100644
index 000000000..5c3386ea5
--- /dev/null
+++ b/lib/hrm/installation-policy.ts
@@ -0,0 +1,27 @@
+import { DEFAULT_PSADT_CONFIG, type PSADTConfig } from '@/types/psadt';
+
+export interface InstallationPolicy { mode: 'existing' | 'prompt' | 'silent'; days: number }
+export const DEFAULT_INSTALLATION_POLICY: InstallationPolicy = { mode: 'existing', days: 3 };
+export function installationPolicyError(value: unknown): string | null {
+  if (!value || typeof value !== 'object' || Array.isArray(value)) return 'Choose an installation policy.';
+  const p = value as InstallationPolicy;
+  if (!['existing', 'prompt', 'silent'].includes(p.mode)) return 'Choose a supported installation policy.';
+  if (!Number.isInteger(p.days) || p.days < 1 || p.days > 14) return 'Choose 1 to 14 days.';
+  return null;
+}
+export function installationPolicySummary(p: InstallationPolicy): string {
+  if (p.mode === 'existing') return 'Keep each app’s saved installation settings';
+  if (p.mode === 'silent') return 'Install automatically without a postponement prompt';
+  return `Allow postponement for ${p.days} ${p.days === 1 ? 'day' : 'days'} from the first installation attempt`;
+}
+/** Only automatic releases use this rule. Keep installer commands, detection and restart behavior. */
+export function applyInstallationPolicy(saved: PSADTConfig | undefined, policy: InstallationPolicy): PSADTConfig | undefined {
+  if (policy.mode === 'existing') return saved;
+  const result: PSADTConfig = { ...DEFAULT_PSADT_CONFIG, ...saved };
+  // Old absolute deadlines and count limits must not shorten a new version's choice period.
+  delete result.deferDeadline;
+  delete result.forceCloseProcessesCountdown;
+  if (policy.mode === 'silent') return { ...result, allowDefer: false, deferByDaysOnly: false, deferDays: undefined, deployMode: 'Silent' };
+  return { ...result, allowDefer: true, deferByDaysOnly: true, deferDays: policy.days, deferTimes: 1000, deployMode: 'Auto',
+    closeCountdown: Math.max(saved?.closeCountdown ?? 60, 300), showClosePrompt: true, promptToSave: true, persistPrompt: false, minimizeWindows: false };
