diff --git a/hooks/useInstallationPolicy.ts b/hooks/useInstallationPolicy.ts
new file mode 100644
index 000000000..f3c77be71
--- /dev/null
+++ b/hooks/useInstallationPolicy.ts
@@ -0,0 +1,23 @@
+'use client';
+import { useMutation, useQuery, useQueryClient } from '@tanstack/react-query';
+import { useMicrosoftAuth } from './useMicrosoftAuth';
+import type { InstallationPolicy } from '@/lib/hrm/installation-policy';
+export interface InstallationPolicyView { supported: boolean; shared?: InstallationPolicy; exceptions?: (InstallationPolicy & { appId: string })[] }
+export function useInstallationPolicy() {
+  const { getAccessToken, isAuthenticated, account } = useMicrosoftAuth();
+  const client = useQueryClient();
+  const key = ['hrm', 'installation-policy', account?.tenantId, account?.localAccountId];
+  const request = async (body?: Record<string, unknown>): Promise<InstallationPolicyView> => {
+    const token = await getAccessToken();
+    if (!token) throw new Error('Sign in again to view installation timing.');
+    const response = await fetch('/api/hrm/installation-policy', { method: body ? 'POST' : 'GET',
+      headers: { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json' }, ...(body ? { body: JSON.stringify(body) } : {}) });
+    if (response.redirected || !response.headers.get('content-type')?.includes('application/json')) throw new Error('Your sign-in expired. Reload and sign in again.');
+    const data = await response.json();
+    if (!response.ok) throw new Error(data.error || 'Could not load installation timing.');
+    return data;
+  };
+  const query = useQuery({ queryKey: key, queryFn: () => request(), enabled: isAuthenticated, staleTime: 30000 });
+  const action = useMutation({ mutationFn: request, onSuccess: data => { client.setQueryData(key, data); } });
+  return { ...query, action };
+}
