+// @vitest-environment happy-dom
+import { act, createElement } from 'react';
+import { createRoot, type Root } from 'react-dom/client';
+import { afterEach, beforeEach, expect, it, vi } from 'vitest';
+import type { AppUpdatePolicy } from '@/types/update-policies';
+const state = vi.hoisted(() => ({ mutate: vi.fn(), reset: vi.fn() }));
+vi.mock('@/hooks/useInstallationPolicy', () => ({ useInstallationPolicy: () => ({ data: { supported: true, shared: { mode: 'existing', days: 3 }, exceptions: [{ appId: 'vendor.app', mode: 'silent', days: 3 }] }, action: { mutate: state.mutate, reset: state.reset, isPending: false } }) }));
+import { InstallationPolicyPanel } from './InstallationPolicyPanel';
+let root: Root;
+(globalThis as typeof globalThis & { IS_REACT_ACT_ENVIRONMENT: boolean }).IS_REACT_ACT_ENVIRONMENT = true;
+const apps = [{ id: 'policy', winget_id: 'Vendor.App', deployment_config: { displayName: 'Vendor App' } }] as AppUpdatePolicy[];
+const button = (label: string) => [...document.querySelectorAll('button')].find(b => b.textContent === label)!;
+beforeEach(async () => { state.mutate.mockReset(); const node = document.createElement('div'); document.body.append(node); root = createRoot(node); await act(async () => root.render(createElement(InstallationPolicyPanel, { apps }))); });
+afterEach(async () => { await act(async () => root.unmount()); document.body.innerHTML = ''; });
+it('opens a labeled right-side panel with a three-day draft without activating it until Save', async () => {
+  expect(document.querySelector('[role="dialog"]')).toBeNull();
+  await act(async () => button('Edit shared policy').click());
+  const panel = document.querySelector('[role="dialog"]')!;
+  expect(panel.className).toContain('right-0'); expect(panel.getAttribute('aria-labelledby')).toBeTruthy();
+  expect(document.querySelector<HTMLSelectElement>('[aria-label="Days users can postpone"]')!.value).toBe('3');
+  expect(state.mutate).not.toHaveBeenCalled();
+  await act(async () => button('Save shared policy').click());
+  expect(state.mutate.mock.calls[0][0]).toEqual({ action: 'save', appId: '', policy: { mode: 'prompt', days: 3 } });
+  expect(document.body.textContent).toContain('may run silently');
+  await act(async () => button('Close').click());
+  expect(document.querySelector('[role="dialog"]')).toBeNull();
+});
+it('lets an app return to inheritance without rewriting the shared policy', async () => {
+  await act(async () => button('Edit app exception').click());
