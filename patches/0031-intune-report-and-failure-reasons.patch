+    expect(await runSqliteUpdateCheck(db)).toMatchObject({ triggered: 1 });
+  });
+  it('still retries after an ordinary dispatch failure', async () => {
+    const { db, runSqliteUpdateCheck } = await failedEarlier('WORKFLOW_DISPATCH_FAILED', 'GitHub returned 502');
+    expect(await runSqliteUpdateCheck(db)).toMatchObject({ triggered: 1 });
+  });
+});
