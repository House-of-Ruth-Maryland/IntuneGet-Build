+  beforeEach(() => { vi.stubEnv('DATABASE_MODE', 'sqlite'); });
+  afterEach(() => { vi.unstubAllEnvs(); });
+  async function failedEarlier(code: string, message: string, sha = 'ABCDEF') {
+    const loaded = await load();
+    await seedDeployment(loaded.db);
+    getAppsByWingetIdsMock.mockResolvedValue([{ winget_id: 'Vendor.App', name: 'Vendor App', latest_version: '1.1.0' }]);
