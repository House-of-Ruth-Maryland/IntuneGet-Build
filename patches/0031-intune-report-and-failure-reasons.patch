diff --git a/lib/hrm/installer-block.ts b/lib/hrm/installer-block.ts
new file mode 100644
index 000000000..69d7620eb
--- /dev/null
+++ b/lib/hrm/installer-block.ts
@@ -0,0 +1,32 @@
+import type Database from 'better-sqlite3';
+
+/**
+ * HRM patch 0031: an automatic update whose installer already failed the pre-packaging check
+ * (publisher serves different bytes, version withdrawn from WinGet, manifest changed) is not tried
+ * again for the same version and installer checksum. It is tried again when the catalog offers a
+ * different version or WinGet corrects the checksum. Jobs from before this patch were recorded as
+ * WORKFLOW_DISPATCH_FAILED, so their message is matched too.
+ */
+export const INSTALLER_CHECK_CODES = ['HASH_MISMATCH', 'MANIFEST_UNAVAILABLE', 'MANIFEST_CHANGED'] as const;
+const LEGACY_MESSAGE = /serves different bytes|is no longer available from WinGet|no longer matches the trusted WinGet manifest/;
+
+export function createInstallerBlockStore(getDb: () => Database.Database) {
+  return {
+    /** The failed job's code and time when this exact installer already failed its check, else null. */
+    blocked(tenant: string, winget: string, version: string, sha256: string): { code: string; at: string } | null {
+      const rows = getDb().prepare(`SELECT error_code, error_message, created_at FROM packaging_jobs
+        WHERE tenant_id = ? AND winget_id = ? COLLATE NOCASE AND version = ? AND status = 'failed'
+          AND upper(COALESCE(installer_sha256, '')) = upper(?)
+          AND error_code IN ('HASH_MISMATCH','MANIFEST_UNAVAILABLE','MANIFEST_CHANGED','WORKFLOW_DISPATCH_FAILED')
+        ORDER BY created_at DESC LIMIT 5`).all(tenant, winget, version, sha256) as Array<{ error_code: string; error_message: string | null; created_at: string }>;
+      const hit = rows.find((r) => r.error_code !== 'WORKFLOW_DISPATCH_FAILED' || LEGACY_MESSAGE.test(r.error_message ?? ''));
+      return hit ? { code: hit.error_code, at: hit.created_at } : null;
+    },
+  };
+}
+
+export async function installerBlocked(tenant: string, winget: string, version: string, sha256: string) {
+  if (process.env.DATABASE_MODE?.toLowerCase() !== 'sqlite' || !sha256) return null;
+  const { sqliteInstallerBlocks } = await import('@/lib/db/sqlite');
+  return sqliteInstallerBlocks.blocked(tenant, winget, version, sha256);
+}
