new file mode 100644
index 000000000..57fc8a352
--- /dev/null
+++ b/components/unmanaged/DiscoveredGuide.tsx
@@ -0,0 +1,84 @@
+'use client';
+
+// HRM patch 0040: how Discovered apps works, at the top of the page. Hiding it is remembered in this browser.
+import { useEffect, useState } from 'react';
+import Link from 'next/link';
+import { ChevronDown, ChevronUp, PackageCheck, Trash2 } from 'lucide-react';
+import { Button } from '@/components/ui/button';
+import { cn } from '@/lib/utils';
+
+const KEY = 'hrm.discovered.guide.hidden';
+export const GUIDE_LABELS = { title: 'How Discovered apps works', show: 'How this works', hide: 'Hide' } as const;
+
+const lanes = [
+  {
+    tone: 'install' as const, icon: PackageCheck, title: 'Keep it and let IntuneGet update it',
+    steps: ['Claim', 'Choose groups', 'Deploy to Intune', 'Get updates'],
+  },
+  {
+    tone: 'remove' as const, icon: Trash2, title: 'Remove it from devices',
+    steps: ['Remove', 'Check groups', 'Deploy to Intune', 'Delete when done'],
+  },
+];
+
+const terms: Array<[string, string]> = [
+  ['Claimed', 'In the Deployment list, waiting to be installed. Nothing has changed on devices yet. Deploy it, or take it out of the list.'],
+  ['To remove', 'In the Deployment list, waiting to be uninstalled. Nothing has changed on devices yet.'],
+  ['Matched', 'IntuneGet knows which WinGet package it is, so it can install it. Remove from devices checks whether it can also remove it.'],
+  ['Partial match / No match', 'IntuneGet isn\'t sure which package it is. Use Link package to pick one first.'],
+  ['Microsoft Store app', 'Comes from the Store. Install or remove it in Intune as a Microsoft Store app.'],
+];
+
+export function DiscoveredGuide() {
+  const [hidden, setHidden] = useState(false);
+  useEffect(() => {
+    try { setHidden(window.localStorage.getItem(KEY) === '1'); } catch { /* storage unavailable: show it */ }
+  }, []);
+  const toggle = () => {
+    const next = !hidden;
+    setHidden(next);
+    try { window.localStorage.setItem(KEY, next ? '1' : '0'); } catch { /* not remembered */ }
+  };
+
+  return (
+    <section aria-labelledby="discovered-guide" className="glass-light rounded-xl border border-overlay/10">
+      <div className="flex items-center justify-between gap-3 px-5 py-3">
+        <h2 id="discovered-guide" className="text-sm font-semibold text-text-primary">{GUIDE_LABELS.title}</h2>
+        <Button type="button" size="sm" variant="ghost" onClick={toggle} aria-expanded={!hidden} className="text-text-secondary">
+          {hidden ? <>{GUIDE_LABELS.show}<ChevronDown className="w-4 h-4 ml-1" /></> : <>{GUIDE_LABELS.hide}<ChevronUp className="w-4 h-4 ml-1" /></>}
+        </Button>
+      </div>
+      {!hidden && (
+        <div className="px-5 pb-5 space-y-4">
+          <p className="text-sm text-text-secondary">
+            These apps are on HRM devices but IntuneGet doesn&apos;t manage them. Nothing on this page changes a device by itself:
+            every change goes through the Deployment list and Deploy to Intune.
+          </p>
+          <div className="grid gap-3 md:grid-cols-2">
+            {lanes.map((lane) => (
+              <div key={lane.title} className={cn('rounded-lg border p-4', lane.tone === 'remove' ? 'border-status-error/20 bg-status-error/5' : 'border-accent-cyan/20 bg-accent-cyan/5')}>
+                <p className="flex items-center gap-2 text-sm font-medium text-text-primary mb-3">
+                  <lane.icon className={cn('w-4 h-4', lane.tone === 'remove' ? 'text-status-error' : 'text-accent-cyan')} />{lane.title}
+                </p>
+                <ol className="grid grid-cols-2 gap-1.5 text-xs text-text-secondary">
+                  {lane.steps.map((step, i) => (
+                    <li key={step} className="flex items-center gap-1.5 rounded-md bg-bg-elevated border border-overlay/10 px-2 py-1.5">
+                      <span className={cn('flex-shrink-0 w-4 h-4 rounded-full flex items-center justify-center text-[10px] font-bold', lane.tone === 'remove' ? 'bg-status-error/15 text-status-error' : 'bg-accent-cyan/15 text-accent-cyan')}>{i + 1}</span>
+                      <span className="truncate">{step}</span>
+                    </li>
+                  ))}
+                </ol>
+              </div>
+            ))}
+          </div>
+          <dl className="grid gap-x-6 gap-y-2 sm:grid-cols-2 text-xs">
+            {terms.map(([term, meaning]) => (
+              <div key={term}><dt className="inline font-semibold text-text-primary">{term}: </dt><dd className="inline text-text-secondary">{meaning}</dd></div>
+            ))}
+          </dl>
+          <p className="text-xs text-text-muted">More in Help: <Link href="/dashboard/help#discovered" className="text-accent-cyan hover:underline">Discovered apps</Link> and <Link href="/dashboard/help#remove-discovered" className="text-accent-cyan hover:underline">Removing an app found on devices</Link>.</p>
+        </div>
+      )}
+    </section>
+  );
+}
diff --git a/components/unmanaged/FlowSteps.tsx b/components/unmanaged/FlowSteps.tsx
new file mode 100644
index 000000000..8fb540aa2
--- /dev/null
+++ b/components/unmanaged/FlowSteps.tsx
@@ -0,0 +1,43 @@
+'use client';
+
+// HRM patch 0040: numbered steps for the install and remove flows on Discovered apps.
+import { cn } from '@/lib/utils';
+
+export interface FlowStep { title: string; detail?: string }
+
+export function FlowSteps({ steps, tone = 'install', current = 0, className }: {
+  steps: FlowStep[]; tone?: 'install' | 'remove'; current?: number; className?: string;
+}) {
+  const color = tone === 'remove'
+    ? { now: 'bg-status-error text-white', next: 'bg-status-error/10 text-status-error border border-status-error/30' }
+    : { now: 'bg-accent-cyan text-black', next: 'bg-accent-cyan/10 text-accent-cyan border border-accent-cyan/30' };
+  return (
+    <ol className={cn('space-y-3', className)}>
+      {steps.map((step, i) => (
+        <li key={step.title} className="flex gap-3">
+          <span className={cn('flex-shrink-0 w-6 h-6 rounded-full flex items-center justify-center text-xs font-bold', i === current ? color.now : color.next)}>
+            {i + 1}
+          </span>
+          <div className="min-w-0 pt-0.5">
+            <p className="text-sm font-medium text-text-primary">{step.title}{i === current && <span className="ml-2 text-xs font-normal text-text-muted">(this step)</span>}</p>
+            {step.detail && <p className="text-xs text-text-secondary mt-0.5">{step.detail}</p>}
+          </div>
+        </li>
+      ))}
+    </ol>
+  );
+}
+
+export const installSteps = (name: string): FlowStep[] => [
+  { title: 'Claim', detail: `Adds ${name} to the Deployment list. Claimed means it is waiting there. Nothing changes on devices yet.` },
+  { title: 'Choose groups in the Deployment list', detail: 'Required installs it automatically. Available lets staff install it from Company Portal.' },
+  { title: 'Deploy to Intune', detail: "IntuneGet packages it, adds it to Intune and assigns your groups. Devices in Required groups install IntuneGet's copy, including ones that already have it." },
+  { title: 'IntuneGet keeps it up to date', detail: 'New versions show under App updates, and the app appears in Inventory.' },
+];
+
+export const removeSteps = (name: string): FlowStep[] => [
+  { title: 'Add removal to Deployment list', detail: 'Nothing changes on devices yet.' },
+  { title: 'Check the groups in the Deployment list', detail: 'Every group must be Uninstall. All devices removes it everywhere it is found.' },
+  { title: 'Deploy to Intune', detail: `IntuneGet adds "${name} (uninstall only)" to Intune with those Uninstall groups.` },
+  { title: 'Watch it in Inventory, then delete it', detail: `Devices that have ${name} remove it when they check in. Inventory shows how many still have it. When none are left, press Delete from Intune.` },
+];
diff --git a/components/unmanaged/RemoveAppModal.tsx b/components/unmanaged/RemoveAppModal.tsx
new file mode 100644
index 000000000..a10e6af3d
--- /dev/null
+++ b/components/unmanaged/RemoveAppModal.tsx
@@ -0,0 +1,136 @@
+'use client';
+
+// HRM patch 0040: guided removal of an app found on devices.
+import { useEffect, useState } from 'react';
+import { AlertTriangle, Loader2, Monitor, Trash2 } from 'lucide-react';
+import { Button } from '@/components/ui/button';
+import { Dialog, DialogContent, DialogDescription, DialogFooter, DialogHeader, DialogTitle } from '@/components/ui/dialog';
+import { AppIcon } from '@/components/AppIcon';
+import { FlowSteps, removeSteps } from './FlowSteps';
+import { REMOVAL_LABELS } from '@/lib/hrm/removal';
+import type { RemovalCheck, RemovalTarget } from '@/hooks/use-unmanaged-apps';
+import type { UnmanagedApp } from '@/types/unmanaged';
+
+interface Props {
+  app: UnmanagedApp;
+  onClose: () => void;
+  onCheck: (app: UnmanagedApp) => Promise<RemovalCheck>;
+  onConfirm: (app: UnmanagedApp, check: RemovalCheck, target: RemovalTarget) => void;
+  onLink: (app: UnmanagedApp) => void;
+}
+
+/** What staff can do when IntuneGet can't remove the app itself. */
+function alternatives(app: UnmanagedApp): string[] {
+  if (app.isStoreApp) return [
+    'In Intune, add it as a Microsoft Store app (new) and assign it to groups as Uninstall.',
+  ];
+  if (app.matchStatus !== 'matched') return [
+    'If it is in WinGet, use Link package to pick the right package, then press Remove from devices again.',
+    "Otherwise, remove it with a script in Intune (Devices, Scripts and remediations) or the vendor's own removal tool.",
+  ];
+  return ["Remove it with a script in Intune (Devices, Scripts and remediations) or the vendor's own removal tool."];
+}
+
+export function RemoveAppModal({ app, onClose, onCheck, onConfirm, onLink }: Props) {
+  const [check, setCheck] = useState<RemovalCheck | null>(null);
+  const [error, setError] = useState<string | null>(null);
+  const [target, setTarget] = useState<RemovalTarget>('allDevices');
+  const [confirmed, setConfirmed] = useState(false);
+  const inList = app.cartPurpose === 'install';
+
+  useEffect(() => {
+    let live = true;
+    if (inList) return;
+    onCheck(app).then((r) => { if (live) setCheck(r); }).catch((e) => { if (live) setError(e instanceof Error ? e.message : 'Try again.'); });
+    return () => { live = false; };
+  }, [app, onCheck, inList]);
+
+  const blocked = inList
+    ? { reason: 'It is claimed: it is in the Deployment list to be installed. Take it out of the Deployment list first.' }
+    : check && !check.ok ? check : null;
+
+  return (
+    <Dialog open onOpenChange={(open) => { if (!open) onClose(); }}>
+      <DialogContent className="max-w-lg mx-4">
+        <DialogHeader>
+          <DialogTitle>{REMOVAL_LABELS.remove}</DialogTitle>
+          <DialogDescription className="sr-only">Uninstall {app.displayName} from devices through Intune</DialogDescription>
+        </DialogHeader>
+
+        <div className="px-6 py-5 space-y-5 max-h-[70vh] overflow-y-auto">
+          <div className="flex items-center gap-4">
+            <AppIcon packageId={app.matchedPackageId || app.displayName} packageName={app.displayName} size="lg" />
+            <div className="min-w-0">
+              <h3 className="text-text-primary font-semibold truncate">{app.displayName}</h3>
+              <p className="text-text-secondary text-sm truncate">{app.publisher || 'Unknown publisher'}</p>
+              <p className="text-text-muted text-xs mt-1 flex items-center gap-1"><Monitor className="w-3.5 h-3.5" />Found on {app.deviceCount.toLocaleString()} {app.deviceCount === 1 ? 'device' : 'devices'}</p>
+            </div>
+          </div>
+
+          {!blocked && !check && !error && (
+            <p className="flex items-center gap-2 text-sm text-text-secondary"><Loader2 className="w-4 h-4 animate-spin" />Checking whether IntuneGet can remove it…</p>
+          )}
+
+          {error && <p role="alert" className="text-sm text-status-error">{error}</p>}
+
+          {blocked && (
+            <div className="rounded-xl border border-status-warning/30 bg-status-warning/5 p-4 space-y-2">
+              <p className="text-sm font-medium text-text-primary flex items-center gap-2"><AlertTriangle className="w-4 h-4 text-status-warning" />IntuneGet can&apos;t remove this app</p>
+              <p className="text-sm text-text-secondary">{blocked.reason}</p>
+              {!inList && (
+                <>
+                  <p className="text-sm font-medium text-text-primary pt-1">What you can do instead</p>
+                  <ul className="list-disc pl-5 space-y-1 text-sm text-text-secondary">{alternatives(app).map((a) => <li key={a}>{a}</li>)}</ul>
+                </>
+              )}
+            </div>
+          )}
+
+          {check?.ok && (
+            <>
+              <div className="rounded-xl border border-overlay/10 bg-bg-elevated/50 p-4">
+                <h4 className="text-sm font-medium text-text-primary mb-3">How removing works</h4>
+                <FlowSteps steps={removeSteps(app.displayName)} tone="remove" />
+              </div>
+
+              <div className="rounded-xl border border-overlay/10 p-4 space-y-1 text-sm text-text-secondary">
+                <p className="font-medium text-text-primary">What gets removed</p>
+                <p>Each device in the groups uninstalls the program named exactly &quot;{app.displayName}&quot;, using the program&apos;s own uninstaller.</p>
+                <p>Other products from the same publisher aren&apos;t touched. Copies installed for one user only aren&apos;t removed.</p>
+              </div>
+
+              <fieldset className="space-y-2">
+                <legend className="text-sm font-medium text-text-primary mb-1">Remove it from</legend>
+                <label className="flex items-start gap-2 text-sm text-text-primary">
+                  <input type="radio" name="removal-target" className="mt-1" checked={target === 'allDevices'} onChange={() => setTarget('allDevices')} />
+                  <span>All devices<span className="block text-xs text-text-secondary">For software HRM doesn&apos;t want anywhere.</span></span>
+                </label>
+                <label className="flex items-start gap-2 text-sm text-text-primary">
+                  <input type="radio" name="removal-target" className="mt-1" checked={target === 'choose'} onChange={() => setTarget('choose')} />
+                  <span>Groups I choose in the Deployment list<span className="block text-xs text-text-secondary">Every group you add there is set to Uninstall.</span></span>
+                </label>
+              </fieldset>
+
+              <label className="flex items-start gap-2 text-sm text-text-primary">
+                <input type="checkbox" className="mt-1" checked={confirmed} onChange={(e) => setConfirmed(e.target.checked)} />
+                {REMOVAL_LABELS.confirm}
+              </label>
+            </>
+          )}
+        </div>
+
+        <DialogFooter>
+          <Button type="button" variant="outline" onClick={onClose} className="border-overlay/10">{blocked ? 'Close' : 'Cancel'}</Button>
+          {blocked && !inList && !app.isStoreApp && app.matchStatus !== 'matched' && (
+            <Button type="button" variant="outline" onClick={() => { onClose(); onLink(app); }} className="border-overlay/10">Link package</Button>
+          )}
+          {check?.ok && (
+            <Button type="button" variant="destructive" disabled={!confirmed} onClick={() => onConfirm(app, check, target)}>
+              <Trash2 className="w-4 h-4 mr-2" />{REMOVAL_LABELS.add}
+            </Button>
+          )}
+        </DialogFooter>
+      </DialogContent>
+    </Dialog>
+  );
+}
