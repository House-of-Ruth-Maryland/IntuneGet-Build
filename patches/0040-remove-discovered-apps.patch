+import type { GraphAssignment } from '../duplicates';
+
+const APP = '11111111-1111-4111-8111-111111111111';
+
+describe('which installers can be removed', () => {
+  it('allows EXE-family machine installers', () => {
+    for (const type of ['exe', 'inno', 'nullsoft', 'burn']) expect(removalBlockReason({ type, scope: 'machine' })).toBeNull();
+  });
+  it('refuses MSI, MSIX, portable, ZIP and per-user packages with a reason', () => {
+    expect(removalBlockReason({ type: 'msi' })).toMatch(/MSI/);
+    expect(removalBlockReason({ type: 'wix' })).toMatch(/MSI/);
+    expect(removalBlockReason({ type: 'zip', nestedInstallerType: 'msi' })).toMatch(/MSI/);
+    expect(removalBlockReason({ type: 'msix' })).toMatch(/MSIX/);
+    expect(removalBlockReason({ type: 'portable' })).toMatch(/installed programs/);
+    expect(removalBlockReason({ type: 'zip', nestedInstallerType: 'exe' })).toMatch(/installed programs/);
+    expect(removalBlockReason({ type: 'exe', scope: 'user' })).toMatch(/one user/);
+    expect(removalBlockReason({ type: 'pwa' })).toMatch(/can't remove/);
+  });
+});
+
+describe('groups of a removal', () => {
+  it('needs at least one included group, all Uninstall', () => {
+    expect(removalGroupProblems(undefined)).toEqual(['Choose at least one group to remove it from.']);
+    expect(removalGroupProblems([{ type: 'exclusionGroup', intent: 'required', groupId: 'g' }])).toEqual(['Choose at least one group to remove it from.']);
+    expect(removalGroupProblems([{ type: 'allDevices', intent: 'uninstall' }])).toEqual([]);
+    expect(removalGroupProblems([{ type: 'allDevices', intent: 'uninstall' }, { type: 'group', intent: 'required', groupId: 'g' }]))
+      .toEqual(['Every group must be set to Uninstall.']);
+    // Exclusions keep the intent they have always been sent with.
+    expect(removalGroupProblems([{ type: 'allDevices', intent: 'uninstall' }, { type: 'exclusionGroup', intent: 'required', groupId: 'g' }])).toEqual([]);
+  });
+});
+
+describe('detection and uninstall target the same exact program', () => {
+  it('builds a script that only reports a removable, machine-wide program with exactly that name', () => {
+    const script = removalDetectionScript('McAfee');
+    expect(script.startsWith(REMOVAL_SCRIPT_HEADER)).toBe(true);
+    expect(script).toContain("$name = 'McAfee'");
+    expect(script).toContain('-ine $name');
+    expect(script).not.toMatch(/-like|-match|Contains/);
+    expect(script).toContain('HKLM:\\SOFTWARE\\WOW6432Node');
+    expect(script).not.toContain('HKCU');
+    expect(script).toContain('SystemComponent');
+    expect(script).toContain("Write-Output 'Installed'");
+    expect(removalUninstallCommand('McAfee')).toBe('REGISTRY_UNINSTALL:McAfee');
+  });
+  it('quotes names safely for PowerShell, including typographic quotes', () => {
+    const script = removalDetectionScript("Bob's \u2019Tool\u2019");
+    expect(script).toContain("$name = 'Bob''s \u2019\u2019Tool\u2019\u2019'");
+  });
+  it('folds control characters and line breaks the same way in detection and uninstall', () => {
+    const name = 'Evil\r\nWrite-Output x\u2028App';
+    expect(removalUninstallCommand(name)).toBe('REGISTRY_UNINSTALL:Evil Write-Output x App');
+    expect(removalDetectionScript(name)).toContain("$name = 'Evil Write-Output x App'");
+    expect(removalDetectionScript(name).split('\r\n')).toHaveLength(removalDetectionScript('A').split('\r\n').length);
+  });
+  it('rejects empty and overlong names', () => {
+    expect(validRemovalName('  ')).toBe(false);
+    expect(validRemovalName('x'.repeat(201))).toBe(false);
+    expect(validRemovalName('McAfee')).toBe(true);
+  });
+  it('keeps the removal detection through catalog normalization at dispatch', () => {
+    const rules = removalDetectionRules('McAfee');
+    const out = normalizeCatalogDetectionRules({ detectionRules: rules, wingetId: 'McAfee.WebAdvisor', version: '4.1.1', installScope: 'machine', installerType: 'exe' });
+    expect(out).toEqual(rules);
+  });
+  it('labels the Intune copy once', () => {
+    expect(removalDisplayName('McAfee')).toBe('McAfee (uninstall only)');
+    expect(removalDisplayName('McAfee (uninstall only)')).toBe('McAfee (uninstall only)');
+  });
+});
+
+describe('removal items', () => {
+  const item = (extra: Partial<CartItem> = {}) => ({
+    id: 'i1', appSource: 'win32', wingetId: 'Example.Tool', displayName: 'Example Tool (uninstall only)', publisher: 'Example', version: '2.0',
+    addedAt: '2026-01-01T00:00:00Z', assignments: [{ type: 'allDevices', intent: 'uninstall' }], ...extra,
+  }) as unknown as CartItem;
+  it('recognizes a removal only with a valid name', () => {
+    expect(isRemovalItem(item({ hrmRemoval: { discoveredName: 'Example Tool', deviceCount: 4 } }))).toBe(true);
+    expect(removalOf({ hrmRemoval: { discoveredName: '' } })).toBeNull();
+    expect(isRemovalItem(item())).toBe(false);
+  });
+  it('describes a removal plainly before deploying', () => {
+    const row = reviewRow(item({ hrmRemoval: { discoveredName: 'Example Tool' } }));
+    expect(row.action).toBe('Adds it to Intune only to uninstall "Example Tool"');
+    expect(row.groups).toBe('All devices · Uninstall');
+    expect(row.updates).toBe('Updates: Ignore');
+    expect(row.warnings).toEqual([]);
+    expect(reviewRow(item({ hrmRemoval: { discoveredName: 'Example Tool' }, assignments: [] })).warnings).toEqual(['Choose at least one group to remove it from.']);
+  });
+});
+
+describe('tracking a removal after it deploys', () => {
+  let db: Database.Database;
+  let store: ReturnType<typeof createRetireStore>;
+  const rows = [{ intent: 'uninstall', target: { '@odata.type': '#microsoft.graph.allDevicesAssignmentTarget' } }] as GraphAssignment[];
+  const job = (config: unknown) => ({ id: 'job1', tenant_id: 'tenant', winget_id: 'Example.Tool', version: '2.0', display_name: 'Example Tool (uninstall only)', user_email: 'staff@example.test', package_config: config });
+  const deps = (overrides: Record<string, unknown> = {}) => ({
+    sqlite: true, token: async () => 'token', read: async () => ({ displayName: 'Example Tool (uninstall only)', version: '2.0', rows }), store, ...overrides,
+  }) as Parameters<typeof startRemovalTracking>[2];
+  beforeEach(() => { db = new Database(':memory:'); runSqliteMigrations(db); store = createRetireStore(() => db); });
+  afterEach(() => db.close());
+
+  it('starts an uninstalling record marked as a removal, with no groups to put back', async () => {
+    expect(await startRemovalTracking(job({ hrmRemoval: { discoveredName: 'Example Tool' } }), APP, deps())).toBe('started');
+    const r = store.active('tenant', APP);
+    expect(r).toMatchObject({ phase: 'uninstalling', purpose: 'removal', saved_assignments: [], uninstall_assignments: rows, started_by: 'staff@example.test' });
+    expect(store.holdsFamily('tenant', 'example.tool')).toBe(true);
+  });
+  it('does nothing for ordinary deployments', async () => {
+    expect(await startRemovalTracking(job({}), APP, deps())).toBe('skipped');
+    expect(store.active('tenant', APP)).toBeNull();
+  });
+  it('never throws when Intune can\'t be read', async () => {
+    expect(await startRemovalTracking(job({ hrmRemoval: { discoveredName: 'Example Tool' } }), APP, deps({ read: async () => { throw new Error('down'); } }))).toBe('failed');
+    expect(store.active('tenant', APP)).toBeNull();
+  });
+  it('records ordinary retirements as retire', () => {
+    store.reserve({ id: 'r1', tenant_id: 'tenant', app_id: APP, winget_id: 'Example.Tool', display_name: 'Example', version: '1', saved_assignments: [], uninstall_assignments: [], started_by: 'staff@example.test', started_at: '2026-01-01T00:00:00Z' });
+    expect(store.active('tenant', APP)?.purpose).toBe('retire');
+  });
+  it('adds the column once, keeping existing retirements', () => {
+    const fresh = new Database(':memory:');
+    runSqliteMigrations(fresh);
+    const columns = (fresh.prepare('PRAGMA table_info(hrm_retirements)').all() as Array<{ name: string }>).filter((c) => c.name === 'purpose');
+    expect(columns).toHaveLength(1);
+    fresh.close();
+  });
+});
