+++ b/components/hrm/help/HelpWorkspace.tsx
@@ -0,0 +1,119 @@
+'use client';
+import { useCallback, useEffect, useRef, useState, type MouseEvent, type ReactNode } from 'react';
+import Link from 'next/link';
+import { ArrowLeft, ArrowRight, ArrowUpRight, BookOpen, CheckCircle2, ChevronDown, ChevronLeft, ChevronRight, Circle, CircleHelp, ExternalLink, Lightbulb, Link2, ListChecks, Search, ShieldCheck, X } from 'lucide-react';
+import { HELP_CATEGORIES, HELP_GUIDES, type HelpCategory } from '@/lib/hrm/help-guides';
+import { HELP_SECTIONS, HRM_SUPPORT_URL } from '@/lib/hrm/help-content';
+import { helpGuideFromHash, searchHelpGuides } from '@/lib/hrm/help-navigation';
+import { HelpVisual, HELP_SCREENS } from './HelpVisual';
+
+const FEATURED = ['deploying', 'automatic-installation-policy', 'install-results', 'pilot-rollouts', 'remove-discovered', 'support'];
+const focusRing = 'focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-cyan focus-visible:ring-offset-2 focus-visible:ring-offset-bg-surface';
+
+function AppLink({ href, children, className = '', newTab = true }: { href: string; children: ReactNode; className?: string; newTab?: boolean }) {
+  const external = href.startsWith('https://');
+  return <Link href={href} target={external || newTab ? '_blank' : undefined} rel={external || newTab ? 'noopener noreferrer' : undefined} className={`${className} ${focusRing}`} data-help-app-link>
+    {children}{external ? <><ExternalLink size={14} aria-hidden="true"/></> : <ArrowUpRight size={15} aria-hidden="true"/>}{(external || newTab) && <span className="sr-only"> (opens in a new tab)</span>}
+  </Link>;
+}
+
+export function HelpWorkspace() {
+  const [selected, setSelected] = useState<string | null>(null);
+  const [stepIndex, setStepIndex] = useState(0);
+  const [query, setQuery] = useState('');
+  const [category, setCategory] = useState<HelpCategory | 'all'>('all');
+  const [browseAll, setBrowseAll] = useState(false);
+  const [copied, setCopied] = useState(false);
+  const [copyError, setCopyError] = useState(false);
+  const heading = useRef<HTMLHeadingElement>(null);
+  const input = useRef<HTMLInputElement>(null);
+  const stepList = useRef<HTMLOListElement>(null);
+  const guide = HELP_GUIDES.find(item => item.id === selected);
+  const searching = query.trim().length > 0;
+
+  useEffect(() => {
+    const sync = () => { setSelected(helpGuideFromHash(window.location.hash)); setStepIndex(0); setQuery(''); setCopied(false); };
+    sync();
+    window.addEventListener('hashchange', sync); window.addEventListener('popstate', sync);
+    return () => { window.removeEventListener('hashchange', sync); window.removeEventListener('popstate', sync); };
+  }, []);
+  useEffect(() => {
+    if (selected) heading.current?.focus({ preventScroll: true });
+  }, [selected]);
+
+  useEffect(() => {
+    const list = stepList.current;
+    const active = list?.querySelector<HTMLElement>('[aria-current="step"]');
+    if (!list || !active || list.scrollWidth <= list.clientWidth) return;
+    const outer = list.getBoundingClientRect(), inner = active.getBoundingClientRect();
+    if (inner.right > outer.right) list.scrollLeft += inner.right - outer.right + 4;
+    else if (inner.left < outer.left) list.scrollLeft -= outer.left - inner.left + 4;
+  }, [stepIndex, selected]);
+
+  const navigate = useCallback((id: string | null) => {
