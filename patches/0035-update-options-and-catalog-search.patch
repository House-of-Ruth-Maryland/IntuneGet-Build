diff --git a/hooks/use-database-mode.ts b/hooks/use-database-mode.ts
new file mode 100644
index 000000000..6d94c40d2
--- /dev/null
+++ b/hooks/use-database-mode.ts
@@ -0,0 +1,23 @@
+'use client';
+
+import { useEffect, useState } from 'react';
+
+// HRM patch 0035: which database the server runs, read once from /api/health.
+// null until known. Used to hide options that only take effect in Supabase mode.
+let cached: Promise<'sqlite' | 'supabase' | null> | null = null;
+
+export function useDatabaseMode(): 'sqlite' | 'supabase' | null {
+  const [mode, setMode] = useState<'sqlite' | 'supabase' | null>(null);
+  useEffect(() => {
+    let active = true;
+    cached ??= fetch('/api/health', { cache: 'no-store' })
+      .then((res) => (res.ok || res.status === 503 ? res.json() : null))
+      .then((body: { databaseMode?: unknown } | null) =>
+        body?.databaseMode === 'sqlite' || body?.databaseMode === 'supabase' ? body.databaseMode : null)
+      .catch(() => null)
+      .then((value) => { if (value === null) cached = null; return value; });
+    cached.then((value) => { if (active) setMode(value); });
+    return () => { active = false; };
+  }, []);
+  return mode;
+}
diff --git a/lib/hrm/__tests__/catalog-links.test.ts b/lib/hrm/__tests__/catalog-links.test.ts
new file mode 100644
index 000000000..5029b8188
--- /dev/null
+++ b/lib/hrm/__tests__/catalog-links.test.ts
@@ -0,0 +1,33 @@
+// HRM patch 0035: links into the App catalog must use parameters it reads
+// (Find in App catalog sent ?search=, which the catalog ignores).
+import { readdirSync, readFileSync, statSync } from 'node:fs';
+import { join, relative } from 'node:path';
+import { describe, expect, it } from 'vitest';
+
+const root = join(__dirname, '../../..');
+const catalog = readFileSync(join(root, 'app/(app)/dashboard/apps/page.tsx'), 'utf8');
+const read = new Set([...catalog.matchAll(/searchParams\.get\('([A-Za-z]+)'\)/g)].map((m) => m[1]));
+
+function* files(dir: string): Generator<string> {
+  for (const name of readdirSync(dir)) {
+    const path = join(dir, name);
+    if (/node_modules|__tests__|\.test\./.test(path)) continue;
+    if (statSync(path).isDirectory()) yield* files(path);
+    else if (/\.tsx?$/.test(name)) yield path;
+  }
+}
+
+describe('links into the App catalog', () => {
+  it('only use query parameters the App catalog reads', () => {
+    expect(read.has('q')).toBe(true);
+    const bad: string[] = [];
+    for (const dir of ['app', 'components', 'hooks', 'lib']) {
+      for (const file of files(join(root, dir))) {
+        for (const m of readFileSync(file, 'utf8').matchAll(/\/dashboard\/apps\?([A-Za-z]+)=/g)) {
+          if (!read.has(m[1])) bad.push(`${relative(root, file)}: ?${m[1]}=`);
+        }
+      }
+    }
+    expect(bad).toEqual([]);
+  });
+});
