+// @vitest-environment happy-dom
+// Security review U1 (November 2026): Inventory details is a real modal (focus moves in, stays in, returns; nested Escape).
+import { act, createElement as h, useState } from 'react';
+import { createRoot, type Root } from 'react-dom/client';
+import { afterEach, beforeEach, it, expect, vi } from 'vitest';
+vi.mock('framer-motion', async () => {
+  const React = await import('react');
+  return {
+    useReducedMotion: () => true,
+    motion: {
+      div: React.forwardRef<HTMLDivElement, Record<string, unknown>>(function MotionDiv(props, ref) {
+        const { variants, initial, animate, exit, ...rest } = props;
+        return React.createElement('div', { ...rest, ref });
+      }),
+    },
+  };
+});
+import { SlidePanel } from './SlidePanel';
+import { Dialog, DialogContent, DialogHeader, DialogTitle } from '@/components/ui/dialog';
+let root: Root;
+(globalThis as typeof globalThis & { IS_REACT_ACT_ENVIRONMENT: boolean }).IS_REACT_ACT_ENVIRONMENT = true;
+function Fixture() {
+  const [open, setOpen] = useState(false),
+    [review, setReview] = useState(false);
+  return h(
+    'main',
+    null,
+    h('button', { id: 'opener', onClick: () => setOpen(true) }, 'Open'),
+    h(SlidePanel, {
+      isOpen: open,
+      onClose: () => setOpen(false),
+      ariaLabel: 'Example app',
+      children: [
+        h('button', { key: 'review', id: 'review', onClick: () => setReview(true) }, 'Review'),
+        h(
+          Dialog,
+          { key: 'dialog', open: review, onOpenChange: setReview },
+          h(
+            DialogContent,
+            null,
+            h(DialogHeader, null, h(DialogTitle, null, 'Review groups')),
+            h('button', { id: 'inner' }, 'Confirm')
+          )
+        ),
+      ],
+    })
+  );
+}
+beforeEach(async () => {
+  const container = document.createElement('div');
+  document.body.append(container);
+  root = createRoot(container);
+  await act(async () => root.render(h(Fixture)));
+});
+afterEach(async () => {
+  await act(async () => root.unmount());
+  document.body.innerHTML = '';
+});
+it('moves focus into the named modal, contains it, and restores the opener', async () => {
+  const opener = document.getElementById('opener')!;
+  opener.focus();
+  await act(async () => opener.click());
+  const panel = document.querySelector('[role=dialog]')!;
+  expect(panel.getAttribute('aria-labelledby')).toBeTruthy();
+  expect(panel.contains(document.activeElement)).toBe(true);
+  await act(async () => opener.focus());
+  expect(panel.contains(document.activeElement)).toBe(true);
+  await act(async () => {
+    document.activeElement!.dispatchEvent(new KeyboardEvent('keydown', { key: 'Escape', bubbles: true }));
+  });
+  await act(async () => {
+    await new Promise((resolve) => setTimeout(resolve, 5));
+  });
+  expect(document.querySelector('[role=dialog]')).toBeNull();
+  expect(document.activeElement).toBe(opener);
+});
+it('closes only the nested review on Escape', async () => {
+  document.getElementById('opener')!.focus();
+  await act(async () => document.getElementById('opener')!.click());
+  await act(async () => document.getElementById('review')!.click());
+  expect(document.querySelectorAll('[role=dialog]')).toHaveLength(2);
+  await act(async () => {
+    document.activeElement!.dispatchEvent(new KeyboardEvent('keydown', { key: 'Escape', bubbles: true }));
+  });
+  await act(async () => {
+    await new Promise((resolve) => setTimeout(resolve, 5));
+  });
+  expect(document.querySelectorAll('[role=dialog]')).toHaveLength(1);
+  expect(document.getElementById('review')).not.toBeNull();
+});
