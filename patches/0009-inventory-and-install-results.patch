diff --git a/lib/hrm/intune-self-test.ts b/lib/hrm/intune-self-test.ts
new file mode 100644
index 000000000..a2f492676
--- /dev/null
+++ b/lib/hrm/intune-self-test.ts
@@ -0,0 +1,44 @@
+/**
+ * HRM patch 0032: a daily read-only test of every Intune request the server depends on.
+ *
+ * Microsoft changes Graph without notice (in 2026 it removed the install report IntuneGet used, and
+ * started rejecting a $select it relied on), and the scheduled checks only counted the failures.
+ * This runs the server's own read functions against one tracked app per tenant and reports which
+ * failed, with a status-only reason. It never writes to Intune and never returns app, group, user
+ * or device names.
+ */
+import { getServicePrincipalToken } from '@/lib/intune/graph-client';
+import { listWin32AppIds } from './intune-app-ids';
+import { readObservation } from './app-insights-check';
+import { fetchInstallCounts } from './install-status';
+import { pilotGraph } from './pilot-graph';
+
+export interface SelfTestCheck { name: string; ok: boolean; error?: string }
+export interface SelfTestResult { ok: boolean; tenants: number; checks: SelfTestCheck[] }
+interface Tracked { tenantId: string; appId: string; wingetId: string; displayName: string; version: string }
+
+const reason = (error: unknown) => (error instanceof Error ? error.message : 'Failed').replace(/[0-9a-f]{8}-[0-9a-f-]{27}/gi, '<id>').slice(0, 120);
+
+export async function runIntuneSelfTest(tracked: Tracked[], deps: {
+  token?: (tenant: string) => Promise<string | null>; fetchImpl?: typeof fetch;
+} = {}): Promise<SelfTestResult> {
+  const getToken = deps.token ?? getServicePrincipalToken;
+  const byTenant = new Map<string, Tracked>();
+  for (const app of tracked) if (!byTenant.has(app.tenantId)) byTenant.set(app.tenantId, app);
+  const checks: SelfTestCheck[] = [];
+  const check = async (name: string, run: () => Promise<unknown>) => {
+    try { await run(); checks.push({ name, ok: true }); }
+    catch (error) { checks.push({ name, ok: false, error: reason(error) }); }
+  };
+  for (const app of byTenant.values()) {
+    const token = await getToken(app.tenantId).catch(() => null);
+    if (!token) { checks.push({ name: 'Intune sign-in', ok: false, error: 'No Intune token' }); continue; }
+    const signal = AbortSignal.timeout(30000);
+    await check('App list', async () => { if (!(await listWin32AppIds(app.tenantId, { token: async () => token, fetchImpl: deps.fetchImpl }))) throw new Error('App list could not be read completely'); });
+    await check('App and groups', async () => { const o = await readObservation(app, token, signal, deps.fetchImpl); if (!o.exists) throw new Error('Tracked app not found'); });
+    await check('Install results', () => fetchInstallCounts(token, app.appId, deps.fetchImpl));
+    const graph = pilotGraph(token, deps.fetchImpl);
+    await check('Pilot reads', async () => { await graph.app(app.appId); await graph.assignments(app.appId); });
+  }
+  return { ok: checks.every((c) => c.ok), tenants: byTenant.size, checks };
+}
