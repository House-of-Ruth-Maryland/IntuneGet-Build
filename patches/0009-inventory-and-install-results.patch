+vi.mock('@/components/hrm/AppInsights', () => ({ AppActivityTimeline: () => null, AppDriftWarning: () => null }));
+vi.mock('@/components/hrm/AppTimingPanel', () => ({ AppTimingPanel: () => createElement('p', null, 'Install dates') }));
+vi.mock('@/components/hrm/RollbackPanel', () => ({ RollbackPanel: () => createElement('p', null, 'Go back to previous version') }));
+vi.mock('@/components/hrm/RetirePanel', () => ({ RetirePanel: () => createElement('p', null, 'Retire app') }));
+vi.mock('@/components/dashboard/animations/SlidePanel', () => ({
+  SlidePanel: ({ header, footer, children }: { header?: ReactNode; footer?: ReactNode; children: ReactNode }) =>
+    createElement('div', null, header, children, footer ? createElement('footer', null, footer) : null),
+}));
+vi.mock('next/link', () => ({ default: ({ href, children }: { href: string; children: ReactNode }) => createElement('a', { href }, children) }));
+
+import { InventoryAppDetails } from './InventoryAppDetails';
+
+let root: Root | undefined;
+afterEach(async () => { await act(async () => root?.unmount()); document.body.innerHTML = ''; state.prefill = null; state.refetch.mockReset(); });
+
+async function render(onUpdate?: (name: string) => void) {
+  (globalThis as { IS_REACT_ACT_ENVIRONMENT?: boolean }).IS_REACT_ACT_ENVIRONMENT = true;
+  const container = document.createElement('div'); document.body.append(container);
+  root = createRoot(container);
+  await act(async () => root!.render(createElement(InventoryAppDetails, { appId: 'fixture-app', onClose: vi.fn(), onUpdate })));
+  return container;
+}
+const actionTexts = (c: HTMLElement) => [...c.querySelectorAll('[data-testid="inventory-app-actions"] [data-action]')].map((el) => el.textContent?.trim());
+
+describe('Inventory app details actions', () => {
+  it('lists Install dates, Find in App catalog, Go back to previous version, then Retire app', async () => {
+    const c = await render(vi.fn());
