+import { describe, expect, it } from 'vitest';
+import { normalizeInstallCode, installErrorGuidance } from '../install-error-guidance';
+describe('installation error guidance', () => {
+  it('normalizes hexadecimal, signed and unsigned decimal codes', () => {
+    for (const code of ['0x87d1041c', '-2016345060', '2278622236']) expect(normalizeInstallCode(code)).toBe('0x87D1041C');
+    expect(installErrorGuidance('1603')).toEqual(installErrorGuidance('0x80070643'));
+    expect(installErrorGuidance('1618').title).toContain('Another installation');
+    expect(installErrorGuidance('1638').title).toContain('Another version');
+  });
+  it('uses general troubleshooting for unknown, malformed and success codes', () => {
+    for (const code of ['', '0', '3010', '0xFFFFFFFF', 'random', '0x87D1041C<script>', '4294967296', '-2147483649']) expect(installErrorGuidance(code).title).toBe('Check the installation details');
+  });
+  it('links guidance only to Microsoft Learn', () => {
+    for (const code of ['0x87D1041C', '1603', '1618', '1638', 'unknown']) expect(new URL(installErrorGuidance(code).source).hostname).toBe('learn.microsoft.com');
+  });
+});
diff --git a/lib/hrm/__tests__/install-status.test.ts b/lib/hrm/__tests__/install-status.test.ts
