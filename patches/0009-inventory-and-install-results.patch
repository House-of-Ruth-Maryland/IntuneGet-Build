@@ -0,0 +1,33 @@
+import { describe, expect, it, vi } from 'vitest';
+import { runIntuneSelfTest } from '../intune-self-test';
+const A = '11111111-1111-4111-8111-111111111111';
+const app = { tenantId: 'tenant', appId: A, wingetId: 'Example.App', displayName: 'Example', version: '1' };
+function graph(fail?: (url: string) => boolean) {
+  return vi.fn(async (url: string) => {
+    if (fail?.(url)) return new Response(JSON.stringify({ error: { code: 'BadRequest' } }), { status: 400 });
+    if (url.includes('retrieveDeviceAppInstallationStatusReport')) return Response.json({ Schema: [{ Column: 'AppInstallState' }], Values: [['Installed']], TotalRowCount: 1 });
+    if (url.endsWith('/assignments')) return Response.json({ value: [] });
+    if (url.includes(`mobileApps/${A}`)) return Response.json({ id: A, '@odata.type': '#microsoft.graph.win32LobApp', displayVersion: '1' });
+    return Response.json({ value: [{ id: A }] });
+  }) as unknown as typeof fetch;
+}
+describe('Intune self-test (HRM patch 0032)', () => {
+  it('passes when every read works, once per tenant', async () => {
+    const result = await runIntuneSelfTest([app, { ...app, appId: '22222222-2222-4222-8222-222222222222' }], { token: async () => 'token', fetchImpl: graph() });
+    expect(result).toMatchObject({ ok: true, tenants: 1 });
+    expect(result.checks.map((c) => c.name)).toEqual(['App list', 'App and groups', 'Install results', 'Pilot reads']);
+  });
+  it('names the read that Microsoft changed, with a status-only reason', async () => {
+    const result = await runIntuneSelfTest([app], { token: async () => 'token', fetchImpl: graph((url) => url.includes('reports/')) });
+    expect(result.ok).toBe(false);
+    expect(result.checks.find((c) => !c.ok)).toEqual({ name: 'Install results', ok: false, error: 'Intune install report returned 400' });
+  });
+  it('fails without a token, and passes with nothing to test yet', async () => {
+    expect(await runIntuneSelfTest([app], { token: async () => null, fetchImpl: graph() })).toMatchObject({ ok: false, checks: [{ name: 'Intune sign-in', ok: false }] });
+    expect(await runIntuneSelfTest([], { token: async () => 'token', fetchImpl: graph() })).toMatchObject({ ok: true, tenants: 0, checks: [] });
+  });
+  it('never returns IDs in reasons', async () => {
+    const result = await runIntuneSelfTest([app], { token: async () => 'token', fetchImpl: vi.fn(async () => { throw new Error(`boom ${A}`); }) as unknown as typeof fetch });
+    expect(JSON.stringify(result)).not.toContain(A);
+  });
+});
diff --git a/lib/hrm/__tests__/report-safety.test.ts b/lib/hrm/__tests__/report-safety.test.ts
new file mode 100644
index 000000000..177da542f
--- /dev/null
+++ b/lib/hrm/__tests__/report-safety.test.ts
@@ -0,0 +1,130 @@
+// Security review S4, S6 and performance (November 2026): install report safety and bounded checks.
+import { it, expect, vi } from 'vitest';
+import {
+  fetchInstallCounts,
+  countInstallReport,
+  runInstallStatusCheck,
+  type InstallStatusStore,
+  type InstallStatusRecord,
+} from '../install-status';
+import { retirementReady } from '../retire-readiness';
+const APP = '11111111-1111-4111-8111-111111111111';
+it('refuses malformed, truncated and changing reports', async () => {
+  expect(() => countInstallReport([{}])).toThrow(/Incomplete/);
+  const truncated = vi.fn(async () =>
+    Response.json({ Schema: [{ Column: 'AppInstallState' }], Values: [['Not installed']], TotalRowCount: 100 })
+  );
+  await expect(fetchInstallCounts('token', APP, truncated)).rejects.toThrow(/Incomplete/);
+  const tooLarge = vi.fn(async () =>
+    Response.json({ Schema: [{ Column: 'AppInstallState' }], Values: [], TotalRowCount: 21000 })
+  );
+  await expect(fetchInstallCounts('token', APP, tooLarge)).rejects.toThrow(/limit/);
+});
+it('distinguishes confirmed absence, zero reports and uncertainty', () => {
+  const counts = { installed: 0, pending: 0, failed: 0, other: 0, notApplicable: 0, notInstalled: 2 };
+  expect(retirementReady(counts, true)).toBe(true);
+  for (const altered of [{ notInstalled: 0 }, { failed: 1 }, { other: 1 }, { installed: 1 }, { pending: 1 }])
+    expect(retirementReady({ ...counts, ...altered }, true)).toBe(false);
+  // A copy with no Uninstall groups reaches no computers, so an empty report is enough.
+  expect(retirementReady({ ...counts, notInstalled: 0 }, false)).toBe(true);
+  expect(retirementReady({ ...counts, failed: 1 }, false)).toBe(false);
+  expect(retirementReady(null, false)).toBe(false);
+});
+
+it('bounds report concurrency and checkpoints failed attempts for the next run', async () => {
+  const rows = new Map<string, InstallStatusRecord>();
+  const attempts = new Map<string, string>();
+  let active = 0,
+    peak = 0;
+  const store: InstallStatusStore = {
+    get: async (_tenant, app) => rows.get(app) ?? null,
+    save: async (row) => {
+      rows.set(row.intune_app_id, row);
+    },
+    markAlerted: async () => {},
+    listForTenant: async () => [...rows.values()],
+    removeMissing: async () => {},
+    lastAttempt: async (_tenant, app) => attempts.get(app) ?? '',
+    markAttempt: async (_tenant, app, at) => {
+      attempts.set(app, at);
+    },
+  };
+  const deployments = Array.from({ length: 7 }, (_, i) => ({
+    id: String(i),
+    user_id: 'user',
+    intune_tenant_id: 'tenant',
+    intune_app_id: `11111111-1111-4111-8111-${String(i).padStart(12, '0')}`,
+    winget_id: `Example.App${i}`,
+    version: '1',
+    display_name: 'Example',
+    deployed_at: '2026-01-01',
+  })) as never;
+  const token = vi.fn(async () => 'token');
+  const fetcher = vi.fn(async () => {
+    active++;
+    peak = Math.max(peak, active);
+    await new Promise((resolve) => setTimeout(resolve, 2));
+    active--;
+    return Response.json({ Schema: [{ Column: 'AppInstallState' }], Values: [['Installed']], TotalRowCount: 1 });
+  });
+  const result = await runInstallStatusCheck(deployments, { store, token, fetchImpl: fetcher });
+  expect(result.checked).toBe(7);
+  expect(peak).toBe(3);
+  expect(token).toHaveBeenCalledTimes(1);
+  expect(attempts.size).toBe(7);
+  const prior = [...rows.values()];
+  const controller = new AbortController();
+  controller.abort();
+  const failed = await runInstallStatusCheck(deployments, {
+    store,
+    token,
+    fetchImpl: fetcher,
+    signal: controller.signal,
+  });
+  expect(failed.errors).toBe(0);
+  expect(failed.deferred).toBe(7);
+  expect([...rows.values()]).toEqual(prior);
+});
+it('honors throttling backoff and retries within the report deadline', async () => {
+  vi.useFakeTimers();
+  try {
+    const read = vi
+      .fn()
+      .mockResolvedValueOnce(new Response(null, { status: 429, headers: { 'Retry-After': '1' } }))
+      .mockResolvedValueOnce(
+        Response.json({ Schema: [{ Column: 'AppInstallState' }], Values: [['Not installed']], TotalRowCount: 1 })
+      );
+    const result = fetchInstallCounts('token', APP, read);
+    await vi.advanceTimersByTimeAsync(1000);
+    expect((await result).notInstalled).toBe(1);
+    expect(read).toHaveBeenCalledTimes(2);
+  } finally {
+    vi.useRealTimers();
+  }
+});
+
+it('stops when token acquisition does not finish within the run budget', async () => {
+  const store: InstallStatusStore = {
+    get: async () => null,
+    save: async () => {},
+    markAlerted: async () => {},
+    listForTenant: async () => [],
+    removeMissing: async () => {},
+  };
+  const deployments = [
+    {
+      id: 'one',
+      user_id: 'u',
+      intune_tenant_id: 't',
+      intune_app_id: APP,
+      winget_id: 'Example.App',
+      version: '1',
+      display_name: 'Example',
+    },
+  ] as never;
+  const result = await runInstallStatusCheck(deployments, { store, token: () => new Promise(() => {}), budgetMs: 10 });
+  // Cut off by the time limit: left for the next check, not counted as an Intune failure.
+  expect(result.checked).toBe(0);
+  expect(result.errors).toBe(0);
+  expect(result.deferred).toBe(1);
+});
