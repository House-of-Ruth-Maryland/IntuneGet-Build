+import { describe, expect, it, vi } from 'vitest';
+import { listWin32AppIds } from '../intune-app-ids';
+
+const token = async () => 'token';
+const page = (ids: string[], next?: string) => Response.json({ value: ids.map((id) => ({ id })), ...(next ? { '@odata.nextLink': next } : {}) });
+
+describe('listWin32AppIds', () => {
+  it('reads every page and lower-cases the IDs', async () => {
+    const fetchImpl = vi.fn()
+      .mockResolvedValueOnce(page(['AAA'], 'https://graph.microsoft.com/beta/deviceAppManagement/mobileApps?$skiptoken=2'))
+      .mockResolvedValueOnce(page(['bbb']));
+    const ids = await listWin32AppIds('tenant-one', { token, fetchImpl: fetchImpl as unknown as typeof fetch });
+    expect(ids).toEqual(new Set(['aaa', 'bbb']));
+    expect(String(fetchImpl.mock.calls[0][0])).toContain('$select=id');
+  });
+
+  it("returns null when Intune can't be read, so nothing is skipped", async () => {
+    const failing = vi.fn(async () => new Response('denied', { status: 403 })) as unknown as typeof fetch;
+    expect(await listWin32AppIds('tenant-one', { token, fetchImpl: failing })).toBeNull();
+    expect(await listWin32AppIds('tenant-one', { token: async () => null })).toBeNull();
+    expect(await listWin32AppIds('', { token })).toBeNull();
+  });
+
+  it('never follows a next link to another host', async () => {
+    const fetchImpl = vi.fn().mockResolvedValueOnce(page(['aaa'], 'https://evil.example.test/next'));
+    expect(await listWin32AppIds('tenant-one', { token, fetchImpl: fetchImpl as unknown as typeof fetch })).toEqual(new Set(['aaa']));
+    expect(fetchImpl).toHaveBeenCalledTimes(1);
