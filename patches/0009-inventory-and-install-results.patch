+import { beforeEach, describe, expect, it, vi } from 'vitest';
+import { NextRequest } from 'next/server';
+const mocks = vi.hoisted(() => ({ auth: vi.fn(), sqlite: true, family: vi.fn(), snapshot: vi.fn(), activity: vi.fn(), alerts: vi.fn(), review: vi.fn(), check: vi.fn() }));
+vi.mock('@/lib/auth-utils', () => ({ parseAccessToken: mocks.auth }));
+vi.mock('@/lib/db', () => ({ isSqliteMode: () => mocks.sqlite }));
+vi.mock('@/lib/db/sqlite', () => ({ sqliteAppInsights: { family: mocks.family, snapshot: mocks.snapshot, activity: mocks.activity, alerts: mocks.alerts, review: mocks.review } }));
+vi.mock('@/lib/hrm/app-insights-check', () => ({ checkAppInsights: mocks.check }));
+import { GET, POST } from './route';
+const A = '11111111-1111-4111-8111-111111111111';
+const request = (body?: unknown, query = '') => new NextRequest(`http://localhost/api/hrm/app-insights${query}`, { headers: { Authorization: 'Bearer test' }, ...(body ? { method: 'POST', body: JSON.stringify(body) } : {}) });
+beforeEach(() => {
+  vi.clearAllMocks(); mocks.sqlite = true;
+  mocks.auth.mockResolvedValue({ tenantId: 'signed-in-tenant', userId: 'staff' });
+  mocks.family.mockReturnValue('Example.App'); mocks.snapshot.mockReturnValue({ appId: A });
+  mocks.alerts.mockReturnValue([]); mocks.activity.mockReturnValue([]); mocks.review.mockReturnValue(true);
+  mocks.check.mockResolvedValue({ checked: 1, errors: 0 });
+});
+describe('app insight authentication and tenant scope', () => {
+  it('authenticates before reading or checking app data', async () => {
+    mocks.auth.mockResolvedValue(null);
+    expect((await GET(request())).status).toBe(401);
+    expect((await POST(request({ action: 'check' }))).status).toBe(401);
+    expect(mocks.alerts).not.toHaveBeenCalled(); expect(mocks.check).not.toHaveBeenCalled();
+  });
+  it('uses the token tenant, never request-supplied tenant IDs', async () => {
+    const response = await GET(request(undefined, `?appId=${A}&tenantId=other`));
+    expect(response.headers.get('cache-control')).toBe('private, no-store');
+    expect(mocks.family).toHaveBeenCalledWith('signed-in-tenant', A);
+    expect(mocks.activity).toHaveBeenCalledWith('signed-in-tenant', 'Example.App');
+    await POST(request({ action: 'check', tenantId: 'other', appId: A }));
+    expect(mocks.check).toHaveBeenCalledWith(expect.anything(), expect.objectContaining({ tenantId: 'signed-in-tenant', appId: A }));
+    await POST(request({ action: 'review', tenantId: 'other', appId: A, revision: 2 }));
+    expect(mocks.review).toHaveBeenCalledWith('signed-in-tenant', A, 2);
+  });
+  it('does not reveal history for another tenant or an untracked app', async () => {
+    mocks.family.mockReturnValue(null);
+    expect(await (await GET(request(undefined, `?appId=${A}`))).json()).toEqual({ supported: true, snapshot: null, activity: [] });
+    expect(mocks.snapshot).not.toHaveBeenCalled(); expect(mocks.activity).not.toHaveBeenCalled();
+  });
+  it('rejects invalid IDs, actions and revisions and returns a conflict for stale reviews', async () => {
+    expect((await GET(request(undefined, '?appId=invalid'))).status).toBe(400);
+    for (const body of [{ action: 'delete' }, { action: 'review', appId: A, revision: -1 }, { action: 'check', appId: 'bad' }, { action: 'review' }]) expect((await POST(request(body))).status).toBe(400);
+    mocks.review.mockReturnValue(false);
+    expect((await POST(request({ action: 'review', appId: A, revision: 1 }))).status).toBe(409);
+  });
+  it('does not initialize SQLite on hosted installs and never leaks database errors', async () => {
+    mocks.sqlite = false;
+    expect(await (await GET(request())).json()).toMatchObject({ supported: false });
+    expect(mocks.alerts).not.toHaveBeenCalled();
+    mocks.sqlite = true; mocks.alerts.mockImplementation(() => { throw new Error('private server path'); });
+    const response = await GET(request());
+    expect(response.status).toBe(500); expect(await response.text()).not.toContain('private server path');
+  });
+});
diff --git a/app/api/hrm/app-insights/route.ts b/app/api/hrm/app-insights/route.ts
new file mode 100644
index 000000000..6215092e3
--- /dev/null
+++ b/app/api/hrm/app-insights/route.ts
@@ -0,0 +1,36 @@
+import { NextRequest, NextResponse } from 'next/server';
+import { parseAccessToken } from '@/lib/auth-utils';
+import { isSqliteMode } from '@/lib/db';
+import { GUID } from '@/lib/hrm/app-insights';
+import { checkAppInsights } from '@/lib/hrm/app-insights-check';
+
+const reply = (body: unknown, status = 200) => NextResponse.json(body, { status, headers: { 'Cache-Control': 'private, no-store' } });
+export async function GET(request: NextRequest) {
+  const user = await parseAccessToken(request.headers.get('Authorization'));
+  if (!user) return reply({ error: 'Authentication required' }, 401);
+  const appId = request.nextUrl.searchParams.get('appId');
+  if (appId && !GUID.test(appId)) return reply({ error: 'Invalid app' }, 400);
+  if (!isSqliteMode()) return reply({ supported: false, snapshot: null, activity: [], alerts: [] });
+  try {
+    const { sqliteAppInsights: store } = await import('@/lib/db/sqlite');
+    if (!appId) return reply({ supported: true, alerts: store.alerts(user.tenantId) });
+    const family = store.family(user.tenantId, appId);
+    return reply({ supported: true, snapshot: family ? store.snapshot(user.tenantId, appId) : null,
+      activity: family ? store.activity(user.tenantId, family) : [] });
+  } catch { return reply({ error: 'Could not load app activity. Try again.' }, 500); }
+}
+export async function POST(request: NextRequest) {
+  const user = await parseAccessToken(request.headers.get('Authorization'));
+  if (!user) return reply({ error: 'Authentication required' }, 401);
+  if (!isSqliteMode()) return reply({ error: 'App observations need SQLite mode.' }, 409);
+  const body = await request.json().catch(() => null);
+  if (!body || !['check', 'review'].includes(body.action) ||
+      (body.appId !== undefined && (typeof body.appId !== 'string' || !GUID.test(body.appId)))) return reply({ error: 'Invalid request' }, 400);
+  try {
+    const { sqliteAppInsights: store } = await import('@/lib/db/sqlite');
+    if (body.action === 'check') return reply(await checkAppInsights(store, { tenantId: user.tenantId, appId: body.appId, signal: request.signal }));
+    if (!body.appId || !Number.isSafeInteger(body.revision) || body.revision < 0) return reply({ error: 'Invalid review' }, 400);
+    if (!store.review(user.tenantId, body.appId, body.revision)) return reply({ error: 'The groups changed again. Refresh and review the latest change.' }, 409);
+    return reply({ reviewed: true });
+  } catch { return reply({ error: 'Could not check app activity. Try again.' }, 500); }
+}
