+        <div className="mt-3 flex flex-wrap items-center gap-x-3 gap-y-2">
+          <CheckNow {...checkNow} />
+          <a href={intuneUrl} target="_blank" rel="noopener noreferrer" className={secondaryButton}>
+            {OPEN_IN_INTUNE} <ExternalLink className="h-3.5 w-3.5" aria-hidden="true" />
+            <span className="sr-only"> (opens in a new tab)</span>
+          </a>
+        </div>
+      </div>
+    </section>
+  );
+}
