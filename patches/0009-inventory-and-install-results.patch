+// @vitest-environment happy-dom
+import { act, createElement, type ReactNode } from 'react';
+import { createRoot, type Root } from 'react-dom/client';
+import { afterEach, describe, expect, it, vi } from 'vitest';
+
+// HRM patch 0053: one Actions section in a fixed order, Retire app last, and a labelled refresh button.
+const state = vi.hoisted(() => ({ prefill: null as unknown, refetch: vi.fn() }));
+vi.mock('@/hooks/use-inventory', () => ({
+  useAppDetails: () => ({
+    data: { app: { id: 'fixture-app', displayName: 'Fixture', publisher: 'Example', createdDateTime: '2026-01-01T00:00:00Z', lastModifiedDateTime: '2026-01-01T00:00:00Z', assignments: [] } },
+    isLoading: false, error: null, refetch: state.refetch,
