diff --git a/components/hrm/InstallStatusBar.tsx b/components/hrm/InstallStatusBar.tsx
new file mode 100644
index 000000000..a11a20108
--- /dev/null
+++ b/components/hrm/InstallStatusBar.tsx
@@ -0,0 +1,149 @@
+'use client';
+
+// HRM patch 0019: install results for an IntuneGet-deployed app. Counts only, never device or user names.
+// HRM patch 0054: Check installs now refreshes this one app's results from Intune (newest copy, SQLite mode).
+// November 2026 readability pass: a headline count, tiles for the main states, one card per failure reason.
+
+import { useId, useRef, useState } from 'react';
+import { installErrorGuidance } from '@/lib/hrm/install-error-guidance';
+import { ExternalLink } from 'lucide-react';
+import { useCheckInstallsNow, useInstallStatus } from '@/hooks/useInstallStatus';
+import { intuneAppUrl, OPEN_IN_INTUNE } from '@/lib/hrm/intune-link';
+
+// Security review U4 (November 2026): Not installed and Unknown are shown, so every counted device is accounted for.
+const SEGMENTS = [
+  { key: 'installed', label: 'Installed', bar: 'bg-emerald-500', dot: 'bg-emerald-500' },
+  { key: 'failed', label: 'Failed', bar: 'bg-red-500', dot: 'bg-red-500' },
+  { key: 'pending', label: 'Pending', bar: 'bg-amber-400', dot: 'bg-amber-400' },
+  { key: 'notInstalled', label: 'Not installed', bar: 'bg-slate-400', dot: 'bg-slate-400' },
+  { key: 'notApplicable', label: 'Not applicable', bar: 'bg-overlay/20', dot: 'bg-overlay/30' },
+  { key: 'other', label: 'Unknown', bar: 'bg-purple-400', dot: 'bg-purple-400' },
+] as const;
+const MAIN = new Set(['installed', 'failed', 'pending']);
+
+const heading = 'text-base font-semibold text-text-primary';
+const secondaryButton = 'inline-flex items-center gap-1.5 rounded-lg border border-overlay/15 px-3 py-1.5 text-sm font-medium text-text-primary hover:bg-overlay/5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-cyan disabled:opacity-60';
+const computers = (n: number) => (n === 1 ? '1 computer' : `${n} computers`);
+
+// The check's state lives in InstallStatusBar, so its result stays shown when the first results arrive.
+function CheckNow({ canCheck, check }: ReturnType<typeof useCheckInstallsNow>) {
+  if (!canCheck) return null;
+  return (
+    <>
+      <button type="button" onClick={() => check.mutate()} disabled={check.isPending} className={secondaryButton}>
+        {check.isPending ? 'Checking…' : 'Check installs now'}
+      </button>
+      {check.isSuccess && <span role="status" className="text-sm text-status-success">Install results updated.</span>}
+      {check.error && <span role="alert" className="text-sm text-status-error">{check.error.message}</span>}
+    </>
+  );
+}
+
+export function InstallStatusBar({ appId, compact = false }: { appId: string; compact?: boolean }) {
+  const detailId = useId();
+  const [expanded, setExpanded] = useState(false);
+  const detail = useRef<HTMLDivElement>(null);
+  const { data: status, isLoading, error } = useInstallStatus(appId);
+  const checkNow = useCheckInstallsNow(appId);
+  if (!status) {
+    return (
+      <section aria-label="Install results">
+        <h4 className={`${heading} mb-2`}>Install results</h4>
+        <p className="text-sm text-text-secondary" role={error ? 'alert' : undefined}>
+          {isLoading ? 'Loading install results…' : error ? "Couldn't load install results. Close this panel and open it again." : 'No install results for this version yet.'}
+        </p>
+        {!isLoading && !error && <div className="mt-3 flex flex-wrap items-center gap-x-3 gap-y-2"><CheckNow {...checkNow} /></div>}
+      </section>
+    );
+  }
+  const count = (key: (typeof SEGMENTS)[number]['key']) => status[key] ?? 0;
+  const total = SEGMENTS.reduce((sum, s) => sum + count(s.key), 0);
+  const applicable = total - count('notApplicable');
+  const tiles = SEGMENTS.filter((s) => MAIN.has(s.key) || count(s.key) > 0);
+  const zeros = SEGMENTS.filter((s) => !MAIN.has(s.key) && count(s.key) === 0);
+  const checked = new Date(status.checkedAt).toLocaleString('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' });
+  // HRM patch 0036: shared helper; the ID is now URL-encoded like the other Intune links.
+  const intuneUrl = intuneAppUrl(appId);
+
+  if (compact) return <section aria-label="Install results" className="space-y-3">
