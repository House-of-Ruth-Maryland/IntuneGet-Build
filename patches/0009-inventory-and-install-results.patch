diff --git a/lib/hrm/app-insights-check.ts b/lib/hrm/app-insights-check.ts
new file mode 100644
index 000000000..526eb10da
--- /dev/null
+++ b/lib/hrm/app-insights-check.ts
@@ -0,0 +1,83 @@
+/** Only complete, successful reads or an app's own 404 become observations. */
+import { getServicePrincipalToken } from '@/lib/intune/graph-client';
+import { GUID, summarizeAssignments, type AppObservation } from './app-insights';
+import type { AppInsightsStore } from './app-insights-store';
+const BASE = 'https://graph.microsoft.com/beta/deviceAppManagement/mobileApps';
+type Tracked = ReturnType<AppInsightsStore['tracked']>[number];
+
+export async function readObservation(app: Tracked, token: string, signal: AbortSignal, fetchImpl: typeof fetch = fetch): Promise<AppObservation> {
+  if (!GUID.test(app.appId)) throw new Error('Invalid app');
+  const checkedAt = new Date().toISOString();
+  const init = { headers: { Authorization: `Bearer ${token}` }, cache: 'no-store' as const, signal };
+  const response = await fetchImpl(`${BASE}/${app.appId}`, init);
+  if (response.status === 404) return { ...app, exists: false, assignments: [], checkedAt };
+  if (!response.ok) throw new Error(`Intune app read returned ${response.status}`);
+  const body = await response.json();
+  if (typeof body.id !== 'string' || body.id.toLowerCase() !== app.appId.toLowerCase()) throw new Error('Incomplete app');
+  const rows: unknown[] = [];
+  let url: string | null = `${BASE}/${app.appId}/assignments`;
+  for (let page = 0; url && page < 20; page++) {
+    const result: Response = await fetchImpl(url, init);
+    if (!result.ok) throw new Error(`Intune assignment read returned ${result.status}`);
+    const data: { value?: unknown[]; '@odata.nextLink'?: unknown } = await result.json();
+    if (!Array.isArray(data.value)) throw new Error('Incomplete assignments');
+    rows.push(...data.value);
+    const next: unknown = data['@odata.nextLink'];
+    if (next != null && (typeof next !== 'string' || !next.startsWith(`${BASE}/${app.appId}/assignments?`))) throw new Error('Invalid assignment continuation');
+    url = typeof next === 'string' && next ? next : null;
+  }
+  if (url) throw new Error('Assignments exceeded page limit');
+  const ids = [...new Set(rows.flatMap((r) => {
+    const id = (r as { target?: { groupId?: unknown } })?.target?.groupId;
+    return typeof id === 'string' && GUID.test(id) ? [id.toLowerCase()] : [];
+  }))].slice(0, 50);
+  const names: Record<string, string> = {};
+  let groupIndex = 0;
+  await Promise.all(Array.from({ length: Math.min(4, ids.length) }, async () => {
+    while (groupIndex < ids.length && !signal.aborted) {
+      const id = ids[groupIndex++];
+      try {
+        const result = await fetchImpl(`https://graph.microsoft.com/v1.0/groups/${id}?$select=id,displayName`,
+          { ...init, signal: AbortSignal.any([signal, AbortSignal.timeout(2000)]) });
+        if (!result.ok) continue;
+        const group = await result.json();
+        if (typeof group.displayName === 'string' && group.displayName.trim()) names[id] = group.displayName;
+      } catch { /* Group IDs remain usable when an optional label is unavailable. */ }
+    }
+  }));
+  return { ...app, version: typeof body.displayVersion === 'string' ? body.displayVersion : '', exists: true,
+    assignments: summarizeAssignments(rows, names), checkedAt };
+}
+
+export async function checkAppInsights(store: AppInsightsStore, options: {
+  tenantId?: string; appId?: string; actor?: string; knownChange?: boolean;
+  token?: (tenant: string) => Promise<string | null>; fetchImpl?: typeof fetch; signal?: AbortSignal;
+} = {}) {
+  const apps = store.tracked(options.tenantId, options.appId).filter((app) => !options.appId || app.appId === options.appId);
+  const signal = AbortSignal.any([AbortSignal.timeout(45000), ...(options.signal ? [options.signal] : [])]);
+  const tokens = new Map<string, Promise<string | null>>();
+  let next = 0, checked = 0, errors = 0;
+  let lastError: string | undefined;
+  await Promise.all(Array.from({ length: Math.min(4, apps.length) }, async () => {
+    while (next < apps.length && !signal.aborted) {
+      const app = apps[next++];
+      try {
+        if (!tokens.has(app.tenantId)) tokens.set(app.tenantId, (options.token ?? getServicePrincipalToken)(app.tenantId));
+        const token = await tokens.get(app.tenantId);
+        if (!token) throw new Error('No token');
+        const observation = await readObservation(app, token, AbortSignal.any([signal, AbortSignal.timeout(8000)]), options.fetchImpl);
+        store.observe(app.tenantId, observation, options.actor, options.knownChange);
+        checked++;
+      } catch (error) { errors++; lastError = error instanceof Error ? error.message.slice(0, 120) : 'App read failed'; }
+    }
+  }));
+  const skipped = apps.length - next;
+  if (skipped > 0 && !lastError) lastError = 'Timed out';
+  if (errors + skipped > 0) console.warn(`[app activity] ${errors + skipped} app(s) not checked: ${lastError}`);
+  return { checked, errors: errors + skipped, ...(lastError ? { lastError } : {}) };
+}
+
+export async function runSqliteAppInsightsCheck() {
+  const { sqliteAppInsights } = await import('@/lib/db/sqlite');
+  return checkAppInsights(sqliteAppInsights);
+}
diff --git a/lib/hrm/app-insights-store.ts b/lib/hrm/app-insights-store.ts
new file mode 100644
index 000000000..0c070ea0c
--- /dev/null
+++ b/lib/hrm/app-insights-store.ts
@@ -0,0 +1,101 @@
+/** SQLite activity store. Tenant and app are part of every key/read/write. */
+import type Database from 'better-sqlite3';
+import { assignmentsEqual, needsReview, type AppObservation, type AppSnapshot, type AppActivity } from './app-insights';
+
+export function createAppInsightsStore(getDb: () => Database.Database) {
+  function snapshot(tenant: string, appId: string): AppSnapshot | null {
+    const row = getDb().prepare('SELECT snapshot FROM hrm_app_observations WHERE tenant_id = ? AND app_id = ?').get(tenant, appId) as { snapshot: string } | undefined;
+    return row ? JSON.parse(row.snapshot) : null;
+  }
+  function event(tenant: string, winget: string, entry: Omit<AppActivity, 'id'>) {
+    const db = getDb();
+    db.prepare('INSERT INTO hrm_app_activity (tenant_id, winget_id, app_id, at, entry) VALUES (?, ?, ?, ?, ?)')
+      .run(tenant, winget, entry.appId, entry.at, JSON.stringify(entry));
+    // Bound history per app family, while keeping changes across replacement copies.
+    db.prepare(`DELETE FROM hrm_app_activity WHERE tenant_id = ? AND winget_id = ? AND id NOT IN
+      (SELECT id FROM hrm_app_activity WHERE tenant_id = ? AND winget_id = ? ORDER BY id DESC LIMIT 200)`)
+      .run(tenant, winget, tenant, winget);
+  }
+  return {
+    snapshot,
+    observe(tenant: string, observation: AppObservation, actor = 'Observed in Intune', knownChange = false) {
+      const db = getDb();
+      return db.transaction(() => {
+        const old = snapshot(tenant, observation.appId);
+        if (old && old.checkedAt > observation.checkedAt) return old;
+        const changed = old && observation.exists && !assignmentsEqual(old.assignments, observation.assignments);
+        const revision = (old?.revision ?? 0) + (changed ? 1 : 0);
+        const pending = old?.change && old.reviewedRevision < old.revision;
+        const current: AppSnapshot = { ...observation, revision, reviewedRevision: knownChange && !pending ? revision : old?.reviewedRevision ?? 0,
+          change: changed && (!knownChange || pending) ? { before: pending ? old!.change!.before : old!.assignments, after: observation.assignments, observedAt: observation.checkedAt } : old?.change ?? null };
+        if (!old || old.exists !== observation.exists || changed) {
+          const title = !observation.exists ? 'No longer in Intune' : !old ? 'First checked in Intune' : !old.exists ? 'Found in Intune again' : changed ? 'Groups or assignment settings changed' : 'Version changed in Intune';
+          const detail = changed ? `Previously: ${old!.assignments.map((a) => a.label).join('; ') || 'No groups'}\nNow: ${observation.assignments.map((a) => a.label).join('; ') || 'No groups'}` : observation.exists ? `Version ${observation.version || 'unknown'}` : 'This deployed copy was not found. It may have been replaced or deleted.';
+          event(tenant, observation.wingetId, { at: observation.checkedAt, title, detail, actor, appId: observation.appId });
+        }
+        if (old && observation.exists && old.version !== observation.version) {
+          event(tenant, observation.wingetId, { at: observation.checkedAt, title: 'Version changed in Intune',
+            detail: `Version ${old.version || 'unknown'} to ${observation.version || 'unknown'}`, actor, appId: observation.appId });
+        }
+        // Keep the last known groups/version for a missing copy.
+        if (!observation.exists && old) { current.assignments = old.assignments; current.version = old.version; }
+        db.prepare(`INSERT INTO hrm_app_observations (tenant_id, app_id, winget_id, snapshot) VALUES (?, ?, ?, ?)
+          ON CONFLICT (tenant_id, app_id) DO UPDATE SET winget_id = excluded.winget_id, snapshot = excluded.snapshot`)
+          .run(tenant, observation.appId, observation.wingetId, JSON.stringify(current));
+        return current;
+      })();
+    },
+    install(tenant: string, appId: string, at: string, counts: { installed: number; failed: number; pending: number; notApplicable: number; other: number }) {
+      const db = getDb();
+      db.transaction(() => {
+        const row = db.prepare('SELECT winget_id FROM upload_history WHERE intune_tenant_id = ? AND intune_app_id = ? ORDER BY deployed_at DESC LIMIT 1').get(tenant, appId) as { winget_id: string } | undefined;
+        if (!row) return;
+        const detail = `${counts.installed} installed, ${counts.failed} failed, ${counts.pending} pending, ${counts.notApplicable} not applicable, ${counts.other} other`;
+        const last = db.prepare("SELECT entry FROM hrm_app_activity WHERE tenant_id = ? AND app_id = ? AND json_extract(entry, '$.title') = 'Install results' ORDER BY id DESC LIMIT 1").get(tenant, appId) as { entry: string } | undefined;
+        if (last && JSON.parse(last.entry).detail === detail) return;
+        event(tenant, row.winget_id, { at, title: 'Install results', detail, actor: 'Intune report', appId });
+      })();
+    },
+    review(tenant: string, appId: string, revision: number) {
+      const db = getDb();
+      return db.transaction(() => {
+        const current = snapshot(tenant, appId);
+        if (!current || current.revision !== revision) return false;
+        current.reviewedRevision = revision;
+        db.prepare('UPDATE hrm_app_observations SET snapshot = ? WHERE tenant_id = ? AND app_id = ?').run(JSON.stringify(current), tenant, appId);
+        return true;
+      })();
+    },
+    alerts(tenant: string): AppSnapshot[] {
+      // Show only the newest deployed copy of each app family. Superseded copies
+      // are expected to lose groups/disappear and should not remain fleet warnings.
+      const rows = getDb().prepare(`SELECT o.snapshot FROM hrm_app_observations o WHERE o.tenant_id = ? AND o.app_id =
+        (SELECT h.intune_app_id FROM upload_history h WHERE h.intune_tenant_id = o.tenant_id AND h.winget_id = o.winget_id ORDER BY h.deployed_at DESC, h.id DESC LIMIT 1)`)
+        .all(tenant) as Array<{ snapshot: string }>;
+      return rows.map((r) => JSON.parse(r.snapshot) as AppSnapshot).filter(needsReview);
+    },
+    activity(tenant: string, winget: string): AppActivity[] {
+      const db = getDb();
+      const observed = (db.prepare('SELECT id, entry FROM hrm_app_activity WHERE tenant_id = ? AND winget_id = ? ORDER BY id DESC LIMIT 100').all(tenant, winget) as Array<{ id: number; entry: string }>)
+        .map((r) => ({ ...JSON.parse(r.entry), id: `observed-${r.id}` }));
+      // Existing completed deployments and failed attempts are available immediately.
+      const deployed = (db.prepare(`SELECT id, deployed_at, version, intune_app_id FROM upload_history WHERE intune_tenant_id = ? AND winget_id = ? ORDER BY deployed_at DESC LIMIT 100`).all(tenant, winget) as Array<{ id: string; deployed_at: string; version: string; intune_app_id: string }>)
+        .map((r) => ({ id: `deploy-${r.id}`, at: r.deployed_at, title: 'Deployed to Intune', detail: `Version ${r.version}`, actor: 'IntuneGet', appId: r.intune_app_id }));
+      const failed = (db.prepare(`SELECT id, COALESCE(completed_at, updated_at, created_at) AS at, version FROM packaging_jobs WHERE tenant_id = ? AND winget_id = ? AND status = 'failed' ORDER BY created_at DESC LIMIT 100`).all(tenant, winget) as Array<{ id: string; at: string; version: string }>)
+        .map((r) => ({ id: `failed-${r.id}`, at: r.at, title: 'Deployment failed', detail: `Version ${r.version}. Open Deployments for the failure details.`, actor: 'IntuneGet', appId: '' }));
+      return [...observed, ...deployed, ...failed].sort((a, b) => (Date.parse(b.at) - Date.parse(a.at)) || b.id.localeCompare(a.id)).slice(0, 100);
+    },
+    tracked(tenant?: string, appId?: string) {
+      const rows = getDb().prepare(`SELECT h.intune_tenant_id AS tenantId, h.intune_app_id AS appId, h.winget_id AS wingetId, h.display_name AS displayName, h.version
+        FROM upload_history h WHERE h.intune_tenant_id IS NOT NULL AND (? IS NULL OR h.intune_tenant_id = ?) AND (? IS NULL OR h.intune_app_id = ?) AND h.id =
+        (SELECT n.id FROM upload_history n WHERE n.intune_tenant_id = h.intune_tenant_id AND n.winget_id = h.winget_id AND (? IS NULL OR n.intune_app_id = ?) ORDER BY n.deployed_at DESC, n.id DESC LIMIT 1)`)
+        .all(tenant ?? null, tenant ?? null, appId ?? null, appId ?? null, appId ?? null, appId ?? null);
+      return rows as Array<{ tenantId: string; appId: string; wingetId: string; displayName: string; version: string }>;
+    },
+    family(tenant: string, appId: string): string | null {
+      const row = getDb().prepare('SELECT winget_id FROM upload_history WHERE intune_tenant_id = ? AND intune_app_id = ? ORDER BY deployed_at DESC LIMIT 1').get(tenant, appId) as { winget_id: string } | undefined;
+      return row?.winget_id ?? null;
+    },
+  };
+}
+export type AppInsightsStore = ReturnType<typeof createAppInsightsStore>;
diff --git a/lib/hrm/app-insights.ts b/lib/hrm/app-insights.ts
new file mode 100644
index 000000000..36d7c0840
--- /dev/null
+++ b/lib/hrm/app-insights.ts
@@ -0,0 +1,62 @@
+/** Shared, browser-safe app activity and assignment comparison types. */
+export interface AssignmentSummary { key: string; label: string; installs: boolean }
+export interface AssignmentChange { before: AssignmentSummary[]; after: AssignmentSummary[]; observedAt: string }
+export interface AppObservation {
+  appId: string; wingetId: string; displayName: string; exists: boolean; version: string;
+  assignments: AssignmentSummary[]; checkedAt: string;
+}
+export interface AppSnapshot extends AppObservation {
+  change: AssignmentChange | null; revision: number; reviewedRevision: number;
+}
+export interface AppActivity { id: string; at: string; title: string; detail: string; actor: string; appId: string }
+export interface AppInsights { supported: boolean; snapshot: AppSnapshot | null; activity: AppActivity[] }
+export const GUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
+
+// Ignore Graph's generated assignment ID and object key order. Keep filters,
+// exclusions, intent, deadlines and notifications: each changes who/how an app reaches.
+function stable(value: unknown): unknown {
+  if (Array.isArray(value)) return value.map(stable);
+  if (value && typeof value === 'object') return Object.fromEntries(Object.entries(value)
+    .filter(([key]) => !key.startsWith('@odata.')).sort(([a], [b]) => a.localeCompare(b))
+    .map(([key, v]) => [key, stable(v)]));
+  return value;
+}
+function describeSettings(value: unknown, prefix = ''): string {
+  if (!value || typeof value !== 'object') return '';
+  return Object.entries(value).filter(([key, v]) => !key.startsWith('@odata.') && v !== null && v !== undefined)
+    .map(([key, v]) => {
+      const label = key.replace(/([a-z])([A-Z])/g, '$1 $2').toLowerCase();
+      const path = prefix ? `${prefix}, ${label}` : label;
+      if (typeof v === 'object') return describeSettings(v, path);
+      const text = typeof v === 'boolean' ? (v ? 'Yes' : 'No') : String(v).replace(/([a-z])([A-Z])/g, '$1 $2');
+      return `${path}: ${text}`;
+    }).filter(Boolean).join(' · ');
+}
+export function summarizeAssignments(rows: unknown[], names: Record<string, string> = {}): AssignmentSummary[] {
+  const entries = rows.map((row) => {
+    if (!row || typeof row !== 'object') throw new Error('Invalid assignment');
+    const r = row as Record<string, unknown>;
+    const target = r.target as Record<string, unknown> | undefined;
+    if (!target || typeof target['@odata.type'] !== 'string' || typeof r.intent !== 'string') throw new Error('Incomplete assignment');
+    const type = target['@odata.type'];
+    const id = typeof target.groupId === 'string' ? target.groupId.toLowerCase() : '';
+    const name = type.includes('allDevices') ? 'All devices' : type.includes('allUsers') ? 'All users' : id ? (names[id] || `Group ${id}`) : 'Unknown target';
+    const intent = ({ required: 'Required', available: 'Available', uninstall: 'Uninstall', availableWithoutEnrollment: 'Available without enrollment' } as Record<string, string>)[r.intent] ?? r.intent;
+    const excluded = type.includes('exclusionGroup');
+    const filter = typeof target.deviceAndAppManagementAssignmentFilterId === 'string' && target.deviceAndAppManagementAssignmentFilterId
+      ? ` · ${String(target.deviceAndAppManagementAssignmentFilterType)} filter ${target.deviceAndAppManagementAssignmentFilterId}` : '';
+    const options = describeSettings(r.settings);
+    return {
+      key: JSON.stringify(stable({ intent: r.intent, target: { ...target, groupId: id || undefined, targetType: type }, settings: r.settings ?? null })),
+      label: `${excluded ? 'Excluded ' : ''}${name} · ${intent}${filter}${options ? ` · ${options}` : ''}`,
+      installs: !excluded && (r.intent === 'required' || r.intent === 'available' || r.intent === 'availableWithoutEnrollment'),
+    };
+  });
+  return [...new Map(entries.map((e) => [e.key, e])).values()].sort((a, b) => a.key.localeCompare(b.key));
+}
+export function assignmentsEqual(a: AssignmentSummary[], b: AssignmentSummary[]) {
+  return JSON.stringify(a.map((e) => e.key).sort()) === JSON.stringify(b.map((e) => e.key).sort());
+}
+export function needsReview(s: AppSnapshot) {
+  return !s.exists || !s.assignments.some((a) => a.installs) || (s.change !== null && s.reviewedRevision < s.revision);
+}
diff --git a/lib/hrm/install-error-guidance.ts b/lib/hrm/install-error-guidance.ts
