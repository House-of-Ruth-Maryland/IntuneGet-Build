new file mode 100644
index 000000000..68f1e9636
--- /dev/null
+++ b/components/hrm/AppGroupsLine.tsx
@@ -0,0 +1,59 @@
+'use client';
+
+// HRM patch 0023: which groups an Intune app is assigned to, in one line, read live from Intune.
+
+import { AppDriftWarning } from '@/components/hrm/AppInsights';
+import { AlertTriangle, Users } from 'lucide-react';
+import { useAppDetails } from '@/hooks/use-inventory';
+import { assignmentTargetLabel } from '@/lib/intune/assignment-group-names';
+import { Fragment, type ReactNode } from 'react';
+import { Term } from './Term';
+
+const INTENT: Record<string, string> = { required: 'Required', available: 'Available', uninstall: 'Uninstall', availableWithoutEnrollment: 'Available' };
+const SHOWN = 3;
+
+export function AppGroupsLine({ intuneAppId }: { intuneAppId: string | null | undefined }) {
+  if (!intuneAppId) return null;
+  // HRM patch 0036: the live line below already says "No groups" or "Not in Intune any more", so the
+  // saved-check warning shows only unreviewed group changes, not the same warning again.
+  return <div><AppDriftWarning appId={intuneAppId} changesOnly /><LiveGroupsLine intuneAppId={intuneAppId} /></div>;
+}
+
+function LiveGroupsLine({ intuneAppId }: { intuneAppId: string }) {
+  const { data, isLoading, error } = useAppDetails(intuneAppId || null);
+  if (!intuneAppId) return null;
+  if (isLoading) return <p className="text-xs text-text-muted">Checking groups…</p>;
+  if (error) {
+    const gone = error instanceof Error && /not found/i.test(error.message);
+    return gone ? (
+      <p className="flex items-center gap-1.5 text-xs text-amber-600 dark:text-amber-400">
+        <AlertTriangle className="h-3.5 w-3.5 flex-shrink-0" aria-hidden="true" />
+        Not in Intune any more. Don&apos;t update this copy.
+      </p>
+    ) : null;
+  }
+  const app = data?.app;
+  if (!app) return null;
+  const assignments = app.assignments;
+  if (!assignments?.length) {
+    return <p className="text-xs text-text-secondary">{assignments ? 'No install assignments.' : 'Assignments unavailable.'}</p>;
+  }
+  const labels = assignments.map((a): ReactNode => {
+    const label = assignmentTargetLabel(a.target, app.assignmentGroupNames, app.assignmentGroupLookupFailures);
+    // An exclusion is Excluded, not Required: Intune stores an intent for it that means nothing to staff.
+    if (label.startsWith('Excluded group: ')) return <>{label.slice('Excluded group: '.length)} · <Term term="excluded">Excluded</Term></>;
+    const intent = INTENT[a.intent] ?? a.intent;
+    // Required and Available keep Intune's names and explain themselves on hover or keyboard focus.
+    const term = intent === 'Required' ? 'required' : intent === 'Available' ? 'available' : intent === 'Uninstall' ? 'uninstall' : null;
+    return <>{label.replace(/^Group: /, '')} · {term ? <Term term={term}>{intent}</Term> : intent}</>;
+  });
+  return (
+    <p className="flex items-start gap-1.5 text-xs text-text-secondary">
+      <Users className="mt-0.5 h-3.5 w-3.5 flex-shrink-0 text-text-muted" aria-hidden="true" />
+      <span className="min-w-0 break-words">
+        {labels.slice(0, SHOWN).map((label, i) => <Fragment key={i}>{i > 0 && ', '}{label}</Fragment>)}
+        {labels.length > SHOWN && <span className="text-text-muted"> and {labels.length - SHOWN} more</span>}
+      </span>
+    </p>
+  );
+}
