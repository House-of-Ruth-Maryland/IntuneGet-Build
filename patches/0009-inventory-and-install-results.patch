+import { describe, expect, it } from 'vitest';
+import { unreachedApps } from '../home';
+const now = new Date('2026-11-10T12:00:00Z');
+const counts = (over: Record<string, unknown> = {}) => ({ intune_app_id: 'APP-1', display_name: 'Zoom Workplace', installed: 0, pending: 0, failed: 0, checked_at: '2026-11-10T08:30:00Z', ...over });
+const deployed = (at: string) => [{ intune_app_id: 'app-1', deployed_at: at }];
+describe('apps that reach no devices (HRM patch 0032)', () => {
+  it('lists an app deployed over 3 days ago with nothing installed, pending or failed', () => {
+    expect(unreachedApps([counts()], deployed('2026-11-05T12:00:00Z'), now)).toEqual([{ displayName: 'Zoom Workplace', intuneAppId: 'APP-1', deployedAt: '2026-11-05T12:00:00Z' }]);
+  });
+  it.each([
+    ['deployed recently', counts(), deployed('2026-11-08T12:00:00Z')],
+    ['installed somewhere', counts({ installed: 1 }), deployed('2026-11-01T12:00:00Z')],
+    ['pending somewhere', counts({ pending: 1 }), deployed('2026-11-01T12:00:00Z')],
+    ['failing somewhere (already its own alert)', counts({ failed: 1 }), deployed('2026-11-01T12:00:00Z')],
+    ['counts are stale', counts({ checked_at: '2026-11-07T08:30:00Z' }), deployed('2026-11-01T12:00:00Z')],
+    ['no deployment record', counts(), []],
+  ])('ignores an app when %s', (_label, install, history) => {
+    expect(unreachedApps([install], history, now)).toEqual([]);
+  });
+  it('uses the newest deployment of a copy (history is newest first)', () => {
+    expect(unreachedApps([counts()], [{ intune_app_id: 'app-1', deployed_at: '2026-11-09T12:00:00Z' }, { intune_app_id: 'app-1', deployed_at: '2026-10-01T12:00:00Z' }], now)).toEqual([]);
+  });
+});
diff --git a/lib/hrm/app-insights-check.ts b/lib/hrm/app-insights-check.ts
new file mode 100644
index 000000000..526eb10da
--- /dev/null
+++ b/lib/hrm/app-insights-check.ts
@@ -0,0 +1,83 @@
+/** Only complete, successful reads or an app's own 404 become observations. */
+import { getServicePrincipalToken } from '@/lib/intune/graph-client';
+import { GUID, summarizeAssignments, type AppObservation } from './app-insights';
+import type { AppInsightsStore } from './app-insights-store';
+const BASE = 'https://graph.microsoft.com/beta/deviceAppManagement/mobileApps';
+type Tracked = ReturnType<AppInsightsStore['tracked']>[number];
+
+export async function readObservation(app: Tracked, token: string, signal: AbortSignal, fetchImpl: typeof fetch = fetch): Promise<AppObservation> {
+  if (!GUID.test(app.appId)) throw new Error('Invalid app');
+  const checkedAt = new Date().toISOString();
+  const init = { headers: { Authorization: `Bearer ${token}` }, cache: 'no-store' as const, signal };
+  const response = await fetchImpl(`${BASE}/${app.appId}`, init);
+  if (response.status === 404) return { ...app, exists: false, assignments: [], checkedAt };
+  if (!response.ok) throw new Error(`Intune app read returned ${response.status}`);
+  const body = await response.json();
+  if (typeof body.id !== 'string' || body.id.toLowerCase() !== app.appId.toLowerCase()) throw new Error('Incomplete app');
+  const rows: unknown[] = [];
+  let url: string | null = `${BASE}/${app.appId}/assignments`;
+  for (let page = 0; url && page < 20; page++) {
+    const result: Response = await fetchImpl(url, init);
+    if (!result.ok) throw new Error(`Intune assignment read returned ${result.status}`);
+    const data: { value?: unknown[]; '@odata.nextLink'?: unknown } = await result.json();
+    if (!Array.isArray(data.value)) throw new Error('Incomplete assignments');
+    rows.push(...data.value);
+    const next: unknown = data['@odata.nextLink'];
+    if (next != null && (typeof next !== 'string' || !next.startsWith(`${BASE}/${app.appId}/assignments?`))) throw new Error('Invalid assignment continuation');
+    url = typeof next === 'string' && next ? next : null;
+  }
+  if (url) throw new Error('Assignments exceeded page limit');
+  const ids = [...new Set(rows.flatMap((r) => {
+    const id = (r as { target?: { groupId?: unknown } })?.target?.groupId;
+    return typeof id === 'string' && GUID.test(id) ? [id.toLowerCase()] : [];
+  }))].slice(0, 50);
+  const names: Record<string, string> = {};
+  let groupIndex = 0;
+  await Promise.all(Array.from({ length: Math.min(4, ids.length) }, async () => {
+    while (groupIndex < ids.length && !signal.aborted) {
+      const id = ids[groupIndex++];
+      try {
+        const result = await fetchImpl(`https://graph.microsoft.com/v1.0/groups/${id}?$select=id,displayName`,
+          { ...init, signal: AbortSignal.any([signal, AbortSignal.timeout(2000)]) });
+        if (!result.ok) continue;
+        const group = await result.json();
+        if (typeof group.displayName === 'string' && group.displayName.trim()) names[id] = group.displayName;
+      } catch { /* Group IDs remain usable when an optional label is unavailable. */ }
+    }
+  }));
+  return { ...app, version: typeof body.displayVersion === 'string' ? body.displayVersion : '', exists: true,
+    assignments: summarizeAssignments(rows, names), checkedAt };
+}
+
+export async function checkAppInsights(store: AppInsightsStore, options: {
+  tenantId?: string; appId?: string; actor?: string; knownChange?: boolean;
+  token?: (tenant: string) => Promise<string | null>; fetchImpl?: typeof fetch; signal?: AbortSignal;
+} = {}) {
+  const apps = store.tracked(options.tenantId, options.appId).filter((app) => !options.appId || app.appId === options.appId);
+  const signal = AbortSignal.any([AbortSignal.timeout(45000), ...(options.signal ? [options.signal] : [])]);
+  const tokens = new Map<string, Promise<string | null>>();
+  let next = 0, checked = 0, errors = 0;
+  let lastError: string | undefined;
+  await Promise.all(Array.from({ length: Math.min(4, apps.length) }, async () => {
+    while (next < apps.length && !signal.aborted) {
+      const app = apps[next++];
+      try {
+        if (!tokens.has(app.tenantId)) tokens.set(app.tenantId, (options.token ?? getServicePrincipalToken)(app.tenantId));
+        const token = await tokens.get(app.tenantId);
+        if (!token) throw new Error('No token');
+        const observation = await readObservation(app, token, AbortSignal.any([signal, AbortSignal.timeout(8000)]), options.fetchImpl);
+        store.observe(app.tenantId, observation, options.actor, options.knownChange);
+        checked++;
+      } catch (error) { errors++; lastError = error instanceof Error ? error.message.slice(0, 120) : 'App read failed'; }
+    }
+  }));
+  const skipped = apps.length - next;
+  if (skipped > 0 && !lastError) lastError = 'Timed out';
+  if (errors + skipped > 0) console.warn(`[app activity] ${errors + skipped} app(s) not checked: ${lastError}`);
+  return { checked, errors: errors + skipped, ...(lastError ? { lastError } : {}) };
+}
+
+export async function runSqliteAppInsightsCheck() {
+  const { sqliteAppInsights } = await import('@/lib/db/sqlite');
+  return checkAppInsights(sqliteAppInsights);
+}
diff --git a/lib/hrm/app-insights-store.ts b/lib/hrm/app-insights-store.ts
new file mode 100644
index 000000000..03cafd398
--- /dev/null
+++ b/lib/hrm/app-insights-store.ts
@@ -0,0 +1,114 @@
+/** SQLite activity store. Tenant and app are part of every key/read/write. */
+import type Database from 'better-sqlite3';
+import { assignmentsEqual, needsReview, type AppObservation, type AppSnapshot, type AppActivity } from './app-insights';
+
+export function createAppInsightsStore(getDb: () => Database.Database) {
+  function snapshot(tenant: string, appId: string): AppSnapshot | null {
+    const row = getDb().prepare('SELECT snapshot FROM hrm_app_observations WHERE tenant_id = ? AND app_id = ?').get(tenant, appId) as { snapshot: string } | undefined;
+    return row ? JSON.parse(row.snapshot) : null;
+  }
+  function event(tenant: string, winget: string, entry: Omit<AppActivity, 'id'>) {
+    const db = getDb();
+    db.prepare('INSERT INTO hrm_app_activity (tenant_id, winget_id, app_id, at, entry) VALUES (?, ?, ?, ?, ?)')
+      .run(tenant, winget, entry.appId, entry.at, JSON.stringify(entry));
+    // Bound history per app family, while keeping changes across replacement copies.
+    db.prepare(`DELETE FROM hrm_app_activity WHERE tenant_id = ? AND winget_id = ? AND id NOT IN
+      (SELECT id FROM hrm_app_activity WHERE tenant_id = ? AND winget_id = ? ORDER BY id DESC LIMIT 200)`)
+      .run(tenant, winget, tenant, winget);
+  }
+  return {
+    snapshot,
+    latestAttempt(tenant: string, appId: string, winget: string, userId: string) {
+      // Exact copy association, never display name or family alone. Archived
+      // attempts remain audit evidence, without restoring their history card.
+      const row = getDb().prepare(`SELECT id, version, status, created_at, archived_at, user_id, is_auto_update, error_code, error_message
+        FROM packaging_jobs WHERE tenant_id = ? AND lower(winget_id) = lower(?) AND
+        (lower(intune_app_id) = lower(?) OR CASE WHEN json_valid(package_config) THEN
+          lower(json_extract(package_config, '$.replacesIntuneAppId')) = lower(?) OR
+          lower(json_extract(package_config, '$.sourceIntuneAppId')) = lower(?) ELSE 0 END)
+        ORDER BY created_at DESC, id DESC LIMIT 1`).get(tenant, winget, appId, appId, appId) as {
+          id:string;version:string;status:string;created_at:string;archived_at:string|null;user_id:string;is_auto_update:number|null;error_code:string|null;error_message:string|null
+        } | undefined;
+      return row ? { id:row.id, version:row.version, status:row.status, createdAt:row.created_at, archived:Boolean(row.archived_at), owned:row.user_id===userId, automatic:Boolean(row.is_auto_update), errorCode:row.error_code, errorMessage:row.error_message } : null;
+    },
+    observe(tenant: string, observation: AppObservation, actor = 'Observed in Intune', knownChange = false) {
+      const db = getDb();
+      return db.transaction(() => {
+        const old = snapshot(tenant, observation.appId);
+        if (old && old.checkedAt > observation.checkedAt) return old;
+        const changed = old && observation.exists && !assignmentsEqual(old.assignments, observation.assignments);
+        const revision = (old?.revision ?? 0) + (changed ? 1 : 0);
+        const pending = old?.change && old.reviewedRevision < old.revision;
+        const current: AppSnapshot = { ...observation, revision, reviewedRevision: knownChange && !pending ? revision : old?.reviewedRevision ?? 0,
+          change: changed && (!knownChange || pending) ? { before: pending ? old!.change!.before : old!.assignments, after: observation.assignments, observedAt: observation.checkedAt } : old?.change ?? null };
+        if (!old || old.exists !== observation.exists || changed) {
+          const title = !observation.exists ? 'No longer in Intune' : !old ? 'First checked in Intune' : !old.exists ? 'Found in Intune again' : changed ? 'Groups or assignment settings changed' : 'Version changed in Intune';
+          const detail = changed ? `Previously: ${old!.assignments.map((a) => a.label).join('; ') || 'No groups'}\nNow: ${observation.assignments.map((a) => a.label).join('; ') || 'No groups'}` : observation.exists ? `Version ${observation.version || 'unknown'}` : 'This deployed copy was not found. It may have been replaced or deleted.';
+          event(tenant, observation.wingetId, { at: observation.checkedAt, title, detail, actor, appId: observation.appId });
+        }
+        if (old && observation.exists && old.version !== observation.version) {
+          event(tenant, observation.wingetId, { at: observation.checkedAt, title: 'Version changed in Intune',
+            detail: `Version ${old.version || 'unknown'} to ${observation.version || 'unknown'}`, actor, appId: observation.appId });
+        }
+        // Keep the last known groups/version for a missing copy.
+        if (!observation.exists && old) { current.assignments = old.assignments; current.version = old.version; }
+        db.prepare(`INSERT INTO hrm_app_observations (tenant_id, app_id, winget_id, snapshot) VALUES (?, ?, ?, ?)
+          ON CONFLICT (tenant_id, app_id) DO UPDATE SET winget_id = excluded.winget_id, snapshot = excluded.snapshot`)
+          .run(tenant, observation.appId, observation.wingetId, JSON.stringify(current));
+        return current;
+      })();
+    },
+    install(tenant: string, appId: string, at: string, counts: { installed: number; failed: number; pending: number; notApplicable: number; other: number }) {
+      const db = getDb();
+      db.transaction(() => {
+        const row = db.prepare('SELECT winget_id FROM upload_history WHERE intune_tenant_id = ? AND intune_app_id = ? ORDER BY deployed_at DESC LIMIT 1').get(tenant, appId) as { winget_id: string } | undefined;
+        if (!row) return;
+        const detail = `${counts.installed} installed, ${counts.failed} failed, ${counts.pending} pending, ${counts.notApplicable} not applicable, ${counts.other} other`;
+        const last = db.prepare("SELECT entry FROM hrm_app_activity WHERE tenant_id = ? AND app_id = ? AND json_extract(entry, '$.title') = 'Install results' ORDER BY id DESC LIMIT 1").get(tenant, appId) as { entry: string } | undefined;
+        if (last && JSON.parse(last.entry).detail === detail) return;
+        event(tenant, row.winget_id, { at, title: 'Install results', detail, actor: 'Intune report', appId });
+      })();
+    },
+    review(tenant: string, appId: string, revision: number) {
+      const db = getDb();
+      return db.transaction(() => {
+        const current = snapshot(tenant, appId);
+        if (!current || current.revision !== revision) return false;
+        current.reviewedRevision = revision;
+        db.prepare('UPDATE hrm_app_observations SET snapshot = ? WHERE tenant_id = ? AND app_id = ?').run(JSON.stringify(current), tenant, appId);
+        return true;
+      })();
+    },
+    alerts(tenant: string): AppSnapshot[] {
+      // Show only the newest deployed copy of each app family. Superseded copies
+      // are expected to lose groups/disappear and should not remain fleet warnings.
+      const rows = getDb().prepare(`SELECT o.snapshot FROM hrm_app_observations o WHERE o.tenant_id = ? AND o.app_id =
+        (SELECT h.intune_app_id FROM upload_history h WHERE h.intune_tenant_id = o.tenant_id AND h.winget_id = o.winget_id ORDER BY h.deployed_at DESC, h.id DESC LIMIT 1)`)
+        .all(tenant) as Array<{ snapshot: string }>;
+      return rows.map((r) => JSON.parse(r.snapshot) as AppSnapshot).filter(needsReview);
+    },
+    activity(tenant: string, winget: string): AppActivity[] {
+      const db = getDb();
+      const observed = (db.prepare('SELECT id, entry FROM hrm_app_activity WHERE tenant_id = ? AND winget_id = ? ORDER BY id DESC LIMIT 100').all(tenant, winget) as Array<{ id: number; entry: string }>)
+        .map((r) => ({ ...JSON.parse(r.entry), id: `observed-${r.id}` }));
+      // Existing completed deployments and failed attempts are available immediately.
+      const deployed = (db.prepare(`SELECT id, deployed_at, version, intune_app_id FROM upload_history WHERE intune_tenant_id = ? AND winget_id = ? ORDER BY deployed_at DESC LIMIT 100`).all(tenant, winget) as Array<{ id: string; deployed_at: string; version: string; intune_app_id: string }>)
+        .map((r) => ({ id: `deploy-${r.id}`, at: r.deployed_at, title: 'Deployed to Intune', detail: `Version ${r.version}`, actor: 'IntuneGet', appId: r.intune_app_id }));
+      const failed = (db.prepare(`SELECT id, COALESCE(completed_at, updated_at, created_at) AS at, version, archived_at FROM packaging_jobs WHERE tenant_id = ? AND winget_id = ? AND status = 'failed' ORDER BY created_at DESC LIMIT 100`).all(tenant, winget) as Array<{ id: string; at: string; version: string; archived_at:string|null }>)
+        .map((r) => ({ id: `failed-${r.id}`, at: r.at, title: 'Deployment failed', detail: `Version ${r.version}. ${r.archived_at ? 'Archived attempt; retained as audit evidence.' : 'Open Deployments for the failure details.'}`, actor: 'IntuneGet', appId: '' }));
+      return [...observed, ...deployed, ...failed].sort((a, b) => (Date.parse(b.at) - Date.parse(a.at)) || b.id.localeCompare(a.id)).slice(0, 100);
+    },
+    tracked(tenant?: string, appId?: string) {
+      const rows = getDb().prepare(`SELECT h.intune_tenant_id AS tenantId, h.intune_app_id AS appId, h.winget_id AS wingetId, h.display_name AS displayName, h.version
+        FROM upload_history h WHERE h.intune_tenant_id IS NOT NULL AND (? IS NULL OR h.intune_tenant_id = ?) AND (? IS NULL OR h.intune_app_id = ?) AND h.id =
+        (SELECT n.id FROM upload_history n WHERE n.intune_tenant_id = h.intune_tenant_id AND n.winget_id = h.winget_id AND (? IS NULL OR n.intune_app_id = ?) ORDER BY n.deployed_at DESC, n.id DESC LIMIT 1)`)
+        .all(tenant ?? null, tenant ?? null, appId ?? null, appId ?? null, appId ?? null, appId ?? null);
+      return rows as Array<{ tenantId: string; appId: string; wingetId: string; displayName: string; version: string }>;
+    },
+    family(tenant: string, appId: string): string | null {
+      const row = getDb().prepare('SELECT winget_id FROM upload_history WHERE intune_tenant_id = ? AND intune_app_id = ? ORDER BY deployed_at DESC LIMIT 1').get(tenant, appId) as { winget_id: string } | undefined;
+      return row?.winget_id ?? null;
+    },
+  };
+}
+export type AppInsightsStore = ReturnType<typeof createAppInsightsStore>;
diff --git a/lib/hrm/app-insights.ts b/lib/hrm/app-insights.ts
new file mode 100644
index 000000000..e0fa1c869
--- /dev/null
+++ b/lib/hrm/app-insights.ts
@@ -0,0 +1,63 @@
+/** Shared, browser-safe app activity and assignment comparison types. */
+export interface AssignmentSummary { key: string; label: string; installs: boolean }
+export interface AssignmentChange { before: AssignmentSummary[]; after: AssignmentSummary[]; observedAt: string }
+export interface AppObservation {
+  appId: string; wingetId: string; displayName: string; exists: boolean; version: string;
+  assignments: AssignmentSummary[]; checkedAt: string;
+}
+export interface AppSnapshot extends AppObservation {
+  change: AssignmentChange | null; revision: number; reviewedRevision: number;
+}
+export interface AppActivity { id: string; at: string; title: string; detail: string; actor: string; appId: string }
+export interface AppAttempt { id: string; version: string; status: string; createdAt: string; archived: boolean; owned: boolean; automatic?: boolean; errorCode: string | null; errorMessage: string | null }
+export interface AppInsights { supported: boolean; snapshot: AppSnapshot | null; activity: AppActivity[]; appId?: string; family?: string | null; latestAttempt?: AppAttempt | null }
+export const GUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
+
+// Ignore Graph's generated assignment ID and object key order. Keep filters,
+// exclusions, intent, deadlines and notifications: each changes who/how an app reaches.
+function stable(value: unknown): unknown {
+  if (Array.isArray(value)) return value.map(stable);
+  if (value && typeof value === 'object') return Object.fromEntries(Object.entries(value)
+    .filter(([key]) => !key.startsWith('@odata.')).sort(([a], [b]) => a.localeCompare(b))
+    .map(([key, v]) => [key, stable(v)]));
+  return value;
+}
+function describeSettings(value: unknown, prefix = ''): string {
+  if (!value || typeof value !== 'object') return '';
+  return Object.entries(value).filter(([key, v]) => !key.startsWith('@odata.') && v !== null && v !== undefined)
+    .map(([key, v]) => {
+      const label = key.replace(/([a-z])([A-Z])/g, '$1 $2').toLowerCase();
+      const path = prefix ? `${prefix}, ${label}` : label;
+      if (typeof v === 'object') return describeSettings(v, path);
+      const text = typeof v === 'boolean' ? (v ? 'Yes' : 'No') : String(v).replace(/([a-z])([A-Z])/g, '$1 $2');
+      return `${path}: ${text}`;
+    }).filter(Boolean).join(' · ');
+}
+export function summarizeAssignments(rows: unknown[], names: Record<string, string> = {}): AssignmentSummary[] {
+  const entries = rows.map((row) => {
+    if (!row || typeof row !== 'object') throw new Error('Invalid assignment');
+    const r = row as Record<string, unknown>;
+    const target = r.target as Record<string, unknown> | undefined;
+    if (!target || typeof target['@odata.type'] !== 'string' || typeof r.intent !== 'string') throw new Error('Incomplete assignment');
+    const type = target['@odata.type'];
+    const id = typeof target.groupId === 'string' ? target.groupId.toLowerCase() : '';
+    const name = type.includes('allDevices') ? 'All devices' : type.includes('allUsers') ? 'All users' : id ? (names[id] || `Group ${id}`) : 'Unknown target';
+    const intent = ({ required: 'Required', available: 'Available', uninstall: 'Uninstall', availableWithoutEnrollment: 'Available without enrollment' } as Record<string, string>)[r.intent] ?? r.intent;
+    const excluded = type.includes('exclusionGroup');
+    const filter = typeof target.deviceAndAppManagementAssignmentFilterId === 'string' && target.deviceAndAppManagementAssignmentFilterId
+      ? ` · ${String(target.deviceAndAppManagementAssignmentFilterType)} filter ${target.deviceAndAppManagementAssignmentFilterId}` : '';
+    const options = describeSettings(r.settings);
+    return {
+      key: JSON.stringify(stable({ intent: r.intent, target: { ...target, groupId: id || undefined, targetType: type }, settings: r.settings ?? null })),
+      label: `${name} · ${excluded ? 'Excluded' : intent}${filter}${options ? ` · ${options}` : ''}`,
+      installs: !excluded && (r.intent === 'required' || r.intent === 'available' || r.intent === 'availableWithoutEnrollment'),
+    };
+  });
+  return [...new Map(entries.map((e) => [e.key, e])).values()].sort((a, b) => a.key.localeCompare(b.key));
+}
+export function assignmentsEqual(a: AssignmentSummary[], b: AssignmentSummary[]) {
+  return JSON.stringify(a.map((e) => e.key).sort()) === JSON.stringify(b.map((e) => e.key).sort());
+}
+export function needsReview(s: AppSnapshot) {
+  return !s.exists || !s.assignments.some((a) => a.installs) || (s.change !== null && s.reviewedRevision < s.revision);
+}
diff --git a/lib/hrm/install-error-guidance.ts b/lib/hrm/install-error-guidance.ts
new file mode 100644
index 000000000..17fc3cb5b
--- /dev/null
+++ b/lib/hrm/install-error-guidance.ts
@@ -0,0 +1,40 @@
+/** Checked against Microsoft Learn. Guidance suggests checks, never a diagnosis. */
+export const WIN32_TROUBLESHOOT = 'https://learn.microsoft.com/en-us/intune/app-management/deployment/troubleshoot-win32';
+const MSI = 'https://learn.microsoft.com/en-us/windows/win32/msi/error-codes';
+export interface InstallGuidance { title: string; steps: string[]; source: string }
+export function normalizeInstallCode(input: string): string | null {
+  const value = input.trim();
+  if (!/^(?:0x[0-9a-f]{1,8}|-?\d{1,10})$/i.test(value)) return null;
+  const n = Number(value);
+  if (!Number.isInteger(n) || n < -2147483648 || n > 4294967295) return null;
+  return `0x${(n >>> 0).toString(16).toUpperCase().padStart(8, '0')}`;
+}
+const GENERIC: InstallGuidance = { title: 'Check the installation details', steps: [
+  'Open this app in Intune, then Device install status and a failed installation.',
+  'Read the reported error and collect installation logs before changing the package.',
+], source: WIN32_TROUBLESHOOT };
+const GUIDANCE: Record<string, InstallGuidance> = {
+  '0x87D1041C': { title: 'Intune could not detect the installed app', steps: [
+    'Check whether the app is present and whether it updated itself or was removed.',
+    'Compare the detection rule with the installed version, file or registry location and install context.',
+  ], source: WIN32_TROUBLESHOOT },
+  '0x80070643': { title: 'The installer reported a failure', steps: [
+    'Read the installer log to find the underlying failure; this code does not identify one cause.',
+    'Check the silent command, prerequisites and whether it runs as System or the signed-in user.',
+  ], source: MSI },
+  '0x80070652': { title: 'Another installation is running', steps: [
+    'Let the other installation finish, then check the next Intune attempt.',
+    'If it persists, check the installer logs for an installation that has stopped responding.',
+  ], source: MSI },
+  '0x80070666': { title: 'Another version is already installed', steps: [
+    'Compare the installed version with this package and check the vendor’s supported upgrade path.',
+    'Review replacement and detection settings before deploying again.',
+  ], source: MSI },
+};
+// Raw Windows Installer exit codes and HRESULT-wrapped equivalents.
+GUIDANCE['0x00000643'] = GUIDANCE['0x80070643'];
+GUIDANCE['0x00000652'] = GUIDANCE['0x80070652'];
+GUIDANCE['0x00000666'] = GUIDANCE['0x80070666'];
+export function installErrorGuidance(code: string): InstallGuidance {
+  return GUIDANCE[normalizeInstallCode(code) ?? ''] ?? GENERIC;
+}
diff --git a/lib/hrm/install-status-check.ts b/lib/hrm/install-status-check.ts
new file mode 100644
index 000000000..166adec26
--- /dev/null
+++ b/lib/hrm/install-status-check.ts
@@ -0,0 +1,57 @@
+/**
+ * HRM patch 0019: the install-status step of the 3:30 AM update check (SQLite mode).
+ */
+
+import { getDatabase, isSqliteMode } from '@/lib/db';
+import { checkInstallStatusNow, CHECK_NOW_INTERVAL_MS, marylandDay, runInstallStatusCheck, type CheckNowResult } from '@/lib/hrm/install-status';
+import type { UploadHistoryRecord } from '@/lib/db/types';
+import { notifyInstallFailures } from '@/lib/notifications/notify-install-failures';
+
+export async function runSqliteInstallCheck(now = new Date()) {
+  const { sqliteInstallStatus, sqliteWebhooks } = await import('@/lib/db/sqlite');
+  const deployments = await getDatabase().uploadHistory.currentDeployments();
+  const result = await runInstallStatusCheck(deployments, { store: sqliteInstallStatus, now });
+  const sent = await notifyInstallFailures(result.newFailures, sqliteWebhooks, now);
+  if (sent.errors.length > 0) console.warn(`[install status] ${sent.errors.length} webhook delivery error(s)`);
+  // HRM patch 0024: only a delivered alert counts; otherwise the next check tries again.
+  if (sent.webhooksSent > 0) await sqliteInstallStatus.markAlerted(result.newFailures, marylandDay(now));
+  if (result.deferred) console.warn(`[install status] ${result.deferred} app(s) left for the next check (time limit)`);
+  if (result.errors > 0) console.warn(`[install status] ${result.errors} app(s) not checked: ${result.lastError ?? 'unknown'}`);
+  return { checked: result.checked, errors: result.errors, ...(result.lastError ? { lastError: result.lastError } : {}), ...(result.deferred ? { deferred: result.deferred } : {}), alerted: sent.webhooksSent > 0 ? result.newFailures.length : 0 };
+}
+
+/** Install counts for one tenant's IntuneGet-deployed apps; empty without SQLite. */
+export async function listInstallStatus(tenantId: string) {
+  if (!isSqliteMode()) return [];
+  const { sqliteInstallStatus } = await import('@/lib/db/sqlite');
+  return sqliteInstallStatus.listForTenant(tenantId);
+}
+
+/**
+ * Patch 0054: this Intune app's IntuneGet record when it is the newest copy of its app in this tenant,
+ * otherwise null. Read from every app's newest copy, with no history window (security review S6), so
+ * an app last deployed long ago still has Check now.
+ */
+export async function newestCopyOf(tenantId: string, intuneAppId: string): Promise<UploadHistoryRecord | null> {
+  const id = intuneAppId.toLowerCase();
+  const current = await getDatabase().uploadHistory.currentDeployments(tenantId);
+  return current.find((d) => d.intune_app_id?.toLowerCase() === id) ?? null;
+}
+
+/** Whether Check now can refresh this app's install results (SQLite mode, newest IntuneGet copy). */
+export async function canCheckInstallsNow(tenantId: string, intuneAppId: string): Promise<boolean> {
+  if (!isSqliteMode()) return false;
+  const newest = await newestCopyOf(tenantId, intuneAppId).catch(() => null);
+  return newest?.intune_app_id?.toLowerCase() === intuneAppId.toLowerCase();
+}
+
+// Check now attempts per tenant and app, so a failing Intune read is not retried more than every 5 minutes.
+const attempts = new Map<string, number>();
+
+/** Patch 0054: Check now in Inventory's Install results. Never sends alerts (see checkInstallStatusNow). */
+export async function checkInstallsNow(tenantId: string, intuneAppId: string, now = new Date()): Promise<CheckNowResult> {
+  if (!isSqliteMode()) return { ok: false, reason: 'not-newest' };
+  const { sqliteInstallStatus } = await import('@/lib/db/sqlite');
+  for (const [key, at] of attempts) if (now.getTime() - at >= CHECK_NOW_INTERVAL_MS) attempts.delete(key);
+  return checkInstallStatusNow(tenantId, intuneAppId, { store: sqliteInstallStatus, now, newestCopy: newestCopyOf, attempts });
+}
diff --git a/lib/hrm/install-status.ts b/lib/hrm/install-status.ts
new file mode 100644
index 000000000..e0fca0889
--- /dev/null
+++ b/lib/hrm/install-status.ts
@@ -0,0 +1,387 @@
+/**
+ * HRM patch 0019: install results per IntuneGet-deployed app, as counts only.
+ *
+ * Intune's per-app install report (retrieveDeviceAppInstallationStatusReport; Microsoft removed getDeviceInstallStatusReport in 2026) is asked for
+ * the install state and error columns only, so device names, user names and
+ * device IDs are never fetched, stored or shown. The update check (3:30 AM and
+ * 3:30 PM) refreshes the counts; an alert goes out when an app's failed count goes up,
+ * at most once a day per app.
+ */
+
+import { setTimeout as delay } from 'node:timers/promises';
+import { acquireAppOnlyToken } from '@/lib/azure-app-credential';
+import type { UploadHistoryRecord } from '@/lib/db/types';
+
+export const INSTALL_REPORT_URL =
+  'https://graph.microsoft.com/beta/deviceManagement/reports/retrieveDeviceAppInstallationStatusReport';
+const PAGE_SIZE = 1000;
+const MAX_ROWS = 20000;
+/** Security review (November 2026): the longest one install-results run reads Intune. */
+export const INSTALL_CHECK_BUDGET_MS = 120_000;
+const TOP_ERRORS = 3;
+
+export interface InstallError {
+  code: string;
+  description: string;
+  count: number;
+}
+
+export interface InstallCounts {
+  notInstalled?: number;
+  installed: number;
+  failed: number;
+  pending: number;
+  notApplicable: number;
+  other: number;
+  topErrors: InstallError[];
+}
+
+export interface InstallStatusRecord extends InstallCounts {
+  tenant_id: string;
+  intune_app_id: string;
+  user_id: string;
+  display_name: string;
+  previous_failed: number;
+  alerted_on: string | null;
+  checked_at: string;
+}
+
+export interface InstallStatusStore {
+  lastAttempt?(tenant: string, app: string): Promise<string>;
+  markAttempt?(tenant: string, app: string, at: string): Promise<void>;
+  get(tenantId: string, intuneAppId: string): Promise<InstallStatusRecord | null>;
+  save(record: InstallStatusRecord): Promise<void>;
+  // HRM patch 0024: record that these apps' failures were reported today
+  markAlerted(records: InstallStatusRecord[], day: string): Promise<void>;
+  listForTenant(tenantId: string): Promise<InstallStatusRecord[]>;
+  removeMissing(keep: Array<{ tenantId: string; intuneAppId: string }>): Promise<void>;
+}
+
+type Bucket = 'notInstalled' | 'installed' | 'failed' | 'pending' | 'notApplicable' | 'other';
+
+/** The report gives a localized state ("Installed", "Failed", ...) next to a number; the text is used. */
+export function installBucket(state: unknown): Bucket {
+  const text = String(state ?? '')
+    .toLowerCase()
+    .replace(/[\s_]/g, '');
+  if (text.includes('fail')) return 'failed';
+  if (text.includes('notapplicable')) return 'notApplicable';
+  if (text.includes('pending')) return 'pending';
+  if (text === 'notinstalled' || text === 'uninstalled') return 'notInstalled';
+  if (text === 'installed') return 'installed';
+  return 'other';
+}
+
+interface ReportPage {
+  Schema?: Array<{ Column?: string; Name?: string }>;
+  Values?: unknown[][];
+  TotalRowCount?: number;
+}
+
+/** Counts one or more report pages. Only state and error columns are read. */
+export function countInstallReport(pages: ReportPage[]): InstallCounts {
+  const counts: InstallCounts = {
+    notInstalled: 0,
+    installed: 0,
+    failed: 0,
+    pending: 0,
+    notApplicable: 0,
+    other: 0,
+    topErrors: [],
+  };
+  const errors = new Map<string, InstallError>();
+  for (const page of pages) {
+    if (!Array.isArray(page.Schema) || !Array.isArray(page.Values)) throw new Error('Incomplete Intune install report');
+    const columns = page.Schema.map((c) => c.Column ?? c.Name ?? '');
+    const at = (name: string) => columns.indexOf(name);
+    const state = at('AppInstallState_loc') >= 0 ? at('AppInstallState_loc') : at('AppInstallState');
+    if (state < 0 || page.Values.some((row) => !Array.isArray(row) || row.length <= state || row[state] == null))
+      throw new Error('Incomplete Intune install states');
+    const code = at('HexErrorCode');
+    const detail =
+      at('AppInstallStateDetails_loc') >= 0 ? at('AppInstallStateDetails_loc') : at('AppInstallStateDetails');
+    for (const row of page.Values ?? []) {
+      const bucket = installBucket(state >= 0 ? row[state] : null);
+      counts[bucket] = (counts[bucket] ?? 0) + 1;
+      if (bucket !== 'failed') continue;
+      const hex = code >= 0 ? String(row[code] ?? '').trim() : '';
+      const key = hex || 'unknown';
+      const description = detail >= 0 ? String(row[detail] ?? '').trim() : '';
+      const entry = errors.get(key) ?? { code: hex, description, count: 0 };
+      entry.count += 1;
+      if (!entry.description && description) entry.description = description;
+      errors.set(key, entry);
+    }
+  }
+  counts.topErrors = [...errors.values()].sort((a, b) => b.count - a.count).slice(0, TOP_ERRORS);
+  return counts;
+}
+
+/** Reads every page of one app's install report. */
+export async function fetchInstallCounts(
+  accessToken: string,
+  intuneAppId: string,
+  fetchImpl: typeof fetch = fetch,
+  parentSignal?: AbortSignal
+): Promise<InstallCounts> {
+  if (!/^[0-9a-f-]{36}$/i.test(intuneAppId)) throw new Error('Invalid Intune app ID');
+  const signal = AbortSignal.any([AbortSignal.timeout(30000), ...(parentSignal ? [parentSignal] : [])]);
+  const pages: ReportPage[] = [];
+  let expectedTotal: number | undefined;
+  let seen = 0;
+  for (let skip = 0; skip < MAX_ROWS; skip += PAGE_SIZE) {
+    signal.throwIfAborted();
+    const init: RequestInit = {
+      signal,
+      method: 'POST',
+      headers: { Authorization: `Bearer ${accessToken}`, 'Content-Type': 'application/json' },
+      body: JSON.stringify({
+        filter: `(ApplicationId eq '${intuneAppId}')`,
+        // Never DeviceName, UserName, UserPrincipalName or DeviceId.
+        select: ['AppInstallState', 'AppInstallStateDetails', 'HexErrorCode'],
+        skip,
+        top: PAGE_SIZE,
+      }),
+    };
+    let response = await fetchImpl(INSTALL_REPORT_URL, init);
+    for (let retry = 0; (response.status === 429 || response.status === 503) && retry < 2; retry++) {
+      const header = response.headers.get('retry-after');
+      const seconds =
+        header && /^\d+$/.test(header)
+          ? Number(header)
+          : header
+            ? Math.max(0, (Date.parse(header) - Date.now()) / 1000)
+            : retry + 1;
+      const wait = Math.max(1000, Math.ceil(seconds * 1000));
+      if (!Number.isFinite(wait) || wait > 10000) throw new Error('Intune install report throttled; retry next check');
+      await response.body?.cancel();
+      await delay(wait, undefined, { signal });
+      response = await fetchImpl(INSTALL_REPORT_URL, init);
+    }
+    if (!response.ok) throw new Error(`Intune install report returned ${response.status}`);
+    const page = (await response.json()) as ReportPage;
+    // Validate every page before accepting any of its numbers.
+    countInstallReport([page]);
+    const rows = page.Values!.length;
+    if (
+      rows > PAGE_SIZE ||
+      (page.TotalRowCount !== undefined && (!Number.isSafeInteger(page.TotalRowCount) || page.TotalRowCount < 0))
+    )
+      throw new Error('Invalid Intune report size');
+    if (page.TotalRowCount !== undefined) {
+      if (expectedTotal !== undefined && expectedTotal !== page.TotalRowCount)
+        throw new Error('Intune report changed while reading');
+      expectedTotal = page.TotalRowCount;
+      if (expectedTotal > MAX_ROWS) throw new Error('Intune report exceeds safe read limit');
+    }
+    pages.push(page);
+    seen += rows;
+    if (expectedTotal !== undefined && seen > expectedTotal) throw new Error('Invalid Intune report count');
+    if (expectedTotal !== undefined && seen === expectedTotal) return countInstallReport(pages);
+    if (rows < PAGE_SIZE) {
+      if (expectedTotal !== undefined) throw new Error('Incomplete Intune report pages');
+      return countInstallReport(pages);
+    }
+  }
+  throw new Error('Intune report exceeds safe read limit');
+}
+
+export interface InstallCheckDeps {
+  store: InstallStatusStore;
+  token?: (tenantId: string) => Promise<string | null>;
+  fetchImpl?: typeof fetch;
+  now?: Date;
+  signal?: AbortSignal;
+  budgetMs?: number;
+}
+
+export interface InstallCheckSummary {
+  checked: number;
+  errors: number;
+  /** HRM patch 0031: a short reason for the last error (status codes only), so failures aren't silent. */
+  lastError?: string;
+  /** Apps whose failed count went up and haven't been alerted today. */
+  newFailures: InstallStatusRecord[];
+  /** Apps the run's time limit cut off; read first at the next check (not errors). */
+  deferred?: number;
+}
+
+async function appToken(tenantId: string): Promise<string | null> {
+  const result = await acquireAppOnlyToken(tenantId);
+  return result.ok ? result.accessToken : null;
+}
+
+/** The Maryland calendar day, so "once a day" matches staff's day rather than UTC's. */
+export function marylandDay(date: Date): string {
+  return new Intl.DateTimeFormat('en-CA', { timeZone: 'America/New_York' }).format(date);
+}
+
+/**
+ * The record to save for fresh counts. HRM patch 0024: previous_failed is the count last reported
+ * (lowered when failures go down), so a rise that couldn't be reported the same day is still reported
+ * the next day. alerted_on and previous_failed only move up once a webhook has accepted the alert
+ * (markAlerted). Patch 0054: Check now saves the same record, so alerts work the same either way.
+ */
+export function nextInstallRecord(
+  before: InstallStatusRecord | null,
+  counts: InstallCounts,
+  deployment: Pick<UploadHistoryRecord, 'intune_app_id' | 'user_id' | 'display_name'> & { intune_tenant_id: string | null },
+  now: Date
+): InstallStatusRecord {
+  const reported = before ? Math.min(before.previous_failed, before.failed) : 0;
+  return {
+    ...counts,
+    tenant_id: deployment.intune_tenant_id ?? '',
+    intune_app_id: deployment.intune_app_id,
+    user_id: deployment.user_id,
+    display_name: deployment.display_name,
+    previous_failed: Math.min(reported, counts.failed),
+    alerted_on: before?.alerted_on ?? null,
+    checked_at: now.toISOString(),
+  };
+}
+
+/** Patch 0054: how long Check now waits after the last check of an app (scheduled or on demand). */
+export const CHECK_NOW_INTERVAL_MS = 5 * 60 * 1000;
+
+export type CheckNowResult =
+  | { ok: true; record: InstallStatusRecord }
+  | { ok: false; reason: 'not-newest' | 'too-soon' | 'no-token' | 'intune'; retryAt?: string };
+
+/**
+ * Patch 0054: refresh one app's install counts on demand (Check now in Inventory). Read-only against
+ * Intune: the same install report the update check reads. Only the newest IntuneGet copy of an app has
+ * counts. It never sends an alert or marks one as sent: the next update check compares against the
+ * saved counts exactly as it would after its own check, so the once-a-day alert rule is unchanged.
+ * Limited to once every 5 minutes per app, counting scheduled checks and failed attempts.
+ */
+export async function checkInstallStatusNow(
+  tenantId: string,
+  intuneAppId: string,
+  deps: InstallCheckDeps & {
+    newestCopy: (tenantId: string, intuneAppId: string) => Promise<UploadHistoryRecord | null>;
+    attempts: Map<string, number>;
+  }
+): Promise<CheckNowResult> {
+  const now = deps.now ?? new Date();
+  const deployment = await deps.newestCopy(tenantId, intuneAppId);
+  if (!deployment?.intune_app_id || deployment.intune_app_id.toLowerCase() !== intuneAppId.toLowerCase()) {
+    return { ok: false, reason: 'not-newest' };
+  }
+  const key = `${tenantId}|${intuneAppId.toLowerCase()}`;
+  const before = await deps.store.get(tenantId, deployment.intune_app_id);
+  const last = Math.max(deps.attempts.get(key) ?? 0, before ? Date.parse(before.checked_at) || 0 : 0);
+  if (now.getTime() - last < CHECK_NOW_INTERVAL_MS) {
+    return { ok: false, reason: 'too-soon', retryAt: new Date(last + CHECK_NOW_INTERVAL_MS).toISOString() };
+  }
+  deps.attempts.set(key, now.getTime());
+  const token = await (deps.token ?? appToken)(tenantId).catch(() => null);
+  if (!token) return { ok: false, reason: 'no-token' };
+  let counts: InstallCounts;
+  try {
+    counts = await fetchInstallCounts(token, deployment.intune_app_id, deps.fetchImpl);
+  } catch {
+    return { ok: false, reason: 'intune' };
+  }
+  const record = nextInstallRecord(before, counts, { ...deployment, intune_tenant_id: tenantId }, now);
+  await deps.store.save(record);
+  return { ok: true, record };
+}
+
+/** Refreshes counts for the newest deployment of every IntuneGet-deployed app. */
+export async function runInstallStatusCheck(
+  deployments: UploadHistoryRecord[],
+  deps: InstallCheckDeps
+): Promise<InstallCheckSummary> {
+  const now = deps.now ?? new Date();
+  const today = marylandDay(now);
+  const getToken = deps.token ?? appToken;
+  const summary: InstallCheckSummary = { checked: 0, errors: 0, newFailures: [] };
+
+  // HRM patch 0024: the newest copy of each app only (listAll is newest first). Older copies are
+  // superseded, so their failures aren't today's problem.
+  const newest = new Map<string, UploadHistoryRecord>();
+  for (const deployment of deployments) {
+    if (!deployment.intune_tenant_id || !deployment.intune_app_id) continue;
+    const key = `${deployment.intune_tenant_id}|${deployment.winget_id}`;
+    if (!newest.has(key)) newest.set(key, deployment);
+  }
+
+  // Security review (November 2026): 3 reads at a time, a time limit for the whole run, and a saved
+  // attempt time per app so the apps not reached run first next time.
+  const signal = AbortSignal.any([AbortSignal.timeout(deps.budgetMs ?? INSTALL_CHECK_BUDGET_MS), ...(deps.signal ? [deps.signal] : [])]);
+  const tokens = new Map<string, Promise<string | null>>();
+  // Durable attempt checkpoints advance even when a read fails. Oldest/never-read apps
+  // run first next time, so a deadline cannot starve the end of the fleet.
+  const apps = await Promise.all(
+    [...newest.values()].map(async (deployment) => ({
+      deployment,
+      before: await deps.store.get(deployment.intune_tenant_id!, deployment.intune_app_id),
+      attempted: (await deps.store.lastAttempt?.(deployment.intune_tenant_id!, deployment.intune_app_id)) ?? '',
+    }))
+  );
+  apps.sort(
+    (a, b) =>
+      a.attempted.localeCompare(b.attempted) || (a.before?.checked_at ?? '').localeCompare(b.before?.checked_at ?? '')
+  );
+  let index = 0;
+  let deferred = 0;
+  await Promise.all(
+    Array.from({ length: Math.min(3, apps.length) }, async () => {
+      while (index < apps.length && !signal.aborted) {
+        const { deployment, before } = apps[index++];
+        const tenantId = deployment.intune_tenant_id!;
+        await deps.store.markAttempt?.(tenantId, deployment.intune_app_id, now.toISOString());
+        if (!tokens.has(tenantId)) tokens.set(tenantId, getToken(tenantId).catch(() => null));
+        const token = await new Promise<string | null>((resolve) => {
+          const finish = (value: string | null) => {
+            signal.removeEventListener('abort', abort);
+            resolve(value);
+          };
+          const abort = () => finish(null);
+          signal.addEventListener('abort', abort, { once: true });
+          if (signal.aborted) abort();
+          void tokens.get(tenantId)!.then(finish, () => finish(null));
+        });
+        if (!token) {
+          if (signal.aborted) {
+            deferred++;
+            continue;
+          }
+          summary.errors++;
+          summary.lastError = 'No Intune token';
+          continue;
+        }
+        let counts: InstallCounts;
+        try {
+          counts = await fetchInstallCounts(token, deployment.intune_app_id, deps.fetchImpl, signal);
+        } catch (error) {
+          if (signal.aborted) {
+            deferred++;
+            continue;
+          }
+          summary.errors++;
+          summary.lastError = error instanceof Error ? error.message.slice(0, 120) : 'Install report failed';
+          continue;
+        }
+
+        // Read again: Check now may have saved this app while the run was waiting.
+        const latest = (await deps.store.get(tenantId, deployment.intune_app_id)) ?? before;
+        const record = nextInstallRecord(latest, counts, deployment, now);
+        const alert = counts.failed > record.previous_failed && latest?.alerted_on !== today;
+        await deps.store.save(record);
+        summary.checked += 1;
+        if (alert) summary.newFailures.push(record);
+      }
+    })
+  );
+  // Apps the time limit cut off aren't failures: they are read first at the next check. Counted
+  // apart from errors, so a large fleet doesn't look like an Intune outage to the status report.
+  deferred += apps.length - index;
+  if (deferred > 0) summary.deferred = deferred;
+  // Cleanup follows a complete distinct deployment selection, never the completed subset.
+  await deps.store.removeMissing(
+    [...newest.values()].map((d) => ({ tenantId: d.intune_tenant_id!, intuneAppId: d.intune_app_id }))
+  );
+  return summary;
+}
diff --git a/lib/hrm/installer-block.ts b/lib/hrm/installer-block.ts
new file mode 100644
index 000000000..8a62a3ea4
--- /dev/null
+++ b/lib/hrm/installer-block.ts
@@ -0,0 +1,38 @@
+import type Database from 'better-sqlite3';
+
+/**
+ * HRM patch 0031: an automatic update whose installer already failed the pre-packaging check
+ * (publisher serves different bytes, version withdrawn from WinGet, manifest changed) is not tried
+ * again for the same version and installer checksum. It is tried again when the catalog offers a
+ * different version or WinGet corrects the checksum. Jobs from before this patch were recorded as
+ * WORKFLOW_DISPATCH_FAILED, so their message is matched too.
+ */
+export const INSTALLER_CHECK_CODES = ['HASH_MISMATCH', 'MANIFEST_UNAVAILABLE', 'MANIFEST_CHANGED'] as const;
+const LEGACY_MESSAGE = /serves different bytes|is no longer available from WinGet|no longer matches the trusted WinGet manifest/;
+
+/** HRM patch 0032: whether a failed job was the installer check, including jobs recorded before 0031. */
+export function isInstallerCheckFailure(code: string | null | undefined, message: string | null | undefined): boolean {
+  if ((INSTALLER_CHECK_CODES as readonly string[]).includes(code ?? '')) return true;
+  return code === 'WORKFLOW_DISPATCH_FAILED' && LEGACY_MESSAGE.test(message ?? '');
+}
+
+export function createInstallerBlockStore(getDb: () => Database.Database) {
+  return {
+    /** The failed job's code and time when this exact installer already failed its check, else null. */
+    blocked(tenant: string, winget: string, version: string, sha256: string): { code: string; at: string } | null {
+      const rows = getDb().prepare(`SELECT error_code, error_message, created_at FROM packaging_jobs
+        WHERE tenant_id = ? AND winget_id = ? COLLATE NOCASE AND version = ? AND status = 'failed'
+          AND upper(COALESCE(installer_sha256, '')) = upper(?)
+          AND error_code IN ('HASH_MISMATCH','MANIFEST_UNAVAILABLE','MANIFEST_CHANGED','WORKFLOW_DISPATCH_FAILED')
+        ORDER BY created_at DESC LIMIT 5`).all(tenant, winget, version, sha256) as Array<{ error_code: string; error_message: string | null; created_at: string }>;
+      const hit = rows.find((r) => isInstallerCheckFailure(r.error_code, r.error_message));
+      return hit ? { code: hit.error_code, at: hit.created_at } : null;
+    },
+  };
+}
+
+export async function installerBlocked(tenant: string, winget: string, version: string, sha256: string) {
+  if (process.env.DATABASE_MODE?.toLowerCase() !== 'sqlite' || !sha256) return null;
+  const { sqliteInstallerBlocks } = await import('@/lib/db/sqlite');
+  return sqliteInstallerBlocks.blocked(tenant, winget, version, sha256);
+}
diff --git a/lib/hrm/intune-app-ids.ts b/lib/hrm/intune-app-ids.ts
new file mode 100644
index 000000000..93a518ba2
--- /dev/null
+++ b/lib/hrm/intune-app-ids.ts
@@ -0,0 +1,40 @@
+/**
+ * HRM patch 0023: which Win32 apps still exist in Intune.
+ *
+ * IntuneGet keeps its own deployment history, so a copy deleted in Intune
+ * still looked like a deployed app: App updates listed it and auto-update
+ * could act on it. The update check asks Intune for the current list and
+ * skips copies that are gone. If Intune can't be asked, nothing is skipped.
+ */
+
+import { inventoryPageUrl } from '@/lib/intune/inventory-list';
+import { getServicePrincipalToken } from '@/lib/intune/graph-client';
+
+const MAX_PAGES = 50;
+
+// IDs are lower-case.
+export type ExistingAppIds = (tenantId: string) => Promise<Set<string> | null>;
+
+/** Every Win32 app ID in the tenant, or null when Intune couldn't be read completely. */
+export async function listWin32AppIds(
+  tenantId: string,
+  deps: { token?: (tenantId: string) => Promise<string | null>; fetchImpl?: typeof fetch } = {}
+): Promise<Set<string> | null> {
+  if (!tenantId) return null;
+  const token = await (deps.token ?? getServicePrincipalToken)(tenantId).catch(() => null);
+  if (!token) return null;
+  const doFetch = deps.fetchImpl ?? fetch;
+  const ids = new Set<string>();
+  let url: string | null = `${inventoryPageUrl(null)}&$select=id`;
+  for (let page = 0; url && page < MAX_PAGES; page++) {
+    const response = await doFetch(url, { headers: { Authorization: `Bearer ${token}` }, cache: 'no-store' }).catch(() => null);
+    if (!response?.ok) return null;
+    const body = (await response.json().catch(() => null)) as { value?: Array<{ id?: string }>; '@odata.nextLink'?: string } | null;
+    if (!body || !Array.isArray(body.value)) return null;
+    for (const app of body.value) if (app.id) ids.add(app.id.toLowerCase());
+    const next = body['@odata.nextLink'];
+    url = typeof next === 'string' && next.startsWith('https://graph.microsoft.com/') ? next : null;
+  }
+  // Stopped at the page limit: the list may be incomplete, so don't skip anything.
+  return url ? null : ids;
+}
