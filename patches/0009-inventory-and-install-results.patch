@@ -0,0 +1,85 @@
+'use client';
+import { useAppInsights } from '@/hooks/useAppInsights';
+import { needsReview, type AppSnapshot } from '@/lib/hrm/app-insights';
+import { intuneAppUrl, OPEN_IN_INTUNE } from '@/lib/hrm/intune-link';
+
+const date = (at: string) => new Date(at).toLocaleString('en-US', { month: 'short', day: 'numeric', year: 'numeric', hour: 'numeric', minute: '2-digit' });
+const button = 'text-xs text-accent-cyan hover:underline disabled:opacity-50';
+
+// HRM patch 0036: changesOnly leaves out "no longer in Intune" and "no groups", for screens that already
+// say so from the live Intune read, so the same warning isn't shown twice.
+const hasUnreviewedChange = (s: AppSnapshot) => s.change !== null && s.reviewedRevision < s.revision;
+
+export function AssignmentDifference({ snapshot, changesOnly = false }: { snapshot: AppSnapshot; changesOnly?: boolean }) {
+  const change = snapshot.change;
+  return <div className="space-y-2 text-sm">
+    {!changesOnly && !snapshot.exists && <p>This copy is no longer in Intune. It may have been replaced or deleted. Check before deploying again.</p>}
+    {!changesOnly && snapshot.exists && !snapshot.assignments.some((a) => a.installs) && <p>No groups receive this app for installation. Exclusions and uninstall assignments do not install it.</p>}
+    {change && snapshot.reviewedRevision < snapshot.revision && <>
+      <p>Groups or assignment settings changed since the previous check ({date(change.observedAt)}).</p>
+      <div className="grid gap-3 sm:grid-cols-2">
+        {(['before', 'after'] as const).map((key) => <div key={key}>
+          <p className="font-medium">{key === 'before' ? 'Previously' : 'Now'}</p>
+          {change[key].length === 0 ? <p className="text-text-muted">No groups</p> : <ul className="list-disc pl-4 space-y-1 break-words">{change[key].map((a) => <li key={a.key}>{a.label}</li>)}</ul>}
+        </div>)}
+      </div>
+    </>}
+  </div>;
+}
+
+export function AppDriftWarning({ appId, changesOnly = false }: { appId?: string | null; changesOnly?: boolean }) {
+  // Separate child keeps hooks unconditional when the cart has no previous copy.
+  return appId ? <DriftWarning appId={appId} changesOnly={changesOnly} /> : null;
+}
+function DriftWarning({ appId, changesOnly }: { appId: string; changesOnly: boolean }) {
+  const { data, error } = useAppInsights(appId);
+  if (error) return <p className="mt-2 text-xs text-amber-700 dark:text-amber-300">Could not check saved group changes. Review the live groups before deploying.</p>;
+  if (!data?.snapshot || !(changesOnly ? hasUnreviewedChange(data.snapshot) : needsReview(data.snapshot))) return null;
+  return <div className="mt-2 rounded-lg border border-amber-500/30 bg-amber-500/10 p-3 text-amber-700 dark:text-amber-300"><AssignmentDifference snapshot={data.snapshot} changesOnly={changesOnly} /></div>;
+}
+
+export function AppDriftPanel({ onOpen }: { onOpen: (id: string) => void }) {
+  const { data, isLoading, error, refetch, action } = useAppInsights();
+  if (data?.supported === false) return null;
+  return <section className="mb-6 rounded-xl border border-overlay/10 bg-bg-surface p-4" aria-label="Group changes to review">
+    <div className="flex items-center justify-between gap-3">
+      <h2 className="font-semibold text-text-primary">Group changes to review</h2>
+      <button className={button} disabled={action.isPending} onClick={() => action.mutate({ action: 'check' })}>{action.isPending && action.variables?.action === 'check' ? 'Checking…' : 'Check now'}</button>
+    </div>
+    <p className="mt-1 text-xs text-text-muted">Apps deployed by IntuneGet. Checked at 3:30 AM and 3:30 PM, Maryland time. Changes are observed between checks; who changed them in Intune is not known.</p>
+    {isLoading && <p className="mt-3 text-sm text-text-muted">Loading saved checks…</p>}
+    {error && <p role="alert" className="mt-3 text-sm text-status-error">{error.message} <button className={button} onClick={() => refetch()}>Try again</button></p>}
+    {action.error && <p role="alert" className="mt-3 text-sm text-status-error">{action.error.message}</p>}
+    {action.data && <p role="status" className="mt-2 text-xs text-text-secondary">{action.data.reviewed ? 'Change marked reviewed.' : `Checked ${action.data.checked ?? 0} apps.`}{action.data.errors > 0 ? ` Could not check ${action.data.errors}; their last successful checks are kept.` : ''}</p>}
+    {data && data.alerts?.length === 0 && <p className="mt-3 text-sm text-text-secondary">No saved warnings. Use Check now to get the latest groups from Intune.</p>}
+    <ul className="mt-3 space-y-3">{data?.alerts?.map((s) => <li key={s.appId} className="rounded-lg border border-amber-500/30 bg-amber-500/10 p-3 text-amber-700 dark:text-amber-300">
+      <div className="flex flex-wrap items-center justify-between gap-2 mb-2"><p className="font-medium">{s.displayName} {s.version}</p>
+        <div className="flex gap-3"><button className={button} onClick={() => onOpen(s.appId)}>{s.exists ? 'Open app' : 'Open activity'}</button>{!s.exists && <a className={button} href={intuneAppUrl(s.appId)} target="_blank" rel="noopener noreferrer">{OPEN_IN_INTUNE}</a>}</div>
+      </div>
+      <AssignmentDifference snapshot={s} />
+      <p className="mt-2 text-xs text-text-muted">Last successful check: {date(s.checkedAt)}</p>
+      {s.change && s.reviewedRevision < s.revision && <button className={`${button} mt-2`} disabled={action.isPending} onClick={() => action.mutate({ action: 'review', appId: s.appId, revision: s.revision })}>Mark reviewed</button>}
+    </li>)}</ul>
+  </section>;
+}
+
+export function AppActivityTimeline({ appId }: { appId: string }) {
+  const { data, isLoading, error, refetch } = useAppInsights(appId);
+  if (data?.supported === false) return null;
+  return <section className="border-t border-overlay/10 pt-4" aria-label="App activity">
+    <h4 className="mb-2 text-sm font-semibold text-text-secondary">App activity</h4>
+    {isLoading && <p className="text-sm text-text-muted">Loading activity…</p>}
+    {error && <p role="alert" className="text-sm text-status-error">{error.message} <button className={button} onClick={() => refetch()}>Try again</button></p>}
+    {data && <>
+      <p className="mb-3 text-xs text-text-muted">Latest 100 events across versions deployed by IntuneGet. Group and install-result changes are recorded from the first check after this feature was added.</p>
+      {data.activity.length === 0 && <p className="text-sm text-text-muted">No recorded activity for this app.</p>}
+      <ol className="space-y-3 border-l border-overlay/10 pl-4">{data.activity.map((e) => <li key={e.id} className="text-sm">
+        <p className="font-medium text-text-primary">{e.title}</p>
+        <p className="text-text-secondary break-words whitespace-pre-line">{e.detail}</p>
+        {e.appId && <a className={button} href={intuneAppUrl(e.appId)} target="_blank" rel="noopener noreferrer">{OPEN_IN_INTUNE}</a>}
+        {e.id.startsWith('failed-') && <a className={button} href="/dashboard/uploads">Open Deployments</a>}
+        <p className="mt-1 text-xs text-text-muted"><time dateTime={e.at}>{date(e.at)}</time> · {e.actor}</p>
+      </li>)}</ol>
+    </>}
+  </section>;
+}
diff --git a/components/hrm/InstallStatusBar.test.ts b/components/hrm/InstallStatusBar.test.ts
new file mode 100644
index 000000000..e02a9e073
--- /dev/null
+++ b/components/hrm/InstallStatusBar.test.ts
@@ -0,0 +1,64 @@
+// @vitest-environment happy-dom
+// HRM patch 0054: Check installs now in Inventory's Install results.
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { act, createElement } from 'react';
+import { createRoot, type Root } from 'react-dom/client';
+import { QueryClient, QueryClientProvider } from '@tanstack/react-query';
+
+vi.mock('@/hooks/useMicrosoftAuth', () => ({ useMicrosoftAuth: () => ({ getAccessToken: async () => 'token', isAuthenticated: true }) }));
+import { InstallStatusBar } from './InstallStatusBar';
+
+const A = '00000000-0000-0000-0000-00000000000a';
+const counts = { installed: 2, failed: 0, pending: 1, notApplicable: 0, other: 0, topErrors: [], checkedAt: '2026-11-11T20:00:00.000Z' };
+let root: Root;
+(globalThis as typeof globalThis & { IS_REACT_ACT_ENVIRONMENT: boolean }).IS_REACT_ACT_ENVIRONMENT = true;
+const fetchMock = vi.fn();
+const text = () => document.body.textContent ?? '';
+const button = () => [...document.querySelectorAll('button')].find((b) => b.textContent?.trim() === 'Check installs now');
+const settle = async () => { for (let i = 0; i < 5; i++) await act(async () => { await new Promise((r) => setTimeout(r, 0)); }); };
+
+async function render() {
+  const client = new QueryClient({ defaultOptions: { queries: { retry: false } } });
+  await act(async () => root.render(createElement(QueryClientProvider, { client }, createElement(InstallStatusBar, { appId: A }))));
+  await settle();
+}
+
+beforeEach(() => {
+  root = createRoot(document.body.appendChild(document.createElement('div')));
+  fetchMock.mockReset();
+  vi.stubGlobal('fetch', fetchMock);
+});
+afterEach(async () => {
+  await act(async () => root.unmount());
+  document.body.innerHTML = '';
+  vi.unstubAllGlobals();
+});
+
+describe('InstallStatusBar Check installs now', () => {
+  it('fills in results for a new copy with none yet', async () => {
+    fetchMock.mockResolvedValueOnce(Response.json({ status: null, canCheck: true }));
+    await render();
+    expect(text()).toContain('No install results for this version yet.');
+    fetchMock.mockResolvedValueOnce(Response.json({ status: counts }));
+    await act(async () => button()!.click());
+    await settle();
+    expect(fetchMock.mock.calls[1][1]).toMatchObject({ method: 'POST', body: JSON.stringify({ appId: A }) });
+    expect(text()).toContain('Install results updated.');
+    expect(text()).toContain('Installed2');
+  });
+
+  it('says when to try again after a recent check', async () => {
+    fetchMock.mockResolvedValueOnce(Response.json({ status: counts, canCheck: true }));
+    await render();
+    fetchMock.mockResolvedValueOnce(Response.json({ error: 'Install results were checked in the last 5 minutes. Try again later.', retryAt: '2026-11-11T20:05:00.000Z' }, { status: 429 }));
+    await act(async () => button()!.click());
+    await settle();
+    expect(document.querySelector('[role="alert"]')?.textContent).toMatch(/^Install results were checked in the last 5 minutes\. Try again after \d{1,2}:05 (AM|PM)\.$/);
+  });
+
+  it('has no button for older copies or outside SQLite', async () => {
+    fetchMock.mockResolvedValueOnce(Response.json({ status: counts, canCheck: false }));
+    await render();
+    expect(button()).toBeUndefined();
+  });
+});
diff --git a/components/hrm/InstallStatusBar.tsx b/components/hrm/InstallStatusBar.tsx
new file mode 100644
index 000000000..1a34e7b32
--- /dev/null
+++ b/components/hrm/InstallStatusBar.tsx
@@ -0,0 +1,101 @@
+'use client';
+
+// HRM patch 0019: install results for an IntuneGet-deployed app. Counts only, never device or user names.
+// HRM patch 0054: Check installs now refreshes this one app's results from Intune (newest copy, SQLite mode).
+
+import { installErrorGuidance } from '@/lib/hrm/install-error-guidance';
+import { ExternalLink } from 'lucide-react';
+import { useCheckInstallsNow, useInstallStatus } from '@/hooks/useInstallStatus';
+import { intuneAppUrl, OPEN_IN_INTUNE } from '@/lib/hrm/intune-link';
+
+const SEGMENTS = [
+  { key: 'installed', label: 'Installed', bar: 'bg-emerald-500', dot: 'bg-emerald-500' },
+  { key: 'failed', label: 'Failed', bar: 'bg-red-500', dot: 'bg-red-500' },
+  { key: 'pending', label: 'Pending', bar: 'bg-amber-400', dot: 'bg-amber-400' },
+  { key: 'notApplicable', label: 'Not applicable', bar: 'bg-overlay/20', dot: 'bg-overlay/30' },
+] as const;
+
+// The check's state lives in InstallStatusBar, so its result stays shown when the first results arrive.
+function CheckNow({ canCheck, check }: ReturnType<typeof useCheckInstallsNow>) {
+  if (!canCheck) return null;
+  return (
+    <div className="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs">
+      <button
+        type="button"
+        onClick={() => check.mutate()}
+        disabled={check.isPending}
+        className="rounded-md border border-overlay/10 px-2 py-1 text-accent-cyan hover:bg-overlay/5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-cyan disabled:opacity-60"
+      >
+        {check.isPending ? 'Checking…' : 'Check installs now'}
+      </button>
+      {check.isSuccess && <span role="status" className="text-text-secondary">Install results updated.</span>}
+      {check.error && <span role="alert" className="text-status-error">{check.error.message}</span>}
+    </div>
+  );
+}
+
+export function InstallStatusBar({ appId }: { appId: string }) {
+  const { data: status, isLoading, error } = useInstallStatus(appId);
+  const checkNow = useCheckInstallsNow(appId);
+  if (!status) return <div><h4 className="text-sm font-semibold text-text-secondary mb-2">Install results</h4><p className="text-sm text-text-muted" role={error ? 'alert' : undefined}>{isLoading ? 'Loading install results…' : error ? "Couldn't load install results. Close this panel and open it again." : 'No install results for this version yet.'}</p>{!isLoading && !error && <CheckNow {...checkNow} />}</div>;
+  const total = status.installed + status.failed + status.pending + status.notApplicable + status.other;
+  const checked = new Date(status.checkedAt).toLocaleString('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' });
+  // HRM patch 0036: shared helper; the ID is now URL-encoded like the other Intune links.
+  const intuneUrl = intuneAppUrl(appId);
+
+  return (
+    <div>
+      <h4 className="text-sm font-semibold text-text-secondary mb-2">Install results</h4>
+      {total === 0 ? (
+        <p className="text-sm text-text-muted">No computers have reported yet.</p>
+      ) : (
+        <>
+          <div className="flex h-2 w-full overflow-hidden rounded-full bg-overlay/5" aria-hidden="true">
+            {SEGMENTS.map((s) =>
+              status[s.key] > 0 ? <div key={s.key} className={s.bar} style={{ width: `${(status[s.key] / total) * 100}%` }} /> : null
+            )}
+          </div>
+          <ul className="mt-3 grid grid-cols-2 gap-x-4 gap-y-1 text-sm">
+            {SEGMENTS.map((s) => (
+              <li key={s.key} className="flex items-center gap-2">
+                <span className={`h-2 w-2 rounded-full ${s.dot}`} aria-hidden="true" />
+                <span className="text-text-secondary">{s.label}</span>
+                <span className={`ml-auto font-medium ${s.key === 'failed' && status.failed > 0 ? 'text-red-600 dark:text-red-400' : 'text-text-primary'}`}>
+                  {status[s.key]}
+                </span>
+              </li>
+            ))}
+          </ul>
+        </>
+      )}
+      {status.topErrors.length > 0 && (
+        <div className="mt-3">
+          <p className="text-xs font-medium text-text-secondary mb-1">Most common reasons</p>
+          <ul className="space-y-1 text-sm text-text-secondary">
+            {status.topErrors.map((e) => (
+              <li key={e.code || e.description}>
+                {e.description || 'No description from Intune'}
+                {e.code && <span className="text-text-muted"> ({e.code})</span>}
+                <span className="text-text-muted">: {e.count === 1 ? '1 computer' : `${e.count} computers`}</span>
+                <details className="mt-1 mb-3 rounded-lg border border-overlay/10 bg-bg-elevated p-2">
+                  <summary className="cursor-pointer text-accent-cyan">What to check</summary>
+                  <p className="mt-2 font-medium">{installErrorGuidance(e.code).title}</p>
+                  <ol className="mt-1 list-decimal pl-5 space-y-1">{installErrorGuidance(e.code).steps.map((step) => <li key={step}>{step}</li>)}</ol>
+                  <a className="mt-2 inline-block text-xs text-accent-cyan hover:underline" href={installErrorGuidance(e.code).source} target="_blank" rel="noopener noreferrer">Microsoft troubleshooting guidance</a>
+                </details>
+              </li>
+            ))}
+          </ul>
+        </div>
+      )}
+      <p className="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-text-muted">
+        <span>Checked {checked}. Updated at 3:30 AM and 3:30 PM, Maryland time.</span>
+        <a href={intuneUrl} target="_blank" rel="noopener noreferrer" className="inline-flex items-center gap-1 text-accent-cyan hover:underline">
+          {OPEN_IN_INTUNE} <ExternalLink className="w-3 h-3" aria-hidden="true" />
+          <span className="sr-only"> (opens in a new tab)</span>
+        </a>
+      </p>
+      <CheckNow {...checkNow} />
+    </div>
+  );
+}
