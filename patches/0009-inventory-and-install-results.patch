diff --git a/app/api/cron/intune-self-test/route.ts b/app/api/cron/intune-self-test/route.ts
new file mode 100644
index 000000000..06a5e72c5
--- /dev/null
+++ b/app/api/cron/intune-self-test/route.ts
@@ -0,0 +1,19 @@
+/** HRM patch 0032: daily read-only Intune self-test (VM timer intuneget-intune-self-test). */
+import { NextResponse } from 'next/server';
+import { isSqliteMode } from '@/lib/db';
+import { runIntuneSelfTest } from '@/lib/hrm/intune-self-test';
+
+export const maxDuration = 120;
+
+export async function GET(request: Request) {
+  const cronSecret = process.env.CRON_SECRET;
+  if (!cronSecret || request.headers.get('authorization') !== `Bearer ${cronSecret}`) {
+    return NextResponse.json({ error: 'Unauthorized' }, { status: 401 });
+  }
+  if (!isSqliteMode()) return NextResponse.json({ success: true, skipped: 'The self-test needs SQLite mode' });
+  const { sqliteAppInsights } = await import('@/lib/db/sqlite');
+  const result = await runIntuneSelfTest(sqliteAppInsights.tracked());
+  if (!result.ok) console.warn(`[intune self-test] failed: ${result.checks.filter((c) => !c.ok).map((c) => `${c.name} (${c.error})`).join(', ')}`);
+  // 200 either way: the result is the finding; the status file and watchdog read it.
+  return NextResponse.json({ success: true, ...result });
+}
