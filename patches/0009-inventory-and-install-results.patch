+import { describe, expect, it, vi } from 'vitest';
+import { listWin32AppIds } from '../intune-app-ids';
+
+const token = async () => 'token';
+const page = (ids: string[], next?: string) => Response.json({ value: ids.map((id) => ({ id })), ...(next ? { '@odata.nextLink': next } : {}) });
+
+describe('listWin32AppIds', () => {
+  it('reads every page and lower-cases the IDs', async () => {
+    const fetchImpl = vi.fn()
+      .mockResolvedValueOnce(page(['AAA'], 'https://graph.microsoft.com/beta/deviceAppManagement/mobileApps?$skiptoken=2'))
+      .mockResolvedValueOnce(page(['bbb']));
+    const ids = await listWin32AppIds('tenant-one', { token, fetchImpl: fetchImpl as unknown as typeof fetch });
