+const counts = (over: Record<string, unknown> = {}) => ({ intune_app_id: 'APP-1', display_name: 'Zoom Workplace', installed: 0, pending: 0, failed: 0, checked_at: '2026-11-10T08:30:00Z', ...over });
+const deployed = (at: string) => [{ intune_app_id: 'app-1', deployed_at: at }];
+describe('apps that reach no devices (HRM patch 0032)', () => {
+  it('lists an app deployed over 3 days ago with nothing installed, pending or failed', () => {
+    expect(unreachedApps([counts()], deployed('2026-11-05T12:00:00Z'), now)).toEqual([{ displayName: 'Zoom Workplace', intuneAppId: 'APP-1', deployedAt: '2026-11-05T12:00:00Z' }]);
