@@ -0,0 +1,293 @@
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { mkdtempSync, rmSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import type { UploadHistoryRecord } from '@/lib/db/types';
+import {
+  countInstallReport,
+  fetchInstallCounts,
+  installBucket,
+  INSTALL_REPORT_URL,
+  marylandDay,
+  runInstallStatusCheck,
+  checkInstallStatusNow,
+  CHECK_NOW_INTERVAL_MS,
+  type InstallStatusRecord,
+  type InstallStatusStore,
+} from '../install-status';
+import { buildInstallFailureData, formatInstallFailurePayload } from '@/lib/webhooks/install-failure-formatters';
+
+const APP_A = '00000000-0000-0000-0000-00000000000a';
+const APP_B = '00000000-0000-0000-0000-00000000000b';
+const SCHEMA = [
+  { Column: 'AppInstallState', PropertyType: 'Int32' },
+  { Column: 'AppInstallState_loc', PropertyType: 'String' },
+  { Column: 'AppInstallStateDetails', PropertyType: 'Int32' },
+  { Column: 'AppInstallStateDetails_loc', PropertyType: 'String' },
+  { Column: 'HexErrorCode', PropertyType: 'String' },
+];
+const row = (state: string, code = '', detail = '') => [0, state, 0, detail, code];
+const DETECTED = 'The application was not detected after installation completed successfully.';
+
+function deployment(id: string, appId: string, name: string, deployedAt: string): UploadHistoryRecord {
+  return {
+    id, packaging_job_id: null, user_id: 'user-one', winget_id: `Example.${name}`, version: '1.0', display_name: name,
+    publisher: null, intune_app_id: appId, intune_app_url: null, intune_tenant_id: 'tenant-one', app_source: null, deployed_at: deployedAt,
+  };
+}
+
+function memoryStore(): InstallStatusStore & { rows: Map<string, InstallStatusRecord> } {
+  const rows = new Map<string, InstallStatusRecord>();
+  return {
+    rows,
+    async get(t, a) { return rows.get(`${t}|${a}`) ?? null; },
+    async save(r) { rows.set(`${r.tenant_id}|${r.intune_app_id}`, { ...r }); },
+    async markAlerted(records, day) {
+      for (const r of records) { const row = rows.get(`${r.tenant_id}|${r.intune_app_id}`)!; row.previous_failed = row.failed; row.alerted_on = day; }
+    },
+    async listForTenant(t) { return [...rows.values()].filter((r) => r.tenant_id === t); },
+    async removeMissing(keep) {
+      const wanted = new Set(keep.map((k) => `${k.tenantId}|${k.intuneAppId}`));
+      for (const key of rows.keys()) if (!wanted.has(key)) rows.delete(key);
+    },
+  };
+}
+
+function reportFetch(byApp: Record<string, unknown[][]>) {
+  return vi.fn(async (_url: string | URL | Request, init?: RequestInit) => {
+    const body = JSON.parse(String(init?.body));
+    const id = String(body.filter).match(/'([^']+)'/)![1];
+    return Response.json({ Schema: SCHEMA, Values: byApp[id] ?? [], TotalRowCount: (byApp[id] ?? []).length });
+  });
+}
+
+describe('install report counting', () => {
+  it('sorts localized states into buckets', () => {
+    expect(installBucket('Installed')).toBe('installed');
+    expect(installBucket('Failed')).toBe('failed');
+    expect(installBucket('Uninstall failed')).toBe('failed');
+    expect(installBucket('Install pending')).toBe('pending');
+    expect(installBucket('Not applicable')).toBe('notApplicable');
+    expect(installBucket('Not installed')).toBe('other');
+    expect(installBucket(null)).toBe('other');
+  });
+
+  it('counts states and keeps the three most common failure reasons', () => {
+    const counts = countInstallReport([{
+      Schema: SCHEMA,
+      Values: [
+        row('Installed'), row('Installed'), row('Install pending'), row('Not applicable'),
+        row('Failed', '0x87D1041C', DETECTED), row('Failed', '0x87D1041C', DETECTED), row('Failed', '0x80070005', 'Access denied.'),
+        row('Failed', '0x1', 'One'), row('Failed', '0x2', 'Two'),
+      ],
+    }]);
+    expect(counts).toMatchObject({ installed: 2, failed: 5, pending: 1, notApplicable: 1, other: 0 });
+    expect(counts.topErrors).toHaveLength(3);
+    expect(counts.topErrors[0]).toEqual({ code: '0x87D1041C', description: DETECTED, count: 2 });
+  });
+
+  it('asks Intune for state and error columns only, never device or user names', async () => {
+    const fetchMock = reportFetch({ [APP_A]: [row('Installed')] });
+    await fetchInstallCounts('token', APP_A, fetchMock as unknown as typeof fetch);
+    const [url, init] = fetchMock.mock.calls[0];
+    expect(url).toBe(INSTALL_REPORT_URL);
+    // HRM patch 0031: Microsoft removed getDeviceInstallStatusReport (400 "Resource not found for the segment").
+    expect(url).toBe('https://graph.microsoft.com/beta/deviceManagement/reports/retrieveDeviceAppInstallationStatusReport');
+    const body = JSON.parse(String(init?.body));
+    expect(body.select).toEqual(['AppInstallState', 'AppInstallStateDetails', 'HexErrorCode']);
+    expect(JSON.stringify(body)).not.toMatch(/DeviceName|UserName|UserPrincipalName|DeviceId/);
+    expect(body.filter).toBe(`(ApplicationId eq '${APP_A}')`);
+  });
+
+  it('pages through large reports', async () => {
+    const page = Array.from({ length: 1000 }, () => row('Installed'));
+    const fetchMock = vi.fn(async (_u: unknown, init?: RequestInit) => {
+      const { skip } = JSON.parse(String(init?.body));
+      return Response.json({ Schema: SCHEMA, Values: skip === 0 ? page : [row('Failed', '0x1')], TotalRowCount: 1001 });
+    });
+    const counts = await fetchInstallCounts('token', APP_A, fetchMock as unknown as typeof fetch);
+    expect(fetchMock).toHaveBeenCalledTimes(2);
+    expect(counts).toMatchObject({ installed: 1000, failed: 1 });
+  });
+
+  it('refuses an app ID that could change the filter', async () => {
+    await expect(fetchInstallCounts('token', "x') or (1 eq 1", vi.fn() as unknown as typeof fetch)).rejects.toThrow('Invalid');
+  });
+});
+
+describe('nightly install status check', () => {
+  const deployments = [
+    deployment('h3', APP_A, 'Example Reader', '2026-11-01T10:00:00Z'),
+    deployment('h2', APP_A, 'Example Reader', '2026-10-01T10:00:00Z'),
+    deployment('h1', APP_B, 'Example Zip', '2026-10-01T10:00:00Z'),
+  ];
+  const token = async () => 'token';
+
+  it('checks each app once, by its newest deployment, and alerts when failures go up', async () => {
+    const store = memoryStore();
+    const fetchImpl = reportFetch({ [APP_A]: [row('Failed', '0x1', 'One'), row('Installed')], [APP_B]: [row('Installed')] }) as unknown as typeof fetch;
+    const result = await runInstallStatusCheck(deployments, { store, token, fetchImpl, now: new Date('2026-11-02T08:30:00Z') });
+    expect(result.checked).toBe(2);
+    expect(result.newFailures.map((r) => r.display_name)).toEqual(['Example Reader']);
+    expect(store.rows.get(`tenant-one|${APP_A}`)).toMatchObject({ failed: 1, previous_failed: 0, alerted_on: null });
+    await store.markAlerted(result.newFailures, '2026-11-02');
+    expect(store.rows.get(`tenant-one|${APP_A}`)).toMatchObject({ failed: 1, previous_failed: 1, alerted_on: '2026-11-02' });
+  });
+
+  it('alerts at most once a day, and reports a rise from later that day on the next day', async () => {
+    const store = memoryStore();
+    const fails = (n: number) => reportFetch({ [APP_A]: Array.from({ length: n }, () => row('Failed')) }) as unknown as typeof fetch;
+    const only = [deployments[0]];
+    const run = async (n: number, at: string, delivered = true) => {
+      const r = await runInstallStatusCheck(only, { store, token, fetchImpl: fails(n), now: new Date(at) });
+      if (delivered && r.newFailures.length) await store.markAlerted(r.newFailures, at.slice(0, 10));
+      return r.newFailures.length;
+    };
+    expect(await run(5, '2026-11-02T12:00:00Z')).toBe(1);
+    expect(await run(8, '2026-11-02T19:30:00Z')).toBe(0);
+    expect(await run(8, '2026-11-03T12:00:00Z')).toBe(1);
+    expect(await run(8, '2026-11-04T12:00:00Z')).toBe(0);
+  });
+
+  it('tries again when no webhook accepted the alert', async () => {
+    const store = memoryStore();
+    const fetchImpl = reportFetch({ [APP_A]: [row('Failed')] }) as unknown as typeof fetch;
+    const only = [deployments[0]];
+    expect((await runInstallStatusCheck(only, { store, token, fetchImpl, now: new Date('2026-11-02T12:00:00Z') })).newFailures).toHaveLength(1);
+    expect((await runInstallStatusCheck(only, { store, token, fetchImpl, now: new Date('2026-11-02T19:30:00Z') })).newFailures).toHaveLength(1);
+  });
+
+  it('alerts again after failures fall and then rise', async () => {
+    const store = memoryStore();
+    const fails = (n: number) => reportFetch({ [APP_A]: Array.from({ length: n }, () => row('Failed')) }) as unknown as typeof fetch;
