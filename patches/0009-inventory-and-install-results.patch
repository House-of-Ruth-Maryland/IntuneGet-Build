@@ -0,0 +1,40 @@
+/** Checked against Microsoft Learn. Guidance suggests checks, never a diagnosis. */
+export const WIN32_TROUBLESHOOT = 'https://learn.microsoft.com/en-us/intune/app-management/deployment/troubleshoot-win32';
+const MSI = 'https://learn.microsoft.com/en-us/windows/win32/msi/error-codes';
+export interface InstallGuidance { title: string; steps: string[]; source: string }
+export function normalizeInstallCode(input: string): string | null {
+  const value = input.trim();
+  if (!/^(?:0x[0-9a-f]{1,8}|-?\d{1,10})$/i.test(value)) return null;
+  const n = Number(value);
+  if (!Number.isInteger(n) || n < -2147483648 || n > 4294967295) return null;
+  return `0x${(n >>> 0).toString(16).toUpperCase().padStart(8, '0')}`;
+}
+const GENERIC: InstallGuidance = { title: 'Check the installation details', steps: [
+  'Open this app in Intune, then Device install status and a failed installation.',
+  'Read the reported error and collect installation logs before changing the package.',
+], source: WIN32_TROUBLESHOOT };
+const GUIDANCE: Record<string, InstallGuidance> = {
+  '0x87D1041C': { title: 'Intune could not detect the installed app', steps: [
+    'Check whether the app is present and whether it updated itself or was removed.',
+    'Compare the detection rule with the installed version, file or registry location and install context.',
+  ], source: WIN32_TROUBLESHOOT },
+  '0x80070643': { title: 'The installer reported a failure', steps: [
+    'Read the installer log to find the underlying failure; this code does not identify one cause.',
+    'Check the silent command, prerequisites and whether it runs as System or the signed-in user.',
+  ], source: MSI },
+  '0x80070652': { title: 'Another installation is running', steps: [
+    'Let the other installation finish, then check the next Intune attempt.',
+    'If it persists, check the installer logs for an installation that has stopped responding.',
+  ], source: MSI },
+  '0x80070666': { title: 'Another version is already installed', steps: [
+    'Compare the installed version with this package and check the vendor’s supported upgrade path.',
+    'Review replacement and detection settings before deploying again.',
+  ], source: MSI },
+};
+// Raw Windows Installer exit codes and HRESULT-wrapped equivalents.
+GUIDANCE['0x00000643'] = GUIDANCE['0x80070643'];
+GUIDANCE['0x00000652'] = GUIDANCE['0x80070652'];
+GUIDANCE['0x00000666'] = GUIDANCE['0x80070666'];
+export function installErrorGuidance(code: string): InstallGuidance {
+  return GUIDANCE[normalizeInstallCode(code) ?? ''] ?? GENERIC;
+}
diff --git a/lib/hrm/install-status-check.ts b/lib/hrm/install-status-check.ts
new file mode 100644
index 000000000..f58e7f4dd
--- /dev/null
+++ b/lib/hrm/install-status-check.ts
@@ -0,0 +1,55 @@
+/**
+ * HRM patch 0019: the install-status step of the 3:30 AM update check (SQLite mode).
+ */
+
+import { getDatabase, isSqliteMode } from '@/lib/db';
+import { checkInstallStatusNow, CHECK_NOW_INTERVAL_MS, marylandDay, runInstallStatusCheck, type CheckNowResult } from '@/lib/hrm/install-status';
+import type { UploadHistoryRecord } from '@/lib/db/types';
+import { notifyInstallFailures } from '@/lib/notifications/notify-install-failures';
+
+export async function runSqliteInstallCheck(now = new Date()) {
+  const { sqliteInstallStatus, sqliteWebhooks } = await import('@/lib/db/sqlite');
+  const deployments = await getDatabase().uploadHistory.listAll(2000);
+  const result = await runInstallStatusCheck(deployments, { store: sqliteInstallStatus, now });
+  const sent = await notifyInstallFailures(result.newFailures, sqliteWebhooks, now);
+  if (sent.errors.length > 0) console.warn(`[install status] ${sent.errors.length} webhook delivery error(s)`);
+  // HRM patch 0024: only a delivered alert counts; otherwise the next check tries again.
+  if (sent.webhooksSent > 0) await sqliteInstallStatus.markAlerted(result.newFailures, marylandDay(now));
+  if (result.errors > 0) console.warn(`[install status] ${result.errors} app(s) not checked: ${result.lastError ?? 'unknown'}`);
+  return { checked: result.checked, errors: result.errors, ...(result.lastError ? { lastError: result.lastError } : {}), alerted: sent.webhooksSent > 0 ? result.newFailures.length : 0 };
+}
+
+/** Install counts for one tenant's IntuneGet-deployed apps; empty without SQLite. */
+export async function listInstallStatus(tenantId: string) {
+  if (!isSqliteMode()) return [];
+  const { sqliteInstallStatus } = await import('@/lib/db/sqlite');
+  return sqliteInstallStatus.listForTenant(tenantId);
+}
+
+/** Patch 0054: the newest IntuneGet copy of the app this Intune app is a copy of, in this tenant. */
+export async function newestCopyOf(tenantId: string, intuneAppId: string): Promise<UploadHistoryRecord | null> {
+  const db = getDatabase();
+  const id = intuneAppId.toLowerCase();
+  const copy = (await db.uploadHistory.listAll(2000))
+    .find((d) => d.intune_tenant_id === tenantId && d.intune_app_id?.toLowerCase() === id);
+  if (!copy) return null;
+  return db.uploadHistory.getLatestInTenant(tenantId, copy.winget_id);
+}
+
+/** Whether Check now can refresh this app's install results (SQLite mode, newest IntuneGet copy). */
+export async function canCheckInstallsNow(tenantId: string, intuneAppId: string): Promise<boolean> {
+  if (!isSqliteMode()) return false;
+  const newest = await newestCopyOf(tenantId, intuneAppId).catch(() => null);
+  return newest?.intune_app_id?.toLowerCase() === intuneAppId.toLowerCase();
+}
+
+// Check now attempts per tenant and app, so a failing Intune read is not retried more than every 5 minutes.
+const attempts = new Map<string, number>();
+
+/** Patch 0054: Check now in Inventory's Install results. Never sends alerts (see checkInstallStatusNow). */
+export async function checkInstallsNow(tenantId: string, intuneAppId: string, now = new Date()): Promise<CheckNowResult> {
+  if (!isSqliteMode()) return { ok: false, reason: 'not-newest' };
+  const { sqliteInstallStatus } = await import('@/lib/db/sqlite');
+  for (const [key, at] of attempts) if (now.getTime() - at >= CHECK_NOW_INTERVAL_MS) attempts.delete(key);
+  return checkInstallStatusNow(tenantId, intuneAppId, { store: sqliteInstallStatus, now, newestCopy: newestCopyOf, attempts });
+}
diff --git a/lib/hrm/install-status.ts b/lib/hrm/install-status.ts
new file mode 100644
index 000000000..afe19aa54
--- /dev/null
+++ b/lib/hrm/install-status.ts
@@ -0,0 +1,273 @@
+/**
+ * HRM patch 0019: install results per IntuneGet-deployed app, as counts only.
+ *
+ * Intune's per-app install report (retrieveDeviceAppInstallationStatusReport; Microsoft removed getDeviceInstallStatusReport in 2026) is asked for
+ * the install state and error columns only, so device names, user names and
+ * device IDs are never fetched, stored or shown. The update check (3:30 AM and
+ * 3:30 PM) refreshes the counts; an alert goes out when an app's failed count goes up,
+ * at most once a day per app.
+ */
+
+import { acquireAppOnlyToken } from '@/lib/azure-app-credential';
+import type { UploadHistoryRecord } from '@/lib/db/types';
+
+export const INSTALL_REPORT_URL = 'https://graph.microsoft.com/beta/deviceManagement/reports/retrieveDeviceAppInstallationStatusReport';
+const PAGE_SIZE = 1000;
+const MAX_ROWS = 20000;
+const TOP_ERRORS = 3;
+
+export interface InstallError {
+  code: string;
+  description: string;
+  count: number;
+}
+
+export interface InstallCounts {
+  installed: number;
+  failed: number;
+  pending: number;
+  notApplicable: number;
+  other: number;
+  topErrors: InstallError[];
+}
+
+export interface InstallStatusRecord extends InstallCounts {
+  tenant_id: string;
+  intune_app_id: string;
+  user_id: string;
+  display_name: string;
+  previous_failed: number;
+  alerted_on: string | null;
+  checked_at: string;
+}
+
+export interface InstallStatusStore {
+  get(tenantId: string, intuneAppId: string): Promise<InstallStatusRecord | null>;
+  save(record: InstallStatusRecord): Promise<void>;
+  // HRM patch 0024: record that these apps' failures were reported today
+  markAlerted(records: InstallStatusRecord[], day: string): Promise<void>;
+  listForTenant(tenantId: string): Promise<InstallStatusRecord[]>;
+  removeMissing(keep: Array<{ tenantId: string; intuneAppId: string }>): Promise<void>;
+}
+
+type Bucket = 'installed' | 'failed' | 'pending' | 'notApplicable' | 'other';
+
+/** The report gives a localized state ("Installed", "Failed", ...) next to a number; the text is used. */
+export function installBucket(state: unknown): Bucket {
+  const text = String(state ?? '').toLowerCase().replace(/[\s_]/g, '');
+  if (text.includes('fail')) return 'failed';
+  if (text.includes('notapplicable')) return 'notApplicable';
+  if (text.includes('pending')) return 'pending';
+  if (text === 'installed') return 'installed';
+  return 'other';
+}
+
+interface ReportPage {
+  Schema?: Array<{ Column?: string; Name?: string }>;
+  Values?: unknown[][];
+  TotalRowCount?: number;
+}
+
+/** Counts one or more report pages. Only state and error columns are read. */
+export function countInstallReport(pages: ReportPage[]): InstallCounts {
+  const counts: InstallCounts = { installed: 0, failed: 0, pending: 0, notApplicable: 0, other: 0, topErrors: [] };
+  const errors = new Map<string, InstallError>();
+  for (const page of pages) {
+    const columns = (page.Schema ?? []).map((c) => c.Column ?? c.Name ?? '');
+    const at = (name: string) => columns.indexOf(name);
+    const state = at('AppInstallState_loc') >= 0 ? at('AppInstallState_loc') : at('AppInstallState');
+    const code = at('HexErrorCode');
+    const detail = at('AppInstallStateDetails_loc') >= 0 ? at('AppInstallStateDetails_loc') : at('AppInstallStateDetails');
+    for (const row of page.Values ?? []) {
+      const bucket = installBucket(state >= 0 ? row[state] : null);
+      counts[bucket] += 1;
+      if (bucket !== 'failed') continue;
+      const hex = code >= 0 ? String(row[code] ?? '').trim() : '';
+      const key = hex || 'unknown';
+      const description = detail >= 0 ? String(row[detail] ?? '').trim() : '';
+      const entry = errors.get(key) ?? { code: hex, description, count: 0 };
+      entry.count += 1;
+      if (!entry.description && description) entry.description = description;
+      errors.set(key, entry);
+    }
+  }
+  counts.topErrors = [...errors.values()].sort((a, b) => b.count - a.count).slice(0, TOP_ERRORS);
+  return counts;
+}
+
+/** Reads every page of one app's install report. */
+export async function fetchInstallCounts(
+  accessToken: string,
+  intuneAppId: string,
+  fetchImpl: typeof fetch = fetch
+): Promise<InstallCounts> {
+  if (!/^[0-9a-f-]{36}$/i.test(intuneAppId)) throw new Error('Invalid Intune app ID');
+  const pages: ReportPage[] = [];
+  for (let skip = 0; skip < MAX_ROWS; skip += PAGE_SIZE) {
+    const response = await fetchImpl(INSTALL_REPORT_URL, {
+      method: 'POST',
+      headers: { Authorization: `Bearer ${accessToken}`, 'Content-Type': 'application/json' },
+      body: JSON.stringify({
+        filter: `(ApplicationId eq '${intuneAppId}')`,
+        // Never DeviceName, UserName, UserPrincipalName or DeviceId.
+        select: ['AppInstallState', 'AppInstallStateDetails', 'HexErrorCode'],
+        skip,
+        top: PAGE_SIZE,
+      }),
+    });
+    if (!response.ok) throw new Error(`Intune install report returned ${response.status}`);
+    const page = (await response.json()) as ReportPage;
+    pages.push(page);
+    const rows = page.Values?.length ?? 0;
+    if (rows < PAGE_SIZE || (page.TotalRowCount !== undefined && skip + rows >= page.TotalRowCount)) break;
+  }
+  return countInstallReport(pages);
+}
+
+export interface InstallCheckDeps {
+  store: InstallStatusStore;
+  token?: (tenantId: string) => Promise<string | null>;
+  fetchImpl?: typeof fetch;
+  now?: Date;
+}
+
+export interface InstallCheckSummary {
+  checked: number;
+  errors: number;
+  /** HRM patch 0031: a short reason for the last error (status codes only), so failures aren't silent. */
+  lastError?: string;
+  /** Apps whose failed count went up and haven't been alerted today. */
+  newFailures: InstallStatusRecord[];
+}
+
+async function appToken(tenantId: string): Promise<string | null> {
+  const result = await acquireAppOnlyToken(tenantId);
+  return result.ok ? result.accessToken : null;
+}
+
+/** The Maryland calendar day, so "once a day" matches staff's day rather than UTC's. */
+export function marylandDay(date: Date): string {
+  return new Intl.DateTimeFormat('en-CA', { timeZone: 'America/New_York' }).format(date);
+}
+
+/**
+ * The record to save for fresh counts. HRM patch 0024: previous_failed is the count last reported
+ * (lowered when failures go down), so a rise that couldn't be reported the same day is still reported
+ * the next day. alerted_on and previous_failed only move up once a webhook has accepted the alert
+ * (markAlerted). Patch 0054: Check now saves the same record, so alerts work the same either way.
+ */
+export function nextInstallRecord(
+  before: InstallStatusRecord | null,
+  counts: InstallCounts,
+  deployment: Pick<UploadHistoryRecord, 'intune_app_id' | 'user_id' | 'display_name'> & { intune_tenant_id: string | null },
+  now: Date
+): InstallStatusRecord {
+  const reported = before ? Math.min(before.previous_failed, before.failed) : 0;
+  return {
+    ...counts,
+    tenant_id: deployment.intune_tenant_id ?? '',
+    intune_app_id: deployment.intune_app_id,
+    user_id: deployment.user_id,
+    display_name: deployment.display_name,
+    previous_failed: Math.min(reported, counts.failed),
+    alerted_on: before?.alerted_on ?? null,
+    checked_at: now.toISOString(),
+  };
+}
+
+/** Patch 0054: how long Check now waits after the last check of an app (scheduled or on demand). */
+export const CHECK_NOW_INTERVAL_MS = 5 * 60 * 1000;
+
+export type CheckNowResult =
+  | { ok: true; record: InstallStatusRecord }
+  | { ok: false; reason: 'not-newest' | 'too-soon' | 'no-token' | 'intune'; retryAt?: string };
+
+/**
+ * Patch 0054: refresh one app's install counts on demand (Check now in Inventory). Read-only against
+ * Intune: the same install report the update check reads. Only the newest IntuneGet copy of an app has
+ * counts. It never sends an alert or marks one as sent: the next update check compares against the
+ * saved counts exactly as it would after its own check, so the once-a-day alert rule is unchanged.
+ * Limited to once every 5 minutes per app, counting scheduled checks and failed attempts.
+ */
+export async function checkInstallStatusNow(
+  tenantId: string,
+  intuneAppId: string,
+  deps: InstallCheckDeps & {
+    newestCopy: (tenantId: string, intuneAppId: string) => Promise<UploadHistoryRecord | null>;
+    attempts: Map<string, number>;
+  }
+): Promise<CheckNowResult> {
+  const now = deps.now ?? new Date();
+  const deployment = await deps.newestCopy(tenantId, intuneAppId);
+  if (!deployment?.intune_app_id || deployment.intune_app_id.toLowerCase() !== intuneAppId.toLowerCase()) {
+    return { ok: false, reason: 'not-newest' };
+  }
+  const key = `${tenantId}|${intuneAppId.toLowerCase()}`;
+  const before = await deps.store.get(tenantId, deployment.intune_app_id);
+  const last = Math.max(deps.attempts.get(key) ?? 0, before ? Date.parse(before.checked_at) || 0 : 0);
+  if (now.getTime() - last < CHECK_NOW_INTERVAL_MS) {
+    return { ok: false, reason: 'too-soon', retryAt: new Date(last + CHECK_NOW_INTERVAL_MS).toISOString() };
+  }
+  deps.attempts.set(key, now.getTime());
+  const token = await (deps.token ?? appToken)(tenantId).catch(() => null);
+  if (!token) return { ok: false, reason: 'no-token' };
+  let counts: InstallCounts;
+  try {
+    counts = await fetchInstallCounts(token, deployment.intune_app_id, deps.fetchImpl);
+  } catch {
+    return { ok: false, reason: 'intune' };
+  }
+  const record = nextInstallRecord(before, counts, { ...deployment, intune_tenant_id: tenantId }, now);
+  await deps.store.save(record);
+  return { ok: true, record };
+}
+
+/** Refreshes counts for the newest deployment of every IntuneGet-deployed app. */
+export async function runInstallStatusCheck(
+  deployments: UploadHistoryRecord[],
+  deps: InstallCheckDeps
+): Promise<InstallCheckSummary> {
+  const now = deps.now ?? new Date();
+  const today = marylandDay(now);
+  const getToken = deps.token ?? appToken;
+  const summary: InstallCheckSummary = { checked: 0, errors: 0, newFailures: [] };
+
+  // HRM patch 0024: the newest copy of each app only (listAll is newest first). Older copies are
+  // superseded, so their failures aren't today's problem.
+  const newest = new Map<string, UploadHistoryRecord>();
+  for (const deployment of deployments) {
+    if (!deployment.intune_tenant_id || !deployment.intune_app_id) continue;
+    const key = `${deployment.intune_tenant_id}|${deployment.winget_id}`;
+    if (!newest.has(key)) newest.set(key, deployment);
+  }
+
+  const tokens = new Map<string, string | null>();
+  const keep: Array<{ tenantId: string; intuneAppId: string }> = [];
+  for (const deployment of newest.values()) {
+    const tenantId = deployment.intune_tenant_id!;
+    keep.push({ tenantId, intuneAppId: deployment.intune_app_id });
+    if (!tokens.has(tenantId)) tokens.set(tenantId, await getToken(tenantId).catch(() => null));
+    const token = tokens.get(tenantId);
+    if (!token) {
+      summary.errors += 1;
+      summary.lastError = 'No Intune token';
+      continue;
+    }
+    let counts: InstallCounts;
+    try {
+      counts = await fetchInstallCounts(token, deployment.intune_app_id, deps.fetchImpl);
+    } catch (error) {
+      summary.errors += 1;
+      summary.lastError = error instanceof Error ? error.message.slice(0, 120) : 'Install report failed';
+      continue;
+    }
+    const before = await deps.store.get(tenantId, deployment.intune_app_id);
+    const record = nextInstallRecord(before, counts, deployment, now);
+    const alert = counts.failed > record.previous_failed && before?.alerted_on !== today;
+    await deps.store.save(record);
+    summary.checked += 1;
+    if (alert) summary.newFailures.push(record);
+  }
+  await deps.store.removeMissing(keep);
+  return summary;
+}
diff --git a/lib/hrm/installer-block.ts b/lib/hrm/installer-block.ts
new file mode 100644
index 000000000..8a62a3ea4
--- /dev/null
+++ b/lib/hrm/installer-block.ts
@@ -0,0 +1,38 @@
+import type Database from 'better-sqlite3';
+
+/**
+ * HRM patch 0031: an automatic update whose installer already failed the pre-packaging check
+ * (publisher serves different bytes, version withdrawn from WinGet, manifest changed) is not tried
+ * again for the same version and installer checksum. It is tried again when the catalog offers a
+ * different version or WinGet corrects the checksum. Jobs from before this patch were recorded as
+ * WORKFLOW_DISPATCH_FAILED, so their message is matched too.
+ */
+export const INSTALLER_CHECK_CODES = ['HASH_MISMATCH', 'MANIFEST_UNAVAILABLE', 'MANIFEST_CHANGED'] as const;
+const LEGACY_MESSAGE = /serves different bytes|is no longer available from WinGet|no longer matches the trusted WinGet manifest/;
+
+/** HRM patch 0032: whether a failed job was the installer check, including jobs recorded before 0031. */
+export function isInstallerCheckFailure(code: string | null | undefined, message: string | null | undefined): boolean {
+  if ((INSTALLER_CHECK_CODES as readonly string[]).includes(code ?? '')) return true;
+  return code === 'WORKFLOW_DISPATCH_FAILED' && LEGACY_MESSAGE.test(message ?? '');
+}
+
+export function createInstallerBlockStore(getDb: () => Database.Database) {
+  return {
+    /** The failed job's code and time when this exact installer already failed its check, else null. */
+    blocked(tenant: string, winget: string, version: string, sha256: string): { code: string; at: string } | null {
+      const rows = getDb().prepare(`SELECT error_code, error_message, created_at FROM packaging_jobs
+        WHERE tenant_id = ? AND winget_id = ? COLLATE NOCASE AND version = ? AND status = 'failed'
+          AND upper(COALESCE(installer_sha256, '')) = upper(?)
+          AND error_code IN ('HASH_MISMATCH','MANIFEST_UNAVAILABLE','MANIFEST_CHANGED','WORKFLOW_DISPATCH_FAILED')
+        ORDER BY created_at DESC LIMIT 5`).all(tenant, winget, version, sha256) as Array<{ error_code: string; error_message: string | null; created_at: string }>;
+      const hit = rows.find((r) => isInstallerCheckFailure(r.error_code, r.error_message));
+      return hit ? { code: hit.error_code, at: hit.created_at } : null;
+    },
+  };
+}
+
+export async function installerBlocked(tenant: string, winget: string, version: string, sha256: string) {
+  if (process.env.DATABASE_MODE?.toLowerCase() !== 'sqlite' || !sha256) return null;
+  const { sqliteInstallerBlocks } = await import('@/lib/db/sqlite');
+  return sqliteInstallerBlocks.blocked(tenant, winget, version, sha256);
+}
diff --git a/lib/hrm/intune-app-ids.ts b/lib/hrm/intune-app-ids.ts
new file mode 100644
index 000000000..93a518ba2
--- /dev/null
+++ b/lib/hrm/intune-app-ids.ts
@@ -0,0 +1,40 @@
+/**
+ * HRM patch 0023: which Win32 apps still exist in Intune.
+ *
+ * IntuneGet keeps its own deployment history, so a copy deleted in Intune
+ * still looked like a deployed app: App updates listed it and auto-update
+ * could act on it. The update check asks Intune for the current list and
+ * skips copies that are gone. If Intune can't be asked, nothing is skipped.
+ */
+
+import { inventoryPageUrl } from '@/lib/intune/inventory-list';
+import { getServicePrincipalToken } from '@/lib/intune/graph-client';
+
+const MAX_PAGES = 50;
+
+// IDs are lower-case.
+export type ExistingAppIds = (tenantId: string) => Promise<Set<string> | null>;
+
+/** Every Win32 app ID in the tenant, or null when Intune couldn't be read completely. */
+export async function listWin32AppIds(
+  tenantId: string,
+  deps: { token?: (tenantId: string) => Promise<string | null>; fetchImpl?: typeof fetch } = {}
+): Promise<Set<string> | null> {
+  if (!tenantId) return null;
+  const token = await (deps.token ?? getServicePrincipalToken)(tenantId).catch(() => null);
+  if (!token) return null;
+  const doFetch = deps.fetchImpl ?? fetch;
+  const ids = new Set<string>();
+  let url: string | null = `${inventoryPageUrl(null)}&$select=id`;
+  for (let page = 0; url && page < MAX_PAGES; page++) {
+    const response = await doFetch(url, { headers: { Authorization: `Bearer ${token}` }, cache: 'no-store' }).catch(() => null);
+    if (!response?.ok) return null;
+    const body = (await response.json().catch(() => null)) as { value?: Array<{ id?: string }>; '@odata.nextLink'?: string } | null;
+    if (!body || !Array.isArray(body.value)) return null;
+    for (const app of body.value) if (app.id) ids.add(app.id.toLowerCase());
+    const next = body['@odata.nextLink'];
+    url = typeof next === 'string' && next.startsWith('https://graph.microsoft.com/') ? next : null;
+  }
+  // Stopped at the page limit: the list may be incomplete, so don't skip anything.
+  return url ? null : ids;
+}
