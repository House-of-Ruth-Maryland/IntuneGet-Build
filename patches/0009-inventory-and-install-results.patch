@@ -0,0 +1,53 @@
+// HRM patch 0054: Check installs now (POST) next to the saved counts (GET).
+import { beforeEach, describe, expect, it, vi } from 'vitest';
+import { NextRequest } from 'next/server';
+
+const state = vi.hoisted(() => ({ auth: true, canCheck: true, result: null as unknown, records: [] as unknown[], calls: [] as string[] }));
+vi.mock('@/lib/auth-utils', () => ({ parseAccessToken: async () => (state.auth ? { tenantId: 'tenant-one', userId: 'staff' } : null) }));
+vi.mock('@/lib/hrm/install-status-check', () => ({
+  listInstallStatus: async () => state.records,
+  canCheckInstallsNow: async () => state.canCheck,
+  checkInstallsNow: async (tenant: string, appId: string) => { state.calls.push(`${tenant}|${appId}`); return state.result; },
+}));
+import { GET, POST } from './route';
+
+const A = '00000000-0000-0000-0000-00000000000a';
+const record = { tenant_id: 'tenant-one', intune_app_id: A, user_id: 'staff', display_name: 'Example Reader', installed: 3, failed: 1, pending: 0,
+  notApplicable: 0, other: 0, topErrors: [], previous_failed: 0, alerted_on: null, checked_at: '2026-11-11T20:00:00.000Z' };
+const post = (body: unknown) => POST(new NextRequest('http://localhost/api/hrm/install-status', { method: 'POST', headers: { Authorization: 'Bearer fixture' }, body: JSON.stringify(body) }));
+
+beforeEach(() => Object.assign(state, { auth: true, canCheck: true, result: { ok: true, record }, records: [record], calls: [] }));
+
+describe('install status route', () => {
+  it('returns counts only, and whether Check installs now is available', async () => {
+    const body = await (await GET(new NextRequest(`http://localhost/api/hrm/install-status?appId=${A}`, { headers: { Authorization: 'Bearer fixture' } }))).json();
+    expect(body).toEqual({ status: { installed: 3, failed: 1, pending: 0, notApplicable: 0, other: 0, topErrors: [], checkedAt: record.checked_at }, canCheck: true });
+  });
+
+  it('checks one app for the signed-in tenant and returns its new counts', async () => {
+    const response = await post({ appId: A });
+    expect(response.status).toBe(200);
+    expect((await response.json()).status.installed).toBe(3);
+    expect(state.calls).toEqual([`tenant-one|${A}`]);
+  });
+
+  it('refuses bad input and missing sign-in before reaching Intune', async () => {
+    expect((await post({ appId: "x' or 1 eq 1" })).status).toBe(400);
+    state.auth = false;
+    expect((await post({ appId: A })).status).toBe(401);
+    expect(state.calls).toEqual([]);
+  });
+
+  it('explains limits and failures in plain words, without Intune error text', async () => {
+    state.result = { ok: false, reason: 'too-soon', retryAt: '2026-11-11T20:05:00.000Z' };
+    let response = await post({ appId: A });
+    expect(response.status).toBe(429);
+    expect(await response.json()).toEqual({ error: 'Install results were checked in the last 5 minutes. Try again later.', retryAt: '2026-11-11T20:05:00.000Z' });
+    state.result = { ok: false, reason: 'not-newest' };
+    expect((await post({ appId: A })).status).toBe(409);
+    state.result = { ok: false, reason: 'intune' };
+    response = await post({ appId: A });
+    expect(response.status).toBe(424);
+    expect((await response.json()).error).toBe("Couldn't read install results from Intune. The last results are kept. Try again in 5 minutes.");
+  });
+});
diff --git a/app/api/hrm/install-status/route.ts b/app/api/hrm/install-status/route.ts
new file mode 100644
index 000000000..c936f1756
--- /dev/null
+++ b/app/api/hrm/install-status/route.ts
@@ -0,0 +1,52 @@
+// HRM patch 0019: install counts for one IntuneGet-deployed app (Inventory panel). Counts only.
+// HRM patch 0054: POST { appId } is Check now: it refreshes that one app's counts from Intune (read-only),
+// at most once every 5 minutes per app, and never sends an alert.
+
+import { NextRequest, NextResponse } from 'next/server';
+import { parseAccessToken } from '@/lib/auth-utils';
+import { canCheckInstallsNow, checkInstallsNow, listInstallStatus } from '@/lib/hrm/install-status-check';
+import type { InstallStatusRecord } from '@/lib/hrm/install-status';
+
+const APP_ID = /^[0-9a-f-]{36}$/i;
+const reply = (body: unknown, status = 200) => NextResponse.json(body, { status, headers: { 'Cache-Control': 'private, no-store' } });
+
+const view = (record: InstallStatusRecord) => ({
+  installed: record.installed,
+  failed: record.failed,
+  pending: record.pending,
+  notApplicable: record.notApplicable,
+  other: record.other,
+  topErrors: record.topErrors,
+  checkedAt: record.checked_at,
+});
+
+export async function GET(request: NextRequest) {
+  const user = await parseAccessToken(request.headers.get('Authorization'));
+  if (!user) return reply({ error: 'Authentication required' }, 401);
+
+  const appId = new URL(request.url).searchParams.get('appId') ?? '';
+  if (!APP_ID.test(appId)) return reply({ error: 'Invalid app' }, 400);
+
+  const record = (await listInstallStatus(user.tenantId)).find((app) => app.intune_app_id === appId);
+  return reply({ status: record ? view(record) : null, canCheck: await canCheckInstallsNow(user.tenantId, appId) });
+}
+
+export async function POST(request: NextRequest) {
+  const user = await parseAccessToken(request.headers.get('Authorization'));
+  if (!user) return reply({ error: 'Authentication required' }, 401);
+  const body = (await request.json().catch(() => null)) as { appId?: unknown } | null;
+  const appId = typeof body?.appId === 'string' ? body.appId : '';
+  if (!APP_ID.test(appId)) return reply({ error: 'Invalid app' }, 400);
+
+  try {
+    const result = await checkInstallsNow(user.tenantId, appId);
+    if (result.ok) return reply({ status: view(result.record) });
+    if (result.reason === 'too-soon') {
+      return reply({ error: 'Install results were checked in the last 5 minutes. Try again later.', retryAt: result.retryAt }, 429);
+    }
+    if (result.reason === 'not-newest') return reply({ error: 'Only the newest copy can be checked. Open the newest copy in Inventory.' }, 409);
+    return reply({ error: "Couldn't read install results from Intune. The last results are kept. Try again in 5 minutes." }, 424);
+  } catch {
+    return reply({ error: "Couldn't check install results. The last results are kept. Try again in 5 minutes." }, 500);
+  }
+}
