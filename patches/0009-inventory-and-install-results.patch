diff --git a/components/hrm/AppInsights.tsx b/components/hrm/AppInsights.tsx
new file mode 100644
index 000000000..e43f15427
--- /dev/null
+++ b/components/hrm/AppInsights.tsx
@@ -0,0 +1,132 @@
+'use client';
+import { useAppInsights } from '@/hooks/useAppInsights';
+import { GUID, needsReview, type AssignmentSummary, type AppSnapshot } from '@/lib/hrm/app-insights';
+import { intuneAppUrl, OPEN_IN_INTUNE } from '@/lib/hrm/intune-link';
+
+const date = (at: string) => new Date(at).toLocaleString('en-US', { month: 'short', day: 'numeric', year: 'numeric', hour: 'numeric', minute: '2-digit' });
+const button = 'text-xs text-accent-cyan hover:underline disabled:opacity-50';
+
+// HRM patch 0036: changesOnly leaves out "no longer in Intune" and "no groups", for screens that already
+// say so from the live Intune read, so the same warning isn't shown twice.
+const hasUnreviewedChange = (s: AppSnapshot) => s.change !== null && s.reviewedRevision < s.revision;
+
+function SavedAssignment({ assignment, counterpart }: { assignment: AssignmentSummary; counterpart?: AssignmentSummary }) {
+  const [target, intent, ...settings] = assignment.label.split(' · ');
+  const groupId = target.startsWith('Group ') ? target.slice(6) : '';
+  const unavailable = GUID.test(groupId);
+  const previousSettings = new Set(counterpart?.label.split(' · ').slice(2));
+  const readable = settings.filter(value => !counterpart || !previousSettings.has(value)).map(value => value
+    .replace('notifications: show All', 'Notifications: Show all')
+    .replace('notifications: hide All', 'Notifications: Hide all')
+    .replace('notifications: show Reboot', 'Notifications: Show restart notifications')
+    .replace('delivery optimization priority: not Configured', 'Delivery optimization priority: Not configured'));
+  return <li className="break-words">
+    <span>{unavailable ? 'Group name unavailable' : target}</span>{intent && <> · {intent}</>}
+    {(unavailable || readable.length > 0) && <details className="text-xs text-text-secondary" open={counterpart && readable.length > 0 ? true : undefined}>
+      <summary className="cursor-pointer py-1">Assignment details</summary>
+      {unavailable && <p>Group ID: {groupId}</p>}
+      {readable.map((value, index) => <p key={index}>{value}</p>)}
+    </details>}
+  </li>;
+}
+
+export function AssignmentDifference({ snapshot, changesOnly = false }: { snapshot: AppSnapshot; changesOnly?: boolean }) {
+  const change = snapshot.change;
+  return <div className="space-y-2 text-sm">
+    {!changesOnly && !snapshot.exists && <p>This copy is no longer in Intune. It may have been replaced or deleted. Check before deploying again.</p>}
+    {!changesOnly && snapshot.exists && !snapshot.assignments.some((a) => a.installs) && <p>No install assignments.</p>}
+    {change && snapshot.reviewedRevision < snapshot.revision && <>
+      <p>Change observed {date(change.observedAt)}.</p>
+      <div className="grid gap-3 sm:grid-cols-2">
+        {(['before', 'after'] as const).map((key) => {
+          const other = change[key === 'before' ? 'after' : 'before'];
+          const otherKeys = new Set(other.map(row => row.key));
+          const changed = change[key].filter(row => !otherKeys.has(row.key));
+          return <div key={key}>
+          <p className="font-medium">{key === 'before' ? 'Previously' : 'Now'}</p>
+          {changed.length ? <ul className="space-y-1">{changed.map(assignment => <SavedAssignment key={assignment.key} assignment={assignment} counterpart={other.find(row => row.label.split(' · ').slice(0, 2).join(' · ') === assignment.label.split(' · ').slice(0, 2).join(' · '))} />)}</ul> : <p className="text-text-muted">{key === 'before' ? 'No removed assignments' : 'No added assignments'}</p>}
+        </div>;
+        })}
+      </div>
+    </>}
+  </div>;
+}
+
+export function AppDriftWarning({ appId, changesOnly = false }: { appId?: string | null; changesOnly?: boolean }) {
+  // Separate child keeps hooks unconditional when the cart has no previous copy.
+  return appId ? <DriftWarning appId={appId} changesOnly={changesOnly} /> : null;
+}
+function DriftWarning({ appId, changesOnly }: { appId: string; changesOnly: boolean }) {
+  const { data, error } = useAppInsights(appId);
+  if (error) return <p className="mt-2 text-xs text-amber-700 dark:text-amber-300">Could not check saved group changes. Review the live groups before deploying.</p>;
+  if (!data?.snapshot || !(changesOnly ? hasUnreviewedChange(data.snapshot) : needsReview(data.snapshot))) return null;
+  return <div className="mt-2 rounded-lg border border-overlay/10 bg-bg-surface p-3 text-text-secondary"><AssignmentDifference snapshot={data.snapshot} changesOnly={changesOnly} /></div>;
+}
+
+export function AppDriftPanel({ onOpen }: { onOpen: (id: string) => void }) {
+  const { data, isLoading, error, refetch, action } = useAppInsights();
+  if (data?.supported === false) return null;
+  const alerts = data?.alerts ?? [];
+  const changes = alerts.filter(s => s.exists && hasUnreviewedChange(s));
+  const missing = alerts.filter(s => !s.exists);
+  const unassigned = alerts.filter(s => s.exists && !hasUnreviewedChange(s) && !s.assignments.some(a => a.installs));
+  return <section className="mb-6 rounded-xl border border-overlay/10 bg-bg-surface p-4" aria-label="Group changes to review">
+    <div className="flex items-center justify-between gap-3">
+      <h2 className="font-semibold text-text-primary">Group changes to review</h2>
+      <button className={button} disabled={action.isPending} onClick={() => action.mutate({ action: 'check' })}>{action.isPending && action.variables?.action === 'check' ? 'Checking…' : 'Check now'}</button>
+    </div>
+    <p className="mt-1 text-xs text-text-muted">Checks run at 3:30 AM and 3:30 PM, Maryland time.</p>
+    {isLoading && <p className="mt-3 text-sm text-text-muted">Loading saved checks…</p>}
+    {error && <p role="alert" className="mt-3 text-sm text-status-error">{error.message} <button className={button} onClick={() => refetch()}>Try again</button></p>}
+    {action.error && <p role="alert" className="mt-3 text-sm text-status-error">{action.error.message}</p>}
+    {action.data && <p role="status" className="mt-2 text-xs text-text-secondary">{action.data.reviewed ? 'Change marked reviewed.' : `Checked ${action.data.checked ?? 0} apps.`}{action.data.errors > 0 ? ` Could not check ${action.data.errors}; their last successful checks are kept.` : ''}</p>}
+    {data && changes.length === 0 && <p className="mt-2 text-sm text-text-secondary">No group changes to review.</p>}
+    {changes.map(s => <details key={s.appId} className="mt-2 border-t border-overlay/10 pt-1">
+      <summary className="cursor-pointer py-2 text-sm font-medium text-text-primary">{s.displayName} {s.version}</summary>
+      <AssignmentDifference snapshot={s} />
+      <p className="mt-2 text-xs text-text-muted">Last successful check: {date(s.checkedAt)}</p>
+      <div className="mt-2 flex flex-wrap items-center gap-4">
+        <button className={button} disabled={action.isPending} onClick={() => action.mutate({ action: 'review', appId: s.appId, revision: s.revision })}>Mark reviewed</button>
+        <button className={button} onClick={() => onOpen(s.appId)}>Open app</button>
+      </div>
+    </details>)}
+    {missing.length > 0 && <details className="mt-2 border-t border-overlay/10">
+      <summary className="cursor-pointer py-2 text-sm">Copies no longer in Intune ({missing.length})</summary>
+      {missing.map(s => <div key={s.appId} className="flex flex-wrap items-center gap-3 py-1 text-sm">
+        <span>{s.displayName} {s.version}</span><button className={button} onClick={() => onOpen(s.appId)}>Open activity</button>
+        <a className={button} href={intuneAppUrl(s.appId)} target="_blank" rel="noopener noreferrer">{OPEN_IN_INTUNE}</a>
+        {hasUnreviewedChange(s) && <details className="basis-full"><summary className="cursor-pointer">Last recorded group change</summary>
+          <AssignmentDifference snapshot={s} changesOnly />
+          <button className={button} disabled={action.isPending} onClick={() => action.mutate({ action: 'review', appId: s.appId, revision: s.revision })}>Mark reviewed</button>
+        </details>}
+      </div>)}
+    </details>}
+    {unassigned.length > 0 && <details className="mt-2 border-t border-overlay/10">
+      <summary className="cursor-pointer py-2 text-sm text-text-secondary">No install assignments ({unassigned.length})</summary>
+      {unassigned.map(s => <div key={s.appId} className="flex flex-wrap items-center gap-3 py-1 text-sm">
+        <span>{s.displayName} {s.version}</span><button className={button} onClick={() => onOpen(s.appId)}>Open app</button>
+      </div>)}
+    </details>}
+  </section>;
+}
+
+export function AppActivityTimeline({ appId }: { appId: string }) {
+  const { data, isLoading, error, refetch } = useAppInsights(appId);
+  if (data?.supported === false) return null;
+  return <section className="border-t border-overlay/10 pt-4" aria-label="App activity">
+    <h4 className="mb-2 text-sm font-semibold text-text-secondary">App activity</h4>
+    {isLoading && <p className="text-sm text-text-muted">Loading activity…</p>}
+    {error && <p role="alert" className="text-sm text-status-error">{error.message} <button className={button} onClick={() => refetch()}>Try again</button></p>}
+    {data && <>
+      <p className="mb-3 text-xs text-text-muted">Latest 100 events across versions deployed by IntuneGet. Group and install-result changes are recorded from the first check after this feature was added.</p>
+      {data.activity.length === 0 && <p className="text-sm text-text-muted">No recorded activity for this app.</p>}
+      <ol className="space-y-3 border-l border-overlay/10 pl-4">{data.activity.map((e) => <li key={e.id} className="text-sm">
+        <p className="font-medium text-text-primary">{e.title}</p>
+        <p className="text-text-secondary break-words whitespace-pre-line">{e.detail}</p>
+        {e.appId && <a className={button} href={intuneAppUrl(e.appId)} target="_blank" rel="noopener noreferrer">{OPEN_IN_INTUNE}</a>}
+        {e.id.startsWith('failed-') && <a className={button} href="/dashboard/uploads">Open Deployments</a>}
+        <p className="mt-1 text-xs text-text-muted"><time dateTime={e.at}>{date(e.at)}</time> · {e.actor}</p>
+      </li>)}</ol>
+    </>}
+  </section>;
+}
