@@ -0,0 +1,32 @@
+'use client';
+import { useMutation, useQuery, useQueryClient } from '@tanstack/react-query';
+import { useMicrosoftAuth } from '@/hooks/useMicrosoftAuth';
+import type { AppInsights, AppSnapshot } from '@/lib/hrm/app-insights';
+
+export function useAppInsights(appId?: string) {
+  const { getAccessToken, isAuthenticated, account } = useMicrosoftAuth();
+  const client = useQueryClient();
+  const scope = [account?.tenantId, account?.localAccountId];
+  const key = ['hrm', 'app-insights', ...scope];
+  const request = async (body?: unknown) => {
+    const token = await getAccessToken();
+    if (!token) throw new Error('Sign in again to view app activity.');
+    const result = await fetch(`/api/hrm/app-insights${!body && appId ? `?appId=${encodeURIComponent(appId)}` : ''}`, {
+      method: body ? 'POST' : 'GET', headers: { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json' },
+      ...(body ? { body: JSON.stringify(body) } : {}),
+    });
+    if (result.redirected || result.headers.get('content-type')?.includes('text/html')) throw new Error('Your sign-in expired. Reload the page and sign in again.');
+    const data = await result.json();
+    if (!result.ok) throw new Error(data.error || 'Could not load app activity. Try again.');
+    return data;
+  };
+  const query = useQuery<AppInsights & { alerts?: AppSnapshot[] }>({
+    queryKey: [...key, appId ?? 'fleet'], queryFn: () => request(), enabled: isAuthenticated,
+    staleTime: 30000,
+  });
+  const action = useMutation({
+    mutationFn: (body: { action: 'check' | 'review'; appId?: string; revision?: number }) => request(body),
+    onSuccess: () => client.invalidateQueries({ queryKey: key }),
+  });
+  return { ...query, action };
+}
diff --git a/hooks/useInstallStatus.ts b/hooks/useInstallStatus.ts
new file mode 100644
index 000000000..9074c8de8
--- /dev/null
+++ b/hooks/useInstallStatus.ts
@@ -0,0 +1,93 @@
+'use client';
+
+// HRM patch 0019: install counts for one app, from /api/hrm/install-status.
+// HRM patch 0054: the same request says whether Check now is available, and useCheckInstallsNow runs it.
+
+import { useMutation, useQuery, useQueryClient } from '@tanstack/react-query';
+import { useMicrosoftAuth } from '@/hooks/useMicrosoftAuth';
+import type { InstallError } from '@/lib/hrm/install-status';
+
+export interface AppInstallStatus {
+  installed: number;
+  failed: number;
+  pending: number;
+  notApplicable: number;
+  other: number;
+  topErrors: InstallError[];
+  checkedAt: string;
+}
+
+interface InstallStatusResponse {
+  status: AppInstallStatus | null;
+  canCheck: boolean;
+}
+
+const key = (appId: string | null) => ['hrm', 'install-status', appId] as const;
+
+function useInstallStatusQuery<T>(appId: string | null, select: (data: InstallStatusResponse) => T) {
+  const { getAccessToken, isAuthenticated } = useMicrosoftAuth();
+  return useQuery<InstallStatusResponse, Error, T>({
+    queryKey: key(appId),
+    queryFn: async () => {
+      const token = await getAccessToken();
+      if (!token) throw new Error('Not authenticated');
+      const response = await fetch(`/api/hrm/install-status?appId=${encodeURIComponent(appId ?? '')}`, {
+        headers: { Authorization: `Bearer ${token}` },
+      });
+      if (!response.ok) throw new Error('Failed to load install status');
+      const body = await response.json();
+      return { status: body.status ?? null, canCheck: body.canCheck === true };
+    },
+    select,
+    enabled: isAuthenticated && Boolean(appId),
+    staleTime: 5 * 60 * 1000,
+  });
+}
+
+export function useInstallStatus(appId: string | null) {
+  return useInstallStatusQuery(appId, (data) => data.status);
+}
+
+/**
+ * Patch 0058: 401 and 400 bodies are the route's internal wording, so they get fixed staff text.
+ * Other refusals carry HRM's own fixed sentences from the route and are shown as they are.
+ */
+export function checkErrorMessage(status: number, error: unknown): string {
+  if (status === 401) return 'Your sign-in has expired. Reload the page, then try again.';
+  if (status === 400) return "Couldn't check this app. Reload the page, then try again.";
+  if (typeof error === 'string' && error.length > 0 && error.length <= 200) return error;
+  return "Couldn't check install results. Try again in 5 minutes.";
+}
+
+const timeOf = (iso: string) => new Date(iso).toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' });
+
+/** Patch 0054: Check installs now for one app. canCheck is false outside SQLite and for older copies. */
+export function useCheckInstallsNow(appId: string | null) {
+  const { getAccessToken } = useMicrosoftAuth();
+  const queryClient = useQueryClient();
+  const { data: canCheck } = useInstallStatusQuery(appId, (data) => data.canCheck);
+  const check = useMutation<AppInstallStatus, Error>({
+    mutationFn: async () => {
+      const token = await getAccessToken();
+      if (!token) throw new Error('Your sign-in has expired. Reload the page, then try again.');
+      const response = await fetch('/api/hrm/install-status', {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
+        body: JSON.stringify({ appId }),
+      });
+      const isJson = (response.headers.get('content-type') ?? '').includes('application/json');
+      if (response.redirected || !isJson) throw new Error('Your sign-in has expired. Reload the page, then try again.');
+      const body = await response.json().catch(() => ({}));
+      if (response.status === 429 && typeof body.retryAt === 'string') {
+        throw new Error(`Install results were checked in the last 5 minutes. Try again after ${timeOf(body.retryAt)}.`);
+      }
+      if (!response.ok) throw new Error(checkErrorMessage(response.status, body.error));
+      return body.status as AppInstallStatus;
+    },
+    onSuccess: async (status) => {
+      queryClient.setQueryData<InstallStatusResponse>(key(appId), { status, canCheck: true });
+      await queryClient.invalidateQueries({ queryKey: ['hrm', 'home'] });
+    },
+  });
+  return { canCheck: canCheck === true, check };
+}
