+    state.value = { data: { app: { assignments: [group('g1', 'required'), group('g2', 'available')],
+      assignmentGroupNames: { g1: 'APP-Example', g2: 'Staff-Example' } } } };
+    expect(await render()).toBe('APP-Example · Required, Staff-Example · Available');
+  });
+
+  it('shortens a long list', async () => {
+    state.value = { data: { app: { assignments: ['a', 'b', 'c', 'd', 'e'].map((g) => group(g, 'required')),
+      assignmentGroupNames: { a: 'A', b: 'B', c: 'C', d: 'D', e: 'E' } } } };
+    expect(await render()).toContain('and 2 more');
+  });
+
+  it('warns when the copy has no groups or is gone from Intune', async () => {
+    state.value = { data: { app: { assignments: [] } } };
+    expect(await render()).toContain('No groups. This copy installs nowhere.');
+    state.value = { error: new Error('App not found') };
+    expect(await render()).toContain('Not in Intune any more');
+  });
+
+  // HRM patch 0036: the saved check doesn't repeat what the live line already says.
+  it('says "no groups" or "not in Intune" once, and still shows unreviewed group changes', async () => {
+    const snapshot = { appId: 'app-1', exists: false, assignments: [], revision: 2, reviewedRevision: 2, change: null };
+    insights.value = { data: { supported: true, snapshot }, action: {} };
+    state.value = { error: new Error('App not found') };
+    let text = await render();
+    expect(text).toContain('Not in Intune any more');
+    expect(text).not.toContain('no longer in Intune');
+    insights.value = { data: { supported: true, snapshot: { ...snapshot, exists: true } }, action: {} };
+    state.value = { data: { app: { assignments: [] } } };
+    text = await render();
+    expect(text).toContain('No groups. This copy installs nowhere.');
+    expect(text).not.toContain('No groups receive this app');
+    insights.value = { data: { supported: true, snapshot: { ...snapshot, exists: true, revision: 3,
+      change: { before: [{ key: 'a', label: 'All devices · Required', installs: true }], after: [], observedAt: '2026-01-02T12:00:00Z' } } }, action: {} };
+    text = await render();
+    expect(text).toContain('Groups or assignment settings changed');
+    insights.value = { data: { supported: false }, action: {} };
