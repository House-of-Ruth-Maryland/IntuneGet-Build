+// @vitest-environment happy-dom
+const insights = vi.hoisted(() => ({ value: { data: { supported: false }, action: {} } as Record<string, unknown> }));
+vi.mock('@/hooks/useAppInsights', () => ({ useAppInsights: () => insights.value }));
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { act, createElement } from 'react';
+import { createRoot, type Root } from 'react-dom/client';
+
+const state = vi.hoisted(() => ({ value: {} as { data?: unknown; isLoading?: boolean; error?: Error | null } }));
+vi.mock('@/hooks/use-inventory', () => ({ useAppDetails: () => state.value }));
+import { AppGroupsLine } from './AppGroupsLine';
+
+let root: Root;
+(globalThis as typeof globalThis & { IS_REACT_ACT_ENVIRONMENT: boolean }).IS_REACT_ACT_ENVIRONMENT = true;
+const group = (id: string, intent: string) => ({ intent, target: { '@odata.type': '#microsoft.graph.groupAssignmentTarget', groupId: id } });
+
+async function render(id: string | null = 'app-1') {
+  await act(async () => root.render(createElement(AppGroupsLine, { intuneAppId: id })));
+  return document.body.textContent ?? '';
+}
+
+beforeEach(() => {
+  insights.value = { data: { supported: false }, action: {} };
+  const el = document.createElement('div');
+  document.body.append(el);
+  root = createRoot(el);
+});
+afterEach(async () => {
+  await act(async () => root.unmount());
+  document.body.innerHTML = '';
+});
+
+describe('AppGroupsLine', () => {
+  it('names each group and how it is assigned', async () => {
+    state.value = { data: { app: { assignments: [group('g1', 'required'), group('g2', 'available')],
+      assignmentGroupNames: { g1: 'APP-Example', g2: 'Staff-Example' } } } };
+    expect(await render()).toBe('APP-Example · Required, Staff-Example · Available');
+  });
+
+  it('explains Required and Available on hover or keyboard focus, with Intune\'s own names', async () => {
+    state.value = { data: { app: { assignments: [group('g1', 'required'), group('g2', 'available')],
+      assignmentGroupNames: { g1: 'APP-Example', g2: 'Staff-Example' } } } };
+    await render();
+    const terms = Array.from(document.body.querySelectorAll('[tabindex="0"]')).map((el) => el.textContent);
+    expect(terms).toEqual(['Required', 'Available']);
+  });
+
+  it('shortens a long list', async () => {
+    state.value = { data: { app: { assignments: ['a', 'b', 'c', 'd', 'e'].map((g) => group(g, 'required')),
+      assignmentGroupNames: { a: 'A', b: 'B', c: 'C', d: 'D', e: 'E' } } } };
+    expect(await render()).toContain('and 2 more');
+  });
+
+  it('warns when the copy has no groups or is gone from Intune', async () => {
+    state.value = { data: { app: { assignments: [] } } };
+    expect(await render()).toContain('No install assignments.');
+    state.value = { error: new Error('App not found') };
+    expect(await render()).toContain('Not in Intune any more');
+  });
+
+  // HRM patch 0036: the saved check doesn't repeat what the live line already says.
+  it('says "no groups" or "not in Intune" once, and still shows unreviewed group changes', async () => {
+    const snapshot = { appId: 'app-1', exists: false, assignments: [], revision: 2, reviewedRevision: 2, change: null };
+    insights.value = { data: { supported: true, snapshot }, action: {} };
+    state.value = { error: new Error('App not found') };
+    let text = await render();
+    expect(text).toContain('Not in Intune any more');
+    expect(text).not.toContain('no longer in Intune');
+    insights.value = { data: { supported: true, snapshot: { ...snapshot, exists: true } }, action: {} };
+    state.value = { data: { app: { assignments: [] } } };
+    text = await render();
+    expect(text).toContain('No install assignments.');
+    expect(text).not.toContain('No groups receive this app');
+    insights.value = { data: { supported: true, snapshot: { ...snapshot, exists: true, revision: 3,
+      change: { before: [{ key: 'a', label: 'All devices · Required', installs: true }], after: [], observedAt: '2026-01-02T12:00:00Z' } } }, action: {} };
+    text = await render();
+    expect(text).toContain('Change observed');
+    expect(text).toContain('All devices');
+    insights.value = { data: { supported: false }, action: {} };
+  });
+
+  it('shows nothing for other errors or without an app ID', async () => {
+    state.value = { error: new Error('Failed to fetch app details') };
+    expect(await render()).toBe('');
+    state.value = { isLoading: true };
+    expect(await render(null)).toBe('');
