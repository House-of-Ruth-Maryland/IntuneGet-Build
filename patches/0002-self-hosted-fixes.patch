+const today = new Date().toISOString();
+const job = (id: string, status: string) => ({ id, status, winget_id: 'Example.App', display_name: 'Example', publisher: 'Example Publisher', error_message: status === 'failed' ? 'fixture error' : null, created_at: today, completed_at: today });
+const request = () => new NextRequest('http://localhost/api/analytics?days=7');
+beforeEach(() => { vi.clearAllMocks(); mocks.auth.mockResolvedValue({ userId: 'caller', tenantId: 'fixture-tenant' }); });
+describe('deployment analytics', () => {
+  it('counts deployed jobs from GitHub-mode packaging as successful', async () => {
+    mocks.jobs.mockResolvedValue([job('a', 'deployed'), job('b', 'deployed'), job('c', 'completed'), job('d', 'failed'), job('e', 'queued')]);
+    const v = await (await GET(request())).json();
+    expect(v.summary).toMatchObject({ totalJobs: 5, completedJobs: 3, failedJobs: 1, pendingJobs: 1, successRate: 75 });
+    expect(v.dailyDeployments.reduce((n: number, d: { completed: number }) => n + d.completed, 0)).toBe(3);
+    expect(v.topApps).toEqual([{ wingetId: 'Example.App', displayName: 'Example', publisher: 'Example Publisher', count: 3 }]);
+  });
+  // HRM item 105
+  it('reports on the whole tenant for a colleague who owns none of its jobs, and past the newest 50', async () => {
+    const rows = Array.from({ length: 120 }, (_, n) => ({ ...job(`t${n}`, n % 4 ? 'deployed' : 'failed'), user_id: 'fixture-owner', user_email: 'owner@example.test' }));
+    mocks.tenantJobs.mockImplementation(async (tenant: string, limit: number) => tenant === 'fixture-tenant' ? rows.slice(0, limit) : []);
+    mocks.jobs.mockResolvedValue([]);
+    const tenant = await (await GET(new NextRequest('http://localhost/api/analytics?days=7&scope=tenant'))).json();
+    expect(tenant.scope).toBe('tenant');
+    expect(tenant.summary).toMatchObject({ totalJobs: 120, completedJobs: 90, failedJobs: 30 });
+    expect(mocks.jobs).not.toHaveBeenCalled();
+    const mine = await (await GET(request())).json();
+    expect(mine.scope).toBe('mine'); expect(mine.summary.totalJobs).toBe(0);
+    expect(mocks.jobs).toHaveBeenCalledWith('caller', 5000);
+  });
+  it('reads only the tenant in the verified sign-in token, whatever the request names', async () => {
+    mocks.tenantJobs.mockResolvedValue([]);
+    mocks.auth.mockResolvedValue({ userId: 'outsider', tenantId: 'other-tenant' });
+    await GET(new NextRequest('http://localhost/api/analytics?scope=tenant&tenantId=fixture-tenant', { headers: { 'X-MSP-Tenant-Id': 'fixture-tenant' } }));
+    await EXPORT(new NextRequest('http://localhost/api/analytics/export?scope=tenant&tenantId=fixture-tenant', { headers: { 'X-MSP-Tenant-Id': 'fixture-tenant' } }));
+    expect(mocks.tenantJobs.mock.calls).toEqual([['other-tenant', 5000], ['other-tenant', 5000]]);
+  });
+  it('refuses unauthenticated callers and unknown scopes before reading any job', async () => {
+    expect((await GET(new NextRequest('http://localhost/api/analytics?scope=everyone'))).status).toBe(400);
+    expect((await EXPORT(new NextRequest('http://localhost/api/analytics/export?scope=everyone'))).status).toBe(400);
+    mocks.auth.mockResolvedValue(null);
+    expect((await GET(new NextRequest('http://localhost/api/analytics?scope=tenant'))).status).toBe(401);
+    expect((await EXPORT(new NextRequest('http://localhost/api/analytics/export?scope=tenant'))).status).toBe(401);
+    expect(mocks.jobs).not.toHaveBeenCalled(); expect(mocks.tenantJobs).not.toHaveBeenCalled();
+  });
+  it('adds who deployed each row to a tenant export only', async () => {
+    const row = { ...job('a', 'deployed'), version: '1', architecture: 'x64', installer_type: 'msi', intune_app_id: null, user_email: 'owner@example.test' };
+    mocks.tenantJobs.mockResolvedValue([row]); mocks.jobs.mockResolvedValue([row]);
+    const tenant = await (await EXPORT(new NextRequest('http://localhost/api/analytics/export?scope=tenant'))).text();
+    expect(tenant.split('\n')[0].endsWith(',Deployed By')).toBe(true);
+    expect(tenant.split('\n')[1].endsWith(',owner@example.test')).toBe(true);
+    const mine = await (await EXPORT(new NextRequest('http://localhost/api/analytics/export'))).text();
+    expect(mine).not.toContain('Deployed By'); expect(mine).not.toContain('owner@example.test');
+  });
+});
