+'use client';
+import { ArrowRight, ArrowUpCircle, BarChart3, Box, Check, ChevronDown, Circle, LayoutDashboard, LifeBuoy, Package, Radar, Rocket, Search, Server } from 'lucide-react';
+import type { LucideIcon } from 'lucide-react';
+import { HRM_SUPPORT_URL } from '@/lib/hrm/help-content';
+import type { HelpScreen, HelpStep } from '@/lib/hrm/help-guides';
+
+/** label: the page's name in the sidebar and Search; heading: its on-page title when that differs. */
+export const HELP_SCREENS: Record<HelpScreen, { label: string; href: string; heading?: string }> = {
+  catalog: { label: 'App catalog', href: '/dashboard/apps' },
+  'deployment-list': { label: 'Deployment list', href: '/dashboard/apps' },
+  updates: { label: 'App updates', href: '/dashboard/updates' },
+  inventory: { label: 'Inventory', href: '/dashboard/inventory' },
+  deployments: { label: 'Deployments', href: '/dashboard/uploads' },
+  discovered: { label: 'Discovered apps', href: '/dashboard/unmanaged' },
+  settings: { label: 'Settings', href: '/dashboard/settings' },
+  server: { label: 'Home', href: '/dashboard' },
+  support: { label: 'HRM Support', href: HRM_SUPPORT_URL },
+  reports: { label: 'Reports', href: '/dashboard/reports', heading: 'My deployment reports' },
+};
+
+/** HRM patch 0058 (sidebar 2B): Home, then Apps and Activity, then Help on its own at the bottom. */
+const RAIL: { screens: HelpScreen[]; icon: LucideIcon }[][] = [
+  [{ screens: ['server'], icon: LayoutDashboard }],
+  [{ screens: ['catalog', 'deployment-list'], icon: Package }, { screens: ['inventory'], icon: Server }, { screens: ['discovered'], icon: Radar }, { screens: ['updates'], icon: ArrowUpCircle }],
+  [{ screens: ['deployments'], icon: Rocket }, { screens: ['reports'], icon: BarChart3 }],
+  [{ screens: [], icon: LifeBuoy }],
+];
+
+function ExampleRow({ label, value }: { label: string; value: string }) {
+  return <div className="flex items-center justify-between gap-3 border-b border-overlay/10 py-3 text-xs"><span className="text-text-muted">{label}</span><span className="text-text-secondary">{value}</span></div>;
+}
+
+/** A schematic built from app labels, never a screenshot of a tenant or a live action. */
+export function HelpVisual({ step, number, guideId }: { step: HelpStep; number: number; guideId: string }) {
+  const screen = HELP_SCREENS[step.screen];
+  const isRemoval = ['retire', 'remove-discovered'].includes(guideId);
+  const action = /^(Open|Save|Deploy|Add|Remove|Check|Update|Review|Approve|End|Go back|Keep|Delete|Reload|Retry|Download|Contact|Turn|Edit|Find|Show|Clear|Pause|Resume)/i.test(step.focus);
+  const target = (<div className="relative my-4 rounded-xl border-2 border-accent-cyan bg-accent-cyan/5 p-3.5"><span className="absolute -left-2.5 -top-2.5 flex h-6 w-6 items-center justify-center rounded-full bg-accent-cyan text-xs font-bold text-bg-deep">{number}</span><div className={`flex min-h-10 items-center justify-between gap-3 rounded-lg px-3 py-2 text-sm font-semibold ${action ? 'bg-accent-cyan/15 text-text-primary' : 'border border-overlay/15 bg-bg-surface text-text-primary'}`}><span>{step.focus}</span>{action ? <ArrowRight size={16} className="shrink-0 text-accent-cyan"/> : <ChevronDown size={15} className="shrink-0 text-text-muted"/>}</div></div>);
+  // Home: task guides about apps show Needs attention; the server guide shows Server status (patch 0058 layout 3B).
+  const needsAttention = step.screen === 'server' && guideId !== 'server';
+  const rowLabels: Partial<Record<HelpScreen, string[]>> = { catalog: ['Who gets it', 'When a new version comes out'], 'deployment-list': ['Who gets it', 'When a new version comes out'], updates: ['Update schedule', 'Installation timing', 'Startup install results'], inventory: ['Groups', 'Install results'], discovered: ['App found on computers'], settings: ['Appearance', 'Notifications'], server: needsAttention ? ['Needs attention'] : ['Server status', 'Intune self-test', 'Version', 'All checks'] };
+  const heading = screen.heading ?? screen.label;
+  const focusAtHeading = step.focus === heading;
+  // Inventory app details: Availability and deadline, Previous version and Retire app sit under Actions, between Install results and Groups.
+  const actionsPanel = step.screen === 'inventory' ? ({ 'installation-timing': 'Availability and deadline', rollback: 'Previous version', retire: 'Retire app' } as Record<string, string>)[guideId] : undefined;
+  const focusAtRow = rowLabels[step.screen]?.includes(step.focus);
+  const row = (label: string, value: string) => step.focus === label ? target : <ExampleRow label={label} value={value}/>;
+  // App updates (patch 0058 layout 4B): one status strip; pausing, hours and blackouts are in Edit schedule.
+  const scheduleDialog = ['Pause automatic updates', 'Edit schedule', 'Restrict deploying to selected days and hours', 'Add blackout'].includes(step.focus);
+  const location = step.screen === 'catalog' && !focusAtHeading ? 'App configuration · panel on the right' : needsAttention ? 'Home · Needs attention' : step.focus === 'Check installs now' ? 'App details · Install results' : actionsPanel ? `App details · Actions · ${actionsPanel}` : step.focus === 'Installation policy for this release' ? 'Update history · expanded version' : guideId === 'automatic-installation-policy' ? 'Status strip · Installation timing · Edit shared policy' : scheduleDialog ? 'Status strip · Update schedule · Edit schedule' : step.screen === 'updates' && ['Auto-update', 'Update', 'Test with a pilot group'].includes(step.focus) ? 'Available updates · app card' : guideId === 'startup-beta' && step.screen === 'updates' ? 'Status strip · Startup install results · Beta' : step.screen === 'updates' && step.focus === 'Update schedule' ? 'App updates · status strip' : null;
+  return <figure className="min-w-0 overflow-hidden rounded-2xl border border-overlay/10 bg-bg-elevated" aria-label={`Visual reference: ${screen.label}, ${step.focus}`}>
+    <div className="flex flex-wrap items-center justify-between gap-2 border-b border-overlay/10 px-4 py-3"><span className="text-xs font-medium text-text-secondary">Where to look</span><span className="rounded-full bg-overlay/5 px-2 py-1 text-[11px] text-text-muted">Illustration · example data</span></div>
+    <div className="p-4 sm:p-6">
+      <div className="overflow-hidden rounded-xl border border-overlay/15 bg-bg-surface shadow-sm" aria-hidden="true">
+        <div className="flex items-center gap-2 border-b border-overlay/10 px-4 py-3"><Box size={15} className="text-accent-cyan"/><span className="text-xs font-semibold text-text-primary">{step.screen === 'support' ? 'HRM Support' : 'IntuneGet'}</span><span className="ml-auto text-xs text-text-muted">{screen.label}</span></div>
+        <div className="flex">
+          <div className={`${step.screen === 'support' ? 'hidden' : 'hidden sm:flex'} w-12 shrink-0 flex-col items-center gap-3 border-r border-overlay/10 bg-overlay/[0.02] py-5`}>{RAIL.map((group, index) => <div key={index} className={`flex flex-col items-center gap-3 ${index > 0 ? 'border-t border-overlay/10 pt-3' : ''}`}>{group.map(({ screens, icon: Icon }, item) => <Icon key={item} size={16} className={screens.includes(step.screen) ? 'text-accent-cyan' : 'text-text-muted'}/>)}</div>)}</div>
+          <div className="min-w-0 flex-1 p-4 sm:p-5">
+            {focusAtHeading && target}
+            {location && <p className="mb-3 text-xs font-medium leading-relaxed text-accent-cyan">{location}</p>}
+            <div className="mb-4 flex items-center justify-between gap-3"><span className="text-sm font-semibold text-text-primary">{heading}</span>{step.screen === 'updates' && <span className="text-[11px] text-text-muted">Deploying ≠ installing</span>}</div>
+            {['catalog', 'discovered'].includes(step.screen) && <div className="mb-4 flex items-center gap-2 rounded-lg border border-overlay/10 bg-overlay/[0.02] px-3 py-2 text-xs text-text-muted"><Search size={13}/>Search apps</div>}
+            {['catalog', 'inventory', 'discovered', 'deployments', 'deployment-list', 'updates'].includes(step.screen) && <div className="mb-3 flex items-center gap-3"><span className="rounded-xl bg-accent-cyan/10 p-2.5 text-accent-cyan"><Package size={20}/></span><div className="min-w-0"><p className="text-sm font-medium text-text-primary">Example app</p><p className="mt-1 text-xs text-text-muted">{step.screen === 'deployments' ? 'Deployment history' : 'Deployment configuration'}</p></div></div>}
+            {['catalog', 'deployment-list'].includes(step.screen) && <>{row('Who gets it', 'Pilot device group')}{row('When a new version comes out', 'Notify only')}</>}
+            {step.screen === 'updates' && <>{row('Update schedule', 'Deploys to Intune Mon to Fri, 7 PM to 5 AM · On')}{row('Installation timing', 'Users can postpone · 3 days')}{row('Startup install results', 'No reports yet · Beta')}</>}
+            {step.screen === 'inventory' && (actionsPanel ? <>{row('Install results', 'Check received reports')}{target}{row('Groups', isRemoval ? 'Review removal assignments' : 'Required / Available')}</> : <>{row('Groups', isRemoval ? 'Review removal assignments' : 'Required / Available')}{row('Install results', 'Check received reports')}</>)}
+            {step.screen === 'discovered' && row('App found on computers', 'Review match and eligibility')}
+            {step.screen === 'deployments' && <div className="my-4 rounded-lg border border-overlay/10 bg-overlay/[0.02] p-3"><p className="text-xs font-medium text-text-primary">Deployment outcome</p><p className="mt-1 text-xs leading-relaxed text-text-muted">Read the recorded status. Installing on computers is a separate result.</p></div>}
+            {step.screen === 'settings' && <>{row('Appearance', 'Your preference')}{row('Notifications', 'Review configuration')}</>}
+            {step.screen === 'server' && (needsAttention ? row('Needs attention', 'Example app needs a look') : <>{row('Server status', '1 needs a look')}{row('Intune self-test', 'Failing · reason shown')}{row('Version', 'Example version')}{row('All checks', '9 working')}</>)}
+            {step.screen === 'support' && <div className="my-4 space-y-3 rounded-lg border border-overlay/10 p-3 text-xs text-text-muted"><p>App and version</p><p>What you tried</p><p>Result or error code</p></div>}
+            {!focusAtHeading && !focusAtRow && !actionsPanel && target}
+
+            <p className="mt-3 text-[11px] leading-relaxed text-text-muted">Layout simplified to show the control you need.</p>
+          </div>
+        </div>
+      </div>
+      <figcaption className="mt-5 flex items-start gap-2.5 text-sm leading-relaxed text-text-secondary"><span className="mt-0.5 shrink-0 text-accent-cyan"><Circle size={15}/></span><span>{step.screen === 'support' ? <>Open <strong className="font-semibold text-text-primary">HRM Support</strong> and include the evidence listed in this step.</> : <>Look for <strong className="font-semibold text-text-primary">{step.focus}</strong> in {screen.label}.</>}</span></figcaption>
+    </div>
+    <div className="flex items-center gap-2 border-t border-overlay/10 px-4 py-3 text-xs text-text-muted"><Check size={13} className="shrink-0"/>Exploring this guide does not change your apps.</div>
+  </figure>;
+}
