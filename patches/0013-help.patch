+++ b/lib/hrm/__tests__/help-guides.test.ts
@@ -0,0 +1,106 @@
+import { existsSync, readFileSync, readdirSync } from 'node:fs';
+import path from 'node:path';
+import { describe, expect, it } from 'vitest';
+import { HELP_SECTIONS } from '../help-content';
+import { HELP_CATEGORIES, HELP_GUIDES } from '../help-guides';
+
+const words = (value: string) => value.trim().split(/\s+/).length;
+const guide = (id: string) => HELP_GUIDES.find(item => item.id === id)!;
+const prose = (id: string) => {
+  const item = guide(id);
+  return [item.summary, ...item.before, ...item.steps.flatMap(step => [step.instruction, step.result]), item.success, item.caution, ...item.troubleshoot.flatMap(issue => [issue.problem, issue.action])].join(' ');
+};
+
+describe('task-based Help guide integrity', () => {
+  it('preserves every existing deep link and groups each reference rule exactly once', () => {
+    const ids = HELP_GUIDES.map(item => item.id);
+    expect(new Set(ids).size).toBe(ids.length);
+    expect([...ids].sort()).toEqual(HELP_SECTIONS.map(item => item.id).sort());
+    for (const section of HELP_SECTIONS) {
+      const groups = guide(section.id).referenceGroups;
+      expect(groups.length).toBeGreaterThan(0);
+      const indexes = groups.flatMap(group => group.indexes);
+      expect(indexes.length, section.id).toBe(section.points.length);
+      expect([...indexes].sort((a, b) => a - b), section.id).toEqual(section.points.map((_, index) => index));
+      for (const group of groups) {
+        expect(group.title.trim()).not.toBe('');
+        expect(group.title).not.toMatch(/part\s*\d/i);
+        expect(group.indexes.length).toBeGreaterThan(0);
+      }
+    }
+  });
+
+  it('keeps the primary workflow concise and every step tied to an explicit screen and outcome', () => {
+    const categories = HELP_CATEGORIES.map(item => item.id);
+    expect(new Set(categories).size).toBe(5);
+    const screens = ['catalog', 'deployment-list', 'updates', 'inventory', 'deployments', 'discovered', 'settings', 'server', 'support', 'reports'];
+    for (const item of HELP_GUIDES) {
+      expect(categories).toContain(item.category);
+      expect(words(item.summary), item.id).toBeLessThanOrEqual(22);
+      expect(item.before.length, item.id).toBeLessThanOrEqual(2);
+      expect(item.steps.length, item.id).toBeGreaterThanOrEqual(3);
+      expect(item.steps.length, item.id).toBeLessThanOrEqual(6);
+      expect(item.keywords.length).toBeGreaterThan(0);
+      expect(item.success.trim()).not.toBe('');
+      for (const step of item.steps) {
+        expect(words(step.instruction), `${item.id}: ${step.title}`).toBeLessThanOrEqual(35);
+        expect(words(step.result), `${item.id}: ${step.title}`).toBeLessThanOrEqual(25);
+        expect(screens).toContain(step.screen);
+        expect(step.focus.trim()).not.toBe('');
+        expect(step.title.trim()).not.toBe('');
+      }
+    }
+  });
+
+  it('links only to existing guides, real app routes and HRM Support', () => {
+    const ids = HELP_GUIDES.map(item => item.id);
+    for (const item of HELP_GUIDES) {
+      for (const id of [...item.related, ...item.troubleshoot.flatMap(issue => issue.guide ? [issue.guide] : [])]) {
+        expect(ids, item.id).toContain(id);
+        expect(id).not.toBe(item.id);
+      }
+      expect(item.start.label.trim()).not.toBe('');
+      if (item.start.href === 'https://support.hruthmd.org') continue;
+      expect(item.start.href).toMatch(/^\/dashboard(?:\/|$)/);
+      expect(item.start.href).not.toMatch(/[?#]/);
+      expect(existsSync(path.join(process.cwd(), 'app/(app)', item.start.href, 'page.tsx')), item.start.href).toBe(true);
+    }
+  });
+
+  it('uses illustration focus labels present in actual app components', () => {
+    const collect = (directory: string): string[] => readdirSync(directory, { withFileTypes: true }).flatMap(entry => {
+      const file = path.join(directory, entry.name);
+      if (entry.isDirectory()) return collect(file);
+      return entry.name.endsWith('.tsx') && !entry.name.includes('.test.') && !file.includes('/help/') ? [readFileSync(file, 'utf8')] : [];
+    });
+    const uiSource = [...collect(path.join(process.cwd(), 'components')), ...collect(path.join(process.cwd(), 'app'))].join('\n');
+    for (const item of HELP_GUIDES) for (const step of item.steps) expect(uiSource, `${item.id}: ${step.focus}`).toContain(step.focus);
+  });
+
+  it('retains the important deployment, pilot, Beta and script-reporting distinctions', () => {
+    expect(prose('deploying')).toContain('Deployed to Intune does not mean computers have installed');
+    expect(prose('pilot-rollouts')).toContain('no wider rollout happens without your approval');
+    expect(guide('remove-discovered').title).toBe('Remove an app found on computers');
+    expect(prose('updating')).toContain('Set them again with Availability and deadline in Inventory');
+    expect(prose('pilot-rollouts')).toContain('not verified pilot-group members');
+    expect(prose('startup-beta')).toContain('Windows pilot testing required');
+    expect(prose('startup-beta')).toContain('No forced restart, login trigger or three-day deadline');
+    expect(prose('automatic-installation-policy')).toContain('first install attempt and isn’t reported in Update history');
+    expect(prose('update-schedule')).toContain('Update schedule does not set when computers install');
+    expect(prose('update-schedule')).toContain('Leaving it unchecked means unrestricted hours, not automatic updates off');
+    expect(prose('update-schedule')).toContain('Pause automatic updates');
+    expect(prose('update-schedule')).toContain('Resume automatic updates');
+    expect(prose('update-schedule')).toContain('3:30 AM and 3:30 PM');
+    expect(prose('update-schedule')).toContain('queued work and manual updates are not cancelled');
+    expect(prose('automatic-installation-policy')).toContain('Installation timing row in the status strip');
+    expect(prose('remove-discovered')).toContain('platform script');
+    expect(prose('remove-discovered')).toContain('inspect execution results in Intune');
+    expect(prose('remove-discovered')).toContain('does not prove a separate removal script ran');
+    expect(guide('reports').steps[0].screen).toBe('reports');
+    expect(prose('reports')).toContain('Choose Cancelled for cancellations; these are not counted as Failed');
+    expect(prose('reports')).toContain('Active has no clear action');
+    expect(prose('reports')).toContain('Only your matching finished deployments are hidden; audit and update records remain');
+    expect(prose('reports')).toContain('History controls do not stop active deployments or hide other staff’s records');
+    expect(guide('install-results').steps.find(step => step.focus === 'Check groups')?.screen).toBe('server');
+  });
+});
diff --git a/lib/hrm/__tests__/help-navigation.test.ts b/lib/hrm/__tests__/help-navigation.test.ts
