+import { expect, it } from 'vitest';
+import { helpGuideFromHash, searchHelpGuides } from '../help-navigation';
+it('finds tasks from questions, synonyms and detailed setup rules', () => {
+  expect(searchHelpGuides('how do I restart')[0].id).toBe('startup-beta');
+  expect(searchHelpGuides('HRM_STARTUP_REPORT_SCRIPT_ID').some(guide => guide.id === 'startup-beta')).toBe(true);
+  expect(searchHelpGuides('uninstall').some(guide => guide.id === 'remove-discovered')).toBe(true);
+  expect(searchHelpGuides('zzunknownphrase')).toEqual([]);
+});
+it('filters categories without dropping a matching query or including other categories', () => {
+  const guides = searchHelpGuides('timing', 'updates');
+  expect(guides.length).toBeGreaterThan(0);
+  expect(guides.every(guide => guide.category === 'updates')).toBe(true);
+});
+it('resolves original bookmarks and safely rejects unknown or malformed hashes', () => {
+  expect(helpGuideFromHash('#installation-timing')).toBe('installation-timing');
+  expect(helpGuideFromHash('#startup-beta')).toBe('startup-beta');
+  expect(helpGuideFromHash('#unknown')).toBeNull();
+  expect(helpGuideFromHash('#%E0%A4%A')).toBeNull();
+  expect(helpGuideFromHash('')).toBeNull();
+});
+
+it('finds shared pause and unrestricted-hours guidance without changing the original bookmark', () => {
+  expect(searchHelpGuides('pause automatic updates')[0].id).toBe('update-schedule');
+  expect(searchHelpGuides('schedule off')[0].id).toBe('update-schedule');
+  expect(helpGuideFromHash('#update-schedule')).toBe('update-schedule');
+  expect(searchHelpGuides('availability and deadline')[0].id).toBe('installation-timing');
+  // Staff used to say publish; the old word still finds the renamed guides.
+  expect(searchHelpGuides('pause automatic publishing')[0].id).toBe('update-schedule');
+});
+
+it('finds workspace and unavailable employee choices while preserving policy bookmarks', () => {
+  expect(searchHelpGuides('next rollout').some(guide => guide.id === 'automatic-installation-policy')).toBe(true);
+  expect(searchHelpGuides('employee choose time').some(guide => guide.id === 'automatic-installation-policy')).toBe(true);
+  expect(searchHelpGuides('scheduling blackout').some(guide => guide.id === 'update-schedule')).toBe(true);
+  expect(helpGuideFromHash('#automatic-installation-policy')).toBe('automatic-installation-policy');
+});
+
+it('finds current workspace labels without changing bookmarks', () => {
+  for (const query of ['Current release', 'Next automatic update', 'What employees see', 'Timing and policy details']) expect(searchHelpGuides(query).some(guide => guide.id === 'automatic-installation-policy')).toBe(true);
+});
+
+it('keeps primary navigation and original page names searchable', () => {
+  for (const query of ['Apps Inventory', 'Inventory Details']) expect(searchHelpGuides(query).some(guide => guide.id === 'install-results')).toBe(true);
+  for (const query of ['Updates', 'App updates']) expect(searchHelpGuides(query).some(guide => guide.id === 'automatic-installation-policy')).toBe(true);
+  for (const query of ['Activity Reports', 'Deployments']) expect(searchHelpGuides(query).some(guide => guide.id === 'reports')).toBe(true);
+  for (const id of ['your-settings', 'reports', 'install-results']) expect(helpGuideFromHash(`#${id}`)).toBe(id);
+});
+
+it('finds restart pilot save and start separately with its original bookmark', () => {
+  for (const query of ['Find a pilot group', 'Start restart Beta pilot', 'saved target', 'broad automatic updates held']) expect(searchHelpGuides(query).some(guide => guide.id === 'startup-beta')).toBe(true);
+  expect(helpGuideFromHash('#startup-beta')).toBe('startup-beta');
+});
+
+it('finds manual bulk review and date choices with the existing updating bookmark', () => {
+  for (const query of ['bulk review', 'past dates', 'reset dates', 'Send update to Intune']) expect(searchHelpGuides(query).some(guide => guide.id === 'updating')).toBe(true);
+  expect(helpGuideFromHash('#updating')).toBe('updating');
+});
+
+it('retains old refresh and schedule aliases for the clarified controls', () => {
+  for (const query of ['Refresh', 'Check for app updates', 'Automatic update policy']) expect(searchHelpGuides(query).some(guide => guide.id === 'updates')).toBe(true);
+  expect(searchHelpGuides('Refresh pilot status').some(guide => guide.id === 'pilot-rollouts')).toBe(true);
+  for (const query of ['Edit schedule', 'Automatic update delivery', 'Automatic publishing window', 'Edit publishing window']) expect(searchHelpGuides(query).some(guide => guide.id === 'update-schedule')).toBe(true);
+});
+
+it('finds current Curated eligibility guidance without changing deployment bookmarks', () => {
+  for (const query of ['security hold', 'eligibility unavailable', 'installer hash']) expect(searchHelpGuides(query).some(guide => guide.id === 'deploying')).toBe(true);
+  expect(helpGuideFromHash('#deploying')).toBe('deploying');
+});
