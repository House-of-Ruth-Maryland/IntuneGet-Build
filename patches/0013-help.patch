+// @vitest-environment happy-dom
+import { act, createElement } from 'react';
+import { createRoot, type Root } from 'react-dom/client';
+import { afterEach, beforeEach, expect, it } from 'vitest';
+import { HelpWorkspace } from './HelpWorkspace';
+let root: Root;
+(globalThis as typeof globalThis & { IS_REACT_ACT_ENVIRONMENT: boolean }).IS_REACT_ACT_ENVIRONMENT = true;
+const button = (label: string) => [...document.querySelectorAll('button')].find(item => item.textContent === label)!;
+beforeEach(() => { window.history.replaceState(null, '', '/dashboard/help'); const node = document.createElement('div'); document.body.append(node); root = createRoot(node); });
+afterEach(async () => { await act(async () => root.unmount()); document.body.innerHTML = ''; window.history.replaceState(null, '', '/dashboard/help'); });
+it('starts with task choices rather than mounting every long-form section', async () => {
+  await act(async () => root.render(createElement(HelpWorkspace)));
+  expect(document.querySelectorAll('article')).toHaveLength(0);
+  expect(document.querySelectorAll('[href="#deploying"]').length).toBeGreaterThan(0);
+  expect(document.body.textContent).not.toContain('HRM_STARTUP_REPORT_SCRIPT_ID');
+});
+it('opens original bookmarks and synchronizes the visual with the selected step', async () => {
+  window.history.replaceState(null, '', '/dashboard/help#deploying');
+  await act(async () => root.render(createElement(HelpWorkspace)));
+  expect(document.querySelector('article')?.id).toBe('deploying');
+  const first = document.querySelector('[aria-label^="Visual reference:"]')!.getAttribute('aria-label');
+  expect(document.querySelector('[aria-current="step"]')?.textContent).toContain('Choose the app');
+  await act(async () => button('Next step').click());
+  expect(document.querySelector('[aria-current="step"]')?.textContent).toContain('Choose who gets it');
+  expect(document.querySelector('[aria-label^="Visual reference:"]')!.getAttribute('aria-label')).not.toBe(first);
+  expect(document.querySelector('[aria-label^="Visual reference:"]')!.getAttribute('aria-label')).toContain('Who gets it');
+  expect([...document.querySelectorAll('details')].every(item => !item.open)).toBe(true);
+  expect(button('Open App catalog')).toBeUndefined();
+  expect(document.querySelector('[data-help-app-link][href="/dashboard/apps"]')).not.toBeNull();
+});
+it('follows related guide links, resets the step, and respects browser history', async () => {
+  window.history.replaceState(null, '', '/dashboard/help#deploying');
+  await act(async () => root.render(createElement(HelpWorkspace)));
+  await act(async () => button('Next step').click());
+  const related = document.querySelector<HTMLAnchorElement>('nav[aria-label="Related help guides"] [href="#install-results"]')!;
+  await act(async () => related.click());
+  expect(window.location.hash).toBe('#install-results');
+  expect(document.querySelector('article')?.id).toBe('install-results');
+  expect(document.querySelector('[aria-current="step"]')?.textContent).toMatch(/^1/);
+  await act(async () => { window.history.replaceState(null, '', '/dashboard/help#deploying'); window.dispatchEvent(new PopStateEvent('popstate')); });
+  expect(document.querySelector('article')?.id).toBe('deploying');
+  await act(async () => button('All guides').click());
+  expect(window.location.hash).toBe('');
+  expect(document.querySelectorAll('article')).toHaveLength(0);
+});
+it('finishes support instructions at HRM Support and keeps app links in a separate tab', async () => {
+  window.history.replaceState(null, '', '/dashboard/help#support');
+  await act(async () => root.render(createElement(HelpWorkspace)));
+  await act(async () => button('Next step').click());
+  await act(async () => button('Next step').click());
+  const support = [...document.querySelectorAll<HTMLAnchorElement>('article [data-help-app-link]')].find(link => link.textContent?.startsWith('Open HRM Support'));
+  expect(support?.getAttribute('href')).toBe('https://support.hruthmd.org');
+  for (const link of document.querySelectorAll<HTMLAnchorElement>('article [data-help-app-link]')) {
+    expect(link.target).toBe('_blank');
+    expect(link.rel).toContain('noopener');
+  }
+});
+
+it('shows shared pause separately from per-app Auto-update and Installation timing', async () => {
+  window.history.replaceState(null, '', '/dashboard/help#update-schedule');
+  await act(async () => root.render(createElement(HelpWorkspace)));
+  expect(document.querySelector('[aria-label^="Visual reference:"]')?.getAttribute('aria-label')).toContain('Auto-update');
+  await act(async () => button('Next step').click());
+  const visual=document.querySelector('[aria-label^="Visual reference:"]')!;
+  expect(visual.getAttribute('aria-label')).toContain('Pause automatic updates');
+  expect(visual.textContent).toContain('Update schedule');
+  expect(visual.textContent).toContain('Installation timing');
+  expect(visual.textContent).not.toContain('Automatic publishing');
+  expect(visual.textContent).not.toContain('Auto-update installation timing');
+  expect(document.querySelector('[aria-label="Current step"]')?.textContent).toContain('queued work and manual updates are not cancelled');
+});
+it('shows Inventory panels under Actions and the Reports page heading (HRM patch 0053)', async () => {
+  window.history.replaceState(null, '', '/dashboard/help#retire');
+  await act(async () => root.render(createElement(HelpWorkspace)));
+  let visual = document.querySelector('[aria-label^="Visual reference:"]')!;
+  expect(visual.getAttribute('aria-label')).toContain('Retire app');
+  expect(visual.textContent).toContain('App details · Actions · Retire app');
+  await act(async () => root.unmount());
+  root = createRoot(document.body.appendChild(document.createElement('div')));
+  window.history.replaceState(null, '', '/dashboard/help#reports');
+  await act(async () => root.render(createElement(HelpWorkspace)));
+  visual = document.querySelector('[aria-label^="Visual reference:"]')!;
+  expect(visual.getAttribute('aria-label')).toContain('My deployment reports');
+  expect(visual.textContent).toContain('My deployment reports');
+  expect(visual.textContent).toContain('Reports');
+});
+it('places App updates steps in the status strip and Edit schedule, and Home steps in Needs attention (HRM patch 0058)', async () => {
+  window.history.replaceState(null, '', '/dashboard/help#update-schedule');
+  await act(async () => root.render(createElement(HelpWorkspace)));
+  await act(async () => button('Next step').click());
+  let visual = document.querySelector('[aria-label^="Visual reference:"]')!;
+  expect(visual.textContent).toContain('Status strip · Update schedule · Edit schedule');
+  expect(visual.textContent).toContain('Startup install results');
+  expect(visual.textContent).not.toContain('Automatic updates ·');
+  await act(async () => root.unmount());
+  root = createRoot(document.body.appendChild(document.createElement('div')));
+  window.history.replaceState(null, '', '/dashboard/help#old-copies');
+  await act(async () => root.render(createElement(HelpWorkspace)));
+  visual = document.querySelector('[aria-label^="Visual reference:"]')!;
+  expect(visual.getAttribute('aria-label')).toContain('Open app');
+  expect(visual.textContent).toContain('Home · Needs attention');
+  await act(async () => root.unmount());
+  root = createRoot(document.body.appendChild(document.createElement('div')));
+  window.history.replaceState(null, '', '/dashboard/help#server');
+  await act(async () => root.render(createElement(HelpWorkspace)));
+  visual = document.querySelector('[aria-label^="Visual reference:"]')!;
+  expect(visual.textContent).toContain('All checks');
+  expect(visual.textContent).toContain('Failing · reason shown');
+});
