+    links: [{ label: 'Open Inventory', href: '/dashboard/inventory' }, { label: 'How old copies are removed', href: '/dashboard/help#old-copies' }],
+  },
+  {
+    id: 'installation-timing',
+    title: 'Availability and deadline',
+    uiLabels: ['Inventory', 'Actions', 'App updates', 'Availability and deadline', 'Reload dates', 'Reload from Intune', 'What these dates change', 'App availability', 'Installation deadline', 'Restart grace period', 'Save to Intune', 'Installation timing'],
+    flow: ['Open the app in Inventory', 'Press Availability and deadline', 'Press Reload dates', 'Choose assignment and dates', 'Press Save to Intune'],
+    points: [
+      'Open the app in Inventory and press Availability and deadline under Actions, or press it on the app\'s card in App updates. In the panel on the right, press Reload dates to read its current Required and Available groups.',
+      'Choose one assignment. App availability controls when Required apps can download or Available apps appear in Company Portal. Leave the date blank for as soon as possible.',
+      'For Required groups, Installation deadline controls when installation starts. Leave it blank to install after availability. Another assignment with an earlier deadline can take priority.',
+      'Choose Device local time for each computer’s clock, or UTC for one shared time. Changing the time zone keeps the entered clock times, so check the dates before saving.',
+      'Restart grace period delays an Intune-managed restart after installation. The app must use return-code restart behavior or a mandatory restart. An installer can still force its own restart.',
+      'With return-code restart behavior, grace applies to hard reboots. A soft reboot result only shows a notification.',
