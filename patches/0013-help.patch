@@ -0,0 +1,26 @@
+import { HELP_GUIDES, type HelpCategory } from './help-guides';
+import { HELP_SECTIONS } from './help-content';
+
+const STOP_WORDS = new Set(['why', 'which', 'isnt', 'cant', 'wont', 'not', 'need', 'want', 'will', 'should', 'did', 'didnt', 'have', 'has', 'a', 'an', 'and', 'are', 'can', 'do', 'does', 'for', 'how', 'i', 'in', 'is', 'it', 'me', 'my', 'of', 'on', 'the', 'to', 'what', 'when', 'where', 'with']);
+const normalise = (value: string) => value.toLowerCase().replace(/[’']/g, '').replace(/[^a-z0-9]+/g, ' ').trim();
+
+/** Local search only: no questions, tenant details or search terms leave the page. */
+export function searchHelpGuides(query: string, category: HelpCategory | 'all' = 'all') {
+  const aliases: Record<string, string> = { installing: 'install', installed: 'install', installation: 'install', updating: 'update', updates: 'update', publish: 'deploy', publishing: 'deploy', published: 'deploy', deploying: 'deploy', deployed: 'deploy' };
+  const terms = normalise(query).split(' ').filter(word => word && !STOP_WORDS.has(word)).map(word => aliases[word] ?? word);
+  return HELP_GUIDES.flatMap((guide, index) => {
+    if (category !== 'all' && guide.category !== category) return [];
+    const title = normalise(guide.title);
+    const keywords = normalise(guide.keywords.join(' '));
+    const body = normalise([guide.summary, ...guide.before, guide.success, guide.caution ?? '', ...guide.steps.flatMap(step => [step.title, step.instruction, step.focus, step.result]), ...guide.troubleshoot.flatMap(item => [item.problem, item.action]), ...(HELP_SECTIONS.find(section => section.id === guide.id)?.points ?? [])].join(' '));
+    if (!terms.every(term => `${title} ${keywords} ${body}`.includes(term))) return [];
+    return [{ guide, score: terms.reduce((score, term) => score + (title.includes(term) ? 6 : 0) + (keywords.includes(term) ? 3 : 0), 0), index }];
+  }).sort((a, b) => b.score - a.score || a.index - b.index).map(result => result.guide);
+}
+
+export function helpGuideFromHash(hash: string): string | null {
+  try {
+    const id = decodeURIComponent(hash.replace(/^#/, ''));
+    return HELP_GUIDES.some(guide => guide.id === id) ? id : null;
+  } catch { return null; }
+}
