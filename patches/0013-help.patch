+  updates: { primary: 'Updates', label: 'App updates', href: '/dashboard/updates' },
+  inventory: { primary: 'Apps', pages: ['Inventory', 'App catalog', 'Discovered apps'], label: 'Inventory', href: '/dashboard/inventory' },
+  deployments: { primary: 'Activity', pages: ['Deployments', 'Reports'], label: 'Deployments', href: '/dashboard/uploads' },
+  discovered: { primary: 'Apps', pages: ['Inventory', 'App catalog', 'Discovered apps'], label: 'Discovered apps', href: '/dashboard/unmanaged' },
+  settings: { label: 'Settings', href: '/dashboard/settings' },
+  server: { label: 'Home', href: '/dashboard' },
+  support: { label: 'HRM Support', href: HRM_SUPPORT_URL },
+  reports: { primary: 'Activity', pages: ['Deployments', 'Reports'], label: 'Reports', href: '/dashboard/reports', heading: 'Deployment reports' },
+};
+
+/** Primary navigation; secondary pages stay inside Apps and Activity. */
+const RAIL: { screens: HelpScreen[]; icon: LucideIcon; label: string }[][] = [
+  [{ screens: ['server'], icon: LayoutDashboard, label: 'Home' },
+   { screens: ['catalog', 'deployment-list', 'inventory', 'discovered'], icon: Package, label: 'Apps' },
+   { screens: ['updates'], icon: ArrowUpCircle, label: 'Updates' },
+   { screens: ['deployments', 'reports'], icon: Rocket, label: 'Activity' },
+   { screens: ['settings'], icon: Server, label: 'Settings' }],
+  [{ screens: [], icon: LifeBuoy, label: 'Help' }],
+];
+
+function ExampleRow({ label, value }: { label: string; value: string }) {
+  return <div className="flex items-center justify-between gap-3 border-b border-overlay/10 py-3 text-xs"><span className="text-text-muted">{label}</span><span className="text-text-secondary">{value}</span></div>;
+}
+
+/** A schematic built from app labels, never a screenshot of a tenant or a live action. */
