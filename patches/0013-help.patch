+it('separates saving a restart pilot target from starting deployment', () => {
+  const guide = HELP_GUIDES.find(item => item.id === 'startup-beta')!;
+  const text = JSON.stringify(guide);
+  for (const label of ['Find a pilot group', 'Save for this app', 'Start restart Beta pilot', 'Required', 'existing wider assignments', 'Broad automatic updates are held', 'real Intune delivery remains unverified']) expect(text).toContain(label);
+  expect(guide.steps.findIndex(step => step.focus === 'Save for this app')).toBeLessThan(guide.steps.findIndex(step => step.focus === 'Start restart Beta pilot'));
+});
+
+it('places manual settings review before the distinct start control', () => {
+  const guide = HELP_GUIDES.find(item => item.id === 'updating')!;
+  expect(guide.steps[1].focus).toBe('Effective update settings');
+  expect(guide.steps[2].focus).toBe('Send update to Intune');
