+  const isRemoval = ['retire', 'remove-discovered'].includes(guideId);
+  const action = /^(Open|Save|Deploy|Add|Remove|Check|Update|Review|Approve|End|Go back|Keep|Delete|Reload|Retry|Download|Contact|Turn|Edit|Find|Show|Clear|Pause|Resume)/i.test(step.focus) || step.focus === 'Install dates';
+  const target = (<div className="relative my-4 rounded-xl border-2 border-accent-cyan bg-accent-cyan/5 p-3.5"><span className="absolute -left-2.5 -top-2.5 flex h-6 w-6 items-center justify-center rounded-full bg-accent-cyan text-xs font-bold text-bg-deep">{number}</span><div className={`flex min-h-10 items-center justify-between gap-3 rounded-lg px-3 py-2 text-sm font-semibold ${action ? 'bg-accent-cyan/15 text-text-primary' : 'border border-overlay/15 bg-bg-surface text-text-primary'}`}><span>{step.focus}</span>{action ? <ArrowRight size={16} className="shrink-0 text-accent-cyan"/> : <ChevronDown size={15} className="shrink-0 text-text-muted"/>}</div></div>);
+  // Home: task guides about apps show Needs attention; the server guide shows Server status (patch 0058 layout 3B).
+  const needsAttention = step.screen === 'server' && guideId !== 'server';
+  const installSettings = guideId === 'install-settings';
+  const rowLabels: Partial<Record<HelpScreen, string[]>> = { catalog: ['Who gets it', 'When a new version comes out'], 'deployment-list': ['Who gets it', 'When a new version comes out'], updates: ['When can IntuneGet send automatic updates to Intune?', 'Installation timing', 'Startup install results'], inventory: ['Current release', 'Who gets it', 'Install results', 'Next automatic update', 'App activity'], discovered: ['App found on computers'], settings: ['Appearance', 'Notifications'], server: needsAttention ? ['Needs attention'] : ['Server status', 'Intune self-test', 'Version', 'All checks'] };
+  const heading = screen.heading ?? screen.label;
+  const focusAtHeading = step.focus === heading;
+  // Inventory app details: Install dates, Previous version and Retire app sit under Actions, between Install results and Groups.
+  const actionsPanel = step.screen === 'inventory' ? ({ rollback: 'Previous version', retire: 'Retire app' } as Record<string, string>)[guideId] : undefined;
+  const focusAtRow = manualReview || restartEditor || (installSettings && ['Toolkit windows', 'App setup and checks', 'Staff experience'].includes(step.focus)) || rowLabels[step.screen]?.includes(step.focus);
+  const row = (label: string, value: string) => step.focus === label ? target : <ExampleRow label={label} value={value}/>;
+  // App updates: publishing controls and Installation timing are separate; discovery is in Settings.
+  const scheduleDialog = ['Pause automatic updates', 'Edit publishing window', 'Restrict deploying to selected days and hours', 'Add blackout'].includes(step.focus);
+  const location = step.focus === 'Check for app updates' ? 'Updates · header · may start enabled automatic updates' : manualReview ? 'Updates · Review update or Update all · read-only assignment review' : restartEditor ? 'Apps · App workspace · Edit next rollout · app exception · requires enabled validated startup workflow' : step.screen === 'catalog' && !focusAtHeading ? 'App configuration · panel on the right' : needsAttention ? 'Home · Needs attention' : guideId === 'installation-timing' && step.screen === 'inventory' ? 'App workspace · Current release · Install dates' : step.focus === 'Check installs now' ? 'App details · Install results' : actionsPanel ? `Inventory · Details · Actions · ${actionsPanel}` : step.focus === 'Installation policy for this release' ? 'Update history · expanded version' : guideId === 'automatic-installation-policy' ? (step.screen === 'inventory' ? 'App workspace · Edit next rollout' : 'App updates · Open app workspace') : scheduleDialog ? 'App updates · When can IntuneGet send automatic updates to Intune? · Edit publishing window' : step.screen === 'updates' && ['Auto-update', 'Update', 'Test with a pilot group'].includes(step.focus) ? 'Available updates · app card' : guideId === 'startup-beta' && step.screen === 'updates' ? 'Status strip · Startup install results · Beta' : step.screen === 'updates' && step.focus === 'Update schedule' ? 'App updates · status strip' : null;
+  return <figure className="min-w-0 overflow-hidden rounded-2xl border border-overlay/10 bg-bg-elevated" aria-label={`Visual reference: ${screen.label}, ${step.focus}`}>
