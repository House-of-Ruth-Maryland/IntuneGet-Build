+++ b/lib/hrm/__tests__/help-navigation.test.ts
@@ -0,0 +1,29 @@
+import { expect, it } from 'vitest';
+import { helpGuideFromHash, searchHelpGuides } from '../help-navigation';
+it('finds tasks from questions, synonyms and detailed setup rules', () => {
+  expect(searchHelpGuides('how do I restart')[0].id).toBe('startup-beta');
+  expect(searchHelpGuides('HRM_STARTUP_REPORT_SCRIPT_ID').some(guide => guide.id === 'startup-beta')).toBe(true);
+  expect(searchHelpGuides('uninstall').some(guide => guide.id === 'remove-discovered')).toBe(true);
+  expect(searchHelpGuides('zzunknownphrase')).toEqual([]);
+});
+it('filters categories without dropping a matching query or including other categories', () => {
+  const guides = searchHelpGuides('timing', 'updates');
+  expect(guides.length).toBeGreaterThan(0);
+  expect(guides.every(guide => guide.category === 'updates')).toBe(true);
+});
+it('resolves original bookmarks and safely rejects unknown or malformed hashes', () => {
+  expect(helpGuideFromHash('#installation-timing')).toBe('installation-timing');
+  expect(helpGuideFromHash('#startup-beta')).toBe('startup-beta');
+  expect(helpGuideFromHash('#unknown')).toBeNull();
+  expect(helpGuideFromHash('#%E0%A4%A')).toBeNull();
+  expect(helpGuideFromHash('')).toBeNull();
+});
+
+it('finds shared pause and unrestricted-hours guidance without changing the original bookmark', () => {
+  expect(searchHelpGuides('pause automatic updates')[0].id).toBe('update-schedule');
+  expect(searchHelpGuides('schedule off')[0].id).toBe('update-schedule');
+  expect(helpGuideFromHash('#update-schedule')).toBe('update-schedule');
+  expect(searchHelpGuides('availability and deadline')[0].id).toBe('installation-timing');
+  // Staff used to say publish; the old word still finds the renamed guides.
+  expect(searchHelpGuides('pause automatic publishing')[0].id).toBe('update-schedule');
+});
