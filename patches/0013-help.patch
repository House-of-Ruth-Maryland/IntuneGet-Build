+            {step.screen === 'updates' && (manualReview ? <>{row('Effective update settings', 'Example app · version 1 to 2')}{row('Saved app settings', 'Saved installer behavior · restart suppressed')}{row('Groups', 'Example pilot group · Required')}{row('Confirm replacement deadlines', 'Paused for IT')}{row('Retain the existing deadlines', 'Availability and other settings stay unchanged')}{row('Choose a new deadline', 'Future date for affected required assignments')}{row('Send update to Intune', 'Single app; bulk uses Update all')}<p className="mt-3 text-xs text-text-muted">Expired required deadlines need explicit IT confirmation. Single app uses Send update to Intune; bulk uses Update all. Reviewing starts nothing. Device installation follows assignments and check-in.</p></> : <>{row('When can IntuneGet send automatic updates to Intune?', 'Review pause, hours and blackouts')}{row('Installation timing', 'Users can postpone · 3 days')}{row('Startup install results', 'No reports yet · Beta')}{guideId === 'updates' && step.focus !== 'Check for app updates' && <ExampleRow label="Check for app updates" value="May start enabled automatic updates"/>}{guideId === 'pilot-rollouts' && <ExampleRow label="Refresh pilot status" value="Read pilot status only"/>}</>)}
+            {step.screen === 'inventory' && (restartEditor ? <>{row('Install after next restart · Beta', 'App-scoped pilot only')}{row('Find a pilot group', 'Example pilot security group')}{row('Save for this app', 'Saves rule and target; no deployment')}{row('Saved target', 'Example pilot security group')}{row('Start restart Beta pilot', 'Required for selected group only')}<p className="mt-3 text-xs text-text-muted">Broad automatic updates held. Previous wider assignments remain intact. Local startup testing only; Intune delivery unverified.</p></> : actionsPanel ? <>{row('Install results', 'Check received reports')}{target}{row('Groups', isRemoval ? 'Review removal assignments' : 'Required / Available')}</> : <>{row('Install results', 'Check received reports')}{step.focus === 'Edit next rollout' && target}{row('Current release', 'Saved in Intune')}{row('Who gets it', isRemoval ? 'Review removal assignments' : 'Required / Available')}{row('Install behavior', 'Saved installer settings')}{row('What employees see', 'Saved installer experience')}{row('Next automatic update', 'Future automatic packages only')}{row('Timing and policy details', 'Expand for timing limits')}{row('App activity', 'Expand recorded changes')}</>)}
+            {step.screen === 'discovered' && row('App found on computers', 'Review match and eligibility')}
+            {step.screen === 'deployments' && <div className="my-4 rounded-lg border border-overlay/10 bg-overlay/[0.02] p-3"><p className="text-xs font-medium text-text-primary">Deployment outcome</p><p className="mt-1 text-xs leading-relaxed text-text-muted">Read the recorded status. Installing on computers is a separate result.</p></div>}
+            {step.screen === 'settings' && <>{row('Appearance', 'Your preference')}{row('Notifications', 'Review configuration')}</>}
+            {step.screen === 'server' && (needsAttention ? row('Needs attention', 'Example app needs a look') : <>{row('Server status', '1 needs a look')}{row('Intune self-test', 'Failing · reason shown')}{row('Version', 'Example version')}{row('All checks', '9 working')}</>)}
+            {step.screen === 'support' && <div className="my-4 space-y-3 rounded-lg border border-overlay/10 p-3 text-xs text-text-muted"><p>App and version</p><p>What you tried</p><p>Result or error code</p></div>}
+            {!focusAtHeading && !focusAtRow && !actionsPanel && !(step.screen === 'inventory' && step.focus === 'Edit next rollout') && target}
+
+            <p className="mt-3 text-[11px] leading-relaxed text-text-muted">Layout simplified to show the control you need.</p>
+          </div>
+        </div>
+      </div>
+      <figcaption className="mt-5 flex items-start gap-2.5 text-sm leading-relaxed text-text-secondary"><span className="mt-0.5 shrink-0 text-accent-cyan"><Circle size={15}/></span><span>{step.screen === 'support' ? <>Open <strong className="font-semibold text-text-primary">HRM Support</strong> and include the evidence listed in this step.</> : <>Look for <strong className="font-semibold text-text-primary">{step.focus}</strong> in {screen.label}.</>}</span></figcaption>
+    </div>
+    <div className="flex items-center gap-2 border-t border-overlay/10 px-4 py-3 text-xs text-text-muted"><Check size={13} className="shrink-0"/>Exploring this guide does not change your apps.</div>
+  </figure>;
+}
