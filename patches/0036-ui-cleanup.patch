+// HRM patch 0036: Home and the IT dashboard status report read the status file through one
+// bounded reader, so neither parses more than 32 KB.
+export const STATUS_FILE_MAX_BYTES = 32_768;
+export class StatusFileTooLargeError extends Error {
+  constructor() { super('Report unavailable'); }
+}
+
+/** The status file's text, or null when it doesn't exist. Throws if it is over 32 KB or unreadable. */
+export async function readStatusFileText(signal?: AbortSignal): Promise<string | null> {
+  let file;
+  try {
+    file = await open(statusFilePath(), 'r');
+  } catch (error) {
+    if ((error as NodeJS.ErrnoException).code === 'ENOENT') return null;
+    throw error;
+  }
+  try {
+    signal?.throwIfAborted();
+    if ((await file.stat()).size > STATUS_FILE_MAX_BYTES) throw new StatusFileTooLargeError();
+    const buffer = Buffer.alloc(STATUS_FILE_MAX_BYTES + 1);
+    const { bytesRead } = await file.read(buffer, 0, buffer.length, 0);
+    signal?.throwIfAborted();
+    if (bytesRead > STATUS_FILE_MAX_BYTES) throw new StatusFileTooLargeError();
+    return buffer.toString('utf8', 0, bytesRead);
+  } finally {
+    await file.close();
+  }
+}
+
 export async function readServerStatus(now = new Date()): Promise<ServerStatus> {
   let raw: string | null = null;
   try {
-    raw = await readFile(statusFilePath(), 'utf8');
-  } catch {
+    raw = await readStatusFileText();
+  } catch (error) {
+    if (error instanceof StatusFileTooLargeError) return { reported: false, reason: 'unreadable' };
     raw = null;
   }
   return interpretServerStatus(raw, now);
