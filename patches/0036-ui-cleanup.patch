@@ -0,0 +1,67 @@
+// @vitest-environment happy-dom
+// HRM patch 0036: policy badges use the menu's names, auto-update turned off by failures says so,
+// and Critical, Unmanaged and "new app" markers show only in Supabase mode.
+import { act, createElement, type ReactNode } from 'react';
+import { createRoot, type Root } from 'react-dom/client';
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+const mode = vi.hoisted(() => ({ value: 'sqlite' as 'sqlite' | 'supabase' | null }));
+vi.mock('@/hooks/use-database-mode', () => ({ useDatabaseMode: () => mode.value }));
+vi.mock('gt-next', () => ({ T: ({ children }: { children: ReactNode }) => children, Var: ({ children }: { children: ReactNode }) => children }));
+vi.mock('framer-motion', async () => {
+  const { createElement: h } = await import('react');
+  const strip = (tag: string) => ({ children, className }: { children?: ReactNode; className?: string }) => h(tag, { className }, children);
+  return { motion: { div: strip('div'), span: strip('span') }, useReducedMotion: () => true, AnimatePresence: ({ children }: { children: ReactNode }) => children };
+});
+vi.mock('@/components/hrm/PilotRollouts', () => ({ StartPilot: () => null }));
+vi.mock('@/components/hrm/AppGroupsLine', () => ({ AppGroupsLine: () => null }));
+vi.mock('@/components/AppIcon', () => ({ AppIcon: () => null }));
+vi.mock('./UpdatePolicySelector', () => ({ UpdatePolicySelector: () => null }));
+import { UpdateCard } from './UpdateCard';
+import type { AvailableUpdate } from '@/types/update-policies';
+
+let root: Root;
+(globalThis as typeof globalThis & { IS_REACT_ACT_ENVIRONMENT: boolean }).IS_REACT_ACT_ENVIRONMENT = true;
+beforeEach(() => { const el = document.createElement('div'); document.body.append(el); root = createRoot(el); mode.value = 'sqlite'; });
+afterEach(async () => { await act(async () => root.unmount()); document.body.innerHTML = ''; });
+
+const update = (over: Partial<AvailableUpdate> = {}): AvailableUpdate => ({
+  id: 'u-1', user_id: 'user', tenant_id: 'tenant', winget_id: 'Example.App', intune_app_id: 'app-1', display_name: 'Example App',
+  current_version: '1.0.0', latest_version: '2.0.0', is_critical: true, detected_at: new Date().toISOString(), notified_at: null,
+  dismissed_at: null, has_prior_deployment: true, is_managed: true, policy: null, ...over,
+});
+const policy = (over: Partial<NonNullable<AvailableUpdate['policy']>> = {}) => ({
+  id: 'p-1', policy_type: 'auto_update' as const, is_enabled: true, pinned_version: null, last_auto_update_at: null,
+  last_auto_update_version: null, consecutive_failures: 0, ...over,
+});
+async function render(u: AvailableUpdate) {
+  await act(async () => root.render(createElement(UpdateCard, { update: u, onTriggerUpdate: vi.fn(), onPolicyChange: vi.fn() })));
+  return document.body.textContent ?? '';
+}
+
+describe('UpdateCard', () => {
+  it('names the policy the same way as the menu', async () => {
+    expect(await render(update({ policy: policy() }))).toContain('Auto-update');
+    expect(await render(update({ policy: policy({ policy_type: 'notify' }) }))).toContain('Notify only');
+  });
+
+  it('warns when the safety limit turned auto-update off', async () => {
+    const text = await render(update({ policy: policy({ is_enabled: false, consecutive_failures: 3 }) }));
+    expect(text).toContain('Auto-update off');
+    expect(text).toContain('Turn auto-update back on');
+  });
+
+  it('hides Critical, Unmanaged and New to IntuneGet unless the server runs Supabase', async () => {
+    const odd = update({ is_managed: false, has_prior_deployment: false });
+    let text = await render(odd);
+    expect(text).not.toContain('Critical');
+    expect(text).not.toContain('Unmanaged');
+    expect(text).toContain('Major');
+    mode.value = null;
+    expect(await render(odd)).not.toContain('Critical');
+    mode.value = 'supabase';
+    text = await render(odd);
+    expect(text).toContain('Critical');
+    expect(text).toContain('Unmanaged');
+    expect(await render(update({ has_prior_deployment: false }))).toContain('New to IntuneGet');
+  });
+});
