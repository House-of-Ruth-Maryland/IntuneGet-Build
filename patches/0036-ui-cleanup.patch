+/**
+ * HRM patch 0036: the current setting of each row under More settings and What staff see during
+ * install, in a few words. Shared by the deploy panel (PackageConfig) and the cart editor
+ * (CartItemConfig) so the two always describe the same settings the same way.
+ */
+import type { PSADTConfig } from '@/types/psadt';
+
+const plural = (n: number, one: string, many: string) => `${n} ${n === 1 ? one : many}`;
+
+export interface SettingsSummaryInput {
+  config: PSADTConfig;
+  espProfiles: unknown[];
+  relationships: unknown[];
+  categories: Array<{ displayName: string }>;
+  /** Description, install or uninstall command differ from what the app started with. */
+  descriptionOrCommandsChanged: boolean;
+  customDetectionActive?: boolean;
+}
+
+export function settingsSummaries({ config, espProfiles, relationships, categories, descriptionOrCommandsChanged, customDetectionActive = false }: SettingsSummaryInput) {
+  return {
+    detection: customDetectionActive ? 'Your own rules' : 'Automatic',
+    esp: espProfiles.length ? `Required on ${plural(espProfiles.length, 'setup profile', 'setup profiles')}` : 'Not required',
+    dependencies: relationships.length ? plural(relationships.length, 'linked app', 'linked apps') : 'None',
+    category: categories.map((c) => c.displayName).join(', ') || 'None',
+    behavior: `${{ Silent: 'Silent', NonInteractive: 'Progress only', Auto: 'Installer decides' }[config.deployMode || 'Silent'] ?? 'Silent'}, ${
+      { Suppress: 'no restart', Prompt: 'asks to restart', Force: 'restarts' }[config.restartBehavior] ?? 'no restart'}`,
+    advanced: descriptionOrCommandsChanged || config.postInstallCommands?.length || config.postUninstallCommands?.length ? 'Changed' : 'Default',
+    deferral: config.allowDefer ? `Up to ${plural(config.deferTimes, 'time', 'times')}` : 'Off',
+    progress: config.progressDialog?.enabled || config.balloonTips?.length ? 'On' : 'Off',
+    prompts: config.customPrompts?.length ? plural(config.customPrompts.length, 'message', 'messages') : 'None',
+    restart: config.restartPrompt?.enabled ? 'On' : 'Off',
+    diskspace: config.checkDiskSpace ? (config.requiredDiskSpace ? `${config.requiredDiskSpace} MB` : 'On') : 'Off',
+    branding: config.brandingCompanyName || config.brandingWelcomeTitle || config.brandingLogoPath ? 'Custom' : 'Default',
+  };
+}
