+// HRM patch 0036: the modifier key for Search, named for the computer in use. Starts as "Ctrl"
+// (most HRM computers run Windows) and switches to "Cmd" after mount on a Mac, so the server
+// render and the first client render match.
+export function isMacPlatform(nav: { platform?: string; userAgent?: string } | undefined): boolean {
+  if (!nav) return false;
+  return /Mac|iPhone|iPad|iPod/i.test(nav.platform || nav.userAgent || '');
+}
+
+export function useModifierKeyLabel(): 'Cmd' | 'Ctrl' {
+  const [label, setLabel] = useState<'Cmd' | 'Ctrl'>('Ctrl');
+  useEffect(() => {
+    if (isMacPlatform(typeof navigator === 'undefined' ? undefined : navigator)) setLabel('Cmd');
+  }, []);
+  return label;
+}
+
