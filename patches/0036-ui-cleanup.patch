+ * IT dashboard status report. Reads NEXT_PUBLIC_URL first (the variable upstream's compose file
+ * sets) and falls back to NEXT_PUBLIC_APP_URL, taking the first one that is a plain https address.
+ * Paths, query strings and fragments are dropped; addresses with credentials or http are ignored,
+ * so compose's default http://localhost:3000 doesn't hide a valid NEXT_PUBLIC_APP_URL.
+ */
+export function serverHttpsOrigin(env: Record<string, string | undefined> = process.env): string | undefined {
+  for (const name of ['NEXT_PUBLIC_URL', 'NEXT_PUBLIC_APP_URL']) {
