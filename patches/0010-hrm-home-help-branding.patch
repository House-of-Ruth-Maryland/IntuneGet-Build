@@ -0,0 +1,22 @@
+import { describe, expect, it } from 'vitest';
+import { HELP_SECTIONS } from '../help-content';
+
+describe('help content', () => {
+  const text = HELP_SECTIONS.flatMap((s) => [s.title, ...s.points, ...(s.links ?? []).map((l) => l.label)]);
+
+  it('uses unique section ids and https links only', () => {
+    const ids = HELP_SECTIONS.map((s) => s.id);
+    expect(new Set(ids).size).toBe(ids.length);
+    for (const link of HELP_SECTIONS.flatMap((s) => s.links ?? [])) expect(link.href).toMatch(/^https:\/\//);
+  });
+
+  it('points to HRM Support, never "contact IT"', () => {
+    expect(HELP_SECTIONS.some((s) => s.links?.some((l) => l.href === 'https://support.hruthmd.org'))).toBe(true);
+    expect(text.join(' ')).not.toMatch(/contact IT/i);
+  });
+
+  it('follows HRM writing rules: sentence-case titles, no em dashes', () => {
+    for (const s of HELP_SECTIONS) expect(s.title.slice(1)).not.toMatch(/\b(?!Enrollment|Status|Page|Teams|ESP)[A-Z][a-z]+/);
+    expect(text.join(' ')).not.toContain('—');
+  });
+});
diff --git a/lib/hrm/__tests__/home.test.ts b/lib/hrm/__tests__/home.test.ts
new file mode 100644
index 000000000..a7463eeff
--- /dev/null
+++ b/lib/hrm/__tests__/home.test.ts
@@ -0,0 +1,67 @@
+import { describe, expect, it } from 'vitest';
+import type { AnalyticsJob } from '@/lib/db/types';
+import { attentionCounts, interpretServerStatus } from '../home';
+
+const NOW = new Date('2026-10-27T12:00:00Z');
+const file = (over: Record<string, unknown> = {}) => JSON.stringify({
+  generatedAt: '2026-10-27T11:58:00Z',
+  version: 'v0.8.2-hrm.9',
+  startedAt: '2026-10-27T10:00:00Z',
+  lastDeploy: { time: '2026-10-27T10:00:00Z', result: 'deployed', from: 'v0.8.2-hrm.8', to: 'v0.8.2-hrm.9' },
+  lastBackup: { at: '2026-10-27T09:59:00Z', sizeKb: 90000 },
+  disk: { totalKb: 1000, usedKb: 600 },
+  updateCheck: { result: 'success', at: '2026-10-27T07:30:00Z' },
+  notifications: { result: 'success', at: '2026-10-27T08:00:00Z' },
+  tunnel: { version: '2026.10.4', running: true, lastUpdate: { result: 'success', at: '2026-10-27T00:00:00Z' } },
+  ...over,
+});
+
+describe('server status file', () => {
+  it('reports a healthy server', () => {
+    const status = interpretServerStatus(file(), NOW);
+    expect(status).toMatchObject({ reported: true, version: 'v0.8.2-hrm.9', diskWarning: false, problems: [] });
+  });
+
+  it('never guesses when the file is missing, unreadable or old', () => {
+    expect(interpretServerStatus(null, NOW)).toEqual({ reported: false, reason: 'missing' });
+    expect(interpretServerStatus('{not json', NOW)).toEqual({ reported: false, reason: 'unreadable' });
+    expect(interpretServerStatus('{}', NOW)).toEqual({ reported: false, reason: 'unreadable' });
+    expect(interpretServerStatus(file({ generatedAt: '2026-10-27T11:40:00Z' }), NOW)).toMatchObject({ reported: false, reason: 'stale' });
+  });
+
+  it('flags disk, deploy, timers and the tunnel', () => {
+    const status = interpretServerStatus(file({
+      disk: { totalKb: 100, usedKb: 90 },
+      lastDeploy: { time: '2026-10-27T10:00:00Z', result: 'rolled_back', from: 'a', to: 'b' },
+      updateCheck: { result: 'exit-code', at: '2026-10-27T07:30:00Z' },
+      notifications: { result: 'timeout', at: null },
+      tunnel: { version: '2026.10.4', running: false, lastUpdate: { result: 'success', at: null } },
+    }), NOW);
+    expect(status.reported && status.problems).toEqual(['disk', 'deploy', 'updateCheck', 'notifications', 'tunnel']);
+  });
+
+  it('treats a waiting deploy as normal and a failed tunnel update as a warning', () => {
+    const status = interpretServerStatus(file({
+      lastDeploy: { time: '2026-10-27T10:00:00Z', result: 'waiting', from: 'a', to: 'b' },
+      tunnel: { version: '2026.10.4', running: true, lastUpdate: { result: 'exit-code', at: null } },
+    }), NOW);
+    expect(status.reported && status.problems).toEqual(['tunnelUpdate']);
+  });
+});
+
+describe('needs attention counts', () => {
