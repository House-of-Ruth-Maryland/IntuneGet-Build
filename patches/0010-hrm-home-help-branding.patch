+import { describe, expect, it } from 'vitest';
+import { NextRequest } from 'next/server';
+import { isCrawlerPath, isMarketingPath } from '../site';
+import { proxy } from '@/proxy';
+
+const get = (path: string) => proxy(new NextRequest(`https://intune.example.test${path}`));
+
+describe('no marketing site on the HRM server', () => {
+  it('treats the landing page and every marketing section as marketing', () => {
+    for (const path of ['/', '/about', '/apps', '/apps/Google.Chrome', '/blog/post', '/docs/docker', '/pricing', '/privacy', '/qa', '/roadmap', '/security', '/terms']) {
+      expect(isMarketingPath(path), path).toBe(true);
+    }
+  });
+
+  it('leaves the app, sign-in and API alone', () => {
+    for (const path of ['/dashboard', '/dashboard/apps', '/dashboard/help', '/auth/signin', '/api/health', '/api/apps', '/onboarding', '/redirect', '/applications', '/docsx']) {
+      expect(isMarketingPath(path), path).toBe(false);
+    }
+  });
+
+  it('redirects marketing pages to the dashboard', async () => {
+    for (const path of ['/', '/pricing', '/docs/getting-started']) {
+      const response = await get(path);
+      expect(response.status, path).toBe(307);
+      expect(new URL(response.headers.get('location')!).pathname).toBe('/dashboard');
+    }
+  });
+
+  it('tells crawlers to skip everything and serves no sitemap', async () => {
+    const robots = await get('/robots.txt');
+    expect(await robots.text()).toBe('User-agent: *\nDisallow: /\n');
+    expect((await get('/sitemap.xml')).status).toBe(404);
+    expect((await get('/sitemap/1.xml')).status).toBe(404);
+    expect(isCrawlerPath('/sitemapping')).toBe(false);
+  });
+
+  it('still sends signed-out visitors of the dashboard to sign-in', async () => {
+    const response = await get('/dashboard');
+    expect(new URL(response.headers.get('location')!).pathname).toBe('/auth/signin');
+  });
+});
