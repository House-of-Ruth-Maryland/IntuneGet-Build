+/**
+ * HRM patch: this server is HRM's internal tool behind Cloudflare Access, so
+ * the public marketing site (home page, pricing, blog, docs...) has no
+ * audience. Its pages stay in the code, unchanged, and the request proxy
+ * sends them to the dashboard instead.
+ */
+
+// Top-level routes of app/(marketing). '/' is the landing page.
+const MARKETING_PREFIXES = [
+  '/about', '/apps', '/blog', '/docs', '/pricing', '/privacy', '/qa', '/roadmap', '/security', '/terms',
+];
+
+export const HOME_PATH = '/dashboard';
+
+export function isMarketingPath(pathname: string): boolean {
+  if (pathname === '/') return true;
+  return MARKETING_PREFIXES.some((prefix) => pathname === prefix || pathname.startsWith(`${prefix}/`));
+}
+
+// Search engines are told to skip everything; the sitemap is never served.
+export function isCrawlerPath(pathname: string): boolean {
+  return pathname === '/robots.txt' || pathname === '/sitemap.xml' || pathname.startsWith('/sitemap/');
+}
+
+export const ROBOTS_TXT = 'User-agent: *\nDisallow: /\n';
