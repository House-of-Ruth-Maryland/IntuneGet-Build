@@ -0,0 +1,36 @@
+import { NextRequest } from 'next/server';
+import { beforeEach, describe, expect, it, vi } from 'vitest';
+const mocks = vi.hoisted(() => ({ auth: vi.fn(), jobs: vi.fn(), status: vi.fn() }));
+vi.mock('@/lib/auth-utils', () => ({ parseAccessToken: mocks.auth }));
+vi.mock('@/lib/db', () => ({ getDatabase: () => ({ jobs: { getAnalyticsJobs: mocks.jobs } }) }));
+vi.mock('@/lib/hrm/home', async (original) => ({ ...(await original<typeof import('@/lib/hrm/home')>()), readServerStatus: mocks.status }));
+import { GET } from './route';
+
+const request = () => new NextRequest('http://localhost/api/hrm/home');
+beforeEach(() => {
+  vi.clearAllMocks();
+  mocks.auth.mockResolvedValue({ userId: 'caller', tenantId: 'token-tenant' });
+  mocks.jobs.mockResolvedValue([]);
+  mocks.status.mockResolvedValue({ reported: false, reason: 'missing' });
+});
+
+describe('HRM home route', () => {
+  it('requires sign-in before reading anything', async () => {
+    mocks.auth.mockResolvedValue(null);
+    expect((await GET(request())).status).toBe(401);
+    expect(mocks.jobs).not.toHaveBeenCalled();
+    expect(mocks.status).not.toHaveBeenCalled();
+  });
+
+  it('reads only the signed-in tenant and is never cached', async () => {
+    const response = await GET(request());
+    expect(mocks.jobs).toHaveBeenCalledWith({ tenantId: 'token-tenant' });
+    expect(response.headers.get('cache-control')).toBe('private, no-store');
+    expect(await response.json()).toEqual({ attention: { failedRecent: 0, stuck: 0 }, server: { reported: false, reason: 'missing' } });
+  });
+
+  it('still returns server status when the job query fails', async () => {
+    mocks.jobs.mockRejectedValue(new Error('db busy'));
+    expect(await (await GET(request())).json()).toMatchObject({ attention: null, server: { reported: false } });
+  });
+});
diff --git a/app/api/hrm/home/route.ts b/app/api/hrm/home/route.ts
new file mode 100644
index 000000000..c1f693757
--- /dev/null
+++ b/app/api/hrm/home/route.ts
@@ -0,0 +1,20 @@
+// HRM patch: Home page data (needs attention counts and server status).
+
+import { NextRequest, NextResponse } from 'next/server';
+import { getDatabase } from '@/lib/db';
+import { parseAccessToken } from '@/lib/auth-utils';
+import { attentionCounts, readServerStatus } from '@/lib/hrm/home';
+
+export async function GET(request: NextRequest) {
+  const user = await parseAccessToken(request.headers.get('Authorization'));
+  if (!user) return NextResponse.json({ error: 'Authentication required' }, { status: 401 });
+
+  const [jobs, server] = await Promise.all([
+    getDatabase().jobs.getAnalyticsJobs({ tenantId: user.tenantId }).catch(() => null),
+    readServerStatus(),
+  ]);
+  return NextResponse.json(
+    { attention: jobs ? attentionCounts(jobs) : null, server },
+    { headers: { 'Cache-Control': 'private, no-store' } },
+  );
+}
