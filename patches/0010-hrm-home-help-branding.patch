diff --git a/app/(app)/dashboard/help/page.tsx b/app/(app)/dashboard/help/page.tsx
new file mode 100644
index 000000000..46e12bc3d
--- /dev/null
+++ b/app/(app)/dashboard/help/page.tsx
@@ -0,0 +1,75 @@
+'use client';
+
+// HRM patch: help for HRM IT in place of upstream's public docs.
+
+import Link from 'next/link';
+import { ExternalLink, LifeBuoy } from 'lucide-react';
+import { PageHeader } from '@/components/dashboard';
+import { HELP_SECTIONS, HRM_SUPPORT_URL } from '@/lib/hrm/help-content';
+
+export default function HelpPage() {
+  return (
+    <div className="space-y-6 max-w-3xl">
+      <PageHeader
+        title="Help"
+        description="How HRM uses IntuneGet, and where to go when something goes wrong."
+        icon={LifeBuoy}
+      />
+
+      <nav aria-label="Help topics" className="flex flex-wrap gap-2">
+        {HELP_SECTIONS.map((section) => (
+          <a
+            key={section.id}
+            href={`#${section.id}`}
+            className="text-sm px-3 py-1 rounded-full border border-overlay/10 text-text-secondary hover:text-accent-cyan hover:border-accent-cyan/40"
+          >
+            {section.title}
+          </a>
+        ))}
+      </nav>
+
+      {HELP_SECTIONS.map((section) => (
+        <section
+          key={section.id}
+          id={section.id}
+          aria-labelledby={`${section.id}-title`}
+          className="scroll-mt-20 rounded-xl border border-overlay/10 bg-bg-elevated p-5"
+        >
+          <h2 id={`${section.id}-title`} className="text-lg font-semibold text-text-primary mb-3">
+            {section.title}
+          </h2>
+          <ul className="list-disc pl-5 space-y-2 text-sm text-text-secondary leading-relaxed">
+            {section.points.map((point) => (
+              <li key={point}>{point}</li>
+            ))}
+          </ul>
+          {section.links && (
+            <div className="mt-4 flex flex-wrap gap-4">
+              {section.links.map((link) => (
+                <Link
+                  key={link.href}
+                  href={link.href}
+                  target="_blank"
+                  rel="noopener noreferrer"
+                  className="inline-flex items-center gap-1.5 text-sm font-medium text-accent-cyan hover:underline"
+                >
+                  {link.label}
+                  <ExternalLink className="w-3.5 h-3.5" aria-hidden="true" />
+                  <span className="sr-only">(opens in a new tab)</span>
+                </Link>
+              ))}
+            </div>
+          )}
+        </section>
+      ))}
+
+      <p className="text-sm text-text-muted">
+        Still stuck?{' '}
+        <a href={HRM_SUPPORT_URL} target="_blank" rel="noopener noreferrer" className="text-accent-cyan hover:underline">
+          Contact HRM Support
+        </a>
+        .
+      </p>
+    </div>
+  );
+}
