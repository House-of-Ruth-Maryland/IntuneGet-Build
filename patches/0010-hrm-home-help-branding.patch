diff --git a/components/hrm/ServerStatusCard.tsx b/components/hrm/ServerStatusCard.tsx
new file mode 100644
index 000000000..6f1c02f2e
--- /dev/null
+++ b/components/hrm/ServerStatusCard.tsx
@@ -0,0 +1,98 @@
+'use client';
+
+// HRM patch: the Home page's server status card.
+
+import { Server, Loader2 } from 'lucide-react';
+import type { ServerStatus } from '@/lib/hrm/home';
+
+function relative(iso: string | null | undefined, now = Date.now()): string {
+  const at = iso ? Date.parse(iso) : NaN;
+  if (!Number.isFinite(at)) return 'Never';
+  const minutes = Math.max(0, Math.round((now - at) / 60000));
+  if (minutes < 60) return minutes <= 1 ? 'Just now' : `${minutes} min ago`;
+  const hours = Math.round(minutes / 60);
+  if (hours < 48) return `${hours} h ago`;
+  return `${Math.round(hours / 24)} days ago`;
+}
+
+function size(kb: number): string {
+  return kb >= 1024 * 1024 ? `${(kb / 1024 / 1024).toFixed(1)} GB` : `${Math.round(kb / 1024)} MB`;
+}
+
+function Pill({ tone, children }: { tone: 'ok' | 'warn' | 'bad'; children: React.ReactNode }) {
+  const tones = {
+    ok: 'bg-status-success/10 text-status-success',
+    warn: 'bg-status-warning/10 text-status-warning',
+    bad: 'bg-status-error/10 text-status-error',
+  };
+  return <span className={`text-xs font-medium px-2 py-0.5 rounded-full ${tones[tone]}`}>{children}</span>;
+}
+
+function Row({ label, children }: { label: string; children: React.ReactNode }) {
+  return (
+    <div className="flex items-center justify-between gap-3 py-2 border-t border-overlay/5 first:border-t-0">
+      <dt className="text-sm text-text-muted">{label}</dt>
+      <dd className="text-sm text-text-primary text-right">{children}</dd>
+    </div>
+  );
+}
+
+export function ServerStatusCard({ status, loading }: { status?: ServerStatus; loading?: boolean }) {
+  return (
+    <section aria-labelledby="server-status-title" className="glass-light rounded-xl p-5 border-t-4 border-t-accent-violet-bright">
+      <div className="flex items-center gap-2 mb-3">
+        <Server className="w-5 h-5 text-accent-cyan" aria-hidden="true" />
+        <h2 id="server-status-title" className="text-lg font-semibold text-text-primary">Server status</h2>
+        {status?.reported && (
+          <span className="ml-auto">{status.problems.length === 0 ? <Pill tone="ok">Healthy</Pill> : <Pill tone="warn">Check</Pill>}</span>
+        )}
+      </div>
+
+      {loading && !status ? (
+        <Loader2 className="w-5 h-5 text-text-secondary animate-spin" aria-label="Loading server status" />
+      ) : !status?.reported ? (
+        <p className="text-sm text-text-muted">
+          {status?.reason === 'stale'
+            ? `Status not reported since ${relative(status.generatedAt)}. The status timer on the server may have stopped.`
+            : 'Status not reported. The status timer on the server may not be installed yet.'}
+        </p>
+      ) : (
+        <dl>
+          <Row label="Version">{status.version ?? 'Unknown'}</Row>
+          <Row label="Last deploy">
+            {status.lastDeploy ? (
+              <span className="inline-flex items-center gap-2">
+                {relative(status.lastDeploy.time)}
+                {status.problems.includes('deploy') && <Pill tone="bad">{status.lastDeploy.result.replace('_', ' ')}</Pill>}
+              </span>
+            ) : 'Never'}
+          </Row>
+          <Row label="Last backup">
+            {status.lastBackup ? `${relative(status.lastBackup.at)}, ${size(status.lastBackup.sizeKb)}` : 'None'}
+          </Row>
+          <Row label="Update check">
+            {status.problems.includes('updateCheck') ? <Pill tone="bad">Failed</Pill> : relative(status.updateCheck.at)}
+          </Row>
+          <Row label="Update alerts">
+            {status.problems.includes('notifications') ? <Pill tone="bad">Failed</Pill> : relative(status.notifications.at)}
+          </Row>
+          <Row label="Disk">
+            {status.diskWarning ? <Pill tone="warn">{Math.round(status.diskRatio * 100)}% used</Pill> : `${Math.round(status.diskRatio * 100)}% used`}
+          </Row>
+          <Row label="Tunnel">
+            {status.problems.includes('tunnel') ? (
+              <Pill tone="bad">Not running</Pill>
+            ) : status.problems.includes('tunnelUpdate') ? (
+              <Pill tone="warn">Update failed</Pill>
+            ) : (
+              <span className="inline-flex items-center gap-2">
+                {status.tunnel.version ?? ''}
+                <Pill tone="ok">Running</Pill>
+              </span>
+            )}
+          </Row>
+        </dl>
+      )}
+    </section>
+  );
+}
