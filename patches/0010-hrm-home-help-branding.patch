diff --git a/hooks/useHrmHome.ts b/hooks/useHrmHome.ts
new file mode 100644
index 000000000..36cd4da6e
--- /dev/null
+++ b/hooks/useHrmHome.ts
@@ -0,0 +1,28 @@
+'use client';
+
+// HRM patch: Home page data from /api/hrm/home.
+
+import { useQuery } from '@tanstack/react-query';
+import { useMicrosoftAuth } from '@/hooks/useMicrosoftAuth';
+import type { ServerStatus } from '@/lib/hrm/home';
+
+export interface HrmHomeData {
+  attention: { failedRecent: number; stuck: number } | null;
+  server: ServerStatus;
+}
+
+export function useHrmHome() {
+  const { getAccessToken, isAuthenticated } = useMicrosoftAuth();
+  return useQuery<HrmHomeData>({
+    queryKey: ['hrm', 'home'],
+    queryFn: async () => {
+      const token = await getAccessToken();
+      if (!token) throw new Error('Not authenticated');
+      const response = await fetch('/api/hrm/home', { headers: { Authorization: `Bearer ${token}` } });
+      if (!response.ok) throw new Error('Failed to load the Home page');
+      return response.json();
+    },
+    enabled: isAuthenticated,
+    refetchInterval: 60 * 1000,
+  });
+}
