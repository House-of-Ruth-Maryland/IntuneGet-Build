@@ -0,0 +1,29 @@
+// HRM patch: the IT dashboard's status report. Protected by STATUS_REPORT_KEY alone, not sign-in;
+// Cloudflare Access bypasses this one path. Counts and states only (lib/hrm/status-report.ts).
+
+import { NextRequest, NextResponse } from 'next/server';
+import { getDatabase } from '@/lib/db';
+import { readServerStatus } from '@/lib/hrm/home';
+import { buildStatusReport, reportKeyMatches, reportRateLimited } from '@/lib/hrm/status-report';
+
+export const dynamic = 'force-dynamic';
+
+export async function GET(request: NextRequest) {
+  const authorization = request.headers.get('authorization');
+  if (reportRateLimited(authorization)) return new NextResponse(null, { status: 429 });
+  if (!reportKeyMatches(authorization, process.env.STATUS_REPORT_KEY)) return new NextResponse(null, { status: 401 });
+
+  const db = getDatabase();
+  const [server, jobs, deploys] = await Promise.all([
+    readServerStatus(),
+    Promise.all([
+      db.jobs.getByStatus('failed', 500, false),
+      ...['queued', 'packaging', 'uploading'].map((status) => db.jobs.getByStatus(status, 200)),
+    ]).then((lists) => lists.flat()).catch(() => null),
+    db.uploadHistory.listAll(1000).catch(() => null),
+  ]);
+  return NextResponse.json(
+    buildStatusReport({ server, jobs, deploys, origin: process.env.NEXT_PUBLIC_URL }),
+    { headers: { 'Cache-Control': 'no-store' } },
+  );
+}
