diff --git a/app/api/status-report/route.test.ts b/app/api/status-report/route.test.ts
new file mode 100644
index 000000000..f3e680150
--- /dev/null
+++ b/app/api/status-report/route.test.ts
@@ -0,0 +1,120 @@
+import { NextRequest } from 'next/server';
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+const mocks = vi.hoisted(() => ({ byStatus: vi.fn(), history: vi.fn(), status: vi.fn(), factory: vi.fn() }));
+vi.mock('@/lib/db', () => ({ isSqliteMode: () => false, getDatabase: () => mocks.factory() }));
+vi.mock('@/lib/hrm/status-report-data', async original => ({
+  ...(await original<typeof import('@/lib/hrm/status-report-data')>()), readReportServerStatus: mocks.status,
+}));
+let GET: typeof import('./route')['GET'];
+const KEY = 'a'.repeat(64);
+const request = (authorization?: string) => new NextRequest('https://example.test/api/status-report', {
+  headers: authorization ? { authorization } : {},
+});
+const authorized = () => request(`Bearer ${KEY}`);
+
+beforeEach(async () => {
+  vi.resetModules();
+  vi.useFakeTimers();
+  vi.setSystemTime(new Date('2026-11-03T12:00:00Z'));
+  process.env.STATUS_REPORT_KEY = KEY;
+  mocks.byStatus.mockReset().mockResolvedValue([]);
+  mocks.history.mockReset().mockResolvedValue([]);
+  mocks.status.mockReset().mockResolvedValue({ reported: false, reason: 'missing' });
+  mocks.factory.mockReset().mockImplementation(() => ({ jobs: { getByStatus: mocks.byStatus }, uploadHistory: { listAll: mocks.history } }));
+  GET = (await import('./route')).GET;
+});
+afterEach(() => { vi.useRealTimers(); delete process.env.STATUS_REPORT_KEY; });
+
+async function down(response: Response) {
+  expect(response.status).toBe(200);
+  const text = await response.text();
+  expect(text).not.toContain('FORBIDDEN');
+  expect(text).not.toContain(KEY);
+  expect(JSON.parse(text)).toMatchObject({ health: 'down', status: 'Report unavailable' });
+}
+
+describe('status report route', () => {
+  it('always rejects missing or wrong keys with empty 401s without reading anything', async () => {
+    for (let i = 0; i < 30; i++) {
+      for (const header of [undefined, `Bearer wrong-${i}`, `Basic ${KEY}`]) {
+        const response = await GET(request(header));
+        expect(response.status).toBe(401);
+        expect(await response.text()).toBe('');
+      }
+    }
+    expect(mocks.factory).not.toHaveBeenCalled();
+    expect(mocks.status).not.toHaveBeenCalled();
+    expect((await GET(authorized())).status).toBe(200);
+  });
+
+  it('rejects every key when unset or shorter than 32 characters', async () => {
+    for (const key of [undefined, 's'.repeat(31)]) {
+      process.env.STATUS_REPORT_KEY = key ?? '';
+      for (let i = 0; i < 25; i++) expect((await GET(request(`Bearer ${key ?? ''}`))).status).toBe(401);
+    }
+  });
+
+  it('serves cached 200 reports and rebuilds at most once a minute', async () => {
+    const first = await GET(authorized());
+    expect(first.status).toBe(200);
+    expect(first.headers.get('cache-control')).toBe('no-store');
+    const report = await first.json();
+    for (let i = 0; i < 30; i++) expect(await (await GET(authorized())).json()).toEqual(report);
+    expect(mocks.factory).toHaveBeenCalledTimes(1);
+    vi.advanceTimersByTime(60_001);
+    expect((await GET(authorized())).status).toBe(200);
+    expect(mocks.factory).toHaveBeenCalledTimes(2);
+  });
+
+  it('shares one build between simultaneous valid requests', async () => {
+    await Promise.all(Array.from({ length: 10 }, () => GET(authorized())));
+    expect(mocks.factory).toHaveBeenCalledTimes(1);
+  });
+
+  it('does not reuse another key cache after rotation', async () => {
+    const first = await (await GET(authorized())).json();
+    process.env.STATUS_REPORT_KEY = 'b'.repeat(64);
+    vi.advanceTimersByTime(1_000);
+    const next = await GET(request(`Bearer ${process.env.STATUS_REPORT_KEY}`));
+    expect((await next.json()).generatedAt).not.toBe(first.generatedAt);
+    expect(mocks.factory).toHaveBeenCalledTimes(2);
+    expect((await GET(authorized())).status).toBe(401);
+  });
+
+  it('sanitizes query failures and database factory throws', async () => {
+    mocks.factory.mockImplementation(() => { throw new Error('FORBIDDEN_FACTORY'); });
+    await down(await GET(authorized()));
+    expect(mocks.status).toHaveBeenCalled();
+    vi.advanceTimersByTime(60_001);
+    mocks.factory.mockReturnValue({ jobs: { getByStatus: mocks.byStatus }, uploadHistory: { listAll: mocks.history } });
+    mocks.history.mockRejectedValue(new Error('FORBIDDEN_QUERY'));
+    const response = await GET(authorized());
+    const text = await response.text();
+    expect(response.status).toBe(200);
+    expect(JSON.parse(text).health).toBe('down');
+    expect(text).not.toContain('FORBIDDEN');
+  });
+
+  it('sanitizes malformed status data when building the report throws', async () => {
+    mocks.status.mockResolvedValue({ reported: true, problems: null });
+    await down(await GET(authorized()));
+  });
+
+  it('answers a cold slow build within three seconds and cancels its reads', async () => {
+    let signal: AbortSignal | undefined;
+    mocks.status.mockImplementation((value: AbortSignal) => { signal = value; return new Promise(() => {}); });
+    const response = GET(authorized());
+    await vi.advanceTimersByTimeAsync(2_250);
+    await down(await response);
+    expect(signal?.aborted).toBe(true);
+  });
+
+  it('returns the last safe report on a slow refresh without changing its generatedAt', async () => {
+    const first = await (await GET(authorized())).json();
+    vi.advanceTimersByTime(60_001);
+    mocks.history.mockImplementation(() => new Promise(() => {}));
+    const response = GET(authorized());
+    await vi.advanceTimersByTimeAsync(2_250);
+    expect(await (await response).json()).toEqual(first);
+  });
+});
diff --git a/app/api/status-report/route.ts b/app/api/status-report/route.ts
new file mode 100644
index 000000000..25fc74af8
--- /dev/null
+++ b/app/api/status-report/route.ts
@@ -0,0 +1,70 @@
+// HRM patch: protected by STATUS_REPORT_KEY alone; the report path bypasses sign-in.
+import { createHash } from 'node:crypto';
+import { NextRequest, NextResponse } from 'next/server';
+import { readReportCounts, readReportServerStatus } from '@/lib/hrm/status-report-data';
+import { buildStatusReport, degradedReport, reportKeyMatches, type StatusReport } from '@/lib/hrm/status-report';
+
+export const dynamic = 'force-dynamic';
+export const runtime = 'nodejs';
+const CACHE_MS = 60_000;
+const BUILD_MS = 2_250; // Leave headroom inside the dashboard contract's three-second budget.
+interface Cache {
+  key: string;
+  attemptedAt: number;
+  report?: StatusReport;
+  lastGood?: StatusReport;
+  pending?: Promise<StatusReport>;
+}
+let cache: Cache | undefined;
+
+async function rebuild(entry: Cache, now: Date): Promise<StatusReport> {
+  const controller = new AbortController();
+  let timer: ReturnType<typeof setTimeout> | undefined;
+  try {
+    const work = Promise.resolve().then(async () => {
+      const [server, counts] = await Promise.all([
+        readReportServerStatus(controller.signal, now),
+        readReportCounts(controller.signal, now),
+      ]);
+      return buildStatusReport({ server, counts, jobs: [], deploys: [], origin: process.env.NEXT_PUBLIC_URL, now });
+    });
+    const deadline = new Promise<StatusReport>(resolve => {
+      timer = setTimeout(() => {
+        // Keep the original generatedAt when serving older numbers.
+        resolve(entry.lastGood ?? degradedReport(now));
+        controller.abort();
+      }, BUILD_MS);
+    });
+    entry.report = await Promise.race([work, deadline]);
+    if (!controller.signal.aborted && entry.report.health !== 'down') entry.lastGood = entry.report;
+  } catch {
+    entry.report = degradedReport(now);
+  } finally {
+    if (timer) clearTimeout(timer);
+    controller.abort();
+  }
+  return entry.report;
+}
+
+export async function GET(request: NextRequest) {
+  const authorization = request.headers.get('authorization');
+  // Invalid credentials never touch the cache or consume an authenticated request's allowance.
+  if (!reportKeyMatches(authorization, process.env.STATUS_REPORT_KEY)) {
+    return new NextResponse(null, { status: 401, headers: { 'Cache-Control': 'no-store' } });
+  }
+  try {
+    const key = createHash('sha256').update(process.env.STATUS_REPORT_KEY!).digest('hex');
+    const now = new Date();
+    if (!cache || cache.key !== key) cache = { key, attemptedAt: -Infinity };
+    const entry = cache;
+    if (!entry.pending && now.getTime() - entry.attemptedAt >= CACHE_MS) {
+      entry.attemptedAt = now.getTime();
+      entry.pending = rebuild(entry, now).finally(() => { entry.pending = undefined; });
+    }
+    const report = await (entry.pending ?? entry.report ?? degradedReport(now));
+    return NextResponse.json(report, { headers: { 'Cache-Control': 'no-store' } });
+  } catch {
+    // Includes factory/setup, malformed status, query, build and serialization failures. Never log errors or keys.
+    return NextResponse.json(degradedReport(), { headers: { 'Cache-Control': 'no-store' } });
+  }
+}
diff --git a/lib/hrm/__tests__/status-report-data.test.ts b/lib/hrm/__tests__/status-report-data.test.ts
new file mode 100644
index 000000000..44d2db5fe
--- /dev/null
+++ b/lib/hrm/__tests__/status-report-data.test.ts
@@ -0,0 +1,70 @@
+import { afterEach, describe, expect, it } from 'vitest';
+import Database from 'better-sqlite3';
+import { mkdtemp, rm, writeFile } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import path from 'node:path';
+import { readReportServerStatus, readSqliteReportCounts } from '../status-report-data';
+const NOW = new Date('2026-11-03T12:00:00Z');
+const dirs: string[] = [];
+const originalPath = process.env.DATABASE_PATH;
+afterEach(async () => {
+  if (originalPath === undefined) delete process.env.DATABASE_PATH;
+  else process.env.DATABASE_PATH = originalPath;
+  for (const dir of dirs.splice(0)) await rm(dir, { recursive: true, force: true });
+});
+async function directory() {
+  const dir = await mkdtemp(path.join(tmpdir(), 'report-counts-'));
+  dirs.push(dir);
+  process.env.DATABASE_PATH = path.join(dir, 'test.db');
+  return dir;
+}
+
+describe('isolated report reads', () => {
+  it('aggregates complete counts in UTC without exposing records or changing the app connection', async () => {
+    await directory();
+    const db = new Database(process.env.DATABASE_PATH!);
+    try {
+      db.exec(`CREATE TABLE packaging_jobs (status TEXT, created_at TEXT, updated_at TEXT, archived_at TEXT, display_name TEXT);
+        CREATE TABLE upload_history (deployed_at TEXT, display_name TEXT);`);
+      const insert = db.prepare('INSERT INTO upload_history VALUES (?, ?)');
+      db.transaction(() => {
+        for (let i = 0; i < 1_205; i++) insert.run('2026-11-02T23:59:00Z', 'FORBIDDEN_APP');
+      })();
+      insert.run('2026-11-03T00:00:00Z', 'FORBIDDEN_APP');
+      insert.run('2026-11-04T00:00:00Z', 'FORBIDDEN_FUTURE');
+      db.prepare('INSERT INTO packaging_jobs VALUES (?, ?, ?, ?, ?)').run('failed', NOW.toISOString(), NOW.toISOString(), null, 'FORBIDDEN_ERROR');
+      db.prepare('INSERT INTO packaging_jobs VALUES (?, ?, ?, ?, ?)').run('queued', '2026-11-02T00:00:00Z', NOW.toISOString(), null, 'FORBIDDEN_STAFF');
+      db.prepare('INSERT INTO packaging_jobs VALUES (?, ?, ?, ?, ?)').run('failed', NOW.toISOString(), NOW.toISOString(), NOW.toISOString(), 'FORBIDDEN_ARCHIVED');
+      const timeout = db.pragma('busy_timeout', { simple: true });
+      const result = await readSqliteReportCounts(new AbortController().signal, NOW);
+      expect(result).toMatchObject({ failedRecent: 1, stuck: 1 });
+      expect(result.days.slice(-2)).toEqual([1_205, 1]);
+      expect(result.deployed.reduce((sum, group) => sum + group.count, 0)).toBe(1_206);
+      expect(result.failed.reduce((sum, group) => sum + group.count, 0)).toBe(1);
+      expect(JSON.stringify(result)).not.toContain('FORBIDDEN');
+      expect(db.pragma('busy_timeout', { simple: true })).toBe(timeout);
+    } finally { db.close(); }
+  });
+
+  it('cancels an isolated reader without waiting for a busy database', async () => {
+    await directory();
+    const db = new Database(process.env.DATABASE_PATH!);
+    try {
+      db.exec('CREATE TABLE packaging_jobs (status TEXT); BEGIN EXCLUSIVE;');
+      const controller = new AbortController();
+      const result = readSqliteReportCounts(controller.signal, NOW);
+      controller.abort();
+      await expect(result).rejects.toThrow('Report unavailable');
+    } finally { db.exec('ROLLBACK'); db.close(); }
+  });
+
+  it('bounds status-file bytes and keeps missing status distinct from malformed input', async () => {
+    const dir = await directory();
+    const signal = new AbortController().signal;
+    expect(await readReportServerStatus(signal, NOW)).toEqual({ reported: false, reason: 'missing' });
+    await writeFile(path.join(dir, 'hrm-status.json'), 'x'.repeat(32_769));
+    await expect(readReportServerStatus(signal, NOW)).rejects.toThrow('Report unavailable');
+    await writeFile(path.join(dir, 'hrm-status.json'), JSON.stringify({ generatedAt: NOW.toISOString(), disk: {}, tunnel: { running: true, lastUpdate: null } }));
+    await expect(readReportServerStatus(signal, NOW)).rejects.toThrow();
+  });
+});
diff --git a/lib/hrm/__tests__/status-report.test.ts b/lib/hrm/__tests__/status-report.test.ts
new file mode 100644
index 000000000..a198cc7b3
--- /dev/null
+++ b/lib/hrm/__tests__/status-report.test.ts
@@ -0,0 +1,221 @@
+import { describe, expect, it } from 'vitest';
+import { interpretServerStatus } from '../home';
+import { buildStatusReport, reportKeyMatches, constrainReport } from '../status-report';
+
+const NOW = new Date('2026-11-03T12:00:00Z');
+const ORIGIN = 'https://intuneget.example.test';
+const server = (over: Record<string, unknown> = {}) => interpretServerStatus(JSON.stringify({
+  generatedAt: '2026-11-03T11:58:00Z',
+  version: 'v0.8.5-hrm.7',
+  startedAt: '2026-11-03T10:00:00Z',
+  lastDeploy: { time: '2026-11-03T10:00:00Z', result: 'deployed', from: 'v0.8.5-hrm.6', to: 'v0.8.5-hrm.7' },
+  lastBackup: { at: '2026-11-03T09:59:00Z', sizeKb: 90000 },
+  offsiteBackup: { result: 'success', at: '2026-11-03T05:30:00Z', compressedBytes: 1000 },
+  disk: { totalKb: 1000, usedKb: 420 },
+  updateCheck: { result: 'success', at: '2026-11-03T07:30:00Z' },
+  notifications: { result: 'success', at: '2026-11-03T08:00:00Z' },
+  tunnel: { version: '2026.10.4', running: true, lastUpdate: { result: 'success', at: '2026-11-03T00:00:00Z' } },
+  ...over,
+}), NOW);
+const job = (status: string, created_at: string) => ({ status, created_at, updated_at: created_at });
+const build = (over: Partial<Parameters<typeof buildStatusReport>[0]> = {}) =>
+  buildStatusReport({ server: server(), jobs: [], deploys: [], origin: ORIGIN, now: NOW, ...over });
+
+describe('status report', () => {
+  it('reports a healthy server with deploy counts per day', () => {
+    const report = build({
+      deploys: [
+        { deployed_at: '2026-11-03T11:10:00Z' },
+        { deployed_at: '2026-11-03T11:40:00Z' },
+        { deployed_at: '2026-11-01T09:00:00Z' },
+        { deployed_at: '2026-10-01T09:00:00Z' },
+      ],
+    });
+    expect(report).toMatchObject({
+      version: 1, tool: 'intuneget', generatedAt: '2026-11-03T12:00:00.000Z', health: 'ok', status: 'Up',
+      metric: { value: 3, label: 'apps deployed in 14 days' },
+      foot: ['Running v0.8.5-hrm.7', 'Disk 42% used'],
+      todos: [],
+    });
+    expect(report.series.values).toHaveLength(14);
+    expect(report.series.values.slice(-3)).toEqual([1, 0, 2]);
+    expect(report.events).toEqual([
+      { at: '2026-11-03T11:40:00.000Z', text: '2 apps deployed to Intune', tone: 'ok' },
+      { at: '2026-11-03T10:00:00.000Z', text: 'Server updated to v0.8.5-hrm.7', tone: 'ok' },
+      { at: '2026-11-03T05:30:00.000Z', text: 'Off-site backup finished', tone: 'ok' },
+    ]);
+  });
+
+  it('turns server problems into to-dos, worst first in the pill', () => {
+    const report = build({
+      server: server({
+        disk: { totalKb: 100, usedKb: 91 },
+        lastDeploy: { time: '2026-11-03T10:00:00Z', result: 'rolled_back', from: 'a', to: 'b' },
+      }),
+    });
+    expect(report).toMatchObject({ health: 'warn', status: 'Deploy failed' });
+    expect(report.todos).toEqual([
+      { id: 'server-deploy', title: 'The last deploy did not finish', link: `${ORIGIN}/dashboard` },
+      { id: 'server-disk', title: 'Disk space is running low', link: `${ORIGIN}/dashboard` },
+    ]);
+    expect(report.events).toContainEqual({ at: '2026-11-03T10:00:00.000Z', text: 'Server update did not finish', tone: 'down' });
+  });
+
+  it('warns when the status file is missing or stale, without guessing', () => {
+    expect(build({ server: interpretServerStatus(null, NOW) })).toMatchObject({
+      health: 'warn', status: 'No server status', foot: [],
+      todos: [{ id: 'server-status', title: 'The server status file has stopped updating' }],
+    });
+    expect(build({ server: server({ generatedAt: '2026-11-03T11:00:00Z' }) }).status).toBe('Status file stale');
+  });
+
+  it('counts failed and stuck packaging jobs', () => {
+    const report = build({
+      jobs: [
+        job('failed', '2026-11-03T09:00:00Z'),
+        job('failed', '2026-11-02T09:00:00Z'),
+        job('failed', '2026-10-01T09:00:00Z'),
+        job('queued', '2026-11-03T08:00:00Z'),
+        job('queued', '2026-11-03T11:30:00Z'),
+      ],
+    });
+    expect(report).toMatchObject({ health: 'warn', status: '2 failed' });
+    expect(report.todos).toEqual([
+      { id: 'jobs-failed', title: '2 packaging jobs failed in the last 7 days', link: `${ORIGIN}/dashboard/uploads?status=failed` },
+      { id: 'jobs-stuck', title: '1 packaging job waiting more than 2 hours', link: `${ORIGIN}/dashboard/uploads?status=pending` },
+    ]);
+    expect(report.events.filter((event) => event.tone === 'warn')).toHaveLength(2);
+  });
+
+  it('marks the tool down when the database cannot be read', () => {
+    expect(build({ jobs: null })).toMatchObject({ health: 'down', status: 'Database error' });
+    expect(build({ deploys: null, server: interpretServerStatus(null, NOW) })).toMatchObject({ health: 'down', status: 'Database error' });
+  });
+
+  it('leaves links out unless the server address is https', () => {
+    const report = build({ origin: 'http://localhost:3000', jobs: [job('failed', '2026-11-03T09:00:00Z')] });
+    expect(report.todos[0]).not.toHaveProperty('link');
+  });
+
+  it('drops independent forbidden markers from every raw input field', () => {
+    const marker = (field: string) => `FORBIDDEN_${field}`;
+    const raw = (fields: string[]) => Object.fromEntries(fields.map(field => [field, marker(field)]));
+    const report = build({
+      server: server({
+        ...raw(['version', 'startedAt', 'extra', 'device_name', 'staff_name', 'error']),
+        lastDeploy: { ...raw(['from', 'to', 'error']), time: NOW.toISOString(), result: marker('result') },
+        lastBackup: raw(['at', 'sizeKb']), offsiteBackup: { at: NOW.toISOString(), result: marker('backup_result') },
+        tunnel: { ...raw(['version', 'device_name']), running: false, lastUpdate: raw(['result', 'at']) },
+        updateCheck: raw(['result', 'at']), notifications: raw(['result', 'at']),
+      }),
+      jobs: [{ ...raw(['display_name', 'user_email', 'tenant_id', 'status_message', 'staff_name', 'device_name', 'id']),
+        ...job('failed', NOW.toISOString()) }, { ...job(marker('job_status'), marker('created_at')), updated_at: marker('updated_at') }],
+      deploys: [{ ...raw(['display_name', 'user_id', 'tenant_id', 'device_name', 'error']), deployed_at: NOW.toISOString() },
+        { deployed_at: marker('deployed_at') }],
+      origin: `${ORIGIN}/FORBIDDEN_path?value=FORBIDDEN_query#FORBIDDEN_fragment`,
+    });
+    expect(JSON.stringify(report)).not.toContain('FORBIDDEN');
+    for (const field of ['generatedAt', 'disk']) {
+      const bad = build({ server: server({ [field]: marker(field) }) });
+      expect(JSON.stringify(bad)).not.toContain('FORBIDDEN');
+    }
+    for (const field of ['totalKb', 'usedKb']) {
+      expect(JSON.stringify(build({ server: server({ disk: { totalKb: 1, usedKb: 1, [field]: marker(field) } }) }))).not.toContain('FORBIDDEN');
+    }
+  });
+
+  it('checks each server-status leaf independently with a synthetic forbidden marker', () => {
+    const fixture = server() as unknown as Record<string, unknown>;
+    const leaves = (value: unknown, prefix: string[] = []): string[][] => {
+      if (value && typeof value === 'object' && !Array.isArray(value)) {
+        return Object.entries(value).flatMap(([key, child]) => leaves(child, [...prefix, key]));
+      }
+      return [prefix];
+    };
+    for (const fields of leaves(fixture)) {
+      const copy = structuredClone(fixture);
+      let parent = copy;
+      for (const field of fields.slice(0, -1)) parent = parent[field] as Record<string, unknown>;
+      parent[fields.at(-1)!] = 'FORBIDDEN_SERVER_FIELD';
+      const report = build({ server: interpretServerStatus(JSON.stringify(copy), NOW) });
+      expect(JSON.stringify(report), fields.join('.')).not.toContain('FORBIDDEN');
+    }
+  });
+
+  it('uses parsed https origins only, without credentials, paths, queries or fragments', () => {
+    const jobs = [job('failed', NOW.toISOString())];
+    for (const origin of ['https://', 'invalid', 'http://example.test', 'https://FORBIDDEN:FORBIDDEN@example.test']) {
+      expect(build({ origin, jobs }).todos[0]).not.toHaveProperty('link');
+    }
+    expect(build({ origin: `${ORIGIN}/discard?discard=yes#discard`, jobs }).todos[0].link).toBe(`${ORIGIN}/dashboard/uploads?status=failed`);
+  });
+
+  it('omits waiting deployments and accepts only release tags as version text', () => {
+    expect(build({ server: server({ version: 'FORBIDDEN', lastDeploy: { time: NOW.toISOString(), result: 'waiting', to: 'FORBIDDEN' } }) }).events.some(event => event.text.startsWith('Server updated'))).toBe(false);
+    for (const version of ['FORBIDDEN', 'x'.repeat(100_000), 'v1.2.3-extra', 'v1.2.3\n', 'v1.2.3\nFORBIDDEN']) {
+      const report = build({ server: server({ version, lastDeploy: { time: NOW.toISOString(), result: 'deployed', to: version } }) });
+      expect(report.foot.some(line => line.startsWith('Running'))).toBe(false);
+      expect(report.events).toContainEqual({ at: NOW.toISOString(), text: 'Server updated', tone: 'ok' });
+    }
+  });
+
+  it('uses UTC calendar buckets at midnight and noon and ignores future deployments', () => {
+    for (const time of ['2026-11-03T00:00:00Z', '2026-11-03T12:00:00Z']) {
+      const report = build({ now: new Date(time), deploys: [
+        { deployed_at: '2026-11-02T23:59:59Z' }, { deployed_at: '2026-11-03T00:00:00Z' },
+        { deployed_at: '2026-11-04T00:00:00Z' },
+      ] });
+      expect(report.series.values.slice(-2)).toEqual([1, 1]);
+    }
+  });
+
+  it('enforces all text and item limits centrally and stays below 64 KB in UTF-8', () => {
+    const report = build();
+    const long = '界'.repeat(10_000);
+    report.status = long;
+    report.metric.label = long;
+    report.series.label = long;
+    report.foot = [long, long, long];
+    report.todos = Array.from({ length: 30 }, () => ({ id: long, title: long, detail: long }));
+    report.events = Array.from({ length: 30 }, () => ({ at: NOW.toISOString(), text: long, tone: 'ok' as const }));
+    const bounded = constrainReport(report, NOW);
+    expect(bounded.status.length).toBe(24);
+    expect(bounded.metric.label.length).toBe(40);
+    expect(bounded.series.label.length).toBeLessThanOrEqual(60);
+    expect(bounded.foot).toHaveLength(2);
+    expect(bounded.foot.every(line => line.length <= 60)).toBe(true);
+    expect(bounded.todos).toHaveLength(20);
+    expect(bounded.todos.every(todo => todo.id.length <= 80 && todo.title.length <= 100 && todo.detail!.length <= 100)).toBe(true);
+    expect(bounded.events).toHaveLength(20);
+    expect(bounded.events.every(event => event.text.length <= 80)).toBe(true);
+    expect(Buffer.byteLength(JSON.stringify(bounded))).toBeLessThan(65_536);
+    bounded.todos = bounded.todos.map(todo => ({ ...todo, link: `${ORIGIN}/${'界'.repeat(1_900)}` }));
+    const oversized = constrainReport(bounded, NOW);
+    expect(oversized.health).toBe('down');
+    expect(Buffer.byteLength(JSON.stringify(oversized))).toBeLessThan(65_536);
+  });
+
+  it('keeps events only within the last 48 hours, newest first, at most 20', () => {
+    const deploys = Array.from({ length: 60 }, (_, hour) => ({ deployed_at: new Date(NOW.getTime() - hour * 3_600_000).toISOString() }));
+    deploys.push({ deployed_at: new Date(NOW.getTime() + 3_600_000).toISOString() });
+    const report = build({ deploys });
+    expect(report.events).toHaveLength(20);
+    expect(report.events.every(event => Date.parse(event.at) <= NOW.getTime() && Date.parse(event.at) >= NOW.getTime() - 48 * 3_600_000)).toBe(true);
+    expect(report.events.map(event => event.at)).toEqual(report.events.map(event => event.at).sort().reverse());
+  });
+
+});
+
+describe('report key', () => {
+  const key = 'k'.repeat(64);
+  it('accepts only the exact bearer key, and nothing when the key is unset or short', () => {
+    expect(reportKeyMatches(`Bearer ${key}`, key)).toBe(true);
+    expect(reportKeyMatches(`Bearer ${'s'.repeat(32)}`, 's'.repeat(32))).toBe(true);
+    expect(reportKeyMatches(`Bearer ${key}x`, key)).toBe(false);
+    expect(reportKeyMatches(`Bearer ${key}\n`, key)).toBe(false);
+    expect(reportKeyMatches(key, key)).toBe(false);
+    expect(reportKeyMatches(null, key)).toBe(false);
+    expect(reportKeyMatches('Bearer ', undefined)).toBe(false);
+    expect(reportKeyMatches('Bearer short', 'short')).toBe(false);
+  });
+});
