@@ -0,0 +1,67 @@
+import { NextRequest } from 'next/server';
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+const mocks = vi.hoisted(() => ({ byStatus: vi.fn(), history: vi.fn(), status: vi.fn() }));
+vi.mock('@/lib/db', () => ({
+  getDatabase: () => ({ jobs: { getByStatus: mocks.byStatus }, uploadHistory: { listAll: mocks.history } }),
+}));
+vi.mock('@/lib/hrm/home', async (original) => ({ ...(await original<typeof import('@/lib/hrm/home')>()), readServerStatus: mocks.status }));
+import { GET } from './route';
+
+const KEY = 'a'.repeat(64);
+// Each test starts two minutes after the last, so earlier requests don't count against the rate limit.
+let testIndex = 0;
+const request = (authorization?: string) => new NextRequest('http://localhost/api/status-report', {
+  headers: authorization ? { authorization } : {},
+});
+
+beforeEach(() => {
+  vi.useFakeTimers();
+  vi.setSystemTime(new Date(Date.UTC(2026, 10, 3, 12) + testIndex++ * 120_000));
+  process.env.STATUS_REPORT_KEY = KEY;
+  mocks.byStatus.mockReset().mockResolvedValue([]);
+  mocks.history.mockReset().mockResolvedValue([]);
+  mocks.status.mockReset().mockResolvedValue({ reported: false, reason: 'missing' });
+});
+afterEach(() => {
+  vi.useRealTimers();
+  delete process.env.STATUS_REPORT_KEY;
+});
+
+describe('status report route', () => {
+  it('rejects a missing or wrong key without reading anything', async () => {
+    for (const header of [undefined, 'Bearer wrong', `Basic ${KEY}`]) {
+      const response = await GET(request(header));
+      expect(response.status).toBe(401);
+      expect(await response.text()).toBe('');
+    }
+    expect(mocks.byStatus).not.toHaveBeenCalled();
+    expect(mocks.status).not.toHaveBeenCalled();
+  });
+
+  it('rejects every key when STATUS_REPORT_KEY is unset or short', async () => {
+    delete process.env.STATUS_REPORT_KEY;
+    expect((await GET(request('Bearer '))).status).toBe(401);
+    process.env.STATUS_REPORT_KEY = 'short';
+    expect((await GET(request('Bearer short'))).status).toBe(401);
+  });
+
+  it('answers the right key with a version 1 report that is never cached', async () => {
+    const response = await GET(request(`Bearer ${KEY}`));
+    expect(response.status).toBe(200);
+    expect(response.headers.get('cache-control')).toBe('no-store');
+    expect(await response.json()).toMatchObject({ version: 1, tool: 'intuneget', health: 'warn', status: 'No server status' });
+  });
+
+  it('reports the database as down instead of failing', async () => {
+    mocks.history.mockRejectedValue(new Error('locked'));
+    expect(await (await GET(request(`Bearer ${KEY}`))).json()).toMatchObject({ health: 'down', status: 'Database error' });
+  });
+
+  it('allows about one request a minute per key', async () => {
+    expect((await GET(request(`Bearer ${KEY}`))).status).toBe(200);
+    expect((await GET(request(`Bearer ${KEY}`))).status).toBe(200);
+    expect((await GET(request(`Bearer ${KEY}`))).status).toBe(429);
+    vi.advanceTimersByTime(61_000);
+    expect((await GET(request(`Bearer ${KEY}`))).status).toBe(200);
+  });
+});
