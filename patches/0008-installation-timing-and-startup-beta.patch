+import {describe,it,expect} from 'vitest';
+import {assignmentSnapshot,carryoverAssignments,assertAssignmentDeadlines,type AssignmentTimingReview} from '../src/assignment-settings';
+const source='11111111-1111-4111-8111-111111111111',now=Date.parse('2026-11-24T12:00:00Z');
+const rows=[{id:'assignment',intent:'required',target:{'@odata.type':'#microsoft.graph.groupAssignmentTarget',groupId:'pilot'},settings:{notifications:'hideAll',installTimeSettings:{useLocalTime:false,startDateTime:'2026-01-01T00:00:00Z',deadlineDateTime:'2026-01-02T00:00:00Z'},restartSettings:{gracePeriodInMinutes:1440}}}];
+const review=(decision:'retain'|'reschedule'='retain',newDeadline?:string):AssignmentTimingReview=>({sourceAppId:source,expected:assignmentSnapshot(rows),expiredDates:'keep',deadlineConfirmation:{decision,assignmentIds:['assignment'],newDeadline}});
+describe('replacement deadline admission',()=>{
+ it('holds old flag-off requests and rejects the old reset-to-ASAP shortcut',()=>{
+  expect(()=>carryoverAssignments(rows,source,undefined,now,false)).toThrow('Paused for IT');
+  expect(()=>carryoverAssignments(rows,source,{sourceAppId:source,expected:assignmentSnapshot(rows),expiredDates:'reset'},now,false)).toThrow('Paused for IT');
+ });
+ it('retains explicitly and reschedules only affected deadlines without mutating any input',()=>{
+  const optional={...rows[0],id:'optional',intent:'available'},input=[...rows,optional],before=structuredClone(input);
+  const r={...review('reschedule','2026-11-25T12:00:00Z'),expected:assignmentSnapshot(input)};
+  const out=carryoverAssignments(input,source,r,now,false);
+  expect(out.find(r=>r.intent==='required')?.settings).toMatchObject({...rows[0].settings,installTimeSettings:{...rows[0].settings.installTimeSettings,deadlineDateTime:'2026-11-25T12:00:00Z'}});
+  expect(out.find(r=>r.intent==='available')?.settings).toMatchObject(rows[0].settings);expect(input).toEqual(before);
+  expect(carryoverAssignments(rows,source,review(),now,false)[0].settings).toMatchObject(rows[0].settings);
+ });
+ it('rejects stale reviews and rechecks a new deadline on retries',()=>{
+  expect(()=>assertAssignmentDeadlines([{...rows[0],intent:'available'}],source,review(),now)).toThrow('changed after review');
+  expect(()=>assertAssignmentDeadlines(rows,'other',review(),now)).toThrow('changed after review');
+  expect(()=>assertAssignmentDeadlines(rows,source,review('reschedule','2026-11-25T12:00:00Z'),now+172800000)).toThrow('future');
+ });
+ it('requires another confirmation if another assignment expires after review',()=>{
+  const future={...rows[0],id:'later',settings:{...rows[0].settings,installTimeSettings:{...rows[0].settings.installTimeSettings,deadlineDateTime:'2026-11-25T00:00:00Z'}}},both=[...rows,future],r={...review(),expected:assignmentSnapshot(both)};
+  expect(()=>assertAssignmentDeadlines(both,source,r,now)).not.toThrow();expect(()=>assertAssignmentDeadlines(both,source,r,now+86400000)).toThrow('another deadline expired');
+ });
+ it.each(['bad','2026-02-30T12:00:00Z','2026-11-24T10:00:00Z'])('rejects invalid new deadlines %s',value=>expect(()=>assertAssignmentDeadlines(rows,source,review('reschedule',value),now)).toThrow());
+ it('does not hold future UTC or optional deadlines',()=>{
+  const input=[{...rows[0],intent:'available'},{...rows[0],id:'future',settings:{installTimeSettings:{useLocalTime:false,deadlineDateTime:'2027-01-01T00:00:00Z'}}}];
+  expect(carryoverAssignments(input,source,undefined,now,false)).toHaveLength(2);
+ });
+ it('reviews only local deadlines that may already be due, and rejects a new wall time that is due in UTC+14',()=>{
+  const local=(hours:number)=>[{...rows[0],settings:{installTimeSettings:{useLocalTime:true,deadlineDateTime:new Date(now+hours*3600000).toISOString()}}}];
+  expect(()=>assertAssignmentDeadlines(local(13),source,undefined,now)).toThrow('Paused for IT');
+  expect(()=>assertAssignmentDeadlines(local(15),source,undefined,now)).not.toThrow();
+  const input=local(13),r={...review('reschedule',new Date(now+13*3600000).toISOString()),expected:assignmentSnapshot(input)};
+  expect(()=>assertAssignmentDeadlines(input,source,r,now)).toThrow('14 hours');
+ });
+});
