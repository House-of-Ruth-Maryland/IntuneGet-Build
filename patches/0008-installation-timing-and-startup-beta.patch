+    expect(output).toMatch(/Show-ADTInstallationWelcome[^\n]*-AllowDeferCloseProcesses[^\n]*-ForceCloseProcessesCountdown 90[^\n]*-DeferTimes 3/);
+    expect(output).not.toContain('-CloseProcessesCountdown 60');
