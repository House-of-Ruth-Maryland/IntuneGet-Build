+'use client';
+import { installExperience, installSettingsProblem, TOOLKIT_MODES, type PackagingPath } from '@/lib/hrm/install-experience';
+import type { PSADTConfig, DeployMode } from '@/types/psadt';
+import { useId } from 'react';
+
+export function ToolkitModePicker({ config, path, onChange }: { config: PSADTConfig; path: PackagingPath; onChange: (value: DeployMode) => void }) {
+  const id = useId();
+  return <div className="space-y-2">
+    <label htmlFor={id} className="block text-sm font-medium text-text-secondary">Toolkit windows</label>
+    <select id={id} value={config.deployMode || 'Silent'} disabled={!!config.installAfterRestartBeta || path === 'unknown' || path === 'unavailable'}
+      onChange={event => onChange(event.target.value as DeployMode)}
+      className="w-full rounded-lg border border-overlay/15 bg-bg-elevated px-3 py-2 text-sm text-text-primary disabled:opacity-60">
+      {TOOLKIT_MODES.map(mode => <option key={mode.value} value={mode.value} disabled={mode.value === 'Auto' && path === 'local'}>{mode.label}{mode.value === 'Auto' && path === 'local' ? ' (unavailable locally)' : ''}</option>)}
+    </select>
+    <p className="text-xs text-text-muted">Controls IntuneGet’s toolkit windows. The vendor installer still uses its configured command and switches. Intune notifications are separate.</p>
+    <a href="/dashboard/help#install-settings" className="inline-block text-xs text-accent-cyan underline-offset-4 hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-accent-cyan">Installation settings guide</a>
+  </div>;
+}
+
+export function InstallExperienceSummary({ config, path }: { config: PSADTConfig; path: PackagingPath }) {
+  const experience = installExperience(config, path);
+  return <section aria-label="Effective staff experience" className="rounded-lg border border-overlay/15 bg-bg-elevated/60 p-4 text-sm leading-relaxed">
+    <h3 className="font-semibold text-text-primary">Staff experience</h3>
+    <p className="mt-1 text-text-secondary">{experience.staff}</p>
+    {experience.visible && (experience.progress || experience.notifications || experience.messages) && <p className="mt-2 text-text-secondary">Enabled toolkit windows: {[experience.progress && 'installation progress', experience.notifications && `${experience.enabledNotifications} notifications`, experience.messages && `${experience.enabledMessages} custom messages when interactive`].filter(Boolean).join(', ')}.</p>}
+    {experience.automatic && config.allowDefer && <p className="mt-2 text-text-secondary">Postponement: {experience.deferral}.</p>}
+    {installSettingsProblem(config, path) && <p role="alert" tabIndex={-1} data-install-settings-problem className="mt-2 rounded-sm text-status-warning focus-visible:outline focus-visible:outline-2 focus-visible:outline-accent-cyan">{installSettingsProblem(config, path)}</p>}
+    {experience.known && experience.background.length > 0 && <div className="mt-3 border-t border-overlay/10 pt-3"><p className="font-medium text-text-primary">Background actions</p><ul className="mt-1 list-disc space-y-1 pl-4 text-text-secondary">{experience.background.map(line => <li key={line}>{line}</li>)}</ul></div>}
+    {experience.restartPrompt && <p className="mt-2 text-status-warning">The package restart countdown can restart the computer after installation, even when the installer did not request a restart.</p>}
+    {path === 'github' && config.restartBehavior !== 'Suppress' && <p className="mt-2 text-text-secondary">{config.restartBehavior === 'Force' ? 'Intune is configured to force a restart. Toolkit window settings do not suppress it.' : 'Intune handles restart-required return codes using the assignment’s restart settings.'}</p>}
+    {experience.known && !experience.automatic && (config.allowDefer || config.showClosePrompt || config.customPrompts?.some(p => p.enabled)) && <details className="mt-3 text-text-secondary"><summary className="cursor-pointer rounded-sm focus-visible:outline focus-visible:outline-2 focus-visible:outline-accent-cyan">Saved question settings are inactive</summary><p className="mt-2 text-xs">Your saved close-app, postponement and message choices are kept. They do not ask staff in this mode. Choose Ask when needed to use them on a supported packaging service.</p></details>}
+    {path === 'local' && <p className="mt-2 text-xs text-text-muted">This local packager supports process handling and disk checks. Branding, status messages and package restart countdowns are not generated; Intune restart behavior is suppressed.</p>}
+    {path === 'unknown' && <p role="status" className="mt-2 text-xs text-text-muted">Installation options are unavailable until this server’s packaging capabilities can be verified. Reload after signing in.</p>}
+  </section>;
+}
