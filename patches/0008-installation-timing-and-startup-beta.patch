+import { beforeEach, describe, expect, it, vi } from 'vitest';
+import { NextRequest } from 'next/server';
+const state = vi.hoisted(() => ({ signedIn: true, local: false, pipeline: true, github: true, startup: false, dates: false }));
+vi.mock('@/lib/auth-utils', () => ({ parseAccessToken: async () => state.signedIn ? { tenantId: 'fixture', userId: 'fixture' } : null }));
+vi.mock('@/lib/features', () => ({ getFeatureFlags: () => ({ pipeline: state.pipeline, localPackager: state.local }) }));
+vi.mock('@/lib/github-actions', () => ({ isGitHubActionsConfigured: () => state.github }));
+vi.mock('@/lib/hrm/packaging-capabilities', () => ({ startupPilotValidated: () => state.startup, deployDatesAttested: () => state.dates }));
+import { GET } from './route';
+beforeEach(() => Object.assign(state, { signedIn: true, local: false, pipeline: true, github: true, startup: false, dates: false }));
+describe('read-only packaging capability discovery', () => {
+  it('requires authentication and exposes no secrets', async () => {
+    state.signedIn = false;
+    expect((await GET(new NextRequest('http://localhost/api/fixture'))).status).toBe(401);
+    state.signedIn = true;
+    const response = await GET(new NextRequest('http://localhost/api/fixture'));
+    expect(await response.json()).toEqual({ path: 'github', startupBeta: false, deployDates: false });
+    expect(response.headers.get('Cache-Control')).toContain('no-store');
+  });
+  it('uses server configuration, never a client-selected mode', async () => {
+    state.local = true; state.startup = true;
+    expect(await (await GET(new NextRequest('http://localhost/api/fixture?path=github'))).json()).toEqual({ path: 'local', startupBeta: false, deployDates: true });
+    state.local = false; state.pipeline = false;
+    expect(await (await GET(new NextRequest('http://localhost/api/fixture'))).json()).toEqual({ path: 'unavailable', startupBeta: false, deployDates: false });
+  });
+  it('offers install dates in the deploy form only where packaging applies them', async () => {
+    // Hosted packaging needs the operator's attestation; a client cannot ask for it.
+    expect((await (await GET(new NextRequest('http://localhost/api/fixture?deployDates=true'))).json()).deployDates).toBe(false);
+    state.dates = true;
+    expect((await (await GET(new NextRequest('http://localhost/api/fixture'))).json()).deployDates).toBe(true);
+    state.pipeline = false;
+    expect((await (await GET(new NextRequest('http://localhost/api/fixture'))).json()).deployDates).toBe(false);
+  });
+});
