+              {selected && <label className="flex items-start gap-3 rounded-lg border border-status-warning/25 p-3 text-sm"><input type="radio" className="mt-1" name="installation-behavior" value="restart" checked={draft.mode === 'restart'} disabled={!!restartProblem} aria-describedby={restartProblem ? 'restart-installation-restriction' : undefined} onChange={() => { setDraft({ ...draft, mode: 'restart' }); setSaved(false); action.reset(); }} /><span><span className="block font-medium text-text-primary">Install after next restart · Beta</span><span className="block text-xs text-text-muted mt-1">Beta: Windows pilot testing required. Machine-wide MSI/EXE apps only. Use a Required assignment to pilot devices. Does not force a restart; no three-day deadline.</span></span></label>}
+              {selected && restartProblem && <p id="restart-installation-restriction" role={invalidRestart ? 'alert' : undefined} className="text-xs text-status-warning">{restartProblem} Review the app’s saved deployment configuration before choosing this Beta.</p>}
