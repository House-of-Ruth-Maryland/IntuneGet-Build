diff --git a/.github/scripts/Prepare-StartupPackage.ps1 b/.github/scripts/Prepare-StartupPackage.ps1
new file mode 100644
index 000000000..10d83cc0a
--- /dev/null
+++ b/.github/scripts/Prepare-StartupPackage.ps1
@@ -0,0 +1,37 @@
+# Packages the opt-in startup installer Beta using the existing reviewed PSADT package.
+[CmdletBinding()]
+param([Parameter(Mandatory=$true)][string]$PackageDirectory)
+$ErrorActionPreference='Stop'
+$config=if ($env:PSADT_CONFIG) { $env:PSADT_CONFIG | ConvertFrom-Json } else { [pscustomobject]@{} }
+$flag=$config.PSObject.Properties['installAfterRestartBeta']
+if (-not $flag -or $flag.Value -eq $false) { return }
+if ($flag.Value -isnot [bool]) { throw 'Invalid startup installer Beta setting.' }
+if ($env:INSTALL_SCOPE -ne 'machine' -or $env:INSTALLER_TYPE -notin @('msi','wix','exe','inno','nullsoft','burn')) { throw 'Startup installer Beta supports machine-wide MSI and EXE apps only.' }
+if ($config.customDetection -eq $true -or ($env:ESP_PROFILES -and @($env:ESP_PROFILES | ConvertFrom-Json).Count -gt 0) -or $env:SUPERSEDENCE_TYPE -eq 'replace') { throw 'Startup installer Beta requires automatic detection, no setup profiles and update supersedence.' }
+if ($config.restartBehavior -and $config.restartBehavior -ne 'Suppress') { throw 'Startup installer Beta requires suppressed restarts.' }
+if ($env:RELATIONSHIPS) { foreach ($relationship in @($env:RELATIONSHIPS | ConvertFrom-Json)) { if ($relationship.relationshipType -eq 'supersedence' -and $relationship.supersedenceType -eq 'replace') { throw 'Startup installer Beta requires update supersedence.' } } }
+$job=[guid]::Empty
+if (-not [guid]::TryParse($env:JOB_ID,[ref]$job) -or $env:WINGET_ID -notmatch '^[A-Za-z0-9_.-]{1,256}$') { throw 'Invalid startup package identity.' }
+$root=if ($config.registryMarkerPath) { [string]$config.registryMarkerPath } else { 'SOFTWARE\IntuneGet\Apps' }
+$root=$root.Trim().Replace('/','\') -replace '\\+', '\'
+$root=$root.Trim('\') -replace '^(HKLM|HKCU|HKEY_LOCAL_MACHINE|HKEY_CURRENT_USER):?(\\|$)', ''
+$root=$root -replace '[*?"''<>|\x00-\x1f]', ''
+$root=(@($root.Split('\') | ForEach-Object {$_.Trim()} | Where-Object {$_}) -join '\')
+if ($root -notmatch '^SOFTWARE\\') { throw 'Startup installer Beta requires a SOFTWARE registry marker.' }
+$sha=[Security.Cryptography.SHA256]::Create()
+try {$appKey=([BitConverter]::ToString($sha.ComputeHash([Text.Encoding]::UTF8.GetBytes($env:WINGET_ID.ToLowerInvariant())))).Replace('-','').ToLowerInvariant()} finally {$sha.Dispose()}
+$created=[DateTimeOffset]::MinValue
+if (-not [DateTimeOffset]::TryParse($env:JOB_CREATED_AT,[ref]$created)) { throw 'Startup packages require the original deployment creation time.' }
+$metadata=[ordered]@{v=1;createdAt=$created.UtcDateTime.ToString('yyyy-MM-ddTHH:mm:ss.fffZ');jobId=$job.ToString();appKey=$appKey;version=$env:VERSION;marker=$root+'\'+($env:WINGET_ID -replace '[.\-]','_')}
+$runner=Join-Path $PSScriptRoot 'IntuneGet-StartupInstall.ps1'
+if (-not (Test-Path -LiteralPath $runner)) { $runner=Join-Path $PSScriptRoot '..\..\packager\scripts\IntuneGet-StartupInstall.ps1' }
+Copy-Item -LiteralPath $runner -Destination (Join-Path $PackageDirectory 'IntuneGet-StartupInstall.ps1') -Force
+[IO.File]::WriteAllText((Join-Path $PackageDirectory 'startup-config.json'),($metadata | ConvertTo-Json -Compress),[Text.UTF8Encoding]::new($false))
+$uninstall=@'
+@echo off
+"%SystemRoot%\System32\WindowsPowerShell\v1.0\powershell.exe" -NoProfile -NonInteractive -ExecutionPolicy Bypass -File "%~dp0IntuneGet-StartupInstall.ps1" -Mode Cancel
+if errorlevel 1 exit /b %errorlevel%
+"%~dp0Invoke-AppDeployToolkit.exe" -DeploymentType Uninstall -DeployMode Silent
+exit /b %errorlevel%
+'@
+[IO.File]::WriteAllText((Join-Path $PackageDirectory 'Uninstall-AfterRestart.cmd'),($uninstall -replace "`r?`n","`r`n"),[Text.Encoding]::ASCII)
diff --git a/.github/scripts/Preserve-AssignmentSettings.ps1 b/.github/scripts/Preserve-AssignmentSettings.ps1
new file mode 100644
index 000000000..0171768b4
--- /dev/null
+++ b/.github/scripts/Preserve-AssignmentSettings.ps1
@@ -0,0 +1,198 @@
+# Pure replacement-assignment contract. Dot-source only; no Graph writes or installation.
+function Copy-IntuneGetAssignmentValue($Value) {
+    if($Value -is [Collections.IDictionary] -or $Value -is [pscustomobject]){
+        $map=Get-IntuneGetAssignmentMap $Value;$copy=[ordered]@{}
+        foreach($key in $map.Keys){$copy[$key]=Copy-IntuneGetAssignmentValue $map[$key]}
+        return $copy
+    }
+    if($Value -is [Collections.IEnumerable] -and $Value -isnot [string]){return ,@(foreach($item in $Value){Copy-IntuneGetAssignmentValue $item})}
+    return $Value
+}
+function Get-IntuneGetAssignmentMap($Value) {
+    $result=@{}
+    if ($Value -is [Collections.IDictionary]) { foreach($key in $Value.Keys){$result[[string]$key]=$Value[$key]} }
+    elseif ($null -ne $Value) { foreach($property in $Value.PSObject.Properties){$result[$property.Name]=$property.Value} }
+    return $result
+}
+function Get-IntuneGetPreservedSettings($Value) {
+    $old=Get-IntuneGetAssignmentMap $Value
+    $keys=@('@odata.type','@odata.context','notifications','deliveryOptimizationPriority','installTimeSettings','restartSettings','autoUpdateSettings','inUseSettings')
+    $unsupported=@($old.Keys | Where-Object {$_ -notin $keys} | Sort-Object)
+    if($unsupported.Count){
+        # Names only: never serialize settings values or the Graph response into errors.
+        # Bound output for callback limits; suppress nonstandard names (including control characters).
+        $names=@(foreach($key in @($unsupported | Select-Object -First 12)){
+            if($key -cmatch '^(?:@odata\.)?[A-Za-z][A-Za-z0-9_]{0,79}$'){$key}else{'[nonstandard field name]'}
+        })
+        $fields=ConvertTo-Json -InputObject $names -Compress
+        throw "Unsupported assignment settings. Review this copy in Intune before replacing it. Unsupported field names ($($unsupported.Count) total, at most 12 shown): $fields"
+    }
+    if($old.ContainsKey('@odata.type') -and $old['@odata.type'] -ne '#microsoft.graph.win32LobAppAssignmentSettings'){throw 'Only Win32 assignment settings can be carried over.'}
+    $result=[ordered]@{'@odata.type'='#microsoft.graph.win32LobAppAssignmentSettings';notifications='showAll';deliveryOptimizationPriority='notConfigured'}
+    foreach($key in $keys[2..7]){if($old.ContainsKey($key)){$result[$key]=Copy-IntuneGetAssignmentValue $old[$key]}}
+    # Graph beta $metadata: win32LobAppInUseSettings contains these three
+    # non-nullable Edm.Int32 values. Preserve values/absence/null exactly; do not
+    # infer defaults, disable prompting, or discard future behavioral settings.
+    if($old.ContainsKey('inUseSettings') -and $null -ne $old.inUseSettings){
+        if($old.inUseSettings -isnot [Collections.IDictionary] -and $old.inUseSettings -isnot [pscustomobject]){throw 'Invalid in-use assignment settings shape. Review this copy in Intune.'}
+        $inUse=Get-IntuneGetAssignmentMap $old.inUseSettings
+        $fields=@('countdownMinutes','minutesBetweenDeferrals','numberOfDeferrals')
+        foreach($key in $inUse.Keys){if($key -notin ($fields+@('@odata.type','@odata.context'))){throw 'Unsupported in-use assignment settings. Review this copy in Intune before replacing it.'}}
+        if($inUse.ContainsKey('@odata.type') -and $inUse['@odata.type'] -ne '#microsoft.graph.win32LobAppInUseSettings'){throw 'Invalid in-use assignment settings type. Review this copy in Intune.'}
+        foreach($key in $fields){
+            $value=$inUse[$key]
+            if(-not $inUse.ContainsKey($key) -or ($value -isnot [int] -and $value -isnot [long]) -or $value -lt [int]::MinValue -or $value -gt [int]::MaxValue){throw 'Invalid in-use assignment integer settings. Review this copy in Intune.'}
+        }
+    }
+    if($result.notifications -notin @('showAll','showReboot','hideAll')){throw 'Unsupported notification setting. Review it in Intune.'}
+    if($result.deliveryOptimizationPriority -notin @('notConfigured','foreground')){throw 'Unsupported download priority. Review it in Intune.'}
+    if($result.Contains('installTimeSettings') -and $null -ne $result.installTimeSettings){
+        $t=Get-IntuneGetAssignmentMap $result.installTimeSettings
+        if($t.useLocalTime -isnot [bool]){throw 'Invalid assignment time zone. Refresh the review.'}
+        foreach($key in @('startDateTime','deadlineDateTime')){if($t.ContainsKey($key) -and $null -ne $t[$key]){
+            $date=[DateTimeOffset]::MinValue
+            if(-not [DateTimeOffset]::TryParse([string]$t[$key],[ref]$date)){throw 'Invalid assignment date. Review it in Intune.'}
+        }}
+    }
+    return $result
+}
+function Get-IntuneGetAssignmentSnapshot([object[]]$Rows) {
+    $result=@()
+    foreach($value in $Rows){
+        $row=Get-IntuneGetAssignmentMap $value;$target=Get-IntuneGetAssignmentMap $row.target
+        if($row.ContainsKey('source') -and $null -ne $row.source -and $row.source -ne 'direct'){throw 'Inherited assignments need review in Intune before replacement.'}
+        if($row.intent -notin @('required','available','availableWithoutEnrollment','uninstall')){throw 'Unsupported assignment intent. Review it in Intune.'}
+        $type=[string]$target['@odata.type']
+        if($type -notin @('#microsoft.graph.allDevicesAssignmentTarget','#microsoft.graph.allLicensedUsersAssignmentTarget','#microsoft.graph.groupAssignmentTarget','#microsoft.graph.exclusionGroupAssignmentTarget')){throw 'Unsupported assignment target. Review it in Intune.'}
+        $kept=[ordered]@{'@odata.type'=$type}
+        foreach($key in @('groupId','deviceAndAppManagementAssignmentFilterId','deviceAndAppManagementAssignmentFilterType')){if($target.ContainsKey($key)){$kept[$key]=$target[$key]}}
+        $settings=if($type -like '*exclusionGroup*'){$null}else{Get-IntuneGetPreservedSettings $(if($row.ContainsKey('settings')){$row.settings}else{$null})}
+        $result+= [ordered]@{id=$(if($row.ContainsKey('id')){[string]$row.id}else{''});intent=$row.intent;target=$kept;settings=$settings}
+    }
+    return ,@($result|Sort-Object {$_.id})
+}
+function ConvertTo-IntuneGetAssignmentCanonical($Value) {
+    if($null -eq $Value){return 'null'}
+    if($Value -is [DateTime] -or $Value -is [DateTimeOffset]){return (ConvertTo-Json -InputObject ([DateTimeOffset]$Value).ToUniversalTime().ToString('o') -Compress)}
+    if($Value -is [string]){
+        if($Value -match '^\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d'){$date=[DateTimeOffset]::MinValue;if([DateTimeOffset]::TryParse($Value,[ref]$date)){return (ConvertTo-Json -InputObject $date.ToUniversalTime().ToString('o') -Compress)}}
+        return (ConvertTo-Json -InputObject $Value -Compress)
+    }
+    if($Value -is [Collections.IDictionary] -or $Value -is [pscustomobject]){
+        $map=Get-IntuneGetAssignmentMap $Value
+        $parts=@(foreach($key in @($map.Keys|Sort-Object)){(ConvertTo-Json -InputObject ([string]$key) -Compress)+':'+(ConvertTo-IntuneGetAssignmentCanonical $map[$key])})
+        return '{'+($parts -join ',')+'}'
+    }
+    if($Value -is [Collections.IEnumerable]){return '['+(@(foreach($item in $Value){ConvertTo-IntuneGetAssignmentCanonical $item}) -join ',')+']'}
+    return (ConvertTo-Json -InputObject $Value -Compress)
+}
+function Test-IntuneGetAssignmentDateReview([object[]]$Snapshot,[DateTimeOffset]$Now=[DateTimeOffset]::UtcNow) {
+    foreach($row in $Snapshot){
+        $s=Get-IntuneGetAssignmentMap $row.settings
+        if(-not $s.ContainsKey('installTimeSettings') -or $null -eq $s.installTimeSettings){continue}
+        $t=Get-IntuneGetAssignmentMap $s.installTimeSettings
+        foreach($key in @('startDateTime','deadlineDateTime')){if($t.ContainsKey($key) -and $null -ne $t[$key]){if($t.useLocalTime -eq $true -or [DateTimeOffset]::Parse([string]$t[$key]) -lt $Now){return $true}}}
+    }
+    return $false
+}
+function Assert-IntuneGetReplacementDeadlines([object[]]$Snapshot,[string]$SourceAppId,$Review=$null,[DateTimeOffset]$Now=[DateTimeOffset]::UtcNow) {
+    $map=Get-IntuneGetAssignmentMap $Review
+    if($null -ne $Review -and ($map.sourceAppId -ne $SourceAppId -or (ConvertTo-IntuneGetAssignmentCanonical $Snapshot) -cne (ConvertTo-IntuneGetAssignmentCanonical $map.expected))){throw 'Assignments changed after review. Review the deadlines again.'}
+    $affected=@($Snapshot | Where-Object {
+        $t=Get-IntuneGetAssignmentMap $_.settings.installTimeSettings
+        $_.intent -eq 'required' -and $_.target['@odata.type'] -notlike '*exclusionGroup*' -and $null -ne $t.deadlineDateTime -and ([DateTimeOffset]::Parse([string]$t.deadlineDateTime) -le $(if($t.useLocalTime -eq $true){$Now.AddHours(14)}else{$Now}))
+    })
+    if(-not $affected.Count){return ,$affected}
+    $confirmation=Get-IntuneGetAssignmentMap $map.deadlineConfirmation
+    if($confirmation.decision -notin @('retain','reschedule') -or $map.expiredDates -ne 'keep'){throw 'Paused for IT: explicitly retain expired deadlines or choose a new future deadline before packaging.'}
+    $ids=@($affected | ForEach-Object {[string]$_.id} | Sort-Object)
+    if(@($ids | Where-Object {-not $_}).Count -or @($ids | Select-Object -Unique).Count -ne $ids.Count -or (ConvertTo-IntuneGetAssignmentCanonical $ids) -cne (ConvertTo-IntuneGetAssignmentCanonical @($confirmation.assignmentIds | Sort-Object))){throw 'The affected assignments changed or another deadline expired. Review again.'}
+    if($confirmation.decision -eq 'reschedule'){
+        $date=[DateTimeOffset]::MinValue
+        $text=if($confirmation.newDeadline -is [DateTime] -or $confirmation.newDeadline -is [DateTimeOffset]){([DateTimeOffset]$confirmation.newDeadline).ToUniversalTime().ToString('yyyy-MM-ddTHH:mm:ss.fffZ')}else{[string]$confirmation.newDeadline}
+        if($text -notmatch '^\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d(\.\d{3})?Z$' -or -not [DateTimeOffset]::TryParse($text,[ref]$date) -or $date.UtcDateTime.ToString('yyyy-MM-ddTHH:mm:ss') -ne $text.Substring(0,19)){throw 'Enter a valid new deadline.'}
+        foreach($row in $affected){
+            $t=Get-IntuneGetAssignmentMap $row.settings.installTimeSettings
+            $cutoff=if($t.useLocalTime -eq $true){$Now.AddHours(14)}else{$Now}
+            if($date -le $cutoff){throw 'The new deadline must still be in the future; device-local deadlines need 14 hours of lead time.'}
+            if($t.startDateTime -and $date -lt [DateTimeOffset]::Parse([string]$t.startDateTime)){throw 'The new deadline must be at or after every affected availability date.'}
+        }
+    }
+    return ,$affected
+}
+function Get-IntuneGetCarriedAssignments([object[]]$Rows,[string]$SourceAppId,$Review=$null,[DateTimeOffset]$Now=[DateTimeOffset]::UtcNow,[bool]$RequireDateReview=$true) {
+    $snapshot=Get-IntuneGetAssignmentSnapshot $Rows
+    $reviewMap=Get-IntuneGetAssignmentMap $Review
+    $affected=Assert-IntuneGetReplacementDeadlines $snapshot $SourceAppId $Review $Now
+    $affectedIds=@($affected | ForEach-Object {[string]$_.id})
+    if($null -ne $Review){
+        if(-not $reviewMap.ContainsKey('sourceAppId') -or -not $reviewMap.ContainsKey('expected') -or -not $reviewMap.ContainsKey('expiredDates')){throw 'Invalid assignment review. Review this update again.'}
+        if($reviewMap.sourceAppId -ne $SourceAppId -or $reviewMap.expiredDates -notin @('keep','reset') -or (ConvertTo-IntuneGetAssignmentCanonical $snapshot) -cne (ConvertTo-IntuneGetAssignmentCanonical $reviewMap.expected)){throw 'Assignments changed after review. Refresh App updates and review again.'}
+    }
+    if($RequireDateReview -and (Test-IntuneGetAssignmentDateReview $snapshot $Now) -and $null -eq $Review){throw 'Past or device-local assignment dates require review before replacement. Review this update before retrying.'}
+    $result=@()
+    foreach($row in $snapshot){
+        $id=$row.id
+        $row.Remove('id');$row['@odata.type']='#microsoft.graph.mobileAppAssignment'
+        if($null -eq $row.settings){$row.Remove('settings')}
+        elseif($null -ne $Review -and $reviewMap.expiredDates -eq 'reset'){$row.settings['installTimeSettings']=$null}
+        elseif($id -in $affectedIds -and $reviewMap.deadlineConfirmation.decision -eq 'reschedule'){$row.settings.installTimeSettings.deadlineDateTime=$reviewMap.deadlineConfirmation.newDeadline}
+        $result+=$row
+    }
+    return ,$result
+}
+# Install dates chosen in the deploy form for a new deployment. Mirrors deployTimingProblem and
+# deployTimingSettings in packager/src/assignment-settings.ts. Returns only the settings to add;
+# an empty result means the group starts as soon as possible. Throws rather than guessing.
+# It reads the assignment's raw JSON text: ConvertFrom-Json rewrites date strings (a date without a
+# time zone becomes the runner's local time), so a parsed object cannot be validated exactly.
+function Get-IntuneGetDeployTiming([string]$AssignmentJson,[bool]$RestartSupported=$false) {
+    $dates='Enter valid Available from and Must install by dates.'
+    $range='Use whole minutes: grace 1 to 20160, countdown 1 to grace, and snooze 0 to grace (0 disables snooze).'
+    $result=[ordered]@{}
+    $document=[Text.Json.JsonDocument]::Parse($AssignmentJson)
+    try {
+        $root=$document.RootElement
+        if($root.ValueKind -ne [Text.Json.JsonValueKind]::Object){return $result}
+        $get={param($element,[string]$name) $value=[Text.Json.JsonElement]::new(); if($element.TryGetProperty($name,[ref]$value) -and $value.ValueKind -ne [Text.Json.JsonValueKind]::Null){return ,$value}; return $null}
+        $text={param($element,[string]$name) $value=& $get $element $name; if($null -ne $value -and $value.ValueKind -eq [Text.Json.JsonValueKind]::String){return $value.GetString()}; return ''}
+        $names={param($element) return (@(foreach($property in $element.EnumerateObject()){$property.Name}) | Sort-Object -CaseSensitive) -join ','}
+        $time=& $get $root 'installTimeSettings'; $restart=& $get $root 'restartSettings'
+        if($null -eq $time -and $null -eq $restart){return $result}
+        if((& $text $root 'type') -cnotin @('allUsers','allDevices','group')){throw 'Excluded groups cannot have install dates.'}
+        $intent=& $text $root 'intent'
+        if($intent -cnotin @('required','available')){throw 'Only Required and Available groups can have install dates.'}
+        if($null -ne $time){
+            if($time.ValueKind -ne [Text.Json.JsonValueKind]::Object -or (& $names $time) -cne 'deadlineDateTime,startDateTime,useLocalTime'){throw $dates}
+            $local=$time.GetProperty('useLocalTime')
+            if($local.ValueKind -notin @([Text.Json.JsonValueKind]::True,[Text.Json.JsonValueKind]::False)){throw $dates}
+            $read={param([string]$name)
+                $value=$time.GetProperty($name)
+                if($value.ValueKind -eq [Text.Json.JsonValueKind]::Null){return $null}
+                if($value.ValueKind -ne [Text.Json.JsonValueKind]::String){throw $dates}
+                $raw=$value.GetString();$date=[DateTimeOffset]::MinValue
+                if($raw -cnotmatch '^\d{4}-\d\d-\d\dT([01]\d|2[0-3]):[0-5]\d:[0-5]\dZ$' -or -not [DateTimeOffset]::TryParseExact($raw,"yyyy-MM-dd'T'HH:mm:ss'Z'",[Globalization.CultureInfo]::InvariantCulture,[Globalization.DateTimeStyles]::AssumeUniversal,[ref]$date)){throw $dates}
+                return $raw
+            }
+            $start=& $read 'startDateTime';$deadline=& $read 'deadlineDateTime'
+            if($intent -cne 'required' -and $null -ne $deadline){throw 'Only Required groups can have an installation deadline.'}
+            # Both are the same fixed-width UTC format, so ordinal order is time order.
+            if($null -ne $start -and $null -ne $deadline -and [string]::CompareOrdinal($deadline,$start) -lt 0){throw 'The installation deadline must be at or after availability.'}
+            if($null -ne $start -or $null -ne $deadline){$result['installTimeSettings']=[ordered]@{useLocalTime=$local.GetBoolean();startDateTime=$start;deadlineDateTime=$deadline}}
+        }
+        if($null -ne $restart){
+            if(-not $RestartSupported){throw 'A restart grace period needs a deployment that restarts based on the installer result or forces a restart.'}
+            $keys=@('gracePeriodInMinutes','countdownDisplayBeforeRestartInMinutes','restartNotificationSnoozeDurationInMinutes')
+            if($restart.ValueKind -ne [Text.Json.JsonValueKind]::Object -or (& $names $restart) -cne ((@($keys) | Sort-Object -CaseSensitive) -join ',')){throw $range}
+            $numbers=@(foreach($key in $keys){
+                $value=$restart.GetProperty($key);$number=[long]0
+                if($value.ValueKind -ne [Text.Json.JsonValueKind]::Number -or -not $value.TryGetInt64([ref]$number)){throw $range}
+                $number
+            })
+            $grace=$numbers[0];$countdown=$numbers[1];$snooze=$numbers[2]
+            if($grace -lt 1 -or $grace -gt 20160 -or $countdown -lt 1 -or $countdown -gt $grace -or $snooze -lt 0 -or $snooze -gt $grace){throw $range}
+            $result['restartSettings']=[ordered]@{gracePeriodInMinutes=[int]$grace;countdownDisplayBeforeRestartInMinutes=[int]$countdown;restartNotificationSnoozeDurationInMinutes=[int]$snooze}
+        }
+        return $result
+    } finally { $document.Dispose() }
+}
diff --git a/.github/workflows-reference/package-intunewin.yml b/.github/workflows-reference/package-intunewin.yml
