+            </dl>}
+            <div className="flex flex-wrap gap-4 text-xs"><Link href="/dashboard/inventory" className="text-accent-cyan hover:underline">Open Inventory for install results</Link><Link href="/dashboard/help#automatic-installation-policy" target="_blank" rel="noopener noreferrer" className="text-accent-cyan hover:underline">Automatic installation guide<span className="sr-only"> (opens in a new tab)</span></Link></div>
+            {action.error && <p role="alert" className="text-sm text-status-error">{action.error.message}</p>}
+            {saved && <p role="status" className="text-sm text-status-success">Installation policy saved for future automatic updates.</p>}
+          </div>
+          <DialogFooter><Button variant="ghost" disabled={action.isPending} onClick={() => setOpen(false)}>Close</Button><Button disabled={action.isPending || saved || invalidRestart} onClick={() => action.mutate({ action: selected && inherit ? 'inherit' : 'save', appId: selected, policy: draft }, { onSuccess: () => setSaved(true) })}>{action.isPending ? 'Saving…' : selected ? inherit ? 'Use shared policy' : 'Save app exception' : 'Save shared policy'}</Button></DialogFooter>
+        </DialogContent>
+      </Dialog>}
+  >
+    {error && <p role="alert" className="text-sm text-status-error">{error.message}</p>}
+    {exceptions.length > 0 && <details className="text-sm"><summary className="cursor-pointer text-accent-cyan">Review app exceptions</summary><ul className="mt-2 divide-y divide-overlay/10">{exceptions.map(exception => <li key={exception.appId} className="flex flex-wrap justify-between gap-2 py-2 text-sm"><div><span className="text-text-primary">{apps.find(a => a.winget_id.toLowerCase() === exception.appId.toLowerCase())?.deployment_config?.displayName || exception.appId}</span><p className="text-xs text-text-muted">{installationPolicySummary(exception)}</p></div><button className="text-xs text-accent-cyan hover:underline" onClick={() => { choose(exception.appId); setOpen(true); }}>Edit app exception</button></li>)}</ul></details>}
+  </StatusStripRow>;
+}
+
+/** Reuses the shared query cache so cards name their actual inherited rule. */
+export function AutoUpdateTimingSummary({ appId }: { appId: string }) {
+  const { data } = useInstallationPolicy();
+  if (!data?.shared) return null;
+  const exception = data.exceptions?.find(p => p.appId.toLowerCase() === appId.toLowerCase());
+  return <p className="mt-2 text-xs text-text-secondary"><span className="font-medium">{exception ? 'App exception' : 'Shared policy'}:</span> {installationPolicySummary(exception ?? data.shared)}. Applies to the next automatic release.</p>;
+}
