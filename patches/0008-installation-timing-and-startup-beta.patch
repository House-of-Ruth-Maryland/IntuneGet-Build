@@ -0,0 +1,15 @@
+import { NextRequest, NextResponse } from 'next/server';
+import { parseAccessToken } from '@/lib/auth-utils';
+import { getFeatureFlags } from '@/lib/features';
+import { isGitHubActionsConfigured } from '@/lib/github-actions';
+import { deployDatesAttested, startupPilotValidated } from '@/lib/hrm/packaging-capabilities';
+import { deployDatesAvailable } from '@/lib/hrm/deploy-dates';
+
+/** Read-only capabilities of this server's configured packaging path, never client-selected. */
+export async function GET(request: NextRequest) {
+  const user = await parseAccessToken(request.headers.get('Authorization'));
+  if (!user) return NextResponse.json({ error: 'Sign in to view installation options.' }, { status: 401 });
+  const features = getFeatureFlags();
+  const path = features.localPackager ? 'local' : features.pipeline && isGitHubActionsConfigured() ? 'github' : 'unavailable';
+  return NextResponse.json({ path, startupBeta: path === 'github' && startupPilotValidated(), deployDates: deployDatesAvailable(path, deployDatesAttested()) }, { headers: { 'Cache-Control': 'private, no-store' } });
+}
