index 000000000..7b1c51451
--- /dev/null
+++ b/components/hrm/TimingFields.tsx
@@ -0,0 +1,61 @@
+'use client';
+// The Install dates fields: time zone, Available from, Must install by and restart grace period.
+// One component for the Install dates panel (an app already in Intune) and the deploy form (a new
+// deployment), so both use the same names, hints and hover explanations.
+import { timingInput, timingTimestamp, type TimingEdit } from '@/lib/hrm/app-timing';
+import { Term } from './Term';
+
+const fieldLabel = 'block text-sm font-medium text-text-primary';
+const hint = 'mt-1.5 text-sm leading-relaxed text-text-secondary';
+const inputClass = 'mt-1.5 w-full min-w-0 rounded-lg border border-overlay/15 bg-bg-elevated px-3 py-2 text-[15px] text-text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-cyan';
+const RESTART_FIELDS = [
+  { key: 'gracePeriodInMinutes', label: 'Grace period' },
+  { key: 'countdownDisplayBeforeRestartInMinutes', label: 'Countdown' },
+  { key: 'restartNotificationSnoozeDurationInMinutes', label: 'Snooze' },
+] as const;
+export const RESTART_UNSUPPORTED_IN_INTUNE = 'This app does not support a grace period. In Intune, set its restart behavior to Determine behavior based on return codes or to a mandatory restart first.';
+
+export function TimingFields({ value, onChange, intent, restartSupported, restartUnsupportedNote = RESTART_UNSUPPORTED_IN_INTUNE }: {
+  value: TimingEdit; onChange: (next: TimingEdit) => void; intent: string; restartSupported: boolean; restartUnsupportedNote?: string;
+}) {
+  const time = value.installTimeSettings;
+  const restart = value.restartSettings;
+  const setTime = (patch: Partial<NonNullable<TimingEdit['installTimeSettings']>>) =>
+    onChange({ ...value, installTimeSettings: { useLocalTime: time?.useLocalTime ?? false, startDateTime: time?.startDateTime ?? null, deadlineDateTime: time?.deadlineDateTime ?? null, ...patch } });
+  return <>
+      <div>
+        <label className={fieldLabel}>Time zone
+          <select className={inputClass} aria-label="Time zone" value={time?.useLocalTime ? 'device' : 'utc'} onChange={e => setTime({ useLocalTime: e.target.value === 'device' })}>
+            <option value="device">Each computer's own clock</option><option value="utc">UTC</option>
+          </select>
+        </label>
+        <p className={hint}>Changing this keeps the clock times you entered.</p>
+      </div>
+      <div>
+        <label className={fieldLabel}><Term term="availableFrom">Available from</Term>
+          <input aria-label="Available from" type="datetime-local" className={inputClass} value={timingInput(time?.startDateTime)} onChange={e => setTime({ startDateTime: timingTimestamp(e.target.value) })} />
+        </label>
+        <p className={hint}>Leave blank to make it available right away. Required apps start downloading from this date. Available apps appear in Company Portal from this date.</p>
+      </div>
+      {intent === 'required' && <div>
+        <label className={fieldLabel}><Term term="mustInstallBy">Must install by</Term>
+          <input aria-label="Must install by" type="datetime-local" className={inputClass} value={timingInput(time?.deadlineDateTime)} onChange={e => setTime({ deadlineDateTime: timingTimestamp(e.target.value) })} />
+        </label>
+        <p className={hint}>Intune calls this the installation deadline. Leave blank to install as soon as it is available. If another group has an earlier deadline, the earlier one wins.</p>
+      </div>}
+
+      <div className="space-y-3 rounded-lg border border-overlay/10 p-4">
+        <label className="flex items-start gap-3 text-[15px] font-medium text-text-primary">
+          <input type="checkbox" className="mt-1 h-4 w-4" aria-label="Restart grace period" checked={!!restart} disabled={!restartSupported && !restart} onChange={e => { onChange({ ...value, restartSettings: e.target.checked ? { gracePeriodInMinutes: 1440, countdownDisplayBeforeRestartInMinutes: 15, restartNotificationSnoozeDurationInMinutes: 240 } : null }); }} />
+          <span><Term term="restartGrace">Restart grace period</Term><span className="block text-sm font-normal leading-relaxed text-text-secondary">Gives people time before Intune restarts the computer after installing. It cannot stop a restart the installer forces itself.</span></span>
+        </label>
+        {!restartSupported && <p className="text-sm text-text-secondary">{restartUnsupportedNote}</p>}
+        {restart && <p className="text-sm text-text-secondary">All in minutes. Countdown and snooze can't be longer than the grace period. A snooze of 0 turns snooze off.</p>}
+        {restart && <div className="grid gap-3 sm:grid-cols-3">{RESTART_FIELDS.map(({ key, label: text }, i) => <label key={key} className="block text-sm font-medium text-text-primary">
+          {text}
+          <input aria-label={`${text} (minutes)`} type="number" disabled={!restartSupported} min={i === 2 ? 0 : 1} max={i === 0 ? 20160 : restart.gracePeriodInMinutes} className={inputClass} value={Number.isNaN(restart[key]) ? '' : restart[key]} onChange={e => { onChange({ ...value, restartSettings: { ...restart, [key]: e.target.value === '' ? NaN : Number(e.target.value) } }); }} />
+        </label>)}</div>}
+        {!restart && restartSupported && <p className="text-sm text-text-secondary">Without a grace period, a required restart can happen without warning.</p>}
+      </div>
+  </>;
+}
