+import type Database from 'better-sqlite3';
+import { DEFAULT_INSTALLATION_POLICY, type InstallationPolicy } from './installation-policy';
+export function createInstallationPolicyStore(getDb: () => Database.Database) {
+  const read = (tenant: string, app: string): InstallationPolicy | null => {
+    const row = getDb().prepare('SELECT mode, days, restart_pilot_target FROM hrm_installation_policies WHERE tenant_id = ? AND app_id = ? COLLATE NOCASE').get(tenant, app) as (InstallationPolicy & { restart_pilot_target?: string | null }) | undefined;
+    if (!row) return null;
+    const result: InstallationPolicy = { mode: row.mode, days: row.days };
+    if (row.restart_pilot_target) result.restartPilot = JSON.parse(row.restart_pilot_target);
+    return result;
+  };
+  return {
+    shared: (tenant: string) => read(tenant, '') ?? { ...DEFAULT_INSTALLATION_POLICY },
+    effective: (tenant: string, app: string) => read(tenant, app) ?? read(tenant, '') ?? { ...DEFAULT_INSTALLATION_POLICY },
+    exceptions(tenant: string) {
+      const rows = getDb().prepare('SELECT app_id AS appId FROM hrm_installation_policies WHERE tenant_id = ? AND app_id != ? ORDER BY app_id').all(tenant, '') as { appId: string }[];
+      return rows.map(row => ({ ...read(tenant, row.appId)!, appId: row.appId }));
+    },
+    save(tenant: string, app: string, policy: InstallationPolicy) {
+      getDb().prepare(`INSERT INTO hrm_installation_policies (tenant_id, app_id, mode, days, updated_at, restart_pilot_target) VALUES (?, ?, ?, ?, ?, ?)
+        ON CONFLICT(tenant_id, app_id) DO UPDATE SET mode = excluded.mode, days = excluded.days, updated_at = excluded.updated_at, restart_pilot_target = excluded.restart_pilot_target`)
+        .run(tenant, app.toLowerCase(), policy.mode, policy.days, new Date().toISOString(), policy.mode === 'restart' && policy.restartPilot ? JSON.stringify(policy.restartPilot) : null);
+    },
+    remove(tenant: string, app: string) {
+      if (!app) throw new Error('The shared policy cannot be removed.');
+      getDb().prepare('DELETE FROM hrm_installation_policies WHERE tenant_id = ? AND app_id = ? COLLATE NOCASE').run(tenant, app);
+    },
+  };
+}
