+              ] as const).map(([mode, label, hint]) => <label key={mode} className="flex items-start gap-3 rounded-lg border border-overlay/10 p-3 text-sm"><input className="mt-1" name="installation-behavior" type="radio" value={mode} checked={draft.mode === mode} onChange={() => { setDraft({ ...draft, mode }); setSaved(false); action.reset(); }} /><span><span className="block text-text-primary font-medium">{label}</span><span className="block text-xs text-text-muted mt-1">{hint}</span></span></label>)}
+              {selected && restartOffered && <label className="flex items-start gap-3 rounded-lg border border-status-warning/25 p-3 text-sm"><input type="radio" className="mt-1" name="installation-behavior" value="restart" checked={draft.mode === 'restart'} disabled={!!restartProblem} aria-describedby={restartProblem ? 'restart-installation-restriction' : undefined} onChange={() => { setDraft({ ...draft, mode: 'restart' }); setSaved(false); action.reset(); }} /><span><span className="block font-medium text-text-primary">Install after next restart · Beta</span><span className="block text-xs text-text-muted mt-1">Machine-wide MSI/EXE apps only. Requires a selected pilot group. No forced reboot or deadline.</span></span></label>}
