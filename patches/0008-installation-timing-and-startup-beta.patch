--- /dev/null
+++ b/hooks/usePackagingCapabilities.ts
@@ -0,0 +1,26 @@
+'use client';
+import { useEffect, useState } from 'react';
+import { useMicrosoftAuth } from '@/hooks/useMicrosoftAuth';
+import type { PackagingPath } from '@/lib/hrm/install-experience';
+
+export function usePackagingCapabilities(): { path: PackagingPath; startupBeta: boolean; deployDates: boolean } {
+  const { isAuthenticated, getAccessToken } = useMicrosoftAuth();
+  const [capabilities, setCapabilities] = useState<{ path: PackagingPath; startupBeta: boolean; deployDates: boolean }>({ path: 'unknown', startupBeta: false, deployDates: false });
+  useEffect(() => {
+    let active = true;
+    setCapabilities({ path: 'unknown', startupBeta: false, deployDates: false });
+    if (!isAuthenticated || typeof getAccessToken !== 'function') return;
+    void (async () => {
+      try {
+        const token = await getAccessToken();
+        if (!token) return;
+        const response = await fetch('/api/hrm/packaging-capabilities', { headers: { Authorization: `Bearer ${token}` } });
+        if (!response.ok || response.redirected) return;
+        const value = await response.json();
+        if (active && ['github', 'local', 'unavailable'].includes(value.path)) setCapabilities({ path: value.path, startupBeta: value.startupBeta === true, deployDates: value.deployDates === true });
+      } catch { /* Unknown is deliberately not treated as full capability. */ }
+    })();
+    return () => { active = false; };
+  }, [isAuthenticated, getAccessToken]);
+  return capabilities;
+}
