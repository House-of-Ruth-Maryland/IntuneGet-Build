index 000000000..faf409c67
--- /dev/null
+++ b/app/api/hrm/installation-policy/route.ts
@@ -0,0 +1,73 @@
+import type { AppUpdatePolicy } from '@/types/update-policies';
+import { startupInstallationProblem } from '@/lib/hrm/startup-installation';
+import { NextRequest, NextResponse } from 'next/server';
+import { parseAccessToken } from '@/lib/auth-utils';
+import { isSqliteMode } from '@/lib/db';
+import { installationPolicyError, type InstallationPolicy } from '@/lib/hrm/installation-policy';
+const reply = (body: unknown, status = 200) => NextResponse.json(body, { status, headers: { 'Cache-Control': 'private, no-store' } });
+async function restartProblem(policy: AppUpdatePolicy): Promise<string | null> {
+  const config = policy.deployment_config;
+  const savedProblem = startupInstallationProblem({ ...config, customDetection: config?.psadtConfig?.customDetection });
+  if (savedProblem) return savedProblem;
+  const { sqliteDb } = await import('@/lib/db/sqlite');
+  // The auto-update snapshot can predate later setup-profile changes. Check the
+  // current published package as well, before accepting a restart exception.
+  const updates = await sqliteDb.updateCheckResults.list(policy.user_id, { tenantId: policy.tenant_id });
+  const appIds = [...new Set(updates.filter(row => row.winget_id.toLowerCase() === policy.winget_id.toLowerCase()).map(row => row.intune_app_id))];
+  const current = appIds.length
+    ? await Promise.all(appIds.map(appId => sqliteDb.jobs.getLatestDeployed(policy.user_id, policy.tenant_id, policy.winget_id, appId)))
+    : [await sqliteDb.jobs.getLatestDeployed(policy.user_id, policy.tenant_id, policy.winget_id)];
+  for (const job of current) {
+    const packageConfig = job?.package_config;
+    if (!job || !packageConfig || typeof packageConfig !== 'object' || Array.isArray(packageConfig)) continue;
+    const problem = startupInstallationProblem({ ...config,
+      espProfiles: Array.isArray(packageConfig.espProfiles) ? packageConfig.espProfiles : config?.espProfiles,
+      relationships: Array.isArray(packageConfig.relationships) ? packageConfig.relationships as unknown as NonNullable<typeof config>['relationships'] : config?.relationships,
+      supersedenceType: typeof packageConfig.supersedenceType === 'string' ? packageConfig.supersedenceType : config?.supersedenceType,
+      customDetection: config?.psadtConfig?.customDetection });
+    if (problem) return problem;
+  }
+  return null;
+}
+async function view(tenant: string, userId: string) {
+  const { sqliteInstallationPolicies: store } = await import('@/lib/db/sqlite');
+  const { sqliteDb } = await import('@/lib/db/sqlite');
+  const policies = (await sqliteDb.updatePolicies.list(userId, tenant)).filter(policy => policy.policy_type === 'auto_update');
+  const restartEligibility = await Promise.all(policies.map(async policy => ({ appId: policy.winget_id.toLowerCase(), problem: await restartProblem(policy) })));
+  return { supported: true, shared: store.shared(tenant), exceptions: store.exceptions(tenant), restartEligibility };
+}
+export async function GET(request: NextRequest) {
+  const user = await parseAccessToken(request.headers.get('Authorization'));
+  if (!user) return reply({ error: 'Authentication required' }, 401);
+  if (!isSqliteMode()) return reply({ supported: false });
+  return reply(await view(user.tenantId, user.userId));
+}
+export async function POST(request: NextRequest) {
+  const user = await parseAccessToken(request.headers.get('Authorization'));
+  if (!user) return reply({ error: 'Authentication required' }, 401);
+  if (!isSqliteMode()) return reply({ error: 'Installation policies need this server’s SQLite mode.' }, 409);
+  const body = await request.json().catch(() => null);
+  if (!body || !['save', 'inherit'].includes(body.action) || typeof body.appId !== 'string' || body.appId.length > 256) return reply({ error: 'Choose the shared policy or an auto-update app.' }, 400);
+  const { sqliteDb, sqliteInstallationPolicies: store } = await import('@/lib/db/sqlite');
+  // A signed-in tenant may only change its own apps. Never trust a supplied tenant id.
+  if (body.appId) {
+    const policies = await sqliteDb.updatePolicies.list(user.userId, user.tenantId);
+    if (!policies.some(p => p.winget_id.toLowerCase() === body.appId.toLowerCase() && p.policy_type === 'auto_update')) return reply({ error: 'Choose an app with auto-update enabled for your account.' }, 404);
+  }
+  if (body.action === 'inherit') {
+    if (!body.appId) return reply({ error: 'Only an app exception can be removed.' }, 400);
+    store.remove(user.tenantId, body.appId);
+  } else {
+    const problem = installationPolicyError(body.policy);
+    if (problem) return reply({ error: problem }, 400);
+    const { mode, days } = body.policy as InstallationPolicy;
+    if (mode === 'restart') {
+      if (!body.appId) return reply({ error: 'Install after next restart · Beta is available only as an app exception for pilot testing.' }, 400);
+      const policy = (await sqliteDb.updatePolicies.list(user.userId, user.tenantId)).find(p => p.winget_id.toLowerCase() === body.appId.toLowerCase());
+      const problem = policy ? await restartProblem(policy) : 'Choose an app with auto-update enabled for your account.';
+      if (problem) return reply({ error: problem }, 400);
+    }
+    store.save(user.tenantId, body.appId, { mode, days });
+  }
+  return reply(await view(user.tenantId, user.userId));
+}
