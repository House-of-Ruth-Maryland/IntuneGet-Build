+vi.mock('@/hooks/useInstallationPolicy', () => ({ useInstallationPolicy: () => ({ data: { supported: true, shared: { mode: 'existing', days: 3 }, exceptions: [{ appId: 'vendor.app', mode: state.exceptionMode, days: 3 }], restartEligibility: state.eligibility }, action: { mutate: state.mutate, reset: state.reset, isPending: false } }) }));
