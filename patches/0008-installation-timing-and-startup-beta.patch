+param([string]$Script,[string]$In,[string]$Out)
+$ErrorActionPreference='Stop'
+. $Script
+$doc=Get-Content $In -Raw | ConvertFrom-Json
+$results=[ordered]@{}
+foreach($case in $doc.cases){
+  $failure=$null;$carried=$null
+  try{
+    # Same shapes the hosted workflow sees: Graph rows and ASSIGNMENT_REVIEW both via ConvertFrom-Json.
+    $review=if($null -ne $case.review){ConvertFrom-Json ($case.review|ConvertTo-Json -Depth 20 -Compress)}else{$null}
+    $carried=Get-IntuneGetCarriedAssignments -Rows @($case.rows) -SourceAppId $doc.source -Review $review -Now ([DateTimeOffset]::Parse($doc.now)) -RequireDateReview $true
+  }catch{$failure=$_.Exception.Message}
+  $results[$case.name]=[ordered]@{failure=$failure;body=$(if($null -ne $carried){(@{mobileAppAssignments=$carried}|ConvertTo-Json -Depth 10 -Compress)}else{$null})}
+}
+$results|ConvertTo-Json -Depth 5|Set-Content $Out
