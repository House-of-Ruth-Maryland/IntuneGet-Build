+          </DialogFooter>
+        </DialogContent>
+      </Dialog>;
+  if (compact) return editor;
+  return <StatusStripRow label={HOW_UPDATES_INSTALL} summary={isLoading ? 'Loading…' : sharedSummary && <>{sharedSummary}{!appId && exceptions.length > 0 && ` · ${exceptions.length} app exceptions`}</>} action={editor}>
+    {error && <p role="alert" className="text-sm text-status-error">{error.message}</p>}
+    {!appId && exceptions.length > 0 && <details className="text-sm"><summary className="cursor-pointer text-accent-cyan">Review app exceptions</summary><ul className="mt-2 divide-y divide-overlay/10">{exceptions.map(exception => <li key={exception.appId} className="flex flex-wrap justify-between gap-2 py-2 text-sm"><div><span className="text-text-primary">{apps.find(a => a.winget_id.toLowerCase() === exception.appId.toLowerCase())?.deployment_config?.displayName || exception.appId}</span><p className="text-xs text-text-muted">{installationPolicySummary(exception)}</p></div><button className="text-xs text-accent-cyan hover:underline" onClick={() => { choose(exception.appId); setOpen(true); }}>Edit app exception</button></li>)}</ul></details>}
