index 000000000..4292bdd60
--- /dev/null
+++ b/components/hrm/AppTimingPanel.tsx
@@ -0,0 +1,179 @@
+'use client';
+import { useEffect, useRef, useState } from 'react';
+import { useQueryClient } from '@tanstack/react-query';
+import { useMicrosoftAuth } from '@/hooks/useMicrosoftAuth';
+import { useMspOptional } from '@/hooks/useMspOptional';
+import { Dialog, DialogTrigger, DialogContent, DialogHeader, DialogTitle, DialogDescription } from '@/components/ui/dialog';
+import Link from 'next/link';
+import { appWorkspaceUrl } from '@/lib/hrm/rollout-workspace';
+import { Term, type IntuneTerm } from './Term';
+import { TimingFields } from './TimingFields';
+import { Button } from '@/components/ui/button';
+import { timingInput, timingTimestamp, timingProblem, type TimingRow, type TimingEdit, type RestartTiming } from '@/lib/hrm/app-timing';
+
+export const INSTALL_DATES = 'Install dates';
+
+export function AppTimingPanel({ appId, groupNames = {} }: { appId: string; groupNames?: Record<string, string> }) {
+  return <Dialog><DialogTrigger asChild><Button size="sm" variant="outline">{INSTALL_DATES}</Button></DialogTrigger>
+    <DialogContent side="right" onOpenAutoFocus={e => { e.preventDefault(); (e.currentTarget as HTMLElement | null)?.focus(); }}><DialogHeader className="pr-12"><DialogTitle className="text-xl">{INSTALL_DATES}</DialogTitle><DialogDescription className="mt-1 text-[15px] leading-relaxed">When this version becomes available and when it must install, for one group at a time.</DialogDescription></DialogHeader>
+    <div className="flex-1 min-h-0 overflow-y-auto p-6"><AppTimingContent appId={appId} groupNames={groupNames} /></div></DialogContent></Dialog>;
+}
+function AppTimingContent({ appId, groupNames }: { appId: string; groupNames: Record<string, string> }) {
+  const { getAccessToken } = useMicrosoftAuth();
+  const { isMspUser, selectedTenantId } = useMspOptional();
+  const client = useQueryClient();
+  // Changing app or tenant remounts the editor, dropping any draft from the previous copy.
+  return <TimingEditor key={`${appId}:${selectedTenantId}`} appId={appId} groupNames={groupNames} request={async (body) => {
+    const token = await getAccessToken();
+    if (!token) throw new Error('Sign in again.');
+    const response = await fetch(body ? '/api/hrm/app-timing' : `/api/hrm/app-timing?appId=${encodeURIComponent(appId)}`, {
+      method: body ? 'POST' : 'GET', headers: { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json',
+        ...(isMspUser && selectedTenantId ? { 'X-MSP-Tenant-Id': selectedTenantId } : {}) },
+      ...(body ? { body: JSON.stringify({ ...body, appId }) } : {}),
+    });
+    if (response.redirected || !response.headers.get('content-type')?.includes('application/json')) throw new Error('Your sign-in expired. Reload and sign in again.');
+    const data = await response.json();
+    if (!response.ok) throw new Error(data.error || 'Could not read install dates from Intune.');
+    if (body) {
+      void client.invalidateQueries({ queryKey: ['hrm', 'app-insights'] });
+      void client.invalidateQueries({ queryKey: ['inventory'] });
+    }
+    return data;
+  }} />;
+}
+
+/** Shows a stored clock time as written, never shifted into the browser's time zone. */
+function clock(value: string | null | undefined, local: boolean) {
+  const input = timingInput(value);
+  if (!input) return null;
+  const text = new Date(`${input}:00Z`).toLocaleString('en-US', { timeZone: 'UTC', month: 'short', day: 'numeric', year: 'numeric', hour: 'numeric', minute: '2-digit' });
+  return local ? text : `${text} UTC`;
+}
+function minutes(n: number) {
+  if (n % 1440 === 0) return n === 1440 ? '1 day' : `${n / 1440} days`;
+  if (n % 60 === 0) return n === 60 ? '1 hour' : `${n / 60} hours`;
+  return n === 1 ? '1 minute' : `${n} minutes`;
+}
+function restartSummary(r: RestartTiming | null) {
+  if (!r) return 'Off';
+  const snooze = r.restartNotificationSnoozeDurationInMinutes ? `, snooze ${minutes(r.restartNotificationSnoozeDurationInMinutes)}` : ', no snooze';
+  return `${minutes(r.gracePeriodInMinutes)}, ${minutes(r.countdownDisplayBeforeRestartInMinutes)} countdown${snooze}`.replace(/(\d+) (minute|hour|day)s? countdown/, '$1-$2 countdown');
+}
+
+const sectionHeading = 'text-base font-semibold text-text-primary';
+const fieldLabel = 'block text-sm font-medium text-text-primary';
+const hint = 'mt-1.5 text-sm leading-relaxed text-text-secondary';
+const TERMS: Record<string, IntuneTerm> = { 'Available from': 'availableFrom', 'Must install by': 'mustInstallBy', 'Restart grace period': 'restartGrace' };
+
+export function TimingEditor({ appId, groupNames, request }: {
+  appId: string; groupNames: Record<string, string>;
+  request: (body?: Record<string, unknown>) => Promise<{ rows?: TimingRow[]; success?: boolean }>;
+}) {
+  const [rows, setRows] = useState<TimingRow[] | null>(null);
+  const [selected, setSelected] = useState('');
+  const [draft, setDraft] = useState<TimingEdit | null>(null);
+  const [editing, setEditing] = useState(false);
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState('');
+  const [saved, setSaved] = useState(false);
+  const [stale, setStale] = useState(false);
+  const row = rows?.find(r => r.id === selected);
+  // The field is already labelled Group, so the row's own "Group " prefix is dropped once the name is known.
+  const label = (r: TimingRow) => r.label.replace(/^Group ([0-9a-f]{8}-[0-9a-f-]{27})/i, (all, id) => groupNames[id.toLowerCase()] ? id : all).replace(/[0-9a-f]{8}-[0-9a-f-]{27}/gi, id => groupNames[id.toLowerCase()] || id);
+  const choose = (r?: TimingRow) => { setSelected(r?.id ?? ''); setDraft(r ? { installTimeSettings: r.installTimeSettings, restartSettings: r.restartSettings } : null); };
+  async function load(keepSaved = false, keep = selected) {
+    setBusy(true); setError(''); if (!keepSaved) setSaved(false);
+    try {
+      const data = await request(); const list = data.rows ?? [];
+      setRows(list); choose(list.find(r => r.id === keep) ?? list[0]); setStale(false); setEditing(false);
+    } catch (e) {
+      if (keepSaved) { setSaved(false); setError('Saved to Intune, but the new dates could not be read back. Press Refresh dates.'); }
+      else setError(e instanceof Error ? e.message : 'Could not read install dates from Intune.');
+      setStale(true);
+    }
+    finally { setBusy(false); }
+  }
+  // The panel reads the current dates when it opens (a read only; nothing changes in Intune).
+  const started = useRef(false);
+  useEffect(() => { if (!started.current) { started.current = true; void load(); } });
+  const problem = row && draft ? timingProblem(draft, row.intent, row.restartSupported, row.restartSettings) : null;
+  const inputClass = 'mt-1.5 w-full min-w-0 rounded-lg border border-overlay/15 bg-bg-elevated px-3 py-2 text-[15px] text-text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-cyan';
+  const time = draft?.installTimeSettings;
+  const restart = draft?.restartSettings;
+  const live = row?.installTimeSettings;
+  const unchanged = !!row && JSON.stringify(draft) === JSON.stringify({ installTimeSettings: row.installTimeSettings, restartSettings: row.restartSettings });
+  const setTime = (patch: Partial<NonNullable<TimingEdit['installTimeSettings']>>) => {
+    if (!draft) return;
+    setSaved(false);
+    setDraft({ ...draft, installTimeSettings: { useLocalTime: time?.useLocalTime ?? false, startDateTime: time?.startDateTime ?? null, deadlineDateTime: time?.deadlineDateTime ?? null, ...patch } });
+  };
+
+  return <section className="space-y-5" aria-label={INSTALL_DATES}>
+    <div className="flex flex-wrap items-center justify-between gap-3">
+      <h4 className={sectionHeading}>{editing ? 'Change dates' : 'Current dates'}</h4>
+      <Button variant="outline" disabled={busy} onClick={() => void load()}>{busy ? 'Working…' : 'Refresh dates'}</Button>
+    </div>
+
+    {!rows && !error && <p className="text-sm text-text-secondary">Reading the current dates from Intune…</p>}
+    {rows && rows.length === 0 && <p className="text-sm text-text-secondary">This version has no Required or Available groups in Intune. Use Edit groups in the app workspace, then press Refresh dates.</p>}
+
+    {rows && rows.length > 1 && <label className={fieldLabel}>Group
+      <select aria-label="Group" className={inputClass} disabled={busy || editing} value={selected} onChange={e => { setSaved(false); choose(rows.find(r => r.id === e.target.value)); }}>
+        {rows.map(r => <option key={r.id} value={r.id}>{label(r)}</option>)}
+      </select>
+    </label>}
+
+    {row && !editing && <>
+      <dl className="divide-y divide-overlay/10 overflow-hidden rounded-lg border border-overlay/10 bg-bg-elevated text-[15px]">
+        {([
+          ...(rows && rows.length > 1 ? [] : [['Group', label(row)]]),
+          ['Available from', clock(live?.startDateTime, !!live?.useLocalTime) ?? 'As soon as possible'],
+          ...(row.intent === 'required' ? [['Must install by', clock(live?.deadlineDateTime, !!live?.useLocalTime) ?? 'As soon as it is available']] : []),
+          ['Time zone', live?.useLocalTime ? "Each computer's own clock" : 'UTC'],
+          ['Restart grace period', restartSummary(row.restartSettings)],
+        ] as [string, string][]).map(([k, v]) => <div key={k} className="flex flex-wrap justify-between gap-x-4 gap-y-0.5 px-4 py-2.5">
+          <dt className="text-text-secondary">{TERMS[k] ? <Term term={TERMS[k]}>{k}</Term> : k}</dt><dd className="text-right font-medium text-text-primary">{v}</dd>
+        </div>)}
+      </dl>
+      <Button disabled={busy || stale} onClick={() => { choose(row); setSaved(false); setEditing(true); }}>Edit dates</Button>
+    </>}
+
+    {row && draft && editing && <fieldset disabled={busy || stale} className="min-w-0 space-y-5">
+      <TimingFields value={draft} onChange={next => { setSaved(false); setDraft(next); }} intent={row.intent} restartSupported={row.restartSupported} />
+
+      {problem && <p role="alert" className="text-sm font-medium text-status-error">{problem}</p>}
+      <div className="flex flex-wrap gap-3">
+        <Button disabled={busy || !!problem || unchanged} onClick={async () => {
+          setBusy(true); setError(''); setSaved(false);
+          let ok = false;
+          try {
+            await request({ assignmentId: row.id, token: row.token, edit: draft });
+            ok = true; setSaved(true);
+          } catch (e) { setError(e instanceof Error ? e.message : 'Could not save the dates.'); setStale(true); }
+          finally { setBusy(false); }
+          // Every save is followed by a new read, so the panel shows what Intune actually saved
+          // and the next edit has a fresh review token.
+          if (ok) { setStale(true); await load(true, row.id); }
+        }}>Save to Intune</Button>
+        <Button variant="outline" disabled={busy} onClick={() => { choose(row); setEditing(false); }}>Cancel</Button>
+      </div>
+    </fieldset>}
+
+    {saved && <p role="status" className="text-sm font-medium text-status-success">Saved to Intune. The dates above are what Intune has now.</p>}
+    {error && <p role="alert" className="text-sm font-medium text-status-error">{error}</p>}
+
+    {rows && rows.length > 0 && <details className="rounded-lg border border-overlay/10 px-4 py-3 text-sm leading-relaxed text-text-secondary">
+      <summary className="cursor-pointer font-medium text-text-primary">What changing dates does</summary>
+      <ul className="mt-2 list-disc space-y-0.5 pl-5">
+        <li>Computers that already have this version are not affected.</li>
+        <li>Offline computers can install after they reconnect and Intune processes the assignment.</li>
+        <li>It sets dates once. It does not install at restart or sign-in.</li>
+        <li>The dates belong to this version. Check them again after an update.</li>
+      </ul>
+    </details>}
+    <dl className="space-y-1.5 border-t border-overlay/10 pt-4 text-sm text-text-secondary">
+      <div><dt className="inline font-medium text-text-primary">Who gets it: </dt><dd className="inline">use Edit groups in the <Link href={appWorkspaceUrl(appId)} className="text-accent-cyan hover:underline">app workspace</Link>.</dd></div>
+      <div><dt className="inline font-medium text-text-primary">Future updates: </dt><dd className="inline">set in <Link href="/dashboard/updates" className="text-accent-cyan hover:underline">App updates</Link>.</dd></div>
+    </dl>
+  </section>;
+}
