+  // HRM patch 0058 (choice 4B): the last row of App updates' status strip; Open shows the reports.
+  const summary = isLoading ? 'Loading reports…' : data && startupReportNeedsReview(data) ? 'Reports need review' : data?.report ? `${data.report.summary.waiting} waiting for restart · ${data.report.summary.failed} failed` : data?.configured ? 'No reports yet' : 'Not set up';
+  return <section id="startup-installations" aria-label="Startup install results · Beta" className="p-4">
