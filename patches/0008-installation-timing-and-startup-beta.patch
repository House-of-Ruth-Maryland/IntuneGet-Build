+import { createHash } from 'node:crypto';
+import { readFile } from 'node:fs/promises';
+import path from 'node:path';
+import { NextRequest, NextResponse } from 'next/server';
+import { parseAccessToken } from '@/lib/auth-utils';
+import { isSqliteMode } from '@/lib/db';
+import { GUID, STARTUP_FRESH_MS } from '@/lib/hrm/startup-report';
+export const maxDuration = 120;
+const reply = (body: unknown, status = 200) => NextResponse.json(body, { status, headers: { 'Cache-Control': 'private, no-store' } });
+async function read(tenant: string) {
+  const { sqliteStartupReports: store } = await import('@/lib/db/sqlite');
+  const configured = GUID.test(process.env.HRM_STARTUP_REPORT_SCRIPT_ID ?? '');
+  const packages = store.jobs(tenant);
+  if (!configured) return { supported: true, configured: false, packages };
+  const result = store.read(tenant);
+  return { supported: true, configured: true, packages, ...result, stale: !result.checkedAt || Date.now() - Date.parse(result.checkedAt) > STARTUP_FRESH_MS };
+}
+export async function GET(request: NextRequest) {
+  const user = await parseAccessToken(request.headers.get('Authorization'));
+  if (!user) return reply({ error: 'Authentication required' }, 401);
+  if (!isSqliteMode()) return reply({ supported: false, configured: false });
+  if (request.nextUrl.searchParams.get('download') === 'cancel') {
+    const jobId = request.nextUrl.searchParams.get('jobId') ?? '';
+    if (!GUID.test(jobId)) return reply({ error: 'Choose a startup Beta package.' }, 400);
+    const { sqliteStartupReports: store } = await import('@/lib/db/sqlite');
+    const job = store.cancellation(user.tenantId, jobId);
+    if (!job) return reply({ error: 'Startup Beta package not found.' }, 404);
+    const template = await readFile(path.join(process.cwd(), 'public/startup-beta/Cancel-StartupTemplate.ps1'), 'utf8');
+    const script = template.replaceAll('__JOB_ID__', job.id.toLowerCase()).replaceAll('__APP_KEY__', createHash('sha256').update(job.wingetId.toLowerCase()).digest('hex')).replaceAll('__VERSION_BASE64__', Buffer.from(job.version, 'utf8').toString('base64'));
+    return new NextResponse(script, { headers: { 'Content-Type': 'text/plain; charset=utf-8', 'Content-Disposition': 'attachment; filename="Cancel-startup-beta.ps1"', 'Cache-Control': 'private, no-store' } });
+  }
+  return reply(await read(user.tenantId));
+}
+export async function POST(request: NextRequest) {
+  const user = await parseAccessToken(request.headers.get('Authorization'));
+  if (!user) return reply({ error: 'Authentication required' }, 401);
+  if (!isSqliteMode()) return reply({ supported: false, configured: false });
+  const { refreshStartupReport } = await import('@/lib/hrm/startup-report-check');
+  await refreshStartupReport(user.tenantId);
+  return reply(await read(user.tenantId));
+}
