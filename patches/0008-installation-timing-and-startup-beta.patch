+import { expect, it } from 'vitest';
+import { appWorkspaceUrl, attemptWorkspaceId, effectiveInstallationRule, savedInstallationSummary } from '../rollout-workspace';
+import { nextVersionCheck } from '../version-check';
+it('links failed updates by exact source identity without guessing names or conflicting IDs',()=>{
+ const a='11111111-1111-4111-8111-111111111111',b='22222222-2222-4222-8222-222222222222';
+ expect(attemptWorkspaceId({package_config:{sourceIntuneAppId:a}})).toBe(a);
+ expect(attemptWorkspaceId({intune_app_id:b,package_config:{sourceIntuneAppId:a}})).toBe(b);
+ expect(attemptWorkspaceId({package_config:{sourceIntuneAppId:a,replacesIntuneAppId:b}})).toBeNull();
+ expect(attemptWorkspaceId({package_config:{displayName:'Example'}})).toBeNull();
+});
+it('preserves the source distinction and matches app exceptions without case dependence', () => {
+  const shared = { mode: 'existing', days: 3 } as const;
+  expect(effectiveInstallationRule(shared, [], 'Vendor.App')).toEqual({ source: 'Shared policy', policy: shared });
+  const exception = { appId: 'vendor.app', mode: 'silent', days: 3 } as const;
+  expect(effectiveInstallationRule(shared, [exception], 'Vendor.App')).toEqual({ source: 'App exception', policy: exception });
+});
+it('does not infer missing settings or claim startup has a bounded deadline', () => {
+  expect(savedInstallationSummary(null)).toContain('unavailable');
+  expect(savedInstallationSummary({ installAfterRestartBeta: true })).toContain('No enforced startup deadline');
+  expect(savedInstallationSummary({ deployMode: 'Silent', allowDefer: false })).toContain('No toolkit windows');
+  expect(savedInstallationSummary({ allowDefer: true, deferDays: 3, deferTimes: 1000, deferByDaysOnly: true })).not.toContain('1000');
+  expect(appWorkspaceUrl('app/value')).toBe('/dashboard/inventory/app%2Fvalue');
+});
+it('does not describe saved deferrals as active for silent or noninteractive packages',()=>{
+ for (const deployMode of ['Silent','NonInteractive'] as const) {
+  const config={deployMode,allowDefer:true,deferTimes:3,deferDays:2};
+  expect(savedInstallationSummary(config)).toContain('Saved postponement is inactive');
+  expect(savedInstallationSummary(config)).not.toContain('up to 3');
+  expect(config.allowDefer).toBe(true);
+ }
+});
+it('uses Eastern wall-clock cadence across daylight saving and advances past the current slot', () => {
+  expect(nextVersionCheck(new Date('2026-11-23T20:30:00Z'))).toBe('2026-11-24T08:30:00.000Z');
+  expect(nextVersionCheck(new Date('2026-03-08T06:00:00Z'))).toBe('2026-03-08T07:30:00.000Z');
+  expect(nextVersionCheck(new Date('2026-11-01T05:00:00Z'))).toBe('2026-11-01T08:30:00.000Z');
+});
