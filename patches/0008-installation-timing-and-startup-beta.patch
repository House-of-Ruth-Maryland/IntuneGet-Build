+param([Parameter(Mandatory=$true)][string]$Runner,[Parameter(Mandatory=$true)][string]$TempRoot)
+$ErrorActionPreference='Stop'
+$testRoot=Join-Path $TempRoot ('intuneget-startup-test-'+[guid]::NewGuid().ToString())
+$originalProgramData=$env:ProgramData
+$script:boot='boot-a';$script:installed=$false;$script:starts=0;$script:removed=0;$script:registered=$null;$script:waits=0;$script:slow=$false
+function Set-TestMocks {
+    # OS security and scheduler primitives are tested in the Windows pilot, not emulated as real Windows APIs here.
+    function script:Assert-IntuneGetSystem {}
+    function script:Assert-IntuneGetOwnedPath {param($Path)}
+    function script:New-IntuneGetSecureDirectory {param($Path);$null=[IO.Directory]::CreateDirectory($Path)}
+    function script:Get-IntuneGetBoot {return $script:boot}
+    function script:Test-IntuneGetInstalled {param($Config);return $script:installed}
+    function script:Register-IntuneGetStartupTask {param($Config,$Directory);$script:registered=$Directory}
+    function script:Remove-IntuneGetStartupTask {param($Config);$script:removed++}
+    function script:Get-ScheduledTask {param($TaskName,$ErrorAction);return [pscustomobject]@{Actions=[pscustomobject]@{Arguments=$script:registered}}}
+    function script:Assert-IntuneGetManifest {param($Payload,$Manifest);if(-not $Manifest.files){throw 'Manifest missing'}}
+    function script:Start-Process {
+        param($FilePath,$ArgumentList,$WorkingDirectory,[switch]$PassThru)
+        $script:starts++;$script:installed=$true
+        $p=[pscustomobject]@{ExitCode=0;Id=123;Directory=$WorkingDirectory}
+        $p | Add-Member -MemberType ScriptMethod -Name WaitForExit -Value {
+            param($Milliseconds)
+            $script:waits++
+            if ($script:slow -and $script:waits -le 2) {
+                $record=Read-IntuneGetJson (Join-Path (Split-Path $this.Directory) 'state.json')
+                if($record.state -ne 'installing'){throw 'Slow installer was marked failed before completion'}
+                return $false
+            }
+            return $true
+        }
+        return $p
+    }
+}
+try {
+    $null=[IO.Directory]::CreateDirectory($testRoot)
+    $env:ProgramData=Join-Path $testRoot 'data'
+    $null=[IO.Directory]::CreateDirectory($env:ProgramData)
+    $source=Join-Path $testRoot 'source';$null=[IO.Directory]::CreateDirectory($source)
+    $copy=Join-Path $source 'IntuneGet-StartupInstall.ps1';Copy-Item -LiteralPath $Runner -Destination $copy
+    $metadata=@{v=1;createdAt='2026-01-01T00:00:00.000Z';jobId='11111111-1111-4111-8111-111111111111';appKey=('a'*64);version='2.0';marker='SOFTWARE\IntuneGet\Apps\Fixture_App'}
+    $metadata | ConvertTo-Json | Set-Content -LiteralPath (Join-Path $source 'startup-config.json')
+    Set-Content -LiteralPath (Join-Path $source 'Invoke-AppDeployToolkit.exe') -Value 'not executable: lifecycle test fixture'
+    . $copy -Mode Stage
+    Set-TestMocks
+    $code=Invoke-IntuneGetStartup
+    if($code -ne 1618 -or $script:starts -ne 0){throw 'Staging started an installer or reported success'}
+    $directory=$script:registered
+    $state=Read-IntuneGetJson (Join-Path $directory 'state.json')
+    if($state.state -ne 'waiting' -or $state.boot -ne 'boot-a'){throw 'Missing boot boundary'}
+    $payload=Join-Path $directory 'payload'
+    $originalHash=(Get-FileHash -LiteralPath (Join-Path $payload 'Invoke-AppDeployToolkit.exe')).Hash
+    Set-Content -LiteralPath (Join-Path $source 'Invoke-AppDeployToolkit.exe') -Value 'changed source'
+    $null=Invoke-IntuneGetStartup
+    if((Get-FileHash -LiteralPath (Join-Path $payload 'Invoke-AppDeployToolkit.exe')).Hash -ne $originalHash){throw 'Retry replaced staged bytes'}
+    . (Join-Path $payload 'IntuneGet-StartupInstall.ps1') -Mode Run
+    Set-TestMocks
+    if((Invoke-IntuneGetStartup) -ne 1618 -or $script:starts -ne 0){throw 'Same-boot run installed early'}
+    $script:slow=$true
+    $script:boot='boot-b'
+    if((Invoke-IntuneGetStartup) -ne 0){throw 'New boot did not complete the mocked install'}
+    $state=Read-IntuneGetJson (Join-Path $directory 'state.json')
+    if($script:waits -ne 3){throw 'Coordinator did not keep waiting for the slow installer'}
+    if($script:starts -ne 1 -or $state.state -ne 'installed' -or $script:removed -ne 1){throw 'Incorrect installation outcome'}
+    $script:installed=$false
+    $metadata.jobId='22222222-2222-4222-8222-222222222222'
+    $metadata | ConvertTo-Json | Set-Content -LiteralPath (Join-Path $source 'startup-config.json')
+    . $copy -Mode Stage
+    Set-TestMocks
+    $null=Invoke-IntuneGetStartup
+    $cancelled=$script:registered
+    . $copy -Mode Cancel
+    Set-TestMocks
+    if((Invoke-IntuneGetStartup) -ne 0){throw 'Cancellation failed'}
+    $state=Read-IntuneGetJson (Join-Path $cancelled 'state.json')
+    if($state.state -ne 'cancelled' -or $script:removed -ne 2){throw 'Cancellation did not clear its task'}
+    . (Join-Path $cancelled 'payload/IntuneGet-StartupInstall.ps1') -Mode Run
+    Set-TestMocks
+    $script:boot='boot-c'
+    if((Invoke-IntuneGetStartup) -ne 60010 -or $script:starts -ne 1){throw 'Cancelled deployment installed later'}
+    # Delayed older packages, including deliveries after newer completion/cancellation,
+    # must never take over the task. Version text is intentionally not sortable.
+    $metadata.jobId='33333333-3333-4333-8333-333333333333'
+    $metadata.createdAt='2026-01-03T00:00:00.000Z';$metadata.version='release-new'
+    $metadata | ConvertTo-Json | Set-Content -LiteralPath (Join-Path $source 'startup-config.json')
+    . $copy -Mode Stage
+    Set-TestMocks
+    if((Invoke-IntuneGetStartup) -ne 1618){throw 'New deployment was not staged'}
+    $newer=$script:registered
+    $metadata.jobId='44444444-4444-4444-8444-444444444444'
+    $metadata.createdAt='2026-01-02T00:00:00.000Z';$metadata.version='release-old'
+    $metadata | ConvertTo-Json | Set-Content -LiteralPath (Join-Path $source 'startup-config.json')
+    . $copy -Mode Stage
+    Set-TestMocks
+    if((Invoke-IntuneGetStartup) -ne 60010 -or $script:registered -ne $newer){throw 'Older delivery took over the newer task'}
+    if((Read-IntuneGetJson (Join-Path $newer 'state.json')).state -ne 'waiting'){throw 'Older delivery superseded newer state'}
+    # The durable intent still protects a completed package after its payload is removed.
+    $newState=Read-IntuneGetJson (Join-Path $newer 'state.json');$newState.state='installed'
+    Write-IntuneGetJson (Join-Path $newer 'state.json') $newState
+    if((Invoke-IntuneGetStartup) -ne 60010){throw 'Older delivery bypassed completed intent'}
+    $left=[pscustomobject]@{createdAt='2026-01-03T00:00:00Z';jobId='b'}
+    $right=[pscustomobject]@{createdAt='2026-01-03T00:00:00Z';jobId='a'}
+    if((Compare-IntuneGetIntent $left $right) -le 0){throw 'Equal-time order was not deterministic'}
+    # Detection of a later package also clears earlier waiting records, not only its task.
+    $metadata.jobId='55555555-5555-4555-8555-555555555555';$metadata.createdAt='2026-01-05T00:00:00.000Z'
+    $metadata | ConvertTo-Json | Set-Content -LiteralPath (Join-Path $source 'startup-config.json')
+    . $copy -Mode Stage
+    Set-TestMocks
+    $null=Invoke-IntuneGetStartup;$waiting=$script:registered
+    $metadata.jobId='66666666-6666-4666-8666-666666666666';$metadata.createdAt='2026-01-06T00:00:00.000Z'
+    $metadata | ConvertTo-Json | Set-Content -LiteralPath (Join-Path $source 'startup-config.json')
+    $script:installed=$true
+    if((Invoke-IntuneGetStartup) -ne 0){throw 'Detected current version did not finish'}
+    if((Read-IntuneGetJson (Join-Path $waiting 'state.json')).state -ne 'superseded'){throw 'Detected newer package left phantom waiting work'}
+    # Missing server creation time fails closed rather than using delivery time.
+    $metadata.Remove('createdAt');$metadata | ConvertTo-Json | Set-Content -LiteralPath (Join-Path $source 'startup-config.json')
+    $rejected=$false
+    try {$null=Invoke-IntuneGetStartup} catch {$rejected=$true}
+    if(-not $rejected){throw 'Missing deployment order was accepted'}
+    Write-Output 'PASS: staging, idempotent retry, boot gate, installation detection, cleanup and cancellation'
+} finally {
+    $env:ProgramData=$originalProgramData
+    Remove-Item -LiteralPath $testRoot -Recurse -Force -ErrorAction SilentlyContinue
+}
