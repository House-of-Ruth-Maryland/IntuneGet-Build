+'use client';
+import { STARTUP_BETA_LABEL } from '@/lib/hrm/startup-installation';
+export function StartupInstallChoice({ value, onChange, problem }: { value: boolean; onChange: (value: boolean) => void; problem: string | null }) {
+  return <div className="space-y-3 rounded-lg border border-status-warning/30 bg-status-warning/5 p-4">
+    <label className="flex items-start gap-3 text-[15px] font-medium text-text-primary">
+      <input type="checkbox" className="mt-1 h-4 w-4" checked={value} disabled={!!problem && !value} onChange={e => onChange(e.target.checked)} />
+      <span>{STARTUP_BETA_LABEL}<span className="mt-0.5 block text-sm font-normal leading-relaxed text-text-secondary">Installs the app the next time each computer restarts, instead of right away.</span></span>
+    </label>
+    <ul className="list-disc space-y-1 pl-12 text-sm leading-relaxed text-text-secondary">
+      <li>It never forces a restart and does not block sign-in.</li>
+      <li>The 3-day postponement does not apply.</li>
+      <li>Applies to this deployment only. Future automatic updates follow App updates.</li>
+    </ul>
+    {value && <div role="note" className="rounded-md border border-status-warning/40 bg-status-warning/10 px-3 py-2 text-sm leading-relaxed text-text-primary">
+      <p className="font-semibold">Beta: try it on a small pilot group first</p>
+      <p className="mt-0.5 text-text-secondary">Assign it as Required to a few pilot computers. Intune may show Retry or Failed until each computer restarts. Startup results appear in App updates once reporting is set up.</p>
+    </div>}
+    {problem && <p className="text-sm text-text-secondary">{problem}</p>}
+  </div>;
+}
