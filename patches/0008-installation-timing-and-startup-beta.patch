+import { describe, it, expect } from 'vitest';
+import { DEFAULT_PSADT_CONFIG } from '@/types/psadt';
+import { installExperience, installSettingsProblem } from '../install-experience';
+import { settingsSummaries } from '../settings-summary';
+
+const config = () => structuredClone(DEFAULT_PSADT_CONFIG);
+describe('effective install experience', () => {
+  it('keeps saved postponement inactive in Silent while disk and process actions still apply', () => {
+    const saved = { ...config(), allowDefer: true, deferTimes: 3, checkDiskSpace: true, requiredDiskSpace: 500, processesToClose: [{ name: 'example', description: '' }], blockExecution: true };
+    const before = structuredClone(saved);
+    const result = installExperience(saved);
+    expect(result.automatic).toBe(false);
+    expect(result.deferral).toBe('Saved, inactive in this mode');
+    expect(result.background.join(' ')).toContain('500 MB');
+    expect(result.background.join(' ')).toContain('without asking');
+    expect(saved).toEqual(before);
+    expect(settingsSummaries({ config: saved, espProfiles: [], relationships: [], categories: [], descriptionOrCommandsChanged: false }).deferral).not.toContain('3 postponements');
+  });
+  it('distinguishes NonInteractive status windows from questions and the pinned restart countdown', () => {
+    const saved = { ...config(), deployMode: 'NonInteractive' as const, allowDefer: true, progressDialog: { enabled: false }, restartPrompt: { enabled: true, countdownSeconds: 600, countdownNoHideSeconds: 60 } };
+    const result = installExperience(saved);
+    expect(result.progress).toBe(false);
+    expect(result.automatic).toBe(false);
+    expect(result.restartPrompt).toBe(true);
+    expect(result.staff).toContain('restart countdowns');
+    expect(installExperience(saved, 'local').restartPrompt).toBe(false);
+  });
+  it('reports every active postponement limit and ignores disabled messages', () => {
+    const saved = { ...config(), deployMode: 'Auto' as const, allowDefer: true, deferTimes: 0, deferDays: 2, deferDeadline: '2027-01-03', customPrompts: [{ enabled: false, timing: 'pre-install' as const, title: 'Stored', message: 'Hidden', icon: 'None' as const }] };
+    const result = installExperience(saved);
+    expect(result.deferral).toBe('0 postponements, 2 days from the first attempt, until 2027-01-03');
+    expect(result.messages).toBe(false);
+    expect(installExperience({ ...saved, deferByDaysOnly: true }).deferral).not.toContain('postponements');
+  });
+  it('does not claim local Auto parity or trust an unknown packaging path', () => {
+    expect(installExperience({ ...config(), deployMode: 'Auto' }, 'local').staff).toContain('defaults to Silent');
+    const unknown = installExperience({ ...config(), deployMode: 'Auto', allowDefer: true }, 'unknown');
+    expect(unknown.known).toBe(false);
+    expect(unknown.automatic).toBe(false);
+    expect(unknown.deferral).toBe('Saved; packaging not verified');
+  });
+  it('rejects competing active deadlines while preserving inactive values and one time limit', () => {
+    const saved = { ...config(), deployMode: 'Auto' as const, allowDefer: true, deferTimes: 3, deferDays: 2, deferDeadline: '2027-01-03' };
+    const before = structuredClone(saved);
+    expect(installSettingsProblem(saved)).toContain('stores one deadline');
+    expect(installSettingsProblem({ ...saved, deployMode: 'Silent' })).toBeNull();
+    expect(installSettingsProblem({ ...saved, deployMode: 'NonInteractive' })).toBeNull();
+    expect(installSettingsProblem({ ...saved, allowDefer: false })).toBeNull();
+    expect(installSettingsProblem({ ...saved, deferDeadline: undefined })).toBeNull();
+    expect(installSettingsProblem({ ...saved, deferDays: undefined })).toBeNull();
+    expect(installSettingsProblem(saved, 'local')).toBeNull();
+    expect(saved).toEqual(before);
+  });
+});
diff --git a/lib/hrm/install-experience.ts b/lib/hrm/install-experience.ts
new file mode 100644
index 000000000..09f75e68f
--- /dev/null
+++ b/lib/hrm/install-experience.ts
@@ -0,0 +1,53 @@
+import type { PSADTConfig } from '@/types/psadt';
+
+export type PackagingPath = 'github' | 'local' | 'unavailable' | 'unknown';
+
+export const TOOLKIT_MODES = [
+  { value: 'Silent', label: 'No toolkit windows' },
+  { value: 'NonInteractive', label: 'No questions; status windows allowed' },
+  { value: 'Auto', label: 'Ask when needed (automatic)' },
+] as const;
+
+/** PSADT 4.1.8 persists one deadline; days plus a date do not form two bounds. */
+export function installSettingsProblem(config: Pick<PSADTConfig, 'deployMode' | 'allowDefer' | 'deferDays' | 'deferDeadline' | 'installAfterRestartBeta'>, path: PackagingPath = 'github'): string | null {
+  if (path === 'github' && !config.installAfterRestartBeta && config.deployMode === 'Auto' && config.allowDefer && Number(config.deferDays) > 0 && config.deferDeadline) {
+    return 'Choose a day limit or a date deadline. The toolkit stores one deadline, so combining both can replace the day limit on a later attempt.';
+  }
+  return null;
+}
+
+/** Describe effective runtime behavior without changing the saved configuration. */
+export function installExperience(config: PSADTConfig, path: PackagingPath = 'github') {
+  const mode = config.installAfterRestartBeta ? 'Silent' : config.deployMode || 'Silent';
+  const known = path === 'github' || path === 'local';
+  const automatic = mode === 'Auto' && path === 'github';
+  const visible = mode !== 'Silent' && path === 'github' && !config.installAfterRestartBeta;
+  const processes = config.processesToClose?.filter(p => p.name.trim()).length || 0;
+  const welcome = automatic && (config.allowDefer || (processes > 0 && config.showClosePrompt));
+  const enabledMessages = config.customPrompts?.filter(p => p.enabled).length || 0;
+  const enabledNotifications = config.balloonTips?.filter(p => p.enabled).length || 0;
+  const limits = [
+    !config.deferByDaysOnly && `${config.deferTimes ?? 3} postponements`,
+    config.deferDays && `${config.deferDays} days from the first attempt`,
+    config.deferDeadline && `until ${config.deferDeadline}`,
+  ].filter(Boolean).join(', ');
+  const deferral = automatic && config.allowDefer ? limits || 'Enabled' : config.allowDefer ? known ? 'Saved, inactive in this mode' : 'Saved; packaging not verified' : 'Off';
+  const background = [
+    processes > 0 && (welcome ? 'Running listed apps may trigger a close-app prompt; otherwise they are handled without asking.' : `${processes} listed ${processes === 1 ? 'app closes' : 'apps close'} without asking.`),
+    config.blockExecution && processes > 0 && 'Listed apps cannot reopen during installation.',
+    config.checkDiskSpace && `Free space is checked${config.requiredDiskSpace !== undefined ? ` (${config.requiredDiskSpace} MB minimum)` : ' against package size'}.`,
+  ].filter(Boolean) as string[];
+  let staff = !known ? 'Verify the packaging service to see which options apply.'
+    : config.installAfterRestartBeta ? 'Staged for a later startup. No forced reboot or sign-in block.'
+    : mode === 'Silent' ? 'No toolkit windows. Installer windows and Intune notifications are controlled separately.'
+    : path === 'local' ? 'No toolkit questions. This local packager does not generate status windows or custom messages.'
+    : mode === 'NonInteractive' ? 'No close-app, postponement or custom-message questions. Enabled status windows and restart countdowns can still appear.'
+    : 'The toolkit checks the signed-in session and running apps. It may ask staff or run silently; the installer does not choose this mode.';
+  if (path === 'local' && mode === 'Auto') staff = 'Saved automatic mode is not supported by this local generator: its script currently defaults to Silent.';
+  return { mode, known, automatic, visible, welcome, processes, enabledMessages, enabledNotifications, deferral, background, staff,
+    progress: visible && config.progressDialog?.enabled,
+    notifications: visible && enabledNotifications > 0,
+    messages: automatic && enabledMessages > 0,
+    restartPrompt: visible && config.restartPrompt?.enabled,
+  };
+}
