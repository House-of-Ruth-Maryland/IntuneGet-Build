+import { expect, it, vi } from 'vitest';
+import { createElement } from 'react';
+import { renderToStaticMarkup } from 'react-dom/server';
+import { emptyStartupCounts, type StartupReportView } from '@/lib/hrm/startup-report';
+const state=vi.hoisted(()=>({data:{supported:true,configured:false,packages:[{id:'fixture',name:'Pilot app',version:'2'}]} as StartupReportView}));
+vi.mock('@/hooks/useStartupInstallations',()=>({useStartupInstallations:()=>({data:state.data,isLoading:false,refresh:{isPending:false,mutate:vi.fn()},cancellation:{isPending:false,mutate:vi.fn()}})}));
+import { StartupInstallations } from './StartupInstallations';
+it('keeps cancellation visible when optional device reporting is unconfigured or denied',()=>{
+ for(const error of [undefined,'access_denied'] as const){
+  state.data={supported:true,configured:!!error,error,packages:[{id:'fixture',name:'Pilot app',version:'2'}]};
+  const html=renderToStaticMarkup(createElement(StartupInstallations));
+  expect(html).toContain('Pilot app');expect(html).toContain('Download cancellation script');expect(html).toContain('No reports yet');
+ }
+});
+it('shows a review indicator in the collapsed overview for incomplete reports',()=>{
+ state.data={supported:true,configured:true,report:{rows:[],summary:emptyStartupCounts(),reportingDevices:1,unknownDevices:1,omitted:20}};
+ const html=renderToStaticMarkup(createElement(StartupInstallations));
+ expect(html).toContain('Reports need review');expect(html).not.toContain('0 waiting for restart');
+});
