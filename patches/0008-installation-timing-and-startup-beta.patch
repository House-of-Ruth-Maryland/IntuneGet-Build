+async function render(row = initial, fail = false) {
+  const request = vi.fn(async (body?: Record<string, unknown>) => { if (body && fail) throw new Error('The assignment changed. Reload from Intune.'); return body ? { success: true } : { rows: [row] }; });
+  const node = document.createElement('div'); document.body.append(node); root = createRoot(node);
+  await act(async () => root.render(createElement(TimingEditor, { appId: 'app', groupNames: {}, request })));
+  await act(async () => button('Reload dates').click());
+  return request;
+}
+it('loads live dates without browser timezone shifts and saves a changed grace period', async () => {
+  const request = await render();
+  expect(document.querySelector<HTMLInputElement>('[aria-label="App availability"]')!.value).toBe('2026-12-01T18:00');
+  expect(document.querySelector<HTMLInputElement>('[aria-label="Installation deadline"]')!.value).toBe('2026-12-01T20:00');
+  expect((button('Save to Intune') as HTMLButtonElement).disabled).toBe(true);
+  await act(async () => document.querySelector<HTMLInputElement>('[aria-label="Restart grace period"]')!.click());
+  await act(async () => button('Save to Intune').click());
+  expect(request).toHaveBeenLastCalledWith({ assignmentId: 'one', token: 'review', edit: { installTimeSettings: initial.installTimeSettings, restartSettings: { gracePeriodInMinutes: 1440, countdownDisplayBeforeRestartInMinutes: 15, restartNotificationSnoozeDurationInMinutes: 240 } } });
+  expect(document.body.textContent).toContain('Saved to Intune. Press Reload dates');
+  expect((button('Save to Intune') as HTMLButtonElement).disabled || button('Save to Intune').closest('fieldset')?.disabled).toBe(true);
