+it('requires a fresh read after a failed save and never shows success', async () => {
+  await render(initial, true);
+  await act(async () => document.querySelector<HTMLInputElement>('[aria-label="Restart grace period"]')!.click());
+  await act(async () => button('Save to Intune').click());
+  expect(document.body.textContent).toContain('The assignment changed');
+  expect(document.body.textContent).not.toContain('Saved to Intune. Press Reload dates');
+  expect(button('Save to Intune').closest('fieldset')!.disabled).toBe(true);
+  expect((button('Reload dates') as HTMLButtonElement).disabled).toBe(false);
