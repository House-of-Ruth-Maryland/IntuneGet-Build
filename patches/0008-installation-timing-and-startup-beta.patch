+'use client';
+import { useMutation, useQuery, useQueryClient } from '@tanstack/react-query';
+import { useMicrosoftAuth } from './useMicrosoftAuth';
+import type { StartupReportView } from '@/lib/hrm/startup-report';
+export function useStartupInstallations() {
+  const { getAccessToken, isAuthenticated, account } = useMicrosoftAuth();
+  const client = useQueryClient();
+  const key = ['hrm', 'startup-installations', account?.tenantId, account?.localAccountId];
+  const request = async (refresh = false): Promise<StartupReportView> => {
+    const token = await getAccessToken();
+    if (!token) throw new Error('Sign in again to view startup installation reports.');
+    const response = await fetch('/api/hrm/startup-installations', { method: refresh ? 'POST' : 'GET', headers: { Authorization: `Bearer ${token}` } });
+    if (response.redirected || !response.headers.get('content-type')?.includes('application/json')) throw new Error('Your sign-in expired. Reload and sign in again.');
+    const value = await response.json();
+    if (!response.ok) throw new Error('Could not load startup installation reports.');
+    return value;
+  };
+  const query = useQuery({ queryKey: key, queryFn: () => request(), enabled: isAuthenticated, staleTime: 30000, refetchInterval: 60000 });
+  const refresh = useMutation({ mutationFn: () => request(true), onSuccess: data => client.setQueryData(key, data) });
+  const cancellation = useMutation({ mutationFn: async (jobId: string) => {
+    const token = await getAccessToken(); if (!token) throw new Error('Sign in again.');
+    const response = await fetch(`/api/hrm/startup-installations?download=cancel&jobId=${encodeURIComponent(jobId)}`, { headers: { Authorization: `Bearer ${token}` } });
+    if (!response.ok || response.redirected || !response.headers.get('content-type')?.includes('text/plain')) throw new Error('Could not download the cancellation script.');
+    const url = URL.createObjectURL(await response.blob());
+    const link = document.createElement('a'); link.href = url; link.download = 'Cancel-startup-beta.ps1'; link.click(); setTimeout(() => URL.revokeObjectURL(url), 1000);
+  } });
+  return { ...query, refresh, cancellation };
+}
