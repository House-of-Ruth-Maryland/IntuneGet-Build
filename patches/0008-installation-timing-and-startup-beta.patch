+    expect(output).toMatch(/Show-ADTInstallationWelcome[^\n]*-CloseProcesses[^\n]*-Silent[^\n]*-BlockExecution[^\n]*-CheckDiskSpace[^\n]*-RequiredDiskSpace 500/);
