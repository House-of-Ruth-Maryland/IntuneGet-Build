+import type { PSADTConfig } from '@/types/psadt';
+import type { InstallationPolicy } from './installation-policy';
+import { GUID } from './app-insights';
+
+export function attemptWorkspaceId(job: { intune_app_id?: string | null; package_config?: unknown }): string | null {
+  if (job.intune_app_id && GUID.test(job.intune_app_id)) return job.intune_app_id;
+  const config = job.package_config && typeof job.package_config === 'object' ? job.package_config as Record<string,unknown> : {};
+  const ids = [...new Set([config.sourceIntuneAppId,config.replacesIntuneAppId].filter((v):v is string=>typeof v==='string'&&GUID.test(v)).map(v=>v.toLowerCase()))];
+  return ids.length===1 ? ids[0] : null;
+}
+
+export function savedInstallationSummary(config?: Partial<PSADTConfig> | null): string {
+  if (!config) return 'Saved installer settings are unavailable for this copy.';
+  if (config.installAfterRestartBeta) return 'Install after next restart · Beta. No enforced startup deadline.';
+  if (config.deployMode === 'Silent' || config.deployMode === 'NonInteractive') return `${config.deployMode === 'Silent' ? 'No toolkit windows' : 'No toolkit questions'}.${config.allowDefer ? ' Saved postponement is inactive in this mode.' : ' No postponement prompt.'} Vendor installer windows and Intune notifications are separate.`;
+  if (config.allowDefer) return `Installer postponement${config.deferDays ? ` · ${config.deferDays} days` : ''}${!config.deferByDaysOnly && config.deferTimes ? ` · up to ${config.deferTimes} postponements` : ''}.`;
+  return 'Use the saved installer behavior, without postponement.';
+}
+
+export function effectiveInstallationRule(shared: InstallationPolicy, exceptions: (InstallationPolicy & { appId: string })[], appId: string) {
+  const exception = exceptions.find(item => item.appId.toLowerCase() === appId.toLowerCase());
+  return { source: exception ? 'App exception' : 'Shared policy', policy: exception ?? shared };
+}
+
+export function appWorkspaceUrl(appId: string) {
+  return `/dashboard/inventory/${encodeURIComponent(appId)}`;
+}
