new file mode 100644
index 000000000..82a1c0ca6
--- /dev/null
+++ b/public/startup-beta/Cancel-StartupTemplate.ps1
@@ -0,0 +1,51 @@
+# Generated by IntuneGet for one startup-installation Beta package.
+# Deploy through Intune as a SYSTEM platform script to the same pilot group.
+# Remove this package's Required assignment first. This does not uninstall an installed app.
+$ErrorActionPreference='Stop'
+$job='__JOB_ID__'
+$app='__APP_KEY__'
+$version=[Text.Encoding]::UTF8.GetString([Convert]::FromBase64String('__VERSION_BASE64__'))
+if($job -notmatch '^[0-9a-f-]{36}$' -or $app -notmatch '^[0-9a-f]{64}$'){throw 'Invalid cancellation identity'}
+if([Security.Principal.WindowsIdentity]::GetCurrent().User.Value -ne 'S-1-5-18'){throw 'Run cancellation as SYSTEM'}
+function Assert-Plain([string]$Path){
+ $current=[IO.Path]::GetFullPath($Path)
+ while($current){
+  if((Test-Path -LiteralPath $current) -and ((Get-Item -LiteralPath $current -Force).Attributes -band [IO.FileAttributes]::ReparsePoint)){throw 'Reparse point refused'}
+  $parent=[IO.Directory]::GetParent($current);$current=if($parent){$parent.FullName}else{$null}
+ }
+}
+function Secure-Directory([string]$Path){
+ Assert-Plain $Path
+ if(-not(Test-Path -LiteralPath $Path)){
+  $acl=New-Object Security.AccessControl.DirectorySecurity;$acl.SetAccessRuleProtection($true,$false);$acl.SetOwner([Security.Principal.SecurityIdentifier]::new('S-1-5-18'))
+  foreach($sid in @('S-1-5-18','S-1-5-32-544')){$acl.AddAccessRule([Security.AccessControl.FileSystemAccessRule]::new([Security.Principal.SecurityIdentifier]::new($sid),'FullControl','ContainerInherit,ObjectInherit','None','Allow'))}
+  $null=[IO.Directory]::CreateDirectory($Path,$acl)
+ }
+ $acl=Get-Acl -LiteralPath $Path
+ if($acl.GetOwner([Security.Principal.SecurityIdentifier]).Value -ne 'S-1-5-18'){throw 'Unexpected cache owner'}
+ foreach($rule in $acl.GetAccessRules($true,$true,[Security.Principal.SecurityIdentifier])){if($rule.AccessControlType -eq 'Allow' -and $rule.IdentityReference.Value -notin @('S-1-5-18','S-1-5-32-544')){throw 'Unexpected cache permission'}}
+}
+$root=Join-Path $env:ProgramData 'IntuneGet-Startup-Beta';Secure-Directory $root
+$family=Join-Path $root $app;Secure-Directory $family
+$directory=Join-Path $family $job
+$mutex=[Threading.Mutex]::new($false,('Global\IntuneGetStartup-'+$app));$locked=$false
+try{
+ try{$locked=$mutex.WaitOne(0)} catch [Threading.AbandonedMutexException]{$locked=$true}
+ if(-not $locked){throw 'Installation or staging is running. Retry cancellation after it finishes.'}
+ Secure-Directory $directory
+ $statePath=Join-Path $directory 'state.json';Assert-Plain $statePath
+ if(Test-Path -LiteralPath $statePath){
+  if((Get-Item -LiteralPath $statePath).Length -gt 8192){throw 'Invalid local status'}
+  $existing=Get-Content -LiteralPath $statePath -Raw | ConvertFrom-Json
+  if($existing.state -eq 'installed'){Write-Output 'Already installed. Use an Intune Uninstall assignment to remove the app.';exit 0}
+ }
+ $name='IntuneGet-Startup-Beta-'+$app
+ $task=Get-ScheduledTask -TaskName $name -ErrorAction SilentlyContinue
+ if($task -and ($task.Actions.Arguments -like ('*'+$job+'*'))){Unregister-ScheduledTask -TaskName $name -Confirm:$false}
+ # A protected tombstone also blocks future delivery/retry of this exact package.
+ $state=[ordered]@{v=1;job=$job;app=$app;version=$version;state='cancelled';boot='';attempts=0;updated=[DateTime]::UtcNow.ToString('o');code=$null}
+ $temporary=$statePath+'.new';Assert-Plain $temporary
+ [IO.File]::WriteAllText($temporary,($state|ConvertTo-Json -Compress),[Text.UTF8Encoding]::new($false))
+ Move-Item -LiteralPath $temporary -Destination $statePath -Force
+ Write-Output 'Cancelled this startup package. Later reports will confirm the cancellation.'
+} finally {if($locked){$mutex.ReleaseMutex()};$mutex.Dispose()}
diff --git a/public/startup-beta/Detect-StartupInstallations.ps1 b/public/startup-beta/Detect-StartupInstallations.ps1
new file mode 100644
index 000000000..65a976d26
--- /dev/null
+++ b/public/startup-beta/Detect-StartupInstallations.ps1
@@ -0,0 +1,54 @@
+# IntuneGet startup installation reporting (Beta).
+# Deploy as a detection-only Intune Remediations script, SYSTEM, 64-bit, hourly.
+# Does not install software, restart Windows, or transmit credentials/device/user names.
+$ErrorActionPreference='Stop'
+$root=Join-Path $env:ProgramData 'IntuneGet-Startup-Beta'
+$items=New-Object 'Collections.Generic.List[object]'
+$issues=0
+function Test-PlainOwnedDirectory([string]$Path) {
+    $entry=Get-Item -LiteralPath $Path -Force
+    if ($entry.Attributes -band [IO.FileAttributes]::ReparsePoint) {return $false}
+    $acl=Get-Acl -LiteralPath $Path
+    return $acl.GetOwner([Security.Principal.SecurityIdentifier]).Value -eq 'S-1-5-18'
+}
+try {
+    if (Test-Path -LiteralPath $root) {
+        if (-not (Test-PlainOwnedDirectory $root)) {throw 'Invalid report root'}
+        foreach ($app in Get-ChildItem -LiteralPath $root -Directory) {
+            if ($app.Name -notmatch '^[0-9a-f]{64}$' -or -not (Test-PlainOwnedDirectory $app.FullName)) {$issues++;continue}
+            foreach ($package in Get-ChildItem -LiteralPath $app.FullName -Directory) {
+                if ($package.Name -notmatch '^[0-9a-f-]{36}$' -or -not (Test-PlainOwnedDirectory $package.FullName)) {$issues++;continue}
+                $path=Join-Path $package.FullName 'state.json'
+                if (-not (Test-Path -LiteralPath $path)) {continue}
+                try {
+                    $file=Get-Item -LiteralPath $path -Force
+                    if ($file.Length -gt 8192 -or ($file.Attributes -band [IO.FileAttributes]::ReparsePoint)) {throw 'Invalid status file'}
+                    $s=Get-Content -LiteralPath $path -Raw | ConvertFrom-Json
+                    $id=[guid]::Empty
+                    if ($s.v -ne 1 -or -not [guid]::TryParse([string]$s.job,[ref]$id) -or $id.ToString() -ne $package.Name -or $s.app -ne $app.Name) {throw 'Invalid status identity'}
+                    $codes=@{waiting='w';installing='i';installed='s';failed='f';cancelled='c'}
+                    if (-not $codes.ContainsKey([string]$s.state)) {continue}
+                    $at=[DateTimeOffset]::Parse([string]$s.updated).ToUnixTimeSeconds()
+                    # Keep all pending/failed records, plus seven days of completed installations.
+                    if ($s.state -in @('installed','cancelled') -and $at -lt [DateTimeOffset]::UtcNow.AddDays(-7).ToUnixTimeSeconds()) {continue}
+                    $items.Add([pscustomobject]@{job=$id.ToString();state=$codes[[string]$s.state];at=$at})
+                } catch {$issues++}
+            }
+        }
+    }
+    # Active/failed records first. Bound output below Intune's 2048-character limit.
+    $ordered=@($items | Sort-Object @{Expression={if ($_.state -eq 's') {1} else {0}}},@{Expression='at';Descending=$true})
+    $selected=New-Object 'Collections.Generic.List[object]'
+    foreach ($item in $ordered) {
+        if ($selected.Count -ge 24) {break}
+        $selected.Add(@($item.job,$item.state,$item.at))
+    }
+    $result=[ordered]@{v=1;at=[DateTimeOffset]::UtcNow.ToUnixTimeSeconds();omitted=($ordered.Count-$selected.Count);issues=$issues;items=@($selected.ToArray())}
+    $json=$result | ConvertTo-Json -Depth 5 -Compress
+    if ($json.Length -gt 1950) {throw 'Output limit'}
+    Write-Output $json
+    exit 0
+} catch {
+    Write-Output ('{"v":1,"at":'+[DateTimeOffset]::UtcNow.ToUnixTimeSeconds()+',"omitted":0,"issues":1,"items":[]}')
+    exit 0
+}
