+import { afterEach, beforeEach, expect, it, vi } from 'vitest';
+import { NextRequest } from 'next/server';
+const state = vi.hoisted(() => ({ user: { userId: 'staff', tenantId: 'tenant', userEmail: 'staff@example.test' } as unknown, supabase: null as unknown }));
+vi.mock('@/lib/auth-utils', () => ({ parseAccessToken: async () => state.user }));
+vi.mock('@/lib/supabase', () => ({ getServerClientOrNull: () => state.supabase }));
+vi.mock('@/lib/db', () => ({ isSqliteMode: () => false }));
+vi.mock('@/lib/intune/graph-client', () => ({ getServicePrincipalToken: async () => 'fixture-token' }));
+vi.mock('@/lib/msp/tenant-resolution', () => ({ resolveTargetTenantId: async () => ({ tenantId: 'tenant', errorResponse: null }) }));
+import { POST } from './route';
+const APP = '10000000-0000-0000-0000-000000000001';
+const GROUP = '20000000-0000-0000-0000-000000000002';
+let rows: Record<string, unknown>[];
+let writes: Record<string, unknown>[];
+let version: string;
+let writeStatus: number;
+let missingReadback: boolean;
+let failAfterWrite: boolean;
+const request = (body: object, tenant?: string) => POST(new NextRequest('http://localhost/api/hrm/app-assignments', { method: 'POST', headers: { 'Content-Type': 'application/json', ...(tenant ? { 'X-MSP-Tenant-Id': tenant } : {}) }, body: JSON.stringify({ appId: APP, groupId: GROUP, intent: 'required', ...body }) }));
+const review = async (intent = 'required') => (await (await request({ action: 'review', intent })).json()).review;
+beforeEach(() => {
+  state.user = { userId: 'staff', tenantId: 'tenant' }; state.supabase = null;
+  rows = [{ id: 'old', intent: 'uninstall', target: { '@odata.type': '#microsoft.graph.exclusionGroupAssignmentTarget', groupId: '30000000-0000-0000-0000-000000000003', deviceAndAppManagementAssignmentFilterId: 'filter', futureTarget: { preserve: true } }, settings: { '@odata.type': '#microsoft.graph.win32LobAppAssignmentSettings', futureSetting: true }, futureRoot: { keep: true } }];
+  writes = []; version = '1.2'; writeStatus = 201; missingReadback = false; failAfterWrite = false;
+  vi.stubGlobal('fetch', vi.fn(async (url: string, init?: RequestInit) => {
+    if (url.includes('/groups/')) return Response.json({ id: GROUP, displayName: 'Enrolled staff', securityEnabled: true });
+    if (url.endsWith('/assignments')) {
+      if (init?.method === 'POST') {
+        const input = JSON.parse(init.body as string); writes.push(input);
+        if (writeStatus !== 201) return new Response('', { status: writeStatus });
+        if (!missingReadback) rows.push({ id: 'new', ...input });
+        if (failAfterWrite) throw new Error('Connection lost after commit');
+        return Response.json(input, { status: 201 });
+      }
+      return Response.json({ value: rows });
+    }
+    return Response.json({ id: APP, displayName: 'Example app', displayVersion: version, '@odata.type': '#microsoft.graph.win32LobApp' });
+  }));
+});
+afterEach(() => vi.unstubAllGlobals());
+it.each(['required', 'available'])('adds only one %s assignment and reads back actual rows without rewriting unknown fields', async intent => {
+  const original = structuredClone(rows[0]);
+  const r = await review(intent);
+  expect(r).toMatchObject({ appName: 'Example app', version: '1.2', groupName: 'Enrolled staff', intent });
+  expect(writes).toHaveLength(0);
+  const saved = await request({ action: 'save', intent, token: r.token });
+  expect(saved.status).toBe(200);
+  expect((await saved.json()).assignments).toHaveLength(2);
+  expect(rows[0]).toEqual(original);
+  expect(writes).toEqual([{ '@odata.type': '#microsoft.graph.mobileAppAssignment', intent, target: { '@odata.type': '#microsoft.graph.groupAssignmentTarget', groupId: GROUP }, settings: { '@odata.type': '#microsoft.graph.win32LobAppAssignmentSettings', notifications: 'showAll' } }]);
+  expect((await request({ action: 'save', intent, token: r.token })).status).toBe(200);
+  expect(writes).toHaveLength(1);
+});
+it('recovers an ambiguous committed write through review and retry without another write', async () => {
+  const r = await review(); failAfterWrite = true;
+  expect((await request({ action: 'save', token: r.token })).status).toBe(424);
+  const next = await review();
+  expect((await request({ action: 'save', token: next.token })).status).toBe(200);
+  expect(writes).toHaveLength(1);
+});
+it('rejects changed app identity and invalid intent', async () => {
+  const r = await review(); version = '2';
+  expect((await request({ action: 'save', token: r.token })).status).toBe(409);
+  expect((await request({ action: 'review', intent: 'availableWithoutEnrollment' })).status).toBe(400);
+  expect(writes).toHaveLength(0);
+});
+it.each(['uninstall', 'available', 'required'])('rejects existing conflicting %s or filtered assignment', async intent => {
+  rows.push({ intent, target: { '@odata.type': '#microsoft.graph.groupAssignmentTarget', groupId: GROUP, deviceAndAppManagementAssignmentFilterId: 'filter', deviceAndAppManagementAssignmentFilterType: 'include' } });
+  expect((await request({ action: 'review' })).status).toBe(409);
+  expect(writes).toHaveLength(0);
+});
+it('enforces authentication and tenant scoping before Graph', async () => {
+  state.user = null;
+  expect((await request({ action: 'review' })).status).toBe(401);
+  state.user = { userId: 'staff', tenantId: 'tenant' };
+  expect((await request({ action: 'review' }, 'other')).status).toBe(403);
+  expect(fetch).not.toHaveBeenCalled();
+});
+it('denies MSP viewers server-side', async () => {
+  const chain = { select: () => chain, eq: () => chain, maybeSingle: async () => ({ data: { role: 'viewer' }, error: null }) };
+  state.supabase = { from: () => chain };
+  expect((await request({ action: 'review' })).status).toBe(403);
+  expect(fetch).not.toHaveBeenCalled();
+});
+it('reports Graph denial and unconfirmed readback without a replacement fallback', async () => {
+  const r = await review(); writeStatus = 403;
+  expect((await request({ action: 'save', token: r.token })).status).toBe(403);
+  writeStatus = 201; missingReadback = true;
+  expect((await request({ action: 'save', token: r.token })).status).toBe(424);
+  expect(writes).toHaveLength(2);
+});
