+import { timingInput, timingTimestamp, timingProblem, type TimingRow, type TimingEdit } from '@/lib/hrm/app-timing';
+
+export function AppTimingPanel({ appId, groupNames = {} }: { appId: string; groupNames?: Record<string, string> }) {
+  return <Dialog><DialogTrigger asChild><Button size="sm" variant="outline">Availability and deadline</Button></DialogTrigger>
+    <DialogContent side="right"><DialogHeader className="pr-12"><DialogTitle>Availability and deadline</DialogTitle><DialogDescription>Dates and restart grace for this copy already in Intune. Installation timing in App updates sets future automatic updates.</DialogDescription></DialogHeader>
+    <div className="flex-1 min-h-0 overflow-y-auto p-6"><AppTimingContent appId={appId} groupNames={groupNames} /><div className="mt-5"><InstallStatusBar appId={appId} /></div></div></DialogContent></Dialog>;
+}
+function AppTimingContent({ appId, groupNames }: { appId: string; groupNames: Record<string, string> }) {
+  const { getAccessToken } = useMicrosoftAuth();
+  const { isMspUser, selectedTenantId } = useMspOptional();
+  const client = useQueryClient();
+  // Changing app or tenant remounts the editor, dropping any draft from the previous copy.
+  return <TimingEditor key={`${appId}:${selectedTenantId}`} appId={appId} groupNames={groupNames} request={async (body) => {
+    const token = await getAccessToken();
+    if (!token) throw new Error('Sign in again.');
+    const response = await fetch(body ? '/api/hrm/app-timing' : `/api/hrm/app-timing?appId=${encodeURIComponent(appId)}`, {
+      method: body ? 'POST' : 'GET', headers: { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json',
+        ...(isMspUser && selectedTenantId ? { 'X-MSP-Tenant-Id': selectedTenantId } : {}) },
+      ...(body ? { body: JSON.stringify({ ...body, appId }) } : {}),
+    });
+    if (response.redirected || !response.headers.get('content-type')?.includes('application/json')) throw new Error('Your sign-in expired. Reload and sign in again.');
+    const data = await response.json();
+    if (!response.ok) throw new Error(data.error || 'Could not read availability and deadline from Intune.');
+    if (body) {
+      void client.invalidateQueries({ queryKey: ['hrm', 'app-insights'] });
+      void client.invalidateQueries({ queryKey: ['inventory'] });
+    }
+    return data;
+  }} />;
+}
+
+export function TimingEditor({ groupNames, request }: {
+  appId: string; groupNames: Record<string, string>;
+  request: (body?: Record<string, unknown>) => Promise<{ rows?: TimingRow[]; success?: boolean }>;
+}) {
+  const [rows, setRows] = useState<TimingRow[] | null>(null);
+  const [selected, setSelected] = useState('');
+  const [draft, setDraft] = useState<TimingEdit | null>(null);
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState('');
+  const [saved, setSaved] = useState(false);
+  const [stale, setStale] = useState(false);
+  const row = rows?.find(r => r.id === selected);
+  const label = (r: TimingRow) => r.label.replace(/[0-9a-f]{8}-[0-9a-f-]{27}/gi, id => groupNames[id.toLowerCase()] || id);
+  const choose = (r?: TimingRow) => { setSelected(r?.id ?? ''); setDraft(r ? { installTimeSettings: r.installTimeSettings, restartSettings: r.restartSettings } : null); setSaved(false); };
+  async function load() {
+    setBusy(true); setError(''); setSaved(false);
+    try { const data = await request(); setRows(data.rows ?? []); choose(data.rows?.[0]); setStale(false); }
+    catch (e) { setError(e instanceof Error ? e.message : 'Could not read availability and deadline from Intune.'); setStale(true); }
+    finally { setBusy(false); }
+  }
+  const problem = row && draft ? timingProblem(draft, row.intent, row.restartSupported, row.restartSettings) : null;
+  const inputClass = 'w-full min-w-0 rounded-lg border border-overlay/15 bg-bg-elevated px-3 py-2 text-sm text-text-primary';
+  const time = draft?.installTimeSettings;
+  const restart = draft?.restartSettings;
+  return <section className="space-y-3 rounded-lg border border-overlay/10 p-3" aria-label="Availability and deadline">
+    <h4 className="text-sm font-semibold text-text-primary">Availability and deadline</h4>
+    <p className="text-xs text-text-secondary">Set dates for this copy's Required or Available groups.</p>
+    <details className="text-xs text-text-secondary">
+      <summary className="cursor-pointer text-accent-cyan focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-cyan rounded">What these dates change</summary>
+      <p className="mt-1">Computers that already have this version are not changed. Offline computers may install after the chosen time when they reconnect. This is not a recurring after-hours window or a startup or sign-in trigger. Review these dates again after deploying a new version.</p>
+    </details>
+    <Button size="sm" variant="outline" disabled={busy} onClick={() => void load()}>{busy ? 'Working…' : 'Reload dates'}</Button>
+    {rows && rows.length === 0 && <p className="text-sm text-text-muted">This copy has no Required or Available groups. Add one, then press Reload dates.</p>}
+    {rows && rows.length > 0 && <fieldset disabled={busy || stale} className="space-y-3 min-w-0">
+      <label className="block text-sm text-text-secondary">Assignment
+        <select aria-label="Timing assignment" className={inputClass} value={selected} onChange={e => choose(rows.find(r => r.id === e.target.value))}>
+          {rows.map(r => <option key={r.id} value={r.id}>{label(r)}</option>)}
+        </select>
+      </label>
+      {draft && row && <>
+        <label className="block text-sm text-text-secondary">Time zone
+          <select className={inputClass} aria-label="Timing time zone" value={time?.useLocalTime ? 'device' : 'utc'} onChange={e => { setSaved(false); setDraft({ ...draft, installTimeSettings: { startDateTime: time?.startDateTime ?? null, deadlineDateTime: time?.deadlineDateTime ?? null, useLocalTime: e.target.value === 'device' } }); }}>
+            <option value="utc">UTC</option><option value="device">Device local time</option>
+          </select>
+        </label>
+        <p className="text-xs text-text-muted">{time?.useLocalTime ? 'Each device uses its own clock. Changing the time zone keeps the entered clock times.' : 'Enter UTC clock times. Changing the time zone keeps the entered clock times.'}</p>
+        <label className="block text-sm text-text-secondary">App availability
+          <input aria-label="App availability" type="datetime-local" className={inputClass} value={timingInput(time?.startDateTime)} onChange={e => { setSaved(false); setDraft({ ...draft, installTimeSettings: { useLocalTime: time?.useLocalTime ?? false, startDateTime: timingTimestamp(e.target.value), deadlineDateTime: time?.deadlineDateTime ?? null } }); }} />
+        </label>
+        <p className="text-xs text-text-muted">Leave blank for as soon as possible. Required apps can download from this date. Available apps appear in Company Portal from this date.</p>
+        {row.intent === 'required' && <>
+          <label className="block text-sm text-text-secondary">Installation deadline
+            <input aria-label="Installation deadline" type="datetime-local" className={inputClass} value={timingInput(time?.deadlineDateTime)} onChange={e => { setSaved(false); setDraft({ ...draft, installTimeSettings: { useLocalTime: time?.useLocalTime ?? false, startDateTime: time?.startDateTime ?? null, deadlineDateTime: timingTimestamp(e.target.value) } }); }} />
+          </label>
+          <p className="text-xs text-text-muted">Required installation waits until this date. Leave blank for as soon as possible after availability. Another assignment with an earlier deadline can take priority.</p>
+        </>}
+        <label className="flex items-start gap-2 text-sm text-text-secondary">
+          <input type="checkbox" aria-label="Restart grace period" checked={!!restart} disabled={!row.restartSupported && !restart} onChange={e => { setSaved(false); setDraft({ ...draft, restartSettings: e.target.checked ? { gracePeriodInMinutes: 1440, countdownDisplayBeforeRestartInMinutes: 15, restartNotificationSnoozeDurationInMinutes: 240 } : null }); }} />Restart grace period
+        </label>
+        {!row.restartSupported && <p className="text-xs text-text-muted">This app’s restart behavior does not support a grace period. Set Determine behavior based on return codes or a mandatory restart in Intune first.</p>}
+        {restart && (['gracePeriodInMinutes', 'countdownDisplayBeforeRestartInMinutes', 'restartNotificationSnoozeDurationInMinutes'] as const).map((key, i) => <label key={key} className="block text-sm text-text-secondary">
+          {['Grace period (minutes)', 'Restart countdown (minutes)', 'Snooze duration (minutes, 0 disables)'][i]}
+          <input aria-label={['Grace period (minutes)', 'Restart countdown (minutes)', 'Snooze duration (minutes, 0 disables)'][i]} type="number" disabled={!row.restartSupported} min={i === 2 ? 0 : 1} max={i === 0 ? 20160 : restart.gracePeriodInMinutes} className={inputClass} value={Number.isNaN(restart[key]) ? '' : restart[key]} onChange={e => { setSaved(false); setDraft({ ...draft, restartSettings: { ...restart, [key]: e.target.value === '' ? NaN : Number(e.target.value) } }); }} />
+        </label>)}
+        <p className="text-xs text-text-muted">A grace period delays an Intune-managed restart after installation. With return-code behavior it applies to hard reboots, not soft reboot notifications. It cannot prevent a restart forced by the installer. Without a grace period, a required restart may happen without warning.</p>
+        {problem && <p role="alert" className="text-sm text-status-error">{problem}</p>}
+        <Button size="sm" disabled={busy || !!problem || JSON.stringify(draft) === JSON.stringify({ installTimeSettings: row.installTimeSettings, restartSettings: row.restartSettings })} onClick={async () => {
+          setBusy(true); setError(''); setSaved(false);
+          try {
+            await request({ assignmentId: row.id, token: row.token, edit: draft });
+            // Require a new live review before another write, including after a timeout.
+            setStale(true); setSaved(true);
+          } catch (e) { setError(e instanceof Error ? e.message : 'Could not save timing.'); setStale(true); }
+          finally { setBusy(false); }
+        }}>Save to Intune</Button>
+      </>}
+    </fieldset>}
+    {saved && <p role="status" className="text-sm text-status-success">Saved to Intune. Press Reload dates to see what Intune saved.</p>}
+    {error && <p role="alert" className="text-sm text-status-error">{error}</p>}
+  </section>;
+}
