+import { afterEach, expect, it } from 'vitest';
+import { mkdtempSync, readFileSync, realpathSync, rmSync } from 'fs';
+import { tmpdir } from 'os';
+import { join, resolve } from 'path';
+import { spawnSync } from 'child_process';
+import { prepareStartupPackage, startupPackageProblem } from '../src/startup-install';
+import type { PackagingJob } from '../src/job-poller';
+const dirs:string[]=[];
+afterEach(()=>{for(const dir of dirs.splice(0))rmSync(dir,{recursive:true,force:true})});
+const job={created_at:'2026-01-01T00:00:00.000Z',id:'11111111-1111-4111-8111-111111111111',winget_id:'Vendor.App',display_name:'Fixture app',version:'2.0',install_scope:'machine',installer_type:'msi',package_config:{psadtConfig:{installAfterRestartBeta:true,restartBehavior:'Suppress'}}} as unknown as PackagingJob;
+it('packages a startup coordinator with a stable app key and real-version detection metadata',async()=>{
+ const dir=mkdtempSync(join(tmpdir(),'startup-package-'));dirs.push(dir);
+ await prepareStartupPackage(job,dir,'SOFTWARE\\IntuneGet\\Apps');
+ const config=JSON.parse(readFileSync(join(dir,'startup-config.json'),'utf8'));
+ expect(config).toMatchObject({v:1,jobId:job.id,version:'2.0',marker:'SOFTWARE\\IntuneGet\\Apps\\Vendor_App'});
+ expect(config.appKey).toMatch(/^[0-9a-f]{64}$/);
+ expect(readFileSync(join(dir,'IntuneGet-StartupInstall.ps1'),'utf8')).toContain('Test-IntuneGetNewBoot');
+ expect(readFileSync(join(dir,'Uninstall-AfterRestart.cmd'),'utf8')).toContain('-Mode Cancel');
+ expect(startupPackageProblem({...job,install_scope:'user'})).not.toBeNull();
+});
+const pwsh = spawnSync('pwsh',['-NoProfile','-Command','exit 0'],{timeout:10000}).status===0;
+it.runIf(pwsh)('parses Windows scripts and proves same-boot retries cannot authorize installation',()=>{
+ const script=resolve('packager/scripts/IntuneGet-StartupInstall.ps1');
+ const reporter=resolve('public/startup-beta/Detect-StartupInstallations.ps1');
+ const prepare=resolve('.github/scripts/Prepare-StartupPackage.ps1');
+ const cancellation=resolve('public/startup-beta/Cancel-StartupTemplate.ps1');
+ const command=`$ErrorActionPreference='Stop'; foreach($path in @('${script}','${reporter}','${prepare}','${cancellation}')) {$tokens=$null;$errors=$null;$null=[Management.Automation.Language.Parser]::ParseFile($path,[ref]$tokens,[ref]$errors);if($errors.Count){throw ($errors | Out-String)}}; . '${script}'; if(Test-IntuneGetNewBoot 'boot-1' 'boot-1'){throw 'Same boot admitted'};if(Test-IntuneGetNewBoot '' 'boot-2'){throw 'Missing boundary admitted'};if(-not (Test-IntuneGetNewBoot 'boot-1' 'boot-2')){throw 'New boot rejected'};Write-Output 'PASS'`;
+ const result=spawnSync('pwsh',['-NoProfile','-Command',command],{encoding:'utf8',timeout:25000});
+ expect(result.status,result.stderr).toBe(0);expect(result.stdout).toContain('PASS');
+},30000);
+
+it.runIf(pwsh)('prepares equivalent metadata through the GitHub Actions helper without executing an installer', async()=>{
+ const dir=mkdtempSync(join(tmpdir(),'startup-actions-'));dirs.push(dir);
+ const result=spawnSync('pwsh',['-NoProfile','-File',resolve('.github/scripts/Prepare-StartupPackage.ps1'),'-PackageDirectory',dir],{encoding:'utf8',timeout:25000,env:{...process.env,PSADT_CONFIG:JSON.stringify({installAfterRestartBeta:true,restartBehavior:'Suppress'}),INSTALL_SCOPE:'machine',INSTALLER_TYPE:'msi',JOB_ID:job.id,JOB_CREATED_AT:job.created_at,WINGET_ID:job.winget_id,VERSION:job.version,ESP_PROFILES:'[]',SUPERSEDENCE_TYPE:'update'}});
+ expect(result.status,result.stderr).toBe(0);
+ const config=JSON.parse(readFileSync(join(dir,'startup-config.json'),'utf8'));
+ const node=mkdtempSync(join(tmpdir(),'startup-node-'));dirs.push(node);await prepareStartupPackage(job,node,'SOFTWARE\\IntuneGet\\Apps');
+ expect(config).toEqual(JSON.parse(readFileSync(join(node,'startup-config.json'),'utf8')));
+ expect(readFileSync(join(dir,'IntuneGet-StartupInstall.ps1'),'utf8')).toContain('Assert-IntuneGetManifest');
+},30000);
+
+it.runIf(pwsh)('exercises staging, retry and post-boot completion with mocked Windows primitives',()=>{
+ const result=spawnSync('pwsh',['-NoProfile','-File',resolve('packager/tests/startup-lifecycle.fixture.ps1'),'-Runner',resolve('packager/scripts/IntuneGet-StartupInstall.ps1'),'-TempRoot',realpathSync(tmpdir())],{encoding:'utf8',timeout:25000});
+ expect(result.status,result.stderr).toBe(0);expect(result.stdout).toContain('PASS: staging');
+},30000);
+
+it('rejects missing deployment order before producing a startup package', async () => {
+ const dir=mkdtempSync(join(tmpdir(),'startup-no-order-'));dirs.push(dir);
+ await expect(prepareStartupPackage({...job,created_at:''},dir,'SOFTWARE\\IntuneGet\\Apps')).rejects.toThrow('original deployment creation time');
+});
