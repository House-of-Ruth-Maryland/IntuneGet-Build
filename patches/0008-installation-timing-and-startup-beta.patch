+
+/** Reuses the shared query cache so cards name their actual inherited rule. */
+export function AutoUpdateTimingSummary({ appId }: { appId: string }) {
+  const { data } = useInstallationPolicy();
+  if (!data?.shared) return null;
+  const exception = data.exceptions?.find(p => p.appId.toLowerCase() === appId.toLowerCase());
+  return <p className="mt-2 text-xs text-text-secondary"><span className="font-medium">{exception ? 'App exception' : 'Shared policy'}:</span> {installationPolicySummary(exception ?? data.shared)}. Applies to the next automatic release.</p>;
+}
+
+function RestartPilotStart({ wingetId, appId, groupId, groupName }: { wingetId: string; appId: string; groupId: string; groupName: string }) {
+  const { data, action } = usePilots();
+  if (!data?.supported) return <p className="text-sm text-text-muted">Starting a pilot requires supported SQLite and GitHub packaging mode.</p>;
+  const active = data.pilots.some(row => row.winget_id.toLowerCase() === wingetId.toLowerCase() && row.phase !== 'complete');
+  return <div className="space-y-2 border-t border-overlay/10 pt-3"><p className="text-sm text-text-secondary">Saved target: <strong>{groupName}</strong>. Only this pilot group receives the restart Beta package as Required. Existing wider assignments remain on the previous version.</p><Button disabled={active || action.isPending} onClick={() => action.mutate({ action: 'start', wingetId, appId, groupId, installationMode: 'restart' })}>{action.isPending ? 'Starting pilot…' : active ? 'Pilot already active' : 'Start restart Beta pilot'}</Button>{action.error && <p role="alert" className="text-sm text-status-error">{action.error.message}</p>}{action.isSuccess && <p role="status" className="text-sm text-status-success">Pilot requested. Review its actual deployment and install results in App updates.</p>}</div>;
+}
