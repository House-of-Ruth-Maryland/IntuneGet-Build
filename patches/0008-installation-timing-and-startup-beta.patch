@@ -0,0 +1,13 @@
+/** Browser-safe restrictions for the opt-in startup installer Beta. */
+export const STARTUP_BETA_LABEL = 'Install after next restart · Beta';
+export const STARTUP_BETA_COMMAND = 'powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File .\\IntuneGet-StartupInstall.ps1 -Mode Stage';
+export const STARTUP_BETA_UNINSTALL = 'cmd.exe /d /c Uninstall-AfterRestart.cmd';
+export function startupInstallationProblem(input: { installScope?: string | null; installerType?: string; customDetection?: boolean; espProfiles?: unknown[]; removal?: boolean; supersedenceType?: string; relationships?: { relationshipType?: string; supersedenceType?: string }[] }): string | null {
+  if (input.installScope !== 'machine') return 'The startup installer Beta supports machine-wide apps only.';
+  if (!['msi','wix','exe','inno','nullsoft','burn'].includes((input.installerType ?? '').toLowerCase())) return 'The startup installer Beta supports MSI and EXE installers only.';
+  if (input.customDetection) return 'The startup installer Beta requires automatic detection rules.';
+  if (input.espProfiles?.length) return 'The startup installer Beta cannot be used for New computer setup.';
+  if (input.removal) return 'The startup installer Beta cannot be used for app removal.';
+  if (input.supersedenceType === 'replace' || input.relationships?.some(r => r.relationshipType === 'supersedence' && r.supersedenceType === 'replace')) return 'Use update supersedence for the startup installer Beta so the previous version is kept until restart.';
+  return null;
+}
diff --git a/lib/hrm/startup-report-check.ts b/lib/hrm/startup-report-check.ts
new file mode 100644
index 000000000..765fbdbbe
--- /dev/null
+++ b/lib/hrm/startup-report-check.ts
@@ -0,0 +1,29 @@
+import { getServicePrincipalToken } from '@/lib/intune/graph-client';
+import { collectStartupReport, GUID } from './startup-report';
+/** Read-only Graph collection. Credentials never go to devices or pagination hosts. */
+export async function refreshStartupReport(tenant: string) {
+  const { sqliteStartupReports: store } = await import('@/lib/db/sqlite');
+  const script = process.env.HRM_STARTUP_REPORT_SCRIPT_ID;
+  if (!script || !GUID.test(script)) return;
+  try {
+    const token = await getServicePrincipalToken(tenant);
+    if (!token) throw new Error('Token unavailable');
+    const base = `https://graph.microsoft.com/beta/deviceManagement/deviceHealthScripts/${script}/deviceRunStates`;
+    let url: string | undefined = `${base}?$select=id,preRemediationDetectionScriptOutput&$top=500`;
+    const states: { id?: string; preRemediationDetectionScriptOutput?: string }[] = [];
+    const deadline = Date.now() + 90000;
+    for (let page = 0; url && page < 40; page++) {
+      if (Date.now() > deadline) throw new Error('Collection timeout');
+      const next = new URL(url);
+      if (next.origin !== 'https://graph.microsoft.com' || next.pathname !== new URL(base).pathname || next.username || next.password) throw new Error('Invalid pagination');
+      const response: Response = await fetch(url, { headers: { Authorization: `Bearer ${token}` }, signal: AbortSignal.timeout(15000), cache: 'no-store' });
+      if (!response.ok) { store.save(tenant, null, response.status === 403 || response.status === 401 ? 'access_denied' : 'read_failed'); return; }
+      const body: { value?: unknown; '@odata.nextLink'?: string } = await response.json();
+      if (!Array.isArray(body.value) || states.length + body.value.length > 20000) throw new Error('Report limit');
+      states.push(...body.value as { id?: string; preRemediationDetectionScriptOutput?: string }[]);
+      url = body['@odata.nextLink'];
+    }
+    if (url) throw new Error('Incomplete report');
+    store.save(tenant, collectStartupReport(states, store.jobs(tenant)));
+  } catch { store.save(tenant, null, 'read_failed'); }
+}
diff --git a/lib/hrm/startup-report-store.ts b/lib/hrm/startup-report-store.ts
new file mode 100644
index 000000000..b50703c82
--- /dev/null
+++ b/lib/hrm/startup-report-store.ts
@@ -0,0 +1,27 @@
+import type Database from 'better-sqlite3';
+import type { StartupJob, StartupReport, StartupReportView } from './startup-report';
+export function createStartupReportStore(getDb: () => Database.Database) {
+  return {
+    jobs(tenant: string): StartupJob[] {
+      const rows = getDb().prepare("SELECT id, display_name, version, package_config FROM packaging_jobs WHERE tenant_id = ? AND CASE WHEN json_valid(package_config) THEN json_extract(package_config, '$.psadtConfig.installAfterRestartBeta') END = 1 ORDER BY created_at DESC").all(tenant) as { id: string; display_name: string; version: string; package_config: string }[];
+      return rows.filter(row => { try { return JSON.parse(row.package_config || '{}').psadtConfig?.installAfterRestartBeta === true; } catch { return false; } }).map(row => ({ id: row.id, name: row.display_name, version: row.version }));
+    },
+    cancellation(tenant: string, job: string): { id: string; wingetId: string; version: string } | null {
+      const row = getDb().prepare('SELECT id, winget_id, version, package_config FROM packaging_jobs WHERE tenant_id = ? AND id = ?').get(tenant, job) as { id: string; winget_id: string; version: string; package_config: string } | undefined;
+      try { return row && JSON.parse(row.package_config || '{}').psadtConfig?.installAfterRestartBeta === true ? { id: row.id, wingetId: row.winget_id, version: row.version } : null; } catch { return null; }
+    },
+    tenants(): string[] {
+      return (getDb().prepare('SELECT DISTINCT tenant_id FROM packaging_jobs WHERE tenant_id IS NOT NULL LIMIT 100').all() as { tenant_id: string }[]).map(r => r.tenant_id);
+    },
+    read(tenant: string): Pick<StartupReportView, 'checkedAt' | 'report' | 'error'> {
+      const row = getDb().prepare('SELECT payload, checked_at, error FROM hrm_startup_reports WHERE tenant_id = ?').get(tenant) as { payload: string | null; checked_at: string; error: StartupReportView['error'] } | undefined;
+      if (!row) return {};
+      return { checkedAt: row.checked_at, ...(row.error ? { error: row.error } : {}), ...(row.payload ? { report: JSON.parse(row.payload) } : {}) };
+    },
+    save(tenant: string, report: StartupReport | null, error?: StartupReportView['error']) {
+      getDb().prepare(`INSERT INTO hrm_startup_reports (tenant_id, payload, checked_at, error) VALUES (?, ?, ?, ?)
+        ON CONFLICT(tenant_id) DO UPDATE SET payload=CASE WHEN excluded.error IS NULL THEN excluded.payload ELSE hrm_startup_reports.payload END, checked_at=CASE WHEN excluded.error IS NULL THEN excluded.checked_at ELSE hrm_startup_reports.checked_at END, error=excluded.error`)
+        .run(tenant, report ? JSON.stringify(report) : null, new Date().toISOString(), error ?? null);
+    },
+  };
+}
diff --git a/lib/hrm/startup-report.ts b/lib/hrm/startup-report.ts
new file mode 100644
index 000000000..7f97bd8c2
--- /dev/null
+++ b/lib/hrm/startup-report.ts
@@ -0,0 +1,47 @@
+export type StartupState = 'waiting' | 'installing' | 'installed' | 'failed' | 'cancelled' | 'outdated';
+export interface StartupCounts { waiting: number; installing: number; installed: number; failed: number; cancelled: number; outdated: number }
+export interface StartupJob { id: string; name: string; version: string }
+export interface StartupReport { rows: (StartupJob & StartupCounts & { lastActivityAt?: string })[]; summary: StartupCounts; reportingDevices: number; unknownDevices: number; omitted: number }
+export const emptyStartupCounts = (): StartupCounts => ({ waiting: 0, installing: 0, installed: 0, failed: 0, cancelled: 0, outdated: 0 });
+export const GUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
+export const STARTUP_FRESH_MS = 6 * 60 * 60 * 1000;
+/** Parses only bounded, known-job identifiers and states; never returns raw Intune/device output. */
+export function collectStartupReport(states: { id?: string; preRemediationDetectionScriptOutput?: string }[], jobs: StartupJob[], now = Date.now()): StartupReport {
+  const rows = new Map<string, StartupJob & StartupCounts & { lastActivityAt?: string }>(jobs.map(j => [j.id.toLowerCase(), { ...j, ...emptyStartupCounts() }]));
+  const result: StartupReport = { rows: [], summary: emptyStartupCounts(), reportingDevices: 0, unknownDevices: 0, omitted: 0 };
+  const seen = new Set<string>();
+  const phases: Record<string, StartupState> = { w: 'waiting', i: 'installing', s: 'installed', f: 'failed', c: 'cancelled' };
+  for (const state of states) {
+    if (!state.id || seen.has(state.id)) continue;
+    seen.add(state.id);
+    try {
+      const text = state.preRemediationDetectionScriptOutput;
+      if (typeof text !== 'string' || text.length > 2048) throw new Error();
+      const value = JSON.parse(text);
+      if (value.v !== 1 || !Number.isSafeInteger(value.at) || value.at * 1000 > now + 300000 || value.at * 1000 < now - 30 * 86400000 || !Array.isArray(value.items) || value.items.length > 24 || !Number.isSafeInteger(value.omitted) || value.omitted < 0 || value.omitted > 100000 || !Number.isSafeInteger(value.issues) || value.issues < 0 || value.issues > 100000) throw new Error();
+      if (!value.items.every((item: unknown) => Array.isArray(item) && item.length === 3 && typeof item[0] === 'string' && GUID.test(item[0]) && typeof item[1] === 'string' && Object.hasOwn(phases, item[1]) && Number.isSafeInteger(item[2]) && item[2] * 1000 <= now + 300000 && item[2] >= 0)) throw new Error();
+      result.reportingDevices++;
+      result.omitted += value.omitted;
+      if (value.issues) result.unknownDevices++;
+      const deviceJobs = new Set<string>();
+      for (const item of value.items) {
+
+        const row = rows.get(item[0].toLowerCase());
+        if (!row || deviceJobs.has(item[0].toLowerCase())) continue;
+        deviceJobs.add(item[0].toLowerCase());
+        const outdated = now - value.at * 1000 > STARTUP_FRESH_MS || (item[1] === 'i' && now - item[2] * 1000 > 2 * 3600000);
+        const phase = outdated ? 'outdated' : phases[item[1]];
+        row[phase]++; result.summary[phase]++;
+        if (!row.lastActivityAt || item[2] * 1000 > Date.parse(row.lastActivityAt)) row.lastActivityAt = new Date(item[2] * 1000).toISOString();
+      }
+    } catch { result.unknownDevices++; }
+  }
+  result.rows = [...rows.values()];
+  return result;
+}
+export interface StartupReportView { supported: boolean; configured: boolean; packages?: StartupJob[]; checkedAt?: string; error?: 'access_denied' | 'read_failed'; stale?: boolean; report?: StartupReport }
+
+/** Used in the collapsed overview so incomplete device reports never look healthy. */
+export function startupReportNeedsReview(view: Pick<StartupReportView, 'error' | 'stale' | 'report'>): boolean {
+  return !!(view.error || view.stale || (view.report && (view.report.unknownDevices > 0 || view.report.omitted > 0 || view.report.summary.outdated > 0)));
+}
