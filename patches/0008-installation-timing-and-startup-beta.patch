+import { readFileSync } from 'node:fs';
+import { spawnSync } from 'node:child_process';
+import { describe, expect, it } from 'vitest';
+import { parse } from 'yaml';
+import { cpSync, mkdtempSync, mkdirSync, rmSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+function project(assignments: unknown[], psadtConfig = '{}', expectFailure = false) {
+  const workflow = parse(readFileSync('.github/workflows-reference/package-intunewin.yml','utf8'));
+  const steps = Object.values(workflow.jobs).flatMap((job: unknown) => (job as {steps?: {name?:string;run?:string}[]}).steps ?? []);
+  const source = steps.find(step => step.name === 'Apply assignments')!.run!;
+  const begin = source.indexOf('if ($hasExplicitAssignments) {');
+  const end = source.indexOf('} elseif ($carryOver -and $hasSourceApp)', begin);
+  expect(begin).toBeGreaterThan(-1); expect(end).toBeGreaterThan(begin);
+  const input = Buffer.from(JSON.stringify(assignments)).toString('base64');
+  const script = '$assignmentsJson = [Text.Encoding]::UTF8.GetString([Convert]::FromBase64String("' + input + '"))\n$hasExplicitAssignments=$true\n$graphAssignments=@()\n' + source.slice(begin,end) + '}\nConvertTo-Json -Depth 12 -InputObject @($graphAssignments)';
+  const result = spawnSync('pwsh',['-NoProfile','-NonInteractive','-Command',script],{encoding:'utf8',env:{PATH:process.env.PATH,SystemRoot:process.env.SystemRoot,TEMP:process.env.TEMP,TMP:process.env.TMP,REQUIREMENT_RULES:'[]',PSADT_CONFIG:psadtConfig,GITHUB_WORKSPACE:workspace}});
+  if (expectFailure) { expect(result.status).not.toBe(0); return result.stderr; }
+  expect(result.status,result.stderr).toBe(0);
+  return JSON.parse(result.stdout);
+}
+// The private workflow checks the bundled script out under assignments/.
+const workspace = mkdtempSync(join(tmpdir(), 'hosted-assign-'));
+mkdirSync(join(workspace, 'assignments'));
+cpSync('.github/scripts/Preserve-AssignmentSettings.ps1', join(workspace, 'assignments', 'Preserve-AssignmentSettings.ps1'));
+// Install dates from the deploy form, through the hosted workflow's own Apply assignments step.
+describe('hosted assignment conversion with install dates',()=>{
+  const time={useLocalTime:true,startDateTime:'2026-12-01T09:00:00Z',deadlineDateTime:'2026-12-05T17:00:00Z'};
+  const grace={gracePeriodInMinutes:1440,countdownDisplayBeforeRestartInMinutes:15,restartNotificationSnoozeDurationInMinutes:240};
+  it('adds install dates only to the group that has them, exactly as the form sent them',()=>{
+    const rows=project([
+      {type:'group',groupId:'fake-a',intent:'required',installTimeSettings:time,restartSettings:grace},
+      {type:'group',groupId:'fake-b',intent:'required'},
+      {type:'allUsers',intent:'available',installTimeSettings:{useLocalTime:false,startDateTime:'2026-12-01T09:00:00Z',deadlineDateTime:null}},
+      {type:'group',groupId:'fake-c',intent:'required',installTimeSettings:{useLocalTime:true,startDateTime:null,deadlineDateTime:null}},
+      {type:'exclusionGroup',groupId:'fake-d',intent:'required'},
+    ],JSON.stringify({restartBehavior:'Prompt'}));
+    expect(rows[0].settings).toEqual({'@odata.type':'#microsoft.graph.win32LobAppAssignmentSettings',notifications:'showAll',deliveryOptimizationPriority:'notConfigured',installTimeSettings:time,restartSettings:grace});
+    // No dates set: the settings are exactly what they were before this feature.
+    expect(rows[1].settings).toEqual({'@odata.type':'#microsoft.graph.win32LobAppAssignmentSettings',notifications:'showAll',deliveryOptimizationPriority:'notConfigured'});
+    expect(rows[2].settings.installTimeSettings).toEqual({useLocalTime:false,startDateTime:'2026-12-01T09:00:00Z',deadlineDateTime:null});
+    expect(rows[3].settings).not.toHaveProperty('installTimeSettings');
+    expect(rows[4]).not.toHaveProperty('settings');
+  });
+  it.each([
+    ['a grace period on a deployment that suppresses restarts',[{type:'group',groupId:'fake-a',intent:'required',restartSettings:grace}],'{"restartBehavior":"Suppress"}','restart grace period needs'],
+    ['a grace period with no restart setting at all',[{type:'group',groupId:'fake-a',intent:'required',restartSettings:grace}],'{}','restart grace period needs'],
+    ['a deadline on an Available group',[{type:'allUsers',intent:'available',installTimeSettings:time}],'{}','Only Required groups'],
+    ['a date without a time zone',[{type:'group',groupId:'fake-a',intent:'required',installTimeSettings:{...time,startDateTime:'2026-12-01T09:00:00'}}],'{}','Enter valid Available from'],
+    ['dates on an exclusion',[{type:'exclusionGroup',groupId:'fake-a',intent:'required',installTimeSettings:time}],'{}','Excluded groups'],
+    ['dates on an Update only group',[{type:'group',groupId:'fake-a',intent:'updateOnly',installTimeSettings:time}],'{}','Only Required and Available'],
+    ['bad dates on the second group only',[{type:'group',groupId:'fake-a',intent:'required',installTimeSettings:time},{type:'group',groupId:'fake-b',intent:'required',installTimeSettings:{...time,deadlineDateTime:'2026-11-01T09:00:00Z'}}],'{}','at or after availability'],
+  ])('assigns no groups at all for %s',(_name,assignments,psadt,message)=>{
+    const stderr=project(assignments as unknown[],psadt as string,true) as string;
+    expect(stderr).toContain('Install dates could not be verified, so no groups were assigned');
+    expect(stderr).toContain(message);
+  });
+});
diff --git a/lib/hrm/__tests__/deploy-dates.test.ts b/lib/hrm/__tests__/deploy-dates.test.ts
new file mode 100644
index 000000000..485f89b21
--- /dev/null
+++ b/lib/hrm/__tests__/deploy-dates.test.ts
@@ -0,0 +1,118 @@
+// Install dates in the deploy form: what the form offers, refuses and describes, and the rule that
+// dates belong to one deployment and are never reused for a later version. Fake data only.
+import { describe, expect, it } from 'vitest';
+import type { PackageAssignment } from '@/types/upload';
+import type { PackagingJob } from '@/lib/db/types';
+import { canHaveDeployDates, deployDateProblems, deployDatesAvailable, deployDatesForm, deployFormProblem, deployFormProblems, deployGraceSupported, describeDeployDates, fitDeployDates, hasDeployDates, stripDeployDates, DEPLOY_GRACE_NOTE_HOSTED, DEPLOY_GRACE_NOTE_LOCAL } from '../deploy-dates';
+import { describeAssignments } from '../deploy-review';
+import { newVersionPrefill } from '../new-version';
+import { parsePackageAssignments } from '@/lib/update-policies/build-deployment-config';
+
+const A = '2026-12-01T09:00:00Z', B = '2026-12-05T17:00:00Z';
+const time = (startDateTime: string | null, deadlineDateTime: string | null, useLocalTime = true) => ({ useLocalTime, startDateTime, deadlineDateTime });
+const grace = { gracePeriodInMinutes: 1440, countdownDisplayBeforeRestartInMinutes: 15, restartNotificationSnoozeDurationInMinutes: 240 };
+const group = (over: Partial<PackageAssignment> = {}): PackageAssignment => ({ type: 'group', groupId: 'fake-group', groupName: 'Pilot computers', intent: 'required', ...over });
+
+describe('where install dates are offered', () => {
+  it('needs packaging that applies them: the local packager always, the hosted workflow only when attested', () => {
+    expect(deployDatesAvailable('local', false)).toBe(true);
+    expect(deployDatesAvailable('github', true)).toBe(true);
+    expect(deployDatesAvailable('github', false)).toBe(false);
+    expect(deployDatesAvailable('unavailable', true)).toBe(false);
+    expect(deployDatesAvailable('unknown', true)).toBe(false);
+  });
+  it('offers a grace period only where Intune restarts the computer', () => {
+    for (const behavior of ['Prompt', 'Force', 'Defer']) expect(deployGraceSupported('github', behavior)).toBe(true);
+    for (const behavior of ['Suppress', undefined, null, '', 'prompt']) expect(deployGraceSupported('github', behavior)).toBe(false);
+    expect(deployGraceSupported('local', 'Force')).toBe(false);
+  });
+  it('builds the form settings from the server capabilities', () => {
+    expect(deployDatesForm({ path: 'github', deployDates: true }, 'Prompt')).toMatchObject({ available: true, graceSupported: true, graceNote: DEPLOY_GRACE_NOTE_HOSTED });
+    expect(deployDatesForm({ path: 'local', deployDates: true }, 'Force')).toMatchObject({ available: true, graceSupported: false, graceNote: DEPLOY_GRACE_NOTE_LOCAL });
+    expect(deployDatesForm({ path: 'unknown', deployDates: false }, 'Force')).toMatchObject({ available: false, graceSupported: false });
+  });
+  it('allows dates on included Required and Available targets only', () => {
+    expect(canHaveDeployDates(group())).toBe(true);
+    expect(canHaveDeployDates(group({ intent: 'available' }))).toBe(true);
+    expect(canHaveDeployDates({ type: 'allDevices', intent: 'required' })).toBe(true);
+    expect(canHaveDeployDates(group({ intent: 'uninstall' }))).toBe(false);
+    expect(canHaveDeployDates(group({ intent: 'updateOnly' }))).toBe(false);
+    expect(canHaveDeployDates(group({ type: 'exclusionGroup' }))).toBe(false);
+  });
+});
+
+describe('what the form refuses', () => {
+  const form = { available: true, graceSupported: true };
+  it('has no problem when nothing is set, so the default stays as soon as possible', () => {
+    expect(hasDeployDates(group())).toBe(false);
+    expect(deployFormProblem(group(), form)).toBeNull();
+    expect(deployFormProblems([group(), group({ intent: 'uninstall' }), group({ type: 'exclusionGroup' })], form)).toEqual([]);
+    expect(deployFormProblems(undefined, form)).toEqual([]);
+    expect(deployFormProblems([group()], undefined)).toEqual([]);
+  });
+  it.each([
+    ['a deadline before availability', group({ installTimeSettings: time(B, A) }), 'at or after availability'],
+    ['a deadline on Available', group({ intent: 'available', installTimeSettings: time(A, B) }), 'Only Required groups'],
+    ['a date that is not a date', group({ installTimeSettings: time('2026-02-30T09:00:00Z', null) }), 'Enter valid Available from'],
+    ['an emptied minutes box', group({ restartSettings: { ...grace, gracePeriodInMinutes: NaN } }), 'Use whole minutes'],
+    ['a countdown longer than the grace period', group({ restartSettings: { ...grace, gracePeriodInMinutes: 10 } }), 'Use whole minutes'],
+    ['a grace period over 14 days', group({ restartSettings: { ...grace, gracePeriodInMinutes: 20161 } }), 'Use whole minutes'],
+  ])('refuses %s', (_name, assignment, message) => {
+    expect(deployFormProblem(assignment, form)).toContain(message);
+    expect(deployFormProblems([group(), assignment], form)).toEqual([expect.stringContaining('Pilot computers: ')]);
+  });
+  it('accepts the boundaries', () => {
+    expect(deployFormProblem(group({ installTimeSettings: time(A, A) }), form)).toBeNull();
+    expect(deployFormProblem(group({ restartSettings: { gracePeriodInMinutes: 20160, countdownDisplayBeforeRestartInMinutes: 20160, restartNotificationSnoozeDurationInMinutes: 0 } }), form)).toBeNull();
+    expect(deployFormProblem(group({ restartSettings: { gracePeriodInMinutes: 1, countdownDisplayBeforeRestartInMinutes: 1, restartNotificationSnoozeDurationInMinutes: 1 } }), form)).toBeNull();
+  });
+  it('refuses a grace period where this deployment never restarts', () => {
+    expect(deployFormProblem(group({ restartSettings: grace }), { available: true, graceSupported: false })).toContain('restart grace period needs');
+  });
+  it('refuses any dates on a server that cannot apply them, and on an app type that has none', () => {
+    expect(deployFormProblem(group({ installTimeSettings: time(A, null) }), { available: false, graceSupported: false })).toContain('cannot apply install dates');
+    expect(deployFormProblems([group({ installTimeSettings: time(A, null) })], undefined)).toEqual(['Install dates can be set for Win32 apps only. Remove the dates.']);
+  });
+  it('names each group in the server message', () => {
+    expect(deployDateProblems([group({ installTimeSettings: time(B, A) }), { type: 'allDevices', intent: 'available', installTimeSettings: time(A, B) }], true))
+      .toEqual(['Pilot computers: The installation deadline must be at or after availability.', 'All devices: Only Required groups can have an installation deadline.']);
+    expect(deployDateProblems('nope', true)).toEqual([]);
+  });
+});
+
+describe('keeping dates only where they belong', () => {
+  it('drops the deadline when a group becomes Available and everything when it cannot have dates', () => {
+    const dated = group({ installTimeSettings: time(A, B), restartSettings: grace });
+    expect(fitDeployDates({ ...dated, intent: 'available' })).toEqual({ ...dated, intent: 'available', installTimeSettings: time(A, null) });
+    expect(fitDeployDates({ ...dated, intent: 'uninstall' })).toEqual(group({ intent: 'uninstall' }));
+    expect(fitDeployDates({ ...dated, intent: 'updateOnly' })).toEqual(group({ intent: 'updateOnly' }));
+    expect(fitDeployDates(dated)).toBe(dated);
+    const plain = group({ filterId: 'f', notifications: 'hideAll' });
+    expect(fitDeployDates(plain)).toBe(plain);
+  });
+  it('strips dates and nothing else', () => {
+    expect(stripDeployDates(group({ filterId: 'f', filterType: 'include', notifications: 'showReboot', installTimeSettings: time(A, B), restartSettings: grace })))
+      .toEqual(group({ filterId: 'f', filterType: 'include', notifications: 'showReboot' }));
+    expect(stripDeployDates(null)).toBeNull();
+  });
+  it('does not carry one deployment\'s dates into the next version or into saved update settings', () => {
+    const assignments = [group({ installTimeSettings: time(A, B), restartSettings: grace }), group({ groupId: 'fake-b', groupName: 'All staff computers' })];
+    const prefill = newVersionPrefill({ id: 'job', version: '1.0', installer_type: 'exe', package_config: { assignments } } as unknown as PackagingJob);
+    expect(prefill.assignments).toEqual([group(), group({ groupId: 'fake-b', groupName: 'All staff computers' })]);
+    expect(parsePackageAssignments({ assignments })).toEqual([group(), group({ groupId: 'fake-b', groupName: 'All staff computers' })]);
+  });
+});
+
+describe('how the review words them', () => {
+  it('says nothing for as soon as possible', () => {
+    expect(describeDeployDates(group())).toBe('');
+    expect(describeDeployDates(group({ installTimeSettings: time(null, null) }))).toBe('');
+    expect(describeAssignments([group()])).toBe('Pilot computers · Required');
+  });
+  it('states the dates, the clock and the grace period beside the group', () => {
+    expect(describeDeployDates(group({ installTimeSettings: time(A, B), restartSettings: grace }))).toBe("available from Dec 1, 2026, 9:00 AM, must install by Dec 5, 2026, 5:00 PM, each computer's own clock, restart grace period");
+    expect(describeDeployDates(group({ installTimeSettings: time(A, null, false) }))).toBe('available from Dec 1, 2026, 9:00 AM UTC');
+    expect(describeAssignments([group({ installTimeSettings: time(null, B, false) }), { type: 'allUsers', intent: 'available' }, group({ type: 'exclusionGroup', groupName: 'Kiosks', installTimeSettings: time(A, null) })]))
+      .toBe('Pilot computers · Required (must install by Dec 5, 2026, 5:00 PM UTC), All users · Available, Kiosks · Excluded');
+  });
+});
