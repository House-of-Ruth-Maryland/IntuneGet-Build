diff --git a/packager/src/assignment-settings.ts b/packager/src/assignment-settings.ts
new file mode 100644
index 000000000..4bf55a471
--- /dev/null
+++ b/packager/src/assignment-settings.ts
@@ -0,0 +1,167 @@
+/** Shared assignment review contract. Pure functions; never contacts Intune. */
+export type PlainRecord = Record<string, unknown>;
+export interface DeadlineConfirmation { decision: 'retain' | 'reschedule'; assignmentIds: string[]; newDeadline?: string }
+export interface AssignmentTimingReview { sourceAppId: string; expected: unknown[]; expiredDates: 'keep' | 'reset'; deadlineConfirmation?: DeadlineConfirmation }
+export const DEADLINE_HOLD_CODE = 'EXPIRED_ASSIGNMENT_DEADLINE_REVIEW_REQUIRED';
+export class AssignmentDeadlineHold extends Error {
+  readonly code = DEADLINE_HOLD_CODE;
+  constructor(message = 'Paused for IT: review expired assignment deadlines before packaging.') { super(message); this.name = 'AssignmentDeadlineHold'; }
+}
+export const SETTINGS_REVIEW_CODE = 'ASSIGNMENT_SETTINGS_REVIEW_REQUIRED';
+export class AssignmentSettingsReview extends Error { readonly code=SETTINGS_REVIEW_CODE; constructor(message='Current assignment settings could not be verified. Review the source copy before retrying.'){super(message);this.name='AssignmentSettingsReview';} }
+export const asObject = (v: unknown): PlainRecord => v && typeof v === 'object' && !Array.isArray(v) ? v as PlainRecord : {};
+const copy = <T>(value: T): T => value === undefined ? value : JSON.parse(JSON.stringify(value));
+const SETTINGS = '#microsoft.graph.win32LobAppAssignmentSettings';
+const settingsKeys = ['@odata.type','@odata.context','notifications','deliveryOptimizationPriority','installTimeSettings','restartSettings','autoUpdateSettings','inUseSettings'];
+export function preservedAssignmentSettings(value: unknown): PlainRecord {
+  const old = asObject(value);
+  const unsupported = Object.keys(old).filter(key => !settingsKeys.includes(key)).sort();
+  if (unsupported.length) {
+    const names = unsupported.slice(0, 12).map(key => /^(?:@odata\.)?[A-Za-z][A-Za-z0-9_]{0,79}$/.test(key) ? key : '[nonstandard field name]');
+    throw new AssignmentSettingsReview(`Unsupported assignment settings. Review this copy in Intune before replacing it. Unsupported field names (${unsupported.length} total, at most 12 shown): ${JSON.stringify(names)}`);
+  }
+  if (old['@odata.type'] && old['@odata.type'] !== SETTINGS) throw new AssignmentSettingsReview('Only Win32 assignment settings can be carried over.');
+  const result: PlainRecord = { '@odata.type': SETTINGS, notifications: 'showAll', deliveryOptimizationPriority: 'notConfigured' };
+  for (const key of settingsKeys.slice(2)) if (Object.hasOwn(old, key)) result[key] = copy(old[key]);
+  // Graph beta $metadata: win32LobAppInUseSettings has three non-nullable Edm.Int32 values.
+  // Keep value, absence and null exactly; mirror Preserve-AssignmentSettings.ps1.
+  if (Object.hasOwn(old, 'inUseSettings') && old.inUseSettings !== null) {
+    const raw = old.inUseSettings;
+    if (!raw || typeof raw !== 'object' || Array.isArray(raw)) throw new AssignmentSettingsReview('Invalid in-use assignment settings shape. Review this copy in Intune.');
+    const inUse = raw as PlainRecord, fields = ['countdownMinutes','minutesBetweenDeferrals','numberOfDeferrals'];
+    if (Object.keys(inUse).some(key => ![...fields,'@odata.type','@odata.context'].includes(key))) throw new AssignmentSettingsReview('Unsupported in-use assignment settings. Review this copy in Intune before replacing it.');
+    if (Object.hasOwn(inUse,'@odata.type') && inUse['@odata.type'] !== '#microsoft.graph.win32LobAppInUseSettings') throw new AssignmentSettingsReview('Invalid in-use assignment settings type. Review this copy in Intune.');
+    for (const key of fields) { const v = inUse[key]; if (typeof v !== 'number' || !Number.isInteger(v) || v < -2147483648 || v > 2147483647) throw new AssignmentSettingsReview('Invalid in-use assignment integer settings. Review this copy in Intune.'); }
+  }
+  if (!['showAll','showReboot','hideAll'].includes(String(result.notifications))) throw new AssignmentSettingsReview('Unsupported notification setting. Review it in Intune.');
+  if (!['notConfigured','foreground'].includes(String(result.deliveryOptimizationPriority))) throw new AssignmentSettingsReview('Unsupported download priority. Review it in Intune.');
+  const timing = result.installTimeSettings;
+  if (timing != null) {
+    const t = asObject(timing);
+    if (typeof t.useLocalTime !== 'boolean') throw new AssignmentSettingsReview('Invalid assignment time zone. Refresh the review.');
+    for (const key of ['startDateTime','deadlineDateTime']) if (t[key] != null && (typeof t[key] !== 'string' || !Number.isFinite(Date.parse(t[key] as string)))) throw new AssignmentSettingsReview('Invalid assignment date. Review it in Intune.');
+  }
+  return result;
+}
+/** Canonical snapshot includes targets, filters, intent and all supported settings. */
+export function assignmentSnapshot(rows: unknown[]): unknown[] {
+  return rows.map(value => {
+    const row = asObject(value), target = asObject(row.target);
+    if (row.source != null && row.source !== 'direct') throw new AssignmentSettingsReview('Inherited assignments need review in Intune before replacement.');
+    if (!['required','available','availableWithoutEnrollment','uninstall'].includes(String(row.intent))) throw new AssignmentSettingsReview('Unsupported assignment intent. Review it in Intune.');
+    const type = String(target['@odata.type'] || '');
+    if (!['#microsoft.graph.allDevicesAssignmentTarget','#microsoft.graph.allLicensedUsersAssignmentTarget','#microsoft.graph.groupAssignmentTarget','#microsoft.graph.exclusionGroupAssignmentTarget'].includes(type)) throw new AssignmentSettingsReview('Unsupported assignment target. Review it in Intune.');
+    const keptTarget: PlainRecord = { '@odata.type': type };
+    for (const key of ['groupId','deviceAndAppManagementAssignmentFilterId','deviceAndAppManagementAssignmentFilterType']) if (Object.hasOwn(target,key)) keptTarget[key] = target[key];
+    return { id: String(row.id || ''), intent: row.intent, target: keptTarget, settings: type.includes('exclusionGroup') ? null : preservedAssignmentSettings(row.settings) };
+  }).sort((a,b) => a.id.localeCompare(b.id) || canonical(a).localeCompare(canonical(b)));
+}
+export function canonical(value: unknown): string {
+  if (Array.isArray(value)) return '[' + value.map(canonical).join(',') + ']';
+  if (value && typeof value === 'object') return '{' + Object.entries(value).sort(([a],[b]) => a < b ? -1 : a > b ? 1 : 0).map(([key,v]) => JSON.stringify(key) + ':' + canonical(v)).join(',') + '}';
+  return JSON.stringify(value) ?? 'null';
+}
+export function needsDateReview(snapshot: unknown[], now = Date.now()): boolean {
+  return snapshot.some(value => {
+    const settings = asObject(asObject(value).settings), timing = asObject(settings.installTimeSettings);
+    return ['startDateTime','deadlineDateTime'].some(key => typeof timing[key] === 'string' && (timing.useLocalTime === true || Date.parse(timing[key] as string) < now));
+  });
+}
+/** A device-local wall time can already be due in UTC+14; later deadlines are unaffected. */
+export function deadlineAssignments(snapshot: unknown[], now = Date.now()): PlainRecord[] {
+  return snapshot.map(asObject).filter(row => {
+    if (row.intent !== 'required' || String(asObject(row.target)['@odata.type']).includes('exclusionGroup')) return false;
+    const t = asObject(asObject(row.settings).installTimeSettings);
+    return typeof t.deadlineDateTime === 'string' && Date.parse(t.deadlineDateTime) <= now + (t.useLocalTime === true ? 14 * 3600000 : 0);
+  });
+}
+export function deadlineProblem(snapshot: unknown[], sourceAppId: string, review?: AssignmentTimingReview | null, now = Date.now()): string | null {
+  if (review && (review.sourceAppId?.toLowerCase() !== sourceAppId.toLowerCase() || !Array.isArray(review.expected) || canonical(snapshot) !== canonical(review.expected))) return 'Assignments changed after review. Review the deadlines again.';
+  const affected = deadlineAssignments(snapshot, now);
+  if (!affected.length) return null;
+  const confirmation = review?.deadlineConfirmation;
