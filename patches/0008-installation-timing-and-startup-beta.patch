+'use client';
+import { useRef, useState } from 'react';
+import { useQueryClient } from '@tanstack/react-query';
+import { useMicrosoftAuth } from '@/hooks/useMicrosoftAuth';
+import { useMspOptional } from '@/hooks/useMspOptional';
+import { useAppDetails } from '@/hooks/use-inventory';
+import { Button } from '@/components/ui/button';
+import { Dialog, DialogContent, DialogDescription, DialogHeader, DialogTitle, DialogTrigger } from '@/components/ui/dialog';
+import { EDIT_GROUPS, intentLabel, isExclusion, removeProblem, switchProblem, targetName, typeLabel } from '@/lib/hrm/group-edit';
+import type { GraphAssignment } from '@/lib/hrm/duplicates';
+import { Term } from './Term';
+import { PilotGroupPicker, type PilotGroupSelection } from './PilotGroupPicker';
+
+export { EDIT_GROUPS };
+type Change = { change: 'add'; groupId: string; intent: string } | { change: 'remove'; assignmentId: string } | { change: 'switch'; assignmentId: string; intent: string };
+interface Review { change?: 'remove' | 'switch'; appName: string; version: string; token: string; group?: string; from?: string; to?: string | null; kept?: string[]; dropped?: string[]; alreadyBoth?: boolean; leavesNoGroups?: boolean; remaining?: string[]; groupName?: string; groupId?: string; intent?: string }
+
+export function EditAssignments({ appId }: { appId: string }) {
+  const { isMspUser, selectedTenantId } = useMspOptional();
+  const tenantId = isMspUser ? selectedTenantId : null;
+  const [open, setOpen] = useState(false);
+  return <Dialog open={open} onOpenChange={setOpen}><DialogTrigger asChild><Button size="sm" variant="outline">{EDIT_GROUPS}</Button></DialogTrigger><DialogContent side="right" onOpenAutoFocus={event => { event.preventDefault(); (event.currentTarget as HTMLElement).focus(); }}><DialogHeader className="pr-12"><DialogTitle>{EDIT_GROUPS}</DialogTitle><DialogDescription>Who gets this version in Intune. Each change is checked with Intune before it is saved. No new package is made.</DialogDescription></DialogHeader><div className="flex-1 min-h-0 overflow-y-auto p-6">{open && <LiveEditor key={`${appId}:${tenantId}`} appId={appId} tenantId={tenantId} />}</div></DialogContent></Dialog>;
+}
+function LiveEditor({ appId, tenantId }: { appId: string; tenantId?: string | null }) {
+  const details = useAppDetails(appId);
+  const app = details.data?.app;
+  if (!app) return details.error ? <p role="alert" className="text-sm text-status-error">Could not read this app&apos;s groups from Intune. Close this panel and try again.</p> : <p role="status" className="text-sm text-text-secondary">Reading the groups from Intune…</p>;
+  return <AssignmentEditor appId={appId} tenantId={tenantId} rows={(app.assignments ?? []) as unknown as GraphAssignment[]} names={app.assignmentGroupNames ?? {}} />;
+}
+
+export function AssignmentEditor({ appId, tenantId, rows = [], names = {} }: { appId: string; tenantId?: string | null; rows?: GraphAssignment[]; names?: Record<string, string> }) {
+  const { getAccessToken } = useMicrosoftAuth();
+  const client = useQueryClient();
+  const [group, setGroup] = useState<PilotGroupSelection | null>(null);
+  const [intent, setIntent] = useState('required');
+  const [pending, setPending] = useState<Change | null>(null);
+  const [review, setReview] = useState<Review | null>(null);
+  const [confirmNoGroups, setConfirmNoGroups] = useState(false);
+  const [busy, setBusy] = useState(false);
+  const running = useRef(false);
+  const [error, setError] = useState('');
+  const [message, setMessage] = useState('');
+  const reset = () => { setReview(null); setPending(null); setConfirmNoGroups(false); };
+  async function run(action: 'review' | 'save', change: Change) {
+    if (running.current) return;
+    running.current = true; setBusy(true); setError(''); setMessage('');
+    try {
+      const token = await getAccessToken();
+      if (!token) throw new Error('Sign in again.');
+      const response = await fetch('/api/hrm/app-assignments', { method: 'POST', headers: { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json', ...(tenantId ? { 'X-MSP-Tenant-Id': tenantId } : {}) }, body: JSON.stringify({ action, appId, ...change, ...(action === 'save' ? { token: review?.token, confirmNoGroups } : {}) }) });
+      if (response.redirected || !response.headers.get('content-type')?.includes('application/json')) throw new Error('Your sign-in expired. Reload and sign in again.');
+      const data = await response.json();
+      if (!response.ok) throw new Error(data.error || 'Could not save the change.');
+      if (action === 'review') {
+        setPending(change); setReview(data.review); setConfirmNoGroups(false);
+        if (data.alreadyAssigned) setMessage('This group is already on the app with this choice. Saving changes nothing.');
+      } else {
+        reset(); setGroup(null);
+        setMessage(data.alreadyAssigned || data.alreadyDone ? 'Intune already has this change. Nothing else was changed.' : 'Saved to Intune.');
+        await client.invalidateQueries({ queryKey: ['inventory'] });
+        await client.invalidateQueries({ queryKey: ['hrm', 'app-insights'] });
+      }
+    } catch (e) {
+      setError(e instanceof Error ? e.message : 'Could not confirm the change. Review it again before retrying.'); reset();
+      if (action === 'save') await client.invalidateQueries({ queryKey: ['inventory'] });
+    } finally { running.current = false; setBusy(false); }
+  }
+  const locked = busy || !!review;
+  const summary = !review || !pending ? '' : pending.change === 'add' ? `Add ${review.groupName} as ${review.intent === 'required' ? 'Required' : 'Available for enrolled devices'}`
+    : pending.change === 'remove' ? `Remove ${review.group} (${review.from})` : `Switch ${review.group} from ${review.from} to ${review.to}`;
+  return <div className="space-y-6 text-sm text-text-secondary">
+    {review && pending && <section aria-label="Change review" className="space-y-3 rounded-lg border border-accent-cyan/40 bg-accent-cyan/5 p-4">
+      <h3 className="font-semibold text-text-primary">Check this change</h3>
+      <p className="text-[15px] font-medium text-text-primary">{summary}</p>
+      <p>App: <strong className="text-text-primary">{review.appName}</strong> · version <strong className="text-text-primary">{review.version || 'not reported'}</strong></p>
+      {pending.change === 'add' && <p>The new group has no filter, no install dates and all notifications.</p>}
+      {review.alreadyBoth && <p>This group is already {review.to} as well. Saving removes its {review.from} assignment only.</p>}
+      {!!review.kept?.length && <p>Kept: {review.kept.join(', ')}.</p>}
+      {!!review.dropped?.length && <p className="text-status-warning">Not kept: {review.dropped.join('; ')}.</p>}
+      {pending.change !== 'add' && (review.remaining?.length ? <p>Not changed: {review.remaining.join(', ')}.</p> : <p>No other groups are on this app.</p>)}
+      {review.leavesNoGroups && <label className="flex items-start gap-3 rounded-md border border-status-warning/40 bg-status-warning/10 p-3 font-medium text-text-primary"><input type="checkbox" className="mt-1 h-4 w-4" checked={confirmNoGroups} disabled={busy} onChange={e => setConfirmNoGroups(e.target.checked)} /><span>This is the last group. No computer will get this app. Remove it anyway.</span></label>}
+      <div className="flex flex-wrap gap-3"><Button disabled={busy || (!!review.leavesNoGroups && !confirmNoGroups)} onClick={() => void run('save', pending)}>{busy ? 'Saving…' : 'Save to Intune'}</Button><Button variant="outline" disabled={busy} onClick={() => { reset(); setMessage(''); }}>Cancel</Button></div>
+    </section>}
+    {error && <p role="alert" className="font-medium text-status-error">{error}</p>}{message && <p role="status" className="font-medium text-status-success">{message}</p>}
+
+    <section aria-label="Groups on this app" className="space-y-2">
+      <h3 className="text-base font-semibold text-text-primary">Groups on this app</h3>
+      {rows.length === 0 ? <p>No groups. No computer gets this app.</p> : <ul className="divide-y divide-overlay/10 rounded-lg border border-overlay/10">{rows.map((row, index) => {
+        const name = targetName(row, names), cannotRemove = removeProblem(row), cannotSwitch = switchProblem(row);
+        const other = row.intent === 'required' ? 'available' : 'required';
+        return <li key={row.id ?? index} className="space-y-2 px-4 py-3">
+          <p className="text-[15px] text-text-primary"><span className="font-medium">{name}</span> · {!isExclusion(row) && (row.intent === 'required' || row.intent === 'available') ? <Term term={row.intent}>{intentLabel(row.intent)}</Term> : typeLabel(row)}</p>
+          {cannotRemove ? <p className="text-xs text-text-muted">{cannotRemove}</p> : <div className="flex flex-wrap items-center gap-2">
+            {!cannotSwitch && <Button size="sm" variant="outline" disabled={locked} aria-label={`Switch ${name} to ${intentLabel(other)}`} onClick={() => void run('review', { change: 'switch', assignmentId: row.id!, intent: other })}>Switch to {intentLabel(other)}</Button>}
+            <Button size="sm" variant="outline" disabled={locked} aria-label={`Remove ${name}`} onClick={() => void run('review', { change: 'remove', assignmentId: row.id! })}>Remove</Button>
+            {cannotSwitch && <span className="text-xs text-text-muted">{cannotSwitch}</span>}
+          </div>}
+        </li>;
+      })}</ul>}
+    </section>
+
+    <section aria-label="Add a group" className="space-y-3">
+      <h3 className="text-base font-semibold text-text-primary">Add a group</h3>
+      <PilotGroupPicker selected={group} onSelect={value => { setGroup(value); setMessage(''); }} disabled={locked} label="Find an Entra group" tenantId={tenantId} />
+      <label className="block font-medium text-text-primary">Required or Available<select className="mt-2 block w-full rounded-lg border border-overlay/20 bg-bg-elevated p-2" value={intent} disabled={locked} onChange={event => { setIntent(event.target.value); setMessage(''); }}><option value="required">Required</option><option value="available">Available for enrolled devices</option></select></label>
+      <p>{intent === 'required' ? <><Term term="required">Required</Term>: Intune installs this app on eligible computers in the group.</> : <><Term term="available">Available</Term>: staff with enrolled computers can choose this app in Company Portal.</>}</p>
+      <div><Button disabled={locked || !group} onClick={() => group && void run('review', { change: 'add', groupId: group.id, intent })}>{busy && !review ? 'Checking Intune…' : 'Review change'}</Button></div>
+    </section>
+
+    <ul className="list-disc space-y-1 border-t border-overlay/10 pl-5 pt-4">
+      <li>One change at a time. Groups you do not change keep their filters, install dates and settings.</li>
+      <li>A new group has no filter, no install dates (it starts as soon as possible) and all notifications. Set its dates afterwards in Install dates.</li>
+      <li>Exclusions, Uninstall groups and groups that come from another assignment can only be changed in Intune.</li>
+    </ul>
+  </div>;
+}
