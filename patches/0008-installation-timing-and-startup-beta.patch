+// @vitest-environment happy-dom
+import { act, createElement } from 'react';
+import { createRoot } from 'react-dom/client';
+import { expect, it } from 'vitest';
+import { INTUNE_TERMS, Term } from './Term';
+(globalThis as { IS_REACT_ACT_ENVIRONMENT?: boolean }).IS_REACT_ACT_ENVIRONMENT = true;
+
+it('keeps the Intune word on screen and explains it on keyboard focus', async () => {
+  const node = document.createElement('div'); document.body.append(node); const root = createRoot(node);
+  await act(async () => root.render(createElement(Term, { term: 'mustInstallBy' }, 'Must install by')));
+  const word = node.querySelector<HTMLElement>('[tabindex="0"]')!;
+  expect(word.textContent).toBe('Must install by');
+  await act(async () => word.focus());
+  expect(document.body.textContent).toContain('Intune calls this the installation deadline.');
+  await act(async () => root.unmount());
+});
+
+it('writes every explanation as short plain sentences', () => {
+  for (const text of Object.values(INTUNE_TERMS)) {
+    expect(text).not.toContain('—');
+    expect(text.length).toBeLessThanOrEqual(190);
+    expect(text.endsWith('.')).toBe(true);
+  }
+});
diff --git a/app/api/hrm/app-assignments/route.groups.test.ts b/app/api/hrm/app-assignments/route.groups.test.ts
new file mode 100644
index 000000000..ac0d38e88
--- /dev/null
+++ b/app/api/hrm/app-assignments/route.groups.test.ts
@@ -0,0 +1,318 @@
+// Edit groups: removing one group and switching one group between Required and Available.
+// Fake Graph only. Every test checks the exact writes. A removal deletes one assignment. A switch
+// saves the whole list once (Intune refuses a group as Required and Available together), and
+// every other group must go back exactly as it was read.
+import { afterEach, beforeEach, expect, it, vi } from 'vitest';
+import { NextRequest } from 'next/server';
+const state = vi.hoisted(() => ({ sqlite: false, retiring: false, pilot: false }));
+vi.mock('@/lib/auth-utils', () => ({ parseAccessToken: async () => ({ userId: 'staff', tenantId: 'tenant', userEmail: 'admin@example.test' }) }));
+vi.mock('@/lib/supabase', () => ({ getServerClientOrNull: () => null }));
+vi.mock('@/lib/db', () => ({ isSqliteMode: () => state.sqlite }));
+vi.mock('@/lib/db/sqlite', () => ({ sqliteRetirements: { holdsApp: () => state.retiring }, sqlitePilotRollouts: { holdsApp: () => state.pilot, active: () => false }, sqliteAppInsights: { family: () => null, observe: () => {} } }));
+vi.mock('@/lib/intune/graph-client', () => ({ getServicePrincipalToken: async () => 'fixture-token' }));
+vi.mock('@/lib/msp/tenant-resolution', () => ({ resolveTargetTenantId: async () => ({ tenantId: 'tenant', errorResponse: null }) }));
+import { POST } from './route';
+
+const APP = '10000000-0000-0000-0000-000000000001';
+const G1 = '20000000-0000-0000-0000-000000000001', G2 = '20000000-0000-0000-0000-000000000002', G3 = '20000000-0000-0000-0000-000000000003';
+const SETTINGS = '#microsoft.graph.win32LobAppAssignmentSettings';
+const group = (id: string) => ({ '@odata.type': '#microsoft.graph.groupAssignmentTarget', groupId: id });
+type Row = Record<string, unknown> & { id: string; intent: string };
+let rows: Row[];
+let calls: { method: string; path: string; body?: Record<string, unknown> }[];
+let assignStatus: number, deleteStatus: number, ignoreAssign: boolean, mangleAssign: boolean, keepDeleted: boolean, version: string;
+const writes = () => calls.filter(c => c.method !== 'GET');
+const send = (body: object) => POST(new NextRequest('http://localhost/api/hrm/app-assignments', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ appId: APP, ...body }) }));
+const json = async (body: object) => { const r = await send(body); return { status: r.status, ...(await r.json()) }; };
+const review = async (body: object) => (await json({ action: 'review', ...body })).review;
+const full = { '@odata.type': SETTINGS, notifications: 'showReboot', deliveryOptimizationPriority: 'foreground',
+  installTimeSettings: { useLocalTime: true, startDateTime: '2026-12-01T09:00:00Z', deadlineDateTime: '2026-12-05T17:00:00Z' },
+  restartSettings: { gracePeriodInMinutes: 1440, countdownDisplayBeforeRestartInMinutes: 15, restartNotificationSnoozeDurationInMinutes: 240 },
+  inUseSettings: { countdownMinutes: 10, minutesBetweenDeferrals: 30, numberOfDeferrals: 3 } };
+
+beforeEach(() => {
+  state.sqlite = false; state.retiring = false; state.pilot = false;
+  rows = [
+    { id: 'pilot', intent: 'required', source: 'direct', target: { ...group(G1), deviceAndAppManagementAssignmentFilterId: 'filter-1', deviceAndAppManagementAssignmentFilterType: 'include' }, settings: structuredClone(full) },
+    { id: 'staff', intent: 'required', source: 'direct', target: group(G2), settings: { '@odata.type': SETTINGS, notifications: 'showAll', futureSetting: { keep: true } }, futureRoot: 1 },
+    { id: 'excluded', intent: 'required', source: 'direct', target: { '@odata.type': '#microsoft.graph.exclusionGroupAssignmentTarget', groupId: G3 }, settings: null },
+  ];
+  calls = []; assignStatus = 204; deleteStatus = 204; ignoreAssign = false; mangleAssign = false; keepDeleted = false; version = '1.2';
+  vi.stubGlobal('fetch', vi.fn(async (url: string, init?: RequestInit) => {
+    const path = new URL(url).pathname.replace(/^\/(beta|v1\.0)/, ''); const method = init?.method ?? 'GET';
+    const body = init?.body ? JSON.parse(init.body as string) : undefined;
+    calls.push({ method, path, body });
+    if (path.startsWith('/groups/')) { const id = path.split('/')[2]; return Response.json({ id, displayName: `Group ${id.slice(-1)}`, securityEnabled: true }); }
+    if (path.endsWith('/assign') && method === 'POST') {
+      // Intune's assign action replaces the whole list, or refuses and changes nothing.
+      if (assignStatus !== 204) return new Response('', { status: assignStatus });
+      if (!ignoreAssign) rows = (body.mobileAppAssignments as Record<string, unknown>[]).map((a, i) => {
+        const target = a.target as { groupId?: string; '@odata.type': string };
+        // Like Intune: the ID follows the group and type, and settings come back with empty fields filled in.
+        const settings = a.settings ? { restartSettings: null, installTimeSettings: null, autoUpdateSettings: null, ...(a.settings as object), ...(mangleAssign && i === 1 ? { notifications: 'hideAll' } : {}) } : null;
+        return { id: `${target.groupId ?? target['@odata.type']}_${a.intent}`, source: 'direct', intent: a.intent as string, target, settings };
+      });
+      return new Response(null, { status: 204 });
+    }
+    if (path.endsWith('/assignments')) return Response.json({ value: rows });
+    const one = path.match(/\/assignments\/(.+)$/);
+    if (one && method === 'DELETE') {
+      if (deleteStatus !== 204) return new Response('', { status: deleteStatus });
+      if (!keepDeleted) rows = rows.filter(r => r.id !== decodeURIComponent(one[1]));
+      return new Response(null, { status: 204 });
+    }
+    return Response.json({ id: APP, displayName: 'Example app', displayVersion: version, '@odata.type': '#microsoft.graph.win32LobApp' });
+  }));
+});
+afterEach(() => vi.unstubAllGlobals());
+
+// ---- Remove ----
+it('reviews a removal without writing, then deletes only that one row', async () => {
+  const before = structuredClone(rows.filter(r => r.id !== 'pilot'));
+  const r = await review({ change: 'remove', assignmentId: 'pilot' });
+  expect(r).toMatchObject({ change: 'remove', appName: 'Example app', version: '1.2', group: 'Group 1', from: 'Required', leavesNoGroups: false });
+  expect(r.remaining).toEqual(['Group 2 · Required', 'Group 3 · Excluded']);
+  expect(writes()).toEqual([]);
+  const saved = await json({ action: 'save', change: 'remove', assignmentId: 'pilot', token: r.token });
+  expect(saved).toMatchObject({ status: 200, success: true });
+  expect(writes()).toEqual([{ method: 'DELETE', path: `/deviceAppManagement/mobileApps/${APP}/assignments/pilot`, body: undefined }]);
+  // Untouched groups are exactly as they were, unknown fields included; they were never sent anywhere.
+  expect(rows).toEqual(before);
+  expect(calls.some(c => c.path.endsWith('/assign'))).toBe(false);
+});
+it('refuses to save a removal without a review token, or with one for another group', async () => {
+  const r = await review({ change: 'remove', assignmentId: 'pilot' });
+  expect((await json({ action: 'save', change: 'remove', assignmentId: 'pilot' })).status).toBe(409);
+  expect((await json({ action: 'save', change: 'remove', assignmentId: 'staff', token: r.token })).status).toBe(409);
+  expect(writes()).toEqual([]);
+});
+it.each([
+  ['its settings', () => { (rows[0].settings as Record<string, unknown>).notifications = 'hideAll'; }],
+  ['the app version', () => { version = '1.3'; }],
+  ['another group, so this became the last one', () => { rows = rows.filter(r => r.id !== 'staff'); }],
+])('rejects a stale removal review after a change to %s', async (_name, mutate) => {
+  const r = await review({ change: 'remove', assignmentId: 'pilot' });
+  mutate();
+  const saved = await json({ action: 'save', change: 'remove', assignmentId: 'pilot', token: r.token });
+  expect(saved.status).toBe(409); expect(saved.error).toContain('Review the change again'); expect(writes()).toEqual([]);
+});
+it('guards the last group: it needs an explicit confirmation, and an exclusion does not count as a group', async () => {
+  rows = rows.filter(r => r.id !== 'staff');
+  const r = await review({ change: 'remove', assignmentId: 'pilot' });
+  expect(r.leavesNoGroups).toBe(true);
+  for (const confirmNoGroups of [undefined, false, 'true', 1]) {
+    const refused = await json({ action: 'save', change: 'remove', assignmentId: 'pilot', token: r.token, confirmNoGroups });
+    expect(refused.status).toBe(400); expect(refused.error).toContain('last group');
+  }
+  expect(writes()).toEqual([]);
+  expect((await json({ action: 'save', change: 'remove', assignmentId: 'pilot', token: r.token, confirmNoGroups: true })).success).toBe(true);
+  expect(rows.map(r => r.id)).toEqual(['excluded']);
+});
+it.each([
+  ['an exclusion', 'excluded', () => {}, 'more computers'],
+  ['an uninstall group', 'staff', () => { rows[1].intent = 'uninstall'; }, 'Uninstall groups'],
+  ['an inherited assignment', 'staff', () => { rows[1].source = 'policySets'; }, 'another assignment'],
+  ['an unknown target type', 'staff', () => { rows[1].target = { '@odata.type': '#microsoft.graph.futureTarget' }; }, 'only be changed in Intune'],
+])('will not remove %s', async (_name, id, mutate, message) => {
+  mutate();
+  const r = await json({ action: 'review', change: 'remove', assignmentId: id });
+  expect(r.status).toBe(409); expect(r.error).toContain(message);
+  expect((await json({ action: 'save', change: 'remove', assignmentId: id, token: 'x' })).status).toBe(409);
+  expect(writes()).toEqual([]);
+});
+it('treats a retry after a lost reply as done and writes nothing', async () => {
+  const r = await review({ change: 'remove', assignmentId: 'pilot' });
+  rows = rows.filter(row => row.id !== 'pilot');
+  const saved = await json({ action: 'save', change: 'remove', assignmentId: 'pilot', token: r.token });
+  expect(saved).toMatchObject({ status: 200, success: true, alreadyDone: true });
+  expect(writes()).toEqual([]);
+  expect((await json({ action: 'review', change: 'remove', assignmentId: 'pilot' })).error).toContain('no longer on the app');
+});
+it.each([[500, 424, 'did not confirm the removal'], [403, 403, 'denied'], [204, 424, 'did not confirm the removal']])('reports a removal Intune answered with %s', async (status, expected, message) => {
+  deleteStatus = status; keepDeleted = status === 204;
+  const r = await review({ change: 'remove', assignmentId: 'pilot' });
+  const saved = await json({ action: 'save', change: 'remove', assignmentId: 'pilot', token: r.token });
+  expect(saved.status).toBe(expected); expect(saved.error).toContain(message);
+  expect(rows.some(row => row.id === 'pilot')).toBe(true);
+});
+it('accepts a 404 on delete only when the group is really gone', async () => {
+  const r = await review({ change: 'remove', assignmentId: 'pilot' });
+  deleteStatus = 404;
+  // Intune says "not found" but still lists the group: not confirmed.
+  expect((await json({ action: 'save', change: 'remove', assignmentId: 'pilot', token: r.token })).status).toBe(424);
+  // Someone else removed it between the read and the delete: the reread shows it gone.
+  const impl = vi.mocked(fetch).getMockImplementation()!;
+  vi.mocked(fetch).mockImplementation(async (url, init) => { if (init?.method === 'DELETE') rows = rows.filter(row => row.id !== 'pilot'); return impl(url, init); });
+  expect((await json({ action: 'save', change: 'remove', assignmentId: 'pilot', token: r.token })).success).toBe(true);
+});
+
+// ---- Switch ----
+const assigns = () => writes().filter(c => c.path.endsWith('/assign'));
+const sent = () => assigns()[0].body!.mobileAppAssignments as Record<string, unknown>[];
+const asSent = (row: Row) => ({ '@odata.type': '#microsoft.graph.mobileAppAssignment', intent: row.intent, target: row.target, ...(row.settings ? { settings: row.settings } : {}) });
+it('switches Required to Available with one save of the whole list, every other group exactly as read', async () => {
+  rows[1] = { id: 'staff', intent: 'required', source: 'direct', target: group(G2), settings: { '@odata.type': SETTINGS, notifications: 'showAll', deliveryOptimizationPriority: 'notConfigured', inUseSettings: { countdownMinutes: 5, minutesBetweenDeferrals: 60, numberOfDeferrals: 2 }, installTimeSettings: { useLocalTime: false, startDateTime: null, deadlineDateTime: '2026-12-09T17:00:00Z' } } };
+  const others = structuredClone(rows.filter(r => r.id !== 'pilot'));
+  const r = await review({ change: 'switch', assignmentId: 'pilot', intent: 'available' });
+  expect(r).toMatchObject({ change: 'switch', group: 'Group 1', from: 'Required', to: 'Available', alreadyBoth: false, leavesNoGroups: false });
+  expect(r.kept).toEqual(['Filter', 'Notifications', 'Download priority', 'Available from', 'Restart grace period', 'App in use settings']);
+  expect(r.dropped).toEqual(['Must install by (Available groups have no deadline)']);
+  expect(r.remaining).toEqual(['Group 2 · Required', 'Group 3 · Excluded']);
+  expect(writes()).toEqual([]);
+  expect((await json({ action: 'save', change: 'switch', assignmentId: 'pilot', intent: 'available', token: r.token })).success).toBe(true);
+  // Exactly one write, and it is the assign action. Nothing is added or deleted one by one.
+  expect(writes().map(c => `${c.method} ${c.path.split('/').slice(4).join('/')}`)).toEqual(['POST assign']);
+  expect(sent()).toEqual([
+    { '@odata.type': '#microsoft.graph.mobileAppAssignment', intent: 'available',
+      target: { ...group(G1), deviceAndAppManagementAssignmentFilterId: 'filter-1', deviceAndAppManagementAssignmentFilterType: 'include' },
+      settings: { ...full, installTimeSettings: { useLocalTime: true, startDateTime: '2026-12-01T09:00:00Z', deadlineDateTime: null } } },
+    asSent(others[0]), asSent(others[1]),
+  ]);
+  // The other groups keep their in-use settings, dates and notifications; the exclusion keeps no settings.
+  expect(rows.find(row => (row.target as { groupId: string }).groupId === G2)!.settings).toMatchObject(others[0].settings as object);
+  expect(rows.find(row => (row.target as { groupId: string }).groupId === G3)!.settings).toBeNull();
+  expect(rows.filter(row => (row.target as { groupId: string }).groupId === G1).map(row => row.intent)).toEqual(['available']);
+});
+it('switches Available to Required and leaves out the Available-only auto-update setting', async () => {
+  rows[1] = { id: 'staff', intent: 'available', source: 'direct', target: group(G2), settings: { '@odata.type': SETTINGS, notifications: 'showAll', deliveryOptimizationPriority: 'notConfigured', installTimeSettings: null, autoUpdateSettings: { '@odata.type': '#microsoft.graph.win32LobAppAutoUpdateSettings', autoUpdateSupersededAppsState: 'enabled' } } };
+  const r = await review({ change: 'switch', assignmentId: 'staff', intent: 'required' });
+  expect(r.dropped).toEqual(['Automatic update of superseded versions (Available groups only)']);
+  expect((await json({ action: 'save', change: 'switch', assignmentId: 'staff', intent: 'required', token: r.token })).success).toBe(true);
+  expect(sent()[1]).toEqual({ '@odata.type': '#microsoft.graph.mobileAppAssignment', intent: 'required', target: group(G2), settings: { '@odata.type': SETTINGS, notifications: 'showAll', deliveryOptimizationPriority: 'notConfigured', installTimeSettings: null, autoUpdateSettings: null } });
+});
+it('keeps a group with no settings object without one, and a single group app works', async () => {
+  rows = [{ id: 'staff', intent: 'required', source: 'direct', target: group(G2), settings: null }];
+  const r = await review({ change: 'switch', assignmentId: 'staff', intent: 'available' });
+  expect(r.remaining).toEqual([]);
+  expect((await json({ action: 'save', change: 'switch', assignmentId: 'staff', intent: 'available', token: r.token })).success).toBe(true);
+  expect(sent()).toEqual([{ '@odata.type': '#microsoft.graph.mobileAppAssignment', intent: 'available', target: group(G2) }]);
+});
+it.each([
+  ['a setting IntuneGet does not know', 'staff', 'available', () => {}, 'cannot carry over'],
+  ['a malformed in-use setting', 'pilot', 'available', () => { (rows[0].settings as Record<string, unknown>).inUseSettings = { countdownMinutes: '10' }; }, 'cannot carry over'],
+  ['an unknown target field', 'pilot', 'available', () => { (rows[0].target as Record<string, unknown>).futureTarget = true; }, 'target settings'],
+  ['the intent it already has', 'pilot', 'required', () => {}, 'already Required'],
+  ['Available without enrollment', 'pilot', 'available', () => { rows[0].intent = 'availableWithoutEnrollment'; }, 'only be switched in Intune'],
+  ['an exclusion', 'excluded', 'available', () => {}, 'more computers'],
+])('will not switch a group with %s, and writes nothing', async (_name, id, intent, mutate, message) => {
+  mutate();
+  const r = await json({ action: 'review', change: 'switch', assignmentId: id, intent });
+  expect(r.status).toBe(409); expect(r.error).toContain(message);
+  expect((await json({ action: 'save', change: 'switch', assignmentId: id, intent, token: 'x' })).status).toBe(409);
+  expect(writes()).toEqual([]);
+});
+// The whole list is sent, so one group that cannot be sent back exactly stops the switch of another.
+it.each([
+  ['unknown settings', () => {}],
+  ['an inherited assignment', () => { rows[1] = { id: 'staff', intent: 'required', source: 'policySets', target: group(G2), settings: null }; }],
+  ['an unknown kind of target', () => { rows[1] = { id: 'staff', intent: 'required', source: 'direct', target: { '@odata.type': '#microsoft.graph.futureTarget' }, settings: null }; }],
+  ['a type IntuneGet does not know', () => { rows[1] = { id: 'staff', intent: 'futureIntent', source: 'direct', target: group(G2), settings: null }; }],
+])('will not switch a group while another group has %s', async (_name, mutate) => {
+  mutate();
+  const r = await json({ action: 'review', change: 'switch', assignmentId: 'pilot', intent: 'available' });
+  expect(r.status).toBe(409); expect(r.error).toContain('Another group on this app has settings IntuneGet cannot send back exactly');
+  expect(writes()).toEqual([]);
+});
+it.each(['uninstall', 'availableWithoutEnrollment', '', undefined])('refuses a switch to %s', async intent => {
+  expect((await json({ action: 'review', change: 'switch', assignmentId: 'pilot', intent })).status).toBe(400);
+});
+const plain = () => { rows[1] = { id: 'staff', intent: 'required', source: 'direct', target: group(G2), settings: { '@odata.type': SETTINGS, notifications: 'showAll', deliveryOptimizationPriority: 'notConfigured' } }; };
+it.each([400, 409, 500])('changes nothing when Intune refuses the save with %s, and says the group is still Required', async status => {
+  plain(); const before = structuredClone(rows);
+  const r = await review({ change: 'switch', assignmentId: 'pilot', intent: 'available' });
+  assignStatus = status;
+  const saved = await json({ action: 'save', change: 'switch', assignmentId: 'pilot', intent: 'available', token: r.token });
+  expect(saved.status).toBe(424); expect(saved.error).toBe('Intune did not accept the change. Nothing was changed; the group is still Required. Review again before retrying.');
+  expect(writes().map(c => c.method)).toEqual(['POST']);
+  expect(rows).toEqual(before);
+});
+it('reports a save Intune denied', async () => {
+  plain();
+  const r = await review({ change: 'switch', assignmentId: 'pilot', intent: 'available' });
+  assignStatus = 403;
+  const saved = await json({ action: 'save', change: 'switch', assignmentId: 'pilot', intent: 'available', token: r.token });
+  expect(saved.status).toBe(403); expect(saved.error).toContain('denied');
+});
+it('does not report success when Intune accepts the save but the groups read back unchanged', async () => {
+  plain();
+  const r = await review({ change: 'switch', assignmentId: 'pilot', intent: 'available' });
+  ignoreAssign = true;
+  const saved = await json({ action: 'save', change: 'switch', assignmentId: 'pilot', intent: 'available', token: r.token });
+  expect(saved.status).toBe(424); expect(saved.error).toContain('do not read back as expected');
+});
+it('does not report success when another group reads back differently after the save', async () => {
+  plain();
+  const r = await review({ change: 'switch', assignmentId: 'pilot', intent: 'available' });
+  mangleAssign = true;
+  const saved = await json({ action: 'save', change: 'switch', assignmentId: 'pilot', intent: 'available', token: r.token });
+  expect(saved.status).toBe(424); expect(saved.error).toContain('do not read back as expected');
+});
+it.each([
+  ['the group being switched', () => { (rows[0].settings as Record<string, unknown>).notifications = 'hideAll'; }],
+  ['another group', () => { (rows[1].settings as Record<string, unknown>).notifications = 'hideAll'; }],
+  ['a group added by someone else', () => { rows.push({ id: 'late', intent: 'available', source: 'direct', target: { '@odata.type': '#microsoft.graph.allLicensedUsersAssignmentTarget' }, settings: null }); }],
+  ['a group removed by someone else', () => { rows = rows.filter(r => r.id !== 'excluded'); }],
+  ['the app version', () => { version = '1.3'; }],
+])('refuses the save when %s changed in Intune after the review, and writes nothing', async (_name, mutate) => {
+  plain();
+  const r = await review({ change: 'switch', assignmentId: 'pilot', intent: 'available' });
+  mutate();
+  const saved = await json({ action: 'save', change: 'switch', assignmentId: 'pilot', intent: 'available', token: r.token });
+  expect(saved.status).toBe(409); expect(saved.error).toBe('The app or its groups changed. Review the change again.');
+  expect(writes()).toEqual([]);
+});
+it('finishes a group that is somehow both by leaving out only its old assignment', async () => {
+  plain();
+  rows.push({ id: 'pilot-available', intent: 'available', source: 'direct', target: structuredClone(rows[0].target), settings: { '@odata.type': SETTINGS, notifications: 'showAll', deliveryOptimizationPriority: 'notConfigured' } });
+  const r = await review({ change: 'switch', assignmentId: 'pilot', intent: 'available' });
+  expect(r.alreadyBoth).toBe(true); expect(r.kept).toEqual([]);
+  expect((await json({ action: 'save', change: 'switch', assignmentId: 'pilot', intent: 'available', token: r.token })).success).toBe(true);
+  expect(sent()).toHaveLength(3);
+  expect(rows.filter(row => (row.target as { groupId: string }).groupId === G1).map(row => row.intent)).toEqual(['available']);
+});
+it('does not treat the same group with a different filter as the same assignment', async () => {
+  plain();
+  rows.push({ id: 'other-filter', intent: 'available', source: 'direct', target: { ...group(G1), deviceAndAppManagementAssignmentFilterId: 'filter-2', deviceAndAppManagementAssignmentFilterType: 'include' }, settings: null });
+  const r = await review({ change: 'switch', assignmentId: 'pilot', intent: 'available' });
+  expect(r.alreadyBoth).toBe(false);
+});
+it('treats a switch retried after it finished as done and writes nothing', async () => {
+  plain();
+  const r = await review({ change: 'switch', assignmentId: 'pilot', intent: 'available' });
+  await json({ action: 'save', change: 'switch', assignmentId: 'pilot', intent: 'available', token: r.token });
+  calls = [];
+  expect(await json({ action: 'save', change: 'switch', assignmentId: 'pilot', intent: 'available', token: r.token })).toMatchObject({ success: true, alreadyDone: true });
+  expect(writes()).toEqual([]);
+  expect(rows.filter(row => (row.target as { groupId: string }).groupId === G1)).toHaveLength(1);
+});
+it('switches back to Required and the group reads as it did, apart from the deadline it lost', async () => {
+  plain();
+  const first = await review({ change: 'switch', assignmentId: 'pilot', intent: 'available' });
+  await json({ action: 'save', change: 'switch', assignmentId: 'pilot', intent: 'available', token: first.token });
+  const id = rows.find(row => (row.target as { groupId: string }).groupId === G1)!.id;
+  const back = await review({ change: 'switch', assignmentId: id, intent: 'required' });
+  expect(back.dropped).toEqual([]);
+  expect((await json({ action: 'save', change: 'switch', assignmentId: id, intent: 'required', token: back.token })).success).toBe(true);
+  const pilot = rows.find(row => (row.target as { groupId: string }).groupId === G1)!;
+  expect(pilot.intent).toBe('required');
+  expect(pilot.settings).toMatchObject({ ...full, installTimeSettings: { useLocalTime: true, startDateTime: '2026-12-01T09:00:00Z', deadlineDateTime: null } });
+});
+
+// ---- Both ----
+it.each(['remove', 'switch'])('holds %s while the app is being retired or piloted', async change => {
+  state.sqlite = true; state.retiring = true;
+  expect((await json({ action: 'review', change, assignmentId: 'pilot', intent: 'available' })).error).toContain('being retired');
+  state.retiring = false; state.pilot = true;
+  expect((await json({ action: 'review', change, assignmentId: 'pilot', intent: 'available' })).error).toContain('active pilot');
+  expect(writes()).toEqual([]);
+});
+it.each([[{ change: 'delete-all', assignmentId: 'pilot' }], [{ change: 'remove' }], [{ change: 'remove', assignmentId: '' }], [{ change: 'remove', assignmentId: 'x'.repeat(201) }], [{ change: 'switch', assignmentId: 7, intent: 'available' }]])('rejects a malformed request %j', async body => {
+  expect((await json({ action: 'review', ...body })).status).toBe(400);
+  expect(calls).toEqual([]);
+});
+it('does not write when the group list cannot be read completely', async () => {
+  const impl = vi.mocked(fetch).getMockImplementation()!;
+  vi.mocked(fetch).mockImplementation(async (url, init) => String(url).endsWith('/assignments') && !init?.method ? Response.json({ value: rows, '@odata.nextLink': 'https://example.invalid/next' }) : impl(url, init));
+  expect((await json({ action: 'review', change: 'remove', assignmentId: 'pilot' })).status).toBe(424);
+  expect(writes()).toEqual([]);
