+import { describe, expect, it } from 'vitest';
+import { installs, leavesNoGroups, removeProblem, rowLabel, sameTarget, switchPlan, switchProblem, targetName } from '../group-edit';
+import type { GraphAssignment } from '../duplicates';
+
+const G = '20000000-0000-0000-0000-000000000001';
+const SETTINGS = '#microsoft.graph.win32LobAppAssignmentSettings';
+const row = (over: Partial<GraphAssignment> = {}): GraphAssignment => ({ id: 'a', intent: 'required', source: 'direct', target: { '@odata.type': '#microsoft.graph.groupAssignmentTarget', groupId: G }, settings: null, ...over });
+
+describe('group-edit', () => {
+  it('names targets and never invents a group name', () => {
+    expect(targetName(row(), { [G]: 'Pilot computers' })).toBe('Pilot computers');
+    expect(targetName(row())).toBe(`Group ${G}`);
+    expect(targetName(row({ target: { '@odata.type': '#microsoft.graph.allDevicesAssignmentTarget' } }))).toBe('All devices');
+    expect(targetName(row({ target: { '@odata.type': '#microsoft.graph.allLicensedUsersAssignmentTarget' } }))).toBe('All users');
+    // An exclusion is Excluded, never Required, whatever intent Intune stores for it.
+    expect(rowLabel(row({ target: { '@odata.type': '#microsoft.graph.exclusionGroupAssignmentTarget', groupId: G } }), { [G]: 'Kiosks' })).toBe('Kiosks · Excluded');
+    expect(rowLabel(row({ intent: 'available' }), { [G]: 'Pilot computers' })).toBe('Pilot computers · Available');
+  });
+  it('counts only groups that receive the app when guarding the last group', () => {
+    const exclusion = row({ id: 'x', target: { '@odata.type': '#microsoft.graph.exclusionGroupAssignmentTarget', groupId: G } });
+    const uninstall = row({ id: 'u', intent: 'uninstall' });
+    expect(installs(exclusion)).toBe(false); expect(installs(uninstall)).toBe(false);
+    expect(leavesNoGroups([row(), exclusion, uninstall], 'a')).toBe(true);
+    expect(leavesNoGroups([row(), row({ id: 'b', intent: 'available' })], 'a')).toBe(false);
+    expect(leavesNoGroups([row(), row({ id: 'b', intent: 'availableWithoutEnrollment' })], 'a')).toBe(false);
+  });
+  it('allows removal and switching only for plain direct groups', () => {
+    expect(removeProblem(row())).toBeNull(); expect(switchProblem(row())).toBeNull();
+    expect(removeProblem(row({ source: null as unknown as string }))).toBeNull();
+    expect(removeProblem(row({ id: undefined }))).toContain('ID');
+    expect(removeProblem(row({ source: 'policySets' }))).toContain('another assignment');
+    expect(removeProblem(row({ intent: 'availableWithoutEnrollment' }))).toBeNull();
+    expect(switchProblem(row({ intent: 'availableWithoutEnrollment' }))).toContain('switched in Intune');
+    expect(switchProblem(row({ settings: { '@odata.type': '#microsoft.graph.iosStoreAppAssignmentSettings' } }))).toContain('cannot carry over');
+    expect(switchProblem(row({ settings: { '@odata.type': SETTINGS, notifications: 'loud' } }))).toContain('cannot carry over');
+  });
+  it('compares targets by kind, group and filter, ignoring case and an empty filter', () => {
+    expect(sameTarget(row(), row({ target: { '@odata.type': '#microsoft.graph.groupAssignmentTarget', groupId: G.toUpperCase(), deviceAndAppManagementAssignmentFilterId: null, deviceAndAppManagementAssignmentFilterType: 'none' } }))).toBe(true);
+    expect(sameTarget(row(), row({ target: { '@odata.type': '#microsoft.graph.groupAssignmentTarget', groupId: G, deviceAndAppManagementAssignmentFilterId: 'f', deviceAndAppManagementAssignmentFilterType: 'include' } }))).toBe(false);
+    expect(sameTarget(row(), row({ target: { '@odata.type': '#microsoft.graph.allDevicesAssignmentTarget' } }))).toBe(false);
+  });
+  it('drops a deadline when switching to Available and clears timing that would be empty', () => {
+    const onlyDeadline = switchPlan(row({ settings: { '@odata.type': SETTINGS, installTimeSettings: { useLocalTime: false, startDateTime: null, deadlineDateTime: '2026-12-05T17:00:00Z' } } }), 'available');
+    expect((onlyDeadline.body.settings as Record<string, unknown>).installTimeSettings).toBeNull();
+    expect(onlyDeadline.dropped).toHaveLength(1);
+    expect(onlyDeadline.kept).not.toContain('Available from');
+  });
+  it('keeps both dates when switching to Required is impossible to lose: Available rows have no deadline to begin with', () => {
+    const plan = switchPlan(row({ intent: 'available', settings: { '@odata.type': SETTINGS, installTimeSettings: { useLocalTime: true, startDateTime: '2026-12-01T09:00:00Z', deadlineDateTime: null } } }), 'required');
+    expect((plan.body.settings as Record<string, unknown>).installTimeSettings).toEqual({ useLocalTime: true, startDateTime: '2026-12-01T09:00:00Z', deadlineDateTime: null });
+    expect(plan.kept).toContain('Available from'); expect(plan.dropped).toEqual([]);
+  });
+  it('does not add setting keys the old row did not have, and does not change the old row', () => {
+    const old = row({ settings: { '@odata.type': SETTINGS, notifications: 'hideAll' } });
+    const copy = structuredClone(old);
+    const plan = switchPlan(old, 'available');
+    expect(plan.body.settings).toEqual({ '@odata.type': SETTINGS, notifications: 'hideAll', deliveryOptimizationPriority: 'notConfigured' });
+    expect(old).toEqual(copy);
+  });
+  it('throws instead of planning a switch it cannot do exactly', () => {
+    expect(() => switchPlan(row(), 'required')).toThrow('already Required');
+    expect(() => switchPlan(row({ settings: { '@odata.type': SETTINGS, mystery: 1 } }), 'available')).toThrow('cannot carry over');
+  });
+});
diff --git a/lib/hrm/deploy-dates.ts b/lib/hrm/deploy-dates.ts
new file mode 100644
index 000000000..a9fd68ecc
--- /dev/null
+++ b/lib/hrm/deploy-dates.ts
@@ -0,0 +1,68 @@
+/**
+ * Install dates in the deploy form: Available from, Must install by, time zone and restart grace
+ * period for the groups of a new deployment. Browser-safe. The rules are the shared ones in
+ * packager/src/assignment-settings.ts (the same as the Install dates panel), so the form, the
+ * server, the local packager and the hosted workflow accept and refuse the same input.
+ */
+import { deployTimingProblem, restartGraceSupported } from '@/packager/src/assignment-settings';
+import type { PackageAssignment } from '@/types/upload';
+
+export type DeployDatesPath = 'github' | 'local' | 'unavailable' | 'unknown';
+/** Whether this server's packaging applies the dates. The hosted workflow needs the operator's attestation. */
+export const deployDatesAvailable = (path: DeployDatesPath, attested: boolean) => path === 'local' || (path === 'github' && attested);
+/** The local packager always suppresses restarts, so it never has a grace period. */
+export const deployGraceSupported = (path: DeployDatesPath, psadtRestartBehavior: unknown) => path === 'github' && restartGraceSupported(psadtRestartBehavior);
+export const hasDeployDates = (a: unknown) => !!a && typeof a === 'object' && ((a as PackageAssignment).installTimeSettings != null || (a as PackageAssignment).restartSettings != null);
+/** Groups that can have dates at all: included targets that are Required or Available. */
+export const canHaveDeployDates = (a: PackageAssignment) => a.type !== 'exclusionGroup' && (a.intent === 'required' || a.intent === 'available');
+
+/** What the deploy form needs to know to offer install dates. */
+export interface DeployDatesForm { available: boolean; graceSupported: boolean; graceNote?: string; note?: string }
+export const DEPLOY_DATES_AFTERWARDS = 'Groups start as soon as possible. To set dates, deploy first, then use Install dates in the app workspace.';
+export const DEPLOY_GRACE_NOTE_HOSTED = 'A grace period needs this deployment to restart on the installer result or by force. Under App handling and restart, set Restart handling in Intune to Use installer return codes or Force an Intune restart first.';
+export const DEPLOY_GRACE_NOTE_LOCAL = 'This server packages apps so that Intune never restarts the computer, so a grace period does not apply.';
+/** The form's settings for one Win32 deployment, from the server's packaging capabilities. */
+export function deployDatesForm(capabilities: { path: DeployDatesPath; deployDates: boolean }, psadtRestartBehavior: unknown): DeployDatesForm {
+  return { available: capabilities.deployDates, graceSupported: deployGraceSupported(capabilities.path, psadtRestartBehavior),
+    graceNote: capabilities.path === 'local' ? DEPLOY_GRACE_NOTE_LOCAL : DEPLOY_GRACE_NOTE_HOSTED, note: DEPLOY_DATES_AFTERWARDS };
+}
+/** Why one group's dates cannot be deployed as entered, or null. The server applies the same rules. */
+export function deployFormProblem(a: PackageAssignment, form: DeployDatesForm): string | null {
+  if (!hasDeployDates(a)) return null;
+  if (!form.available) return 'This server cannot apply install dates during a deployment. Remove the dates, deploy, then set them with Install dates in the app workspace.';
+  return deployTimingProblem(a, form.graceSupported);
+}
+/** Every problem in the form, named by group, for blocking Add to cart and Save. */
+export function deployFormProblems(assignments: PackageAssignment[] | undefined, form: DeployDatesForm | undefined): string[] {
+  if (!form) return (assignments ?? []).some(hasDeployDates) ? ['Install dates can be set for Win32 apps only. Remove the dates.'] : [];
+  return (assignments ?? []).flatMap(a => { const problem = deployFormProblem(a, form); return problem ? [`${name(a)}: ${problem}`] : []; });
+}
+
+const name = (a: PackageAssignment) => a.type === 'allDevices' ? 'All devices' : a.type === 'allUsers' ? 'All users' : a.groupName || 'A group';
+export function deployDateProblems(assignments: unknown, graceSupported: boolean): string[] {
+  if (!Array.isArray(assignments)) return [];
+  return assignments.flatMap(a => { const problem = deployTimingProblem(a, graceSupported); return problem ? [`${name(a as PackageAssignment)}: ${problem}`] : []; });
+}
+/** Dates belong to one deployment. A saved configuration that is reused later never carries them. */
+export function stripDeployDates<T>(assignment: T): T {
+  if (!assignment || typeof assignment !== 'object') return assignment;
+  const { installTimeSettings: _time, restartSettings: _restart, ...rest } = assignment as Record<string, unknown>;
+  return rest as T;
+}
+/** Keep dates only where they are allowed, for example after an intent change in the form. */
+export function fitDeployDates(a: PackageAssignment): PackageAssignment {
+  if (!hasDeployDates(a)) return a;
+  if (!canHaveDeployDates(a)) return stripDeployDates(a);
+  if (a.intent !== 'required' && a.installTimeSettings?.deadlineDateTime) return { ...a, installTimeSettings: { ...a.installTimeSettings, deadlineDateTime: null } };
+  return a;
+}
+const clock = (value: string, local: boolean) => `${new Date(value).toLocaleString('en-US', { timeZone: 'UTC', month: 'short', day: 'numeric', year: 'numeric', hour: 'numeric', minute: '2-digit' })}${local ? '' : ' UTC'}`;
+/** One short phrase for the deploy review, or '' when the group starts as soon as possible. */
+export function describeDeployDates(a: PackageAssignment): string {
+  const t = a.installTimeSettings, parts: string[] = [];
+  if (t?.startDateTime) parts.push(`available from ${clock(t.startDateTime, t.useLocalTime)}`);
+  if (t?.deadlineDateTime) parts.push(`must install by ${clock(t.deadlineDateTime, t.useLocalTime)}`);
+  if (parts.length && t?.useLocalTime) parts.push("each computer's own clock");
+  if (a.restartSettings) parts.push('restart grace period');
+  return parts.join(', ');
+}
diff --git a/lib/hrm/group-edit.ts b/lib/hrm/group-edit.ts
new file mode 100644
index 000000000..eded9d821
--- /dev/null
+++ b/lib/hrm/group-edit.ts
@@ -0,0 +1,115 @@
+/**
+ * Edit groups: what one change to an existing Win32 app's groups may do. Pure functions, shared by
+ * the panel and the server. Adding a group posts one assignment and removing a group deletes one;
+ * neither sends the other groups. Switching Required and Available saves the whole list once with
+ * Intune's assign action, every other group exactly as read, because Intune refuses the same
+ * group as Required and Available together.
+ */
+import { preservedAssignmentSettings, asObject, canonical, type PlainRecord } from '@/packager/src/assignment-settings';
+import type { GraphAssignment } from './duplicates';
+
+export const EDIT_GROUPS = 'Edit groups';
+export type GroupChange = 'add' | 'remove' | 'switch';
+export type SwitchIntent = 'required' | 'available';
+
+const TARGETS: Record<string, string> = {
+  '#microsoft.graph.groupAssignmentTarget': 'group',
+  '#microsoft.graph.allDevicesAssignmentTarget': 'allDevices',
+  '#microsoft.graph.allLicensedUsersAssignmentTarget': 'allUsers',
+};
+const TARGET_KEYS = ['@odata.type', 'groupId', 'deviceAndAppManagementAssignmentFilterId', 'deviceAndAppManagementAssignmentFilterType'];
+const INTENT: Record<string, string> = { required: 'Required', available: 'Available', availableWithoutEnrollment: 'Available without enrollment', uninstall: 'Uninstall' };
+export const intentLabel = (intent: string) => INTENT[intent] ?? intent;
+
+/** Counts as a group that receives the app (same rule as Inventory's "no groups" warning). */
+export const installs = (row: GraphAssignment) => !String(row.target?.['@odata.type']).includes('exclusionGroup') && ['required', 'available', 'availableWithoutEnrollment'].includes(row.intent);
+
+export function targetName(row: GraphAssignment, names: Record<string, string> = {}): string {
+  const type = String(row.target?.['@odata.type'] ?? '');
+  if (type.includes('allDevices')) return 'All devices';
+  if (type.includes('allLicensedUsers')) return 'All users';
+  const id = typeof row.target?.groupId === 'string' ? row.target.groupId.toLowerCase() : '';
+  const name = id ? names[id] || `Group ${id}` : 'Unknown target';
+  return name;
+}
+export const isExclusion = (row: GraphAssignment) => String(row.target?.['@odata.type'] ?? '').includes('exclusionGroup');
+/** What a row's type is called on screen. An exclusion is Excluded, whatever intent Intune stores for it. */
+export const typeLabel = (row: GraphAssignment) => isExclusion(row) ? 'Excluded' : intentLabel(row.intent);
+/** "Kiosk computers · Excluded", "Pilot computers · Required". */
+export const rowLabel = (row: GraphAssignment, names: Record<string, string> = {}) => `${targetName(row, names)} · ${typeLabel(row)}`;
+
+/** Why a row cannot be changed here, or null when it can. Unknown shapes are never guessed at. */
+export function removeProblem(row: GraphAssignment): string | null {
+  if (typeof row.id !== 'string' || !row.id) return 'Intune did not give this group an ID. Change it in Intune.';
+  if (row.source != null && row.source !== 'direct') return 'This group comes from another assignment. Change it in Intune.';
+  const type = String(row.target?.['@odata.type'] ?? '');
+  if (type.includes('exclusionGroup')) return 'Removing an exclusion would give the app to more computers. Change it in Intune.';
+  if (!TARGETS[type]) return 'This kind of target can only be changed in Intune.';
+  if (!['required', 'available', 'availableWithoutEnrollment'].includes(row.intent)) return `${intentLabel(row.intent)} groups can only be changed in Intune.`;
+  return null;
+}
+export function switchProblem(row: GraphAssignment): string | null {
+  const problem = removeProblem(row);
+  if (problem) return problem;
+  if (row.intent !== 'required' && row.intent !== 'available') return `${intentLabel(row.intent)} groups can only be switched in Intune.`;
+  if (Object.keys(asObject(row.target)).some(key => !TARGET_KEYS.includes(key))) return 'This group has target settings IntuneGet does not know. Switch it in Intune.';
+  try { if (row.settings != null) preservedAssignmentSettings(row.settings); }
+  catch { return 'This group has settings IntuneGet cannot carry over. Switch it in Intune.'; }
+  return null;
+}
+
+/** The same target: kind, group and filter. Intent is compared separately. */
+export function sameTarget(a: GraphAssignment, b: GraphAssignment): boolean {
+  const key = (row: GraphAssignment) => {
+    const t = asObject(row.target);
+    return canonical([t['@odata.type'], typeof t.groupId === 'string' ? t.groupId.toLowerCase() : null, t.deviceAndAppManagementAssignmentFilterId || null, !t.deviceAndAppManagementAssignmentFilterId || t.deviceAndAppManagementAssignmentFilterType === 'none' ? null : t.deviceAndAppManagementAssignmentFilterType]);
+  };
+  return key(a) === key(b);
+}
+
+export interface SwitchPlan { body: PlainRecord; kept: string[]; dropped: string[] }
+/**
+ * The row Intune gets when a group switches intent. Settings pass the same allowlist a replacement
+ * uses (preservedAssignmentSettings), so an unknown or malformed setting stops the switch instead of
+ * being dropped silently. Only what the new intent cannot hold is left out, and it is named.
+ */
+export function switchPlan(row: GraphAssignment, to: SwitchIntent): SwitchPlan {
+  const problem = switchProblem(row);
+  if (problem) throw new Error(problem);
+  if (row.intent === to) throw new Error(`This group is already ${intentLabel(to)}.`);
+  const target: PlainRecord = {};
+  for (const key of TARGET_KEYS) if (Object.hasOwn(row.target, key)) target[key] = row.target[key];
+  const kept: string[] = [], dropped: string[] = [];
+  if (target.deviceAndAppManagementAssignmentFilterId) kept.push('Filter');
+  const body: PlainRecord = { '@odata.type': '#microsoft.graph.mobileAppAssignment', intent: to, target };
+  if (row.settings != null) {
+    const had = asObject(row.settings);
+    const settings = preservedAssignmentSettings(row.settings);
+    kept.push('Notifications', 'Download priority');
+    const timing = settings.installTimeSettings == null ? null : { ...asObject(settings.installTimeSettings) };
+    if (timing) {
+      if (to === 'available' && timing.deadlineDateTime != null) { timing.deadlineDateTime = null; dropped.push('Must install by (Available groups have no deadline)'); }
+      if (timing.startDateTime != null) kept.push('Available from');
+      if (to === 'required' && timing.deadlineDateTime != null) kept.push('Must install by');
+      settings.installTimeSettings = timing.startDateTime == null && timing.deadlineDateTime == null ? null : timing;
+    }
+    if (settings.restartSettings != null) kept.push('Restart grace period');
+    if (settings.inUseSettings != null) kept.push('App in use settings');
+    if (settings.autoUpdateSettings != null) {
+      if (to === 'required') { settings.autoUpdateSettings = null; dropped.push('Automatic update of superseded versions (Available groups only)'); }
+      else kept.push('Automatic update of superseded versions');
+    }
+    // Keep absent keys absent: write only what the old row had, plus the two defaults Intune fills in.
+    for (const key of ['installTimeSettings', 'restartSettings', 'autoUpdateSettings', 'inUseSettings']) if (!Object.hasOwn(had, key)) delete settings[key];
+    body.settings = settings;
+  }
+  return { body, kept, dropped };
+}
+
+/** True when taking this row away leaves no group that receives the app. */
+export function leavesNoGroups(rows: GraphAssignment[], removeId: string): boolean {
+  return !rows.some(row => row.id !== removeId && installs(row));
+}
+
+/** A stable fingerprint of one row, for review tokens: any change to it invalidates the review. */
+export const rowKey = (row: GraphAssignment) => canonical({ id: row.id ?? null, intent: row.intent, source: row.source ?? null, target: row.target, settings: row.settings ?? null });
