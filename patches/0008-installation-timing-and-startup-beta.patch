+'use client';
+import Link from 'next/link';
+import { useEffect, useState } from 'react';
+import { AppIcon } from '@/components/AppIcon';
+import { useUpdateSchedule } from '@/hooks/useUpdateSchedule';
+import { usePilots } from '@/hooks/usePilots';
+import { useInventoryIcon, useAppDetails } from '@/hooks/use-inventory';
+import { useAppInsights } from '@/hooks/useAppInsights';
+import { useDeployedConfig } from '@/hooks/use-deployed-config';
+import { useUpdatePolicies } from '@/hooks/use-updates';
+import { useInstallationPolicy } from '@/hooks/useInstallationPolicy';
+import { useMspOptional } from '@/hooks/useMspOptional';
+import { useMicrosoftAuth } from '@/hooks/useMicrosoftAuth';
+import { installationPolicySummary } from '@/lib/hrm/installation-policy';
+import { effectiveInstallationRule, savedInstallationSummary } from '@/lib/hrm/rollout-workspace';
+import type { AppUpdatePolicy } from '@/types/update-policies';
+import { LatestAppAttempt } from "./LatestAppAttempt";
+import { EditAssignments } from "./EditAssignments";
+import { AppTimingPanel } from './AppTimingPanel';
+import { AppGroupsLine } from './AppGroupsLine';
+import { InstallStatusBar } from './InstallStatusBar';
+import { PreviousCopyNote } from './PreviousCopy';
+import { AppActivityTimeline } from './AppInsights';
+import { InstallationPolicyPanel } from './InstallationPolicyPanel';
+import { Button } from '@/components/ui/button';
+import { Term } from './Term';
+
+const section = 'rounded-xl border border-overlay/10 bg-bg-surface p-5 sm:p-6 space-y-4';
+export function AppWorkspace({ appId }: { appId: string }) {
+  const details = useAppDetails(appId);
+  const insights = useAppInsights(appId);
+  const { account } = useMicrosoftAuth();
+  const { isMspUser, selectedTenantId } = useMspOptional();
+  const ownTenant = !isMspUser || !selectedTenantId || selectedTenantId === account?.tenantId;
