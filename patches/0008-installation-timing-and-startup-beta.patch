+// Install dates from the deploy form, through the local packager's own conversion to Intune
+// assignments. Fake groups only; nothing is sent anywhere.
+import { expect, it } from 'vitest';
+import type { PackagerConfig } from '../src/config';
+import { IntuneUploader } from '../src/intune-uploader';
+import type { PackagingJob } from '../src/job-poller';
+
+const uploader = new IntuneUploader({ azure: { clientId: 'fixture', useManagedIdentity: false } } as PackagerConfig) as unknown as {
+  extractExplicitAssignments(job: PackagingJob): unknown[]; toGraphAssignments(assignments: unknown[]): { intent: string; settings?: Record<string, unknown> }[];
+};
+const convert = (assignments: unknown[]) => uploader.toGraphAssignments(uploader.extractExplicitAssignments({ package_config: { assignments } } as unknown as PackagingJob));
+const time = { useLocalTime: true, startDateTime: '2026-12-01T09:00:00Z', deadlineDateTime: '2026-12-05T17:00:00Z' };
+const grace = { gracePeriodInMinutes: 1440, countdownDisplayBeforeRestartInMinutes: 15, restartNotificationSnoozeDurationInMinutes: 240 };
+const plain = { '@odata.type': '#microsoft.graph.win32LobAppAssignmentSettings', notifications: 'showAll', deliveryOptimizationPriority: 'notConfigured' };
+
+it('adds install dates only to the group that has them and leaves the others exactly as before', () => {
+  const rows = convert([
+    { type: 'group', groupId: 'fake-a', intent: 'required', installTimeSettings: time },
+    { type: 'group', groupId: 'fake-b', intent: 'required', notifications: 'hideAll', filterId: 'filter-1', filterType: 'exclude' },
+    { type: 'allUsers', intent: 'available', installTimeSettings: { useLocalTime: false, startDateTime: '2026-12-01T09:00:00Z', deadlineDateTime: null } },
+    { type: 'group', groupId: 'fake-c', intent: 'required', installTimeSettings: { useLocalTime: true, startDateTime: null, deadlineDateTime: null }, restartSettings: null },
+    { type: 'exclusionGroup', groupId: 'fake-d', intent: 'required' },
+  ]);
+  expect(rows[0].settings).toEqual({ ...plain, installTimeSettings: time });
+  expect(rows[1]).toEqual({ '@odata.type': '#microsoft.graph.mobileAppAssignment', intent: 'required', target: { '@odata.type': '#microsoft.graph.groupAssignmentTarget', groupId: 'fake-b', deviceAndAppManagementAssignmentFilterId: 'filter-1', deviceAndAppManagementAssignmentFilterType: 'exclude' }, settings: { ...plain, notifications: 'hideAll' } });
+  expect(rows[2].settings).toEqual({ ...plain, installTimeSettings: { useLocalTime: false, startDateTime: '2026-12-01T09:00:00Z', deadlineDateTime: null } });
+  // Both dates blank is as soon as possible: nothing about timing is sent.
+  expect(rows[3].settings).toEqual(plain);
+  expect(rows[4]).not.toHaveProperty('settings');
+});
+it.each([
+  ['a restart grace period, because this packager never lets Intune restart', [{ type: 'group', groupId: 'fake-a', intent: 'required', restartSettings: grace }], 'restart grace period needs'],
+  ['a deadline before availability', [{ type: 'group', groupId: 'fake-a', intent: 'required', installTimeSettings: { ...time, deadlineDateTime: '2026-11-30T09:00:00Z' } }], 'at or after availability'],
+  ['a deadline on Available', [{ type: 'allUsers', intent: 'available', installTimeSettings: time }], 'Only Required groups'],
+  ['dates on Update only', [{ type: 'group', groupId: 'fake-a', intent: 'updateOnly', installTimeSettings: time }], 'Only Required and Available'],
+  ['dates on an exclusion', [{ type: 'exclusionGroup', groupId: 'fake-a', intent: 'required', installTimeSettings: time }], 'Excluded groups'],
+  ['a malformed date in the second group', [{ type: 'group', groupId: 'fake-a', intent: 'required' }, { type: 'group', groupId: 'fake-b', intent: 'required', installTimeSettings: { ...time, startDateTime: '2026-12-01 09:00' } }], 'Enter valid Available from'],
+])('assigns no group at all for %s', (_name, assignments, message) => {
+  expect(() => convert(assignments)).toThrow(message);
+});
