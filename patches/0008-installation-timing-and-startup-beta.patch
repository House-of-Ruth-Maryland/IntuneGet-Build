index 000000000..32080a7c0
--- /dev/null
+++ b/app/api/cron/collect-startup-installations/route.ts
@@ -0,0 +1,12 @@
+import { NextResponse } from 'next/server';
+import { isSqliteMode } from '@/lib/db';
+import { GUID } from '@/lib/hrm/startup-report';
+export const maxDuration = 300;
+export async function GET(request: Request) {
+  if (!process.env.CRON_SECRET || request.headers.get('authorization') !== `Bearer ${process.env.CRON_SECRET}`) return NextResponse.json({ error: 'Unauthorized' }, { status: 401 });
+  if (!isSqliteMode() || !GUID.test(process.env.HRM_STARTUP_REPORT_SCRIPT_ID ?? '')) return NextResponse.json({ skipped: true });
+  const { sqliteStartupReports: store } = await import('@/lib/db/sqlite');
+  const { refreshStartupReport } = await import('@/lib/hrm/startup-report-check');
+  for (const tenant of store.tenants()) await refreshStartupReport(tenant);
+  return NextResponse.json({ success: true });
+}
diff --git a/app/api/hrm/app-timing/route.test.ts b/app/api/hrm/app-timing/route.test.ts
new file mode 100644
index 000000000..325adf718
--- /dev/null
+++ b/app/api/hrm/app-timing/route.test.ts
@@ -0,0 +1,66 @@
+import { beforeEach, afterEach, describe, it, expect, vi } from 'vitest';
+import { NextRequest } from 'next/server';
+const state = vi.hoisted(() => ({ auth: true, hold: false, tenant: 'tenant', restart: 'basedOnReturnCode' }));
+vi.mock('@/lib/auth-utils', () => ({ parseAccessToken: async () => state.auth ? { tenantId: state.tenant, userId: 'staff' } : null }));
+vi.mock('@/lib/db', () => ({ isSqliteMode: () => true }));
+vi.mock('@/lib/supabase', () => ({ getServerClientOrNull: () => null }));
+vi.mock('@/lib/db/sqlite', () => ({ sqliteRetirements: { holdsApp: () => state.hold }, sqlitePilotRollouts: { holdsApp: () => false, active: () => false }, sqliteAppInsights: { family: () => null } }));
+vi.mock('@/lib/intune/graph-client', () => ({ getServicePrincipalToken: async () => 'fixture' }));
+import { GET, POST } from './route';
+const appId = '11111111-1111-4111-8111-111111111111';
+let rows: Array<Record<string, unknown>>, writes: Array<{ url: string; body: Record<string, unknown> }>, incomplete: boolean, failWrite: boolean;
+const get = (extra: Record<string, string> = {}) => GET(new NextRequest(`http://localhost/api/hrm/app-timing?appId=${appId}`, { headers: { Authorization: 'Bearer fixture', ...extra } }));
+const post = (body: unknown) => POST(new NextRequest('http://localhost/api/hrm/app-timing', { method: 'POST', headers: { Authorization: 'Bearer fixture' }, body: JSON.stringify(body) }));
+const edit = { installTimeSettings: { useLocalTime: true, startDateTime: '2026-12-01T18:00:00Z', deadlineDateTime: '2026-12-01T20:00:00Z' }, restartSettings: null };
+beforeEach(() => {
+  state.auth = true; state.hold = false; state.tenant = 'tenant'; state.restart = 'basedOnReturnCode'; incomplete = false; failWrite = false; writes = [];
+  rows = [{ id: 'assignment-1', intent: 'required', target: { '@odata.type': '#microsoft.graph.allDevicesAssignmentTarget', deviceAndAppManagementAssignmentFilterId: 'keep-filter' }, settings: { '@odata.type': '#microsoft.graph.win32LobAppAssignmentSettings', notifications: 'hideAll', deliveryOptimizationPriority: 'foreground', autoUpdateSettings: { enabled: true } } }];
+  vi.stubGlobal('fetch', vi.fn(async (url: string, init?: RequestInit) => {
+    if (init?.method === 'PATCH') { writes.push({ url, body: JSON.parse(String(init.body)) }); return Response.json({}, { status: failWrite ? 400 : 200 }); }
+    if (url.endsWith('/assignments')) return Response.json(incomplete ? { value: rows, '@odata.nextLink': 'https://other.invalid/groups' } : { value: rows });
+    return Response.json({ id: appId, '@odata.type': '#microsoft.graph.win32LobApp', displayName: 'Example app', displayVersion: '1.0', installExperience: { deviceRestartBehavior: state.restart } });
+  }));
+});
+afterEach(() => vi.unstubAllGlobals());
+async function review() { const response = await get(); expect(response.status).toBe(200); return (await response.json()).rows[0]; }
+describe('edit live assignment timing', () => {
+  it('reads current timing without writing and saves only the selected assignment settings', async () => {
+    const row = await review(); expect(writes).toEqual([]);
+    const response = await post({ appId, assignmentId: row.id, token: row.token, edit });
+    expect(response.status).toBe(200); expect(writes).toHaveLength(1);
+    expect(writes[0].url.endsWith('/assignments/assignment-1')).toBe(true);
+    expect(writes[0].body).toEqual({ '@odata.type': '#microsoft.graph.mobileAppAssignment', settings: { ...(rows[0].settings as object), ...edit } });
+    expect(writes[0].body).not.toHaveProperty('target'); expect(writes[0].body).not.toHaveProperty('intent');
+  });
+  it('rejects stale settings, changed restart policies and cross-tenant review tokens', async () => {
+    const row = await review(); rows[0].intent = 'available';
+    expect((await post({ appId, assignmentId: row.id, token: row.token, edit })).status).toBe(409);
+    rows[0].intent = 'required'; state.restart = 'suppress';
+    expect((await post({ appId, assignmentId: row.id, token: row.token, edit })).status).toBe(409);
+    state.restart = 'basedOnReturnCode'; state.tenant = 'other';
+    expect((await post({ appId, assignmentId: row.id, token: row.token, edit })).status).toBe(409); expect(writes).toEqual([]);
+  });
+  it('rejects incomplete live reads, even when the selected assignment was on the first page', async () => {
+    const row = await review(); incomplete = true;
+    expect((await post({ appId, assignmentId: row.id, token: row.token, edit })).status).toBe(424); expect(writes).toEqual([]);
+  });
+  it('checks sign-in, tenant override and retirement holds', async () => {
+    state.auth = false; expect((await get()).status).toBe(401); expect((await post({ appId })).status).toBe(401);
+    state.auth = true; expect((await get({ 'X-MSP-Tenant-Id': 'other' })).status).toBe(403);
+    state.hold = true; expect((await get()).status).toBe(409); expect(writes).toEqual([]);
+  });
+  it('refuses invalid dates and unsupported restarts before mutation', async () => {
+    state.restart = 'suppress'; const row = await review();
+    expect((await post({ appId, assignmentId: row.id, token: row.token, edit: { ...edit, restartSettings: { gracePeriodInMinutes: 60, countdownDisplayBeforeRestartInMinutes: 15, restartNotificationSnoozeDurationInMinutes: 0 } } })).status).toBe(400);
+    expect((await post({ appId, assignmentId: row.id, token: row.token, edit: { ...edit, installTimeSettings: { ...edit.installTimeSettings, deadlineDateTime: 'yesterday' } } })).status).toBe(400);
+    expect(writes).toEqual([]);
+  });
+  it('reports a failed Graph write without claiming success', async () => {
+    const row = await review(); failWrite = true;
+    expect((await post({ appId, assignmentId: row.id, token: row.token, edit })).status).toBe(424);
+  });
+  it('leaves exclusions and uninstall assignments out of the editor', async () => {
+    rows[0].intent = 'uninstall'; expect((await (await get()).json()).rows).toEqual([]);
+    rows[0].intent = 'required'; rows[0].source = 'policySets'; expect((await (await get()).json()).rows).toEqual([]);
+  });
+});
diff --git a/app/api/hrm/app-timing/route.ts b/app/api/hrm/app-timing/route.ts
new file mode 100644
index 000000000..5be1da897
--- /dev/null
+++ b/app/api/hrm/app-timing/route.ts
@@ -0,0 +1,82 @@
+import { createHash } from 'node:crypto';
+import { NextRequest, NextResponse } from 'next/server';
+import { parseAccessToken } from '@/lib/auth-utils';
+import { isSqliteMode } from '@/lib/db';
+import { getServerClientOrNull } from '@/lib/supabase';
+import { resolveTargetTenantId } from '@/lib/msp/tenant-resolution';
+import { getServicePrincipalToken } from '@/lib/intune/graph-client';
+import { GUID, summarizeAssignments } from '@/lib/hrm/app-insights';
+import { pilotGraph, PilotError } from '@/lib/hrm/pilot-graph';
+import { applyTiming, readInstallTiming, record, timingEditable, timingProblem, type TimingEdit, type TimingRow } from '@/lib/hrm/app-timing';
+import type { GraphAssignment } from '@/lib/hrm/duplicates';
+export const maxDuration = 120;
+const BASE = 'https://graph.microsoft.com/beta';
+const reply = (body: unknown, status = 200) => NextResponse.json(body, { status, headers: { 'Cache-Control': 'private, no-store' } });
+const fingerprint = (tenant: string, app: unknown, row: GraphAssignment) => createHash('sha256').update(JSON.stringify([tenant, app, row.id, summarizeAssignments([row])])).digest('hex');
+async function handle(request: NextRequest, saving: boolean) {
+  try {
+    const user = await parseAccessToken(request.headers.get('Authorization'));
+    if (!user) return reply({ error: 'Authentication required' }, 401);
+    const body = saving ? await request.json().catch(() => null) : null;
+    const appId = saving ? body?.appId : new URL(request.url).searchParams.get('appId');
+    if (typeof appId !== 'string' || !GUID.test(appId)) return reply({ error: 'Invalid app' }, 400);
+    const supabase = getServerClientOrNull();
+    const requested = request.headers.get('X-MSP-Tenant-Id');
+    const resolution = supabase ? await resolveTargetTenantId({ supabase, userId: user.userId, tokenTenantId: user.tenantId, requestedTenantId: requested }) : { tenantId: user.tenantId, errorResponse: null };
+    if (resolution.errorResponse) return resolution.errorResponse;
+    const tenantId = resolution.tenantId;
+    if (!supabase && requested && requested !== user.tenantId) return reply({ error: 'Tenant access denied' }, 403);
+    const checkHold = async () => {
+      if (!isSqliteMode()) return;
+      const { sqliteRetirements: retire, sqlitePilotRollouts: pilots, sqliteAppInsights: insights } = await import('@/lib/db/sqlite');
+      const family = insights.family(tenantId, appId);
+      if (retire.holdsApp(tenantId, appId)) throw new PilotError('This app is being retired. Its timing cannot be changed.');
+      if (pilots.holdsApp(tenantId, appId) || (family && pilots.active(tenantId, family))) throw new PilotError('This app is part of an active pilot. Finish it in App updates first.');
+    };
+    await checkHold();
+    const token = await getServicePrincipalToken(tenantId);
+    if (!token) throw new PilotError('Could not reach Intune. Try again.', 424);
+    const graph = pilotGraph(token, fetch, "Couldn't read all of this app's groups from Intune. Press Reload dates, then try again.");
+    const [app, rows] = await Promise.all([graph.app(appId), graph.assignments(appId)]);
+    const restartBehavior = record(record(app).installExperience).deviceRestartBehavior;
+    const restartSupported = restartBehavior === 'basedOnReturnCode' || restartBehavior === 'force';
+    // Include the restart policy in the review, not unrelated app timestamps.
+    const identity = [app.id, app.displayVersion, restartBehavior];
+    if (!saving) {
+      const editable: TimingRow[] = rows.filter(r => timingEditable(r) && typeof r.id === 'string').map(row => {
+        const settings = record(row.settings);
+        return { id: row.id!, label: summarizeAssignments([{ ...row, settings: null }])[0].label.replace('Unknown target', row.target['@odata.type'] === '#microsoft.graph.allLicensedUsersAssignmentTarget' ? 'All users' : 'Unknown target'),
+          intent: row.intent, token: fingerprint(tenantId, identity, row), restartSupported,
+          installTimeSettings: readInstallTiming(settings.installTimeSettings),
+          restartSettings: (settings.restartSettings ?? null) as TimingEdit['restartSettings'] };
+      });
+      return reply({ rows: editable });
+    }
+    const row = rows.find(r => r.id === body?.assignmentId);
+    if (!row || !timingEditable(row)) throw new PilotError("This group's dates can't be changed here any more. Press Reload dates.");
+    if (body.token !== fingerprint(tenantId, identity, row)) throw new PilotError('The app or group changed after you opened it. Press Reload dates and check it again.');
+    const problem = timingProblem(body.edit, row.intent, restartSupported, record(row.settings).restartSettings ?? null);
+    if (problem) return reply({ error: problem }, 400);
+    await checkHold();
+    const settings = applyTiming(row, body.edit);
+    const response = await fetch(`${BASE}/deviceAppManagement/mobileApps/${appId}/assignments/${encodeURIComponent(row.id!)}`, {
+      method: 'PATCH', headers: { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json' },
+      body: JSON.stringify({ '@odata.type': '#microsoft.graph.mobileAppAssignment', settings }),
+      signal: AbortSignal.timeout(30000), cache: 'no-store',
+    });
+    if (!response.ok) throw new PilotError("Intune didn't confirm the change. Press Reload dates before trying again.", 424);
+    if (isSqliteMode()) {
+      try {
+        const { sqliteAppInsights: insights } = await import('@/lib/db/sqlite');
+        const family = insights.family(tenantId, appId);
+        if (family) insights.observe(tenantId, { appId, wingetId: family, displayName: app.displayName, version: app.displayVersion ?? '', exists: true,
+          assignments: summarizeAssignments(rows.map(r => r.id === row.id ? { ...r, settings } : r)), checkedAt: new Date().toISOString() }, `Availability and deadline saved by ${user.userEmail || 'a staff member'}`, true);
+      } catch { /* Optional activity must not hide a confirmed save. */ }
+    }
+    return reply({ success: true });
+  } catch (error) {
+    return reply({ error: error instanceof PilotError ? error.message : "Couldn't finish the change. Press Reload dates before trying again." }, error instanceof PilotError ? error.status : 424);
+  }
+}
+export const GET = (request: NextRequest) => handle(request, false);
+export const POST = (request: NextRequest) => handle(request, true);
