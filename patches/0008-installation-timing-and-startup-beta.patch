+import {beforeEach,expect,it,vi} from 'vitest';
+import {mkdtemp,rm} from 'node:fs/promises';
+import {tmpdir} from 'node:os';
+import {join} from 'node:path';
+const graph=vi.hoisted(()=>({get:vi.fn(),post:vi.fn()}));
+vi.mock('../src/graph-client',()=>({GraphClient:class {get=graph.get;post=graph.post}}));
+import {JobProcessor} from '../src/job-processor';
+import {IntuneUploader} from '../src/intune-uploader';
+import type {PackagerConfig} from '../src/config';
+import type {PackagingJob} from '../src/job-poller';
+import {assignmentSnapshot} from '../src/assignment-settings';
+const rows=[{id:'a',intent:'required',target:{'@odata.type':'#microsoft.graph.allDevicesAssignmentTarget'},settings:{installTimeSettings:{useLocalTime:false,deadlineDateTime:'2020-01-01T00:00:00Z'}}}];
+beforeEach(()=>{graph.get.mockReset().mockResolvedValue({value:rows});graph.post.mockReset()});
+it('stops the actual local processor before tools or installer download, including retry',async()=>{
+ const work=await mkdtemp(join(tmpdir(),'deadline-admission-'));
+ try{
+  const config={paths:{work,tools:work},azure:{clientId:'fixture',useManagedIdentity:false}} as PackagerConfig;
+  const processor=new JobProcessor(config,{updateJobProgress:vi.fn()} as never);vi.spyOn(processor as any,'packagingPlatform').mockReturnValue('win32');
+  const tools=vi.spyOn(processor as any,'ensureToolsAvailable').mockRejectedValue(Error('tools reached'));
+  const job={id:'held',tenant_id:'tenant',installer_type:'exe',package_config:{replacesIntuneAppId:'source'}} as unknown as PackagingJob;
+  await expect(processor.processJob(job)).rejects.toThrow('Paused for IT');await expect(processor.processJob(job)).rejects.toThrow('Paused for IT');expect(tools).not.toHaveBeenCalled();expect(graph.post).not.toHaveBeenCalled();
+  job.package_config={replacesIntuneAppId:'source',assignmentReview:{sourceAppId:'source',expected:assignmentSnapshot(rows),expiredDates:'keep',deadlineConfirmation:{decision:'retain',assignmentIds:['a']}}};
+  await expect(processor.processJob(job)).rejects.toThrow('tools reached');expect(tools).toHaveBeenCalledTimes(1);
+ }finally{await rm(work,{recursive:true,force:true})}
+});
+it('rechecks live source timing before applying explicit replacement groups',async()=>{
+ const uploader=new IntuneUploader({azure:{clientId:'fixture',useManagedIdentity:false}} as PackagerConfig);
+ const job={tenant_id:'tenant',package_config:{sourceIntuneAppId:'source',assignments:[{type:'group',intent:'required',groupId:'new-group'}]}} as unknown as PackagingJob;
+ await expect((uploader as any).applyAssignments(graph,'new-app',job)).rejects.toThrow('Paused for IT');expect(graph.post).not.toHaveBeenCalled();
+});
