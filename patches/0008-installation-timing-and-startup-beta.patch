+// Install dates for a new deployment: the TypeScript rules (app and local packager), the bundled
+// PowerShell (hosted workflow) and the Install dates panel's own validator must all agree.
+import { expect, it } from 'vitest';
+import { execFileSync, spawnSync } from 'node:child_process';
+import { mkdtempSync, readFileSync, rmSync, writeFileSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { resolve } from 'node:path';
+import { canonical, deployTimingProblem, deployTimingSettings } from '../src/assignment-settings';
+import { timingProblem } from '../../lib/hrm/app-timing';
+
+const pwsh = spawnSync('pwsh', ['-NoProfile', '-Command', '1'], { timeout: 30000 }).status === 0;
+const time = (startDateTime: unknown, deadlineDateTime: unknown, useLocalTime: unknown = true) => ({ useLocalTime, startDateTime, deadlineDateTime });
+const grace = (g: unknown, c: unknown, s: unknown) => ({ gracePeriodInMinutes: g, countdownDisplayBeforeRestartInMinutes: c, restartNotificationSnoozeDurationInMinutes: s });
+const A = '2026-12-01T09:00:00Z', B = '2026-12-05T17:00:00Z';
+interface Case { name: string; assignment: Record<string, unknown>; restartSupported: boolean }
+const cases: Case[] = [];
+const add = (name: string, assignment: Record<string, unknown>, restartSupported = true) => cases.push({ name, assignment: { type: 'group', groupId: 'fake-group', intent: 'required', ...assignment }, restartSupported });
+add('none/absent', {});
