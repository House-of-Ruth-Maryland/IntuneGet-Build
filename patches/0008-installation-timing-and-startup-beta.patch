+++ b/app/api/hrm/app-assignments/route.ts
@@ -0,0 +1,219 @@
+import { createHash } from 'node:crypto';
+import { NextRequest, NextResponse } from 'next/server';
+import { parseAccessToken } from '@/lib/auth-utils';
+import { getServerClientOrNull } from '@/lib/supabase';
+import { resolveTargetTenantId } from '@/lib/msp/tenant-resolution';
+import { hasPermission } from '@/lib/msp-permissions';
+import { getServicePrincipalToken } from '@/lib/intune/graph-client';
+import { GUID } from '@/lib/hrm/app-insights';
+import { isSqliteMode } from '@/lib/db';
+import { pilotGraph, PilotError } from '@/lib/hrm/pilot-graph';
+import { summarizeAssignments } from '@/lib/hrm/app-insights';
+import { intentLabel, leavesNoGroups, removeProblem, rowKey, rowLabel, sameTarget, switchPlan, switchProblem, targetName } from '@/lib/hrm/group-edit';
+import type { GraphAssignment } from '@/lib/hrm/duplicates';
+import { asObject, assignmentSnapshot, canonical, preservedAssignmentSettings, type PlainRecord } from '@/packager/src/assignment-settings';
+
+const reply = (body: unknown, status = 200) => NextResponse.json(body, { status, headers: { 'Cache-Control': 'private, no-store' } });
+// Serialize requests within this server. Never retry a POST automatically:
+// every new attempt rereads Intune and recognizes the existing group target.
+const saving = new Set<string>();
+export async function POST(request: NextRequest) {
+  let lock: string | undefined;
+  try {
+    const user = await parseAccessToken(request.headers.get('Authorization'));
+    if (!user) return reply({ error: 'Authentication required' }, 401);
+    const body = await request.json().catch(() => null);
+    // change: 'add' (the default, one new group), 'remove' (one group) or 'switch' (Required to Available or back).
+    const change = body?.change ?? 'add';
+    if (!body || !GUID.test(body.appId ?? '') || !['review', 'save'].includes(body.action) || !['add', 'remove', 'switch'].includes(change)) return reply({ error: 'Choose an app and a change to its groups.' }, 400);
+    if (change === 'add' && (!GUID.test(body.groupId ?? '') || !['required', 'available'].includes(body.intent))) return reply({ error: 'Choose an app, Entra security group and installation intent.' }, 400);
+    if (change !== 'add' && (typeof body.assignmentId !== 'string' || !body.assignmentId || body.assignmentId.length > 200)) return reply({ error: 'Choose the group to change.' }, 400);
+    if (change === 'switch' && !['required', 'available'].includes(body.intent)) return reply({ error: 'Choose Required or Available.' }, 400);
+    const supabase = getServerClientOrNull();
+    const requestedTenantId = request.headers.get('X-MSP-Tenant-Id');
+    const resolution = supabase ? await resolveTargetTenantId({ supabase, userId: user.userId, tokenTenantId: user.tenantId, requestedTenantId }) : { tenantId: user.tenantId, errorResponse: null };
