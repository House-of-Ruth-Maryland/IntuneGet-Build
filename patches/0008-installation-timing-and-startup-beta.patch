+'use client';
+// One place for the Intune words IntuneGet shows as they are. Each keeps Intune's own name on screen
+// and explains it on hover or keyboard focus, so screens do not invent a second name for it.
+import type { ReactNode } from 'react';
+import { Tooltip, TooltipContent, TooltipProvider, TooltipTrigger } from '@/components/ui/tooltip';
+
+export const INTUNE_TERMS = {
+  required: "Intune installs the app on the group's eligible computers without staff choosing it. The package may still let staff postpone.",
+  available: "The app is listed in Company Portal. Staff choose whether to install it.",
+  availableFrom: "Intune calls this availability. Required apps can start downloading from this date. Available apps appear in Company Portal from this date.",
+  mustInstallBy: "Intune calls this the installation deadline. A Required app installs at this time, or when a computer next connects after it. Blank means as soon as it is available.",
+  restartGrace: "Intune calls this the restart grace period. It gives staff time before Intune restarts the computer after an install. It cannot stop a restart the installer forces.",
+  autoUpdate: "Auto-update deploys each new version to Intune when the publishing window allows. Notify only lists it in App updates until you press Update. Ignore leaves the app out of App updates.",
+  postpone: "Staff can choose Install or Defer when the update starts. The prompt may be skipped when nobody is signed in. After the last allowed day, the next Intune attempt installs it.",
+} as const;
+export type IntuneTerm = keyof typeof INTUNE_TERMS;
+
+export function Term({ term, children }: { term: IntuneTerm; children: ReactNode }) {
+  return <TooltipProvider delayDuration={150}><Tooltip>
+    <TooltipTrigger asChild><span tabIndex={0} className="cursor-help rounded-sm underline decoration-dotted decoration-text-muted underline-offset-4 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-cyan">{children}</span></TooltipTrigger>
+    <TooltipContent className="max-w-72 border border-overlay/10 text-sm font-normal leading-relaxed">{INTUNE_TERMS[term]}</TooltipContent>
+  </Tooltip></TooltipProvider>;
+}
