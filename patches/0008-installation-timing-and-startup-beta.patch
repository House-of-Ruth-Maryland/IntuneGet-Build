+  expect(button('Save app exception').disabled).toBe(true);
+  await act(async () => button('Save app exception').click());
+  expect(state.mutate).not.toHaveBeenCalled();
+  const automatic = document.querySelector<HTMLInputElement>('input[value="silent"]')!;
+  await act(async () => automatic.click());
+  expect(button('Save app exception').disabled).toBe(false);
