diff --git a/lib/webhooks/install-failure-formatters.ts b/lib/webhooks/install-failure-formatters.ts
new file mode 100644
index 000000000..539d0f916
--- /dev/null
+++ b/lib/webhooks/install-failure-formatters.ts
@@ -0,0 +1,104 @@
+/**
+ * HRM patch 0019: "devices failed to install" messages for each webhook type.
+ * Counts and Microsoft's error descriptions only; never device or user names.
+ */
+
+import { appUrl } from '@/lib/hrm/site';
+import type { InstallStatusRecord } from '@/lib/hrm/install-status';
+import type { WebhookType } from '@/types/notifications';
+
+export interface InstallFailureWebhookData {
+  event: 'install_failures';
+  timestamp: string;
+  app_url?: string;
+  apps: Array<{
+    display_name: string;
+    intune_app_id: string;
+    failed: number;
+    previous_failed: number;
+    installed: number;
+    pending: number;
+    top_errors: Array<{ code: string; description: string; count: number }>;
+  }>;
+}
+
+const DISCORD_WARNING_COLOR = 0xf59e0b;
+
+export function buildInstallFailureData(records: InstallStatusRecord[], now = new Date()): InstallFailureWebhookData {
+  return {
+    event: 'install_failures',
+    timestamp: now.toISOString(),
+    app_url: appUrl(),
+    apps: records.map((r) => ({
+      display_name: r.display_name,
+      intune_app_id: r.intune_app_id,
+      failed: r.failed,
+      previous_failed: r.previous_failed,
+      installed: r.installed,
+      pending: r.pending,
+      top_errors: r.topErrors,
+    })),
+  };
+}
+
+const devices = (n: number) => `${n} device${n === 1 ? '' : 's'}`;
+
+function title(data: InstallFailureWebhookData): string {
+  return data.apps.length === 1
+    ? `${data.apps[0].display_name}: ${devices(data.apps[0].failed)} failed to install`
+    : `${data.apps.length} apps have devices that failed to install`;
+}
+
+function lines(data: InstallFailureWebhookData): string[] {
+  return data.apps.map((app) => {
+    const reason = app.top_errors[0]?.description || app.top_errors[0]?.code;
+    return `${app.display_name}: ${app.failed} failed, ${app.installed} installed${reason ? `. ${reason}` : ''}`;
+  });
+}
+
+function inventoryLink(data: InstallFailureWebhookData): string | undefined {
+  return data.app_url ? `${data.app_url}/dashboard/inventory` : undefined;
+}
+
+export function formatInstallFailurePayload(webhookType: WebhookType, data: InstallFailureWebhookData): unknown {
+  const link = inventoryLink(data);
+  switch (webhookType) {
+    case 'teams':
+      return {
+        type: 'message',
+        data,
+        attachments: [
+          {
+            contentType: 'application/vnd.microsoft.card.adaptive',
+            content: {
+              $schema: 'http://adaptivecards.io/schemas/adaptive-card.json',
+              type: 'AdaptiveCard',
+              version: '1.4',
+              body: [
+                { type: 'TextBlock', text: title(data), size: 'Large', weight: 'Bolder', color: 'Warning', wrap: true },
+                ...lines(data).map((text) => ({ type: 'TextBlock', text, wrap: true })),
+              ],
+              actions: link ? [{ type: 'Action.OpenUrl', title: 'Open Inventory', url: link }] : [],
+            },
+          },
+        ],
+      };
+    case 'slack':
+      return {
+        data,
+        blocks: [
+          { type: 'header', text: { type: 'plain_text', text: title(data), emoji: true } },
+          { type: 'section', text: { type: 'mrkdwn', text: lines(data).join('\n').replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' })[c]!) } },
+          ...(link ? [{ type: 'context', elements: [{ type: 'mrkdwn', text: `<${link}|Open Inventory>` }] }] : []),
+        ],
+      };
+    case 'discord':
+      return {
+        data,
+        embeds: [{ title: title(data), url: link, description: lines(data).join('\n'), color: DISCORD_WARNING_COLOR, footer: { text: 'IntuneGet' }, timestamp: data.timestamp }],
+      };
+    case 'custom':
+    default:
+      return data;
+  }
+}
