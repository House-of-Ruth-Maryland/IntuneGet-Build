+'use client';
+
+// HRM patch 0019: install counts for one app, from /api/hrm/install-status.
+
+import { useQuery } from '@tanstack/react-query';
+import { useMicrosoftAuth } from '@/hooks/useMicrosoftAuth';
+import type { InstallError } from '@/lib/hrm/install-status';
+
+export interface AppInstallStatus {
+  installed: number;
+  failed: number;
+  pending: number;
+  notApplicable: number;
+  other: number;
+  topErrors: InstallError[];
+  checkedAt: string;
+}
+
+export function useInstallStatus(appId: string | null) {
+  const { getAccessToken, isAuthenticated } = useMicrosoftAuth();
+  return useQuery<AppInstallStatus | null>({
+    queryKey: ['hrm', 'install-status', appId],
+    queryFn: async () => {
+      const token = await getAccessToken();
+      if (!token) throw new Error('Not authenticated');
+      const response = await fetch(`/api/hrm/install-status?appId=${encodeURIComponent(appId ?? '')}`, {
+        headers: { Authorization: `Bearer ${token}` },
+      });
+      if (!response.ok) throw new Error('Failed to load install status');
+      return (await response.json()).status;
+    },
+    enabled: isAuthenticated && Boolean(appId),
+    staleTime: 5 * 60 * 1000,
+  });
+}
