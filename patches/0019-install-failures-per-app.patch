+          installed = excluded.installed, failed = excluded.failed, pending = excluded.pending, not_applicable = excluded.not_applicable,
+          other = excluded.other, top_errors = excluded.top_errors, previous_failed = excluded.previous_failed,
+          alerted_on = excluded.alerted_on, checked_at = excluded.checked_at`)
