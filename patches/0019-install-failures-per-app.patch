@@ -0,0 +1,28 @@
+/**
+ * HRM patch 0019: tell every enabled webhook when apps' failed install counts go up.
+ * Like deployment results, this is server-wide (SQLite mode serves one tenant).
+ */
+
+import type { sqliteWebhooks as SqliteWebhooks } from '@/lib/db/sqlite';
+import type { InstallStatusRecord } from '@/lib/hrm/install-status';
+import { buildInstallFailureData, formatInstallFailurePayload } from '@/lib/webhooks/install-failure-formatters';
+import { deliverFormattedWebhook } from '@/lib/webhooks/service';
+
+export type InstallFailureWebhookStore = Pick<typeof SqliteWebhooks, 'listAllEnabled' | 'recordResult'>;
+
+export async function notifyInstallFailures(
+  records: InstallStatusRecord[],
+  store: InstallFailureWebhookStore,
+  now = new Date()
+): Promise<{ webhooksSent: number; errors: string[] }> {
+  const summary = { webhooksSent: 0, errors: [] as string[] };
+  if (records.length === 0) return summary;
+  const data = buildInstallFailureData(records, now);
+  for (const webhook of await store.listAllEnabled()) {
+    const result = await deliverFormattedWebhook(webhook, formatInstallFailurePayload(webhook.webhook_type, data));
+    await store.recordResult(webhook.id, result.success);
+    if (result.success) summary.webhooksSent++;
+    else summary.errors.push(`Webhook ${webhook.name} failed: ${result.error}`);
+  }
+  return summary;
+}
