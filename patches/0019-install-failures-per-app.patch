+/**
+ * HRM patch 0019: the install-status step of the 3:30 AM update check (SQLite mode).
+ */
+
+import { getDatabase, isSqliteMode } from '@/lib/db';
+import { runInstallStatusCheck } from '@/lib/hrm/install-status';
+import { notifyInstallFailures } from '@/lib/notifications/notify-install-failures';
+
+export async function runSqliteInstallCheck(now = new Date()) {
+  const { sqliteInstallStatus, sqliteWebhooks } = await import('@/lib/db/sqlite');
+  const deployments = await getDatabase().uploadHistory.listAll(2000);
+  const result = await runInstallStatusCheck(deployments, { store: sqliteInstallStatus, now });
+  const sent = await notifyInstallFailures(result.newFailures, sqliteWebhooks, now);
+  if (sent.errors.length > 0) console.warn(`[install status] ${sent.errors.length} webhook delivery error(s)`);
+  return { checked: result.checked, errors: result.errors, alerted: result.newFailures.length };
+}
+
+/** Install counts for one tenant's IntuneGet-deployed apps; empty without SQLite. */
+export async function listInstallStatus(tenantId: string) {
+  if (!isSqliteMode()) return [];
+  const { sqliteInstallStatus } = await import('@/lib/db/sqlite');
+  return sqliteInstallStatus.listForTenant(tenantId);
+}
diff --git a/lib/hrm/install-status.ts b/lib/hrm/install-status.ts
new file mode 100644
index 000000000..1632e6720
--- /dev/null
+++ b/lib/hrm/install-status.ts
@@ -0,0 +1,204 @@
+/**
+ * HRM patch 0019: install results per IntuneGet-deployed app, as counts only.
+ *
+ * Intune's per-app install report (getDeviceInstallStatusReport) is asked for
+ * the install state and error columns only, so device names, user names and
+ * device IDs are never fetched, stored or shown. The update check (3:30 AM and
+ * 3:30 PM) refreshes the counts; an alert goes out when an app's failed count goes up,
+ * at most once a day per app.
+ */
+
+import { acquireAppOnlyToken } from '@/lib/azure-app-credential';
+import type { UploadHistoryRecord } from '@/lib/db/types';
+
+export const INSTALL_REPORT_URL = 'https://graph.microsoft.com/beta/deviceManagement/reports/getDeviceInstallStatusReport';
+const PAGE_SIZE = 1000;
+const MAX_ROWS = 20000;
+const TOP_ERRORS = 3;
+
+export interface InstallError {
+  code: string;
+  description: string;
+  count: number;
+}
+
+export interface InstallCounts {
+  installed: number;
+  failed: number;
+  pending: number;
+  notApplicable: number;
+  other: number;
+  topErrors: InstallError[];
+}
+
+export interface InstallStatusRecord extends InstallCounts {
+  tenant_id: string;
+  intune_app_id: string;
+  user_id: string;
+  display_name: string;
+  previous_failed: number;
+  alerted_on: string | null;
+  checked_at: string;
+}
+
+export interface InstallStatusStore {
+  get(tenantId: string, intuneAppId: string): Promise<InstallStatusRecord | null>;
+  save(record: InstallStatusRecord): Promise<void>;
+  listForTenant(tenantId: string): Promise<InstallStatusRecord[]>;
+  removeMissing(keep: Array<{ tenantId: string; intuneAppId: string }>): Promise<void>;
+}
+
+type Bucket = 'installed' | 'failed' | 'pending' | 'notApplicable' | 'other';
+
+/** The report gives a localized state ("Installed", "Failed", ...) next to a number; the text is used. */
+export function installBucket(state: unknown): Bucket {
+  const text = String(state ?? '').toLowerCase().replace(/[\s_]/g, '');
+  if (text.includes('fail')) return 'failed';
+  if (text.includes('notapplicable')) return 'notApplicable';
+  if (text.includes('pending')) return 'pending';
+  if (text === 'installed') return 'installed';
+  return 'other';
+}
+
+interface ReportPage {
+  Schema?: Array<{ Column?: string; Name?: string }>;
+  Values?: unknown[][];
+  TotalRowCount?: number;
+}
+
+/** Counts one or more report pages. Only state and error columns are read. */
+export function countInstallReport(pages: ReportPage[]): InstallCounts {
+  const counts: InstallCounts = { installed: 0, failed: 0, pending: 0, notApplicable: 0, other: 0, topErrors: [] };
+  const errors = new Map<string, InstallError>();
+  for (const page of pages) {
+    const columns = (page.Schema ?? []).map((c) => c.Column ?? c.Name ?? '');
+    const at = (name: string) => columns.indexOf(name);
+    const state = at('AppInstallState_loc') >= 0 ? at('AppInstallState_loc') : at('AppInstallState');
+    const code = at('HexErrorCode');
+    const detail = at('AppInstallStateDetails_loc') >= 0 ? at('AppInstallStateDetails_loc') : at('AppInstallStateDetails');
+    for (const row of page.Values ?? []) {
+      const bucket = installBucket(state >= 0 ? row[state] : null);
+      counts[bucket] += 1;
+      if (bucket !== 'failed') continue;
+      const hex = code >= 0 ? String(row[code] ?? '').trim() : '';
+      const key = hex || 'unknown';
+      const description = detail >= 0 ? String(row[detail] ?? '').trim() : '';
+      const entry = errors.get(key) ?? { code: hex, description, count: 0 };
+      entry.count += 1;
+      if (!entry.description && description) entry.description = description;
+      errors.set(key, entry);
+    }
+  }
+  counts.topErrors = [...errors.values()].sort((a, b) => b.count - a.count).slice(0, TOP_ERRORS);
+  return counts;
+}
+
+/** Reads every page of one app's install report. */
+export async function fetchInstallCounts(
+  accessToken: string,
+  intuneAppId: string,
+  fetchImpl: typeof fetch = fetch
+): Promise<InstallCounts> {
+  if (!/^[0-9a-f-]{36}$/i.test(intuneAppId)) throw new Error('Invalid Intune app ID');
+  const pages: ReportPage[] = [];
+  for (let skip = 0; skip < MAX_ROWS; skip += PAGE_SIZE) {
+    const response = await fetchImpl(INSTALL_REPORT_URL, {
+      method: 'POST',
+      headers: { Authorization: `Bearer ${accessToken}`, 'Content-Type': 'application/json' },
+      body: JSON.stringify({
+        filter: `(ApplicationId eq '${intuneAppId}')`,
+        // Never DeviceName, UserName, UserPrincipalName or DeviceId.
+        select: ['AppInstallState', 'AppInstallStateDetails', 'HexErrorCode'],
+        skip,
+        top: PAGE_SIZE,
+      }),
+    });
+    if (!response.ok) throw new Error(`Intune install report returned ${response.status}`);
+    const page = (await response.json()) as ReportPage;
+    pages.push(page);
+    const rows = page.Values?.length ?? 0;
+    if (rows < PAGE_SIZE || (page.TotalRowCount !== undefined && skip + rows >= page.TotalRowCount)) break;
+  }
+  return countInstallReport(pages);
+}
+
+export interface InstallCheckDeps {
+  store: InstallStatusStore;
+  token?: (tenantId: string) => Promise<string | null>;
+  fetchImpl?: typeof fetch;
+  now?: Date;
+}
+
+export interface InstallCheckSummary {
+  checked: number;
+  errors: number;
+  /** Apps whose failed count went up and haven't been alerted today. */
+  newFailures: InstallStatusRecord[];
+}
+
+async function appToken(tenantId: string): Promise<string | null> {
+  const result = await acquireAppOnlyToken(tenantId);
+  return result.ok ? result.accessToken : null;
+}
+
+/** The Maryland calendar day, so "once a day" matches staff's day rather than UTC's. */
+export function marylandDay(date: Date): string {
+  return new Intl.DateTimeFormat('en-CA', { timeZone: 'America/New_York' }).format(date);
+}
+
+/** Refreshes counts for the newest deployment of every IntuneGet-deployed app. */
+export async function runInstallStatusCheck(
+  deployments: UploadHistoryRecord[],
+  deps: InstallCheckDeps
+): Promise<InstallCheckSummary> {
+  const now = deps.now ?? new Date();
+  const today = marylandDay(now);
+  const getToken = deps.token ?? appToken;
+  const summary: InstallCheckSummary = { checked: 0, errors: 0, newFailures: [] };
+
+  // One row per Intune app; listAll is newest first.
+  const newest = new Map<string, UploadHistoryRecord>();
+  for (const deployment of deployments) {
+    if (!deployment.intune_tenant_id || !deployment.intune_app_id) continue;
+    const key = `${deployment.intune_tenant_id}|${deployment.intune_app_id}`;
+    if (!newest.has(key)) newest.set(key, deployment);
+  }
+
+  const tokens = new Map<string, string | null>();
+  const keep: Array<{ tenantId: string; intuneAppId: string }> = [];
+  for (const deployment of newest.values()) {
+    const tenantId = deployment.intune_tenant_id!;
+    keep.push({ tenantId, intuneAppId: deployment.intune_app_id });
+    if (!tokens.has(tenantId)) tokens.set(tenantId, await getToken(tenantId).catch(() => null));
+    const token = tokens.get(tenantId);
+    if (!token) {
+      summary.errors += 1;
+      continue;
+    }
+    let counts: InstallCounts;
+    try {
+      counts = await fetchInstallCounts(token, deployment.intune_app_id, deps.fetchImpl);
+    } catch {
+      summary.errors += 1;
+      continue;
+    }
+    const before = await deps.store.get(tenantId, deployment.intune_app_id);
+    const previousFailed = before?.failed ?? 0;
+    const alert = counts.failed > previousFailed && before?.alerted_on !== today;
+    const record: InstallStatusRecord = {
+      ...counts,
+      tenant_id: tenantId,
+      intune_app_id: deployment.intune_app_id,
+      user_id: deployment.user_id,
+      display_name: deployment.display_name,
+      previous_failed: previousFailed,
+      alerted_on: alert ? today : (before?.alerted_on ?? null),
+      checked_at: now.toISOString(),
+    };
+    await deps.store.save(record);
+    summary.checked += 1;
+    if (alert) summary.newFailures.push(record);
+  }
+  await deps.store.removeMissing(keep);
+  return summary;
+}
