+    id, packaging_job_id: null, user_id: 'user-one', winget_id: `Example.${name}`, version: '1.0', display_name: name,
+    publisher: null, intune_app_id: appId, intune_app_url: null, intune_tenant_id: 'tenant-one', app_source: null, deployed_at: deployedAt,
+  };
+}
+
+function memoryStore(): InstallStatusStore & { rows: Map<string, InstallStatusRecord> } {
+  const rows = new Map<string, InstallStatusRecord>();
+  return {
+    rows,
+    async get(t, a) { return rows.get(`${t}|${a}`) ?? null; },
+    async save(r) { rows.set(`${r.tenant_id}|${r.intune_app_id}`, { ...r }); },
+    async listForTenant(t) { return [...rows.values()].filter((r) => r.tenant_id === t); },
+    async removeMissing(keep) {
+      const wanted = new Set(keep.map((k) => `${k.tenantId}|${k.intuneAppId}`));
+      for (const key of rows.keys()) if (!wanted.has(key)) rows.delete(key);
+    },
+  };
+}
+
+function reportFetch(byApp: Record<string, unknown[][]>) {
+  return vi.fn(async (_url: string | URL | Request, init?: RequestInit) => {
+    const body = JSON.parse(String(init?.body));
+    const id = String(body.filter).match(/'([^']+)'/)![1];
+    return Response.json({ Schema: SCHEMA, Values: byApp[id] ?? [], TotalRowCount: (byApp[id] ?? []).length });
+  });
+}
+
+describe('install report counting', () => {
+  it('sorts localized states into buckets', () => {
+    expect(installBucket('Installed')).toBe('installed');
+    expect(installBucket('Failed')).toBe('failed');
+    expect(installBucket('Uninstall failed')).toBe('failed');
+    expect(installBucket('Install pending')).toBe('pending');
+    expect(installBucket('Not applicable')).toBe('notApplicable');
+    expect(installBucket('Not installed')).toBe('other');
+    expect(installBucket(null)).toBe('other');
+  });
+
+  it('counts states and keeps the three most common failure reasons', () => {
+    const counts = countInstallReport([{
+      Schema: SCHEMA,
+      Values: [
+        row('Installed'), row('Installed'), row('Install pending'), row('Not applicable'),
+        row('Failed', '0x87D1041C', DETECTED), row('Failed', '0x87D1041C', DETECTED), row('Failed', '0x80070005', 'Access denied.'),
+        row('Failed', '0x1', 'One'), row('Failed', '0x2', 'Two'),
+      ],
+    }]);
+    expect(counts).toMatchObject({ installed: 2, failed: 5, pending: 1, notApplicable: 1, other: 0 });
+    expect(counts.topErrors).toHaveLength(3);
+    expect(counts.topErrors[0]).toEqual({ code: '0x87D1041C', description: DETECTED, count: 2 });
+  });
+
+  it('asks Intune for state and error columns only, never device or user names', async () => {
+    const fetchMock = reportFetch({ [APP_A]: [row('Installed')] });
