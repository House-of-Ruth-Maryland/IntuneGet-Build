+    const rows = database.prepare('SELECT tenant_id, intune_app_id FROM hrm_app_install_status').all() as Array<{ tenant_id: string; intune_app_id: string }>;
+    const remove = database.prepare('DELETE FROM hrm_app_install_status WHERE tenant_id = ? AND intune_app_id = ?');
+    database.transaction(() => {
+      for (const row of rows) if (!wanted.has(`${row.tenant_id}|${row.intune_app_id}`)) remove.run(row.tenant_id, row.intune_app_id);
