+    expect((await runInstallStatusCheck(only, { store, token, fetchImpl: two, now: new Date('2026-11-02T15:00:00Z') })).newFailures).toHaveLength(0);
+    expect((await runInstallStatusCheck(only, { store, token, fetchImpl: two, now: new Date('2026-11-03T08:30:00Z') })).newFailures).toHaveLength(0);
+    expect((await runInstallStatusCheck(only, { store, token, fetchImpl: three, now: new Date('2026-11-03T08:31:00Z') })).newFailures).toHaveLength(1);
