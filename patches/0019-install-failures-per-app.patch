+    const [url, init] = fetchMock.mock.calls[0];
+    expect(url).toBe(INSTALL_REPORT_URL);
+    const body = JSON.parse(String(init?.body));
+    expect(body.select).toEqual(['AppInstallState', 'AppInstallStateDetails', 'HexErrorCode']);
+    expect(JSON.stringify(body)).not.toMatch(/DeviceName|UserName|UserPrincipalName|DeviceId/);
+    expect(body.filter).toBe(`(ApplicationId eq '${APP_A}')`);
+  });
+
+  it('pages through large reports', async () => {
+    const page = Array.from({ length: 1000 }, () => row('Installed'));
+    const fetchMock = vi.fn(async (_u: unknown, init?: RequestInit) => {
+      const { skip } = JSON.parse(String(init?.body));
