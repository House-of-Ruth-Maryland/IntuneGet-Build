index 000000000..cee2ad940
--- /dev/null
+++ b/lib/hrm/__tests__/mcp-auth.test.ts
@@ -0,0 +1,101 @@
+import { createLocalJWKSet, exportJWK, generateKeyPair, SignJWT, type JWTVerifyGetKey } from 'jose';
+import { beforeAll, describe, expect, it, vi } from 'vitest';
+import { accessTokenMatches, authorizeMcpRequest, mcpConfig, requesterForLog } from '../mcp-auth';
+
+// Fake values only.
+const TEAM = 'example-team.cloudflareaccess.com';
+const AUD = 'fake-audience-tag-0123456789abcdef';
+const CLIENT = 'fake-client-id.access';
+const TENANT = '00000000-0000-4000-8000-000000000001';
+const KEY = 'k'.repeat(48);
+const env = { MCP_API_KEY: KEY, ACCESS_TEAM_DOMAIN: TEAM, ACCESS_AUD: AUD, MCP_ACCESS_CLIENT_ID: CLIENT, MCP_TENANT_ID: TENANT };
+
+let keys: JWTVerifyGetKey;
+let otherKeys: JWTVerifyGetKey;
+let privateKey: CryptoKey;
+let otherPrivate: CryptoKey;
+beforeAll(async () => {
+  const pair = await generateKeyPair('RS256');
+  const other = await generateKeyPair('RS256');
+  privateKey = pair.privateKey; otherPrivate = other.privateKey;
+  keys = createLocalJWKSet({ keys: [{ ...(await exportJWK(pair.publicKey)), kid: 'one', alg: 'RS256' }] });
+  otherKeys = createLocalJWKSet({ keys: [{ ...(await exportJWK(other.publicKey)), kid: 'two', alg: 'RS256' }] });
+});
+
+function jwt(claims: Record<string, unknown> = {}, opts: { key?: CryptoKey; kid?: string; iss?: string; aud?: string; exp?: string | number } = {}) {
+  return new SignJWT({ common_name: CLIENT, type: 'app', ...claims })
+    .setProtectedHeader({ alg: 'RS256', kid: opts.kid ?? 'one' })
+    .setIssuer(opts.iss ?? `https://${TEAM}`)
+    .setAudience(opts.aud ?? AUD)
+    .setIssuedAt()
+    .setExpirationTime(opts.exp ?? '5m')
+    .sign(opts.key ?? privateKey);
+}
+const headers = (values: Record<string, string>) => new Headers(values);
+
+describe('MCP API settings', () => {
+  it('turns the API off when any setting is missing or malformed', () => {
+    expect(mcpConfig(env)).toEqual({ apiKey: KEY, teamDomain: TEAM, audience: AUD, clientId: CLIENT, tenantId: TENANT });
+    expect(mcpConfig({ ...env, ACCESS_TEAM_DOMAIN: `https://${TEAM}/` })?.teamDomain).toBe(TEAM);
+    for (const change of [
+      { MCP_API_KEY: undefined }, { MCP_API_KEY: 's'.repeat(31) }, { ACCESS_TEAM_DOMAIN: '' }, { ACCESS_AUD: '' },
+      { MCP_ACCESS_CLIENT_ID: '' }, { MCP_TENANT_ID: '' }, { MCP_TENANT_ID: 'not-a-guid' },
+      // Keys are fetched only from a Cloudflare Access team domain.
+      { ACCESS_TEAM_DOMAIN: 'keys.example.test' }, { ACCESS_TEAM_DOMAIN: 'evil.example.test/x.cloudflareaccess.com' },
+    ]) expect(mcpConfig({ ...env, ...change })).toBeNull();
+  });
+});
+
+describe('Cloudflare Access token', () => {
+  const config = mcpConfig(env)!;
+  it('accepts only an unexpired token for this team, audience and service token', async () => {
+    expect(await accessTokenMatches(await jwt(), config, keys)).toBe(true);
+    expect(await accessTokenMatches(await jwt({ common_name: 'other-client.access' }), config, keys)).toBe(false);
+    expect(await accessTokenMatches(await jwt({ common_name: undefined, email: 'person@example.test' }), config, keys)).toBe(false);
+    expect(await accessTokenMatches(await jwt({}, { aud: 'other-audience-0000000000' }), config, keys)).toBe(false);
+    expect(await accessTokenMatches(await jwt({}, { iss: 'https://other.cloudflareaccess.com' }), config, keys)).toBe(false);
+    expect(await accessTokenMatches(await jwt({}, { exp: Math.floor(Date.now() / 1000) - 120 }), config, keys)).toBe(false);
+    expect(await accessTokenMatches(await jwt({}, { key: otherPrivate, kid: 'two' }), config, keys)).toBe(false);
+    expect(await accessTokenMatches(await jwt({}, { key: otherPrivate, kid: 'one' }), config, keys)).toBe(false);
+    expect(await accessTokenMatches(await jwt(), config, otherKeys)).toBe(false);
+    expect(await accessTokenMatches(null, config, keys)).toBe(false);
+    expect(await accessTokenMatches('not.a.jwt', config, keys)).toBe(false);
+    expect(await accessTokenMatches('x'.repeat(9000), config, keys)).toBe(false);
+  });
+
+  it('refuses unsigned and shared-secret tokens', async () => {
+    const encode = (value: unknown) => Buffer.from(JSON.stringify(value)).toString('base64url');
+    const body = encode({ common_name: CLIENT, iss: `https://${TEAM}`, aud: AUD, iat: Math.floor(Date.now() / 1000), exp: Math.floor(Date.now() / 1000) + 300 });
+    expect(await accessTokenMatches(`${encode({ alg: 'none' })}.${body}.`, config, keys)).toBe(false);
+    const hs = await new SignJWT({ common_name: CLIENT }).setProtectedHeader({ alg: 'HS256' }).setIssuer(`https://${TEAM}`)
+      .setAudience(AUD).setIssuedAt().setExpirationTime('5m').sign(new TextEncoder().encode(KEY));
+    expect(await accessTokenMatches(hs, config, keys)).toBe(false);
+  });
+});
+
+describe('authorizeMcpRequest', () => {
+  it('needs both the API key and the Access token', async () => {
+    const token = await jwt();
+    expect(await authorizeMcpRequest(headers({ authorization: `Bearer ${KEY}`, 'cf-access-jwt-assertion': token }), env, keys)).toMatchObject({ tenantId: TENANT });
+    expect(await authorizeMcpRequest(headers({ authorization: `Bearer ${KEY}` }), env, keys)).toBeNull();
+    expect(await authorizeMcpRequest(headers({ 'cf-access-jwt-assertion': token }), env, keys)).toBeNull();
+    expect(await authorizeMcpRequest(headers({ authorization: `Bearer ${KEY}x`, 'cf-access-jwt-assertion': token }), env, keys)).toBeNull();
+    expect(await authorizeMcpRequest(headers({ authorization: `Basic ${KEY}`, 'cf-access-jwt-assertion': token }), env, keys)).toBeNull();
+    expect(await authorizeMcpRequest(headers({ authorization: `Bearer ${KEY}`, 'cf-access-jwt-assertion': token }), { ...env, MCP_TENANT_ID: undefined }, keys)).toBeNull();
+  });
+
+  it('checks the key before touching the Access keys', async () => {
+    const spy = vi.fn(keys);
+    expect(await authorizeMcpRequest(headers({ authorization: 'Bearer wrong', 'cf-access-jwt-assertion': await jwt() }), env, spy)).toBeNull();
+    expect(spy).not.toHaveBeenCalled();
+  });
+});
+
+describe('requesterForLog', () => {
+  it('keeps a plain email and nothing else', () => {
+    expect(requesterForLog('Staff.Member@Example.test')).toBe('staff.member@example.test');
+    for (const value of [null, '', 'not an email', 'a@example.test\n[mcp-api] forged', 'a@example.test b', `${'a'.repeat(300)}@example.test`]) {
+      expect(requesterForLog(value)).toBe('unknown');
+    }
+  });
+});
