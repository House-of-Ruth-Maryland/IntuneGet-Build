+/**
+ * HRM patch 0055: the Home page's "Needs attention" lists for one tenant, shared by Home
+ * (app/api/hrm/home) and the MCP read API so both always agree.
+ */
+
+import { getDatabase } from '@/lib/db';
+import { attentionCounts, unreachedApps } from '@/lib/hrm/home';
+import { listInstallStatus } from '@/lib/hrm/install-status-check';
+import type { InstallStatusRecord } from '@/lib/hrm/install-status';
+
+export interface TenantAttention {
+  attention: ReturnType<typeof attentionCounts> | null;
+  installFailures: Array<{ displayName: string; intuneAppId: string; failed: number }>;
+  unreached: Array<{ displayName: string; intuneAppId: string; deployedAt: string }>;
+  rollbackGaps: Array<{ displayName: string; intuneAppId: string; previousVersion: string }>;
+  oldCopiesKept: Array<{ displayName: string; intuneAppId: string; version: string; newestAppId: string; reason: string }>;
+  /** Install records, for callers that also need error codes (the MCP read API). */
+  installs: InstallStatusRecord[];
+  /** Intune app IDs being retired (lowercase). */
+  retiring: Set<string>;
+}
+
+export async function readTenantAttention(tenantId: string): Promise<TenantAttention> {
+  const db = getDatabase();
+  const [jobs, installs, deployments] = await Promise.all([
+    db.jobs.getAnalyticsJobs({ tenantId }).catch(() => null),
+    // HRM patch 0019: apps with devices that failed to install (counts only)
+    listInstallStatus(tenantId).catch(() => []),
+    // HRM patch 0032: when each copy was deployed, for apps that reach no devices
+    db.uploadHistory.listAll(2000).then((rows) => rows.filter((r) => r.intune_tenant_id === tenantId)).catch(() => []),
+  ]);
+  const installFailures = installs
+    .filter((app) => app.failed > 0)
+    .map((app) => ({ displayName: app.display_name, intuneAppId: app.intune_app_id, failed: app.failed }));
+  // HRM patch 0038: an app being retired is meant to reach nobody, and its failures are uninstall failures.
+  let retiring = new Set<string>();
+  let rollbackGaps: TenantAttention['rollbackGaps'] = [];
+  let oldCopiesKept: TenantAttention['oldCopiesKept'] = [];
+  if (process.env.DATABASE_MODE?.toLowerCase() === 'sqlite') {
+    try { const { sqliteRetirements } = await import('@/lib/db/sqlite'); retiring = new Set(sqliteRetirements.activeAppIds(tenantId)); } catch { /* optional */ }
+    // HRM patch 0039: newest copies that can't go back, because their previous installer is gone or has changed.
+    try {
+      const { sqliteRollbackReadiness, sqliteAppInsights } = await import('@/lib/db/sqlite');
+      const newest = new Map(sqliteAppInsights.tracked(tenantId).map((d) => [d.appId.toLowerCase(), d.displayName]));
+      rollbackGaps = sqliteRollbackReadiness.gaps(tenantId)
+        .filter((g) => newest.has(g.app_id.toLowerCase()) && !retiring.has(g.app_id.toLowerCase()))
+        .map((g) => ({ displayName: newest.get(g.app_id.toLowerCase())!, intuneAppId: g.app_id, previousVersion: g.previous_version }));
+    } catch { /* optional */ }
+    // HRM patch 0042: old copies IntuneGet couldn't remove after an update (still in Intune).
+    try {
+      const { sqliteOldCopies } = await import('@/lib/db/sqlite');
+      oldCopiesKept = sqliteOldCopies.kept(tenantId)
+        .filter((c) => !retiring.has(c.app_id.toLowerCase()))
+        .map((c) => ({ displayName: c.display_name, intuneAppId: c.app_id, version: c.version, newestAppId: c.newest_app_id, reason: c.reason ?? '' }));
+    } catch { /* optional */ }
+  }
+  const unreached = unreachedApps(installs, deployments).filter((app) => !retiring.has(app.intuneAppId.toLowerCase()));
+  // Its uninstall results show in its Inventory details, not as install failures.
+  const failing = installFailures.filter((app) => !retiring.has(app.intuneAppId.toLowerCase()));
+  return { attention: jobs ? attentionCounts(jobs) : null, installFailures: failing, unreached, rollbackGaps, oldCopiesKept, installs, retiring };
+}
