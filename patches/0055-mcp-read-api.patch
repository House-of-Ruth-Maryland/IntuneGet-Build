+import { NextRequest } from 'next/server';
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+const mocks = vi.hoisted(() => ({ authorize: vi.fn(), handle: vi.fn() }));
+vi.mock('@/lib/hrm/mcp-auth', async (original) => ({ ...(await original<typeof import('@/lib/hrm/mcp-auth')>()), authorizeMcpRequest: mocks.authorize }));
+vi.mock('@/lib/hrm/mcp-api', async (original) => ({ ...(await original<typeof import('@/lib/hrm/mcp-api')>()), handleMcpRequest: mocks.handle }));
+import * as route from './route';
+import { McpError } from '@/lib/hrm/mcp-api';
+
+// Fake values only.
+const TENANT = '00000000-0000-4000-8000-000000000001';
+const call = (path: string[], headers: Record<string, string> = {}, query = '') =>
+  route.GET(new NextRequest(`https://example.test/api/hrm/mcp/${path.join('/')}${query}`, { headers }), { params: Promise.resolve({ path }) });
+
+let info: ReturnType<typeof vi.spyOn>;
+beforeEach(() => {
+  vi.clearAllMocks();
+  mocks.authorize.mockResolvedValue({ tenantId: TENANT });
+  mocks.handle.mockResolvedValue({ health: 'ok' });
+  info = vi.spyOn(console, 'info').mockImplementation(() => {});
+});
+afterEach(() => { info.mockRestore(); vi.useRealTimers(); });
+
+describe('MCP read API route', () => {
+  it('answers unauthorized calls with an empty 401 before reading or logging anything', async () => {
+    mocks.authorize.mockResolvedValue(null);
+    const response = await call(['status'], { 'x-hrm-requested-by': 'staff@example.test' });
+    expect(response.status).toBe(401);
+    expect(await response.text()).toBe('');
+    expect(response.headers.get('cache-control')).toBe('no-store');
+    expect(mocks.handle).not.toHaveBeenCalled();
+    expect(info).not.toHaveBeenCalled();
+  });
+
+  it('serves the configured tenant, never cached, and logs the requester only', async () => {
+    const response = await call(['status'], { 'x-hrm-requested-by': 'Staff@Example.test' });
+    expect(response.status).toBe(200);
+    expect(response.headers.get('cache-control')).toBe('no-store');
+    const text = await response.text();
+    expect(JSON.parse(text)).toEqual({ health: 'ok' });
+    expect(text).not.toContain('example.test');
+    expect(mocks.handle.mock.calls[0][2]).toMatchObject({ tenantId: TENANT });
+    expect(info).toHaveBeenCalledWith('[mcp-api] GET status for staff@example.test');
+  });
+
+  it('logs a fixed endpoint name, not the raw path', async () => {
+    await call(['apps', '11111111-1111-4111-8111-111111111111']);
+    expect(info).toHaveBeenCalledWith('[mcp-api] GET apps/{id} for unknown');
+    const unknown = await call(['package']);
+    expect(unknown.status).toBe(404);
+    expect(await unknown.text()).toBe('');
+    expect(info).toHaveBeenLastCalledWith('[mcp-api] GET unknown for unknown');
+  });
+
+  it('maps failures to empty statuses without error text', async () => {
+    mocks.handle.mockRejectedValueOnce(new McpError(400));
+    expect((await call(['jobs'], {}, '?limit=0')).status).toBe(400);
+    mocks.handle.mockRejectedValueOnce(new Error('FORBIDDEN database detail'));
+    const failed = await call(['jobs']);
+    expect(failed.status).toBe(503);
+    expect(await failed.text()).toBe('');
+  });
+
+  it('gives up after the deadline', async () => {
+    vi.useFakeTimers();
+    mocks.handle.mockImplementation(() => new Promise(() => {}));
+    const pending = call(['apps']);
+    await vi.advanceTimersByTimeAsync(6_001);
+    const response = await pending;
+    expect(response.status).toBe(503);
+  });
+
+  it('refuses oversized answers', async () => {
+    mocks.handle.mockResolvedValue({ apps: 'x'.repeat(300 * 1024) });
+    expect((await call(['apps'])).status).toBe(503);
+  });
+
+  it('offers GET only', () => {
+    expect(Object.keys(route).filter((name) => /^[A-Z]+$/.test(name))).toEqual(['GET']);
+  });
