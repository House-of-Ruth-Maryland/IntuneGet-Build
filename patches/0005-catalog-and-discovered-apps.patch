--- /dev/null
+++ b/components/unmanaged/discovery-state.test.ts
@@ -0,0 +1,37 @@
+import { createElement } from 'react';
+import { renderToStaticMarkup } from 'react-dom/server';
+import { describe, expect, it, vi } from 'vitest';
+import { UnmanagedAppCard } from './UnmanagedAppCard';
+import { UnmanagedListRow } from './UnmanagedListRow';
+import type { UnmanagedApp } from '@/types/unmanaged';
+import type { PackageManagementState } from '@/lib/discovery-state';
+vi.mock('@/components/AppIcon', () => ({ AppIcon: () => null }));
+const app: UnmanagedApp = { id: 'row', discoveredAppId: 'new-version-inventory-id', displayName: 'Fixture app', publisher: 'Fixture publisher', version: '2', deviceCount: 12,
+  platform: 'windows', matchStatus: 'matched', matchedPackageId: 'Vendor.App', matchedPackageName: 'Fixture app', matchConfidence: 1, isClaimed: false, lastSynced: '2026-01-01' };
+const none: PackageManagementState = { packageId: 'vendor.app', state: 'none', copies: [], checkedAt: '2026-01-01' };
+for (const view of ['grid', 'list'] as const) describe(`${view} discovered inventory`, () => {
+  const render = (extra: Partial<UnmanagedApp> = {}) => view === 'grid'
+    ? renderToStaticMarkup(createElement(UnmanagedAppCard, { app: { ...app, ...extra } }))
+    : renderToStaticMarkup(createElement(UnmanagedListRow, { app: { ...app, ...extra }, onClaim: () => {}, onLink: () => {}, isClaimLoading: false }));
+  const claimButton = (html: string) => /<button[^>]*>(?:(?!<\/button>).)*\bClaim\s*<\/button>/s.test(html);
+  it('offers staging only after a successful tenant history read with no previous deployment', () => {
+    expect(claimButton(render({ management: none }))).toBe(true);
+    expect(claimButton(render())).toBe(false);
+    expect(render()).toContain('Deployment state unavailable');
+  });
+  it.each(['verified', 'deleted', 'unverified', 'previously_deployed'] as const)('keeps %s inventory and device access without offering Claim', state => {
+    const html = render({ management: { ...none, state, copies: state === 'verified' ? [{ intuneAppId: 'id', version: '1', state: 'present' }] : [] } });
+    expect(html).toContain('Fixture app');
+    expect(html).toContain('12');
+    expect(html).toContain('Review deployments');
+    expect(claimButton(html)).toBe(false);
+    expect(html).not.toContain('installed successfully');
+  });
+  it('keeps a queued deployment separate from local list membership', () => {
+    const html = render({ management: { ...none, activeJobId: 'queued-job' } });
+    expect(html).toContain('Deployment queued or running');
+    expect(html).not.toContain('Claimed: in Deployment list');
+    expect(claimButton(html)).toBe(false);
+    expect(render({ management: none, isClaimed: true })).toContain('Claimed');
+  });
+});
