@@ -0,0 +1,145 @@
+import { getDatabase } from '@/lib/db';
+import type { DatabaseAdapter, PackagingJob, DiscoveryJobEvidence } from '@/lib/db/types';
+import { acquireGraphToken } from '@/lib/graph-token';
+import { packageKey, reviewAcknowledged, type DiscoveryProvenance, type PackageManagementState } from './discovery-state';
+
+const TERMINAL = new Set(['deployed', 'completed', 'failed', 'cancelled', 'duplicate_skipped', 'qa_failed']);
+const GUID = /^[a-f0-9]{8}(?:-[a-f0-9]{4}){3}-[a-f0-9]{12}$/i;
+export class DiscoveryConflictError extends Error {}
+function config(job: DiscoveryJobEvidence): Record<string, unknown> {
+  return job.package_config && typeof job.package_config === 'object' && !Array.isArray(job.package_config)
+    ? job.package_config as Record<string, unknown> : {};
+}
+export function ordinaryPackage(job: DiscoveryJobEvidence): string | null {
+  const c = config(job);
+  const origin = c.deploymentOrigin as { kind?: string } | undefined;
+  if (c.sourceType === 'custom' || c.hrmRemoval || job.app_source === 'store' || c.appSource === 'store'
+    || (origin && ['custom', 'removal', 'store'].includes(origin.kind || ''))
+    || job.winget_id?.toLowerCase().startsWith('custom.')) return null;
+  return packageKey(job.winget_id);
+}
+
+type Probe = (tenantId: string, appId: string) => Promise<'present' | 'absent' | 'unknown'>;
+/** No cross-request cache: a historical deployment is never silently promoted to current management. */
+export async function readDiscoveryManagement(tenantId: string, deps: { db?: DatabaseAdapter; probe?: Probe; verify?: boolean } = {}) {
+  const jobs = await (deps.db || getDatabase()).jobs.getDiscoveryJobs(tenantId);
+  const states: Record<string, PackageManagementState> = {};
+  const unverifiedHistoryCopies = new Set<PackageManagementState['copies'][number]>();
+  const incompleteEvidence = new Set<string>();
+  const now = new Date().toISOString();
+  for (const job of jobs) {
+    if (job.tenant_id !== tenantId) continue;
+    const key = ordinaryPackage(job);
+    if (!key) continue;
+    const state = states[key] ||= { packageId: key, state: 'none', copies: [], checkedAt: now };
+    // Jobs are newest first. Unknown nonterminal statuses fail closed against another deployment.
+    if (!TERMINAL.has(job.status) && !state.activeJobId) {
+      state.activeJobId = job.id;
+      state.activeStatus = job.status;
+    }
+    if (['failed', 'cancelled'].includes(job.status) && (job.intune_app_id || job.upload_started_at
+      || job.error_stage === 'upload' || job.error_message?.startsWith('Job timed out after '))) {
+      state.unconfirmedAttempt = true;
+      if (state.state === 'none') state.state = 'unverified';
+    }
+    if (job.status !== 'deployed') continue;
+    state.state = 'previously_deployed';
+    const c = config(job);
+    const origin = c.deploymentOrigin as { tenantId?: string; packageId?: string } | undefined;
+    const identityMatches = (!c.wingetId || packageKey(c.wingetId) === key)
+      && (!origin || (origin.tenantId === tenantId && packageKey(origin.packageId) === key));
+    if (!identityMatches || !job.intune_app_id) incompleteEvidence.add(key);
+    if (identityMatches && job.intune_app_id && !state.copies.some(c => c.intuneAppId === job.intune_app_id)) {
+      const copy: PackageManagementState['copies'][number] = { intuneAppId: job.intune_app_id, version: job.version, state: 'unknown' };
+      state.copies.push(copy);
+      if (job.historyOnly) unverifiedHistoryCopies.add(copy);
+    }
+  }
+  if (deps.verify === false) return states;
+  const deadline = Date.now() + 8_000;
+  let token: Promise<string> | undefined;
+  const probe: Probe = deps.probe || (async (tenant, id) => {
+    if (!GUID.test(id) || Date.now() >= deadline) return 'unknown';
+    token ||= acquireGraphToken(tenant).then(t => t.accessToken);
+    const bearer = await Promise.race([token, new Promise<never>((_, reject) => {
+      const timer = setTimeout(() => reject(new Error('Intune read timeout')), Math.max(1, deadline - Date.now()));
+      timer.unref?.();
+    })]);
+    if (Date.now() >= deadline) return 'unknown';
+    const response = await fetch(`https://graph.microsoft.com/beta/deviceAppManagement/mobileApps/${encodeURIComponent(id)}?$select=id`, {
+      headers: { Authorization: `Bearer ${bearer}` }, cache: 'no-store',
+      signal: AbortSignal.timeout(Math.max(1, Math.min(3_000, deadline - Date.now()))),
+    });
+    if (response.status === 404) return 'absent';
+    if (!response.ok) return 'unknown';
+    const body = await response.json();
+    return typeof body?.id === 'string' && body.id.toLowerCase() === id.toLowerCase() ? 'present' : 'unknown';
+  });
+  // Bounded request fan-out. Unchecked copies remain unknown, never absent or verified.
+  const copies = Object.values(states).flatMap(s => s.copies).filter(c => !unverifiedHistoryCopies.has(c));
+  let next = 0;
+  await Promise.all(Array.from({ length: Math.min(4, copies.length) }, async () => {
+    while (next < Math.min(80, copies.length) && Date.now() < deadline) {
+      const copy = copies[next++];
+      try { copy.state = await probe(tenantId, copy.intuneAppId); } catch { copy.state = 'unknown'; }
+    }
+  }));
+  for (const state of Object.values(states)) {
+    if (state.copies.some(c => c.state === 'present')) state.state = 'verified';
+    else if (!incompleteEvidence.has(state.packageId) && state.copies.length && state.copies.every(c => c.state === 'absent')) state.state = 'deleted';
+    else if (state.state === 'previously_deployed') state.state = 'unverified';
+  }
+  return states;
+}
+
+/** Validate the immutable discovery tuple before it becomes job configuration. */
+export async function validateDiscoveryProvenance(item: { wingetId: string; discovery?: DiscoveryProvenance; sourceType?: string; hrmRemoval?: unknown; appSource?: string }, tenantId: string, db = getDatabase()) {
+  const d = item.discovery;
+  if (!d) return;
+  if (d.tenantId !== tenantId || !d.claimId || !d.discoveredAppId || !packageKey(d.packageId)
+    || packageKey(d.packageId) !== packageKey(item.wingetId) || item.sourceType === 'custom' || item.hrmRemoval || item.appSource === 'store') {
+    throw new DiscoveryConflictError('The discovered app no longer matches this tenant and package. Add it again from Discovered apps.');
+  }
+  const claim = (await db.claimedApps.listByTenant(tenantId)).find(c => c.discovered_app_id === d.discoveredAppId);
+  if (!claim || claim.id !== d.claimId || claim.tenant_id !== tenantId || packageKey(claim.winget_package_id) !== packageKey(item.wingetId)) {
+    throw new DiscoveryConflictError('The discovered app link changed. Add it again from Discovered apps.');
+  }
+}
+
+/** Both completion paths use the same tenant/package/provenance checks. Repeat calls are harmless. */
+export async function reconcileDiscoveryClaim(job: PackagingJob, db = getDatabase()) {
+  const key = ordinaryPackage(job);
+  const d = config(job).discovery as DiscoveryProvenance | undefined;
+  if (!key || !d || !job.tenant_id || job.status !== 'deployed' || !job.intune_app_id) return;
+  if (config(job).wingetId && packageKey(config(job).wingetId) !== key) return;
+  await validateDiscoveryProvenance({ wingetId: job.winget_id, discovery: d }, job.tenant_id, db);
+  const latest = (await db.jobs.getDiscoveryJobs(job.tenant_id)).find(other => other.status === 'deployed'
+    && ordinaryPackage(other) === key && other.tenant_id === job.tenant_id
+    && (config(other).discovery as DiscoveryProvenance | undefined)?.claimId === d.claimId);
+  if (latest && latest.id !== job.id) return;
+  await db.claimedApps.update(d.claimId, job.tenant_id, { status: 'deployed', intune_app_id: job.intune_app_id });
+}
+
+/** Server checkpoint, before QA demand or queue side effects. A deliberate second copy is per item. */
+export async function checkDiscoveryDispatch(items: { wingetId: string; discovery?: DiscoveryProvenance; sourceType?: string; hrmRemoval?: unknown; appSource?: string; forceCreate?: boolean; deploymentReview?: { tenantId: string; packageId: string }; replacesIntuneAppId?: string }[], tenantId: string, db = getDatabase()) {
+  const ordinary = items.filter(i => i.sourceType !== 'custom' && !i.hrmRemoval && i.appSource !== 'store' && !packageKey(i.wingetId)?.startsWith('custom.'));
+  if (!ordinary.length) return;
+  const states = await readDiscoveryManagement(tenantId, { db, verify: false });
+  const submitted = new Set<string>();
+  for (const item of ordinary) {
+    const key = packageKey(item.wingetId);
+    if (!key) { if (item.discovery) throw new DiscoveryConflictError('Invalid catalog package identity.'); continue; }
+    await validateDiscoveryProvenance(item, tenantId, db);
+    if (submitted.has(key)) throw new DiscoveryConflictError('This package appears more than once. Keep one copy in the Deployment list.');
+    submitted.add(key);
+    const state = states[key];
+    const reviewed = reviewAcknowledged(item, tenantId, state?.copies);
+    if (state?.activeJobId) throw new DiscoveryConflictError('This package already has a queued or running deployment. Review Deployments before trying again.');
+    if (state?.unconfirmedAttempt && !reviewed) throw new DiscoveryConflictError('A previous upload has an unconfirmed outcome. Review Deployments and Inventory before choosing Add a second copy anyway.');
+    if (state && state.state !== 'none' && !reviewed) {
+      throw new DiscoveryConflictError('This package was previously deployed. Review it in Inventory, or choose Add a second copy anyway in the Deployment list. This does not confirm that a previous copy still exists or installed on computers.');
+    }
+    // An old cart's blanket force flag must not bypass a history row inserted after this read.
+    if (item.forceCreate === true && !reviewed && !item.replacesIntuneAppId) item.forceCreate = false;
+  }
+}
diff --git a/lib/discovery-state.ts b/lib/discovery-state.ts
new file mode 100644
index 000000000..598a750c7
--- /dev/null
+++ b/lib/discovery-state.ts
@@ -0,0 +1,46 @@
+/** Browser-safe identities. Display names, publishers and detected version IDs are not package identities. */
+export function packageKey(value: unknown): string | null {
+  return typeof value === 'string' && /^[a-z0-9][a-z0-9._+-]{0,199}$/i.test(value.trim())
+    ? value.trim().toLowerCase() : null;
+}
+
+export interface DiscoveryProvenance {
+  tenantId: string;
+  discoveredAppId: string;
+  packageId: string;
+  claimId: string;
+}
+
+export interface PackageManagementState {
+  packageId: string;
+  /** A deployment job is queued/running, independently of any older live copies. */
+  activeJobId?: string;
+  activeStatus?: string;
+  /** A cancelled/failed upload or lost completion may have left an Intune object. */
+  unconfirmedAttempt?: boolean;
+  /** Only a successful, identity-checked Graph read makes a copy verified. */
+  state: 'none' | 'previously_deployed' | 'verified' | 'deleted' | 'unverified';
+  copies: { intuneAppId: string; version: string; state: 'present' | 'absent' | 'unknown' }[];
+  checkedAt: string;
+}
+
+export function managementLabel(state?: PackageManagementState): string {
+  if (!state) return 'Deployment state unavailable';
+  if (state.activeJobId) return 'Deployment queued or running';
+  if (state.unconfirmedAttempt) return 'Deployment outcome needs review';
+  if (state.state === 'verified') return 'Verified in Intune';
+  if (state.state === 'deleted') return 'Previous copies removed from Intune';
+  if (state.state === 'unverified') return 'Previous deployment not verified';
+  if (state.state === 'previously_deployed') return 'Previously deployed';
+  return '';
+}
+
+/** Claim is a staging action, never adoption of an existing Intune object. */
+export function canStageDiscovery(state?: PackageManagementState): boolean {
+  return !!state && state.state === 'none' && !state.activeJobId && !state.unconfirmedAttempt;
+}
+
+export function reviewAcknowledged(item: { wingetId: string; forceCreate?: boolean; deploymentReview?: { tenantId: string; packageId: string }; replacesIntuneAppId?: string }, tenantId: string | null, copies: readonly { intuneAppId: string }[] = []): boolean {
+  return !!tenantId && item.forceCreate === true && ((item.deploymentReview?.tenantId === tenantId && packageKey(item.deploymentReview.packageId) === packageKey(item.wingetId))
+    || (typeof item.replacesIntuneAppId === 'string' && copies.some(c => c.intuneAppId.toLowerCase() === item.replacesIntuneAppId!.toLowerCase())));
+}
