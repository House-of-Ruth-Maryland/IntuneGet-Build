+++ b/components/unmanaged/FlowSteps.tsx
@@ -0,0 +1,43 @@
+'use client';
+
+// HRM patch 0040: numbered steps for the install and remove flows on Discovered apps.
+import { cn } from '@/lib/utils';
+
+export interface FlowStep { title: string; detail?: string }
+
+export function FlowSteps({ steps, tone = 'install', current = 0, className }: {
+  steps: FlowStep[]; tone?: 'install' | 'remove'; current?: number; className?: string;
+}) {
+  const color = tone === 'remove'
+    ? { now: 'bg-status-error text-white', next: 'bg-status-error/10 text-status-error border border-status-error/30' }
+    : { now: 'bg-accent-cyan text-black', next: 'bg-accent-cyan/10 text-accent-cyan border border-accent-cyan/30' };
+  return (
+    <ol className={cn('space-y-3', className)}>
+      {steps.map((step, i) => (
+        <li key={step.title} className="flex gap-3">
+          <span className={cn('flex-shrink-0 w-6 h-6 rounded-full flex items-center justify-center text-xs font-bold', i === current ? color.now : color.next)}>
+            {i + 1}
+          </span>
+          <div className="min-w-0 pt-0.5">
+            <p className="text-sm font-medium text-text-primary">{step.title}{i === current && <span className="ml-2 text-xs font-normal text-text-muted">(this step)</span>}</p>
+            {step.detail && <p className="text-xs text-text-secondary mt-0.5">{step.detail}</p>}
+          </div>
+        </li>
+      ))}
+    </ol>
+  );
+}
+
+export const installSteps = (name: string): FlowStep[] => [
+  { title: 'Claim', detail: `Adds ${name} to the Deployment list. Claimed means it is waiting there. Nothing changes on computers yet.` },
+  { title: 'Choose groups in the Deployment list', detail: 'Required installs it automatically. Available lets staff install it from Company Portal.' },
+  { title: 'Deploy to Intune', detail: "IntuneGet packages it, adds it to Intune and assigns your groups. Computers in Required groups install IntuneGet's copy, including ones that already have it." },
+  { title: 'IntuneGet keeps it up to date', detail: 'New versions show under App updates, and the app appears in Inventory.' },
+];
+
+export const removeSteps = (name: string): FlowStep[] => [
+  { title: 'Add removal to Deployment list', detail: 'Nothing changes on computers yet.' },
+  { title: 'Check the groups in the Deployment list', detail: 'Every group must be Uninstall. All devices removes it everywhere it is found.' },
+  { title: 'Deploy to Intune', detail: `IntuneGet adds "${name} (uninstall only)" to Intune with those Uninstall groups.` },
+  { title: 'Watch it in Inventory, then delete it', detail: `Computers that have ${name} remove it when they check in. Inventory shows how many still have it. When none are left, press Delete from Intune.` },
+];
