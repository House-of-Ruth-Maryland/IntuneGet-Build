diff --git a/app/api/intune/discovery-state/route.test.ts b/app/api/intune/discovery-state/route.test.ts
new file mode 100644
index 000000000..86bf78676
--- /dev/null
+++ b/app/api/intune/discovery-state/route.test.ts
@@ -0,0 +1,32 @@
+import { beforeEach, expect, it, vi } from 'vitest';
+import { NextRequest } from 'next/server';
+const mocks = vi.hoisted(() => ({ user: { userId: 'staff', tenantId: 'home' } as { userId: string; tenantId: string } | null, hosted: false, read: vi.fn(), resolve: vi.fn() }));
+vi.mock('@/lib/auth-utils', () => ({ parseAccessToken: async () => mocks.user }));
+vi.mock('@/lib/supabase', () => ({ isSupabaseServerConfigured: () => mocks.hosted, createServerClient: () => ({}) }));
+vi.mock('@/lib/msp/tenant-resolution', () => ({ resolveTargetTenantId: mocks.resolve }));
+vi.mock('@/lib/discovery-management', () => ({ readDiscoveryManagement: mocks.read }));
+import { GET } from './route';
+const req = (tenant?: string) => new NextRequest('http://localhost/api/intune/discovery-state', { headers: tenant ? { 'X-MSP-Tenant-Id': tenant } : {} });
+beforeEach(() => { vi.clearAllMocks(); mocks.user = { userId: 'staff', tenantId: 'home' }; mocks.hosted = false; mocks.read.mockResolvedValue({}); });
+it('refuses unauthenticated and foreign local tenant reads before touching the database', async () => {
+  mocks.user = null;
+  expect((await GET(req())).status).toBe(401);
+  mocks.user = { userId: 'staff', tenantId: 'home' };
+  expect((await GET(req('other'))).status).toBe(403);
+  expect(mocks.read).not.toHaveBeenCalled();
+});
+it('uses the authorized MSP tenant and disables response caching', async () => {
+  mocks.hosted = true;
+  mocks.resolve.mockResolvedValue({ tenantId: 'customer', errorResponse: null });
+  const response = await GET(req('customer'));
+  expect(mocks.resolve).toHaveBeenCalledWith(expect.objectContaining({ tokenTenantId: 'home', requestedTenantId: 'customer' }));
+  expect(mocks.read).toHaveBeenCalledExactlyOnceWith('customer');
+  expect(response.headers.get('cache-control')).toBe('no-store');
+  expect((await response.json()).tenantId).toBe('customer');
+});
+it('fails closed on an unavailable history read without exposing database details', async () => {
+  mocks.read.mockRejectedValue(new Error('private connection detail'));
+  const response = await GET(req());
+  expect(response.status).toBe(503);
+  expect(await response.text()).not.toContain('private connection detail');
+});
diff --git a/app/api/intune/discovery-state/route.ts b/app/api/intune/discovery-state/route.ts
new file mode 100644
index 000000000..977716689
--- /dev/null
+++ b/app/api/intune/discovery-state/route.ts
@@ -0,0 +1,26 @@
+import { NextRequest, NextResponse } from 'next/server';
+import { parseAccessToken } from '@/lib/auth-utils';
+import { createServerClient, isSupabaseServerConfigured } from '@/lib/supabase';
+import { resolveTargetTenantId } from '@/lib/msp/tenant-resolution';
+import { readDiscoveryManagement } from '@/lib/discovery-management';
+
+/** Fresh deployment evidence, independently of the inventory scan/cache. No tenant mutations. */
+export async function GET(request: NextRequest) {
+  const headers = { 'Cache-Control': 'no-store' };
+  try {
+    const user = await parseAccessToken(request.headers.get('Authorization'));
+    if (!user) return NextResponse.json({ error: 'Authentication required' }, { status: 401, headers });
+    const requestedTenantId = request.headers.get('X-MSP-Tenant-Id');
+    if (!isSupabaseServerConfigured() && requestedTenantId && requestedTenantId !== user.tenantId) {
+      return NextResponse.json({ error: 'Not authorized to access other tenants' }, { status: 403, headers });
+    }
+    const resolved = isSupabaseServerConfigured() ? await resolveTargetTenantId({
+      supabase: createServerClient(), userId: user.userId, tokenTenantId: user.tenantId, requestedTenantId,
+    }) : { tenantId: user.tenantId, errorResponse: null };
+    if (resolved.errorResponse) return resolved.errorResponse;
+    const states = await readDiscoveryManagement(resolved.tenantId);
+    return NextResponse.json({ tenantId: resolved.tenantId, states, checkedAt: new Date().toISOString() }, { headers });
+  } catch {
+    return NextResponse.json({ error: 'Deployment state is unavailable. Check Deployments before adding another copy.' }, { status: 503, headers });
+  }
+}
