diff --git a/components/unmanaged/RemoveAppModal.tsx b/components/unmanaged/RemoveAppModal.tsx
new file mode 100644
index 000000000..0d8ff22bf
--- /dev/null
+++ b/components/unmanaged/RemoveAppModal.tsx
@@ -0,0 +1,136 @@
+'use client';
+
+// HRM patch 0040: guided removal of an app found on computers.
+import { useEffect, useState } from 'react';
+import { AlertTriangle, Loader2, Monitor, Trash2 } from 'lucide-react';
+import { Button } from '@/components/ui/button';
+import { Dialog, DialogContent, DialogDescription, DialogFooter, DialogHeader, DialogTitle } from '@/components/ui/dialog';
+import { AppIcon } from '@/components/AppIcon';
+import { FlowSteps, removeSteps } from './FlowSteps';
+import { REMOVAL_LABELS } from '@/lib/hrm/removal';
+import type { RemovalCheck, RemovalTarget } from '@/hooks/use-unmanaged-apps';
+import type { UnmanagedApp } from '@/types/unmanaged';
+
+interface Props {
+  app: UnmanagedApp;
+  onClose: () => void;
+  onCheck: (app: UnmanagedApp) => Promise<RemovalCheck>;
+  onConfirm: (app: UnmanagedApp, check: RemovalCheck, target: RemovalTarget) => void;
+  onLink: (app: UnmanagedApp) => void;
+}
+
+/** What staff can do when IntuneGet can't remove the app itself. */
+function alternatives(app: UnmanagedApp): string[] {
+  if (app.isStoreApp) return [
+    'In Intune, add it as a Microsoft Store app (new) and assign it to groups as Uninstall.',
+  ];
+  if (app.matchStatus !== 'matched') return [
+    'If it is in WinGet, use Link package to pick the right package, then press Remove from computers again.',
+    "Otherwise, remove it with a script in Intune (Devices, Scripts and remediations) or the vendor's own removal tool.",
+  ];
+  return ["Remove it with a script in Intune (Devices, Scripts and remediations) or the vendor's own removal tool."];
+}
+
+export function RemoveAppModal({ app, onClose, onCheck, onConfirm, onLink }: Props) {
+  const [check, setCheck] = useState<RemovalCheck | null>(null);
+  const [error, setError] = useState<string | null>(null);
+  const [target, setTarget] = useState<RemovalTarget>('allDevices');
+  const [confirmed, setConfirmed] = useState(false);
+  const inList = app.cartPurpose === 'install';
+
+  useEffect(() => {
+    let live = true;
+    if (inList) return;
+    onCheck(app).then((r) => { if (live) setCheck(r); }).catch((e) => { if (live) setError(e instanceof Error ? e.message : 'Try again.'); });
+    return () => { live = false; };
+  }, [app, onCheck, inList]);
+
+  const blocked = inList
+    ? { reason: 'It is claimed: it is in the Deployment list to be installed. Take it out of the Deployment list first.' }
+    : check && !check.ok ? check : null;
+
+  return (
+    <Dialog open onOpenChange={(open) => { if (!open) onClose(); }}>
+      <DialogContent className="max-w-lg mx-4">
+        <DialogHeader>
+          <DialogTitle>{REMOVAL_LABELS.remove}</DialogTitle>
+          <DialogDescription className="sr-only">Uninstall {app.displayName} from computers through Intune</DialogDescription>
+        </DialogHeader>
+
+        <div className="px-6 py-5 space-y-5 max-h-[70vh] overflow-y-auto">
+          <div className="flex items-center gap-4">
+            <AppIcon packageId={app.matchedPackageId || app.displayName} packageName={app.displayName} size="lg" />
+            <div className="min-w-0">
+              <h3 className="text-text-primary font-semibold truncate">{app.displayName}</h3>
+              <p className="text-text-secondary text-sm truncate">{app.publisher || 'Unknown publisher'}</p>
+              <p className="text-text-muted text-xs mt-1 flex items-center gap-1"><Monitor className="w-3.5 h-3.5" />Found on {app.deviceCount.toLocaleString()} {app.deviceCount === 1 ? 'computer' : 'computers'}</p>
+            </div>
+          </div>
+
+          {!blocked && !check && !error && (
+            <p className="flex items-center gap-2 text-sm text-text-secondary"><Loader2 className="w-4 h-4 animate-spin" />Checking whether IntuneGet can remove it…</p>
+          )}
+
+          {error && <p role="alert" className="text-sm text-status-error">{error}</p>}
+
+          {blocked && (
+            <div className="rounded-xl border border-status-warning/30 bg-status-warning/5 p-4 space-y-2">
+              <p className="text-sm font-medium text-text-primary flex items-center gap-2"><AlertTriangle className="w-4 h-4 text-status-warning" />IntuneGet can&apos;t remove this app</p>
+              <p className="text-sm text-text-secondary">{blocked.reason}</p>
+              {!inList && (
+                <>
+                  <p className="text-sm font-medium text-text-primary pt-1">What you can do instead</p>
+                  <ul className="list-disc pl-5 space-y-1 text-sm text-text-secondary">{alternatives(app).map((a) => <li key={a}>{a}</li>)}</ul>
+                </>
+              )}
+            </div>
+          )}
+
+          {check?.ok && (
+            <>
+              <div className="rounded-xl border border-overlay/10 bg-bg-elevated/50 p-4">
+                <h4 className="text-sm font-medium text-text-primary mb-3">How removing works</h4>
+                <FlowSteps steps={removeSteps(app.displayName)} tone="remove" />
+              </div>
+
+              <div className="rounded-xl border border-overlay/10 p-4 space-y-1 text-sm text-text-secondary">
+                <p className="font-medium text-text-primary">What gets removed</p>
+                <p>Each computer in the groups uninstalls the program named exactly &quot;{app.displayName}&quot;, using the program&apos;s own uninstaller.</p>
+                <p>Other products from the same publisher aren&apos;t touched. Copies installed for one user only aren&apos;t removed.</p>
+              </div>
+
+              <fieldset className="space-y-2">
+                <legend className="text-sm font-medium text-text-primary mb-1">Remove it from</legend>
+                <label className="flex items-start gap-2 text-sm text-text-primary">
+                  <input type="radio" name="removal-target" className="mt-1" checked={target === 'allDevices'} onChange={() => setTarget('allDevices')} />
+                  <span>All devices<span className="block text-xs text-text-secondary">For software HRM doesn&apos;t want anywhere.</span></span>
+                </label>
+                <label className="flex items-start gap-2 text-sm text-text-primary">
+                  <input type="radio" name="removal-target" className="mt-1" checked={target === 'choose'} onChange={() => setTarget('choose')} />
+                  <span>Groups I choose in the Deployment list<span className="block text-xs text-text-secondary">Every group you add there is set to Uninstall.</span></span>
+                </label>
+              </fieldset>
+
+              <label className="flex items-start gap-2 text-sm text-text-primary">
+                <input type="checkbox" className="mt-1" checked={confirmed} onChange={(e) => setConfirmed(e.target.checked)} />
+                {REMOVAL_LABELS.confirm}
+              </label>
+            </>
+          )}
+        </div>
+
+        <DialogFooter>
+          <Button type="button" variant="outline" onClick={onClose} className="border-overlay/10">{blocked ? 'Close' : 'Cancel'}</Button>
+          {blocked && !inList && !app.isStoreApp && app.matchStatus !== 'matched' && (
+            <Button type="button" variant="outline" onClick={() => { onClose(); onLink(app); }} className="border-overlay/10">Link package</Button>
+          )}
+          {check?.ok && (
+            <Button type="button" variant="destructive" disabled={!confirmed} onClick={() => onConfirm(app, check, target)}>
+              <Trash2 className="w-4 h-4 mr-2" />{REMOVAL_LABELS.add}
+            </Button>
+          )}
+        </DialogFooter>
+      </DialogContent>
+    </Dialog>
+  );
+}
