new file mode 100644
index 000000000..1689f5119
--- /dev/null
+++ b/lib/hrm/curated-refresh.ts
@@ -0,0 +1,43 @@
+/**
+ * HRM patch: a newer signed curated catalog from the data folder.
+ *
+ * The curated catalog is a signed list built into the image that expires
+ * 7 days after upstream signs it, so a self-hosted image stops serving it a
+ * week after its release. The VM downloads upstream's latest signed list
+ * daily (IntuneGet-Build deploy/intuneget-curated-refresh.sh) next to the
+ * database. This only reads that file; the caller still verifies its
+ * signature against the keys built into the image, and its expiry, and falls
+ * back to the built-in list when it doesn't verify.
+ */
+
+import { readFileSync, statSync } from 'fs';
+import path from 'path';
+
+const MAX_BYTES = 20 * 1024 * 1024;
+
+let cached: { file: string; mtimeMs: number; size: number; envelope: unknown } | null = null;
+
+export function refreshedCatalogPath(): string {
+  const dbPath = process.env.DATABASE_PATH || './data/intuneget.db';
+  return path.join(path.dirname(dbPath), 'curated-catalog.json');
+}
+
+/** The downloaded envelope, or null when there is none or it can't be read. */
+export function readRefreshedCatalog(): unknown | null {
+  const file = refreshedCatalogPath();
+  try {
+    const { mtimeMs, size } = statSync(file);
+    if (size > MAX_BYTES) return null;
+    if (cached && cached.file === file && cached.mtimeMs === mtimeMs && cached.size === size) return cached.envelope;
+    const envelope = JSON.parse(readFileSync(file, 'utf8'));
+    cached = { file, mtimeMs, size, envelope };
+    return envelope;
+  } catch {
+    return null;
+  }
+}
+
+/** Test hook. */
+export function resetRefreshedCatalogCache() {
+  cached = null;
+}
diff --git a/lib/hrm/removal-start.ts b/lib/hrm/removal-start.ts
new file mode 100644
index 000000000..23833c910
--- /dev/null
+++ b/lib/hrm/removal-start.ts
@@ -0,0 +1,60 @@
+/**
+ * HRM patch 0040: once a removal copy is in Intune, track it the same way as an app being retired
+ * (patch 0038). Inventory then shows "Removing this app" with live counts and Delete from Intune,
+ * updates and new deployments of the app are held, and Home leaves it out of install failures.
+ * Runs from the packaging callback; failures are logged and never fail the callback.
+ */
+import { removalOf } from './removal';
+import type { GraphAssignment } from './duplicates';
+
+interface Job { id: string; tenant_id: string | null; winget_id: string; version: string; display_name: string; user_email?: string | null; package_config: unknown }
+interface Deps {
+  sqlite: boolean;
+  token: (tenantId: string) => Promise<string | null>;
+  read: (token: string, appId: string) => Promise<{ displayName: string; version: string; rows: GraphAssignment[] }>;
+  store: {
+    reserve: (row: { id: string; tenant_id: string; app_id: string; winget_id: string | null; display_name: string; version: string;
+      saved_assignments: GraphAssignment[]; uninstall_assignments: GraphAssignment[]; purpose: 'removal'; started_by: string; started_at: string }) => void;
+    started: (tenant: string, id: string) => boolean;
+  };
+}
+
+export async function startRemovalTracking(job: Job, intuneAppId: string, deps?: Deps): Promise<'started' | 'skipped' | 'failed'> {
+  if (!removalOf(job.package_config) || !job.tenant_id) return 'skipped';
+  const d = deps ?? await defaultDeps();
+  if (!d.sqlite) return 'skipped';
+  try {
+    const token = await d.token(job.tenant_id);
+    if (!token) throw new Error('No Intune token');
+    const live = await d.read(token, intuneAppId);
+    const id = crypto.randomUUID();
+    d.store.reserve({
+      id, tenant_id: job.tenant_id, app_id: intuneAppId, winget_id: job.winget_id, display_name: live.displayName || job.display_name,
+      version: live.version || job.version, saved_assignments: [], uninstall_assignments: live.rows, purpose: 'removal',
+      started_by: job.user_email || 'a staff member', started_at: new Date().toISOString(),
+    });
+    d.store.started(job.tenant_id, id);
+    return 'started';
+  } catch (error) {
+    console.error(`[Removal] Could not start tracking for job ${job.id}:`, error instanceof Error ? error.message : error);
+    return 'failed';
+  }
+}
+
+async function defaultDeps(): Promise<Deps> {
+  const { isSqliteMode } = await import('@/lib/db');
+  if (!isSqliteMode()) return { sqlite: false } as Deps;
+  const { getServicePrincipalToken } = await import('@/lib/intune/graph-client');
+  const { pilotGraph } = await import('./pilot-graph');
+  const { sqliteRetirements } = await import('@/lib/db/sqlite');
+  return {
+    sqlite: true,
+    token: getServicePrincipalToken,
+    async read(token, appId) {
+      const graph = pilotGraph(token, fetch, 'Could not read the removal copy from Intune.');
+      const [app, rows] = await Promise.all([graph.app(appId), graph.assignments(appId)]);
+      return { displayName: app.displayName, version: app.displayVersion ?? '', rows };
+    },
+    store: sqliteRetirements,
+  };
+}
diff --git a/lib/hrm/removal.ts b/lib/hrm/removal.ts
new file mode 100644
index 000000000..65ad91dea
--- /dev/null
+++ b/lib/hrm/removal.ts
@@ -0,0 +1,125 @@
+/**
+ * HRM patch 0040: remove an app found on computers (Discovered apps → Remove from computers).
+ * Browser-safe helpers shared by the page, the Deployment list and the server.
+ *
+ * IntuneGet normally detects its apps by a registry marker that only its own installer writes,
+ * so an Uninstall assignment does nothing where the app was installed another way. A removal
+ * therefore gets its own detection: a script that looks for a program with exactly the name
+ * Intune reported on devices, in the machine-wide installed programs list. The uninstall uses
+ * the same exact name, so detection and uninstall always point at the same program.
+ */
+import type { CartItem, PackageAssignment } from '@/types/upload';
+import type { DetectionRule, ScriptDetectionRule } from '@/types/intune';
+
+export interface HrmRemoval {
+  /** The program name Intune reported on devices (Discovered apps). */
+  discoveredName: string;
+  /** How many devices reported it when it was added. Shown only. */
+  deviceCount?: number;
+}
+
+/** Added to the Intune app name, so a removal copy is never mistaken for a normal one. */
+export const REMOVAL_SUFFIX = ' (uninstall only)';
+export const REMOVAL_SCRIPT_HEADER = '# IntuneGet removal detection (HRM patch 0040)';
+
+export const REMOVAL_LABELS = {
+  remove: 'Remove from computers',
+  confirm: 'I understand this uninstalls the app from every computer in the groups I choose',
+  add: 'Add removal to Deployment list',
+  badge: 'Removal',
+  claimed: 'Claimed',
+  toRemove: 'To remove',
+} as const;
+
+/** Control characters and Unicode line breaks folded to spaces, then trimmed, as the uninstall marker does. */
+export function normalizeRemovalName(name: unknown): string {
+  return typeof name === 'string' ? name.replace(/[\x00-\x1F\x7F-\x9F\u2028\u2029]+/g, ' ').trim() : '';
+}
+
+export function validRemovalName(name: unknown): boolean {
+  const value = normalizeRemovalName(name);
+  return value.length > 0 && value.length <= 200;
+}
+
+/**
+ * Why IntuneGet can't remove an app that uses this installer, or null when it can.
+ * MSI packages: the packager always uninstalls by the newest MSI's product code, which older
+ * installs don't have. Store, MSIX and portable apps aren't listed in installed programs the
+ * same way. Per-user packages: Intune runs the uninstall as the system account, which can't
+ * see a single user's programs.
+ */
+export function removalBlockReason(installer: { type?: string | null; nestedInstallerType?: string | null; scope?: string | null }): string | null {
+  const type = (installer.nestedInstallerType || installer.type || '').toLowerCase();
+  if (type === 'msi' || type === 'wix') return 'This app uses an MSI installer. IntuneGet can only uninstall the exact MSI version it deploys, so older copies on computers would stay.';
+  if (type === 'msix' || type === 'appx') return 'This app is an MSIX package, which IntuneGet can\'t remove from computers it didn\'t install it on.';
+  if (type === 'portable' || (installer.type || '').toLowerCase() === 'zip') return 'This app has no installer that Windows lists under installed programs, so there is nothing for Intune to uninstall.';
+  if ((installer.scope || '').toLowerCase() === 'user') return 'This package installs for one user at a time. Intune uninstalls as the system account, which can\'t see one user\'s programs.';
+  if (!['exe', 'inno', 'nullsoft', 'burn'].includes(type)) return 'IntuneGet can\'t remove apps with this kind of installer.';
+  return null;
+}
+
+/** Problems with the groups of a removal. Empty when it can deploy. */
+export function removalGroupProblems(assignments: PackageAssignment[] | undefined): string[] {
+  const list = assignments ?? [];
+  const problems: string[] = [];
+  if (!list.some((a) => a.type !== 'exclusionGroup')) problems.push('Choose at least one group to remove it from.');
+  if (list.some((a) => a.type !== 'exclusionGroup' && a.intent !== 'uninstall')) problems.push('Every group must be set to Uninstall.');
+  return problems;
+}
+
+/** PowerShell single-quoted text. PowerShell also ends single-quoted strings at U+2018 to U+201B. */
+function psQuoted(value: string): string {
+  return value.replace(/['\u2018-\u201B]/g, (q) => q + q);
+}
+
+/**
+ * Detection script: "installed" only when a removable program with exactly this name is in the
+ * machine-wide installed programs list (64-bit and 32-bit). Hidden system components and entries
+ * without an uninstall command are skipped, because the uninstall can't remove them either.
+ */
+export function removalDetectionScript(name: string): string {
+  const exact = normalizeRemovalName(name);
+  return [
+    REMOVAL_SCRIPT_HEADER,
+    `$name = '${psQuoted(exact)}'`,
+    "$paths = @('HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Uninstall', 'HKLM:\\SOFTWARE\\WOW6432Node\\Microsoft\\Windows\\CurrentVersion\\Uninstall')",
+    'foreach ($path in $paths) {',
+    '    foreach ($key in @(Get-ChildItem -LiteralPath $path -ErrorAction SilentlyContinue)) {',
+    '        $entry = Get-ItemProperty -LiteralPath $key.PSPath -ErrorAction SilentlyContinue',
+    '        if (-not $entry -or [string]$entry.DisplayName -ine $name) { continue }',
+    '        if ([string]$entry.SystemComponent -eq \'1\') { continue }',
+    '        if ([string]::IsNullOrWhiteSpace([string]$entry.QuietUninstallString) -and [string]::IsNullOrWhiteSpace([string]$entry.UninstallString)) { continue }',
+    "        Write-Output 'Installed'",
+    '        exit 0',
+    '    }',
+    '}',
+    'exit 0',
+  ].join('\r\n');
+}
+
+export function removalDetectionRules(name: string): DetectionRule[] {
+  return [{ type: 'script', scriptContent: removalDetectionScript(name), enforceSignatureCheck: false, runAs32Bit: false } as ScriptDetectionRule];
+}
+
+/** The packager's exact-name uninstall: finds the program by this name and runs its own uninstall. */
+export function removalUninstallCommand(name: string): string {
+  return `REGISTRY_UNINSTALL:${normalizeRemovalName(name)}`;
+}
+
+export function removalDisplayName(name: string): string {
+  const base = normalizeRemovalName(name).replace(/\s*\(uninstall only\)$/i, '');
+  return `${base}${REMOVAL_SUFFIX}`;
+}
+
+/** The removal details of a cart item or a stored package config, if it is a removal. */
+export function removalOf(value: unknown): HrmRemoval | null {
+  if (!value || typeof value !== 'object') return null;
+  const removal = (value as { hrmRemoval?: unknown }).hrmRemoval;
+  if (!removal || typeof removal !== 'object') return null;
+  const name = (removal as { discoveredName?: unknown }).discoveredName;
+  if (!validRemovalName(name)) return null;
+  const count = (removal as { deviceCount?: unknown }).deviceCount;
+  return { discoveredName: normalizeRemovalName(name), ...(typeof count === 'number' && Number.isFinite(count) ? { deviceCount: count } : {}) };
+}
+
+export const isRemovalItem = (item: CartItem): boolean => removalOf(item) !== null;
diff --git a/lib/matching/__tests__/catalog-matcher.test.ts b/lib/matching/__tests__/catalog-matcher.test.ts
new file mode 100644
index 000000000..8f86d85e7
--- /dev/null
+++ b/lib/matching/__tests__/catalog-matcher.test.ts
@@ -0,0 +1,107 @@
+import { beforeEach, describe, expect, it, vi } from 'vitest';
+import type { CuratedAppMatch } from '@/lib/app-mappings';
+import type { GraphUnmanagedApp } from '@/types/unmanaged';
+
+const catalog = vi.hoisted(() => ({ search: vi.fn(), withWordSearch: true }));
+vi.mock('@/lib/catalog', () => ({
+  getCatalogSource: () => (catalog.withWordSearch ? { searchCuratedAppsByNameWords: catalog.search } : {}),
+}));
+
+import { isStoreApp, matchDiscoveredAppWithCatalog } from '../catalog-matcher';
+
+const entry = (wingetId: string, name: string, publisher: string): CuratedAppMatch => ({ wingetId, name, publisher, latestVersion: '1.0' });
+const CATALOG = [
+  entry('Intermedia.Unite', 'Intermedia Unite', 'Intermedia.net, Inc.'),
+  entry('Cisco.Webex', 'Webex', 'Cisco Systems, Inc'),
+  entry('Ubiquiti.UniFiOSServer', 'UniFi OS Server', 'Ubiquiti Inc.'),
+  entry('Adobe.Acrobat.Pro.2020', 'Adobe Acrobat 2020', 'Adobe Inc.'),
+  entry('Microsoft.VCRedist.2015+.arm64', 'Microsoft Visual C++ 2015-2022 Redistributable (Arm64)', 'Microsoft Corporation'),
+  entry('Microsoft.VCRedist.2015+.x64', 'Microsoft Visual C++ 2015-2022 Redistributable (x64)', 'Microsoft Corporation'),
+  entry('Contoso.Editor', 'Contoso Editor', 'Contoso Ltd'),
+  entry('Contoso.Editor.Preview', 'Contoso Editor', 'Contoso Ltd'),
+  entry('Fabrikam.Notes', 'Fabrikam Notes', 'Fabrikam'),
+];
+// Fake full-text search: every word must appear in the catalog name.
+const searchByWords = async (words: string[]) =>
+  CATALOG.filter((app) => words.every((word) => app.name.toLowerCase().replace(/[^a-z0-9]+/g, ' ').includes(word.replace(/[^a-z0-9]+/g, ' ').trim())));
+
+const app = (displayName: string, publisher: string | null = null): GraphUnmanagedApp =>
+  ({ id: `id-${displayName}`, displayName, publisher, version: '1.0', deviceCount: 1, platform: 'windows' }) as unknown as GraphUnmanagedApp;
+
+beforeEach(() => {
+  catalog.withWordSearch = true;
+  catalog.search.mockReset();
+  catalog.search.mockImplementation(searchByWords);
+});
+
+describe('Microsoft Store apps', () => {
+  it('recognises package-style names and certificate publishers', () => {
+    expect(isStoreApp(app('XeroxCorp.PrintExperience', 'CN=8D94148D-A6AB-4A8E-9DBF-1D4D1E2F1A2B'))).toBe(true);
+    expect(isStoreApp(app('AD2F1837.HPSupportAssistant', null))).toBe(true);
+    expect(isStoreApp(app('HP Support Assistant', 'CN=ED346674-0FA1-4272-85CE-3187C9C86E26'))).toBe(true);
+    expect(isStoreApp(app('Notepad++', 'Notepad++ Team'))).toBe(false);
+    expect(isStoreApp(app('Google Chrome', 'Google LLC'))).toBe(false);
+  });
+
+  it('marks them and never looks them up', async () => {
+    const result = await matchDiscoveredAppWithCatalog(app('XeroxCorp.PrintExperience', 'CN=8D94148D'));
+    expect(result).toMatchObject({ status: 'unmatched', isStoreApp: true, partialMatches: [] });
+    expect(catalog.search).not.toHaveBeenCalled();
+  });
+});
+
+describe('catalog matching', () => {
+  it('matches an app only the catalog knows, ignoring the version in its name', async () => {
+    const result = await matchDiscoveredAppWithCatalog(app('Intermedia Unite 2.33.58', 'Intermedia.net, Inc.'));
+    expect(result).toMatchObject({ status: 'matched', wingetId: 'Intermedia.Unite', confidence: 1, isStoreApp: false });
+  });
+
+  it('keeps exact built-in mappings without a catalog lookup', async () => {
+    const result = await matchDiscoveredAppWithCatalog(app('Google Chrome', 'Google LLC'));
+    expect(result).toMatchObject({ status: 'matched', wingetId: 'Google.Chrome', confidence: 1 });
+    expect(catalog.search).not.toHaveBeenCalled();
+  });
+
+  it('suggests instead of matching when two catalog entries are equally close', async () => {
+    const result = await matchDiscoveredAppWithCatalog(app('Contoso Editor', 'Contoso Ltd'));
+    expect(result.status).toBe('partial');
+    expect(result.partialMatches.map((m) => m.wingetId)).toEqual(expect.arrayContaining(['Contoso.Editor', 'Contoso.Editor.Preview']));
+  });
+
+  it('suggests instead of matching when the publisher is unknown or different', async () => {
+    expect((await matchDiscoveredAppWithCatalog(app('Fabrikam Notes', null))).status).toBe('partial');
+    expect((await matchDiscoveredAppWithCatalog(app('Fabrikam Notes', 'Someone Else'))).status).toBe('partial');
+    expect((await matchDiscoveredAppWithCatalog(app('Fabrikam Notes', 'Fabrikam'))).status).toBe('matched');
+  });
+
+  it('does not offer ARM-only packages for an x64 app', async () => {
+    const result = await matchDiscoveredAppWithCatalog(app('Microsoft Visual C++ 2015-2022 Redistributable (x64) - 14.40.33810', 'Microsoft Corporation'));
+    expect(result.partialMatches.map((m) => m.wingetId)).not.toContain('Microsoft.VCRedist.2015+.arm64');
+    expect(result.wingetId).toBe('Microsoft.VCRedist.2015+.x64');
+  });
+});
+
+describe('suggestions need a shared meaningful word', () => {
+  it('never suggests security agents for "UniFi Endpoint"', async () => {
+    const result = await matchDiscoveredAppWithCatalog(app('UniFi Endpoint', 'Ubiquiti Inc'));
+    const ids = result.partialMatches.map((m) => m.wingetId);
+    expect(ids).not.toContain('McAfee.Agent');
+    expect(ids).not.toContain('Symantec.EndpointProtection');
+    expect(result.wingetId).not.toBe('McAfee.Agent');
+  });
+
+  it('works without a catalog word search (hosted catalog)', async () => {
+    catalog.withWordSearch = false;
+    const result = await matchDiscoveredAppWithCatalog(app('UniFi Endpoint', 'Ubiquiti Inc'));
+    expect(result).toMatchObject({ status: 'unmatched', isStoreApp: false });
+  });
+
+  it('carries on without the catalog when the lookup fails', async () => {
+    const warn = vi.spyOn(console, 'warn').mockImplementation(() => {});
+    catalog.search.mockRejectedValue(new Error('snapshot unavailable'));
+    const result = await matchDiscoveredAppWithCatalog(app('Intermedia Unite', 'Intermedia.net, Inc.'));
+    expect(result.status).toBe('unmatched');
+    expect(warn).toHaveBeenCalled();
+    warn.mockRestore();
+  });
+});
diff --git a/lib/matching/catalog-matcher.ts b/lib/matching/catalog-matcher.ts
new file mode 100644
index 000000000..c97a1106f
--- /dev/null
+++ b/lib/matching/catalog-matcher.ts
@@ -0,0 +1,164 @@
+/**
+ * Discovered Apps matching against the full catalog (HRM patch).
+ *
+ * Upstream matches discovered apps only against the ~90 built-in mappings, and
+ * scores suggestions by letter similarity ("UniFi Endpoint" vs "McAfee
+ * Endpoint" scores 67%). This wraps that matcher:
+ *   1. Microsoft Store apps are recognised and never matched to WinGet.
+ *   2. Exact built-in mappings still win.
+ *   3. Other apps are matched against the catalog by name words. A match is
+ *      automatic only when the names are identical, the publisher agrees and no
+ *      other candidate comes close; anything else becomes a suggestion.
+ *   4. Built-in suggestions are kept only when they share a meaningful word
+ *      with the app's name.
+ */
+
+import { getCatalogSource } from '@/lib/catalog';
+import type { CuratedAppMatch } from '@/lib/app-mappings';
+import type { GraphUnmanagedApp, PartialMatch } from '@/types/unmanaged';
+import { matchDiscoveredApp, normalizeAppName, normalizePublisher, type MatchResult } from './app-matcher';
+
+export interface CatalogMatchResult extends MatchResult {
+  isStoreApp: boolean;
+}
+
+// Words too common to identify an app on their own.
+const GENERIC_WORDS = new Set([
+  'microsoft', 'the', 'for', 'and', 'agent', 'client', 'endpoint', 'update', 'updater', 'tool', 'tools',
+  'service', 'services', 'driver', 'drivers', 'software', 'plugin', 'app', 'pro', 'dc', 'en', 'us',
+  'media', 'player', 'manager', 'suite', 'edition', 'runtime', 'support', 'assistant', 'helper',
+]);
+const AUTO_MATCH_MARGIN = 0.15;
+const SUGGESTION_MIN_SCORE = 0.6;
+const MAX_SUGGESTIONS = 3;
+const CANDIDATE_LIMIT = 25;
+
+const noMatch = (isStoreApp: boolean): CatalogMatchResult => ({
+  status: 'unmatched', wingetId: null, wingetName: null, confidence: 0, partialMatches: [], isStoreApp,
+});
+
+function words(text: string): string[] {
+  return text.toLowerCase().split(/[\s\-_.]+/).filter((word) => word.length >= 2);
+}
+
+function meaningfulWords(text: string): string[] {
+  return words(text).filter((word) => !GENERIC_WORDS.has(word));
+}
+
+/**
+ * Microsoft Store (MSIX) apps report a package-style name such as
+ * "XeroxCorp.PrintExperience" or a certificate subject ("CN=...") as publisher.
+ * IntuneGet deploys WinGet packages, so these can't be claimed here.
+ */
+export function isStoreApp(app: Pick<GraphUnmanagedApp, 'displayName' | 'publisher'>): boolean {
+  const name = app.displayName.trim();
+  const packageStyleName = /^[A-Za-z0-9]+(\.[A-Za-z0-9]+)+$/.test(name) && !/\s/.test(name);
+  return packageStyleName || /^CN=/i.test(app.publisher?.trim() || '');
+}
+
+function publisherAgrees(discovered: string | null, catalog: string): boolean {
+  const a = normalizePublisher(discovered).split(' ')[0];
+  const b = normalizePublisher(catalog).split(' ')[0];
+  return Boolean(a && b) && (a === b || a.startsWith(b) || b.startsWith(a));
+}
+
+// ARM-only packages aren't offered for apps whose name doesn't mention ARM.
+function isArmOnly(wingetId: string, appName: string): boolean {
+  return /(^|\.)arm(64)?($|\.)/i.test(wingetId) && !/\barm/i.test(appName);
+}
+
+interface ScoredCandidate { app: CuratedAppMatch; score: number; exact: boolean; publisherMatch: boolean }
+
+function scoreCandidate(name: string, publisher: string | null, candidate: CuratedAppMatch): ScoredCandidate {
+  const candidateName = normalizeAppName(candidate.name);
+  const nameWords = new Set(words(name));
+  const candidateWords = new Set(words(candidateName));
+  const shared = [...nameWords].filter((word) => candidateWords.has(word)).length;
+  const union = new Set([...nameWords, ...candidateWords]).size || 1;
+  const exact = candidateName === name;
+  const prefix = !exact && (candidateName.startsWith(`${name} `) || name.startsWith(`${candidateName} `));
+  const publisherMatch = publisherAgrees(publisher, candidate.publisher);
+  const score = (exact ? 1 : prefix ? 0.8 : shared / union) + (publisherMatch ? 0.15 : 0);
+  return { app: candidate, score, exact, publisherMatch };
+}
+
+function sharesMeaningfulWord(name: string, suggestion: PartialMatch): boolean {
+  const nameWords = new Set(meaningfulWords(name));
+  const suggestionWords = [...meaningfulWords(suggestion.name), ...meaningfulWords(suggestion.wingetId.split('.').slice(1).join(' '))];
+  return suggestionWords.some((word) => nameWords.has(word));
+}
+
+async function catalogCandidates(name: string): Promise<CuratedAppMatch[]> {
+  const catalog = getCatalogSource();
+  if (!catalog.searchCuratedAppsByNameWords) return [];
+  const key = meaningfulWords(name);
+  const searchWords = key.length > 0 ? key : words(name);
+  if (searchWords.length === 0) return [];
+  try {
+    return await catalog.searchCuratedAppsByNameWords(searchWords, CANDIDATE_LIMIT);
+  } catch (error) {
+    console.warn('[Discovered apps] Catalog lookup failed:', error instanceof Error ? error.message : error);
+    return [];
+  }
+}
+
+/**
+ * Match one discovered app: built-in mappings, then the catalog, with
+ * suggestions only where a meaningful word is shared.
+ */
+export async function matchDiscoveredAppWithCatalog(app: GraphUnmanagedApp): Promise<CatalogMatchResult> {
+  if (isStoreApp(app)) return noMatch(true);
+
+  const builtIn = matchDiscoveredApp(app);
+  if (builtIn.status === 'matched' && builtIn.confidence >= 1) return { ...builtIn, isStoreApp: false };
+
+  const name = normalizeAppName(app.displayName);
+  const scored = (await catalogCandidates(name))
+    .filter((candidate) => !isArmOnly(candidate.wingetId, app.displayName))
+    .map((candidate) => scoreCandidate(name, app.publisher, candidate))
+    .sort((a, b) => b.score - a.score);
+
+  const [best, runnerUp] = scored;
+  if (best && best.exact && best.publisherMatch && (!runnerUp || best.score - runnerUp.score >= AUTO_MATCH_MARGIN)) {
+    return {
+      status: 'matched',
+      wingetId: best.app.wingetId,
+      wingetName: best.app.name,
+      confidence: 1,
+      partialMatches: [],
+      isStoreApp: false,
+    };
+  }
+
+  const fromCatalog: PartialMatch[] = scored
+    .filter((candidate) => candidate.score >= SUGGESTION_MIN_SCORE)
+    .map((candidate) => ({
+      wingetId: candidate.app.wingetId,
+      name: candidate.app.name,
+      publisher: candidate.app.publisher,
+      version: candidate.app.latestVersion,
+      confidence: Math.min(candidate.score, 0.99),
+    }));
+  const builtInSuggestions: PartialMatch[] = [
+    ...(builtIn.wingetId && builtIn.status !== 'unmatched'
+      ? [{ wingetId: builtIn.wingetId, name: builtIn.wingetName || builtIn.wingetId, publisher: '', version: null, confidence: Math.min(builtIn.confidence, 0.99) }]
+      : []),
+    ...builtIn.partialMatches,
+  ].filter((suggestion) => sharesMeaningfulWord(name, suggestion));
+
+  const seen = new Set<string>();
+  const suggestions = [...fromCatalog, ...builtInSuggestions]
+    .sort((a, b) => b.confidence - a.confidence)
+    .filter((suggestion) => !seen.has(suggestion.wingetId.toLowerCase()) && seen.add(suggestion.wingetId.toLowerCase()))
+    .slice(0, MAX_SUGGESTIONS);
+
+  if (suggestions.length === 0) return noMatch(false);
+  return {
+    status: 'partial',
+    wingetId: suggestions[0].wingetId,
+    wingetName: suggestions[0].name,
+    confidence: suggestions[0].confidence,
+    partialMatches: suggestions,
+    isStoreApp: false,
+  };
+}
