+vi.hoisted(() => { const values = new Map<string, string>(); Object.defineProperty(globalThis, 'localStorage', { configurable: true, value: { getItem: (k: string) => values.get(k) || null, setItem: (k: string, v: string) => values.set(k, v), removeItem: (k: string) => values.delete(k) } }); });
+const session = vi.hoisted(() => ({ tenant: 'tenant', states: {} as Record<string, PackageManagementState>, claimOk: true, identity: 'Vendor.App' }));
+const auth = vi.hoisted(() => ({ isAuthenticated: true, user: { id: 'staff', tenantId: 'home' }, getAccessToken: vi.fn(async () => 'fixture') }));
+vi.mock('@/hooks/useMicrosoftAuth', () => ({ useMicrosoftAuth: () => auth }));
+vi.mock('@/hooks/useMspOptional', () => ({ useMspOptional: () => ({ isMspUser: true, selectedTenantId: session.tenant }) }));
+vi.mock('@/components/providers/UserSettingsProvider', () => ({ useUserSettings: () => ({ settings: { viewMode: 'grid' }, setViewMode: vi.fn() }) }));
+vi.mock('@/hooks/use-toast', () => ({ toast: vi.fn() }));
+import { useUnmanagedApps } from './use-unmanaged-apps';
+import { useCartStore } from '@/stores/cart-store';
+let root: Root;
+let current: ReturnType<typeof useUnmanagedApps>;
+const app = { id: 'row', discoveredAppId: 'version2', displayName: 'Fixture app', publisher: 'Fixture', version: '2', deviceCount: 2, platform: 'windows', matchStatus: 'matched', matchedPackageId: 'Vendor.App', matchedPackageName: 'Fixture app', matchConfidence: 1, isClaimed: false, lastSynced: '2026-01-01' };
+(globalThis as typeof globalThis & { IS_REACT_ACT_ENVIRONMENT: boolean }).IS_REACT_ACT_ENVIRONMENT = true;
+function Harness() {
+  const result = useUnmanagedApps();
+  useLayoutEffect(() => { current = result; }, [result]);
+  return null;
+}
+const settle = async () => { for (let n = 0; n < 3; n++) await act(async () => { await new Promise(r => setTimeout(r, 0)); }); };
+beforeEach(async () => {
+  Object.assign(session, { tenant: 'tenant', states: {}, claimOk: true, identity: 'Vendor.App' });
+  useCartStore.setState({ items: [], isOpen: false });
+  vi.stubGlobal('fetch', vi.fn(async (input: RequestInfo | URL) => {
+    const url = String(input);
+    if (url.includes('/unmanaged-apps')) return Response.json({ apps: [app], lastSynced: '2026-01-01', fromCache: true });
+    if (url.includes('/discovery-state')) return Response.json({ tenantId: session.tenant, states: session.states, checkedAt: '2026-01-01' });
+    if (url.includes('/manifest')) return Response.json({ manifest: { id: session.identity, name: 'Fixture app', version: '2' }, recommendedInstaller: { type: 'exe', architecture: 'x64', scope: 'machine', url: 'https://example.test/app.exe', sha256: 'a'.repeat(64) } });
+    if (url.includes('/claim')) return session.claimOk ? Response.json({ claim: { id: 'claim', tenantId: session.tenant, wingetPackageId: 'Vendor.App' } }) : Response.json({ error: 'Could not record claim' }, { status: 500 });
+    throw new Error('Unexpected request');
+  }));
+  root = createRoot(document.createElement('div'));
+  await act(async () => root.render(createElement(Harness)));
+  await settle();
+});
+afterEach(async () => { await act(async () => root.unmount()); useCartStore.setState({ items: [] }); vi.unstubAllGlobals(); });
+it('records provenance before staging, deduplicates repeated staging, and separates cart clearing from deployment state', async () => {
+  expect(current.fromCache).toBe(true);
+  expect(current.claimableCount).toBe(1);
+  await act(async () => { await current.handleClaimApp(current.filteredApps[0]); });
+  expect(useCartStore.getState().items[0].discovery).toEqual({ tenantId: 'tenant', discoveredAppId: 'version2', packageId: 'Vendor.App', claimId: 'claim' });
+  await act(async () => { await current.handleClaimApp(current.filteredApps[0]); });
+  expect(useCartStore.getState().items).toHaveLength(1);
+  session.states = { 'vendor.app': { packageId: 'vendor.app', state: 'none', copies: [], activeJobId: 'job', checkedAt: '2026-01-01' } };
+  await act(async () => { useCartStore.getState().clearCart(); window.dispatchEvent(new Event('focus')); });
+  await settle();
+  expect(current.filteredApps).toHaveLength(1);
+  expect(current.filteredApps[0].isClaimed).toBe(false);
+  expect(current.filteredApps[0].management?.activeJobId).toBe('job');
+  expect(current.claimableCount).toBe(0);
+});
+it('does not change the cart on claim failure or a manifest identity mismatch', async () => {
+  session.claimOk = false;
+  await act(async () => { await expect(current.handleClaimApp(current.filteredApps[0])).rejects.toThrow(); });
+  expect(useCartStore.getState().items).toHaveLength(0);
+  session.identity = 'Vendor.Other';
+  await act(async () => { await expect(current.handleClaimApp(current.filteredApps[0])).rejects.toThrow(/identity changed/); });
+  expect(useCartStore.getState().items).toHaveLength(0);
+});
+it('rechecks fresh tenant state before claiming even when cached inventory previously offered Claim', async () => {
+  session.states = { 'vendor.app': { packageId: 'vendor.app', state: 'verified', copies: [], checkedAt: '2026-01-01' } };
+  await act(async () => { await expect(current.handleClaimApp(current.filteredApps[0])).rejects.toThrow(/review/); });
+  expect(useCartStore.getState().items).toHaveLength(0);
+});
+it('rejects an old tenant modal after switching tenants and ignores foreign local cart entries', async () => {
+  const old = current.filteredApps[0];
+  session.tenant = 'other';
+  await act(async () => root.render(createElement(Harness)));
+  await settle();
+  await act(async () => { await expect(current.handleClaimApp(old)).rejects.toThrow(/review/); });
+  expect(useCartStore.getState().items).toHaveLength(0);
+});
