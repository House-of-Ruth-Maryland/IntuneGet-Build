index 000000000..85dab033b
--- /dev/null
+++ b/lib/__tests__/discovery-completion.test.ts
@@ -0,0 +1,73 @@
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { NextRequest } from 'next/server';
+vi.mock('@/lib/db', async () => { const { sqliteDb } = await vi.importActual<typeof import('@/lib/db/sqlite')>('@/lib/db/sqlite'); return { getDatabase: () => sqliteDb, isSqliteMode: () => true, verifyPackagerApiKey: () => true }; });
+vi.mock('@/lib/features', () => ({ getFeatureFlags: () => ({ localPackager: true }) }));
+vi.mock('@/lib/callback-signature', () => ({ verifyCallbackSignature: () => true }));
+vi.mock('@/lib/msp/batch-orchestrator', () => ({ onJobCompleted: vi.fn(async () => {}) }));
+vi.mock('@/lib/auto-update/cleanup', () => ({ handleAutoUpdateJobCompletion: vi.fn(async () => {}) }));
+vi.mock('@/lib/update-policies/ensure-policy', () => ({ parseCartUpdatePolicy: () => null, ensureUpdatePolicy: vi.fn() }));
+vi.mock('@/lib/installer-preflight', () => ({ quarantineInstaller: vi.fn() }));
+vi.mock('@/lib/notifications/notify-deployment', () => ({ notifyDeploymentWebhooks: vi.fn(async () => ({})) }));
+vi.mock('@/lib/supabase', () => ({ isSupabaseServerConfigured: () => false, createServerClient: () => ({ from: () => ({ delete: () => ({ eq: () => ({ eq: () => ({ eq: async () => ({ error: null }) }) }) }) }) }) }));
+import { closeSqliteDb, sqliteDb } from '@/lib/db/sqlite';
+import { POST as callback } from '@/app/api/package/callback/route';
+import { PATCH as local } from '@/app/api/packager/jobs/route';
+const APP = '11111111-1111-4111-8111-111111111111';
+beforeEach(() => { vi.stubEnv('DATABASE_MODE', 'sqlite'); vi.stubEnv('DATABASE_PATH', ':memory:'); vi.stubEnv('CALLBACK_SECRET', 'fixture'); closeSqliteDb(); });
+afterEach(() => { closeSqliteDb(); vi.restoreAllMocks(); vi.unstubAllEnvs(); });
+async function setup() {
+  const claim = await sqliteDb.claimedApps.upsert({ user_id: 'staff', tenant_id: 'tenant', discovered_app_id: 'detected', discovered_app_name: 'Fixture', winget_package_id: 'Vendor.App', device_count_at_claim: 1 });
+  const job = await sqliteDb.jobs.create({ user_id: 'staff', tenant_id: 'tenant', winget_id: 'Vendor.App', display_name: 'Fixture', version: '1', installer_type: 'exe', installer_url: 'https://example.test/app.exe', status: 'uploading', package_config: { discovery: { tenantId: 'tenant', discoveredAppId: 'detected', packageId: 'Vendor.App', claimId: claim.id } } });
+  await sqliteDb.jobs.update(job.id, { packager_id: 'packager' });
+  return job;
+}
+function send(kind: 'callback' | 'local', jobId: string, status = 'deployed', extra = {}) {
+  const req = new NextRequest('http://localhost/api/fixture', { method: kind === 'callback' ? 'POST' : 'PATCH', headers: { Authorization: 'Bearer fixture', 'X-Signature': 'fixture' }, body: JSON.stringify({ jobId, packagerId: 'packager', status, intuneAppId: APP, ...(kind==='callback'?{runId:'43',attemptId:'43-1'}:{}), ...extra }) });
+  return kind === 'callback' ? callback(req) : local(req);
+}
+for (const kind of ['callback', 'local'] as const) describe(`${kind} completion`, () => {
+  it('requires an Intune object ID before recording successful deployment', async () => {
+    const j = await setup();
+    expect((await send(kind, j.id, 'deployed', { intuneAppId: undefined })).status).toBe(400);
+    expect((await sqliteDb.jobs.getById(j.id))?.status).toBe('uploading');
+  });
+  it('links only the source claim once and ignores terminal regressions', async () => {
+    const j = await setup();
+    expect((await send(kind, j.id)).status).toBe(200);
+    expect((await sqliteDb.claimedApps.listByTenant('tenant'))[0]).toMatchObject({ status: 'deployed', intune_app_id: APP });
+    expect((await send(kind, j.id)).status).toBe(200);
+    await send(kind, j.id, 'failed');
+    expect((await sqliteDb.jobs.getById(j.id))?.status).toBe('deployed');
+    expect(await sqliteDb.uploadHistory.getByUserId('staff')).toHaveLength(1);
+  });
+  it('recovers a failed claim side effect on an idempotent terminal retry', async () => {
+    const j = await setup();
+    const update = vi.spyOn(sqliteDb.claimedApps, 'update').mockRejectedValueOnce(new Error('database busy'));
+    expect((await send(kind, j.id)).status).toBe(200);
+    expect((await sqliteDb.claimedApps.listByTenant('tenant'))[0].status).toBe('pending');
+    expect((await send(kind, j.id)).status).toBe(200);
+    expect((await sqliteDb.claimedApps.listByTenant('tenant'))[0].status).toBe('deployed');
+    expect(await sqliteDb.uploadHistory.getByUserId('staff')).toHaveLength(1);
+    update.mockRestore();
+  });
+  it('does not revive a cancelled job on a late deployed callback', async () => {
+    const j = await setup();
+    await sqliteDb.jobs.update(j.id, { status: 'cancelled' });
+    expect((await send(kind, j.id)).status).toBe(200);
+    expect((await sqliteDb.jobs.getById(j.id))?.status).toBe('cancelled');
+    expect((await sqliteDb.claimedApps.listByTenant('tenant'))[0].status).toBe('pending');
+    expect(await sqliteDb.uploadHistory.getByUserId('staff')).toHaveLength(0);
+  });
+});
+it('ignores a late local packaging report after upload has started', async () => {
+  const j = await setup();
+  expect((await send('local', j.id, 'uploading')).status).toBe(200);
+  expect((await send('local', j.id, 'packaging')).status).toBe(200);
+  expect((await sqliteDb.jobs.getById(j.id))?.status).toBe('uploading');
+  expect((await sqliteDb.jobs.getById(j.id))?.upload_started_at).toBeTruthy();
+});
+it('rejects another local packager before changing terminal or claim state', async () => {
+  const j = await setup();
+  expect((await send('local', j.id, 'deployed', { packagerId: 'someone-else' })).status).toBe(400);
+  expect((await sqliteDb.jobs.getById(j.id))?.status).toBe('uploading');
+});
diff --git a/lib/__tests__/discovery-management.test.ts b/lib/__tests__/discovery-management.test.ts
new file mode 100644
index 000000000..1aa3ecb9f
--- /dev/null
+++ b/lib/__tests__/discovery-management.test.ts
@@ -0,0 +1,209 @@
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { closeSqliteDb, sqliteDb } from '@/lib/db/sqlite';
+import { checkDiscoveryDispatch, readDiscoveryManagement, reconcileDiscoveryClaim, validateDiscoveryProvenance } from '@/lib/discovery-management';
+import { canStageDiscovery, managementLabel, packageKey, reviewAcknowledged } from '@/lib/discovery-state';
+import type { PackagingJob } from '@/lib/db/types';
+vi.mock('@/lib/graph-token', () => ({ acquireGraphToken: vi.fn(async () => ({ accessToken: 'fixture' })) }));
+
+const APP1 = '11111111-1111-4111-8111-111111111111';
+const APP2 = '22222222-2222-4222-8222-222222222222';
+const PROBE = vi.fn(async () => 'present' as const);
+beforeEach(() => { vi.stubEnv('DATABASE_MODE', 'sqlite'); vi.stubEnv('DATABASE_PATH', ':memory:'); closeSqliteDb(); PROBE.mockClear(); });
+afterEach(() => { closeSqliteDb(); vi.unstubAllEnvs(); vi.unstubAllGlobals(); });
+const job = (extra: Partial<PackagingJob> = {}) => sqliteDb.jobs.create({ user_id: 'staff', tenant_id: 'tenant', winget_id: 'Vendor.App', display_name: 'Fixture app', version: '1', installer_type: 'exe', installer_url: 'https://example.test/app.exe', status: 'queued', ...extra });
+const state = async (probe: (tenant: string, id: string) => Promise<'present' | 'absent' | 'unknown'> = PROBE) =>
+  (await readDiscoveryManagement('tenant', { db: sqliteDb, probe }))['vendor.app'];
+const item = { wingetId: 'VENDOR.APP', appSource: 'win32' };
+
+describe('tenant package deployment evidence', () => {
+  it('canonicalizes exact package identity and never names or publishers', () => {
+    expect(packageKey(' Vendor.App ')).toBe('vendor.app');
+    expect(packageKey('Vendor App')).toBeNull();
+    expect(packageKey(undefined)).toBeNull();
+  });
+  it('binds saved review acknowledgement to the current tenant and package', () => {
+    const reviewed = { ...item, forceCreate: true, deploymentReview: { tenantId: 'tenant', packageId: 'Vendor.App' } };
+    expect(reviewAcknowledged(reviewed, 'tenant')).toBe(true);
+    expect(reviewAcknowledged(reviewed, 'other')).toBe(false);
+    expect(reviewAcknowledged({ ...reviewed, wingetId: 'Vendor.Other' }, 'tenant')).toBe(false);
+    expect(reviewAcknowledged({ ...item, forceCreate: true }, 'tenant')).toBe(false);
+  });
+  it('separates queued jobs from previous or verified copies even after cart clearing', async () => {
+    await job();
+    const s = await state();
+    expect(s.state).toBe('none');
+    expect(s.activeJobId).toBeTruthy();
+    expect(managementLabel(s)).toBe('Deployment queued or running');
+    expect(canStageDiscovery(s)).toBe(false);
+    expect(PROBE).not.toHaveBeenCalled();
+    await expect(checkDiscoveryDispatch([{ ...item, forceCreate: true }], 'tenant', sqliteDb)).rejects.toThrow(/queued or running/);
+  });
+  it.each(['failed', 'cancelled', 'qa_failed', 'duplicate_skipped', 'completed'])('does not promote %s to deployed', async status => {
+    await job({ status, intune_app_id: APP1 });
+    const s = await state();
+    expect(s.state).toBe('none');
+    expect(s.activeJobId).toBeUndefined();
+    expect(canStageDiscovery(s)).toBe(true);
+    expect(PROBE).not.toHaveBeenCalled();
+    await expect(checkDiscoveryDispatch([item], 'tenant', sqliteDb)).resolves.toBeUndefined();
+  });
+  it('requires live presence, checks all versions, and retains dismissed deployment evidence', async () => {
+    const old = await job({ status: 'deployed' });
+    await sqliteDb.jobs.update(old.id, { intune_app_id: APP1, archived_at: '2026-01-01T00:00:00Z' });
+    const newer = await job({ status: 'deployed', version: '2' });
+    await sqliteDb.jobs.update(newer.id, { intune_app_id: APP2 });
+    const s = await state(async (_, id) => id === APP1 ? 'present' : 'absent');
+    expect(s.state).toBe('verified');
+    expect(s.copies).toHaveLength(2);
+    expect(s.copies.find(c => c.intuneAppId === APP1)?.version).toBe('1');
+    expect(canStageDiscovery(s)).toBe(false);
+    await expect(checkDiscoveryDispatch([item], 'tenant', sqliteDb)).rejects.toThrow(/previously deployed/);
+    await expect(checkDiscoveryDispatch([{ ...item, forceCreate: true }], 'tenant', sqliteDb)).rejects.toThrow(/previously deployed/);
+    await expect(checkDiscoveryDispatch([{ ...item, forceCreate: true, deploymentReview: { tenantId: 'other', packageId: 'Vendor.App' } }], 'tenant', sqliteDb)).rejects.toThrow(/previously deployed/);
+    await expect(checkDiscoveryDispatch([{ ...item, forceCreate: true, deploymentReview: { tenantId: 'tenant', packageId: 'Vendor.Other' } }], 'tenant', sqliteDb)).rejects.toThrow(/previously deployed/);
+    await expect(checkDiscoveryDispatch([{ ...item, forceCreate: true, replacesIntuneAppId: APP1 }], 'tenant', sqliteDb)).resolves.toBeUndefined();
+    await expect(checkDiscoveryDispatch([{ ...item, forceCreate: true, deploymentReview: { tenantId: 'tenant', packageId: 'Vendor.App' } }], 'tenant', sqliteDb)).resolves.toBeUndefined();
+    expect((await readDiscoveryManagement('other-tenant', { db: sqliteDb, probe: PROBE }))['vendor.app']).toBeUndefined();
+  });
+  it.each(['absent', 'unknown', 'throw'] as const)('keeps %s objects separate from verified management', async result => {
+    const j = await job({ status: 'deployed' });
+    await sqliteDb.jobs.update(j.id, { intune_app_id: APP1 });
+    const s = await state(async () => { if (result === 'throw') throw new Error('offline'); return result; });
+    expect(s.state).toBe(result === 'absent' ? 'deleted' : 'unverified');
+    expect(canStageDiscovery(s)).toBe(false);
+  });
+  it('keeps missing completion bookkeeping recoverable from the deployed job', async () => {
+    const j = await job({ status: 'deployed' });
+    await sqliteDb.jobs.update(j.id, { intune_app_id: APP1 });
+    expect(await sqliteDb.uploadHistory.getByUserId('staff')).toEqual([]);
+    expect((await state()).state).toBe('verified');
+    expect(canStageDiscovery(undefined)).toBe(false);
+  });
+  it('keeps orphaned historical copies unverified even when another recorded copy is deleted', async () => {
+    const j = await job({ status: 'deployed' });
+    await sqliteDb.jobs.update(j.id, { intune_app_id: APP1 });
+    await sqliteDb.uploadHistory.create({ user_id: 'staff', intune_tenant_id: 'tenant', winget_id: 'VENDOR.APP', version: '0.5', display_name: 'Fixture', intune_app_id: APP2 });
+    const s = await state(async () => 'absent');
+    expect(s.state).toBe('unverified');
