@@ -0,0 +1,162 @@
+/**
+ * HRM patch 0042: remove old copies of an app from Intune after an update has settled.
+ *
+ * Every update deploys a new Intune copy that supersedes the previous one and gets its groups; the previous
+ * copy stays in Intune with its groups. At each update check (3:30 AM and 3:30 PM), for each app IntuneGet
+ * deployed, older copies IntuneGet deployed are removed when all of these hold:
+ *   - the newest copy was deployed at least 7 days ago,
+ *   - the newest copy has at least 1 successful install and failures are 10% or less,
+ *   - no pilot, retirement, going back or deployment of the app is under way,
+ *   - the newest copy supersedes the old copy (directly or through other copies of the app),
+ *   - every group on the old copy is on the newest copy with the same intent and filter.
+ * Removing a copy takes its groups off, removes the links between copies of the app, and deletes it.
+ * Nothing is uninstalled: the newest copy has already replaced it on computers.
+ * A copy the newest doesn't supersede (deployed alongside, or a second copy) is left alone and not listed.
+ * A replaced copy with groups the newest lacks, or that Intune won't delete, is kept and listed on Home.
+ * Copies added in Intune by hand, and removal copies ("(uninstall only)", patch 0040), are never touched. HRM_OLD_COPY_CLEANUP=off turns this off.
+ */
+import { getServicePrincipalToken } from '@/lib/intune/graph-client';
+import { summarizeAssignments } from '@/lib/hrm/app-insights';
+import type { GraphAssignment } from '@/lib/hrm/duplicates';
+import { assign, loadCopy, relationships, unlinkAndDelete } from '@/lib/hrm/intune-copies';
+import { REMOVAL_SUFFIX } from '@/lib/hrm/removal';
+
+export const SETTLE_MS = 7 * 24 * 60 * 60 * 1000;
+export const MAX_REMOVALS_PER_RUN = 20;
+const RUN_BUDGET_MS = 90000;
+const CHAIN_LIMIT = 10;
+export const REMOVED_BY = 'Removed by IntuneGet: old copy after an update';
+
+/** One assignment as Intune applies it: target, group, filter and intent. */
+export function assignmentKey(a: GraphAssignment): string {
+  const t = a.target ?? {};
+  return [t['@odata.type'], t.groupId, t.deviceAndAppManagementAssignmentFilterId, t.deviceAndAppManagementAssignmentFilterType, a.intent]
+    .map((v) => String(v ?? '').toLowerCase()).join('|');
+}
+
+/** At least one computer installed the newest copy, and no more than 1 in 10 results are failures. */
+export function installsSettled(counts: { installed: number; failed: number } | null | undefined): boolean {
+  if (!counts || counts.installed < 1) return false;
+  return counts.failed * 10 <= counts.installed + counts.failed;
+}
+
+export type Verdict = { action: 'remove' } | { action: 'keep'; reason: string } | { action: 'skip' };
+
+/** Whether one older copy can go, given the newest copy's groups and the copies it supersedes. */
+export function judgeOldCopy(copy: { appId: string; assignments: GraphAssignment[] }, newest: { assignments: GraphAssignment[]; supersedes: Set<string> }): Verdict {
+  // Not replaced by the newest copy: deployed alongside or as a second copy on purpose. Left alone, not listed.
+  if (!newest.supersedes.has(copy.appId.toLowerCase())) return { action: 'skip' };
+  const newestKeys = new Set(newest.assignments.map(assignmentKey));
+  const extra = copy.assignments.filter((a) => !newestKeys.has(assignmentKey(a)));
+  if (extra.length > 0) {
+    return { action: 'keep', reason: `This copy has ${extra.length === 1 ? 'a group' : `${extra.length} groups`} the newest copy doesn't. In Inventory, press Keep this copy on the newest copy to move ${extra.length === 1 ? 'it' : 'them'}, then Delete from Intune on this one.` };
+  }
+  return { action: 'remove' };
+}
+
+/** The copies the newest one supersedes, following links only through these copies of the app; null if unreadable. */
+export async function supersededChain(token: string, newestId: string, copyIds: Set<string>): Promise<Set<string> | null> {
+  const found = new Set<string>();
+  let frontier = [newestId];
+  for (let depth = 0; depth < CHAIN_LIMIT && frontier.length > 0; depth++) {
+    const next: string[] = [];
+    for (const id of frontier) {
+      const links = await relationships(token, id);
+      if (!links) return null;
+      for (const r of links) {
+        const target = r.targetId.toLowerCase();
+        if (r.targetType !== 'child' || !String(r['@odata.type'] ?? '').toLowerCase().includes('supersedence')) continue;
+        if (!copyIds.has(target) || found.has(target)) continue;
+        found.add(target);
+        next.push(target);
+      }
+    }
+    frontier = next;
+  }
+  return found;
+}
+
+export interface CleanupSummary { checked: number; removed: number; kept: number; errors: number; disabled?: boolean }
+
+export async function runSqliteOldCopyCleanup(options: { now?: Date; token?: (tenantId: string) => Promise<string | null> } = {}): Promise<CleanupSummary> {
+  const summary: CleanupSummary = { checked: 0, removed: 0, kept: 0, errors: 0 };
+  if (process.env.HRM_OLD_COPY_CLEANUP?.trim().toLowerCase() === 'off') return { ...summary, disabled: true };
+  const { sqliteOldCopies, sqlitePilotRollouts, sqliteRetirements, sqliteRollbacks, sqliteInstallStatus, sqliteAppInsights } = await import('@/lib/db/sqlite');
+  const now = options.now ?? new Date();
+  const deadline = Date.now() + RUN_BUDGET_MS;
+  const tokens = new Map<string, Promise<string | null>>();
+  const note = (tenant: string, wingetId: string, app: { id: string; displayName: string; displayVersion?: string }, assignments: GraphAssignment[], exists: boolean) => {
+    try {
+      sqliteAppInsights.observe(tenant, { appId: app.id, wingetId, displayName: app.displayName, version: app.displayVersion ?? '', exists,
+        assignments: summarizeAssignments(assignments), checkedAt: new Date().toISOString() }, REMOVED_BY, true);
+    } catch { /* Activity is optional; the Intune change still stands. */ }
+  };
+
+  for (const newest of sqliteOldCopies.newest()) {
+    if (Date.now() > deadline || summary.removed >= MAX_REMOVALS_PER_RUN) break;
+    // Removal copies (patch 0040) uninstall an app; they are never part of an update chain.
+    const removal = (name: string) => name.toLowerCase().endsWith(REMOVAL_SUFFIX.toLowerCase());
+    if (removal(newest.displayName)) continue;
+    const older = sqliteOldCopies.older(newest.tenantId, newest.wingetId, newest.appId);
+    if (older.length === 0) continue;
+    // Settling: wait 7 days, for healthy installs, and while anything else is changing this app.
+    const deployed = Date.parse(newest.deployedAt.includes('T') ? newest.deployedAt : `${newest.deployedAt.replace(' ', 'T')}Z`);
+    if (!Number.isFinite(deployed) || now.getTime() - deployed < SETTLE_MS) continue;
+    if (sqlitePilotRollouts.active(newest.tenantId, newest.wingetId) || sqliteRetirements.holdsFamily(newest.tenantId, newest.wingetId)
+      || sqliteRollbacks.running(newest.tenantId, newest.wingetId)) continue;
+    if (!installsSettled(await sqliteInstallStatus.get(newest.tenantId, newest.appId))) continue;
+    if ([newest.appId, ...older.map((o) => o.appId)].some((id) => sqliteRetirements.holdsApp(newest.tenantId, id) || sqlitePilotRollouts.holdsApp(newest.tenantId, id))) continue;
+
+    summary.checked++;
+    try {
+      if (!tokens.has(newest.tenantId)) tokens.set(newest.tenantId, (options.token ?? getServicePrincipalToken)(newest.tenantId));
+      const token = await tokens.get(newest.tenantId);
+      if (!token) throw new Error('No token');
+      const current = await loadCopy(token, newest.appId);
+      if (!current) continue; // Deleted or unreadable: nothing to compare against.
+      const copies: Array<{ appId: string; version: string; app: NonNullable<Awaited<ReturnType<typeof loadCopy>>> }> = [];
+      for (const o of older) {
+        const loaded = await loadCopy(token, o.appId);
+        if (loaded && !removal(loaded.app.displayName)) copies.push({ appId: o.appId, version: o.version, app: loaded });
+        else if (loaded) continue;
+        else sqliteOldCopies.clear(newest.tenantId, o.appId); // Already gone (or not Win32): nothing to keep listing.
+      }
+      if (copies.length === 0) continue;
+      const family = new Set([newest.appId, ...copies.map((c) => c.appId)].map((id) => id.toLowerCase()));
+      const supersedes = await supersededChain(token, newest.appId, family);
+      if (!supersedes) throw new Error("Couldn't read supersedence");
+
+      const record = (c: (typeof copies)[number], outcome: 'removed' | 'kept', reason: string | null) => sqliteOldCopies.record({
+        tenant_id: newest.tenantId, app_id: c.appId, winget_id: newest.wingetId, display_name: c.app.app.displayName || newest.displayName,
+        version: c.app.app.displayVersion || c.version, newest_app_id: newest.appId, newest_version: newest.version, outcome, reason, at: now.toISOString() });
+
+      // Oldest first, so each delete only unlinks it from the next copy up the chain.
+      for (const c of copies) {
+        if (summary.removed >= MAX_REMOVALS_PER_RUN || Date.now() > deadline) break;
+        const verdict = judgeOldCopy({ appId: c.appId, assignments: c.app.assignments }, { assignments: current.assignments, supersedes });
+        if (verdict.action === 'skip') { sqliteOldCopies.clear(newest.tenantId, c.appId); continue; }
+        if (verdict.action === 'keep') { record(c, 'kept', verdict.reason); summary.kept++; continue; }
+        if (c.app.assignments.length > 0) {
+          if (!(await assign(token, c.appId, []))) {
+            record(c, 'kept', "Intune didn't accept removing this copy's groups. Nothing was changed. Try Keep this copy in Inventory.");
+            summary.kept++; continue;
+          }
+          note(newest.tenantId, newest.wingetId, c.app.app, [], true);
+        }
+        const deleted = await unlinkAndDelete(token, c.appId, family);
+        if (!deleted.ok) {
+          // Its groups are already on the newest copy, so leaving it empty changes nothing for computers.
+          record(c, 'kept', `Its groups were removed, but it wasn't deleted. ${deleted.reason.replace(/ Nothing was changed\.$/, '')}`);
+          summary.kept++; continue;
+        }
+        note(newest.tenantId, newest.wingetId, c.app.app, [], false);
+        record(c, 'removed', null);
+        summary.removed++;
+      }
+    } catch (error) {
+      summary.errors++;
+      console.warn(`[old copies] ${newest.wingetId}: ${error instanceof Error ? error.message.slice(0, 120) : 'failed'}`);
+    }
+  }
+  return summary;
+}
diff --git a/lib/hrm/old-copy-store.ts b/lib/hrm/old-copy-store.ts
