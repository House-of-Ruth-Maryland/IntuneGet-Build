+/**
+ * HRM patch 0042: Intune calls for copies of the same app, shared by duplicate cleanup (patches 0025 and
+ * 0026) and the automatic removal of old copies after an update.
+ *
+ * Intune won't delete an app that another app supersedes or depends on, so unlinkAndDelete first removes
+ * the links between copies of this same app (only those), and refuses if any other app links to it.
+ */
+import { GRAPH_API_BASE } from '@/lib/intune/graph-client';
+import type { GraphAssignment } from '@/lib/hrm/duplicates';
+
+/** Intune's own reason, short (app names and IDs only; never client data). */
+export async function intuneReason(response: Response): Promise<string> {
+  const body = (await response.json().catch(() => null)) as { error?: { message?: string } } | null;
+  const message = body?.error?.message?.split('\n')[0]?.trim();
+  return message ? ` Intune said: ${message.slice(0, 200)}` : '';
+}
+
+export interface Relationship {
+  '@odata.type'?: string;
+  targetId: string;
+  targetDisplayName?: string;
+  targetType?: 'child' | 'parent';
+  supersedenceType?: string;
+  dependencyType?: string;
+}
+
+/** The fields Intune's updateRelationships accepts for a relationship this app owns. */
+const toInput = (r: Relationship) => ({
+  '@odata.type': r['@odata.type'],
+  targetId: r.targetId,
+  ...(r.supersedenceType ? { supersedenceType: r.supersedenceType } : {}),
+  ...(r.dependencyType ? { dependencyType: r.dependencyType } : {}),
+});
+
+export interface GraphApp { id: string; displayName: string; displayVersion?: string; publisher: string | null; '@odata.type'?: string }
+
+export async function graph(token: string, path: string, init: RequestInit = {}) {
+  return fetch(`${GRAPH_API_BASE}${path}`, {
+    ...init,
+    headers: { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json', ...(init.headers ?? {}) },
+    cache: 'no-store',
+  });
+}
+
+/** A Win32 app copy and its assignments, or null when it's gone, isn't Win32, or couldn't be read. */
+export async function loadCopy(token: string, id: string): Promise<{ app: GraphApp; assignments: GraphAssignment[] } | null> {
+  const [appResponse, assignmentsResponse] = await Promise.all([
+    graph(token, `/deviceAppManagement/mobileApps/${id}`),
+    graph(token, `/deviceAppManagement/mobileApps/${id}/assignments`),
+  ]);
+  if (!appResponse.ok || !assignmentsResponse.ok) return null;
+  const app = (await appResponse.json()) as GraphApp;
+  if (app['@odata.type'] !== '#microsoft.graph.win32LobApp') return null;
+  const assignments = ((await assignmentsResponse.json()) as { value?: GraphAssignment[] }).value ?? [];
+  return { app, assignments };
+}
+
+// Relationships are a beta-only part of the Intune API.
+const BETA = () => GRAPH_API_BASE.replace(/\/v1\.0$/, '/beta');
+
+export async function relationships(token: string, id: string): Promise<Relationship[] | null> {
+  const response = await fetch(`${BETA()}/deviceAppManagement/mobileApps/${id}/relationships`, {
+    headers: { Authorization: `Bearer ${token}` },
+    cache: 'no-store',
+  });
+  if (!response.ok) return null;
+  return ((await response.json()) as { value?: Relationship[] }).value ?? [];
+}
+
+export async function setRelationships(token: string, id: string, owned: Relationship[]) {
+  return fetch(`${BETA()}/deviceAppManagement/mobileApps/${id}/updateRelationships`, {
+    method: 'POST',
+    headers: { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json' },
+    body: JSON.stringify({ relationships: owned.map(toInput) }),
+    cache: 'no-store',
+  });
+}
+
+export async function assign(token: string, id: string, assignments: GraphAssignment[]) {
+  const response = await graph(token, `/deviceAppManagement/mobileApps/${id}/assign`, {
+    method: 'POST',
+    body: JSON.stringify({ mobileAppAssignments: assignments }),
+  });
+  return response.ok;
+}
+
+export type DeleteResult = { ok: true; unlinked: string[] } | { ok: false; reason: string; status: 409 | 424 };
+
+/**
+ * Delete an emptied copy. copyIds are the copies of the same app (checked by the caller): links to and from
+ * them are removed first; a link from any other app stops the delete with nothing changed.
+ */
+export async function unlinkAndDelete(token: string, id: string, copyIds: Set<string>): Promise<DeleteResult> {
+  const links = await relationships(token, id);
+  if (!links) return { ok: false, reason: "Couldn't read this copy's links in Intune. Nothing was changed.", status: 424 };
+  const isCopy = (targetId: string) => copyIds.has(targetId.toLowerCase());
+  // Another app supersedes or depends on this copy: that's not ours to undo.
+  const outside = links.filter((r) => r.targetType === 'parent' && !isCopy(r.targetId));
+  if (outside.length > 0) {
+    const names = [...new Set(outside.map((r) => r.targetDisplayName || 'another app'))].join(', ');
+    return { ok: false, reason: `${names} replaces or depends on this copy, so Intune won't delete it. Remove that link in Intune first. Nothing was changed.`, status: 409 };
+  }
+  const unlinked: string[] = [];
+  // Copies that supersede (or depend on) this one: drop just that link, keep the rest.
+  for (const parent of links.filter((r) => r.targetType === 'parent')) {
+    const parentLinks = await relationships(token, parent.targetId);
+    if (!parentLinks) return { ok: false, reason: "Couldn't read the links on the other copy. Nothing was deleted.", status: 424 };
+    const owned = parentLinks.filter((r) => r.targetType === 'child');
+    const kept = owned.filter((r) => r.targetId.toLowerCase() !== id.toLowerCase());
+    if (kept.length === owned.length) continue;
+    const response = await setRelationships(token, parent.targetId, kept);
+    if (!response.ok) return { ok: false, reason: `Intune didn't remove the link from the other copy. Nothing was deleted.${await intuneReason(response)}`, status: 424 };
+    unlinked.push(parent.targetDisplayName || parent.targetId);
+  }
+  // This copy's own links (to older copies or other apps) go with it.
+  if (links.some((r) => r.targetType === 'child')) {
+    const response = await setRelationships(token, id, []);
+    if (!response.ok) return { ok: false, reason: `Intune didn't remove this copy's links. Nothing was deleted.${await intuneReason(response)}`, status: 424 };
+  }
+  const response = await graph(token, `/deviceAppManagement/mobileApps/${id}`, { method: 'DELETE' });
+  if (!response.ok) return { ok: false, reason: `Intune didn't delete it.${await intuneReason(response)}`, status: 424 };
+  return { ok: true, unlinked };
+}
