diff --git a/lib/hrm/__tests__/old-copy-cleanup.test.ts b/lib/hrm/__tests__/old-copy-cleanup.test.ts
new file mode 100644
index 000000000..cc31c93a3
--- /dev/null
+++ b/lib/hrm/__tests__/old-copy-cleanup.test.ts
@@ -0,0 +1,215 @@
+// HRM patch 0042: automatic removal of old copies after an update.
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import Database from 'better-sqlite3';
+import { runSqliteMigrations } from '@/lib/db/sqlite-migrations';
+import { createOldCopyStore } from '../old-copy-store';
+import { createPilotStore } from '../pilot-store';
+import { createRetireStore } from '../retire-store';
+import { createRollbackStore } from '../rollback-store';
+import { createAppInsightsStore } from '../app-insights-store';
+import type { GraphAssignment } from '../duplicates';
+
+const h = vi.hoisted(() => ({ db: null as unknown as import('better-sqlite3').Database, installs: new Map<string, { installed: number; failed: number }>() }));
+vi.mock('@/lib/intune/graph-client', () => ({ GRAPH_API_BASE: 'https://graph.microsoft.com/v1.0', getServicePrincipalToken: async () => 'token' }));
+vi.mock('@/lib/db/sqlite', async () => {
+  const getDb = () => h.db;
+  const { createOldCopyStore: oc } = await import('../old-copy-store');
+  const { createPilotStore: p } = await import('../pilot-store');
+  const { createRetireStore: r } = await import('../retire-store');
+  const { createRollbackStore: rb } = await import('../rollback-store');
+  const { createAppInsightsStore: ai } = await import('../app-insights-store');
+  return {
+    sqliteOldCopies: oc(getDb), sqlitePilotRollouts: p(getDb), sqliteRetirements: r(getDb), sqliteRollbacks: rb(getDb), sqliteAppInsights: ai(getDb),
+    sqliteInstallStatus: { get: async (_t: string, id: string) => h.installs.get(id.toLowerCase()) ?? null },
+  };
+});
+import { assignmentKey, installsSettled, judgeOldCopy, runSqliteOldCopyCleanup, SETTLE_MS } from '../old-copy-cleanup';
+
+const id = (n: number) => `${String(n).repeat(8)}-${String(n).repeat(4)}-4${String(n).repeat(3)}-8${String(n).repeat(3)}-${String(n).repeat(12)}`;
+const [V1, V2, V3, V4, OTHER] = [1, 2, 3, 4, 5].map(id);
+const G1 = 'aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa';
+const G2 = 'bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb';
+const group = (groupId: string, intent = 'required', extra: Record<string, unknown> = {}): GraphAssignment =>
+  ({ id: `${intent}-${groupId}`, intent, target: { '@odata.type': '#microsoft.graph.groupAssignmentTarget', groupId, ...extra } });
+const NOW = new Date('2026-11-20T08:30:00Z');
+const daysAgo = (d: number) => new Date(NOW.getTime() - d * 86400000).toISOString();
+
+// A small Intune: apps, their groups, and the supersedence links each app owns (parent -> children).
+interface FakeApp { displayName: string; displayVersion: string; assignments: GraphAssignment[] }
+let apps: Map<string, FakeApp>;
+let links: Map<string, string[]>;
+let calls: string[];
+function relationshipsOf(appId: string) {
+  const owned = (links.get(appId) ?? []).map((t) => ({ '@odata.type': '#microsoft.graph.mobileAppSupersedence', targetId: t, targetType: 'child', supersedenceType: 'update', targetDisplayName: apps.get(t)?.displayName }));
+  const parents = [...links].filter(([, kids]) => kids.includes(appId)).map(([p]) => ({ '@odata.type': '#microsoft.graph.mobileAppSupersedence', targetId: p, targetType: 'parent', supersedenceType: 'update', targetDisplayName: apps.get(p)?.displayName }));
+  return [...owned, ...parents];
+}
+const json = (body: unknown, status = 200) => new Response(JSON.stringify(body), { status, headers: { 'Content-Type': 'application/json' } });
+async function fakeGraph(input: RequestInfo | URL, init: RequestInit = {}) {
+  const url = String(input);
+  const method = init.method ?? 'GET';
+  calls.push(`${method} ${url.replace(/^https:\/\/graph\.microsoft\.com\/(v1\.0|beta)/, '')}`);
+  const m = url.match(/mobileApps\/([0-9a-f-]{36})(\/[a-zA-Z]+)?$/);
+  if (!m) return json({}, 404);
+  const [, appId, tail] = m;
+  const app = apps.get(appId);
+  if (!app) return json({ error: { message: 'Not found' } }, 404);
+  if (method === 'GET' && !tail) return json({ id: appId, '@odata.type': '#microsoft.graph.win32LobApp', publisher: 'Example', displayName: app.displayName, displayVersion: app.displayVersion });
+  if (method === 'GET' && tail === '/assignments') return json({ value: app.assignments });
+  if (method === 'GET' && tail === '/relationships') return json({ value: relationshipsOf(appId) });
+  if (method === 'POST' && tail === '/assign') { app.assignments = JSON.parse(String(init.body)).mobileAppAssignments; return new Response(null, { status: 204 }); }
+  if (method === 'POST' && tail === '/updateRelationships') { links.set(appId, JSON.parse(String(init.body)).relationships.map((r: { targetId: string }) => r.targetId)); return json({}); }
+  if (method === 'DELETE') {
+    if ([...links.values()].some((kids) => kids.includes(appId))) return json({ error: { message: 'App is superseded by another app' } }, 400);
+    apps.delete(appId); links.delete(appId); return new Response(null, { status: 204 });
+  }
+  return json({}, 400);
+}
+
+const deployed = (appId: string, version: string, at: string, wingetId = 'Example.PdfTool') =>
+  h.db.prepare(`INSERT INTO upload_history (id, user_id, winget_id, version, display_name, intune_app_id, intune_tenant_id, deployed_at) VALUES (?, 'staff', ?, ?, 'PDF tool', ?, 'tenant', ?)`)
+    .run(`h-${appId}-${version}`, wingetId, version, appId, at);
+
+beforeEach(() => {
+  h.db = new Database(':memory:'); runSqliteMigrations(h.db); h.installs.clear();
+  apps = new Map(); links = new Map(); calls = [];
+  vi.stubGlobal('fetch', vi.fn(fakeGraph));
+  delete process.env.HRM_OLD_COPY_CLEANUP;
+  // Four versions, each superseding the one before and keeping its group (what an update does).
+  [[V1, '0.17.0', 20], [V2, '0.18.0', 18], [V3, '0.18.2', 16], [V4, '0.19.0', 8]].forEach(([appId, version, days]) => {
+    apps.set(appId as string, { displayName: 'PDF tool', displayVersion: version as string, assignments: [group(G1)] });
+    deployed(appId as string, version as string, daysAgo(days as number));
+  });
+  links.set(V2, [V1]); links.set(V3, [V2]); links.set(V4, [V3]);
+  h.installs.set(V4, { installed: 40, failed: 1 });
+});
+afterEach(() => { vi.unstubAllGlobals(); h.db.close(); });
+
+describe('rules', () => {
+  it('compares target, group, filter and intent, ignoring case and assignment IDs', () => {
+    expect(assignmentKey(group(G1))).toBe(assignmentKey({ ...group(G1.toUpperCase()), id: 'x' }));
+    expect(assignmentKey(group(G1))).not.toBe(assignmentKey(group(G1, 'available')));
+    expect(assignmentKey(group(G1))).not.toBe(assignmentKey(group(G1, 'required', { deviceAndAppManagementAssignmentFilterId: G2, deviceAndAppManagementAssignmentFilterType: 'include' })));
+  });
+  it('needs at least one install and no more than 1 failure in 10', () => {
+    expect(installsSettled(null)).toBe(false);
+    expect(installsSettled({ installed: 0, failed: 0 })).toBe(false);
+    expect(installsSettled({ installed: 9, failed: 1 })).toBe(true);
+    expect(installsSettled({ installed: 8, failed: 2 })).toBe(false);
+  });
+  it('skips a copy the newest one does not supersede, and keeps one with groups the newest lacks', () => {
+    const newest = { assignments: [group(G1)], supersedes: new Set([V1]) };
+    expect(judgeOldCopy({ appId: V1.toUpperCase(), assignments: [group(G1)] }, newest)).toEqual({ action: 'remove' });
+    expect(judgeOldCopy({ appId: V1, assignments: [] }, newest)).toEqual({ action: 'remove' });
+    expect(judgeOldCopy({ appId: V2, assignments: [group(G1)] }, newest)).toEqual({ action: 'skip' });
+    expect(judgeOldCopy({ appId: V1, assignments: [group(G1), group(G2, 'available')] }, newest)).toMatchObject({ action: 'keep', reason: expect.stringMatching(/a group the newest copy doesn't/) });
+  });
+});
+
+describe('removing old copies at the update check', () => {
+  it('removes every older copy in the chain once the newest has settled, oldest first, and keeps the newest', async () => {
+    const result = await runSqliteOldCopyCleanup({ now: NOW });
+    expect(result).toMatchObject({ checked: 1, removed: 3, kept: 0, errors: 0 });
+    expect([...apps.keys()]).toEqual([V4]);
+    expect(apps.get(V4)!.assignments).toEqual([group(G1)]);
+    expect(links.get(V4)).toEqual([]);
+    const deletes = calls.filter((c) => c.startsWith('DELETE'));
+    expect(deletes).toEqual([V1, V2, V3].map((a) => `DELETE /deviceAppManagement/mobileApps/${a}`));
+    // Groups always come off before the delete, and never off the newest copy.
+    expect(calls.filter((c) => c.endsWith('/assign')).every((c) => !c.includes(V4))).toBe(true);
+    const store = createOldCopyStore(() => h.db);
+    expect(store.get('tenant', V1)).toMatchObject({ outcome: 'removed', newest_app_id: V4, newest_version: '0.19.0' });
+    expect(store.kept('tenant')).toEqual([]);
+    // The app's activity timeline says IntuneGet removed it.
+    const activity = createAppInsightsStore(() => h.db).activity('tenant', 'Example.PdfTool');
+    expect(activity.some((a) => a.actor.startsWith('Removed by IntuneGet'))).toBe(true);
+  });
+
+  it('waits 7 days after the newest copy deployed', async () => {
+    h.db.prepare('UPDATE upload_history SET deployed_at = ? WHERE intune_app_id = ?').run(new Date(NOW.getTime() - SETTLE_MS + 60000).toISOString(), V4);
+    expect(await runSqliteOldCopyCleanup({ now: NOW })).toMatchObject({ checked: 0, removed: 0 });
+    expect(apps.size).toBe(4);
+    expect(calls).toEqual([]);
+  });
+
+  it('waits for installs: none yet, no counts, or more than 1 failure in 10', async () => {
+    for (const counts of [{ installed: 0, failed: 0 }, undefined, { installed: 5, failed: 3 }]) {
+      if (counts) h.installs.set(V4, counts); else h.installs.delete(V4);
+      expect(await runSqliteOldCopyCleanup({ now: NOW })).toMatchObject({ removed: 0 });
+    }
+    expect(apps.size).toBe(4);
+  });
+
+  it('waits while a deployment, pilot or retirement of the app is under way', async () => {
+    h.db.prepare(`INSERT INTO packaging_jobs (id,user_id,tenant_id,winget_id,version,display_name,installer_type,installer_url,package_config,status) VALUES ('j1','staff','tenant','example.pdftool','0.20.0','PDF tool','exe','https://example.invalid/a.exe','{}','packaging')`).run();
+    expect(await runSqliteOldCopyCleanup({ now: NOW })).toMatchObject({ removed: 0 });
+    expect(apps.size).toBe(4);
+  });
+
+  it('is off with HRM_OLD_COPY_CLEANUP=off', async () => {
+    process.env.HRM_OLD_COPY_CLEANUP = 'off';
+    expect(await runSqliteOldCopyCleanup({ now: NOW })).toMatchObject({ disabled: true, removed: 0 });
+    expect(calls).toEqual([]);
+  });
+
+  it('keeps and lists a copy with a group the newest lacks, and still removes the others', async () => {
+    apps.get(V2)!.assignments = [group(G1), group(G2, 'available')];
+    const result = await runSqliteOldCopyCleanup({ now: NOW });
+    expect(result).toMatchObject({ removed: 2, kept: 1 });
+    expect([...apps.keys()].sort()).toEqual([V2, V4].sort());
+    expect(apps.get(V2)!.assignments).toHaveLength(2);
+    const kept = createOldCopyStore(() => h.db).kept('tenant');
+    expect(kept).toEqual([expect.objectContaining({ app_id: V2, version: '0.18.0', newest_app_id: V4, reason: expect.stringMatching(/Keep this copy/) })]);
+  });
+
+  it('leaves a copy deployed alongside (not superseded) alone, and does not list it on Home', async () => {
+    links.set(V2, []); // V1 is no longer reached from the newest copy.
+    const result = await runSqliteOldCopyCleanup({ now: NOW });
+    expect(result).toMatchObject({ removed: 2, kept: 0 });
+    expect(apps.has(V1)).toBe(true);
+    expect(apps.get(V1)!.assignments).toEqual([group(G1)]);
+    expect(createOldCopyStore(() => h.db).kept('tenant')).toEqual([]);
+  });
+
+  it("never deletes a copy another app supersedes, and says so on Home", async () => {
+    apps.set(OTHER, { displayName: 'Other tool', displayVersion: '1.0', assignments: [] });
+    links.set(OTHER, [V1]);
+    const result = await runSqliteOldCopyCleanup({ now: NOW });
+    expect(apps.has(V1)).toBe(true);
+    expect(links.get(OTHER)).toEqual([V1]);
+    expect(result.kept).toBe(1);
+    expect(createOldCopyStore(() => h.db).get('tenant', V1)).toMatchObject({ outcome: 'kept', reason: expect.stringMatching(/Other tool replaces or depends on this copy/) });
+  });
+
+  it('never touches apps added in Intune by hand, even when the newest copy supersedes them', async () => {
+    apps.set(OTHER, { displayName: 'PDF tool', displayVersion: '0.16.0', assignments: [group(G1)] });
+    links.set(V1, [OTHER]);
+    await runSqliteOldCopyCleanup({ now: NOW });
+    expect(apps.has(OTHER)).toBe(true);
+    expect(calls.some((c) => c.includes(OTHER) && !c.startsWith('GET'))).toBe(false);
+  });
+
+  it('never touches a removal copy (uninstall only) of the app', async () => {
+    apps.get(V1)!.displayName = 'PDF tool (uninstall only)';
+    await runSqliteOldCopyCleanup({ now: NOW });
+    expect(apps.has(V1)).toBe(true);
+    expect(calls.some((c) => c.includes(V1) && !c.startsWith('GET'))).toBe(false);
+  });
+
+  it('forgets a kept copy once someone has removed it', async () => {
+    apps.get(V2)!.assignments = [group(G1), group(G2, 'available')];
+    await runSqliteOldCopyCleanup({ now: NOW });
+    apps.delete(V2); links.set(V3, []);
+    await runSqliteOldCopyCleanup({ now: NOW });
+    expect(createOldCopyStore(() => h.db).kept('tenant')).toEqual([]);
+  });
+
+  it('does nothing when the newest copy is gone from Intune', async () => {
+    apps.delete(V4); links.delete(V4);
+    expect(await runSqliteOldCopyCleanup({ now: NOW })).toMatchObject({ removed: 0, kept: 0 });
+    expect(apps.size).toBe(3);
+  });
+});
+
+// The unused store imports keep the mocked module's factories type-checked against the real ones.
+void createPilotStore; void createRetireStore; void createRollbackStore;
