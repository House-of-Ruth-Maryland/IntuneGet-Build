index 000000000..4e0016912
--- /dev/null
+++ b/lib/hrm/old-copy-store.ts
@@ -0,0 +1,48 @@
+/**
+ * HRM patch 0042: what the automatic removal of old copies did with each older copy IntuneGet deployed.
+ * 'removed' copies are gone from Intune; 'kept' copies need a person (the reason says why).
+ */
+import type Database from 'better-sqlite3';
+
+export type OldCopyOutcome = 'removed' | 'kept';
+export interface OldCopyRecord {
+  tenant_id: string; app_id: string; winget_id: string; display_name: string; version: string;
+  newest_app_id: string; newest_version: string; outcome: OldCopyOutcome; reason: string | null; at: string;
+}
+export interface NewestDeployment { tenantId: string; wingetId: string; appId: string; displayName: string; version: string; deployedAt: string }
+export interface OlderCopy { appId: string; version: string; deployedAt: string }
+
+export function createOldCopyStore(getDb: () => Database.Database) {
+  return {
+    record(row: OldCopyRecord) {
+      getDb().prepare(`INSERT INTO hrm_old_copy_cleanup (tenant_id, app_id, winget_id, display_name, version, newest_app_id, newest_version, outcome, reason, at)
+        VALUES (?,?,?,?,?,?,?,?,?,?)
+        ON CONFLICT (tenant_id, app_id) DO UPDATE SET winget_id = excluded.winget_id, display_name = excluded.display_name, version = excluded.version,
+          newest_app_id = excluded.newest_app_id, newest_version = excluded.newest_version, outcome = excluded.outcome, reason = excluded.reason, at = excluded.at`)
+        .run(row.tenant_id, row.app_id, row.winget_id, row.display_name, row.version, row.newest_app_id, row.newest_version, row.outcome, row.reason, row.at);
+    },
+    get(tenant: string, appId: string): OldCopyRecord | null {
+      return (getDb().prepare('SELECT * FROM hrm_old_copy_cleanup WHERE tenant_id = ? AND app_id = ? COLLATE NOCASE').get(tenant, appId) as OldCopyRecord) ?? null;
+    },
+    /** A copy that is no longer waiting to be removed (someone tidied it, or it became the newest). */
+    clear(tenant: string, appId: string) { getDb().prepare("DELETE FROM hrm_old_copy_cleanup WHERE tenant_id = ? AND app_id = ? COLLATE NOCASE AND outcome = 'kept'").run(tenant, appId); },
+    /** Older copies IntuneGet couldn't remove, newest first (for Home). */
+    kept(tenant: string): OldCopyRecord[] {
+      return getDb().prepare("SELECT * FROM hrm_old_copy_cleanup WHERE tenant_id = ? AND outcome = 'kept' ORDER BY at DESC LIMIT 50").all(tenant) as OldCopyRecord[];
+    },
+    /** The newest IntuneGet deployment of every app, in every tenant. */
+    newest(): NewestDeployment[] {
+      return getDb().prepare(`SELECT h.intune_tenant_id AS tenantId, h.winget_id AS wingetId, h.intune_app_id AS appId, h.display_name AS displayName,
+          h.version, h.deployed_at AS deployedAt FROM upload_history h
+        WHERE h.intune_tenant_id IS NOT NULL AND h.id = (SELECT n.id FROM upload_history n WHERE n.intune_tenant_id = h.intune_tenant_id
+          AND n.winget_id = h.winget_id ORDER BY n.deployed_at DESC, n.id DESC LIMIT 1)`).all() as NewestDeployment[];
+    },
+    /** Every other Intune copy IntuneGet deployed of this app (one row per copy, oldest first). */
+    older(tenant: string, wingetId: string, newestAppId: string): OlderCopy[] {
+      return getDb().prepare(`SELECT intune_app_id AS appId, version, MAX(deployed_at) AS deployedAt FROM upload_history
+        WHERE intune_tenant_id = ? AND winget_id = ? AND intune_app_id != ? COLLATE NOCASE
+        GROUP BY lower(intune_app_id) ORDER BY deployedAt ASC LIMIT 20`).all(tenant, wingetId, newestAppId) as OlderCopy[];
+    },
+  };
+}
+export type OldCopyStore = ReturnType<typeof createOldCopyStore>;
