+++ b/hooks/usePilots.ts
@@ -0,0 +1,24 @@
+'use client';
+import { useMutation, useQuery, useQueryClient } from '@tanstack/react-query';
+import { useMicrosoftAuth } from './useMicrosoftAuth';
+import type { PilotView, PilotPreview } from '@/lib/hrm/pilot-types';
+export function usePilots() {
+  const { getAccessToken,isAuthenticated,account } = useMicrosoftAuth();
+  const client = useQueryClient();
+  const key = ['hrm','pilots',account?.tenantId,account?.localAccountId];
+  const request = async (body?: Record<string,unknown>) => {
+    const token = await getAccessToken();
+    if (!token) throw new Error('Sign in again to view pilots.');
+    const response = await fetch('/api/hrm/pilots',{ method: body ? 'POST' : 'GET', headers: { Authorization: `Bearer ${token}`, 'Content-Type':'application/json' }, ...(body ? { body:JSON.stringify(body) } : {}) });
+    if (response.redirected || !response.headers.get('content-type')?.includes('application/json')) throw new Error('Your sign-in expired. Reload and sign in again.');
+    const data = await response.json();
+    if (!response.ok) throw new Error(data.error || 'Could not load pilots.');
+    return data as { supported: boolean; pilots: PilotView[]; preview?: PilotPreview; started?: boolean; approved?: boolean; ended?: boolean };
+  };
+  const query = useQuery({ queryKey:key,queryFn:()=>request(),enabled:isAuthenticated,staleTime:15000,refetchInterval:30000 });
+  const action = useMutation({ mutationFn:request,onSuccess:async (data)=>{
+    if (data.preview) return;
+    await Promise.all([client.invalidateQueries({queryKey:key}),client.invalidateQueries({queryKey:['availableUpdates']}),client.invalidateQueries({queryKey:['hrm','app-insights']})]);
+  } });
+  return { ...query,action,getAccessToken };
+}
