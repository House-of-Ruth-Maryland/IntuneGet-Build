+      {action.error && <p role="alert" className="text-sm text-status-error">{action.error.message}</p>}
+      <Button disabled={!selected || action.isPending} onClick={()=>action.mutate({action:'start',wingetId:update.winget_id,appId:update.intune_app_id,groupId:selected!.id},{onSuccess:()=>setOpen(false)})}>{action.isPending?'Starting pilot…':'Deploy to pilot group'}</Button>
+    </DialogContent></Dialog>
+  </>;
+}
+function Counts({ label,counts }: {label:string;counts:InstallCounts}) {
+  return <div className="rounded-lg border border-overlay/10 bg-bg-elevated p-3 text-sm"><h4 className="font-medium text-text-primary">{label}</h4><p className="mt-1 text-text-secondary">{counts.installed} installed · {counts.failed} failed · {counts.pending} pending · {counts.notApplicable} not applicable · {counts.other} other</p>
+    {counts.installed===0 && <p className="mt-1 text-status-warning">No successful installations reported.</p>}
+    {counts.topErrors.map((e)=><p key={e.code} className="mt-1 text-status-error">{e.count} failed: {e.code} {e.description}</p>)}
+  </div>;
+}
+export function PilotRollouts() {
+  const {data,error,isLoading,refetch,action} = usePilots();
+  const [review,setReview] = useState<{row:PilotView;preview:PilotPreview}|null>(null);
+  const [confirmed,setConfirmed] = useState(false);
+  if (data?.supported===false) return null;
+  return <section aria-label="Pilot rollouts" className="rounded-xl border border-overlay/10 bg-bg-surface p-4 space-y-3">
+    <div className="flex items-center justify-between"><h2 className="font-semibold text-text-primary">Pilot rollouts</h2><button className={secondary} onClick={()=>{setReview(null);action.reset();void refetch();}}>Refresh</button></div>
+    <p className="text-sm text-text-secondary">Test an update with a small group, then approve the wider groups yourself. Nothing promotes automatically.</p>
+    {isLoading && <p className="text-sm text-text-muted">Loading pilots…</p>}
+    {error && <p role="alert" className="text-sm text-status-error">{error.message}</p>}
+    {action.error && <p role="alert" className="text-sm text-status-error">{action.error.message}</p>}
+    {data?.pilots.length===0 && <p className="text-sm text-text-muted">Choose Test with a pilot group on an update below.</p>}
+    <ul className="space-y-3">{data?.pilots.map((row)=><li key={row.id} className="rounded-lg border border-overlay/10 p-3 text-sm space-y-2">
+      <p className="font-medium text-text-primary">{row.display_name}: {row.previous_version} → {row.new_version || 'new version'}</p>
+      <p className="text-text-secondary">Pilot group: {row.group_name}. {row.phase==='complete'?(row.approved_by?'Wider rollout approved.':'Failed pilot ended.'):row.job_status==='deployed'?'Pilot deployed. Wider rollout awaits your approval.':`Deployment: ${row.job_status || 'starting'}. Other updates are held.`}</p>
+      {['failed','cancelled'].includes(row.job_status || '') && row.phase!=='complete' && <p className="text-status-warning">Packaging did not complete. Check Deployments. End failed pilot only releases the hold after the workflow has ended and no pilot copy remains in Intune.</p>}
+      <div className="flex flex-wrap gap-4"><a className={secondary} href="/dashboard/uploads">Open Deployments</a>
+        {row.phase!=='complete' && row.job_status==='deployed' && <button className={secondary} disabled={action.isPending} onClick={()=>{setReview(null);setConfirmed(false);action.mutate({action:'preview',id:row.id},{onSuccess:(r)=>{if(r.preview)setReview({row,preview:r.preview});}});}}>{action.isPending?'Reading Intune…':'Review results and wider rollout'}</button>}
+        {row.phase==='starting' && !row.job_id && <button className={secondary} disabled={action.isPending} onClick={()=>action.mutate({action:'endFailed',id:row.id})}>End stalled start (after 2 minutes)</button>}
+        {row.phase!=='complete' && ['failed','cancelled'].includes(row.job_status || '') && <button className={secondary} disabled={action.isPending} onClick={()=>action.mutate({action:'endFailed',id:row.id})}>End failed pilot</button>}
+      </div>
+    </li>)}</ul>
+    <Dialog open={!!review} onOpenChange={(value)=>{if(!value&&!action.isPending)setReview(null);}}><DialogContent className="max-w-2xl max-h-[85vh] overflow-auto"><DialogHeader><DialogTitle>Approve wider rollout</DialogTitle><DialogDescription>Review both versions and the current groups. Approval replaces the temporary pilot assignment with the previous copy’s current groups, preserving their intent, exclusions, filters and settings. The previous copy keeps its groups.</DialogDescription></DialogHeader>
+      {review && <>
+        <p className="text-sm font-medium">{review.row.display_name}</p>
+        <p className="text-xs text-text-muted">Results checked {new Date(review.preview.checkedAt).toLocaleString()}. These are app-wide reports, not a membership check for the pilot group.</p>
+        <div className="grid gap-3 sm:grid-cols-2"><Counts label={`Previous version ${review.row.previous_version}`} counts={review.preview.previousResults}/><Counts label={`Pilot version ${review.row.new_version}`} counts={review.preview.pilotResults}/></div>
+        <div className="grid gap-3 sm:grid-cols-2">{[{title:'New version currently reaches',rows:review.preview.newGroups},{title:'New version after approval',rows:review.preview.proposedGroups}].map((s)=><div key={s.title}><h4 className="text-sm font-medium">{s.title}</h4><ul className="mt-1 list-disc pl-4 text-sm text-text-secondary space-y-1 break-words">{s.rows.map((g,i)=><li key={i}>{g}</li>)}</ul></div>)}</div>
+        <p className="text-sm text-text-secondary">The old copy stays in Intune with its groups, including if approval fails. After rollout, use Inventory’s duplicate cleanup to move groups and remove old copies when appropriate. Removing the temporary pilot assignment does not uninstall the app.</p>
+        <label className="flex gap-2 text-sm"><input type="checkbox" checked={confirmed} onChange={(e)=>setConfirmed(e.target.checked)}/>I reviewed the results and approve these wider groups.</label>
+        {action.error && <p role="alert" className="text-sm text-status-error">{action.error.message} Close this review and refresh it before retrying.</p>}
+        <Button disabled={!confirmed||action.isPending} onClick={()=>action.mutate({action:'approve',id:review.row.id,token:review.preview.token,confirmed:true},{onSuccess:()=>setReview(null)})}>{action.isPending?'Approving…':'Approve wider rollout'}</Button>
+      </>}
+    </DialogContent></Dialog>
+  </section>;
+}
