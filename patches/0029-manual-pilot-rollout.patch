+ it('rejects a late job after a stalled reservation was ended',()=>{store.reserve(row);store.releaseUnstarted('tenant','pilot');expect(()=>job('late',{pilotRolloutId:'pilot'})).toThrow(/no longer active/);});
+ it('lets an expired approval lease recover after restart',()=>{store.reserve(row);job('pilot-job',{pilotRolloutId:'pilot'});store.claim('tenant','pilot',0);db.prepare("UPDATE hrm_pilot_rollouts SET lease_until='2000-01-01T00:00:00Z'").run();expect(store.claim('tenant','pilot',1)).toBe(true);});
