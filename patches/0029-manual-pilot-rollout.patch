+import { PILOT_HOLD } from './pilot-types';
+export async function pilotHold(tenant: string, winget: string, allowedPilot?: string): Promise<string | null> {
+  if (process.env.DATABASE_MODE?.toLowerCase() !== 'sqlite') return null;
+  const { sqlitePilotRollouts } = await import('@/lib/db/sqlite');
+  const row = sqlitePilotRollouts.active(tenant, winget);
+  return row && row.id !== allowedPilot ? PILOT_HOLD : null;
+}
diff --git a/lib/hrm/pilot-store.ts b/lib/hrm/pilot-store.ts
new file mode 100644
index 000000000..c6757edfd
--- /dev/null
+++ b/lib/hrm/pilot-store.ts
@@ -0,0 +1,33 @@
+import type Database from 'better-sqlite3';
+import type { PilotRollout, PilotView } from './pilot-types';
+export function createPilotStore(getDb: () => Database.Database) {
+  const view = `SELECT p.*, j.status AS job_status, j.intune_app_id AS new_app_id, j.version AS new_version FROM hrm_pilot_rollouts p LEFT JOIN packaging_jobs j ON j.id = p.job_id`;
+  return {
+    get(tenant: string, id: string): PilotView | null { return (getDb().prepare(`${view} WHERE p.tenant_id = ? AND p.id = ?`).get(tenant, id) as PilotView) ?? null; },
+    list(tenant: string): PilotView[] { return getDb().prepare(`${view} WHERE p.tenant_id = ? ORDER BY (p.phase = 'complete'), p.created_at DESC LIMIT 100`).all(tenant) as PilotView[]; },
+    active(tenant: string, winget: string): PilotRollout | null { return (getDb().prepare("SELECT * FROM hrm_pilot_rollouts WHERE tenant_id = ? AND winget_id = ? COLLATE NOCASE AND phase != 'complete'").get(tenant, winget) as PilotRollout) ?? null; },
+    hasSetupProfiles(tenant: string, appId: string) { return Boolean(getDb().prepare("SELECT 1 FROM packaging_jobs WHERE tenant_id = ? AND intune_app_id = ? AND status = 'deployed' AND COALESCE(json_array_length(json_extract(package_config,'$.espProfiles')),0) > 0 LIMIT 1").get(tenant,appId)); },
+    holdsApp(tenant: string, appId: string) { return Boolean(getDb().prepare(`${view} WHERE p.tenant_id = ? AND p.phase != 'complete' AND (p.previous_app_id = ? OR j.intune_app_id = ?)`).get(tenant, appId, appId)); },
+    reserve(row: Omit<PilotRollout, 'phase' | 'revision' | 'lease_until' | 'approved_by' | 'job_id'>) {
+      const db = getDb();
+      db.transaction(() => {
+        if (db.prepare("SELECT 1 FROM packaging_jobs WHERE tenant_id = ? AND winget_id = ? COLLATE NOCASE AND archived_at IS NULL AND status NOT IN ('deployed','failed','cancelled','duplicate_skipped') LIMIT 1").get(row.tenant_id, row.winget_id)) throw new Error('A deployment for this app is still running.');
+        db.prepare(`INSERT INTO hrm_pilot_rollouts (id,tenant_id,winget_id,display_name,group_id,group_name,previous_app_id,previous_version,phase,revision,created_at) VALUES (?,?,?,?,?,?,?,?,'starting',0,?)`)
+          .run(row.id,row.tenant_id,row.winget_id,row.display_name,row.group_id,row.group_name,row.previous_app_id,row.previous_version,row.created_at);
+      }).immediate();
+    },
+    attach(tenant: string, id: string, jobId: string) { getDb().prepare("UPDATE hrm_pilot_rollouts SET job_id = ?, phase = 'testing' WHERE tenant_id = ? AND id = ? AND phase = 'starting'").run(jobId,tenant,id); },
+    releaseUnstarted(tenant: string, id: string) {
+      // Never release a reservation after an inserted job might have been dispatched.
+      getDb().prepare("DELETE FROM hrm_pilot_rollouts WHERE tenant_id = ? AND id = ? AND job_id IS NULL AND NOT EXISTS (SELECT 1 FROM packaging_jobs WHERE tenant_id = ? AND json_extract(package_config,'$.pilotRolloutId') = ?)").run(tenant,id,tenant,id);
+    },
+    claim(tenant: string, id: string, revision: number) {
+      const now = new Date().toISOString();
+      return getDb().prepare("UPDATE hrm_pilot_rollouts SET phase = 'promoting', revision = revision + 1, lease_until = ? WHERE tenant_id = ? AND id = ? AND revision = ? AND (phase = 'testing' OR (phase = 'promoting' AND lease_until < ?))")
+        .run(new Date(Date.now()+90000).toISOString(),tenant,id,revision,now).changes === 1;
+    },
+    finish(tenant: string, id: string, actor: string, revision: number) { return getDb().prepare("UPDATE hrm_pilot_rollouts SET phase = 'complete', lease_until = NULL, approved_by = ? WHERE tenant_id = ? AND id = ? AND phase = 'promoting' AND revision = ?").run(actor,tenant,id,revision).changes === 1; },
+    endFailed(tenant: string, id: string) { return getDb().prepare("UPDATE hrm_pilot_rollouts SET phase = 'complete', lease_until = NULL WHERE tenant_id = ? AND id = ? AND phase = 'testing'").run(tenant,id).changes === 1; },
+    unlock(tenant: string, id: string, revision: number) { getDb().prepare("UPDATE hrm_pilot_rollouts SET phase = 'testing', lease_until = NULL WHERE tenant_id = ? AND id = ? AND phase = 'promoting' AND revision = ?").run(tenant,id,revision); },
+  };
+}
