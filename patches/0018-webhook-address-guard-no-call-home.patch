@@ -0,0 +1,74 @@
+import { beforeEach, describe, expect, it, vi } from 'vitest';
+
+const lookupMock = vi.fn();
+let lookupFails = false;
+vi.mock('dns/promises', () => ({
+  lookup: async (...args: unknown[]) => {
+    if (lookupFails) throw new Error('getaddrinfo ENOTFOUND');
+    return lookupMock(...args);
+  },
+}));
+
+import { checkWebhookDestination, checkWebhookUrlShape, isBlockedAddress } from './address-guard';
+
+beforeEach(() => {
+  lookupMock.mockReset();
+  lookupFails = false;
+});
+
+describe('isBlockedAddress', () => {
+  it.each([
+    '127.0.0.1', '10.1.2.3', '172.16.0.1', '172.31.255.255', '192.168.1.1', '169.254.169.254', '100.64.0.1',
+    '0.0.0.0', '224.0.0.1', '255.255.255.255', '::1', '::', 'fd00::1', 'fe80::1', 'ff02::1',
+    '::ffff:127.0.0.1', '::ffff:7f00:1', '64:ff9b::10.0.0.1', 'not-an-ip',
+  ])('blocks %s', (address) => expect(isBlockedAddress(address)).toBe(true));
+
+  it.each(['20.42.65.92', '172.32.0.1', '8.8.8.8', '2606:4700::1111', '::ffff:8.8.8.8'])('allows %s', (address) =>
+    expect(isBlockedAddress(address)).toBe(false)
+  );
+});
+
+describe('checkWebhookUrlShape', () => {
+  it.each([
+    ['http://hooks.example.test/x', 'https://'],
+    ['https://localhost/x', 'must be public'],
+    ['https://app.internal/x', 'must be public'],
+    ['https://intranet/x', 'must be public'],
+    ['https://169.254.169.254/metadata', 'must be public'],
+    ['https://[::1]/x', 'must be public'],
+    ['https://user:pass@hooks.example.test/x', 'header'],
+    ['not a url', 'https://'],
+  ])('refuses %s', (url, message) => {
+    const result = checkWebhookUrlShape(url);
+    expect(result.ok).toBe(false);
+    expect(result.error).toContain(message);
+  });
+
+  it('accepts a public https address', () => {
+    expect(checkWebhookUrlShape('https://alerts.example.test/in/abc')).toEqual({ ok: true });
+  });
+});
+
+describe('checkWebhookDestination', () => {
+  it('accepts a name that resolves only to public addresses', async () => {
+    lookupMock.mockResolvedValue([{ address: '104.16.1.1', family: 4 }, { address: '2606:4700::1', family: 6 }]);
+    expect(await checkWebhookDestination('https://alerts.example.test/in/abc')).toEqual({ ok: true });
+  });
+
+  it('refuses a public-looking name that resolves to a private address', async () => {
+    lookupMock.mockResolvedValue([{ address: '104.16.1.1', family: 4 }, { address: '10.0.0.4', family: 4 }]);
+    expect((await checkWebhookDestination('https://sneaky.example.test/x')).ok).toBe(false);
+  });
+
+  it('refuses a name that does not resolve', async () => {
+    lookupFails = true;
+    const result = await checkWebhookDestination('https://missing.example.test/x');
+    expect(result.ok).toBe(false);
+    expect(result.error).toContain("Couldn't find");
+  });
+
+  it('does not look up names it already refused', async () => {
+    expect((await checkWebhookDestination('https://localhost/x')).ok).toBe(false);
+    expect(lookupMock).not.toHaveBeenCalled();
+  });
+});
diff --git a/lib/webhooks/address-guard.ts b/lib/webhooks/address-guard.ts
new file mode 100644
index 000000000..233fff938
--- /dev/null
+++ b/lib/webhooks/address-guard.ts
@@ -0,0 +1,93 @@
+/**
+ * HRM patch: webhook addresses must be public.
+ *
+ * A webhook URL is typed by a signed-in user, and the server then POSTs to it.
+ * Without this check it could be pointed at the server itself, the private
+ * network or the Azure metadata address. Checked when a webhook is saved and
+ * again before every delivery (DNS can change in between); redirects are not
+ * followed, so a public address can't bounce the request inward.
+ */
+
+import { lookup } from 'dns/promises';
+import { isIP } from 'net';
+
+export interface DestinationCheck {
+  ok: boolean;
+  error?: string;
+}
+
+const BLOCKED_NAMES = /(^|\.)(localhost|local|internal|home\.arpa)$/i;
+
+function ipv4Parts(address: string): number[] | null {
+  const parts = address.split('.').map(Number);
+  return parts.length === 4 && parts.every((p) => Number.isInteger(p) && p >= 0 && p <= 255) ? parts : null;
+}
+
+function blockedIpv4([a, b, c]: number[]): boolean {
+  return (
+    a === 0 || // "this network"
+    a === 10 ||
+    a === 127 ||
+    (a === 100 && b >= 64 && b <= 127) || // carrier-grade NAT
+    (a === 169 && b === 254) || // link-local, including 169.254.169.254 (cloud metadata)
+    (a === 172 && b >= 16 && b <= 31) ||
+    (a === 192 && b === 168) ||
+    (a === 192 && b === 0 && c === 0) ||
+    (a === 198 && (b === 18 || b === 19)) || // benchmarking
+    a >= 224 // multicast and reserved
+  );
+}
+
+/** True for loopback, private, link-local, metadata and other non-public addresses. */
+export function isBlockedAddress(address: string): boolean {
+  const version = isIP(address);
+  if (version === 4) return blockedIpv4(ipv4Parts(address)!);
+  if (version !== 6) return true;
+
+  const lower = address.toLowerCase();
+  // IPv4 written inside IPv6 (::ffff:10.0.0.1, 64:ff9b::10.0.0.1) is judged as IPv4.
+  const embedded = lower.match(/(?:^::ffff:|^64:ff9b::)(\d+\.\d+\.\d+\.\d+)$/);
+  if (embedded) return blockedIpv4(ipv4Parts(embedded[1]) ?? [0, 0, 0, 0]);
+  if (lower === '::' || lower === '::1') return true;
+  if (/^::ffff:/.test(lower)) return true; // mapped address in hex form
+  const first = parseInt(lower.split(':')[0] || '0', 16);
+  return (
+    (first & 0xfe00) === 0xfc00 || // unique local fc00::/7
+    (first & 0xffc0) === 0xfe80 || // link-local fe80::/10
+    (first & 0xff00) === 0xff00 // multicast
+  );
+}
+
+/** The checks that need no network: https, and no local names or private literal addresses. */
+export function checkWebhookUrlShape(url: string): DestinationCheck {
+  let parsed: URL;
+  try {
+    parsed = new URL(url);
+  } catch {
+    return { ok: false, error: 'Enter a full address starting with https://.' };
+  }
+  if (parsed.protocol !== 'https:') return { ok: false, error: 'Enter a full address starting with https://.' };
+  if (parsed.username || parsed.password) return { ok: false, error: 'Put credentials in a header, not in the address.' };
+  const host = parsed.hostname.replace(/^\[|\]$/g, '');
+  if (isIP(host) ? isBlockedAddress(host) : BLOCKED_NAMES.test(host) || !host.includes('.')) {
+    return { ok: false, error: 'Webhook addresses must be public, not this server or the private network.' };
+  }
+  return { ok: true };
+}
+
+/** Full check: the shape, then every address the name resolves to must be public. */
+export async function checkWebhookDestination(url: string): Promise<DestinationCheck> {
+  const shape = checkWebhookUrlShape(url);
+  if (!shape.ok) return shape;
+  const host = new URL(url).hostname.replace(/^\[|\]$/g, '');
+  if (isIP(host)) return { ok: true };
+  try {
+    const addresses = await lookup(host, { all: true, verbatim: true });
+    if (addresses.length === 0 || addresses.some((a) => isBlockedAddress(a.address))) {
+      return { ok: false, error: 'Webhook addresses must be public, not this server or the private network.' };
+    }
+    return { ok: true };
+  } catch {
+    return { ok: false, error: `Couldn't find ${host}. Check the address.` };
+  }
+}
