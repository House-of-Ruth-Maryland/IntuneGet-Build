+// HRM patch 0056: only HRM's IT admins group may use IntuneGet. Fake IDs only.
+import { NextRequest } from 'next/server';
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import {
+  ACCESS_CACHE_MS,
+  ACCESS_DENIED_CODE,
+  ACCESS_DENIED_MESSAGE,
+  adminAccessConfig,
+  adminAccessState,
+  checkAdminAccess,
+  clearAdminAccessCache,
+  isMachineApiPath,
+} from '../admin-access';
+
+const ADMINS = '00000000-0000-4000-8000-0000000000a1';
+const OTHER_GROUP = '00000000-0000-4000-8000-0000000000b2';
+const TENANT = '00000000-0000-4000-8000-0000000000c3';
+const OTHER_TENANT = '00000000-0000-4000-8000-0000000000d4';
+const env = { HRM_ADMIN_GROUP_IDS: ADMINS, HRM_TENANT_ID: TENANT };
+const user = { userId: 'user-01', tenantId: TENANT };
+
+function graph(groups: string[] | null, status = 200) {
+  return vi.fn(async () => (groups === null
+    ? new Response('{"error":{"message":"fake detail"}}', { status })
+    : Response.json({ value: groups }, { status })));
+}
+
+beforeEach(() => clearAdminAccessCache());
+
+describe('access settings', () => {
+  it('is off when no group is set, so nothing changes', () => {
+    expect(adminAccessConfig({})).toBeNull();
+    expect(adminAccessState({})).toBe('not_limited');
+    expect(adminAccessState(env)).toBe('limited');
+  });
+
+  it('keeps only well-formed group IDs and ignores a malformed tenant', () => {
+    expect(adminAccessConfig({ HRM_ADMIN_GROUP_IDS: ` ${ADMINS.toUpperCase()}, not-a-guid,${OTHER_GROUP},${ADMINS}`, HRM_TENANT_ID: 'example.test' }))
+      .toEqual({ groupIds: [ADMINS, OTHER_GROUP], tenantId: null });
+    expect(adminAccessConfig({ HRM_ADMIN_GROUP_IDS: 'not-a-guid' })).toBeNull();
+  });
+
+  it("reads patch 0055's tenant setting when HRM_TENANT_ID is unset", () => {
+    expect(adminAccessConfig({ HRM_ADMIN_GROUP_IDS: ADMINS, MCP_TENANT_ID: TENANT })?.tenantId).toBe(TENANT);
+    expect(adminAccessConfig({ HRM_ADMIN_GROUP_IDS: ADMINS, MCP_TENANT_ID: OTHER_TENANT, HRM_TENANT_ID: TENANT })?.tenantId).toBe(TENANT);
+  });
+});
+
+describe('checkAdminAccess', () => {
+  it('allows everyone without asking Graph when no group is set', async () => {
+    const fetchImpl = graph([]);
+    expect(await checkAdminAccess(user, 'token', { env: {}, fetchImpl })).toBe('allowed');
+    expect(fetchImpl).not.toHaveBeenCalled();
+  });
+
