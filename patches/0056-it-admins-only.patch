+      method: 'POST',
+      headers: expect.objectContaining({ Authorization: 'Bearer user-token' }),
+      body: JSON.stringify({ groupIds: [ADMINS] }),
+    }));
+  });
+
+  it('refuses a non-member', async () => {
+    expect(await checkAdminAccess(user, 'token', { env, fetchImpl: graph([]) })).toBe('not_member');
+  });
+
+  it('refuses another tenant without asking Graph', async () => {
+    const fetchImpl = graph([ADMINS]);
+    expect(await checkAdminAccess({ userId: 'user-02', tenantId: OTHER_TENANT }, 'token', { env, fetchImpl })).toBe('wrong_tenant');
+    expect(fetchImpl).not.toHaveBeenCalled();
+  });
+
+  it('keeps a decision for 5 minutes, then asks again', async () => {
+    const fetchImpl = graph([ADMINS]);
+    const now = 1_000_000;
+    await checkAdminAccess(user, 'token', { env, fetchImpl, now });
+    await checkAdminAccess(user, 'token', { env, fetchImpl, now: now + ACCESS_CACHE_MS - 1 });
+    expect(fetchImpl).toHaveBeenCalledTimes(1);
+    fetchImpl.mockImplementation(async () => Response.json({ value: [] }));
+    expect(await checkAdminAccess(user, 'token', { env, fetchImpl, now: now + ACCESS_CACHE_MS })).toBe('not_member');
+    expect(fetchImpl).toHaveBeenCalledTimes(2);
+  });
+
+  it('asks again when the group setting changes', async () => {
+    const fetchImpl = graph([ADMINS]);
+    await checkAdminAccess(user, 'token', { env, fetchImpl });
+    await checkAdminAccess(user, 'token', { env: { ...env, HRM_ADMIN_GROUP_IDS: OTHER_GROUP }, fetchImpl });
+    expect(fetchImpl).toHaveBeenCalledTimes(2);
+  });
+
+  it('refuses, and keeps nothing, when Graph fails', async () => {
