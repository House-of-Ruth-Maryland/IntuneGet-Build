+++ b/app/api/hrm/access/route.ts
@@ -0,0 +1,13 @@
+// HRM patch 0056: whether the signed-in user may use IntuneGet. The dashboard asks this first and
+// shows the "no access" page on a 403, before any other screen loads.
+
+import { NextRequest, NextResponse } from 'next/server';
+import { verifyAccessToken } from '@/lib/auth-utils';
+import { accessRefusedResponse } from '@/lib/hrm/admin-access';
+
+export async function GET(request: NextRequest) {
+  const verified = await verifyAccessToken(request.headers.get('Authorization'));
+  if (!verified) return NextResponse.json({ error: 'Authentication required' }, { status: 401 });
+  if (verified.access !== 'allowed') return accessRefusedResponse(verified.access);
+  return NextResponse.json({ allowed: true }, { headers: { 'Cache-Control': 'private, no-store' } });
+}
