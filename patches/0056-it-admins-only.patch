new file mode 100644
index 000000000..f673d708a
--- /dev/null
+++ b/hooks/useAppAccess.ts
@@ -0,0 +1,43 @@
+'use client';
+
+// HRM patch 0056: asks the server whether the signed-in user may use IntuneGet, before the
+// dashboard loads anything else. The server enforces this on every route; this only picks the
+// screen to show.
+
+import { useCallback, useEffect, useState } from 'react';
+import { useMicrosoftAuth } from '@/hooks/useMicrosoftAuth';
+
+export type AppAccessState = 'checking' | 'allowed' | 'denied' | 'unavailable';
+
+/** Maps the server's answer to a screen. Anything unexpected lets the dashboard load (routes still refuse). */
+export function accessStateFromStatus(status: number): Exclude<AppAccessState, 'checking'> {
+  if (status === 403) return 'denied';
+  if (status === 503) return 'unavailable';
+  return 'allowed';
+}
+
+export function useAppAccess(enabled: boolean): { state: AppAccessState; retry: () => void } {
+  const { getAccessToken } = useMicrosoftAuth();
+  const [state, setState] = useState<AppAccessState>('checking');
+  const [attempt, setAttempt] = useState(0);
+
+  useEffect(() => {
+    if (!enabled) return;
+    let cancelled = false;
+    setState('checking');
+    (async () => {
+      try {
+        const token = await getAccessToken();
+        if (!token) { if (!cancelled) setState('allowed'); return; }
+        const response = await fetch('/api/hrm/access', { headers: { Authorization: `Bearer ${token}` }, cache: 'no-store' });
+        if (!cancelled) setState(accessStateFromStatus(response.status));
+      } catch {
+        if (!cancelled) setState('allowed');
+      }
+    })();
+    return () => { cancelled = true; };
+  }, [enabled, getAccessToken, attempt]);
+
+  const retry = useCallback(() => setAttempt((n) => n + 1), []);
+  return { state, retry };
+}
