@@ -0,0 +1,46 @@
+// HRM patch 0056
+import { NextRequest } from 'next/server';
+import { beforeEach, describe, expect, it, vi } from 'vitest';
+const mocks = vi.hoisted(() => ({ verify: vi.fn() }));
+vi.mock('@/lib/auth-utils', () => ({ verifyAccessToken: mocks.verify }));
+import { GET } from './route';
+import { ACCESS_DENIED_CODE, ACCESS_UNAVAILABLE_CODE } from '@/lib/hrm/admin-access';
+import { accessStateFromStatus } from '@/hooks/useAppAccess';
+
+const request = () => new NextRequest('http://localhost/api/hrm/access', { headers: { Authorization: 'Bearer x.y.z' } });
+const user = { userId: 'user-01', tenantId: 'tenant-01', userEmail: 'staff.one@example.test', userName: null };
+beforeEach(() => vi.clearAllMocks());
+
+describe('HRM access route', () => {
+  it('requires sign-in', async () => {
+    mocks.verify.mockResolvedValue(null);
+    expect((await GET(request())).status).toBe(401);
+  });
+
+  it('says yes to a member, never cached', async () => {
+    mocks.verify.mockResolvedValue({ user, access: 'allowed' });
+    const response = await GET(request());
+    expect(response.status).toBe(200);
+    expect(response.headers.get('cache-control')).toBe('private, no-store');
+  });
+
+  it('refuses a non-member or another tenant with 403, and a failed check with 503', async () => {
+    for (const access of ['not_member', 'wrong_tenant']) {
+      mocks.verify.mockResolvedValue({ user, access });
+      const response = await GET(request());
+      expect(response.status).toBe(403);
+      expect((await response.json()).code).toBe(ACCESS_DENIED_CODE);
+    }
+    mocks.verify.mockResolvedValue({ user, access: 'unavailable' });
+    const response = await GET(request());
+    expect(response.status).toBe(503);
+    expect((await response.json()).code).toBe(ACCESS_UNAVAILABLE_CODE);
+  });
+
+  it('picks the dashboard screen from the answer', () => {
+    expect(accessStateFromStatus(200)).toBe('allowed');
+    expect(accessStateFromStatus(403)).toBe('denied');
+    expect(accessStateFromStatus(503)).toBe('unavailable');
+    expect(accessStateFromStatus(401)).toBe('allowed');
+  });
+});
diff --git a/app/api/hrm/access/route.ts b/app/api/hrm/access/route.ts
