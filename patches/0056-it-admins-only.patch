diff --git a/lib/hrm/admin-access.ts b/lib/hrm/admin-access.ts
new file mode 100644
index 000000000..593d48e74
--- /dev/null
+++ b/lib/hrm/admin-access.ts
@@ -0,0 +1,151 @@
+/**
+ * HRM patch 0056: only HRM's IT admins may use IntuneGet, behind Cloudflare Access.
+ *
+ * Settings, on the VM only (never in the repo):
+ *  - HRM_ADMIN_GROUP_IDS: comma-separated Entra group object IDs (up to 20). Unset means access
+ *    isn't limited to a group: nothing changes, and Home's Server status says so.
+ *  - HRM_TENANT_ID: the one Entra tenant allowed to sign in. Patch 0055's MCP_TENANT_ID is read
+ *    when it is unset, so one setting names the tenant for both.
+ *
+ * Membership uses POST /me/checkMemberGroups with the signed-in user's own token. Microsoft lists
+ * User.Read (which sign-in already requests) as enough for the signed-in user, and the check is
+ * transitive, so nested groups count. No new permission or admin consent is needed.
+ *
+ * Decisions are kept in memory for 5 minutes per user. A failed check is never kept, and it
+ * refuses the request (503) rather than letting it through.
+ *
+ * Machine routes (cron, status report, workflow callbacks, the MCP read API) never use a user
+ * token, so this check never applies to them.
+ */
+
+export type AccessDecision = 'allowed' | 'not_member' | 'wrong_tenant' | 'unavailable';
+
+export interface AdminAccessConfig {
+  groupIds: string[];
+  tenantId: string | null;
+}
+
+export const ACCESS_CACHE_MS = 5 * 60 * 1000;
+export const ACCESS_CHECK_TIMEOUT_MS = 5_000;
+/** checkMemberGroups takes at most 20 group IDs per request. */
+export const MAX_ADMIN_GROUPS = 20;
+export const ACCESS_DENIED_CODE = 'hrm_access_denied';
+export const ACCESS_UNAVAILABLE_CODE = 'hrm_access_unavailable';
+export const ACCESS_DENIED_MESSAGE =
+  "You don't have access to IntuneGet. Ask HRM Support (https://support.hruthmd.org) to add you to the IT admins group.";
+export const ACCESS_UNAVAILABLE_MESSAGE = "IntuneGet couldn't check your access. Try again in a minute.";
+
+const GUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/;
+const CHECK_URL = 'https://graph.microsoft.com/v1.0/me/checkMemberGroups';
+
+type Env = Record<string, string | undefined>;
+
+/** The access settings, or null when no valid group is set (access isn't limited). */
+export function adminAccessConfig(env: Env = process.env): AdminAccessConfig | null {
+  const groupIds = [...new Set(
+    (env.HRM_ADMIN_GROUP_IDS ?? '')
+      .split(',')
+      .map((id) => id.trim().toLowerCase())
+      .filter((id) => GUID.test(id)),
+  )].slice(0, MAX_ADMIN_GROUPS);
+  if (groupIds.length === 0) return null;
+  const tenant = (env.HRM_TENANT_ID || env.MCP_TENANT_ID || '').trim().toLowerCase();
+  return { groupIds, tenantId: GUID.test(tenant) ? tenant : null };
+}
+
+/** For Home's Server status: whether sign-in is limited to the admins group. */
+export function adminAccessState(env: Env = process.env): 'limited' | 'not_limited' {
+  return adminAccessConfig(env) ? 'limited' : 'not_limited';
+}
+
+const decisions = new Map<string, { decision: AccessDecision; expiresAt: number }>();
+
+/** Test helper: forget every cached decision. */
+export function clearAdminAccessCache(): void {
+  decisions.clear();
+}
+
+async function memberOfAny(accessToken: string, groupIds: string[], fetchImpl: typeof fetch): Promise<boolean | null> {
+  try {
+    const response = await fetchImpl(CHECK_URL, {
+      method: 'POST',
+      headers: { Authorization: `Bearer ${accessToken}`, 'Content-Type': 'application/json' },
+      body: JSON.stringify({ groupIds }),
+      signal: AbortSignal.timeout(ACCESS_CHECK_TIMEOUT_MS),
+    });
+    if (!response.ok) {
+      // Status code only: the body can carry user or tenant details.
+      console.warn(`[HRM access] Group check failed with status ${response.status}`);
+      return null;
+    }
+    const body = (await response.json()) as { value?: unknown };
+    if (!Array.isArray(body.value)) return null;
+    const found = new Set(body.value.filter((id): id is string => typeof id === 'string').map((id) => id.toLowerCase()));
+    return groupIds.some((id) => found.has(id));
+  } catch {
+    console.warn('[HRM access] Group check could not reach Microsoft Graph');
+    return null;
+  }
+}
+
+/**
+ * Whether this verified user may use the app. The token must already be verified with Graph
+ * (parseAccessToken does that first). Allowed for everyone while no group is set.
+ */
+export async function checkAdminAccess(
+  user: { userId: string; tenantId: string },
+  accessToken: string,
+  options: { env?: Env; fetchImpl?: typeof fetch; now?: number } = {},
+): Promise<AccessDecision> {
+  const config = adminAccessConfig(options.env);
+  if (!config) return 'allowed';
+  const now = options.now ?? Date.now();
+  const tenantId = user.tenantId.toLowerCase();
+  const key = `${config.tenantId ?? ''}|${config.groupIds.join(',')}|${tenantId}|${user.userId}`;
+  const cached = decisions.get(key);
+  if (cached && cached.expiresAt > now) return cached.decision;
+
+  let decision: AccessDecision;
+  if (config.tenantId && tenantId !== config.tenantId) {
+    decision = 'wrong_tenant';
+  } else {
+    const member = await memberOfAny(accessToken, config.groupIds, options.fetchImpl ?? fetch);
+    if (member === null) return 'unavailable';
+    decision = member ? 'allowed' : 'not_member';
+  }
+
+  if (decisions.size > 1000) {
+    for (const [entry, value] of decisions) if (value.expiresAt <= now) decisions.delete(entry);
+  }
+  decisions.set(key, { decision, expiresAt: now + ACCESS_CACHE_MS });
+  return decision;
+}
+
+/** The answer for a refused user: 403 for non-members and other tenants, 503 when the check failed. */
+export function accessRefusedResponse(decision: Exclude<AccessDecision, 'allowed'>): Response {
+  const unavailable = decision === 'unavailable';
+  return Response.json(
+    unavailable
+      ? { error: ACCESS_UNAVAILABLE_MESSAGE, code: ACCESS_UNAVAILABLE_CODE }
+      : { error: ACCESS_DENIED_MESSAGE, code: ACCESS_DENIED_CODE },
+    { status: unavailable ? 503 : 403, headers: { 'Cache-Control': 'no-store' } },
+  );
+}
+
+/**
+ * API paths that never take a staff member's token. They have their own keys or signatures, so
+ * the proxy leaves them alone. (They don't call parseAccessToken either.)
+ */
+const MACHINE_API_PREFIXES = [
+  '/api/cron',
+  '/api/status-report',
+  '/api/hrm/mcp',
+  '/api/package/callback',
+  '/api/packager',
+  '/api/qa',
+  '/api/health',
+];
+
+export function isMachineApiPath(pathname: string): boolean {
+  return MACHINE_API_PREFIXES.some((prefix) => pathname === prefix || pathname.startsWith(`${prefix}/`));
+}
