+// HRM patch 0037: going back to the previous version from Inventory.
+import {afterEach,beforeEach,describe,expect,it,vi} from 'vitest';
+import {NextRequest} from 'next/server';
+const state=vi.hoisted(()=>{vi.stubEnv('DATABASE_MODE','sqlite');vi.stubEnv('DATABASE_PATH',':memory:');return {auth:true,dispatch:vi.fn()};});
+vi.mock('@/lib/auth-utils',()=>({parseAccessToken:async()=>state.auth?{tenantId:'tenant',userId:'staff',userEmail:'staff@example.test'}:null}));
+vi.mock('@/lib/db',async()=>{const {sqliteDb}=await import('@/lib/db/sqlite');return {isSqliteMode:()=>true,getDatabase:()=>sqliteDb};});
+vi.mock('@/lib/features',()=>({getFeatureFlags:()=>({localPackager:false})}));
+vi.mock('@/lib/github-actions',()=>({isGitHubActionsConfigured:()=>true}));
+vi.mock('@/lib/intune/graph-client',()=>({getServicePrincipalToken:async()=>'token'}));
+vi.mock('@/lib/hrm/update-dispatch',()=>({dispatchUpdateJob:state.dispatch}));
+import {sqliteDb,sqliteRollbacks,sqlitePilotRollouts,closeSqliteDb} from '@/lib/db/sqlite';
+import {GET,POST} from './route';
+const OLD='11111111-1111-4111-8111-111111111111',NEW='22222222-2222-4222-8222-222222222222',GROUP='33333333-3333-4333-8333-333333333333';
+let groups:unknown[];let writes:string[];
+const group=(id=GROUP)=>({intent:'required',target:{'@odata.type':'#microsoft.graph.groupAssignmentTarget',groupId:id}});
+const post=(body:unknown)=>POST(new NextRequest('http://localhost/api/hrm/rollback',{method:'POST',body:JSON.stringify(body),headers:{Authorization:'Bearer fixture'}}));
+const get=(appId=NEW)=>GET(new NextRequest(`http://localhost/api/hrm/rollback?appId=${appId}`,{headers:{Authorization:'Bearer fixture'}}));
+async function deployed(version:string,appId:string,at:string,config:Record<string,unknown>={}){
+ const job=await sqliteDb.jobs.create({user_id:'staff',tenant_id:'tenant',winget_id:'Example.App',version,display_name:'Example',publisher:'Example Co',installer_type:'exe',installer_url:`https://example.invalid/${version}.exe`,installer_sha256:'a'.repeat(64),uninstall_command:'uninstall.exe /S',package_config:config,status:'queued'});
+ await sqliteDb.jobs.update(job.id,{status:'deployed',intune_app_id:appId,completed_at:at});
+ await sqliteDb.uploadHistory.create({packaging_job_id:job.id,user_id:'staff',intune_tenant_id:'tenant',winget_id:'Example.App',intune_app_id:appId,version,display_name:'Example',deployed_at:at});
+ return job.id;
+}
+let previousJob:string;
+beforeEach(async()=>{
+ closeSqliteDb();state.auth=true;groups=[group()];writes=[];state.dispatch.mockReset();state.dispatch.mockResolvedValue({dispatched:true});
+ previousJob=await deployed('1.1',OLD,'2026-01-01T00:00:00Z');
+ await deployed('2.0',NEW,'2026-01-02T00:00:00Z',{categories:[{id:'now'}]});
+ vi.stubGlobal('fetch',vi.fn(async(url:string,init?:RequestInit)=>{
+  if(init?.method && init.method!=='GET'){writes.push(url);return new Response(null,{status:204});}
+  if(url.endsWith('/assignments'))return Response.json({value:groups});
+  return Response.json({id:NEW,'@odata.type':'#microsoft.graph.win32LobApp',displayName:'Example',publisher:'Example Co',displayVersion:'2.0'});
+ }));
+});
+afterEach(()=>{closeSqliteDb();vi.unstubAllGlobals();});
+describe('go back to the previous version',()=>{
+ it('requires sign-in',async()=>{state.auth=false;expect((await get()).status).toBe(401);expect((await post({action:'preview',appId:NEW})).status).toBe(401);});
+ it('offers the previous version only on the newest copy',async()=>{
+  expect(await (await get()).json()).toMatchObject({supported:true,available:true,currentVersion:'2.0',previousVersion:'1.1',hold:null});
+  expect(await (await get(OLD)).json()).toMatchObject({supported:true,available:false});
+ });
+ it('reviews, then starts a Replace deployment of the previous installer and skips the bad version for automatic updates',async()=>{
+  const {preview}=await (await post({action:'preview',appId:NEW})).json();
+  expect(preview).toMatchObject({currentVersion:'2.0',previousVersion:'1.1',previousJobId:previousJob});
+  expect(preview.groups).toHaveLength(1);
+  expect((await post({action:'start',appId:NEW,previousJobId:previousJob,token:preview.token})).status).toBe(400);
+  const response=await post({action:'start',appId:NEW,previousJobId:previousJob,token:preview.token,confirmed:true});
+  expect(response.status).toBe(200);
+  const {jobId}=await response.json();
+  const job=await sqliteDb.jobs.getById(jobId);
+  expect(job).toMatchObject({version:'1.1',installer_url:'https://example.invalid/1.1.exe',status:'queued',user_email:'staff@example.test'});
+  expect(job!.package_config).toMatchObject({sourceIntuneAppId:NEW,supersedenceType:'replace',assignments:[],categories:[{id:'now'}]});
+  expect(state.dispatch).toHaveBeenCalledWith(expect.anything(),jobId);
+  expect(sqliteRollbacks.skipped('tenant','Example.App','2.0')).toMatchObject({rolled_back_to:'1.1',created_by:'staff@example.test'});
+  expect(writes).toEqual([]);
+  expect((await (await get()).json()).hold).toMatch(/still running/);
+ });
+ it('refuses a stale review when the groups changed',async()=>{
+  const {preview}=await (await post({action:'preview',appId:NEW})).json();
+  groups.push(group('44444444-4444-4444-8444-444444444444'));
+  const response=await post({action:'start',appId:NEW,previousJobId:previousJob,token:preview.token,confirmed:true});
+  expect(response.status).toBe(409);
+  expect(state.dispatch).not.toHaveBeenCalled();
+  expect(sqliteRollbacks.skipped('tenant','Example.App','2.0')).toBeNull();
+ });
+ it('refuses while a pilot is active',async()=>{
+  sqlitePilotRollouts.reserve({id:'pilot',tenant_id:'tenant',winget_id:'Example.App',display_name:'Example',group_id:GROUP,group_name:'Pilot',previous_app_id:NEW,previous_version:'2.0',created_at:new Date().toISOString()});
+  expect((await (await get()).json()).hold).toMatch(/pilot/i);
+  expect((await post({action:'preview',appId:NEW})).status).toBe(409);
+ });
+ it('lets staff allow a skipped version again',async()=>{
+  sqliteRollbacks.skip({tenant_id:'tenant',winget_id:'Example.App',version:'2.1',rolled_back_to:'2.0',job_id:null,created_by:'staff@example.test',created_at:'2026-01-03T00:00:00Z'});
+  expect((await (await get()).json()).skipped).toEqual([{version:'2.1',rolledBackTo:'2.0',at:'2026-01-03T00:00:00Z'}]);
+  expect((await post({action:'allow',appId:NEW,version:'2.1'})).status).toBe(200);
+  expect(sqliteRollbacks.skipped('tenant','Example.App','2.1')).toBeNull();
+  expect((await post({action:'allow',appId:NEW,version:'2.1'})).status).toBe(409);
+ });
+});
diff --git a/app/api/hrm/rollback/route.ts b/app/api/hrm/rollback/route.ts
new file mode 100644
index 000000000..da90067c8
--- /dev/null
+++ b/app/api/hrm/rollback/route.ts
@@ -0,0 +1,140 @@
+// HRM patch 0037: go back to the previous version of an app IntuneGet deployed.
+//   GET  ?appId=  whether this copy can go back, and to which version (database only)
+//   POST { action: 'preview', appId }  read the copy and its live groups from Intune; returns a review token
+//   POST { action: 'start', appId, previousJobId, token, confirmed: true }  start the rollback deployment
+//   POST { action: 'allow', appId, version }  let automatic updates deploy a skipped version again
+// The new deployment replaces the current copy (Replace supersedence: Intune uninstalls the current
+// version, then installs the previous one) and takes over its live groups. Nothing changes in Intune
+// until packaging finishes. Failures use 409/424, because Cloudflare replaces 502 with its own page.
+import { NextRequest, NextResponse } from 'next/server';
+import { parseAccessToken } from '@/lib/auth-utils';
+import { getDatabase, isSqliteMode } from '@/lib/db';
+import { getFeatureFlags } from '@/lib/features';
+import { isGitHubActionsConfigured } from '@/lib/github-actions';
+import { getServicePrincipalToken } from '@/lib/intune/graph-client';
+import { isSelfUpdatingApp } from '@/lib/self-updating-apps';
+import { GUID, summarizeAssignments } from '@/lib/hrm/app-insights';
+import { pilotGraph, PilotError } from '@/lib/hrm/pilot-graph';
+import { pilotHold } from '@/lib/hrm/pilot-guard';
+import { dispatchUpdateJob } from '@/lib/hrm/update-dispatch';
+import { buildRollbackJob, rollbackToken, type RollbackPreview } from '@/lib/hrm/rollback';
+
+export const maxDuration = 120;
+const reply = (body: unknown, status = 200) => NextResponse.json(body, { status, headers: { 'Cache-Control': 'private, no-store' } });
+const supported = () => isSqliteMode() && !getFeatureFlags().localPackager && isGitHubActionsConfigured();
+// One rollback start at a time per app on this server (a double press can't create two copies).
+const starting = new Set<string>();
+
+type User = NonNullable<Awaited<ReturnType<typeof parseAccessToken>>>;
+
+async function candidate(user: User, appId: string) {
+  const { sqliteAppInsights, sqliteRollbacks } = await import('@/lib/db/sqlite');
+  const deployment = sqliteAppInsights.tracked(user.tenantId).find((d) => d.appId.toLowerCase() === appId.toLowerCase());
+  if (!deployment) return null;
+  if (isSelfUpdatingApp(deployment.wingetId)) return { deployment, previous: null, reason: 'This app keeps itself up to date on the device, so IntuneGet does not deploy its versions.' };
+  const previous = sqliteRollbacks.previousJob(user.tenantId, deployment.wingetId, deployment.version, deployment.appId);
+  return { deployment, previous, reason: previous ? null : 'No earlier version deployed by IntuneGet to go back to.' };
+}
+
+async function blocked(user: User, wingetId: string, appId: string): Promise<string | null> {
+  const { sqlitePilotRollouts, sqliteRollbacks } = await import('@/lib/db/sqlite');
+  if (sqlitePilotRollouts.holdsApp(user.tenantId, appId) || await pilotHold(user.tenantId, wingetId)) return 'A pilot is active for this app. Finish it in App updates first.';
+  if (sqliteRollbacks.running(user.tenantId, wingetId)) return 'A deployment for this app is still running. Check Deployments.';
+  return null;
+}
+
+async function preview(user: User, appId: string): Promise<RollbackPreview> {
+  const found = await candidate(user, appId);
+  if (!found) throw new PilotError('Only the newest copy IntuneGet deployed can go back to a previous version. Refresh Inventory.');
+  if (!found.previous) throw new PilotError(found.reason!);
+  const hold = await blocked(user, found.deployment.wingetId, found.deployment.appId);
+  if (hold) throw new PilotError(hold);
+  const token = await getServicePrincipalToken(user.tenantId);
+  if (!token) throw new PilotError("Couldn't reach Intune. Try again.", 424);
+  const graph = pilotGraph(token, fetch, 'Could not read this app from Intune completely. Nothing was changed.');
+  const [app, rows] = await Promise.all([graph.app(found.deployment.appId), graph.assignments(found.deployment.appId)]);
+  if (app.displayVersion !== found.deployment.version) throw new PilotError('The version in Intune no longer matches IntuneGet. Refresh Inventory.');
+  const groups = summarizeAssignments(rows);
+  return {
+    token: rollbackToken(found.deployment.appId, found.deployment.version, found.previous.id, groups.map((g) => g.key)),
+    appId: found.deployment.appId,
+    displayName: found.deployment.displayName,
+    currentVersion: found.deployment.version,
+    previousVersion: found.previous.version,
+    previousJobId: found.previous.id,
+    groups: groups.map((g) => g.label),
+    checkedAt: new Date().toISOString(),
+  };
+}
+
+export async function GET(request: NextRequest) {
+  const user = await parseAccessToken(request.headers.get('Authorization'));
+  if (!user) return reply({ error: 'Authentication required' }, 401);
+  if (!supported()) return reply({ supported: false });
+  const appId = new URL(request.url).searchParams.get('appId') ?? '';
+  if (!GUID.test(appId)) return reply({ error: 'Invalid app' }, 400);
+  const found = await candidate(user, appId);
+  if (!found) return reply({ supported: true, available: false });
+  const { sqliteRollbacks } = await import('@/lib/db/sqlite');
+  return reply({
+    supported: true,
+    available: Boolean(found.previous),
+    currentVersion: found.deployment.version,
+    previousVersion: found.previous?.version ?? null,
+    reason: found.reason,
+    hold: found.previous ? await blocked(user, found.deployment.wingetId, found.deployment.appId) : null,
+    skipped: sqliteRollbacks.listSkipped(user.tenantId, found.deployment.wingetId).map((s) => ({ version: s.version, rolledBackTo: s.rolled_back_to, at: s.created_at })),
+  });
+}
+
+export async function POST(request: NextRequest) {
+  const user = await parseAccessToken(request.headers.get('Authorization'));
+  if (!user) return reply({ error: 'Authentication required' }, 401);
+  if (!supported()) return reply({ error: 'Going back to a previous version needs this server’s SQLite and GitHub packaging mode.' }, 409);
+  const body = (await request.json().catch(() => null)) as Record<string, unknown> | null;
+  const appId = typeof body?.appId === 'string' ? body.appId : '';
+  if (!body || !['preview', 'start', 'allow'].includes(String(body.action)) || !GUID.test(appId)) return reply({ error: 'Invalid request' }, 400);
+  try {
+    if (body.action === 'preview') return reply({ preview: await preview(user, appId) });
+    if (body.action === 'allow') {
+      const found = await candidate(user, appId);
+      if (!found || typeof body.version !== 'string' || body.version.length > 100) throw new PilotError('Refresh Inventory and try again.', 400);
+      const { sqliteRollbacks } = await import('@/lib/db/sqlite');
+      if (!sqliteRollbacks.unskip(user.tenantId, found.deployment.wingetId, body.version)) throw new PilotError('That version is no longer skipped.');
+      return reply({ allowed: true });
+    }
+
+    if (body.confirmed !== true || typeof body.token !== 'string' || !/^[a-f0-9]{64}$/.test(body.token) || typeof body.previousJobId !== 'string') {
+      throw new PilotError('Review the versions and groups, and confirm, first.', 400);
+    }
+    const key = `${user.tenantId}|${appId.toLowerCase()}`;
+    if (starting.has(key)) throw new PilotError('Going back is already starting for this app. Check Deployments.');
+    starting.add(key);
+    try {
+      const checked = await preview(user, appId);
+      if (checked.token !== body.token || checked.previousJobId !== body.previousJobId) {
+        throw new PilotError('The versions or groups changed after your review. Review again before going back.');
+      }
+      const { sqliteRollbacks } = await import('@/lib/db/sqlite');
+      const previous = sqliteRollbacks.previousJob(user.tenantId, (await candidate(user, appId))!.deployment.wingetId, checked.currentVersion, checked.appId);
+      if (!previous || previous.id !== checked.previousJobId) throw new PilotError('The previous version changed. Review again.');
+      const db = getDatabase();
+      const job = await db.jobs.create(buildRollbackJob(previous, sqliteRollbacks.currentJob(user.tenantId, checked.appId), checked.appId, user, checked.currentVersion));
+      // Automatic updates must not redeploy the version staff just went back from.
+      sqliteRollbacks.skip({ tenant_id: user.tenantId, winget_id: previous.winget_id, version: checked.currentVersion, rolled_back_to: previous.version,
+        job_id: job.id, created_by: user.userEmail || user.userId, created_at: new Date().toISOString() });
+      const dispatch = await dispatchUpdateJob(db, job.id);
+      console.log(JSON.stringify({ route: '/api/hrm/rollback', action: 'start', job: job.id, dispatched: dispatch.dispatched }));
+      if (!dispatch.dispatched && dispatch.reason !== 'local-packager') {
+        return reply({ started: false, jobId: job.id, error: `Going back didn't start: ${dispatch.message} Check Deployments.` }, 409);
+      }
+      return reply({ started: true, jobId: job.id, previousVersion: previous.version });
+    } finally {
+      starting.delete(key);
+    }
+  } catch (error) {
+    if (error instanceof PilotError) return reply({ error: error.message }, error.status);
+    const message = error instanceof Error && /pilot rollout is active/i.test(error.message) ? 'A pilot is active for this app. Finish it in App updates first.' : 'Could not go back to the previous version. Check Deployments and try again.';
+    return reply({ error: message }, 409);
+  }
+}
diff --git a/components/hrm/RollbackPanel.tsx b/components/hrm/RollbackPanel.tsx
new file mode 100644
index 000000000..6038fec4b
--- /dev/null
+++ b/components/hrm/RollbackPanel.tsx
@@ -0,0 +1,108 @@
+'use client';
+// HRM patch 0037: go back to the previous version of an app IntuneGet deployed (Inventory app details).
+import { useState } from 'react';
+import Link from 'next/link';
+import { Undo2 } from 'lucide-react';
+import { Button } from '@/components/ui/button';
+import { Dialog, DialogContent, DialogHeader, DialogTitle, DialogDescription, DialogFooter } from '@/components/ui/dialog';
+import { useRollback } from '@/hooks/useRollback';
+import type { RollbackPreview } from '@/lib/hrm/rollback';
+
+export const ROLLBACK_LABELS = {
+  section: 'Previous version',
+  open: 'Go back to previous version',
+  confirm: 'I checked the versions and groups',
+  allow: 'Allow again',
+} as const;
+
+export function RollbackPanel({ appId }: { appId: string }) {
+  const { data, action } = useRollback(appId);
+  const [open, setOpen] = useState(false);
+  const [review, setReview] = useState<RollbackPreview | null>(null);
+  const [confirmed, setConfirmed] = useState(false);
+  const [startedJob, setStartedJob] = useState<string | null>(null);
+  if (!data?.supported || data.currentVersion === undefined) return null;
+  const skipped = data.skipped ?? [];
+  if (!data.available && skipped.length === 0) return null;
+
+  const openReview = () => {
+    action.reset(); setReview(null); setConfirmed(false); setStartedJob(null); setOpen(true);
+    action.mutate({ action: 'preview' }, { onSuccess: (r) => setReview(r.preview ?? null) });
+  };
+
+  return (
+    <div>
+      <h4 className="text-sm font-semibold text-text-secondary mb-2">{ROLLBACK_LABELS.section}</h4>
+      {data.available && data.previousVersion && (
+        <>
+          <p className="text-sm text-text-secondary">
+            If v{data.currentVersion} causes problems, go back to v{data.previousVersion}. Devices in this app&apos;s groups uninstall v{data.currentVersion} and install v{data.previousVersion}.
+          </p>
+          {data.hold ? (
+            <p className="mt-2 text-sm text-status-warning">{data.hold}</p>
+          ) : (
+            <Button variant="outline" size="sm" className="mt-2 border-overlay/10" onClick={openReview}>
+              <Undo2 className="w-4 h-4 mr-2" />
+              {ROLLBACK_LABELS.open}
+            </Button>
+          )}
+        </>
+      )}
+      {skipped.map((s) => (
+        <p key={s.version} className="mt-2 text-sm text-text-secondary">
+          Automatic updates skip v{s.version} (staff went back to v{s.rolledBackTo}).{' '}
+          <button className="text-accent-cyan hover:underline disabled:opacity-50" disabled={action.isPending}
+            onClick={() => action.mutate({ action: 'allow', version: s.version })}>{ROLLBACK_LABELS.allow}</button>
+        </p>
+      ))}
+
+      <Dialog open={open} onOpenChange={(value) => { if (!action.isPending) setOpen(value); }}>
+        <DialogContent className="max-w-lg">
+          <DialogHeader>
+            <DialogTitle>Go back to v{data.previousVersion}</DialogTitle>
+            <DialogDescription>
+              IntuneGet deploys v{data.previousVersion} again, from the installer it used before, as a new copy that replaces v{data.currentVersion}.
+              Intune uninstalls v{data.currentVersion} and then installs v{data.previousVersion} on devices in these groups.
+            </DialogDescription>
+          </DialogHeader>
+          {startedJob ? (
+            <div className="space-y-3 px-6 py-4 text-sm text-text-secondary">
+              <p>Going back to v{data.previousVersion} has started. Packaging takes a few minutes, then the groups move to the new copy.</p>
+              <p>Automatic updates skip v{data.currentVersion} from now on. A newer version still updates automatically.</p>
+              <Link className="text-accent-cyan hover:underline" href="/dashboard/uploads">Open Deployments</Link>
+            </div>
+          ) : (
+            <>
+              <div className="space-y-3 px-6 py-4">
+              {action.isPending && !review && <p role="status" className="text-sm text-text-muted">Reading the app and its groups in Intune…</p>}
+              {review && (
+                <div className="space-y-3 text-sm">
+                  <p className="text-text-secondary">These groups move from v{review.currentVersion} to v{review.previousVersion}:</p>
+                  {review.groups.length === 0
+                    ? <p className="text-status-warning">This copy has no groups, so the previous version would install nowhere. Add groups with Save to Intune first.</p>
+                    : <ul className="list-disc pl-5 text-text-primary">{review.groups.map((g) => <li key={g}>{g}</li>)}</ul>}
+                  <p className="text-text-muted">Check v{review.previousVersion} still works for staff, and that a downgrade is safe for this app (some apps keep settings the older version can&apos;t read).</p>
+                  <label className="flex items-start gap-2 text-text-primary">
+                    <input type="checkbox" className="mt-1" checked={confirmed} onChange={(e) => setConfirmed(e.target.checked)} />
+                    {ROLLBACK_LABELS.confirm}
+                  </label>
+                </div>
+              )}
+              {action.error && <p role="alert" className="text-sm text-status-error">{action.error.message}</p>}
+              </div>
+              {review && (
+                <DialogFooter>
+                <Button disabled={!confirmed || action.isPending || review.groups.length === 0}
+                  onClick={() => action.mutate({ action: 'start', token: review.token, previousJobId: review.previousJobId, confirmed: true },
+                    { onSuccess: (r) => setStartedJob(r.jobId ?? 'started') })}>
+                  {action.isPending ? 'Starting…' : `Go back to v${review.previousVersion}`}
+                </Button>
+                </DialogFooter>
+              )}
+            </>
+          )}
+        </DialogContent>
+      </Dialog>
+    </div>
+  );
+}
