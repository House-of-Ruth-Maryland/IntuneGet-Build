@@ -0,0 +1,117 @@
+// HRM patch 0037: going back to the previous version.
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import Database from 'better-sqlite3';
+import { runSqliteMigrations } from '@/lib/db/sqlite-migrations';
+import { createRollbackStore } from '../rollback-store';
+import { buildRollbackJob, rollbackToken, ROLLBACK_SKIP_REASON } from '../rollback';
+import { buildUpdateWorkflowInputs } from '../update-dispatch';
+import type { PackagingJob } from '@/lib/db/types';
+
+let db: Database.Database;
+let store: ReturnType<typeof createRollbackStore>;
+const CURRENT = '11111111-1111-4111-8111-111111111111';
+const OLDER = '22222222-2222-4222-8222-222222222222';
+const OLDEST = '33333333-3333-4333-8333-333333333333';
+
+function job(id: string, version: string, appId: string | null, status = 'deployed', at = '2026-01-01T00:00:00Z', extra: Record<string, unknown> = {}) {
+  db.prepare(`INSERT INTO packaging_jobs (id,user_id,tenant_id,winget_id,version,display_name,installer_type,installer_url,installer_sha256,package_config,status,intune_app_id,completed_at)
+    VALUES (?,'staff','tenant','Example.App',?,'Example','exe',?,?,?,?,?,?)`)
+    .run(id, version, extra.installer_url ?? `https://example.invalid/${version}.exe`, 'a'.repeat(64), JSON.stringify(extra.config ?? {}), status, appId, at);
+}
+
+beforeEach(() => { db = new Database(':memory:'); runSqliteMigrations(db); store = createRollbackStore(() => db); });
+afterEach(() => db.close());
+
+describe('finding the version to go back to', () => {
+  it('picks the newest earlier deployment of another copy with a different version and a saved installer', () => {
+    job('oldest', '1.0', OLDEST, 'deployed', '2026-01-01T00:00:00Z');
+    job('older', '1.1', OLDER, 'deployed', '2026-01-02T00:00:00Z');
+    job('failed', '1.2', null, 'failed', '2026-01-03T00:00:00Z');
+    job('no-installer', '1.3', '44444444-4444-4444-8444-444444444444', 'deployed', '2026-01-04T00:00:00Z', { installer_url: '' });
+    job('current', '2.0', CURRENT, 'deployed', '2026-01-05T00:00:00Z');
+    expect(store.previousJob('tenant', 'example.app', '2.0', CURRENT)?.id).toBe('older');
+    expect(store.currentJob('tenant', CURRENT)?.id).toBe('current');
+    expect(store.previousJob('other-tenant', 'Example.App', '2.0', CURRENT)).toBeNull();
+  });
+
+  it('never offers the same version again (a redeploy of 2.0 is not a previous version)', () => {
+    job('redeploy', '2.0', OLDER, 'deployed', '2026-01-02T00:00:00Z');
+    job('current', '2.0', CURRENT, 'deployed', '2026-01-05T00:00:00Z');
+    expect(store.previousJob('tenant', 'Example.App', '2.0', CURRENT)).toBeNull();
+  });
+
+  it('reports a running deployment for the app', () => {
+    job('current', '2.0', CURRENT);
+    expect(store.running('tenant', 'Example.App')).toBe(false);
+    job('queued', '1.1', null, 'queued');
+    expect(store.running('tenant', 'example.app')).toBe(true);
+  });
+
+  it('remembers skipped versions per tenant and app, and can allow them again', () => {
+    store.skip({ tenant_id: 'tenant', winget_id: 'Example.App', version: '2.0', rolled_back_to: '1.1', job_id: 'j', created_by: 'staff@example.test', created_at: '2026-01-06T00:00:00Z' });
+    expect(store.skipped('tenant', 'example.app', '2.0')?.rolled_back_to).toBe('1.1');
+    expect(store.skipped('tenant', 'Example.App', '2.1')).toBeNull();
+    expect(store.skipped('other', 'Example.App', '2.0')).toBeNull();
+    expect(store.listSkipped('tenant', 'Example.App')).toHaveLength(1);
+    expect(store.unskip('tenant', 'Example.App', '2.0')).toBe(true);
+    expect(store.unskip('tenant', 'Example.App', '2.0')).toBe(false);
+  });
+});
+
+describe('the rollback deployment', () => {
+  const previous = {
+    id: 'older', winget_id: 'Example.App', version: '1.1', display_name: 'Example', publisher: 'Example Co', architecture: 'x64',
+    installer_type: 'exe', installer_url: 'https://example.invalid/1.1.exe', installer_sha256: 'a'.repeat(64),
+    install_command: 'setup.exe /S', uninstall_command: 'uninstall.exe /S', install_scope: 'machine', detection_rules: [{ type: 'file' }],
+    package_config: { pilotRolloutId: 'old-pilot', autoUpdateHistoryId: 'h', sourceIntuneAppId: OLDEST, assignments: [{ groupId: 'stale' }],
+      categories: [{ id: 'old' }], relationships: [{ relationshipType: 'supersedence' }, { relationshipType: 'dependency', targetId: 'dep-old' }] },
+  } as unknown as PackagingJob;
+  const current = { id: 'current', display_name: 'Example App', package_config: { categories: [{ id: 'now' }], espProfiles: ['esp'], relationships: [{ relationshipType: 'dependency', targetId: 'dep-now' }] } } as unknown as PackagingJob;
+
+  it('reuses the previous installer and replaces the current copy, taking its live groups', () => {
+    const built = buildRollbackJob(previous, current, CURRENT, { userId: 'u', tenantId: 'tenant', userEmail: 'staff@example.test' }, '2.0');
+    const config = built.package_config as Record<string, unknown>;
+    expect(built).toMatchObject({ version: '1.1', installer_url: 'https://example.invalid/1.1.exe', installer_sha256: 'a'.repeat(64), uninstall_command: 'uninstall.exe /S', status: 'queued', is_auto_update: false, display_name: 'Example App' });
+    expect(config).toMatchObject({ sourceIntuneAppId: CURRENT, autoSupersede: true, supersedenceType: 'replace', forceCreate: true, assignments: [], categories: [{ id: 'now' }], espProfiles: ['esp'] });
+    expect(config.relationships).toEqual([{ relationshipType: 'dependency', targetId: 'dep-now' }]);
+    expect(config).not.toHaveProperty('pilotRolloutId');
+    expect(config).not.toHaveProperty('autoUpdateHistoryId');
+    expect(config.hrmRollback).toEqual({ fromVersion: '2.0', fromAppId: CURRENT, previousJobId: 'older' });
+  });
+
+  it('sends Replace supersedence and carries the groups over in the workflow', () => {
+    const built = { ...buildRollbackJob(previous, current, CURRENT, { userId: 'u', tenantId: 'tenant' }, '2.0'), id: 'rollback' } as PackagingJob;
+    const inputs = buildUpdateWorkflowInputs(built, 'https://example.invalid/callback');
+    expect(inputs).toMatchObject({ sourceIntuneAppId: CURRENT, supersedenceType: 'replace', autoSupersede: true, carryOverAssignments: true, removeAssignmentsFromPreviousApp: true, version: '1.1' });
+    expect(inputs.assignments).toBeUndefined();
+    const update = buildUpdateWorkflowInputs({ ...built, package_config: { sourceIntuneAppId: CURRENT } } as unknown as PackagingJob, 'https://example.invalid/callback');
+    expect(update.supersedenceType).toBe('update');
+  });
+
+  it('ties approval to the copy, both versions and the groups (in any order)', () => {
+    const a = rollbackToken(CURRENT, '2.0', 'older', ['g1', 'g2']);
+    expect(rollbackToken(CURRENT.toUpperCase(), '2.0', 'older', ['g2', 'g1'])).toBe(a);
+    expect(rollbackToken(CURRENT, '2.0', 'older', ['g1'])).not.toBe(a);
+    expect(rollbackToken(CURRENT, '2.1', 'older', ['g1', 'g2'])).not.toBe(a);
+    expect(rollbackToken(CURRENT, '2.0', 'oldest', ['g1', 'g2'])).not.toBe(a);
+  });
+});
+
+describe('automatic updates skip a rolled-back version', () => {
+  afterEach(() => { vi.unstubAllEnvs(); vi.resetModules(); vi.doUnmock('@/lib/db/sqlite'); });
+  it('holds only the skipped version, and only in SQLite mode', async () => {
+    vi.stubEnv('DATABASE_MODE', 'sqlite');
+    vi.doMock('@/lib/db/sqlite', () => ({ sqliteRollbacks: { skipped: (_t: string, _w: string, v: string) => (v === '2.0' ? { version: '2.0', rolled_back_to: '1.1' } : null) } }));
+    const { skippedVersionHold } = await import('../rollback-guard');
+    expect(await skippedVersionHold('tenant', 'Example.App', '2.0')).toBe(ROLLBACK_SKIP_REASON('2.0', '1.1'));
+    expect(await skippedVersionHold('tenant', 'Example.App', '2.1')).toBeNull();
+    vi.stubEnv('DATABASE_MODE', 'supabase');
+    expect(await skippedVersionHold('tenant', 'Example.App', '2.0')).toBeNull();
+  });
+  it('ignores a mocked database module without the store', async () => {
+    vi.stubEnv('DATABASE_MODE', 'sqlite');
+    vi.doMock('@/lib/db/sqlite', () => ({}));
+    const { skippedVersionHold } = await import('../rollback-guard');
+    expect(await skippedVersionHold('tenant', 'Example.App', '2.0')).toBeNull();
+  });
+});
