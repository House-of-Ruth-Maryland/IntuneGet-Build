@@ -0,0 +1,43 @@
+'use client';
+// HRM patch 0037: go back to the previous version (Inventory app details).
+import { useMutation, useQuery, useQueryClient } from '@tanstack/react-query';
+import { useMicrosoftAuth } from './useMicrosoftAuth';
+import type { RollbackPreview } from '@/lib/hrm/rollback';
+
+export interface RollbackStatus {
+  supported: boolean;
+  available?: boolean;
+  currentVersion?: string;
+  previousVersion?: string | null;
+  reason?: string | null;
+  hold?: string | null;
+  skipped?: Array<{ version: string; rolledBackTo: string; at: string }>;
+}
+
+export function useRollback(appId: string | null) {
+  const { getAccessToken, isAuthenticated, account } = useMicrosoftAuth();
+  const client = useQueryClient();
+  const key = ['hrm', 'rollback', account?.tenantId, appId];
+  const request = async (body?: Record<string, unknown>) => {
+    const token = await getAccessToken();
+    if (!token) throw new Error('Sign in again.');
+    const response = await fetch(body ? '/api/hrm/rollback' : `/api/hrm/rollback?appId=${encodeURIComponent(appId ?? '')}`, {
+      method: body ? 'POST' : 'GET',
+      headers: { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json' },
+      ...(body ? { body: JSON.stringify({ appId, ...body }) } : {}),
+    });
+    if (response.redirected || !response.headers.get('content-type')?.includes('application/json')) throw new Error('Your sign-in expired. Reload and sign in again.');
+    const data = await response.json();
+    if (!response.ok) throw new Error(data.error || 'Could not go back to the previous version.');
+    return data as RollbackStatus & { preview?: RollbackPreview; started?: boolean; jobId?: string; allowed?: boolean };
+  };
+  const query = useQuery({ queryKey: key, queryFn: () => request(), enabled: isAuthenticated && Boolean(appId), staleTime: 15000 });
+  const action = useMutation({
+    mutationFn: request,
+    onSuccess: async (data) => {
+      if (data.preview) return;
+      await Promise.all([client.invalidateQueries({ queryKey: key }), client.invalidateQueries({ queryKey: ['availableUpdates'] })]);
+    },
+  });
+  return { ...query, action };
+}
