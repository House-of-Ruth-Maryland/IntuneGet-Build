index 000000000..e1a96f9d6
--- /dev/null
+++ b/components/hrm/UpdateSchedule.render.test.ts
@@ -0,0 +1,33 @@
+// @vitest-environment happy-dom
+import { act, createElement } from 'react';
+import { createRoot, type Root } from 'react-dom/client';
+import { afterEach, beforeEach, expect, it, vi } from 'vitest';
+const state = vi.hoisted(() => ({ paused: false, schedule: { enabled: false, paused: false, days: [0,1,2,3,4,5,6], startHour: 0, endHour: 24 }, mutate: vi.fn(), reset: vi.fn() }));
+vi.mock('@/hooks/useUpdateSchedule', () => ({ useUpdateSchedule: () => ({ data: { supported: true, schedule: Object.assign(state.schedule, { paused: state.paused }), blackouts: [], window: { open: !state.paused } }, action: { mutate: state.mutate, reset: state.reset, isPending: false } }) }));
+import { UpdateSchedule } from './UpdateSchedule';
+(globalThis as typeof globalThis & { IS_REACT_ACT_ENVIRONMENT: boolean }).IS_REACT_ACT_ENVIRONMENT = true;
+let root: Root;
+const button = (label: string) => [...document.querySelectorAll('button')].find(b => b.textContent === label)!;
+beforeEach(async () => { state.paused = false; state.mutate.mockReset(); const node = document.createElement('div'); document.body.append(node); root = createRoot(node); await act(async () => root.render(createElement(UpdateSchedule))); });
+afterEach(async () => { await act(async () => root.unmount()); document.body.innerHTML = ''; });
+it('explains server checks and offers a distinct global pause action', async () => {
+  expect(document.body.textContent).toContain('3:30 AM and 3:30 PM Maryland time');
+  expect(document.body.textContent).toContain('do not set a computer installation time');
+  await act(async () => button('Pause automatic publishing').click());
+  expect(state.mutate.mock.calls[0][0]).toEqual({ action: 'setPaused', paused: true });
+  state.paused = true;
+  await act(async () => root.render(createElement(UpdateSchedule)));
+  expect(document.body.textContent).toContain('Paused for all apps');
+  await act(async () => button('Resume automatic publishing').click());
+  expect(state.mutate.mock.calls[1][0]).toEqual({ action: 'setPaused', paused: false });
+});
+it('saves an unrestricted schedule without resuming paused publishing', async () => {
+  state.paused = true;
+  await act(async () => root.render(createElement(UpdateSchedule)));
+  await act(async () => button('Edit publishing schedule').click());
+  expect(document.querySelector('[role="dialog"]')).toBeTruthy();
+  expect(document.body.textContent).toContain('Unchecked means publishing is allowed at any time');
+  await act(async () => button('Save publishing schedule').click());
+  expect(state.mutate.mock.calls[0][0]).toMatchObject({ action: 'save', schedule: { enabled: false, paused: true } });
+  expect(state.mutate.mock.calls.some(([body]) => body.action === 'setPaused')).toBe(false);
+});
