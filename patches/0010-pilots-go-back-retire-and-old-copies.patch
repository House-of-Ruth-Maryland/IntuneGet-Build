+vi.mock('@/lib/hrm/installer-check',()=>({checkInstallerReachable:state.reach,verifyInstallerChecksum:state.verify}));
+import {sqliteRollbackReadiness,sqliteDb,sqliteRollbacks,sqlitePilotRollouts,sqliteRetirements,closeSqliteDb} from '@/lib/db/sqlite';
+import {GET,POST} from './route';
+const OLD='11111111-1111-4111-8111-111111111111',NEW='22222222-2222-4222-8222-222222222222',GROUP='33333333-3333-4333-8333-333333333333';
+let groups:unknown[];let writes:string[];
