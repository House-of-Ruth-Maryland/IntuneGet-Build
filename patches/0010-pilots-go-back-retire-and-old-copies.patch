@@ -0,0 +1,39 @@
+'use client';
+// HRM patch 0038: retire an app (Inventory app details).
+import { useMutation, useQuery, useQueryClient } from '@tanstack/react-query';
+import { useMicrosoftAuth } from './useMicrosoftAuth';
+import type { RetirePreview, RetireStatus } from '@/lib/hrm/retire';
+
+export function useRetire(appId: string | null) {
+  const { getAccessToken, isAuthenticated, account } = useMicrosoftAuth();
+  const client = useQueryClient();
+  const key = ['hrm', 'retire', account?.tenantId, appId];
+  const request = async (body?: Record<string, unknown>) => {
+    const token = await getAccessToken();
+    if (!token) throw new Error('Sign in again.');
+    const response = await fetch(body ? '/api/hrm/retire' : `/api/hrm/retire?appId=${encodeURIComponent(appId ?? '')}`, {
+      method: body ? 'POST' : 'GET',
+      headers: { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json' },
+      ...(body ? { body: JSON.stringify({ appId, ...body }) } : {}),
+    });
+    if (response.redirected || !response.headers.get('content-type')?.includes('application/json')) throw new Error('Your sign-in expired. Reload and sign in again.');
+    const data = await response.json();
+    if (!response.ok) throw new Error(data.error || 'Could not complete the retirement step.');
+    return data as RetireStatus & { preview?: RetirePreview; started?: boolean; cancelled?: boolean; deleted?: boolean };
+  };
+  const query = useQuery({ queryKey: key, queryFn: () => request(), enabled: isAuthenticated && Boolean(appId), staleTime: 30000,
+    refetchInterval: (q) => (q.state.data?.retirement?.phase === 'uninstalling' ? 120000 : false) });
+  const action = useMutation({
+    mutationFn: request,
+    onSuccess: async (data) => {
+      if (data.preview) return;
+      await Promise.all([
+        client.invalidateQueries({ queryKey: key }),
+        client.invalidateQueries({ queryKey: ['hrm', 'app-insights'] }),
+        client.invalidateQueries({ queryKey: ['hrm', 'rollback'] }),
+        client.invalidateQueries({ queryKey: ['availableUpdates'] }),
+      ]);
+    },
+  });
+  return { ...query, action };
+}
diff --git a/hooks/useRollback.ts b/hooks/useRollback.ts
new file mode 100644
index 000000000..746ef38e8
--- /dev/null
+++ b/hooks/useRollback.ts
@@ -0,0 +1,49 @@
+'use client';
+// HRM patch 0037: go back to the previous version (Inventory app details).
+import { useMutation, useQuery, useQueryClient } from '@tanstack/react-query';
+import { useMicrosoftAuth } from './useMicrosoftAuth';
+import type { RollbackPreview } from '@/lib/hrm/rollback';
+
+export interface RollbackStatus {
+  supported: boolean;
+  available?: boolean;
+  currentVersion?: string;
+  previousVersion?: string | null;
+  reason?: string | null;
+  hold?: string | null;
+  skipped?: Array<{ version: string; rolledBackTo: string; at: string }>;
+  // HRM patch 0039: the last check of the previous installer
+  canVerify?: boolean;
+  readiness?: { status: 'ready' | 'missing' | 'unreachable' | 'unsupported'; detail: string | null; checkedAt: string; checksum: 'checking' | 'match' | 'mismatch' | 'missing' | 'unreachable' | null; checksumCheckedAt: string | null } | null;
+}
+
+export function useRollback(appId: string | null) {
+  const { getAccessToken, isAuthenticated, account } = useMicrosoftAuth();
+  const client = useQueryClient();
+  const key = ['hrm', 'rollback', account?.tenantId, appId];
+  const request = async (body?: Record<string, unknown>) => {
+    const token = await getAccessToken();
+    if (!token) throw new Error('Sign in again.');
+    const response = await fetch(body ? '/api/hrm/rollback' : `/api/hrm/rollback?appId=${encodeURIComponent(appId ?? '')}`, {
+      method: body ? 'POST' : 'GET',
+      headers: { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json' },
+      ...(body ? { body: JSON.stringify({ appId, ...body }) } : {}),
+    });
+    if (response.redirected || !response.headers.get('content-type')?.includes('application/json')) throw new Error('Your sign-in expired. Reload and sign in again.');
+    const data = await response.json();
+    if (!response.ok) throw new Error(data.error || 'Could not go back to the previous version.');
+    return data as RollbackStatus & { preview?: RollbackPreview; started?: boolean; jobId?: string; allowed?: boolean; verifying?: boolean };
+  };
+  const query = useQuery({ queryKey: key, queryFn: () => request(), enabled: isAuthenticated && Boolean(appId), staleTime: 15000,
+    // HRM patch 0039: follow a checksum check while it runs
+    refetchInterval: (q) => (q.state.data?.readiness?.checksum === 'checking' ? 10000 : false) });
+  const action = useMutation({
+    mutationFn: request,
+    onSuccess: async (data) => {
+      if (data.preview) return;
+      // HRM patch 0038: a rollback holds Retire app too.
+      await Promise.all([client.invalidateQueries({ queryKey: key }), client.invalidateQueries({ queryKey: ['availableUpdates'] }), client.invalidateQueries({ queryKey: ['hrm', 'retire'] })]);
+    },
+  });
+  return { ...query, action };
+}
diff --git a/lib/hrm/__tests__/installer-check.test.ts b/lib/hrm/__tests__/installer-check.test.ts
new file mode 100644
index 000000000..79ff7e41b
--- /dev/null
+++ b/lib/hrm/__tests__/installer-check.test.ts
@@ -0,0 +1,40 @@
+import { describe, expect, it, vi } from 'vitest';
+import { createHash } from 'node:crypto';
+import { checkInstallerReachable, verifyInstallerChecksum, isPublicAddress } from '../installer-check';
+const lookup = async () => [{ address: '93.184.216.34' }];
+const url = 'https://download.example.test/app.exe';
+describe('saved installer checks', () => {
+  it.each(['127.0.0.1', '10.1.1.1', '169.254.169.254', '100.64.0.1', '::1', 'fc00::1', 'fe80::1', '::ffff:7f00:1', '2002:7f00:1::'])('refuses nonpublic address %s', address => expect(isPublicAddress(address)).toBe(false));
+  it('refuses unsafe protocols and redirects without sending a second request', async () => {
+    const fetchImpl = vi.fn().mockResolvedValue(new Response(null, { status: 302, headers: { location: 'https://127.0.0.1/secret' } }));
+    expect((await checkInstallerReachable(url, { lookup, fetchImpl })).status).toBe('unsupported');
+    expect(fetchImpl).toHaveBeenCalledTimes(1);
+    expect((await checkInstallerReachable('http://download.example.test/app', { lookup, fetchImpl })).status).toBe('unsupported');
+    expect(fetchImpl).toHaveBeenCalledTimes(1);
+  });
+  it('distinguishes gone files from temporary failures and falls back from HEAD', async () => {
+    const fetchImpl = vi.fn().mockResolvedValueOnce(new Response(null, { status: 405 })).mockResolvedValueOnce(new Response('x', { status: 206 }));
+    expect((await checkInstallerReachable(url, { lookup, fetchImpl })).status).toBe('ready');
+    expect(fetchImpl.mock.calls[1][1]).toMatchObject({ method: 'GET', headers: { Range: 'bytes=0-0' } });
+    for (const [status, result] of [[404, 'missing'], [410, 'missing'], [503, 'unreachable']] as const) {
+      expect((await checkInstallerReachable(url, { lookup, fetchImpl: vi.fn().mockResolvedValue(new Response(null, { status })) })).status).toBe(result);
+    }
+  });
+  it('compares actual bytes and stops oversized downloads', async () => {
+    const digest = createHash('sha256').update('installer').digest('hex');
+    const fetchImpl = vi.fn(async (_url, init) => new Response(init?.method === 'HEAD' ? null : 'installer')) as typeof fetch;
+    expect((await verifyInstallerChecksum(url, digest, { lookup, fetchImpl })).status).toBe('match');
+    expect((await verifyInstallerChecksum(url, 'a'.repeat(64), { lookup, fetchImpl })).status).toBe('mismatch');
+    expect((await verifyInstallerChecksum(url, digest, { lookup, fetchImpl, maxBytes: 2 })).status).toBe('unreachable');
+  });
+  it('marks links the server will never fetch as unsupported, and a missing host as unreachable', async () => {
+    const fetchImpl = vi.fn();
+    expect((await checkInstallerReachable('http://download.example.test/app.exe', { lookup, fetchImpl })).status).toBe('unsupported');
+    expect((await checkInstallerReachable(url, { lookup: async () => [{ address: '10.0.0.5' }], fetchImpl })).status).toBe('unsupported');
+    expect((await checkInstallerReachable(url, { lookup: async () => [], fetchImpl })).status).toBe('unreachable');
+    expect(fetchImpl).not.toHaveBeenCalled();
+  });
+  it('does not let a bad redirect throw out the scheduled run', async () => {
+    expect((await checkInstallerReachable(url, { lookup, fetchImpl: vi.fn().mockResolvedValue(new Response(null, { status: 302, headers: { location: 'https://[' } })) })).status).toBe('unreachable');
+  });
+});
diff --git a/lib/hrm/__tests__/old-copy-cleanup.test.ts b/lib/hrm/__tests__/old-copy-cleanup.test.ts
