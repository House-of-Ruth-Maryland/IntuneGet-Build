@@ -0,0 +1,288 @@
+// HRM patch 0042: automatic removal of old copies after an update.
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import Database from 'better-sqlite3';
+import { runSqliteMigrations } from '@/lib/db/sqlite-migrations';
+import { createOldCopyStore } from '../old-copy-store';
+import { createPilotStore } from '../pilot-store';
+import { createRetireStore } from '../retire-store';
+import { createRollbackStore } from '../rollback-store';
+import { createAppInsightsStore } from '../app-insights-store';
+import type { GraphAssignment } from '../duplicates';
+
+const h = vi.hoisted(() => ({ db: null as unknown as import('better-sqlite3').Database, installs: new Map<string, { installed: number; failed: number }>() }));
+vi.mock('@/lib/intune/graph-client', () => ({ GRAPH_API_BASE: 'https://graph.microsoft.com/v1.0', getServicePrincipalToken: async () => 'token' }));
+vi.mock('@/lib/db/sqlite', async () => {
+  const getDb = () => h.db;
+  const { createOldCopyStore: oc } = await import('../old-copy-store');
+  const { createPilotStore: p } = await import('../pilot-store');
+  const { createRetireStore: r } = await import('../retire-store');
+  const { createRollbackStore: rb } = await import('../rollback-store');
+  const { createAppInsightsStore: ai } = await import('../app-insights-store');
+  return {
+    sqliteOldCopies: oc(getDb), sqlitePilotRollouts: p(getDb), sqliteRetirements: r(getDb), sqliteRollbacks: rb(getDb), sqliteAppInsights: ai(getDb),
+    sqliteInstallStatus: { get: async (_t: string, id: string) => h.installs.get(id.toLowerCase()) ?? null },
+  };
+});
+import { assignmentKey, installsSettled, judgeOldCopy, runSqliteOldCopyCleanup, SETTLE_MS, stuckReason, supersededAt } from '../old-copy-cleanup';
+
+const id = (n: number) => `${String(n).repeat(8)}-${String(n).repeat(4)}-4${String(n).repeat(3)}-8${String(n).repeat(3)}-${String(n).repeat(12)}`;
+const [V1, V2, V3, V4, OTHER] = [1, 2, 3, 4, 5].map(id);
+const G1 = 'aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa';
+const G2 = 'bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb';
+const group = (groupId: string, intent = 'required', extra: Record<string, unknown> = {}): GraphAssignment =>
+  ({ id: `${intent}-${groupId}`, intent, target: { '@odata.type': '#microsoft.graph.groupAssignmentTarget', groupId, ...extra } });
+const NOW = new Date('2026-11-20T08:30:00Z');
+const daysAgo = (d: number) => new Date(NOW.getTime() - d * 86400000).toISOString();
+
+// A small Intune: apps, their groups, and the supersedence links each app owns (parent -> children).
+interface FakeApp { displayName: string; displayVersion: string; assignments: GraphAssignment[] }
+let apps: Map<string, FakeApp>;
+let links: Map<string, string[]>;
+let calls: string[];
+function relationshipsOf(appId: string) {
+  const owned = (links.get(appId) ?? []).map((t) => ({ '@odata.type': '#microsoft.graph.mobileAppSupersedence', targetId: t, targetType: 'child', supersedenceType: 'update', targetDisplayName: apps.get(t)?.displayName }));
+  const parents = [...links].filter(([, kids]) => kids.includes(appId)).map(([p]) => ({ '@odata.type': '#microsoft.graph.mobileAppSupersedence', targetId: p, targetType: 'parent', supersedenceType: 'update', targetDisplayName: apps.get(p)?.displayName }));
+  return [...owned, ...parents];
+}
+const json = (body: unknown, status = 200) => new Response(JSON.stringify(body), { status, headers: { 'Content-Type': 'application/json' } });
+async function fakeGraph(input: RequestInfo | URL, init: RequestInit = {}) {
+  const url = String(input);
+  const method = init.method ?? 'GET';
+  calls.push(`${method} ${url.replace(/^https:\/\/graph\.microsoft\.com\/(v1\.0|beta)/, '')}`);
+  const m = url.match(/mobileApps\/([0-9a-f-]{36})(\/[a-zA-Z]+)?$/);
+  if (!m) return json({}, 404);
+  const [, appId, tail] = m;
+  const app = apps.get(appId);
+  if (!app) return json({ error: { message: 'Not found' } }, 404);
+  if (method === 'GET' && !tail) return json({ id: appId, '@odata.type': '#microsoft.graph.win32LobApp', publisher: 'Example', displayName: app.displayName, displayVersion: app.displayVersion });
+  if (method === 'GET' && tail === '/assignments') return json({ value: app.assignments });
+  if (method === 'GET' && tail === '/relationships') return json({ value: relationshipsOf(appId) });
+  if (method === 'POST' && tail === '/assign') { app.assignments = JSON.parse(String(init.body)).mobileAppAssignments; return new Response(null, { status: 204 }); }
+  if (method === 'POST' && tail === '/updateRelationships') { links.set(appId, JSON.parse(String(init.body)).relationships.map((r: { targetId: string }) => r.targetId)); return json({}); }
+  if (method === 'DELETE') {
+    if ([...links.values()].some((kids) => kids.includes(appId))) return json({ error: { message: 'App is superseded by another app' } }, 400);
+    apps.delete(appId); links.delete(appId); return new Response(null, { status: 204 });
+  }
+  return json({}, 400);
+}
+
+const deployed = (appId: string, version: string, at: string, wingetId = 'Example.PdfTool') =>
+  h.db.prepare(`INSERT INTO upload_history (id, user_id, winget_id, version, display_name, intune_app_id, intune_tenant_id, deployed_at) VALUES (?, 'staff', ?, ?, 'PDF tool', ?, 'tenant', ?)`)
+    .run(`h-${appId}-${version}`, wingetId, version, appId, at);
+
+beforeEach(() => {
+  h.db = new Database(':memory:'); runSqliteMigrations(h.db); h.installs.clear();
