+// HRM patch 0037: go back to the previous version of an app IntuneGet deployed.
+//   GET  ?appId=  whether this copy can go back, and to which version (database only)
+//   POST { action: 'preview', appId }  read the copy and its live groups from Intune; returns a review token
+//   POST { action: 'start', appId, previousJobId, token, confirmed: true }  start the rollback deployment
+//   POST { action: 'allow', appId, version }  let automatic updates deploy a skipped version again
+//   POST { action: 'verify', appId }  download the previous installer once and compare its checksum (HRM patch 0039; runs in the background)
+// The new deployment replaces the current copy (Replace supersedence: Intune uninstalls the current
+// version, then installs the previous one) and takes over its live groups. Nothing changes in Intune
+// until packaging finishes. Failures use 409/424, because Cloudflare replaces 502 with its own page.
+import { NextRequest, NextResponse } from 'next/server';
+import { parseAccessToken } from '@/lib/auth-utils';
+import { getDatabase, isSqliteMode } from '@/lib/db';
+import { getFeatureFlags } from '@/lib/features';
+import { isGitHubActionsConfigured } from '@/lib/github-actions';
+import { getServicePrincipalToken } from '@/lib/intune/graph-client';
+import { isSelfUpdatingApp } from '@/lib/self-updating-apps';
+import { GUID, summarizeAssignments } from '@/lib/hrm/app-insights';
+import { pilotGraph, PilotError } from '@/lib/hrm/pilot-graph';
+import { pilotHold } from '@/lib/hrm/pilot-guard';
+import { dispatchUpdateJob } from '@/lib/hrm/update-dispatch';
+import { buildRollbackJob, rollbackToken, type RollbackPreview } from '@/lib/hrm/rollback';
+import { checkInstallerReachable, verifyInstallerChecksum } from '@/lib/hrm/installer-check';
+import { RETIRE_HOLD } from '@/lib/hrm/retire';
+
+export const maxDuration = 120;
+const reply = (body: unknown, status = 200) => NextResponse.json(body, { status, headers: { 'Cache-Control': 'private, no-store' } });
+const supported = () => isSqliteMode() && !getFeatureFlags().localPackager && isGitHubActionsConfigured();
+// One rollback start at a time per app on this server (a double press can't create two copies).
+const starting = new Set<string>();
+// HRM patch 0039: one checksum download at a time per app. A check older than 20 minutes is treated as stopped (server restart).
+const verifying = new Set<string>();
+const STALE_CHECK_MS = 20 * 60000;
+
+type User = NonNullable<Awaited<ReturnType<typeof parseAccessToken>>>;
+
+async function candidate(user: User, appId: string) {
+  const { sqliteAppInsights, sqliteRollbacks } = await import('@/lib/db/sqlite');
+  const deployment = sqliteAppInsights.tracked(user.tenantId).find((d) => d.appId.toLowerCase() === appId.toLowerCase());
+  if (!deployment) return null;
+  if (isSelfUpdatingApp(deployment.wingetId)) return { deployment, previous: null, reason: 'This app keeps itself up to date on the device, so IntuneGet does not deploy its versions.' };
+  const previous = sqliteRollbacks.previousJob(user.tenantId, deployment.wingetId, deployment.version, deployment.appId);
+  return { deployment, previous, reason: previous ? null : 'No earlier version deployed by IntuneGet to go back to.' };
+}
+
+async function blocked(user: User, wingetId: string, appId: string): Promise<string | null> {
+  const { sqlitePilotRollouts, sqliteRollbacks } = await import('@/lib/db/sqlite');
+  // HRM patch 0038: pilotHold also reports an app being retired; show that message as it is.
+  const held = await pilotHold(user.tenantId, wingetId);
+  if (held === RETIRE_HOLD) return held;
+  if (sqlitePilotRollouts.holdsApp(user.tenantId, appId) || held) return 'A pilot is active for this app. Finish it in App updates first.';
+  if (sqliteRollbacks.running(user.tenantId, wingetId)) return 'A deployment for this app is still running. Check Deployments.';
+  return null;
+}
+
+async function preview(user: User, appId: string): Promise<RollbackPreview> {
+  const found = await candidate(user, appId);
+  if (!found) throw new PilotError('Only the newest copy IntuneGet deployed can go back to a previous version. Refresh Inventory.');
+  if (!found.previous) throw new PilotError(found.reason!);
+  const hold = await blocked(user, found.deployment.wingetId, found.deployment.appId);
+  if (hold) throw new PilotError(hold);
+  const token = await getServicePrincipalToken(user.tenantId);
+  if (!token) throw new PilotError("Couldn't reach Intune. Try again.", 424);
+  const graph = pilotGraph(token, fetch, 'Could not read this app from Intune completely. Nothing was changed.');
+  const [app, rows] = await Promise.all([graph.app(found.deployment.appId), graph.assignments(found.deployment.appId)]);
+  if (app.displayVersion !== found.deployment.version) throw new PilotError('The version in Intune no longer matches IntuneGet. Refresh Inventory.');
+  // HRM patch 0039: the previous installer must still download, or the rollback would fail in packaging.
+  const reach = await checkInstallerReachable(found.previous.installer_url ?? '');
+  const { sqliteRollbackReadiness } = await import('@/lib/db/sqlite');
+  sqliteRollbackReadiness.record({ tenant_id: user.tenantId, app_id: found.deployment.appId, previous_job_id: found.previous.id, previous_version: found.previous.version,
+    status: reach.status, detail: reach.detail, checked_at: new Date().toISOString() });
+  if (reach.status === 'missing') throw new PilotError(`The v${found.previous.version} installer no longer downloads: ${reach.detail} Going back from IntuneGet isn't possible.`);
+  if (reach.status === 'unsupported') throw new PilotError(`The saved v${found.previous.version} download link can't be used: ${reach.detail} Going back from IntuneGet isn't possible.`);
+  if (reach.status === 'unreachable') throw new PilotError(`Couldn't reach the v${found.previous.version} installer just now: ${reach.detail} Try again later.`, 424);
+  const saved = sqliteRollbackReadiness.get(user.tenantId, found.deployment.appId);
+  const checksum = saved?.checksum_status;
+  // A check older than 20 minutes stopped (server restart) and no longer blocks.
+  if (checksum === 'checking' && Date.now() - Date.parse(saved?.checksum_checked_at ?? '') < STALE_CHECK_MS) {
+    throw new PilotError('Wait for the installer checksum check to finish before going back.');
+  }
+  if (checksum === 'mismatch') {
+    throw new PilotError(`The v${found.previous.version} installer has changed since IntuneGet used it, so going back would fail its checksum check.`);
+  }
+  const groups = summarizeAssignments(rows);
+  return {
+    token: rollbackToken(found.deployment.appId, found.deployment.version, found.previous.id, groups.map((g) => g.key)),
+    appId: found.deployment.appId,
+    displayName: found.deployment.displayName,
+    currentVersion: found.deployment.version,
+    previousVersion: found.previous.version,
+    previousJobId: found.previous.id,
+    groups: groups.map((g) => g.label),
+    checkedAt: new Date().toISOString(),
+  };
+}
+
+export async function GET(request: NextRequest) {
+  const user = await parseAccessToken(request.headers.get('Authorization'));
+  if (!user) return reply({ error: 'Authentication required' }, 401);
+  if (!supported()) return reply({ supported: false });
+  const appId = new URL(request.url).searchParams.get('appId') ?? '';
+  if (!GUID.test(appId)) return reply({ error: 'Invalid app' }, 400);
+  const found = await candidate(user, appId);
+  if (!found) return reply({ supported: true, available: false });
+  const { sqliteRollbacks, sqliteRollbackReadiness } = await import('@/lib/db/sqlite');
+  const r = found.previous ? sqliteRollbackReadiness.get(user.tenantId, found.deployment.appId) : null;
+  const current = r && r.previous_job_id === found.previous?.id ? r : null;
+  const checking = current?.checksum_status === 'checking' && Date.now() - Date.parse(current.checksum_checked_at ?? '') < STALE_CHECK_MS;
+  return reply({
+    // HRM patch 0039: Check installer now needs the checksum IntuneGet saved.
+    canVerify: Boolean(found.previous?.installer_sha256),
+    readiness: current ? { status: current.status, detail: current.detail, checkedAt: current.checked_at,
+      checksum: current.checksum_status === 'checking' ? (checking ? 'checking' : null) : current.checksum_status, checksumCheckedAt: current.checksum_checked_at } : null,
+    supported: true,
+    available: Boolean(found.previous),
+    currentVersion: found.deployment.version,
+    previousVersion: found.previous?.version ?? null,
+    reason: found.reason,
+    hold: found.previous ? await blocked(user, found.deployment.wingetId, found.deployment.appId) : null,
+    skipped: sqliteRollbacks.listSkipped(user.tenantId, found.deployment.wingetId).map((s) => ({ version: s.version, rolledBackTo: s.rolled_back_to, at: s.created_at })),
+  });
+}
+
+export async function POST(request: NextRequest) {
+  const user = await parseAccessToken(request.headers.get('Authorization'));
+  if (!user) return reply({ error: 'Authentication required' }, 401);
+  if (!supported()) return reply({ error: 'Going back to a previous version needs this server’s SQLite and GitHub packaging mode.' }, 409);
+  const body = (await request.json().catch(() => null)) as Record<string, unknown> | null;
+  const appId = typeof body?.appId === 'string' ? body.appId : '';
+  if (!body || !['preview', 'start', 'allow', 'verify'].includes(String(body.action)) || !GUID.test(appId)) return reply({ error: 'Invalid request' }, 400);
+  try {
+    if (body.action === 'preview') return reply({ preview: await preview(user, appId) });
+    if (body.action === 'verify') {
+      const found = await candidate(user, appId);
+      if (!found?.previous?.installer_url || !found.previous.installer_sha256) throw new PilotError('There is no earlier installer with a checksum to check.', 400);
+      const key = `${user.tenantId}|${found.deployment.appId.toLowerCase()}`;
+      if (verifying.has(key)) return reply({ verifying: true });
+      const { sqliteRollbackReadiness } = await import('@/lib/db/sqlite');
+      if (verifying.size >= 2) throw new PilotError('Two installer checks are running. Try again when one finishes.', 429);
+      // Hold the slot before the first await, so two quick presses can't start a third download.
+      verifying.add(key);
+      // Check the link first and record what it really says; the full download only starts when it answers.
+      let reach;
+      try { reach = await checkInstallerReachable(found.previous.installer_url); } catch (error) { verifying.delete(key); throw error; }
+      sqliteRollbackReadiness.record({ tenant_id: user.tenantId, app_id: found.deployment.appId, previous_job_id: found.previous.id,
+        previous_version: found.previous.version, status: reach.status, detail: reach.detail, checked_at: new Date().toISOString() });
+      if (reach.status !== 'ready') { verifying.delete(key); return reply({ verifying: false, readiness: reach.status }); }
+      sqliteRollbackReadiness.checksum(user.tenantId, found.deployment.appId, found.previous.id, 'checking', null);
+      const previous = found.previous;
+      void verifyInstallerChecksum(previous.installer_url!, previous.installer_sha256!)
+        .then((result) => { sqliteRollbackReadiness.checksum(user.tenantId, found.deployment.appId, previous.id, result.status, result.detail); })
+        .catch(() => { sqliteRollbackReadiness.checksum(user.tenantId, found.deployment.appId, previous.id, 'unreachable', 'The check stopped unexpectedly.'); })
+        .finally(() => verifying.delete(key));
+      return reply({ verifying: true }, 202);
+    }
+    if (body.action === 'allow') {
+      const found = await candidate(user, appId);
+      if (!found || typeof body.version !== 'string' || body.version.length > 100) throw new PilotError('Refresh Inventory and try again.', 400);
+      const { sqliteRollbacks } = await import('@/lib/db/sqlite');
+      if (!sqliteRollbacks.unskip(user.tenantId, found.deployment.wingetId, body.version)) throw new PilotError('That version is no longer skipped.');
+      return reply({ allowed: true });
+    }
+
+    if (body.confirmed !== true || typeof body.token !== 'string' || !/^[a-f0-9]{64}$/.test(body.token) || typeof body.previousJobId !== 'string') {
+      throw new PilotError('Review the versions and groups, and confirm, first.', 400);
+    }
+    const key = `${user.tenantId}|${appId.toLowerCase()}`;
+    if (starting.has(key)) throw new PilotError('Going back is already starting for this app. Check Deployments.');
+    starting.add(key);
+    try {
+      const checked = await preview(user, appId);
+      if (checked.token !== body.token || checked.previousJobId !== body.previousJobId) {
+        throw new PilotError('The versions or groups changed after your review. Review again before going back.');
+      }
+      const { sqliteRollbacks } = await import('@/lib/db/sqlite');
+      const previous = sqliteRollbacks.previousJob(user.tenantId, (await candidate(user, appId))!.deployment.wingetId, checked.currentVersion, checked.appId);
+      if (!previous || previous.id !== checked.previousJobId) throw new PilotError('The previous version changed. Review again.');
+      const db = getDatabase();
+      const job = await db.jobs.create(buildRollbackJob(previous, sqliteRollbacks.currentJob(user.tenantId, checked.appId), checked.appId, user, checked.currentVersion));
+      // Automatic updates must not redeploy the version staff just went back from.
+      sqliteRollbacks.skip({ tenant_id: user.tenantId, winget_id: previous.winget_id, version: checked.currentVersion, rolled_back_to: previous.version,
+        job_id: job.id, created_by: user.userEmail || user.userId, created_at: new Date().toISOString() });
+      const dispatch = await dispatchUpdateJob(db, job.id);
+      console.log(JSON.stringify({ route: '/api/hrm/rollback', action: 'start', job: job.id, dispatched: dispatch.dispatched }));
+      if (!dispatch.dispatched && dispatch.reason !== 'local-packager') {
+        return reply({ started: false, jobId: job.id, error: `Going back didn't start: ${dispatch.message} Check Deployments.` }, 409);
+      }
+      return reply({ started: true, jobId: job.id, previousVersion: previous.version });
+    } finally {
+      starting.delete(key);
+    }
+  } catch (error) {
+    if (error instanceof PilotError) return reply({ error: error.message }, error.status);
+    const text = error instanceof Error ? error.message : '';
+    const message = /being retired/i.test(text) ? RETIRE_HOLD
+      : /pilot rollout is active/i.test(text) ? 'A pilot is active for this app. Finish it in App updates first.'
+      : 'Could not go back to the previous version. Check Deployments and try again.';
+    return reply({ error: message }, 409);
+  }
+}
