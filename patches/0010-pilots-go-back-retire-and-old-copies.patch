+    expect(calls).toEqual([]);
+    expect(createOldCopyStore(() => h.db).kept('tenant')).toEqual([]);
+  });
+
+  it('lists stuck copies on Home when the newest copy has been out 7 days with no groups, no installs or many failures', async () => {
+    const store = createOldCopyStore(() => h.db);
+    apps.get(V4)!.assignments = [];
+    h.installs.delete(V4);
