@@ -0,0 +1,44 @@
+'use client';
+
+// HRM patch 0054: Inventory's label for a copy IntuneGet has replaced. A short tag on the list, and the
+// full sentence (newer copy, when, and what cleanup will do) in the app's details.
+// HRM patch 0058: a copy cleanup is holding is tagged Kept for review, with a warning icon as well as
+// colour. No hover-only text: the details say everything.
+
+import { AlertTriangle, History } from 'lucide-react';
+import { usePreviousCopy } from '@/hooks/usePreviousCopies';
+import { previousCopyText, previousCopyTitle } from '@/lib/hrm/previous-copy-text';
+
+export function PreviousCopyTag({ appId }: { appId: string }) {
+  const copy = usePreviousCopy(appId);
+  if (!copy) return null;
+  const Icon = copy.kept ? AlertTriangle : History;
+  return (
+    <span
+      className={`inline-flex items-center gap-1 rounded border px-1.5 py-0.5 text-xs flex-shrink-0 ${copy.kept ? 'border-amber-500/30 bg-amber-500/10 text-amber-700 dark:text-amber-300' : 'border-overlay/10 bg-overlay/5 text-text-muted'}`}
+    >
+      <Icon className="h-3 w-3" aria-hidden="true" />
+      {previousCopyTitle(copy)}
+    </span>
+  );
+}
+
+export function PreviousCopyNote({ appId }: { appId: string }) {
+  const copy = usePreviousCopy(appId);
+  if (!copy) return null;
+  const [title, ...rest] = previousCopyText(copy);
+  const Icon = copy.kept ? AlertTriangle : History;
+  return (
+    <div
+      role="note"
+      data-testid="previous-copy-note"
+      className={`rounded-lg border p-3 text-sm ${copy.kept ? 'border-amber-500/30 bg-amber-500/5' : 'border-overlay/10 bg-bg-elevated'}`}
+    >
+      <p className="flex items-center gap-2 font-medium text-text-primary">
+        <Icon className={`h-4 w-4 ${copy.kept ? 'text-amber-600 dark:text-amber-400' : 'text-text-muted'}`} aria-hidden="true" />
+        {title}
+      </p>
+      <p className="mt-1 text-text-secondary">{rest.join(' ')}</p>
+    </div>
+  );
+}
