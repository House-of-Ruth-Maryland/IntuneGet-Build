+import {runSqliteMigrations} from '@/lib/db/sqlite-migrations';
+import {createPilotStore} from '../pilot-store';
+let db:Database.Database;let store:ReturnType<typeof createPilotStore>;
+const row={id:'pilot',tenant_id:'tenant',winget_id:'Example.App',display_name:'Example',group_id:'group',group_name:'Test group',previous_app_id:'old',previous_version:'1',created_at:'2026-01-01T00:00:00Z'};
+function job(id='job',config:unknown={}) { db.prepare(`INSERT INTO packaging_jobs(id,user_id,tenant_id,winget_id,version,display_name,installer_type,installer_url,package_config,status) VALUES (?,'staff','tenant','Example.App','2','Example','exe','https://example.invalid/app.exe',?,'queued')`).run(id,JSON.stringify(config)); }
+beforeEach(()=>{db=new Database(':memory:');runSqliteMigrations(db);store=createPilotStore(()=>db);});afterEach(()=>db.close());
+describe('durable pilot reservations',()=>{
+ it('permits only one active pilot per tenant and app',()=>{store.reserve(row);expect(()=>store.reserve({...row,id:'other'})).toThrow();store.reserve({...row,id:'other-tenant',tenant_id:'other'});expect(store.list('tenant')).toHaveLength(1);expect(store.get('other','pilot')).toBeNull();});
+ it('blocks cron, Update all and cart job creation atomically, but attaches the authorized pilot job',()=>{store.reserve(row);expect(()=>job()).toThrow(/pilot/i);job('pilot-job',{pilotRolloutId:'pilot'});expect(store.get('tenant','pilot')).toMatchObject({job_id:'pilot-job',phase:'testing',job_status:'queued'});expect(store.holdsApp('tenant','old')).toBe(true);expect(store.holdsApp('other','old')).toBe(false);});
+ it('refuses a reservation when another deployment is already running',()=>{job();expect(()=>store.reserve(row)).toThrow(/still running/);});
+ it('only releases an unstarted reservation; a restart cannot orphan an inserted job',()=>{store.reserve(row);store.releaseUnstarted('tenant','pilot');expect(store.get('tenant','pilot')).toBeNull();store.reserve(row);job('pilot-job',{pilotRolloutId:'pilot'});store.releaseUnstarted('tenant','pilot');expect(store.get('tenant','pilot')).not.toBeNull();});
+ it('allows one approval at a time and rejects old revisions after a failed approval',()=>{store.reserve(row);job('pilot-job',{pilotRolloutId:'pilot'});expect(store.claim('tenant','pilot',0)).toBe(true);expect(store.claim('tenant','pilot',0)).toBe(false);store.unlock('tenant','pilot',1);expect(store.claim('tenant','pilot',0)).toBe(false);expect(store.claim('tenant','pilot',1)).toBe(true);store.finish('tenant','pilot','staff',2);expect(store.active('tenant','Example.App')).toBeNull();expect(()=>job('ordinary')).not.toThrow();});
+ it('rejects a late job after a stalled reservation was ended',()=>{store.reserve(row);store.releaseUnstarted('tenant','pilot');expect(()=>job('late',{pilotRolloutId:'pilot'})).toThrow(/no longer active/);});
+ it('lets an expired approval lease recover after restart',()=>{store.reserve(row);job('pilot-job',{pilotRolloutId:'pilot'});store.claim('tenant','pilot',0);db.prepare("UPDATE hrm_pilot_rollouts SET lease_until='2000-01-01T00:00:00Z'").run();expect(store.claim('tenant','pilot',1)).toBe(true);});
