+import {describe,expect,it,vi} from 'vitest';
+import {pilotGraph,previewPilot,promotionToken} from '../pilot-graph';
+import type {PilotView} from '../pilot-types';
+const OLD='11111111-1111-4111-8111-111111111111',NEW='22222222-2222-4222-8222-222222222222';
+const row:PilotView={id:'pilot',tenant_id:'tenant',winget_id:'Example.App',display_name:'Example',group_id:'group',group_name:'Pilot',previous_app_id:OLD,previous_version:'1',job_id:'job',phase:'testing',revision:0,lease_until:null,created_at:'2026-01-01',approved_by:null,job_status:'deployed',new_app_id:NEW,new_version:'2'};
+const assignment={id:'graph-id',intent:'required',target:{'@odata.type':'#microsoft.graph.allDevicesAssignmentTarget',deviceAndAppManagementAssignmentFilterId:'filter',deviceAndAppManagementAssignmentFilterType:'include'},settings:{'@odata.type':'#microsoft.graph.win32LobAppAssignmentSettings',notifications:'hideAll',installTimeSettings:{useLocalTime:true,deadlineDateTime:'2026-12-01'}}};
+function fixture(){
+ const writes:Array<{url:string;body:unknown}>=[];
+ const fetchImpl=vi.fn(async(url:string|URL|Request,init?:RequestInit)=>{
+  const path=String(url);if(init?.method==='POST'&&path.endsWith('/assign')){writes.push({url:path,body:JSON.parse(String(init.body))});return new Response(null,{status:204});}
+  if(path.includes('retrieveDeviceAppInstallationStatusReport'))return Response.json({Schema:[{Column:'AppInstallState'}],Values:[['Installed']],TotalRowCount:1});
+  if(path.endsWith('/relationships'))return Response.json({value:[{targetId:OLD,targetType:'child',supersedenceType:'update'}]});
+  if(path.endsWith('/assignments'))return Response.json({value:path.includes(OLD)?[assignment]:[]});
+  if(path.includes('/groups/'))return Response.json({id:OLD,displayName:'Pilot security group',securityEnabled:true});
+  // HRM patch 0031: Intune rejects $select of displayVersion on mobileApp with 400, as production did.
+  if(path.includes('/mobileApps/')&&path.includes('displayVersion'))return new Response(null,{status:400});
+  return Response.json({id:path.includes(OLD)?OLD:NEW,'@odata.type':'#microsoft.graph.win32LobApp',displayName:'Example',publisher:'Example',displayVersion:path.includes(OLD)?'1':'2'});
+ });
+ return {graph:pilotGraph('token',fetchImpl),fetchImpl,writes};
+}
+describe('pilot Graph safety',()=>{
+ it('compares whole-app reports and shows the exact wider groups without writing',async()=>{const f=fixture();const preview=await previewPilot(row,f.graph);expect(preview.pilotResults.installed).toBe(1);expect(preview.previousResults.installed).toBe(1);expect(preview.proposedGroups[0]).toContain('deadline date time');expect(f.writes).toEqual([]);});
+ it('preserves filters, intent, deadlines and notification settings while dropping generated IDs',async()=>{const f=fixture();await f.graph.assign(NEW,[assignment]);expect(f.writes[0]).toMatchObject({url:expect.stringContaining(NEW),body:{mobileAppAssignments:[{intent:assignment.intent,target:assignment.target,settings:assignment.settings}]}});expect(JSON.stringify(f.writes[0].body)).not.toContain('graph-id');expect(f.writes.some(w=>w.url.includes(OLD))).toBe(false);});
+ it('changes the review token for either app’s changed groups or settings',()=>{const token=promotionToken(row,[assignment],[]);expect(promotionToken(row,[{...assignment,id:'regenerated'}],[])).toBe(token);expect(promotionToken(row,[{...assignment,intent:'available'}],[])).not.toBe(token);expect(promotionToken(row,[assignment],[assignment])).not.toBe(token);expect(promotionToken({...row,revision:1},[assignment],[])).not.toBe(token);});
+ it('refuses to promote a failed, unfinished, mismatched or missing app',async()=>{const f=fixture();await expect(f.graph.pair({...row,job_status:'packaging'})).rejects.toThrow(/finish/);await expect(f.graph.pair({...row,new_version:'3'})).rejects.toThrow(/version changed/);});
+ it('requires an Update replacement relationship to the previous copy',async()=>{const f=fixture();const fetchImpl=vi.fn(async(url:string|URL|Request,init?:RequestInit)=>String(url).endsWith('/relationships')?Response.json({value:[]}):f.fetchImpl(url,init));await expect(pilotGraph('token',fetchImpl).pair(row)).rejects.toThrow(/supersede/);});
+ it('rejects incomplete or untrusted assignment pages',async()=>{const fetchImpl=vi.fn().mockResolvedValue(Response.json({value:[], '@odata.nextLink':'https://evil.example.test/next'}));await expect(pilotGraph('token',fetchImpl).assignments(OLD)).rejects.toThrow(/continuation/);expect(fetchImpl).toHaveBeenCalledTimes(1);});
+ it('does not interpret a permissions failure as an empty app or group list',async()=>{const fetchImpl=vi.fn().mockResolvedValue(new Response(null,{status:403}));await expect(pilotGraph('token',fetchImpl).assignments(OLD)).rejects.toThrow(/completely/);});
+ it('requires a security group',async()=>{const fetchImpl=vi.fn().mockResolvedValue(Response.json({id:OLD,displayName:'Not a security group',securityEnabled:false}));await expect(pilotGraph('token',fetchImpl).group(OLD)).rejects.toThrow(/security group/);});
