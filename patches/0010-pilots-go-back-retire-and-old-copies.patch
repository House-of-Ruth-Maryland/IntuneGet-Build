+// HRM patch 0054: previous copies for Inventory. Read-only; this tenant only.
+import { beforeEach, describe, expect, it, vi } from 'vitest';
+import { NextRequest } from 'next/server';
+
+const state = vi.hoisted(() => ({ auth: true, sqlite: true, startup: false, kept: [] as Array<{ app_id: string; reason: string | null }>, history: [] as unknown[] }));
+vi.mock('@/lib/auth-utils', () => ({ parseAccessToken: async () => (state.auth ? { tenantId: 'tenant-one', userId: 'staff' } : null) }));
+vi.mock('@/lib/db', () => ({ isSqliteMode: () => state.sqlite, getDatabase: () => ({ uploadHistory: { listAll: async () => state.history } }) }));
+vi.mock('@/lib/db/sqlite', () => ({ sqliteOldCopies: { kept: () => state.kept, startupFamily: () => state.startup } }));
+vi.mock('@/lib/intune/graph-client', () => ({ getServicePrincipalToken: async () => null }));
+import { GET } from './route';
+
+const A = '00000000-0000-0000-0000-00000000000a';
+const B = '00000000-0000-0000-0000-00000000000b';
+const row = (id: string, appId: string, version: string, deployedAt: string) => ({
+  id, user_id: 'staff', winget_id: 'Example.Reader', version, display_name: 'Example Reader', intune_app_id: appId, intune_tenant_id: 'tenant-one', deployed_at: deployedAt,
+});
+const get = async () => {
+  const response = await GET(new NextRequest('http://localhost/api/hrm/previous-copies', { headers: { Authorization: 'Bearer fixture' } }));
+  return { status: response.status, body: await response.json() };
+};
+
+beforeEach(() => {
+  Object.assign(state, { auth: true, sqlite: true, startup: false, kept: [] });
+  state.history = [row('2', B, '2.0', '2026-11-01T10:00:00Z'), row('1', A, '1.0', '2026-10-01T10:00:00Z')];
+  delete process.env.HRM_OLD_COPY_CLEANUP;
+});
+
+describe('GET /api/hrm/previous-copies', () => {
+  it('needs sign-in', async () => {
+    state.auth = false;
+    expect((await get()).status).toBe(401);
+  });
+
+  it('lists replaced copies with cleanup timing and kept reasons', async () => {
+    expect((await get()).body.copies).toEqual([expect.objectContaining({ appId: A, replacedByVersion: '2.0', removeAfter: '2026-11-08T10:00:00.000Z', kept: null })]);
+    state.kept = [{ app_id: A.toUpperCase(), reason: 'Kept for review.' }];
+    expect((await get()).body.copies[0].kept).toBe('Kept for review.');
+  });
+
+  it('promises no automatic removal when cleanup is off, outside SQLite, or for startup apps', async () => {
+    process.env.HRM_OLD_COPY_CLEANUP = 'off';
+    expect((await get()).body.copies[0].removeAfter).toBeNull();
+    delete process.env.HRM_OLD_COPY_CLEANUP;
+    state.sqlite = false;
+    expect((await get()).body.copies[0].removeAfter).toBeNull();
+    state.sqlite = true; state.startup = true;
+    expect((await get()).body.copies[0].removeAfter).toBeNull();
+  });
+});
