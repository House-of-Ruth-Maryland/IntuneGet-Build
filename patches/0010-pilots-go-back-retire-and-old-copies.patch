diff --git a/lib/hrm/retire-store.ts b/lib/hrm/retire-store.ts
new file mode 100644
index 000000000..eb5547df6
--- /dev/null
+++ b/lib/hrm/retire-store.ts
@@ -0,0 +1,68 @@
+/**
+ * HRM patch 0038: retire an app. One row per retirement: the groups the app had (to put back on
+ * Cancel), the Uninstall groups that replaced them, and where it is (starting, uninstalling,
+ * cancelled, deleted). While a retirement is starting or uninstalling, no deployment of the app can
+ * be created (database trigger, migration 17), the same way an active pilot holds it.
+ */
+import type Database from 'better-sqlite3';
+import type { GraphAssignment } from './duplicates';
+
+export type RetirePhase = 'starting' | 'uninstalling' | 'cancelled' | 'deleted';
+/** HRM patch 0040: 'removal' is a copy added only to uninstall an app found on devices. */
+export type RetirePurpose = 'retire' | 'removal';
+export interface Retirement {
+  id: string; tenant_id: string; app_id: string; winget_id: string | null; display_name: string; version: string;
+  saved_assignments: GraphAssignment[]; uninstall_assignments: GraphAssignment[]; phase: RetirePhase; purpose?: RetirePurpose;
+  started_by: string; started_at: string; finished_by: string | null; finished_at: string | null;
+}
+type Row = Omit<Retirement, 'saved_assignments' | 'uninstall_assignments'> & { saved_assignments: string; uninstall_assignments: string };
+const parse = (row: Row | undefined): Retirement | null => row
+  ? { ...row, saved_assignments: JSON.parse(row.saved_assignments), uninstall_assignments: JSON.parse(row.uninstall_assignments) }
+  : null;
+
+export function createRetireStore(getDb: () => Database.Database) {
+  return {
+    /** The open retirement of this copy, if any. */
+    active(tenant: string, appId: string): Retirement | null {
+      return parse(getDb().prepare("SELECT * FROM hrm_retirements WHERE tenant_id = ? AND app_id = ? AND phase IN ('starting','uninstalling')").get(tenant, appId) as Row | undefined);
+    },
+    /** The newest retirement of this copy (open, cancelled or deleted). */
+    latest(tenant: string, appId: string): Retirement | null {
+      return parse(getDb().prepare('SELECT * FROM hrm_retirements WHERE tenant_id = ? AND app_id = ? ORDER BY started_at DESC LIMIT 1').get(tenant, appId) as Row | undefined);
+    },
+    holdsApp(tenant: string, appId: string): boolean {
+      return Boolean(getDb().prepare("SELECT 1 FROM hrm_retirements WHERE tenant_id = ? AND app_id = ? AND phase IN ('starting','uninstalling')").get(tenant, appId));
+    },
+    holdsFamily(tenant: string, wingetId: string): boolean {
+      return Boolean(getDb().prepare("SELECT 1 FROM hrm_retirements WHERE tenant_id = ? AND winget_id = ? COLLATE NOCASE AND phase IN ('starting','uninstalling')").get(tenant, wingetId));
+    },
+    activeAppIds(tenant: string): string[] {
+      return (getDb().prepare("SELECT app_id FROM hrm_retirements WHERE tenant_id = ? AND phase IN ('starting','uninstalling')").all(tenant) as Array<{ app_id: string }>).map((r) => r.app_id.toLowerCase());
+    },
+    /** Reserve before Intune is changed. Refused while the app is being deployed or already retiring. */
+    reserve(row: Omit<Retirement, 'phase' | 'finished_by' | 'finished_at'>) {
+      const purpose: RetirePurpose = row.purpose === 'removal' ? 'removal' : 'retire';
+      const db = getDb();
+      db.transaction(() => {
+        if (row.winget_id && db.prepare("SELECT 1 FROM packaging_jobs WHERE tenant_id = ? AND winget_id = ? COLLATE NOCASE AND archived_at IS NULL AND status NOT IN ('deployed','failed','cancelled','duplicate_skipped') LIMIT 1").get(row.tenant_id, row.winget_id)) {
+          throw new Error('A deployment for this app is still running.');
+        }
+        db.prepare(`INSERT INTO hrm_retirements (id, tenant_id, app_id, winget_id, display_name, version, saved_assignments, uninstall_assignments, phase, purpose, started_by, started_at)
+          VALUES (?,?,?,?,?,?,?,?,'starting',?,?,?)`).run(row.id, row.tenant_id, row.app_id, row.winget_id, row.display_name, row.version,
+          JSON.stringify(row.saved_assignments), JSON.stringify(row.uninstall_assignments), purpose, row.started_by, row.started_at);
+      }).immediate();
+    },
+    /** Intune didn't accept the Uninstall groups: forget the reservation. */
+    release(tenant: string, id: string) { getDb().prepare("DELETE FROM hrm_retirements WHERE tenant_id = ? AND id = ? AND phase = 'starting'").run(tenant, id); },
+    started(tenant: string, id: string) { return getDb().prepare("UPDATE hrm_retirements SET phase = 'uninstalling' WHERE tenant_id = ? AND id = ? AND phase = 'starting'").run(tenant, id).changes === 1; },
+    finish(tenant: string, id: string, phase: 'cancelled' | 'deleted', actor: string) {
+      return getDb().prepare("UPDATE hrm_retirements SET phase = ?, finished_by = ?, finished_at = ? WHERE tenant_id = ? AND id = ? AND phase = 'uninstalling'")
+        .run(phase, actor, new Date().toISOString(), tenant, id).changes === 1;
+    },
+    /** After deletion the app stays out of App updates: every update policy for it is set to Ignore. */
+    ignoreUpdates(tenant: string, wingetId: string) {
+      return getDb().prepare("UPDATE app_update_policies SET policy_type = 'ignore', updated_at = ? WHERE tenant_id = ? AND winget_id = ? COLLATE NOCASE")
+        .run(new Date().toISOString(), tenant, wingetId).changes;
+    },
+  };
+}
diff --git a/lib/hrm/retire.ts b/lib/hrm/retire.ts
new file mode 100644
index 000000000..86be6a06c
--- /dev/null
+++ b/lib/hrm/retire.ts
@@ -0,0 +1,47 @@
+/**
+ * HRM patch 0038: retire an app. Browser-safe helpers (no database or Graph).
+ *
+ * Retiring changes every group of the copy to Uninstall (exclusions stay exclusions), so Intune
+ * removes the app from those devices and users. Install deadlines and restart settings are dropped;
+ * notifications are kept. When devices report it gone, Delete from Intune removes the app.
+ */
+import { createHash } from 'node:crypto';
+import type { GraphAssignment } from './duplicates';
+import { summarizeAssignments } from './app-insights';
+
+export { RETIRE_HOLD } from './retire-hold';
+
+const WIN32_SETTINGS = '#microsoft.graph.win32LobAppAssignmentSettings';
+
+/** The same targets, each with intent Uninstall. Two rows for one target (Required and Available) become one. */
+export function toUninstallAssignments(rows: GraphAssignment[]): GraphAssignment[] {
+  const seen = new Map<string, GraphAssignment>();
+  for (const row of rows) {
+    const target = row.target as Record<string, unknown>;
+    const settings = row.settings as Record<string, unknown> | null | undefined;
+    const notifications = settings && settings['@odata.type'] === WIN32_SETTINGS && typeof settings.notifications === 'string' ? settings.notifications : 'showAll';
+    const key = JSON.stringify([target['@odata.type'], typeof target.groupId === 'string' ? target.groupId.toLowerCase() : null,
+      target.deviceAndAppManagementAssignmentFilterId ?? null, target.deviceAndAppManagementAssignmentFilterType ?? null]);
+    if (seen.has(key)) continue;
+    seen.set(key, { intent: 'uninstall', target: row.target, settings: { '@odata.type': WIN32_SETTINGS, notifications } } as GraphAssignment);
+  }
+  return [...seen.values()];
+}
+
+/** Ties a start to what was reviewed: the copy, its version and its exact live groups. */
+export function retireToken(appId: string, version: string, rows: GraphAssignment[]): string {
+  return createHash('sha256').update(JSON.stringify(['retire', appId.toLowerCase(), version, summarizeAssignments(rows).map((a) => a.key)])).digest('hex');
+}
+
+export const sameGroups = (a: GraphAssignment[], b: GraphAssignment[]) =>
+  JSON.stringify(summarizeAssignments(a).map((r) => r.key)) === JSON.stringify(summarizeAssignments(b).map((r) => r.key));
+
+export interface RetirePreview { token: string; appId: string; displayName: string; version: string; groups: string[]; after: string[]; checkedAt: string }
+export interface RetireStatus {
+  supported: boolean;
+  retirement: null | { id: string; phase: string; displayName: string; version: string; startedBy: string; startedAt: string; finishedAt: string | null; savedGroups: string[];
+    /** HRM patch 0040: 'removal' when the copy was added only to uninstall an app found on devices. */
+    purpose: 'retire' | 'removal' };
+  counts?: { installed: number; failed: number; pending: number; notApplicable: number; other: number } | null;
+  hold?: string | null;
+}
diff --git a/lib/hrm/rollback-guard.ts b/lib/hrm/rollback-guard.ts
new file mode 100644
index 000000000..fc9e9ace0
--- /dev/null
+++ b/lib/hrm/rollback-guard.ts
@@ -0,0 +1,12 @@
+import { ROLLBACK_SKIP_REASON } from './rollback';
+type Store = typeof import('@/lib/db/sqlite')['sqliteRollbacks'];
+/** HRM patch 0037: automatic updates skip a version staff rolled back from. Null when not skipped. */
+export async function skippedVersionHold(tenant: string, winget: string, version: string): Promise<string | null> {
+  if (process.env.DATABASE_MODE?.toLowerCase() !== 'sqlite') return null;
+  const mod = await import('@/lib/db/sqlite');
+  // Upstream tests mock '@/lib/db/sqlite' without this store (and vitest throws on a missing export).
+  let store: Store | undefined;
+  try { store = mod.sqliteRollbacks; } catch { return null; }
+  const row = store?.skipped(tenant, winget, version);
+  return row ? ROLLBACK_SKIP_REASON(row.version, row.rolled_back_to) : null;
+}
diff --git a/lib/hrm/rollback-readiness-store.ts b/lib/hrm/rollback-readiness-store.ts
new file mode 100644
index 000000000..1ccb4c0b5
--- /dev/null
+++ b/lib/hrm/rollback-readiness-store.ts
@@ -0,0 +1,43 @@
+/** HRM patch 0039: the last check of each copy's previous installer (one row per Intune app copy). */
+import type Database from 'better-sqlite3';
+
+export type ReadinessStatus = 'ready' | 'missing' | 'unreachable' | 'unsupported';
+export type ChecksumStatus = 'checking' | 'match' | 'mismatch' | 'missing' | 'unreachable';
+export interface Readiness {
+  tenant_id: string; app_id: string; previous_job_id: string; previous_version: string;
+  status: ReadinessStatus; detail: string | null; checked_at: string;
+  checksum_status: ChecksumStatus | null; checksum_checked_at: string | null;
+}
+
+export function createRollbackReadinessStore(getDb: () => Database.Database) {
+  return {
+    get(tenant: string, appId: string): Readiness | null {
+      return (getDb().prepare('SELECT * FROM hrm_rollback_readiness WHERE tenant_id = ? AND app_id = ?').get(tenant, appId) as Readiness) ?? null;
+    },
+    /** A new previous installer clears the old checksum result. */
+    record(row: Omit<Readiness, 'checksum_status' | 'checksum_checked_at'>) {
+      getDb().prepare(`INSERT INTO hrm_rollback_readiness (tenant_id, app_id, previous_job_id, previous_version, status, detail, checked_at) VALUES (?,?,?,?,?,?,?)
+        ON CONFLICT (tenant_id, app_id) DO UPDATE SET status = excluded.status, detail = excluded.detail, checked_at = excluded.checked_at,
+          checksum_status = CASE WHEN previous_job_id = excluded.previous_job_id THEN checksum_status END,
+          checksum_checked_at = CASE WHEN previous_job_id = excluded.previous_job_id THEN checksum_checked_at END,
+          previous_job_id = excluded.previous_job_id, previous_version = excluded.previous_version`)
+        .run(row.tenant_id, row.app_id, row.previous_job_id, row.previous_version, row.status, row.detail, row.checked_at);
+    },
+    checksum(tenant: string, appId: string, previousJobId: string, status: ChecksumStatus, detail: string | null) {
+      const now = new Date().toISOString();
+      return getDb().prepare(`UPDATE hrm_rollback_readiness SET checksum_status = ?, checksum_checked_at = ?,
+          status = CASE WHEN ? = 'missing' THEN 'missing' WHEN ? IN ('match','mismatch') THEN 'ready' ELSE status END,
+          -- Keep the link check's reason on a row whose link didn't answer.
+          detail = CASE WHEN ? = 'checking' OR (? = 'unreachable' AND status != 'ready') THEN detail ELSE ? END,
+          -- A check that couldn't finish says nothing new about the link, so it isn't a fresh check.
+          checked_at = CASE WHEN ? IN ('checking','unreachable') THEN checked_at ELSE ? END
+        WHERE tenant_id = ? AND app_id = ? AND previous_job_id = ?`)
+        .run(status, now, status, status, status, status, detail, status, now, tenant, appId, previousJobId).changes === 1;
+    },
+    remove(tenant: string, appId: string) { getDb().prepare('DELETE FROM hrm_rollback_readiness WHERE tenant_id = ? AND app_id = ?').run(tenant, appId); },
+    /** Copies whose previous installer is gone or has changed (for Home). */
+    gaps(tenant: string): Readiness[] {
+      return getDb().prepare("SELECT * FROM hrm_rollback_readiness WHERE tenant_id = ? AND (status IN ('missing','unsupported') OR checksum_status = 'mismatch') ORDER BY checked_at DESC LIMIT 50").all(tenant) as Readiness[];
+    },
+  };
+}
diff --git a/lib/hrm/rollback-readiness.ts b/lib/hrm/rollback-readiness.ts
new file mode 100644
index 000000000..304c5ee25
--- /dev/null
+++ b/lib/hrm/rollback-readiness.ts
@@ -0,0 +1,35 @@
+/**
+ * HRM patch 0039: at each update check (3:30 AM and 3:30 PM), confirm that every app's previous
+ * installer still downloads, so Go back to previous version (patch 0037) works when it's needed.
+ * A light check only (no download); Check installer now compares the checksum on request.
+ */
+import { checkInstallerReachable, type CheckOptions } from './installer-check';
+import { isSelfUpdatingApp } from '@/lib/self-updating-apps';
+
+const CONCURRENCY = 4;
+const RUN_BUDGET_MS = 60000;
+
+export async function runSqliteRollbackReadinessCheck(options: CheckOptions = {}): Promise<{ checked: number; missing: number; unreachable: number }> {
+  const { sqliteAppInsights, sqliteRollbacks, sqliteRollbackReadiness, sqliteRetirements } = await import('@/lib/db/sqlite');
+  // Copies retired and deleted from Intune (patch 0038) can't go back.
+  const deployments = sqliteAppInsights.tracked().filter((d) => sqliteRetirements.latest(d.tenantId, d.appId)?.phase !== 'deleted').sort((a, b) => (sqliteRollbackReadiness.get(a.tenantId, a.appId)?.checked_at ?? '').localeCompare(sqliteRollbackReadiness.get(b.tenantId, b.appId)?.checked_at ?? ''));
+  const result = { checked: 0, missing: 0, unreachable: 0 };
+  let next = 0;
+  const deadline = Date.now() + RUN_BUDGET_MS;
+  const worker = async () => {
+    while (next < deployments.length && Date.now() < deadline) {
+      const d = deployments[next++];
+      const previous = sqliteRollbacks.previousJob(d.tenantId, d.wingetId, d.version, d.appId);
+      // Self-updating apps never go back from IntuneGet (patch 0037), so there is nothing to check.
+      if (!previous?.installer_url || isSelfUpdatingApp(d.wingetId)) { sqliteRollbackReadiness.remove(d.tenantId, d.appId); continue; }
+      const reach = await checkInstallerReachable(previous.installer_url, { timeoutMs: 5000, ...options });
+      sqliteRollbackReadiness.record({ tenant_id: d.tenantId, app_id: d.appId, previous_job_id: previous.id, previous_version: previous.version,
+        status: reach.status, detail: reach.detail, checked_at: new Date().toISOString() });
+      result.checked++;
+      if (reach.status === 'missing' || reach.status === 'unsupported') result.missing++;
+      if (reach.status === 'unreachable') result.unreachable++;
+    }
+  };
+  await Promise.all(Array.from({ length: CONCURRENCY }, worker));
+  return result;
+}
diff --git a/lib/hrm/rollback-store.ts b/lib/hrm/rollback-store.ts
new file mode 100644
index 000000000..f3c264318
--- /dev/null
+++ b/lib/hrm/rollback-store.ts
@@ -0,0 +1,58 @@
+/**
+ * HRM patch 0037: go back to the previous version of an app.
+ *
+ * The store finds the deployment to go back to (the newest successful IntuneGet deployment of the same
+ * app with a different version and a saved installer), and remembers the version that was rolled back
+ * so automatic updates don't deploy it again. Manual Update can still deploy it.
+ */
+import type Database from 'better-sqlite3';
+import type { PackagingJob } from '@/lib/db/types';
+import { compareVersions } from '@/lib/version-compare';
+
+const parse = (row: Record<string, unknown> | undefined): PackagingJob | null => {
+  if (!row) return null;
+  const json = (value: unknown) => (typeof value === 'string' ? JSON.parse(value) : value ?? null);
+  return { ...row, package_config: json(row.package_config), detection_rules: json(row.detection_rules) } as unknown as PackagingJob;
+};
+
+export interface SkippedVersion { tenant_id: string; winget_id: string; version: string; rolled_back_to: string; job_id: string | null; created_by: string; created_at: string }
+
+export function createRollbackStore(getDb: () => Database.Database) {
+  return {
+    /** The job that deployed this Intune app copy. */
+    currentJob(tenant: string, appId: string): PackagingJob | null {
+      return parse(getDb().prepare(`SELECT * FROM packaging_jobs WHERE tenant_id = ? AND intune_app_id = ? COLLATE NOCASE AND status = 'deployed'
+        ORDER BY COALESCE(completed_at, updated_at, created_at) DESC LIMIT 1`).get(tenant, appId) as Record<string, unknown> | undefined);
+    },
+    /**
+     * The newest earlier deployment of this app: another copy with an older version and its installer saved.
+     * Only older versions: after going back from 2.0 to 1.0, 2.0 is not offered as the "previous" version.
+     */
+    previousJob(tenant: string, wingetId: string, currentVersion: string, currentAppId: string): PackagingJob | null {
+      const rows = getDb().prepare(`SELECT * FROM packaging_jobs WHERE tenant_id = ? AND winget_id = ? COLLATE NOCASE AND status = 'deployed'
+        AND intune_app_id IS NOT NULL AND intune_app_id != ? COLLATE NOCASE AND version != ? AND COALESCE(installer_url, '') != ''
+        ORDER BY COALESCE(completed_at, updated_at, created_at) DESC LIMIT 50`).all(tenant, wingetId, currentAppId, currentVersion) as Record<string, unknown>[];
+      return parse(rows.find((row) => compareVersions(String(row.version), currentVersion) < 0));
+    },
+    /** Any deployment of this app that hasn't finished. */
+    running(tenant: string, wingetId: string): boolean {
+      return Boolean(getDb().prepare(`SELECT 1 FROM packaging_jobs WHERE tenant_id = ? AND winget_id = ? COLLATE NOCASE AND archived_at IS NULL
+        AND status NOT IN ('deployed','failed','cancelled','duplicate_skipped') LIMIT 1`).get(tenant, wingetId));
+    },
+    skip(row: SkippedVersion) {
+      getDb().prepare(`INSERT INTO hrm_skipped_versions (tenant_id, winget_id, version, rolled_back_to, job_id, created_by, created_at) VALUES (?,?,?,?,?,?,?)
+        ON CONFLICT (tenant_id, winget_id, version) DO UPDATE SET rolled_back_to = excluded.rolled_back_to, job_id = excluded.job_id,
+        created_by = excluded.created_by, created_at = excluded.created_at`)
+        .run(row.tenant_id, row.winget_id, row.version, row.rolled_back_to, row.job_id, row.created_by, row.created_at);
+    },
+    skipped(tenant: string, wingetId: string, version: string): SkippedVersion | null {
+      return (getDb().prepare('SELECT * FROM hrm_skipped_versions WHERE tenant_id = ? AND winget_id = ? AND version = ?').get(tenant, wingetId, version) as SkippedVersion) ?? null;
+    },
+    listSkipped(tenant: string, wingetId: string): SkippedVersion[] {
+      return getDb().prepare('SELECT * FROM hrm_skipped_versions WHERE tenant_id = ? AND winget_id = ? ORDER BY created_at DESC LIMIT 20').all(tenant, wingetId) as SkippedVersion[];
+    },
+    unskip(tenant: string, wingetId: string, version: string): boolean {
+      return getDb().prepare('DELETE FROM hrm_skipped_versions WHERE tenant_id = ? AND winget_id = ? AND version = ?').run(tenant, wingetId, version).changes === 1;
+    },
+  };
+}
diff --git a/lib/hrm/rollback.ts b/lib/hrm/rollback.ts
new file mode 100644
index 000000000..84423e037
--- /dev/null
+++ b/lib/hrm/rollback.ts
@@ -0,0 +1,80 @@
+/**
+ * HRM patch 0037: go back to the previous version.
+ *
+ * A rollback is a new deployment of the previous version, built from the job that deployed it (same
+ * installer, checksum, commands and detection). It replaces the current copy with Intune's Replace
+ * supersedence, which uninstalls the current version and then installs the previous one, and moves
+ * the current copy's live groups onto it, as an update does. Browser-safe: no database or Graph here.
+ */
+import { createHash } from 'node:crypto';
+import type { PackagingJob } from '@/lib/db/types';
+import type { Json } from '@/types/database';
+
+export const ROLLBACK_SKIP_REASON = (version: string, to: string) =>
+  `Automatic updates skip v${version} because staff went back to v${to}. A newer version still updates automatically; Update deploys v${version} on purpose.`;
+
+export interface RollbackPreview {
+  token: string;
+  appId: string;
+  displayName: string;
+  currentVersion: string;
+  previousVersion: string;
+  previousJobId: string;
+  groups: string[];
+  checkedAt: string;
+}
+
+/** Ties an approval to what was reviewed: the copy, both versions and the exact live groups. */
+export function rollbackToken(appId: string, currentVersion: string, previousJobId: string, groupKeys: string[]): string {
+  return createHash('sha256').update(JSON.stringify(['rollback', appId.toLowerCase(), currentVersion, previousJobId, [...groupKeys].sort()])).digest('hex');
+}
+
+type Config = Record<string, unknown>;
+const dependencies = (list: unknown) => Array.isArray(list)
+  ? (list as Array<{ relationshipType?: string }>).filter((r) => r.relationshipType === 'dependency') : undefined;
+
+/** The new job: the previous version's installer and settings, replacing the current copy. */
+export function buildRollbackJob(previous: PackagingJob, current: PackagingJob | null, currentAppId: string,
+  user: { userId: string; tenantId: string; userEmail?: string | null }, currentVersion: string): Partial<PackagingJob> {
+  const prev = (previous.package_config ?? {}) as Config;
+  const now = (current?.package_config ?? {}) as Config;
+  const {
+    pilotRolloutId: _pilot, autoUpdateHistoryId: _history, replacesIntuneAppId: _replaces, hrmRollback: _rollback,
+    ...rest
+  } = prev;
+  void _pilot; void _history; void _replaces; void _rollback;
+  return {
+    user_id: user.userId,
+    user_email: user.userEmail ?? null,
+    tenant_id: user.tenantId,
+    winget_id: previous.winget_id,
+    version: previous.version,
+    display_name: current?.display_name || previous.display_name,
+    publisher: previous.publisher,
+    architecture: previous.architecture,
+    installer_type: previous.installer_type,
+    installer_url: previous.installer_url,
+    installer_sha256: previous.installer_sha256,
+    install_command: previous.install_command,
+    uninstall_command: previous.uninstall_command,
+    install_scope: previous.install_scope,
+    detection_rules: previous.detection_rules,
+    package_config: {
+      ...rest,
+      // The workflow copies the current copy's live groups, so none are sent.
+      assignments: [],
+      categories: now.categories ?? prev.categories ?? [],
+      espProfiles: now.espProfiles ?? undefined,
+      relationships: dependencies(now.relationships) ?? dependencies(prev.relationships),
+      forceCreate: true,
+      sourceIntuneAppId: currentAppId,
+      autoSupersede: true,
+      supersedenceType: 'replace',
+      hrmRollback: { fromVersion: currentVersion, fromAppId: currentAppId, previousJobId: previous.id },
+    } as unknown as Json,
+    status: 'queued',
+    status_message: `Going back to v${previous.version} from v${currentVersion}`,
+    progress_percent: 0,
+    is_auto_update: false,
+  };
+}
