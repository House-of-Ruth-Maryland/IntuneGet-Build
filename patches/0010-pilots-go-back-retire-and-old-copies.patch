+    apps.set(appId as string, { displayName: 'PDF tool', displayVersion: version as string, assignments: [group(G1)] });
+    deployed(appId as string, version as string, daysAgo(days as number));
+  });
+  links.set(V2, [V1]); links.set(V3, [V2]); links.set(V4, [V3]);
+  h.installs.set(V4, { installed: 40, failed: 1 });
+});
