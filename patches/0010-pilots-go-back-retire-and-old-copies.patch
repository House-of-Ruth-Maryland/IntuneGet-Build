+vi.mock('@/hooks/usePilots',()=>({usePilots:()=>({data:state.data,action:{mutate:state.mutate,reset:state.reset,isPending:false},refetch:vi.fn()})}));
+import {PilotRollouts} from './PilotRollouts';
+let root:Root;
+(globalThis as typeof globalThis&{IS_REACT_ACT_ENVIRONMENT:boolean}).IS_REACT_ACT_ENVIRONMENT=true;
