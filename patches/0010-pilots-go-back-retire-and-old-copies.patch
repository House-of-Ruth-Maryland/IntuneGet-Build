+    h.db.prepare(`INSERT INTO packaging_jobs (id,user_id,tenant_id,winget_id,version,display_name,installer_type,installer_url,package_config,status) VALUES ('j1','staff','tenant','example.pdftool','0.20.0','PDF tool','exe','https://example.invalid/a.exe','{}','packaging')`).run();
