+    expect(store.kept('tenant').map((k) => k.app_id).sort()).toEqual([V1, V2, V3].sort());
+    expect(store.get('tenant', V3)).toMatchObject({ newest_app_id: V4, reason: expect.stringMatching(/^v0\.19\.0 has no groups/) });
