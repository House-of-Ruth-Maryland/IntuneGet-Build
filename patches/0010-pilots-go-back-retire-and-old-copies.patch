+  });
+
+  it('waits 7 days after each old copy was replaced', async () => {
+    h.db.prepare('UPDATE upload_history SET deployed_at = ? WHERE intune_app_id = ?').run(new Date(NOW.getTime() - SETTLE_MS + 60000).toISOString(), V4);
+    // V3 was replaced by V4 less than 7 days ago; V1 and V2 were replaced (by V2 and V3) more than 7 days ago.
+    expect(await runSqliteOldCopyCleanup({ now: NOW })).toMatchObject({ checked: 1, removed: 2 });
+    expect([...apps.keys()].sort()).toEqual([V3, V4].sort());
+    expect(links.get(V4)).toEqual([V3]);
+    expect(apps.get(V4)!.assignments).toEqual([group(G1)]);
+  });
+
+  it('cleans apps released more often than weekly, copy by copy, and waits on copies replaced within 7 days', async () => {
+    // Weekly-or-faster releases: the newest copy is always young, but older copies were replaced long ago.
+    [[V1, 30], [V2, 12], [V3, 5], [V4, 2]].forEach(([appId, d]) => h.db.prepare('UPDATE upload_history SET deployed_at = ? WHERE intune_app_id = ?').run(daysAgo(d as number), appId));
+    expect(await runSqliteOldCopyCleanup({ now: NOW })).toMatchObject({ removed: 1, kept: 0 });
+    expect([...apps.keys()].sort()).toEqual([V2, V3, V4].sort());
+    expect(createOldCopyStore(() => h.db).kept('tenant')).toEqual([]);
+  });
+
+  it('dates each copy\'s replacement from the copy after it', () => {
+    const older = [{ deployedAt: daysAgo(20) }, { deployedAt: daysAgo(9) }];
+    expect(supersededAt(older, 0, daysAgo(1))).toBe(Date.parse(daysAgo(9)));
+    expect(supersededAt(older, 1, daysAgo(1))).toBe(Date.parse(daysAgo(1)));
+    expect(supersededAt([{ deployedAt: '2026-11-01 08:00:00' }], 0, '2026-11-02 08:00:00')).toBe(Date.parse('2026-11-02T08:00:00Z'));
+  });
+
+  it('never removes while the newest copy has no healthy installs', async () => {
+    for (const counts of [{ installed: 0, failed: 0 }, undefined, { installed: 5, failed: 3 }]) {
+      if (counts) h.installs.set(V4, counts); else h.installs.delete(V4);
+      expect(await runSqliteOldCopyCleanup({ now: NOW })).toMatchObject({ removed: 0 });
+    }
+    expect(apps.size).toBe(4);
+    expect(calls.some((c) => !c.startsWith('GET'))).toBe(false);
+  });
+
+  it('waits quietly while a newest copy younger than 7 days has no installs yet', async () => {
