+  });
+
+  it('does not list a stuck copy the newest one does not supersede', async () => {
+    links.set(V2, []);
+    h.installs.delete(V4);
+    await runSqliteOldCopyCleanup({ now: NOW });
+    expect(createOldCopyStore(() => h.db).kept('tenant').map((k) => k.app_id).sort()).toEqual([V2, V3].sort());
+  });
+
+  it('explains why a cleanup is stuck', () => {
+    expect(stuckReason('2.0', 0, { installed: 5, failed: 0 })).toBe('v2.0 has no groups, so no computer gets it. Open v2.0 in Inventory and press Keep this copy to move the groups.');
+    expect(stuckReason('', 1, null)).toBe('The newest copy has no successful installs after 7 days. Open it in Inventory and check Install results.');
