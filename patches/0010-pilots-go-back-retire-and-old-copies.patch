+// HRM patch 0038: retiring an app from Inventory.
+import {afterEach,beforeEach,describe,expect,it,vi} from 'vitest';
+import {NextRequest} from 'next/server';
+const state=vi.hoisted(()=>{vi.stubEnv('DATABASE_MODE','sqlite');vi.stubEnv('DATABASE_PATH',':memory:');return {auth:true};});
+vi.mock('@/lib/auth-utils',()=>({parseAccessToken:async()=>state.auth?{tenantId:'tenant',userId:'staff',userEmail:'staff@example.test'}:null}));
+vi.mock('@/lib/db',async()=>{const {sqliteDb}=await import('@/lib/db/sqlite');return {isSqliteMode:()=>true,getDatabase:()=>sqliteDb};});
+vi.mock('@/lib/intune/graph-client',()=>({getServicePrincipalToken:async()=>'token'}));
+import {sqliteDb,sqliteRetirements,sqlitePilotRollouts,closeSqliteDb} from '@/lib/db/sqlite';
