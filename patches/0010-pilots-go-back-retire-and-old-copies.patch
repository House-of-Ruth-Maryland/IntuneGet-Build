@@ -0,0 +1,117 @@
+// HRM patch 0037: going back to the previous version.
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import Database from 'better-sqlite3';
+import { runSqliteMigrations } from '@/lib/db/sqlite-migrations';
+import { createRollbackStore } from '../rollback-store';
+import { buildRollbackJob, rollbackToken, ROLLBACK_SKIP_REASON } from '../rollback';
+import { buildUpdateWorkflowInputs } from '../update-dispatch';
+import type { PackagingJob } from '@/lib/db/types';
+
+let db: Database.Database;
+let store: ReturnType<typeof createRollbackStore>;
+const CURRENT = '11111111-1111-4111-8111-111111111111';
+const OLDER = '22222222-2222-4222-8222-222222222222';
+const OLDEST = '33333333-3333-4333-8333-333333333333';
+
+function job(id: string, version: string, appId: string | null, status = 'deployed', at = '2026-01-01T00:00:00Z', extra: Record<string, unknown> = {}) {
+  db.prepare(`INSERT INTO packaging_jobs (id,user_id,tenant_id,winget_id,version,display_name,installer_type,installer_url,installer_sha256,package_config,status,intune_app_id,completed_at)
+    VALUES (?,'staff','tenant','Example.App',?,'Example','exe',?,?,?,?,?,?)`)
+    .run(id, version, extra.installer_url ?? `https://example.invalid/${version}.exe`, 'a'.repeat(64), JSON.stringify(extra.config ?? {}), status, appId, at);
+}
+
+beforeEach(() => { db = new Database(':memory:'); runSqliteMigrations(db); store = createRollbackStore(() => db); });
+afterEach(() => db.close());
+
+describe('finding the version to go back to', () => {
+  it('picks the newest earlier deployment of another copy with a different version and a saved installer', () => {
+    job('oldest', '1.0', OLDEST, 'deployed', '2026-01-01T00:00:00Z');
+    job('older', '1.1', OLDER, 'deployed', '2026-01-02T00:00:00Z');
+    job('failed', '1.2', null, 'failed', '2026-01-03T00:00:00Z');
+    job('no-installer', '1.3', '44444444-4444-4444-8444-444444444444', 'deployed', '2026-01-04T00:00:00Z', { installer_url: '' });
+    job('current', '2.0', CURRENT, 'deployed', '2026-01-05T00:00:00Z');
+    expect(store.previousJob('tenant', 'example.app', '2.0', CURRENT)?.id).toBe('older');
+    expect(store.currentJob('tenant', CURRENT)?.id).toBe('current');
+    expect(store.previousJob('other-tenant', 'Example.App', '2.0', CURRENT)).toBeNull();
+  });
+
+  it('never offers the same version again (a redeploy of 2.0 is not a previous version)', () => {
+    job('redeploy', '2.0', OLDER, 'deployed', '2026-01-02T00:00:00Z');
+    job('current', '2.0', CURRENT, 'deployed', '2026-01-05T00:00:00Z');
+    expect(store.previousJob('tenant', 'Example.App', '2.0', CURRENT)).toBeNull();
+  });
+
+  it('reports a running deployment for the app', () => {
+    job('current', '2.0', CURRENT);
+    expect(store.running('tenant', 'Example.App')).toBe(false);
+    job('queued', '1.1', null, 'queued');
+    expect(store.running('tenant', 'example.app')).toBe(true);
+  });
+
+  it('remembers skipped versions per tenant and app, and can allow them again', () => {
+    store.skip({ tenant_id: 'tenant', winget_id: 'Example.App', version: '2.0', rolled_back_to: '1.1', job_id: 'j', created_by: 'staff@example.test', created_at: '2026-01-06T00:00:00Z' });
+    expect(store.skipped('tenant', 'example.app', '2.0')?.rolled_back_to).toBe('1.1');
+    expect(store.skipped('tenant', 'Example.App', '2.1')).toBeNull();
+    expect(store.skipped('other', 'Example.App', '2.0')).toBeNull();
+    expect(store.listSkipped('tenant', 'Example.App')).toHaveLength(1);
+    expect(store.unskip('tenant', 'Example.App', '2.0')).toBe(true);
+    expect(store.unskip('tenant', 'Example.App', '2.0')).toBe(false);
+  });
+});
+
+describe('the rollback deployment', () => {
+  const previous = {
+    id: 'older', winget_id: 'Example.App', version: '1.1', display_name: 'Example', publisher: 'Example Co', architecture: 'x64',
+    installer_type: 'exe', installer_url: 'https://example.invalid/1.1.exe', installer_sha256: 'a'.repeat(64),
+    install_command: 'setup.exe /S', uninstall_command: 'uninstall.exe /S', install_scope: 'machine', detection_rules: [{ type: 'file' }],
+    package_config: { pilotRolloutId: 'old-pilot', autoUpdateHistoryId: 'h', sourceIntuneAppId: OLDEST, assignments: [{ groupId: 'stale' }],
+      categories: [{ id: 'old' }], relationships: [{ relationshipType: 'supersedence' }, { relationshipType: 'dependency', targetId: 'dep-old' }] },
+  } as unknown as PackagingJob;
+  const current = { id: 'current', display_name: 'Example App', package_config: { categories: [{ id: 'now' }], espProfiles: ['esp'], relationships: [{ relationshipType: 'dependency', targetId: 'dep-now' }] } } as unknown as PackagingJob;
+
+  it('reuses the previous installer and replaces the current copy, taking its live groups', () => {
+    const built = buildRollbackJob(previous, current, CURRENT, { userId: 'u', tenantId: 'tenant', userEmail: 'staff@example.test' }, '2.0');
+    const config = built.package_config as Record<string, unknown>;
+    expect(built).toMatchObject({ version: '1.1', installer_url: 'https://example.invalid/1.1.exe', installer_sha256: 'a'.repeat(64), uninstall_command: 'uninstall.exe /S', status: 'queued', is_auto_update: false, display_name: 'Example App' });
+    expect(config).toMatchObject({ sourceIntuneAppId: CURRENT, autoSupersede: true, supersedenceType: 'replace', forceCreate: true, assignments: [], categories: [{ id: 'now' }], espProfiles: ['esp'] });
+    expect(config.relationships).toEqual([{ relationshipType: 'dependency', targetId: 'dep-now' }]);
+    expect(config).not.toHaveProperty('pilotRolloutId');
+    expect(config).not.toHaveProperty('autoUpdateHistoryId');
+    expect(config.hrmRollback).toEqual({ fromVersion: '2.0', fromAppId: CURRENT, previousJobId: 'older' });
+  });
+
+  it('sends Replace supersedence and carries the groups over in the workflow', () => {
+    const built = { ...buildRollbackJob(previous, current, CURRENT, { userId: 'u', tenantId: 'tenant' }, '2.0'), id: 'rollback' } as PackagingJob;
+    const inputs = buildUpdateWorkflowInputs(built, 'https://example.invalid/callback');
+    expect(inputs).toMatchObject({ sourceIntuneAppId: CURRENT, supersedenceType: 'replace', autoSupersede: true, carryOverAssignments: true, removeAssignmentsFromPreviousApp: true, version: '1.1' });
+    expect(inputs.assignments).toBeUndefined();
+    const update = buildUpdateWorkflowInputs({ ...built, package_config: { sourceIntuneAppId: CURRENT } } as unknown as PackagingJob, 'https://example.invalid/callback');
+    expect(update.supersedenceType).toBe('update');
+  });
+
+  it('ties approval to the copy, both versions and the groups (in any order)', () => {
+    const a = rollbackToken(CURRENT, '2.0', 'older', ['g1', 'g2']);
+    expect(rollbackToken(CURRENT.toUpperCase(), '2.0', 'older', ['g2', 'g1'])).toBe(a);
+    expect(rollbackToken(CURRENT, '2.0', 'older', ['g1'])).not.toBe(a);
+    expect(rollbackToken(CURRENT, '2.1', 'older', ['g1', 'g2'])).not.toBe(a);
+    expect(rollbackToken(CURRENT, '2.0', 'oldest', ['g1', 'g2'])).not.toBe(a);
+  });
+});
+
+describe('automatic updates skip a rolled-back version', () => {
+  afterEach(() => { vi.unstubAllEnvs(); vi.resetModules(); vi.doUnmock('@/lib/db/sqlite'); });
+  it('holds only the skipped version, and only in SQLite mode', async () => {
+    vi.stubEnv('DATABASE_MODE', 'sqlite');
+    vi.doMock('@/lib/db/sqlite', () => ({ sqliteRollbacks: { skipped: (_t: string, _w: string, v: string) => (v === '2.0' ? { version: '2.0', rolled_back_to: '1.1' } : null) } }));
+    const { skippedVersionHold } = await import('../rollback-guard');
+    expect(await skippedVersionHold('tenant', 'Example.App', '2.0')).toBe(ROLLBACK_SKIP_REASON('2.0', '1.1'));
+    expect(await skippedVersionHold('tenant', 'Example.App', '2.1')).toBeNull();
+    vi.stubEnv('DATABASE_MODE', 'supabase');
+    expect(await skippedVersionHold('tenant', 'Example.App', '2.0')).toBeNull();
+  });
+  it('ignores a mocked database module without the store', async () => {
+    vi.stubEnv('DATABASE_MODE', 'sqlite');
+    vi.doMock('@/lib/db/sqlite', () => ({}));
+    const { skippedVersionHold } = await import('../rollback-guard');
+    expect(await skippedVersionHold('tenant', 'Example.App', '2.0')).toBeNull();
+  });
+});
diff --git a/lib/hrm/installer-check.ts b/lib/hrm/installer-check.ts
new file mode 100644
index 000000000..3b0b972df
--- /dev/null
+++ b/lib/hrm/installer-check.ts
@@ -0,0 +1,165 @@
+/**
+ * HRM patch 0039: does a saved installer still download?
+ *
+ * Going back to a previous version (patch 0037) reuses the installer IntuneGet used before, and
+ * vendors sometimes delete old downloads. These checks run on the server, so they only fetch https
+ * addresses on public hosts: every hop of a redirect is checked again, credentials and other ports
+ * are refused, and a host that resolves to a private, loopback or link-local address is refused, so a
+ * saved address can never reach the server's own network. Each connection resolves and validates its
+ * destination again in the socket's own lookup, so a changed DNS answer can't slip past the check.
+ */
+import { lookup as dnsLookup } from 'node:dns/promises';
+import { createHash } from 'node:crypto';
+import { isIP } from 'node:net';
+import { request as httpsRequest } from 'node:https';
+import { Readable } from 'node:stream';
+
+// 'unsupported': the link is not an https address on a public host, so the server will never fetch it.
+export type Reachability = { status: 'ready' | 'missing' | 'unreachable' | 'unsupported'; detail: string | null; finalUrl: string | null };
+type Lookup = (host: string) => Promise<Array<{ address: string }>>;
+export interface CheckOptions { fetchImpl?: typeof fetch; lookup?: Lookup; timeoutMs?: number }
+
+const MAX_REDIRECTS = 5;
+const defaultLookup: Lookup = (host) => dnsLookup(host, { all: true, verbatim: true });
+
+/** True only for addresses on the public internet. */
+export function isPublicAddress(address: string): boolean {
+  const v = isIP(address);
+  if (v === 4) {
+    const [a, b] = address.split('.').map(Number);
+    if (a === 0 || a === 10 || a === 127 || a >= 224) return false;
+    if (a === 169 && b === 254) return false;
+    if (a === 172 && b >= 16 && b <= 31) return false;
+    if (a === 192 && b === 168) return false;
+    if (a === 100 && b >= 64 && b <= 127) return false; // carrier-grade NAT
+    if (a === 192 && b === 0) return false;
+    if (a === 198 && (b === 18 || b === 19)) return false;
+    return true;
+  }
+  if (v === 6) {
+    const x = address.toLowerCase();
+    if (x === '::' || x === '::1') return false;
+    if (x.startsWith('::ffff:')) return isPublicAddress(x.slice(7));
+    if (/^f[cd]/.test(x) || /^fe[89ab]/.test(x) || x.startsWith('ff')) return false;
+    // Only global unicast; refuse transition, documentation and special-use ranges.
+    return /^[23]/.test(x) && !x.startsWith('2001:') && !x.startsWith('2002:');
+  }
+  return false;
+}
+
+/** An https address on port 443 with no credentials, or null. */
+export function safeHttpsUrl(raw: string): URL | null {
+  let url: URL;
+  try { url = new URL(raw); } catch { return null; }
+  if (url.protocol !== 'https:' || url.username || url.password || (url.port && url.port !== '443')) return null;
+  return url;
+}
+
+async function publicHost(url: URL, lookup: Lookup): Promise<'public' | 'private' | 'unresolved'> {
+  const host = url.hostname.replace(/^\[|\]$/g, '');
+  if (isIP(host)) return isPublicAddress(host) ? 'public' : 'private';
+  const answers = await lookup(host).catch(() => []);
+  if (answers.length === 0) return 'unresolved';
+  return answers.every((a) => isPublicAddress(a.address)) ? 'public' : 'private';
+}
+
+/** Native HTTPS keeps the validated DNS answer bound to the actual socket. */
+const publicFetch: typeof fetch = async (input, init) => {
+  const url = new URL(String(input));
+  if (!safeHttpsUrl(url.href)) throw new Error('Unsafe download address');
+  if (isIP(url.hostname.replace(/^\[|\]$/g, '')) && !isPublicAddress(url.hostname.replace(/^\[|\]$/g, ''))) throw new Error('Private address');
+  return new Promise<Response>((resolve, reject) => {
+    const req = httpsRequest(url, {
+      method: init?.method ?? 'GET', signal: init?.signal ?? undefined,
+      headers: Object.fromEntries(new Headers(init?.headers).entries()),
+      lookup(host, _options, callback) {
+        defaultLookup(host).then((answers) => {
+          if (!answers.length || answers.some(a => !isPublicAddress(a.address))) return callback(new Error('Private address'), '', 4);
+          // Node requests all answers when automatic family selection is enabled.
+          if (_options.all) callback(null, answers.map(a => ({ address: a.address, family: isIP(a.address) })) as never, 4);
+          else callback(null, answers[0].address, isIP(answers[0].address));
+        }).catch(error => callback(error, '', 4));
+      },
+    }, response => {
+      const headers = new Headers();
+      for (const [name, value] of Object.entries(response.headers)) {
+        if (value !== undefined) headers.set(name, Array.isArray(value) ? value.join(', ') : value);
+      }
+      const status = response.statusCode ?? 500;
+      if (init?.method === 'HEAD' || [204, 205, 304].includes(status)) {
+        response.resume(); resolve(new Response(null, { status, headers }));
+      } else {
+        resolve(new Response(Readable.toWeb(response) as ReadableStream<Uint8Array>, { status, headers }));
+      }
+    });
+    req.on('error', reject); req.end();
+  });
+};
+
+/** Follow up to 5 redirects with HEAD (or a 1-byte GET where HEAD isn't allowed). Never downloads the file. */
+export async function checkInstallerReachable(raw: string, options: CheckOptions = {}): Promise<Reachability> {
+  const fetchImpl = options.fetchImpl ?? publicFetch;
+  const lookup = options.lookup ?? defaultLookup;
+  let current = raw;
+  for (let hop = 0; hop <= MAX_REDIRECTS; hop++) {
+    const url = safeHttpsUrl(current);
+    if (!url) return { status: 'unsupported', detail: 'The download link is not an https address on the standard port.', finalUrl: null };
+    const host = await publicHost(url, lookup);
+    if (host === 'private') return { status: 'unsupported', detail: `${url.hostname} is not a public internet address.`, finalUrl: null };
+    if (host === 'unresolved') return { status: 'unreachable', detail: `${url.hostname} could not be found.`, finalUrl: null };
+    let response: Response;
+    try {
+      const signal = AbortSignal.timeout(options.timeoutMs ?? 15000);
+      response = await fetchImpl(url, { method: 'HEAD', redirect: 'manual', cache: 'no-store', signal });
+      if ([403, 405, 501].includes(response.status)) {
+        response = await fetchImpl(url, { method: 'GET', redirect: 'manual', cache: 'no-store', signal, headers: { Range: 'bytes=0-0' } });
+        await response.body?.cancel().catch(() => undefined);
+      }
+    } catch {
+      return { status: 'unreachable', detail: `${url.hostname} did not answer.`, finalUrl: null };
+    }
+    await response.body?.cancel().catch(() => undefined);
+    if (response.status >= 300 && response.status < 400) {
+      const location = response.headers.get('location');
+      if (!location) return { status: 'unreachable', detail: `${url.hostname} sent a redirect with no address.`, finalUrl: null };
+      try { current = new URL(location, url).href; } catch { return { status: 'unreachable', detail: 'The download sent an invalid redirect.', finalUrl: null }; }
+      continue;
+    }
+    if (response.ok) return { status: 'ready', detail: null, finalUrl: url.href };
+    if (response.status === 404 || response.status === 410) return { status: 'missing', detail: `${url.hostname} says the file is gone (${response.status}).`, finalUrl: null };
+    return { status: 'unreachable', detail: `${url.hostname} answered ${response.status}.`, finalUrl: null };
+  }
+  return { status: 'unreachable', detail: 'The download link redirects too many times.', finalUrl: null };
+}
+
+/** Download once (never saved) and compare the SHA-256 with the one IntuneGet recorded. */
+export async function verifyInstallerChecksum(raw: string, expectedSha256: string, options: CheckOptions & { maxBytes?: number } = {}):
+  Promise<{ status: 'match' | 'mismatch' | 'missing' | 'unreachable'; detail: string | null }> {
+  const reach = await checkInstallerReachable(raw, options);
+  if (reach.status !== 'ready' || !reach.finalUrl) return { status: reach.status === 'missing' ? 'missing' : 'unreachable', detail: reach.detail };
+  const fetchImpl = options.fetchImpl ?? publicFetch;
+  const maxBytes = options.maxBytes ?? 4 * 1024 ** 3;
+  try {
+    const response = await fetchImpl(reach.finalUrl, { redirect: 'error', cache: 'no-store', signal: AbortSignal.timeout(options.timeoutMs ?? 15 * 60000) });
+    if (!response.ok || !response.body) {
+      await response.body?.cancel().catch(() => undefined);
+      return { status: [404, 410].includes(response.status) ? 'missing' : 'unreachable', detail: `The download answered ${response.status}.` };
+    }
+    const hash = createHash('sha256');
+    let bytes = 0;
+    const reader = response.body.getReader();
+    for (;;) {
+      const { done, value } = await reader.read();
+      if (done) break;
+      bytes += value.byteLength;
+      if (bytes > maxBytes) { await reader.cancel(); return { status: 'unreachable', detail: 'The download is larger than IntuneGet checks (4 GB).' }; }
+      hash.update(value);
+    }
+    const actual = hash.digest('hex');
+    return actual.toLowerCase() === expectedSha256.trim().toLowerCase()
+      ? { status: 'match', detail: null }
+      : { status: 'mismatch', detail: 'The file at the saved link has changed since IntuneGet used it.' };
+  } catch {
+    return { status: 'unreachable', detail: 'The download stopped before it finished.' };
+  }
+}
diff --git a/lib/hrm/intune-copies.ts b/lib/hrm/intune-copies.ts
new file mode 100644
index 000000000..4eaa81e5e
--- /dev/null
+++ b/lib/hrm/intune-copies.ts
@@ -0,0 +1,123 @@
+/**
+ * HRM patch 0042: Intune calls for copies of the same app, shared by duplicate cleanup (patches 0025 and
+ * 0026) and the automatic removal of old copies after an update.
+ *
+ * Intune won't delete an app that another app supersedes or depends on, so unlinkAndDelete first removes
+ * the links between copies of this same app (only those), and refuses if any other app links to it.
+ */
+import { GRAPH_API_BASE } from '@/lib/intune/graph-client';
+import type { GraphAssignment } from '@/lib/hrm/duplicates';
+
+/** Intune's own reason, short (app names and IDs only; never client data). */
+export async function intuneReason(response: Response): Promise<string> {
+  const body = (await response.json().catch(() => null)) as { error?: { message?: string } } | null;
+  const message = body?.error?.message?.split('\n')[0]?.trim();
+  return message ? ` Intune said: ${message.slice(0, 200)}` : '';
+}
+
+export interface Relationship {
+  '@odata.type'?: string;
+  targetId: string;
+  targetDisplayName?: string;
+  targetType?: 'child' | 'parent';
+  supersedenceType?: string;
+  dependencyType?: string;
+}
+
+/** The fields Intune's updateRelationships accepts for a relationship this app owns. */
+const toInput = (r: Relationship) => ({
+  '@odata.type': r['@odata.type'],
+  targetId: r.targetId,
+  ...(r.supersedenceType ? { supersedenceType: r.supersedenceType } : {}),
+  ...(r.dependencyType ? { dependencyType: r.dependencyType } : {}),
+});
+
+export interface GraphApp { id: string; displayName: string; displayVersion?: string; publisher: string | null; '@odata.type'?: string }
+
+export async function graph(token: string, path: string, init: RequestInit = {}) {
+  return fetch(`${GRAPH_API_BASE}${path}`, {
+    ...init,
+    headers: { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json', ...(init.headers ?? {}) },
+    cache: 'no-store',
+  });
+}
+
+/** A Win32 app copy and its assignments, or null when it's gone, isn't Win32, or couldn't be read. */
+export async function loadCopy(token: string, id: string): Promise<{ app: GraphApp; assignments: GraphAssignment[] } | null> {
+  const [appResponse, assignmentsResponse] = await Promise.all([
+    graph(token, `/deviceAppManagement/mobileApps/${id}`),
+    graph(token, `/deviceAppManagement/mobileApps/${id}/assignments`),
+  ]);
+  if (!appResponse.ok || !assignmentsResponse.ok) return null;
+  const app = (await appResponse.json()) as GraphApp;
+  if (app['@odata.type'] !== '#microsoft.graph.win32LobApp') return null;
+  const assignments = ((await assignmentsResponse.json()) as { value?: GraphAssignment[] }).value ?? [];
+  return { app, assignments };
+}
+
+// Relationships are a beta-only part of the Intune API.
+const BETA = () => GRAPH_API_BASE.replace(/\/v1\.0$/, '/beta');
+
+export async function relationships(token: string, id: string): Promise<Relationship[] | null> {
+  const response = await fetch(`${BETA()}/deviceAppManagement/mobileApps/${id}/relationships`, {
+    headers: { Authorization: `Bearer ${token}` },
+    cache: 'no-store',
+  });
+  if (!response.ok) return null;
+  return ((await response.json()) as { value?: Relationship[] }).value ?? [];
+}
+
+export async function setRelationships(token: string, id: string, owned: Relationship[]) {
+  return fetch(`${BETA()}/deviceAppManagement/mobileApps/${id}/updateRelationships`, {
+    method: 'POST',
+    headers: { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json' },
+    body: JSON.stringify({ relationships: owned.map(toInput) }),
+    cache: 'no-store',
+  });
+}
+
+export async function assign(token: string, id: string, assignments: GraphAssignment[]) {
+  const response = await graph(token, `/deviceAppManagement/mobileApps/${id}/assign`, {
+    method: 'POST',
+    body: JSON.stringify({ mobileAppAssignments: assignments }),
+  });
+  return response.ok;
+}
+
+export type DeleteResult = { ok: true; unlinked: string[] } | { ok: false; reason: string; status: 409 | 424 };
+
+/**
+ * Delete an emptied copy. copyIds are the copies of the same app (checked by the caller): links to and from
+ * them are removed first; a link from any other app stops the delete with nothing changed.
+ */
+export async function unlinkAndDelete(token: string, id: string, copyIds: Set<string>): Promise<DeleteResult> {
+  const links = await relationships(token, id);
+  if (!links) return { ok: false, reason: "Couldn't read this copy's links in Intune. Nothing was changed.", status: 424 };
+  const isCopy = (targetId: string) => copyIds.has(targetId.toLowerCase());
+  // Another app supersedes or depends on this copy: that's not ours to undo.
+  const outside = links.filter((r) => r.targetType === 'parent' && !isCopy(r.targetId));
+  if (outside.length > 0) {
+    const names = [...new Set(outside.map((r) => r.targetDisplayName || 'another app'))].join(', ');
+    return { ok: false, reason: `${names} replaces or depends on this copy, so Intune won't delete it. Remove that link in Intune first. Nothing was changed.`, status: 409 };
+  }
+  const unlinked: string[] = [];
+  // Copies that supersede (or depend on) this one: drop just that link, keep the rest.
+  for (const parent of links.filter((r) => r.targetType === 'parent')) {
+    const parentLinks = await relationships(token, parent.targetId);
+    if (!parentLinks) return { ok: false, reason: "Couldn't read the links on the other copy. Nothing was deleted.", status: 424 };
+    const owned = parentLinks.filter((r) => r.targetType === 'child');
+    const kept = owned.filter((r) => r.targetId.toLowerCase() !== id.toLowerCase());
+    if (kept.length === owned.length) continue;
+    const response = await setRelationships(token, parent.targetId, kept);
+    if (!response.ok) return { ok: false, reason: `Intune didn't remove the link from the other copy. Nothing was deleted.${await intuneReason(response)}`, status: 424 };
+    unlinked.push(parent.targetDisplayName || parent.targetId);
+  }
+  // This copy's own links (to older copies or other apps) go with it.
+  if (links.some((r) => r.targetType === 'child')) {
+    const response = await setRelationships(token, id, []);
+    if (!response.ok) return { ok: false, reason: `Intune didn't remove this copy's links. Nothing was deleted.${await intuneReason(response)}`, status: 424 };
+  }
+  const response = await graph(token, `/deviceAppManagement/mobileApps/${id}`, { method: 'DELETE' });
+  if (!response.ok) return { ok: false, reason: `Intune didn't delete it.${await intuneReason(response)}`, status: 424 };
+  return { ok: true, unlinked };
+}
diff --git a/lib/hrm/old-copy-cleanup.ts b/lib/hrm/old-copy-cleanup.ts
new file mode 100644
index 000000000..de03790c4
--- /dev/null
+++ b/lib/hrm/old-copy-cleanup.ts
@@ -0,0 +1,195 @@
+/**
+ * HRM patch 0042: remove old copies of an app from Intune after an update has settled.
+ *
+ * Every update (and, from patch 0050, each Deploy new version of a custom app) deploys a new Intune copy that
+ * supersedes the previous one and takes its groups; the previous copy stays in Intune (with its groups after a
+ * pilot's wider rollout). At each update check (3:30 AM and 3:30 PM), for each app IntuneGet
+ * deployed, older copies IntuneGet deployed are removed when all of these hold:
+ *   - the old copy was replaced at least 7 days ago (the copy after it was deployed 7 or more days ago;
+ *     patch 0050, so apps released more often than weekly still get cleaned),
+ *   - the newest copy has at least 1 successful install and failures are 10% or less,
+ *   - no pilot, retirement, going back or deployment of the app is under way,
+ *   - the newest copy supersedes the old copy (directly or through other copies of the app),
+ *   - every group on the old copy is on the newest copy with the same intent and filter.
+ * Removing a copy takes its groups off, removes the links between copies of the app, and deletes it.
+ * Nothing is uninstalled: the newest copy has already replaced it on computers.
+ * A copy the newest doesn't supersede (deployed alongside, or a second copy) is left alone and not listed.
+ * A replaced copy with groups the newest lacks, or that Intune won't delete, is kept and listed on Home.
+ * So is a replaced copy that is waiting on a newest copy 7 or more days old with no groups, no installs or too many failures (patch 0050).
+ * Copies added in Intune by hand, and removal copies ("(uninstall only)", patch 0040), are never touched. HRM_OLD_COPY_CLEANUP=off turns this off.
+ */
+import { getServicePrincipalToken } from '@/lib/intune/graph-client';
+import { summarizeAssignments } from '@/lib/hrm/app-insights';
+import type { GraphAssignment } from '@/lib/hrm/duplicates';
+import { assign, loadCopy, relationships, unlinkAndDelete } from '@/lib/hrm/intune-copies';
+import { REMOVAL_SUFFIX } from '@/lib/hrm/removal';
+
+export const SETTLE_MS = 7 * 24 * 60 * 60 * 1000;
+export const MAX_REMOVALS_PER_RUN = 20;
+const RUN_BUDGET_MS = 90000;
+const CHAIN_LIMIT = 10;
+export const REMOVED_BY = 'Removed by IntuneGet: old copy after an update';
+
+/** One assignment as Intune applies it: target, group, filter and intent. */
+export function assignmentKey(a: GraphAssignment): string {
+  const t = a.target ?? {};
+  return [t['@odata.type'], t.groupId, t.deviceAndAppManagementAssignmentFilterId, t.deviceAndAppManagementAssignmentFilterType, a.intent]
+    .map((v) => String(v ?? '').toLowerCase()).join('|');
+}
+
+/** At least one computer installed the newest copy, and no more than 1 in 10 results are failures. */
+export function installsSettled(counts: { installed: number; failed: number } | null | undefined): boolean {
+  if (!counts || counts.installed < 1) return false;
+  return counts.failed * 10 <= counts.installed + counts.failed;
+}
+
+/** Patch 0050: when an old copy was replaced: the copy after it was deployed. Copies are oldest first. */
+export function supersededAt(older: Array<{ deployedAt: string }>, index: number, newestDeployedAt: string): number {
+  return parseDeployedAt(older[index + 1]?.deployedAt ?? newestDeployedAt);
+}
+
+export function parseDeployedAt(value: string): number {
+  return Date.parse(value.includes('T') ? value : `${value.replace(' ', 'T')}Z`);
+}
+
+/** Patch 0050: why cleanup is stuck on a newest copy that has been out 7 days without settling. */
+export function stuckReason(newestVersion: string, groups: number, counts: { installed: number; failed: number } | null | undefined): string {
+  // Patch 0058: about 20 words each. When cleanup removes the held copy is in Help.
+  const newest = newestVersion ? `v${newestVersion}` : 'The newest copy';
+  if (groups === 0) return `${newest} has no groups, so no computer gets it. Open ${newest} in Inventory and press Keep this copy to move the groups.`;
+  if (!counts || counts.installed < 1) return `${newest} has no successful installs after 7 days. Open it in Inventory and check Install results.`;
+  return `Over 1 in 10 installs of ${newest} failed. Open it in Inventory and check Install results.`;
+}
+
+export type Verdict = { action: 'remove' } | { action: 'keep'; reason: string } | { action: 'skip' };
+
+/** Whether one older copy can go, given the newest copy's groups and the copies it supersedes. */
+export function judgeOldCopy(copy: { appId: string; assignments: GraphAssignment[] }, newest: { assignments: GraphAssignment[]; supersedes: Set<string> }): Verdict {
+  // Not replaced by the newest copy: deployed alongside or as a second copy on purpose. Left alone, not listed.
+  if (!newest.supersedes.has(copy.appId.toLowerCase())) return { action: 'skip' };
+  const newestKeys = new Set(newest.assignments.map(assignmentKey));
+  const extra = copy.assignments.filter((a) => !newestKeys.has(assignmentKey(a)));
+  if (extra.length > 0) {
+    return { action: 'keep', reason: `This copy has ${extra.length === 1 ? 'a group' : `${extra.length} groups`} the newest copy doesn't. Open the newest copy in Inventory and press Keep this copy. Then press Delete from Intune on this copy.` };
+  }
+  return { action: 'remove' };
+}
+
+/** The copies the newest one supersedes, following links only through these copies of the app; null if unreadable. */
+export async function supersededChain(token: string, newestId: string, copyIds: Set<string>): Promise<Set<string> | null> {
+  const found = new Set<string>();
+  let frontier = [newestId];
+  for (let depth = 0; depth < CHAIN_LIMIT && frontier.length > 0; depth++) {
+    const next: string[] = [];
+    for (const id of frontier) {
+      const links = await relationships(token, id);
+      if (!links) return null;
+      for (const r of links) {
+        const target = r.targetId.toLowerCase();
+        if (r.targetType !== 'child' || !String(r['@odata.type'] ?? '').toLowerCase().includes('supersedence')) continue;
+        if (!copyIds.has(target) || found.has(target)) continue;
+        found.add(target);
+        next.push(target);
+      }
+    }
+    frontier = next;
+  }
+  return found;
+}
+
+export interface CleanupSummary { checked: number; removed: number; kept: number; errors: number; disabled?: boolean }
+
+export async function runSqliteOldCopyCleanup(options: { now?: Date; token?: (tenantId: string) => Promise<string | null> } = {}): Promise<CleanupSummary> {
+  const summary: CleanupSummary = { checked: 0, removed: 0, kept: 0, errors: 0 };
+  if (process.env.HRM_OLD_COPY_CLEANUP?.trim().toLowerCase() === 'off') return { ...summary, disabled: true };
+  const { sqliteOldCopies, sqlitePilotRollouts, sqliteRetirements, sqliteRollbacks, sqliteInstallStatus, sqliteAppInsights } = await import('@/lib/db/sqlite');
+  const now = options.now ?? new Date();
+  const deadline = Date.now() + RUN_BUDGET_MS;
+  const tokens = new Map<string, Promise<string | null>>();
+  const note = (tenant: string, wingetId: string, app: { id: string; displayName: string; displayVersion?: string }, assignments: GraphAssignment[], exists: boolean) => {
+    try {
+      sqliteAppInsights.observe(tenant, { appId: app.id, wingetId, displayName: app.displayName, version: app.displayVersion ?? '', exists,
+        assignments: summarizeAssignments(assignments), checkedAt: new Date().toISOString() }, REMOVED_BY, true);
+    } catch { /* Activity is optional; the Intune change still stands. */ }
+  };
+
+  for (const newest of sqliteOldCopies.newest()) {
+    if (Date.now() > deadline || summary.removed >= MAX_REMOVALS_PER_RUN) break;
+    // Removal copies (patch 0040) uninstall an app; they are never part of an update chain.
+    const removal = (name: string) => name.toLowerCase().endsWith(REMOVAL_SUFFIX.toLowerCase());
+    if (removal(newest.displayName)) continue;
+    if (sqliteOldCopies.startupFamily(newest.tenantId, newest.wingetId)) continue;
+    const older = sqliteOldCopies.older(newest.tenantId, newest.wingetId, newest.appId);
+    if (older.length === 0) continue;
+    // Settling: each old copy waits 7 days after it was replaced (patch 0050), the newest copy needs healthy
+    // installs, and nothing else may be changing this app.
+    const settled = (at: number) => Number.isFinite(at) && now.getTime() - at >= SETTLE_MS;
+    const due = new Set(older.filter((_, i) => settled(supersededAt(older, i, newest.deployedAt))).map((o) => o.appId.toLowerCase()));
+    if (due.size === 0) continue;
+    if (sqlitePilotRollouts.active(newest.tenantId, newest.wingetId) || sqliteRetirements.holdsFamily(newest.tenantId, newest.wingetId)
+      || sqliteRollbacks.running(newest.tenantId, newest.wingetId)) continue;
+    const counts = await sqliteInstallStatus.get(newest.tenantId, newest.appId);
+    const healthy = installsSettled(counts);
+    // A newest copy younger than 7 days may still be rolling out: wait quietly. Older than that, say why on Home.
+    if (!healthy && !settled(parseDeployedAt(newest.deployedAt))) continue;
+    if ([newest.appId, ...older.map((o) => o.appId)].some((id) => sqliteRetirements.holdsApp(newest.tenantId, id) || sqlitePilotRollouts.holdsApp(newest.tenantId, id))) continue;
+
+    summary.checked++;
+    try {
+      if (!tokens.has(newest.tenantId)) tokens.set(newest.tenantId, (options.token ?? getServicePrincipalToken)(newest.tenantId));
+      const token = await tokens.get(newest.tenantId);
+      if (!token) throw new Error('No token');
+      const current = await loadCopy(token, newest.appId);
+      if (!current) continue; // Deleted or unreadable: nothing to compare against.
+      const copies: Array<{ appId: string; version: string; app: NonNullable<Awaited<ReturnType<typeof loadCopy>>> }> = [];
+      for (const o of older) {
+        const loaded = await loadCopy(token, o.appId);
+        if (loaded && !removal(loaded.app.displayName)) copies.push({ appId: o.appId, version: o.version, app: loaded });
+        else if (loaded) continue;
+        else sqliteOldCopies.clear(newest.tenantId, o.appId); // Already gone (or not Win32): nothing to keep listing.
+      }
+      if (copies.length === 0) continue;
+      const family = new Set([newest.appId, ...copies.map((c) => c.appId)].map((id) => id.toLowerCase()));
+      const supersedes = await supersededChain(token, newest.appId, family);
+      if (!supersedes) throw new Error("Couldn't read supersedence");
+
+      const record = (c: (typeof copies)[number], outcome: 'removed' | 'kept', reason: string | null) => sqliteOldCopies.record({
+        tenant_id: newest.tenantId, app_id: c.appId, winget_id: newest.wingetId, display_name: c.app.app.displayName || newest.displayName,
+        version: c.app.app.displayVersion || c.version, newest_app_id: newest.appId, newest_version: newest.version, outcome, reason, at: now.toISOString() });
+
+      // Oldest first, so each delete only unlinks it from the next copy up the chain.
+      for (const c of copies) {
+        if (summary.removed >= MAX_REMOVALS_PER_RUN || Date.now() > deadline) break;
+        if (!due.has(c.appId.toLowerCase())) continue; // Replaced less than 7 days ago.
+        if (!healthy) {
+          // Stuck: never removed while the newest copy has no healthy installs, but listed on Home with the reason.
+          if (!supersedes.has(c.appId.toLowerCase())) { sqliteOldCopies.clear(newest.tenantId, c.appId); continue; }
+          record(c, 'kept', stuckReason(current.app.displayVersion || newest.version, current.assignments.length, counts)); summary.kept++; continue;
+        }
+        const verdict = judgeOldCopy({ appId: c.appId, assignments: c.app.assignments }, { assignments: current.assignments, supersedes });
+        if (verdict.action === 'skip') { sqliteOldCopies.clear(newest.tenantId, c.appId); continue; }
+        if (verdict.action === 'keep') { record(c, 'kept', verdict.reason); summary.kept++; continue; }
+        if (c.app.assignments.length > 0) {
+          if (!(await assign(token, c.appId, []))) {
+            record(c, 'kept', "Intune refused to remove this copy's groups, so nothing changed. Open the newest copy in Inventory and press Keep this copy.");
+            summary.kept++; continue;
+          }
+          note(newest.tenantId, newest.wingetId, c.app.app, [], true);
+        }
+        const deleted = await unlinkAndDelete(token, c.appId, family);
+        if (!deleted.ok) {
+          // Its groups are already on the newest copy, so leaving it empty changes nothing for computers.
+          record(c, 'kept', `Its groups were removed, but it wasn't deleted. ${deleted.reason.replace(/ Nothing was changed\.$/, '')}`);
+          summary.kept++; continue;
+        }
+        note(newest.tenantId, newest.wingetId, c.app.app, [], false);
+        record(c, 'removed', null);
+        summary.removed++;
+      }
+    } catch (error) {
+      summary.errors++;
+      console.warn(`[old copies] ${newest.wingetId}: ${error instanceof Error ? error.message.slice(0, 120) : 'failed'}`);
+    }
+  }
+  return summary;
+}
diff --git a/lib/hrm/old-copy-store.ts b/lib/hrm/old-copy-store.ts
new file mode 100644
index 000000000..28e5619ef
--- /dev/null
+++ b/lib/hrm/old-copy-store.ts
@@ -0,0 +1,52 @@
+/**
+ * HRM patch 0042: what the automatic removal of old copies did with each older copy IntuneGet deployed.
+ * 'removed' copies are gone from Intune; 'kept' copies need a person (the reason says why).
+ */
+import type Database from 'better-sqlite3';
+
+export type OldCopyOutcome = 'removed' | 'kept';
+export interface OldCopyRecord {
+  tenant_id: string; app_id: string; winget_id: string; display_name: string; version: string;
+  newest_app_id: string; newest_version: string; outcome: OldCopyOutcome; reason: string | null; at: string;
+}
+export interface NewestDeployment { tenantId: string; wingetId: string; appId: string; displayName: string; version: string; deployedAt: string }
+export interface OlderCopy { appId: string; version: string; deployedAt: string }
+
+export function createOldCopyStore(getDb: () => Database.Database) {
+  return {
+    startupFamily(tenant: string, wingetId: string): boolean {
+      return !!getDb().prepare(`SELECT 1 FROM packaging_jobs WHERE tenant_id = ? AND winget_id = ? COLLATE NOCASE
+        AND CASE WHEN json_valid(package_config) THEN json_extract(package_config, '$.psadtConfig.installAfterRestartBeta') ELSE 0 END = 1 LIMIT 1`).get(tenant, wingetId);
+    },
+    record(row: OldCopyRecord) {
+      getDb().prepare(`INSERT INTO hrm_old_copy_cleanup (tenant_id, app_id, winget_id, display_name, version, newest_app_id, newest_version, outcome, reason, at)
+        VALUES (?,?,?,?,?,?,?,?,?,?)
+        ON CONFLICT (tenant_id, app_id) DO UPDATE SET winget_id = excluded.winget_id, display_name = excluded.display_name, version = excluded.version,
+          newest_app_id = excluded.newest_app_id, newest_version = excluded.newest_version, outcome = excluded.outcome, reason = excluded.reason, at = excluded.at`)
+        .run(row.tenant_id, row.app_id, row.winget_id, row.display_name, row.version, row.newest_app_id, row.newest_version, row.outcome, row.reason, row.at);
+    },
+    get(tenant: string, appId: string): OldCopyRecord | null {
+      return (getDb().prepare('SELECT * FROM hrm_old_copy_cleanup WHERE tenant_id = ? AND app_id = ? COLLATE NOCASE').get(tenant, appId) as OldCopyRecord) ?? null;
+    },
+    /** A copy that is no longer waiting to be removed (someone tidied it, or it became the newest). */
+    clear(tenant: string, appId: string) { getDb().prepare("DELETE FROM hrm_old_copy_cleanup WHERE tenant_id = ? AND app_id = ? COLLATE NOCASE AND outcome = 'kept'").run(tenant, appId); },
+    /** Older copies IntuneGet couldn't remove, newest first (for Home). */
+    kept(tenant: string): OldCopyRecord[] {
+      return getDb().prepare("SELECT * FROM hrm_old_copy_cleanup WHERE tenant_id = ? AND outcome = 'kept' ORDER BY at DESC LIMIT 50").all(tenant) as OldCopyRecord[];
+    },
+    /** The newest IntuneGet deployment of every app, in every tenant. */
+    newest(): NewestDeployment[] {
+      return getDb().prepare(`SELECT h.intune_tenant_id AS tenantId, h.winget_id AS wingetId, h.intune_app_id AS appId, h.display_name AS displayName,
+          h.version, h.deployed_at AS deployedAt FROM upload_history h
+        WHERE h.intune_tenant_id IS NOT NULL AND h.id = (SELECT n.id FROM upload_history n WHERE n.intune_tenant_id = h.intune_tenant_id
+          AND n.winget_id = h.winget_id ORDER BY n.deployed_at DESC, n.id DESC LIMIT 1)`).all() as NewestDeployment[];
+    },
+    /** Every other Intune copy IntuneGet deployed of this app (one row per copy, oldest first). */
+    older(tenant: string, wingetId: string, newestAppId: string): OlderCopy[] {
+      return getDb().prepare(`SELECT intune_app_id AS appId, version, MAX(deployed_at) AS deployedAt FROM upload_history
+        WHERE intune_tenant_id = ? AND winget_id = ? AND intune_app_id != ? COLLATE NOCASE
+        GROUP BY lower(intune_app_id) ORDER BY deployedAt ASC LIMIT 20`).all(tenant, wingetId, newestAppId) as OlderCopy[];
+    },
+  };
+}
+export type OldCopyStore = ReturnType<typeof createOldCopyStore>;
diff --git a/lib/hrm/pilot-graph.ts b/lib/hrm/pilot-graph.ts
new file mode 100644
index 000000000..c968d88d0
--- /dev/null
+++ b/lib/hrm/pilot-graph.ts
@@ -0,0 +1,90 @@
+import { jobIdFromNotes } from './new-version';
+import { inventoryPageUrl } from '@/lib/intune/inventory-list';
+import { createHash } from 'node:crypto';
+import { GUID, summarizeAssignments } from './app-insights';
+import { fetchInstallCounts } from './install-status';
+import type { GraphAssignment } from './duplicates';
+import type { PilotView, PilotPreview } from './pilot-types';
+const BASE = 'https://graph.microsoft.com/beta';
+export class PilotError extends Error { constructor(message: string, public status = 409) { super(message); } }
+interface App { id: string; displayName: string; publisher: string; displayVersion: string; '@odata.type': string }
+// HRM patch 0037: rollback and retire reuse these reads with their own message.
+export function pilotGraph(token: string, fetchImpl: typeof fetch = fetch, readError = 'Could not read Intune completely. No rollout was approved.') {
+  const signal = AbortSignal.timeout(30000);
+  const get = async (path: string) => {
+    const r = await fetchImpl(`${BASE}${path}`, { headers: { Authorization: `Bearer ${token}` }, cache: 'no-store', signal });
+    if (!r.ok) throw new PilotError(readError, 424);
+    return r.json();
+  };
+  const app = async (id: string): Promise<App> => {
+    if (!GUID.test(id)) throw new PilotError('Invalid app.');
+    const a = await get(`/deviceAppManagement/mobileApps/${id}`);
+    if (typeof a.id !== 'string' || a.id.toLowerCase() !== id.toLowerCase() || a['@odata.type'] !== '#microsoft.graph.win32LobApp') throw new PilotError('This is not the expected Win32 app.');
+    return a;
+  };
+  const assignments = async (id: string): Promise<GraphAssignment[]> => {
+    let path: string | null = `/deviceAppManagement/mobileApps/${id}/assignments`;
+    const rows: GraphAssignment[] = [];
+    for (let page = 0; path && page < 20; page++) {
+      const body = await get(path);
+      if (!Array.isArray(body.value)) throw new PilotError('Intune returned incomplete groups.', 424);
+      rows.push(...body.value);
+      const next = body['@odata.nextLink'];
+      if (next != null && (typeof next !== 'string' || !next.startsWith(`${BASE}/deviceAppManagement/mobileApps/${id}/assignments?`))) throw new PilotError('Intune returned an invalid groups continuation.', 424);
+      path = next ? next.slice(BASE.length) : null;
+    }
+    if (path) throw new PilotError('The groups list could not be read completely.', 424);
+    summarizeAssignments(rows); // reject malformed rows, never interpret them as empty
+    return rows;
+  };
+  const input = (rows: GraphAssignment[]) => rows.map((a) => ({ '@odata.type': '#microsoft.graph.mobileAppAssignment', intent: a.intent, target: a.target, ...(a.settings == null ? {} : { settings: a.settings }) }));
+  return {
+    app, assignments, input,
+    async hasJobCopy(jobId: string) {
+      let url: string | null = `${inventoryPageUrl(null)}&$select=id,notes`;
+      for (let page = 0; url && page < 50; page++) {
+        if (!url.startsWith(`${BASE}/deviceAppManagement/mobileApps?`)) throw new PilotError('Could not verify the failed pilot copies.',424);
+        const body = await get(url.slice(BASE.length));
+        if (!Array.isArray(body.value)) throw new PilotError('Could not verify the failed pilot copies.',424);
+        if (body.value.some((a: { notes?: string }) => jobIdFromNotes(a.notes)?.toLowerCase() === jobId.toLowerCase())) return true;
+        const next = body['@odata.nextLink'];
+        if (next != null && typeof next !== 'string') throw new PilotError('Incomplete Intune list.',424);
+        url = next || null;
+      }
+      if (url) throw new PilotError('The Intune list could not be read completely.',424);
+      return false;
+    },
+    async group(id: string) {
+      if (!GUID.test(id)) throw new PilotError('Choose a pilot group.');
+      const g = await get(`/groups/${id}?$select=id,displayName,securityEnabled`);
+      if (g.id?.toLowerCase() !== id.toLowerCase() || g.securityEnabled !== true || typeof g.displayName !== 'string') throw new PilotError('Choose an Entra security group for the pilot.');
+      return { id: g.id as string, name: g.displayName as string };
+    },
+    async pair(row: PilotView) {
+      if (row.job_status !== 'deployed' || !row.new_app_id || !row.new_version) throw new PilotError('The pilot deployment must finish successfully before wider rollout.');
+      const [old, next, oldGroups, newGroups] = await Promise.all([app(row.previous_app_id), app(row.new_app_id), assignments(row.previous_app_id), assignments(row.new_app_id)]);
+      if (old.displayVersion !== row.previous_version || next.displayVersion !== row.new_version || old.id === next.id) throw new PilotError('An app version changed. Review the apps in Intune first.');
+      const norm = (s: string) => (s || '').trim().toLowerCase();
+      if (norm(old.displayName) !== norm(next.displayName) || norm(old.publisher) !== norm(next.publisher)) throw new PilotError('These apps no longer match. Review them in Intune first.');
+      const links = await get(`/deviceAppManagement/mobileApps/${row.new_app_id}/relationships`);
+      if (!Array.isArray(links.value) || links['@odata.nextLink'] || !links.value.some((r: { targetId?: string; targetType?: string; supersedenceType?: string }) => r.targetId?.toLowerCase() === row.previous_app_id.toLowerCase() && r.targetType === 'child' && r.supersedenceType === 'update')) throw new PilotError('The new app must supersede the previous copy with Update. Check its relationships in Intune.');
+      if (!summarizeAssignments(oldGroups).some((a) => a.installs)) throw new PilotError('The previous copy has no groups receiving installations. Assign its wider groups in Intune first.');
+      return { oldGroups, newGroups };
+    },
+    async counts(id: string) { return fetchInstallCounts(token, id, ((url, init) => fetchImpl(url, { ...init, signal })) as typeof fetch); },
+    async assign(id: string, rows: GraphAssignment[]) {
+      const r = await fetchImpl(`${BASE}/deviceAppManagement/mobileApps/${id}/assign`, { method: 'POST', headers: { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json' }, body: JSON.stringify({ mobileAppAssignments: input(rows) }), signal, cache: 'no-store' });
+      if (!r.ok) throw new PilotError('Intune did not confirm the new groups. The previous copy keeps its groups; refresh the review before retrying.', 424);
+    },
+  };
+}
+export function promotionToken(row: PilotView, oldGroups: GraphAssignment[], newGroups: GraphAssignment[]): string {
+  const keys = (rows: GraphAssignment[]) => summarizeAssignments(rows).map((a) => a.key);
+  return createHash('sha256').update(JSON.stringify([row.id,row.revision,row.previous_app_id,row.new_app_id,row.previous_version,row.new_version,keys(oldGroups),keys(newGroups)])).digest('hex');
+}
+export async function previewPilot(row: PilotView, graph: ReturnType<typeof pilotGraph>): Promise<PilotPreview> {
+  const { oldGroups, newGroups } = await graph.pair(row);
+  const [previousResults,pilotResults] = await Promise.all([graph.counts(row.previous_app_id),graph.counts(row.new_app_id!)]);
+  const labels = (rows: GraphAssignment[]) => summarizeAssignments(rows).map((a) => a.label);
+  return { token: promotionToken(row,oldGroups,newGroups), previousGroups: labels(oldGroups), newGroups: labels(newGroups), proposedGroups: labels(oldGroups), previousResults, pilotResults, checkedAt: new Date().toISOString() };
+}
diff --git a/lib/hrm/pilot-guard.ts b/lib/hrm/pilot-guard.ts
new file mode 100644
index 000000000..5538e0f2b
--- /dev/null
+++ b/lib/hrm/pilot-guard.ts
@@ -0,0 +1,14 @@
+import { PILOT_HOLD } from './pilot-types';
+import { RETIRE_HOLD } from './retire';
+type RetireStore = typeof import('@/lib/db/sqlite')['sqliteRetirements'];
+export async function pilotHold(tenant: string, winget: string, allowedPilot?: string): Promise<string | null> {
+  if (process.env.DATABASE_MODE?.toLowerCase() !== 'sqlite') return null;
+  const mod = await import('@/lib/db/sqlite');
+  const row = mod.sqlitePilotRollouts.active(tenant, winget);
+  if (row && row.id !== allowedPilot) return PILOT_HOLD;
+  // HRM patch 0038: an app being retired is held the same way (Update, automatic updates, App catalog).
+  // Upstream tests mock '@/lib/db/sqlite' without this store, and vitest throws on a missing export.
+  let retire: RetireStore | undefined;
+  try { retire = mod.sqliteRetirements; } catch { return null; }
+  return retire?.holdsFamily(tenant, winget) ? RETIRE_HOLD : null;
+}
diff --git a/lib/hrm/pilot-store.ts b/lib/hrm/pilot-store.ts
new file mode 100644
index 000000000..c6757edfd
--- /dev/null
+++ b/lib/hrm/pilot-store.ts
@@ -0,0 +1,33 @@
+import type Database from 'better-sqlite3';
+import type { PilotRollout, PilotView } from './pilot-types';
+export function createPilotStore(getDb: () => Database.Database) {
+  const view = `SELECT p.*, j.status AS job_status, j.intune_app_id AS new_app_id, j.version AS new_version FROM hrm_pilot_rollouts p LEFT JOIN packaging_jobs j ON j.id = p.job_id`;
+  return {
+    get(tenant: string, id: string): PilotView | null { return (getDb().prepare(`${view} WHERE p.tenant_id = ? AND p.id = ?`).get(tenant, id) as PilotView) ?? null; },
+    list(tenant: string): PilotView[] { return getDb().prepare(`${view} WHERE p.tenant_id = ? ORDER BY (p.phase = 'complete'), p.created_at DESC LIMIT 100`).all(tenant) as PilotView[]; },
+    active(tenant: string, winget: string): PilotRollout | null { return (getDb().prepare("SELECT * FROM hrm_pilot_rollouts WHERE tenant_id = ? AND winget_id = ? COLLATE NOCASE AND phase != 'complete'").get(tenant, winget) as PilotRollout) ?? null; },
+    hasSetupProfiles(tenant: string, appId: string) { return Boolean(getDb().prepare("SELECT 1 FROM packaging_jobs WHERE tenant_id = ? AND intune_app_id = ? AND status = 'deployed' AND COALESCE(json_array_length(json_extract(package_config,'$.espProfiles')),0) > 0 LIMIT 1").get(tenant,appId)); },
+    holdsApp(tenant: string, appId: string) { return Boolean(getDb().prepare(`${view} WHERE p.tenant_id = ? AND p.phase != 'complete' AND (p.previous_app_id = ? OR j.intune_app_id = ?)`).get(tenant, appId, appId)); },
+    reserve(row: Omit<PilotRollout, 'phase' | 'revision' | 'lease_until' | 'approved_by' | 'job_id'>) {
+      const db = getDb();
+      db.transaction(() => {
+        if (db.prepare("SELECT 1 FROM packaging_jobs WHERE tenant_id = ? AND winget_id = ? COLLATE NOCASE AND archived_at IS NULL AND status NOT IN ('deployed','failed','cancelled','duplicate_skipped') LIMIT 1").get(row.tenant_id, row.winget_id)) throw new Error('A deployment for this app is still running.');
+        db.prepare(`INSERT INTO hrm_pilot_rollouts (id,tenant_id,winget_id,display_name,group_id,group_name,previous_app_id,previous_version,phase,revision,created_at) VALUES (?,?,?,?,?,?,?,?,'starting',0,?)`)
+          .run(row.id,row.tenant_id,row.winget_id,row.display_name,row.group_id,row.group_name,row.previous_app_id,row.previous_version,row.created_at);
+      }).immediate();
+    },
+    attach(tenant: string, id: string, jobId: string) { getDb().prepare("UPDATE hrm_pilot_rollouts SET job_id = ?, phase = 'testing' WHERE tenant_id = ? AND id = ? AND phase = 'starting'").run(jobId,tenant,id); },
+    releaseUnstarted(tenant: string, id: string) {
+      // Never release a reservation after an inserted job might have been dispatched.
+      getDb().prepare("DELETE FROM hrm_pilot_rollouts WHERE tenant_id = ? AND id = ? AND job_id IS NULL AND NOT EXISTS (SELECT 1 FROM packaging_jobs WHERE tenant_id = ? AND json_extract(package_config,'$.pilotRolloutId') = ?)").run(tenant,id,tenant,id);
+    },
+    claim(tenant: string, id: string, revision: number) {
+      const now = new Date().toISOString();
+      return getDb().prepare("UPDATE hrm_pilot_rollouts SET phase = 'promoting', revision = revision + 1, lease_until = ? WHERE tenant_id = ? AND id = ? AND revision = ? AND (phase = 'testing' OR (phase = 'promoting' AND lease_until < ?))")
+        .run(new Date(Date.now()+90000).toISOString(),tenant,id,revision,now).changes === 1;
+    },
+    finish(tenant: string, id: string, actor: string, revision: number) { return getDb().prepare("UPDATE hrm_pilot_rollouts SET phase = 'complete', lease_until = NULL, approved_by = ? WHERE tenant_id = ? AND id = ? AND phase = 'promoting' AND revision = ?").run(actor,tenant,id,revision).changes === 1; },
+    endFailed(tenant: string, id: string) { return getDb().prepare("UPDATE hrm_pilot_rollouts SET phase = 'complete', lease_until = NULL WHERE tenant_id = ? AND id = ? AND phase = 'testing'").run(tenant,id).changes === 1; },
+    unlock(tenant: string, id: string, revision: number) { getDb().prepare("UPDATE hrm_pilot_rollouts SET phase = 'testing', lease_until = NULL WHERE tenant_id = ? AND id = ? AND phase = 'promoting' AND revision = ?").run(tenant,id,revision); },
+  };
+}
diff --git a/lib/hrm/pilot-types.ts b/lib/hrm/pilot-types.ts
new file mode 100644
index 000000000..7837a6042
--- /dev/null
+++ b/lib/hrm/pilot-types.ts
@@ -0,0 +1,12 @@
+import type { InstallCounts } from './install-status';
+export interface PilotRollout {
+  id: string; tenant_id: string; winget_id: string; display_name: string; group_id: string; group_name: string;
+  previous_app_id: string; previous_version: string; job_id: string | null; phase: 'starting' | 'testing' | 'promoting' | 'complete';
+  revision: number; lease_until: string | null; created_at: string; approved_by: string | null;
+}
