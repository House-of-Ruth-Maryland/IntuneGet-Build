@@ -0,0 +1,91 @@
+import { NextRequest, NextResponse } from 'next/server';
+import { parseAccessToken } from '@/lib/auth-utils';
+import { getDatabase, isSqliteMode } from '@/lib/db';
+import { getFeatureFlags } from '@/lib/features';
+import { isGitHubActionsConfigured, getWorkflowRun } from '@/lib/github-actions';
+import { getServicePrincipalToken } from '@/lib/intune/graph-client';
+import { updateOne } from '@/lib/hrm/manual-update';
+import { isCustomAppId } from '@/lib/hrm/new-version';
+import { GUID, summarizeAssignments } from '@/lib/hrm/app-insights';
+import { updateWindowFor } from '@/lib/hrm/update-gate';
+import { pilotGraph, PilotError, previewPilot, promotionToken } from '@/lib/hrm/pilot-graph';
+export const maxDuration = 120;
+const reply = (body: unknown, status = 200) => NextResponse.json(body, { status, headers: { 'Cache-Control': 'private, no-store' } });
+export async function GET(request: NextRequest) {
+  const user = await parseAccessToken(request.headers.get('Authorization'));
+  if (!user) return reply({ error: 'Authentication required' },401);
+  if (!isSqliteMode() || getFeatureFlags().localPackager || !isGitHubActionsConfigured()) return reply({ supported: false, pilots: [] });
+  const { sqlitePilotRollouts } = await import('@/lib/db/sqlite');
+  return reply({ supported: true, pilots: sqlitePilotRollouts.list(user.tenantId) });
+}
+export async function POST(request: NextRequest) {
+  const user = await parseAccessToken(request.headers.get('Authorization'));
+  if (!user) return reply({ error: 'Authentication required' },401);
+  if (!isSqliteMode() || getFeatureFlags().localPackager || !isGitHubActionsConfigured()) return reply({ error: 'Pilot rollout requires this server’s SQLite and GitHub packaging mode.' },409);
+  const body = await request.json().catch(() => null);
+  if (!body || !['start','preview','approve','endFailed'].includes(body.action)) return reply({ error: 'Invalid action' },400);
+  const { sqlitePilotRollouts: store, sqliteAppInsights } = await import('@/lib/db/sqlite');
+  try {
+    // HRM patch 0030: pilots start and widen only while the update schedule allows updates.
+    if (body.action === 'start' || body.action === 'approve') {
+      const window = await updateWindowFor(user.tenantId);
+      if (!window.open) throw new PilotError(`${window.reason} Pilots can start, and be approved, only while updates are allowed.`);
+    }
+    const token = await getServicePrincipalToken(user.tenantId);
+    if (!token) throw new PilotError('Could not connect to Intune.',424);
+    const graph = pilotGraph(token);
+    if (body.action === 'start') {
+      if (typeof body.wingetId !== 'string' || body.wingetId.length > 200 || isCustomAppId(body.wingetId) || typeof body.groupId !== 'string' || typeof body.appId !== 'string' || !GUID.test(body.groupId) || !GUID.test(body.appId)) throw new PilotError('Choose a deployed WinGet or curated app and a pilot security group.',400);
+      const deployment = sqliteAppInsights.tracked(user.tenantId).find((d) => d.wingetId === body.wingetId);
+      if (!deployment || deployment.appId !== body.appId) throw new PilotError('This is no longer the newest deployed copy. Refresh App updates.');
+      if (store.hasSetupProfiles(user.tenantId,deployment.appId)) throw new PilotError('This app has saved New computer setup profiles. Use the ordinary update flow; pilot rollout does not support those profiles yet.');
+      const [group, old, groups] = await Promise.all([graph.group(body.groupId),graph.app(deployment.appId),graph.assignments(deployment.appId)]);
+      if (old.displayVersion !== deployment.version || !summarizeAssignments(groups).some((a) => a.installs)) throw new PilotError('Review the previous copy’s version and groups in Intune first.');
+      const id = crypto.randomUUID();
+      try { store.reserve({ id,tenant_id:user.tenantId,winget_id:body.wingetId,display_name:deployment.displayName,group_id:group.id,group_name:group.name,previous_app_id:deployment.appId,previous_version:deployment.version,created_at:new Date().toISOString() }); }
+      catch { throw new PilotError('A pilot or another deployment is already active for this app.'); }
+      try {
+        const result = await updateOne(getDatabase(),user,{ winget_id:body.wingetId,tenant_id:user.tenantId },false,{ id,groupId:group.id,sourceAppId:deployment.appId,sourceVersion:deployment.version });
+        if (!result.success) { store.releaseUnstarted(user.tenantId,id); throw new PilotError(result.error || 'Pilot could not start. Check Deployments.'); }
+        return reply({ started: true, pilot: store.get(user.tenantId,id) });
+      } catch (error) { store.releaseUnstarted(user.tenantId,id); throw error; }
+    }
+    if (typeof body.id !== 'string' || !GUID.test(body.id)) throw new PilotError('Invalid pilot.',400);
+    const row = store.get(user.tenantId,body.id);
+    if (!row || row.phase === 'complete') throw new PilotError('This pilot is no longer active.');
+    if (body.action === 'endFailed') {
+      const job = row.job_id ? await getDatabase().jobs.getById(row.job_id) : null;
+      if (!job && row.phase === 'starting') {
+        if (Date.now() - Date.parse(row.created_at) < 120000) throw new PilotError('The pilot start may still be running. Wait 2 minutes before ending a stalled start.');
+        store.releaseUnstarted(user.tenantId,row.id);
+        if (store.get(user.tenantId,row.id)) throw new PilotError('The pilot started while you were reviewing it. Refresh its status.');
+        return reply({ended:true});
+      }
+      if (!job || !['failed','cancelled'].includes(job.status)) throw new PilotError('Only a failed or held pilot can be ended.');
+      const heldBeforeDispatch = job.status === 'cancelled' && job.status_message === "Held: the installation test didn't pass" && !job.github_run_id;
+      if (!heldBeforeDispatch) {
+        if (!job.github_run_id || !/^\d+$/.test(job.github_run_id)) throw new PilotError('The packaging workflow has not been confirmed finished. Check Deployments before ending this pilot.');
+        const run = await getWorkflowRun(Number(job.github_run_id));
+        if (run.status !== 'completed' || typeof run.conclusion !== 'string' || run.conclusion === 'success') throw new PilotError('The workflow must finish unsuccessfully before this pilot can be ended.');
+      }
+      if (await graph.hasJobCopy(job.id)) throw new PilotError('A copy from this failed pilot still exists in Intune. Inspect and remove that copy in Intune before ending the pilot.');
+      if (!store.endFailed(user.tenantId,row.id)) throw new PilotError('The pilot changed. Refresh before trying again.');
+      return reply({ ended: true });
+    }
+    if (body.action === 'preview') return reply({ preview: await previewPilot(row,graph) });
+    if (body.confirmed !== true || typeof body.token !== 'string' || !/^[a-f0-9]{64}$/.test(body.token)) throw new PilotError('Review the installation results and confirm the wider groups first.',400);
+    const { oldGroups,newGroups } = await graph.pair(row);
+    if (promotionToken(row,oldGroups,newGroups) !== body.token) throw new PilotError('The groups or rollout changed after your review. Refresh the review before approving.');
+    if (!store.claim(user.tenantId,row.id,row.revision)) throw new PilotError('Another approval is in progress. Refresh shortly.');
+    try {
+      // Copy the reviewed live assignments, including filters, exclusions and settings.
+      // The previous app is deliberately untouched, including on partial failures.
+      await graph.assign(row.new_app_id!,oldGroups);
+      const checked = await graph.pair(row);
+      if (JSON.stringify(summarizeAssignments(checked.newGroups).map((a) => a.key)) !== JSON.stringify(summarizeAssignments(oldGroups).map((a) => a.key)) || JSON.stringify(summarizeAssignments(checked.oldGroups).map((a) => a.key)) !== JSON.stringify(summarizeAssignments(oldGroups).map((a) => a.key))) throw new PilotError('Groups changed during approval. The previous copy still has its groups. Refresh and review again.');
+      if (!store.finish(user.tenantId,row.id,user.userEmail || user.userId,row.revision+1)) throw new PilotError('The approval changed. Refresh its status before retrying.');
+      try { sqliteAppInsights.observe(user.tenantId,{appId:row.new_app_id!,wingetId:row.winget_id,displayName:row.display_name,exists:true,version:row.new_version!,assignments:summarizeAssignments(checked.newGroups),checkedAt:new Date().toISOString()},`Pilot wider rollout approved by ${user.userEmail || 'a staff member'}`,true); } catch { /* Optional activity must not undo a successful approval. */ }
+      return reply({ approved: true });
+    } catch (error) { store.unlock(user.tenantId,row.id,row.revision+1); throw error; }
+  } catch (error) { return reply({ error: error instanceof PilotError ? error.message : 'Could not complete the pilot action. Check Deployments and refresh before retrying.' },error instanceof PilotError ? error.status : 500); }
+}
