@@ -0,0 +1,158 @@
+'use client';
+// HRM patch 0038: retire an app. Change its groups to Uninstall, wait for devices to report it gone,
+// then delete it from Intune. Cancel retiring puts the saved groups back. Counts only, never devices.
+import { useState } from 'react';
+import { Archive } from 'lucide-react';
+import { Button } from '@/components/ui/button';
+import { Dialog, DialogContent, DialogHeader, DialogTitle, DialogDescription, DialogFooter } from '@/components/ui/dialog';
+import { useRetire } from '@/hooks/useRetire';
+import type { RetirePreview } from '@/lib/hrm/retire';
+
+export const RETIRE_LABELS = {
+  open: 'Retire app',
+  confirm: 'I understand this uninstalls the app from these groups',
+  start: 'Uninstall from these groups',
+  startEmpty: 'Start retiring',
+  keep: 'Keep it for now',
+  remove: 'Delete from Intune',
+  force: 'Delete even though computers still report it',
+  cancel: 'Cancel retiring',
+  // HRM patch 0040: a copy added from Discovered apps only to remove the app
+  removing: 'Removing this app',
+} as const;
+
+const when = (iso: string) => new Date(iso).toLocaleString('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' });
+
+export function RetirePanel({ appId, onDeleted }: { appId: string; onDeleted?: () => void }) {
+  const { data, action } = useRetire(appId);
+  const [open, setOpen] = useState(false);
+  const [review, setReview] = useState<RetirePreview | null>(null);
+  const [confirmed, setConfirmed] = useState(false);
+  const [force, setForce] = useState(false);
+  const [confirmDelete, setConfirmDelete] = useState(false);
+  if (!data?.supported) return null;
+  const retirement = data.retirement?.phase === 'uninstalling' ? data.retirement : null;
+
+  if (retirement) {
+    const c = data.counts;
+    const remaining = c ? c.installed + c.pending : null;
+    const ready = remaining === 0;
+    const removal = retirement.purpose === 'removal';
+    return (
+      <div className="rounded-lg border border-status-warning/30 bg-status-warning/5 p-3">
+        <h4 className="text-sm font-semibold text-text-primary mb-1">{removal ? RETIRE_LABELS.removing : 'Retiring this app'}</h4>
+        <p className="text-sm text-text-secondary">
+          {removal
+            ? <>Added from Discovered apps on {when(retirement.startedAt)}, by {retirement.startedBy}, only to uninstall it. Computers in its Uninstall groups that have the app remove it when they check in. Updates and deployments for it are held.</>
+            : <>Since {when(retirement.startedAt)}, by {retirement.startedBy}. Its groups are set to Uninstall, and updates and deployments for it are held.</>}
+        </p>
+        {c ? (
+          <p className="mt-2 text-sm text-text-secondary">
+            Intune reports: {c.installed} still installed · {c.pending} pending · {c.failed} failed · {c.notApplicable + c.other} other.
+            {ready ? ' Computers report it gone, so it can be deleted.' : ' Computers check in over the next hours; refresh to see the latest.'}
+          </p>
+        ) : (
+          <p className="mt-2 text-sm text-text-muted">Couldn&apos;t read the uninstall results from Intune just now.</p>
+        )}
+        {c && c.failed > 0 && <p className="mt-1 text-sm text-status-error">{c.failed === 1 ? '1 computer' : `${c.failed} computers`} failed to uninstall. Check Install results above before deleting.</p>}
+        {action.error && <p role="alert" className="mt-2 text-sm text-status-error">{action.error.message}</p>}
+        {confirmDelete ? (
+          <div className="mt-3 space-y-2">
+            <p className="text-sm text-text-primary">Delete {retirement.displayName} v{retirement.version} from Intune? This can&apos;t be undone. Links from this app to apps it replaces or depends on are removed first.</p>
+            {!ready && (
+              <label className="flex items-start gap-2 text-sm text-text-primary">
+                <input type="checkbox" className="mt-1" checked={force} onChange={(e) => setForce(e.target.checked)} />
+                {RETIRE_LABELS.force}
+              </label>
+            )}
+            <div className="flex gap-2">
+              <Button size="sm" variant="destructive" disabled={action.isPending || (!ready && !force)}
+                onClick={() => action.mutate({ action: 'delete', id: retirement.id, force: !ready && force }, { onSuccess: () => onDeleted?.() })}>
+                {action.isPending ? 'Deleting…' : RETIRE_LABELS.remove}
+              </Button>
+              <Button size="sm" variant="ghost" disabled={action.isPending} onClick={() => { setConfirmDelete(false); setForce(false); }}>{RETIRE_LABELS.keep}</Button>
+            </div>
+          </div>
+        ) : (
+          <div className="mt-3 flex flex-wrap gap-2">
+            <Button size="sm" variant="outline" className="border-overlay/10" disabled={action.isPending} onClick={() => { action.reset(); setConfirmDelete(true); }}>{RETIRE_LABELS.remove}</Button>
+            {!removal && <Button size="sm" variant="ghost" disabled={action.isPending} onClick={() => action.mutate({ action: 'cancel', id: retirement.id })}>
+              {action.isPending ? 'Putting groups back…' : RETIRE_LABELS.cancel}
+            </Button>}
+          </div>
+        )}
+        {removal ? (
+          <p className="mt-3 text-xs text-text-muted">When computers report it gone, delete this copy from Intune. To stop removing the app sooner, delete this copy now: Intune stops uninstalling, and computers that already removed it don&apos;t get it back.</p>
+        ) : <div className="mt-3 text-xs text-text-muted">
+          <p>Cancel retiring puts these groups back, so Required groups install it again:</p>
+          {retirement.savedGroups.length > 0
+            ? <ul className="mt-1 list-disc pl-5">{retirement.savedGroups.map((g) => <li key={g}>{g}</li>)}</ul>
+            : <p className="mt-1">No groups.</p>}
+        </div>}
+      </div>
+    );
+  }
+
+  const openReview = () => {
+    action.reset(); setReview(null); setConfirmed(false); setOpen(true);
+    action.mutate({ action: 'preview' }, { onSuccess: (r) => setReview(r.preview ?? null) });
+  };
+
+  return (
+    <div>
+      <h4 className="text-sm font-semibold text-text-secondary mb-2">{RETIRE_LABELS.open}</h4>
+      <p className="text-sm text-text-secondary">When HRM stops using this app: uninstall it from its groups, then delete it from Intune once computers report it gone.</p>
+      {data.hold ? (
+        <p className="mt-2 text-sm text-status-warning">{data.hold}</p>
+      ) : (
+        <Button variant="outline" size="sm" className="mt-2 border-overlay/10" onClick={openReview}>
+          <Archive className="w-4 h-4 mr-2" />
+          {RETIRE_LABELS.open}
+        </Button>
+      )}
+      <Dialog open={open} onOpenChange={(value) => { if (!action.isPending) setOpen(value); }}>
+        <DialogContent className="max-w-lg">
+          <DialogHeader>
+            <DialogTitle>Retire {review?.displayName ?? 'this app'}</DialogTitle>
+            <DialogDescription>
+              Every group changes to Uninstall, so Intune removes the app from those devices and users. Updates and deployments for it are held until you delete it or cancel.
+            </DialogDescription>
+          </DialogHeader>
+          <div className="space-y-3 px-6 py-4">
+          {action.isPending && !review && <p role="status" className="text-sm text-text-muted">Reading the app and its groups in Intune…</p>}
+          {review && (
+            <div className="space-y-3 text-sm">
+              {review.groups.length === 0 ? (
+                <p className="text-text-secondary">This copy has no groups, so nothing is uninstalled. After you start, you can delete it from Intune.</p>
+              ) : (
+                <>
+                  <p className="text-text-secondary">Now:</p>
+                  <ul className="list-disc pl-5 text-text-primary">{review.groups.map((g) => <li key={g}>{g}</li>)}</ul>
+                  <p className="text-text-secondary">After:</p>
+                  <ul className="list-disc pl-5 text-text-primary">{review.after.map((g) => <li key={g}>{g}</li>)}</ul>
+                </>
+              )}
+              <p className="text-text-muted">This only removes copies installed by IntuneGet. Copies installed another way stay; use Remove from computers in Discovered apps for those. Other copies of the app in Intune are not changed.</p>
+              {review.groups.length > 0 && (
+                <label className="flex items-start gap-2 text-text-primary">
+                  <input type="checkbox" className="mt-1" checked={confirmed} onChange={(e) => setConfirmed(e.target.checked)} />
+                  {RETIRE_LABELS.confirm}
+                </label>
+              )}
+            </div>
+          )}
+          {action.error && <p role="alert" className="text-sm text-status-error">{action.error.message}</p>}
+          </div>
+          {review && (
+            <DialogFooter>
+            <Button variant="destructive" disabled={(review.groups.length > 0 && !confirmed) || action.isPending}
+              onClick={() => action.mutate({ action: 'start', token: review.token, confirmed: true }, { onSuccess: () => setOpen(false) })}>
+              {action.isPending ? 'Changing groups…' : review.groups.length > 0 ? RETIRE_LABELS.start : RETIRE_LABELS.startEmpty}
+            </Button>
+            </DialogFooter>
+          )}
+        </DialogContent>
+      </Dialog>
+    </div>
+  );
+}
diff --git a/components/hrm/RollbackPanel.tsx b/components/hrm/RollbackPanel.tsx
new file mode 100644
index 000000000..908c34332
--- /dev/null
+++ b/components/hrm/RollbackPanel.tsx
@@ -0,0 +1,141 @@
+'use client';
+// HRM patch 0037: go back to the previous version of an app IntuneGet deployed (Inventory app details).
+import { useState } from 'react';
+import Link from 'next/link';
+import { Undo2 } from 'lucide-react';
+import { Button } from '@/components/ui/button';
+import { Dialog, DialogContent, DialogHeader, DialogTitle, DialogDescription, DialogFooter } from '@/components/ui/dialog';
+import { useRollback } from '@/hooks/useRollback';
+import type { RollbackPreview } from '@/lib/hrm/rollback';
+import { RETIRE_HOLD } from '@/lib/hrm/retire-hold';
+
+export const ROLLBACK_LABELS = {
+  section: 'Previous version',
+  open: 'Go back to previous version',
+  confirm: 'I checked the versions and groups',
+  allow: 'Allow again',
+  verify: 'Check installer now',
+} as const;
+
+const when = (iso: string) => new Date(iso).toLocaleString('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' });
+
+export function RollbackPanel({ appId }: { appId: string }) {
+  const { data, action } = useRollback(appId);
+  const [open, setOpen] = useState(false);
+  const [review, setReview] = useState<RollbackPreview | null>(null);
+  const [confirmed, setConfirmed] = useState(false);
+  const [startedJob, setStartedJob] = useState<string | null>(null);
+  if (!data?.supported || data.currentVersion === undefined) return null;
+  const skipped = data.skipped ?? [];
+  if (!data.available && skipped.length === 0) return null;
+
+  const openReview = () => {
+    action.reset(); setReview(null); setConfirmed(false); setStartedJob(null); setOpen(true);
+    action.mutate({ action: 'preview' }, { onSuccess: (r) => setReview(r.preview ?? null) });
+  };
+
+  return (
+    <div>
+      <h4 className="text-sm font-semibold text-text-secondary mb-2">{ROLLBACK_LABELS.section}</h4>
+      {data.available && data.previousVersion && (
+        <>
+          <p className="text-sm text-text-secondary">
+            If v{data.currentVersion} causes problems, go back to v{data.previousVersion}. Devices in this app&apos;s groups uninstall v{data.currentVersion} and install v{data.previousVersion}.
+          </p>
+          {action.error && !open && <p role="alert" className="mt-2 text-sm text-status-error">{action.error.message}</p>}
+          <Readiness data={data} onVerify={() => action.mutate({ action: 'verify' })} busy={action.isPending} />
+          {blocked(data) ? null : data.hold ? (
+            // HRM patch 0038: the retire hold names Inventory, which is where this panel already is.
+            <p className="mt-2 text-sm text-status-warning">{data.hold === RETIRE_HOLD ? 'Going back isn\u2019t available while this app is being retired.' : data.hold}</p>
+          ) : (
+            <Button variant="outline" size="sm" className="mt-2 border-overlay/10" onClick={openReview}>
+              <Undo2 className="w-4 h-4 mr-2" />
+              {ROLLBACK_LABELS.open}
+            </Button>
+          )}
+        </>
+      )}
+      {skipped.map((s) => (
+        <p key={s.version} className="mt-2 text-sm text-text-secondary">
+          Automatic updates skip v{s.version} (staff went back to v{s.rolledBackTo}).{' '}
+          <button className="text-accent-cyan hover:underline disabled:opacity-50" disabled={action.isPending}
+            onClick={() => action.mutate({ action: 'allow', version: s.version })}>{ROLLBACK_LABELS.allow}</button>
+        </p>
+      ))}
+
+      <Dialog open={open} onOpenChange={(value) => { if (!action.isPending) setOpen(value); }}>
+        <DialogContent className="max-w-lg">
+          <DialogHeader>
+            <DialogTitle>Go back to v{data.previousVersion}</DialogTitle>
+            <DialogDescription>
+              IntuneGet deploys v{data.previousVersion} again, from the installer it used before, as a new copy that replaces v{data.currentVersion}.
+              Intune uninstalls v{data.currentVersion} and then installs v{data.previousVersion} on devices in these groups.
+            </DialogDescription>
+          </DialogHeader>
+          {startedJob ? (
+            <div className="space-y-3 px-6 py-4 text-sm text-text-secondary">
+              <p>Going back to v{data.previousVersion} has started. Packaging takes a few minutes, then the groups move to the new copy.</p>
+              <p>Automatic updates skip v{data.currentVersion} from now on. A newer version still updates automatically.</p>
+              <Link className="text-accent-cyan hover:underline" href="/dashboard/uploads">Open Deployments</Link>
+            </div>
+          ) : (
+            <>
+              <div className="space-y-3 px-6 py-4">
+              {action.isPending && !review && <p role="status" className="text-sm text-text-muted">Reading the app and its groups in Intune…</p>}
+              {review && (
+                <div className="space-y-3 text-sm">
+                  <p className="text-text-secondary">These groups move from v{review.currentVersion} to v{review.previousVersion}:</p>
+                  {review.groups.length === 0
+                    ? <p className="text-status-warning">This copy has no groups, so the previous version would install nowhere. Add groups with Save to Intune first.</p>
+                    : <ul className="list-disc pl-5 text-text-primary">{review.groups.map((g) => <li key={g}>{g}</li>)}</ul>}
+                  <p className="text-text-muted">Check v{review.previousVersion} still works for staff, and that a downgrade is safe for this app (some apps keep settings the older version can&apos;t read).</p>
+                  <label className="flex items-start gap-2 text-text-primary">
+                    <input type="checkbox" className="mt-1" checked={confirmed} onChange={(e) => setConfirmed(e.target.checked)} />
+                    {ROLLBACK_LABELS.confirm}
+                  </label>
+                </div>
+              )}
+              {action.error && <p role="alert" className="text-sm text-status-error">{action.error.message}</p>}
+              </div>
+              {review && (
+                <DialogFooter>
+                <Button disabled={!confirmed || action.isPending || review.groups.length === 0}
+                  onClick={() => action.mutate({ action: 'start', token: review.token, previousJobId: review.previousJobId, confirmed: true },
+                    { onSuccess: (r) => setStartedJob(r.jobId ?? 'started') })}>
+                  {action.isPending ? 'Starting…' : `Go back to v${review.previousVersion}`}
+                </Button>
+                </DialogFooter>
+              )}
+            </>
+          )}
+        </DialogContent>
+      </Dialog>
+    </div>
+  );
+}
+
+type Data = NonNullable<ReturnType<typeof useRollback>['data']>;
+/** HRM patch 0039: going back can't work when the previous installer is gone or has changed. */
+const blocked = (data: Data) => data.readiness?.status === 'missing' || data.readiness?.status === 'unsupported' || data.readiness?.checksum === 'mismatch' || data.readiness?.checksum === 'checking';
+
+/** HRM patch 0039: what the last check of the previous installer found. */
+function Readiness({ data, onVerify, busy }: { data: Data; onVerify: () => void; busy: boolean }) {
+  const r = data.readiness;
+  const v = data.previousVersion;
+  if (!r) return <p className="mt-2 text-xs text-text-muted">The v{v} installer hasn&apos;t been checked yet. It is checked at the 3:30 AM and 3:30 PM update checks, Maryland time. {data.canVerify !== false && <button className="text-accent-cyan hover:underline disabled:opacity-50" disabled={busy} onClick={onVerify}>{ROLLBACK_LABELS.verify}</button>}</p>;
+  const verify = r.checksum !== 'checking' && data.canVerify !== false && (
+    <button className="ml-1 text-accent-cyan hover:underline disabled:opacity-50" disabled={busy} onClick={onVerify}>{ROLLBACK_LABELS.verify}</button>
+  );
+  if (r.checksum === 'checking') return <p className="mt-2 text-xs text-text-muted">Checking the v{v} installer&apos;s checksum now. This can take a few minutes. Go back to previous version is hidden until it finishes.</p>;
+  if (r.status === 'unsupported') return <p className="mt-2 text-sm text-status-error">The saved v{v} download link can&apos;t be used. {r.detail} Going back from IntuneGet isn&apos;t possible.</p>;
+  if (r.status === 'missing') return <p className="mt-2 text-sm text-status-error">The v{v} installer no longer downloads. {r.detail} Checked {when(r.checkedAt)}. Going back from IntuneGet isn&apos;t possible. {verify}</p>;
+  if (r.checksum === 'mismatch') return <p className="mt-2 text-sm text-status-error">The v{v} installer has changed since IntuneGet used it, so going back would fail its checksum check. Checked {when(r.checksumCheckedAt!)}. {verify}</p>;
+  return (
+    <p className="mt-2 text-xs text-text-muted">
+      {r.status === 'ready' ? `The v${v} installer still downloads (checked ${when(r.checkedAt)}).` : <span className="text-status-warning">Couldn&apos;t reach the v{v} installer at the last check. {r.detail} The review checks it again before going back.</span>}
+      {r.checksum === 'match' && ` Its checksum matched on ${when(r.checksumCheckedAt!)}.`}
+      {r.checksum === 'unreachable' && r.status === 'ready' && ` The last checksum check couldn\u2019t finish. ${r.detail ?? ''}`}
+      {verify}
+    </p>
+  );
+}
