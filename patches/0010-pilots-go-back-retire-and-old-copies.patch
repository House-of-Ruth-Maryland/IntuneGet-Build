@@ -0,0 +1,76 @@
+// HRM patch 0038: retiring an app.
+import { afterEach, beforeEach, describe, expect, it } from 'vitest';
+import Database from 'better-sqlite3';
+import { runSqliteMigrations } from '@/lib/db/sqlite-migrations';
+import { createRetireStore } from '../retire-store';
+import { retireToken, sameGroups, toUninstallAssignments } from '../retire';
+import type { GraphAssignment } from '../duplicates';
+
+const APP = '11111111-1111-4111-8111-111111111111';
+const G1 = '22222222-2222-4222-8222-222222222222';
+const G2 = '33333333-3333-4333-8333-333333333333';
+const settings = { '@odata.type': '#microsoft.graph.win32LobAppAssignmentSettings', notifications: 'hideAll', installTimeSettings: { deadlineDateTime: '2026-01-01T00:00:00Z' }, restartSettings: { gracePeriodInMinutes: 60 } };
+const row = (intent: string, groupId: string, type = '#microsoft.graph.groupAssignmentTarget'): GraphAssignment => ({ id: `${intent}-${groupId}`, intent, target: { '@odata.type': type, groupId }, settings });
+
+describe('changing groups to Uninstall', () => {
+  it('keeps every target, exclusions included, drops deadlines and keeps notifications', () => {
+    const out = toUninstallAssignments([row('required', G1), row('available', G2, '#microsoft.graph.exclusionGroupAssignmentTarget')]);
+    expect(out).toEqual([
+      { intent: 'uninstall', target: { '@odata.type': '#microsoft.graph.groupAssignmentTarget', groupId: G1 }, settings: { '@odata.type': '#microsoft.graph.win32LobAppAssignmentSettings', notifications: 'hideAll' } },
+      { intent: 'uninstall', target: { '@odata.type': '#microsoft.graph.exclusionGroupAssignmentTarget', groupId: G2 }, settings: { '@odata.type': '#microsoft.graph.win32LobAppAssignmentSettings', notifications: 'hideAll' } },
+    ]);
+  });
+  it('makes one Uninstall row when a group was both Required and Available, and handles All devices', () => {
+    const all = { intent: 'required', target: { '@odata.type': '#microsoft.graph.allDevicesAssignmentTarget' } } as GraphAssignment;
+    const out = toUninstallAssignments([row('required', G1), row('available', G1.toUpperCase()), all]);
+    expect(out).toHaveLength(2);
+    expect(out[1]).toMatchObject({ intent: 'uninstall', settings: { notifications: 'showAll' } });
+  });
+  it('ties a review to the copy, version and groups', () => {
+    const a = retireToken(APP, '1.0', [row('required', G1)]);
+    expect(retireToken(APP.toUpperCase(), '1.0', [{ ...row('required', G1), id: 'other-id' }])).toBe(a);
+    expect(retireToken(APP, '1.1', [row('required', G1)])).not.toBe(a);
+    expect(retireToken(APP, '1.0', [row('required', G2)])).not.toBe(a);
+    expect(sameGroups([row('required', G1)], [{ ...row('required', G1), id: 'x' }])).toBe(true);
+  });
+});
+
+describe('retirement records and holds', () => {
+  let db: Database.Database;
+  let store: ReturnType<typeof createRetireStore>;
+  const base = { id: 'r1', tenant_id: 'tenant', app_id: APP, winget_id: 'Example.App', display_name: 'Example', version: '1.0', saved_assignments: [row('required', G1)], uninstall_assignments: toUninstallAssignments([row('required', G1)]), started_by: 'staff@example.test', started_at: '2026-01-01T00:00:00Z' };
+  const job = (id: string, status = 'queued') => db.prepare(`INSERT INTO packaging_jobs (id,user_id,tenant_id,winget_id,version,display_name,installer_type,installer_url,package_config,status) VALUES (?,'staff','tenant','example.app','2.0','Example','exe','https://example.invalid/app.exe','{}',?)`).run(id, status);
+  beforeEach(() => { db = new Database(':memory:'); runSqliteMigrations(db); store = createRetireStore(() => db); });
+  afterEach(() => db.close());
+
+  it('allows one open retirement per copy and keeps the saved groups', () => {
+    store.reserve(base);
+    expect(() => store.reserve({ ...base, id: 'r2' })).toThrow();
+    expect(store.active('tenant', APP.toUpperCase())).toMatchObject({ id: 'r1', phase: 'starting', saved_assignments: [row('required', G1)] });
+    expect(store.active('other', APP)).toBeNull();
+  });
+  it('refuses to start while a deployment of the app is running', () => {
+    job('running');
+    expect(() => store.reserve(base)).toThrow(/still running/);
+  });
+  it('blocks every new deployment of the app while retiring, and releases it on cancel or delete', () => {
+    store.reserve(base);
+    expect(() => job('blocked')).toThrow(/being retired/);
+    expect(store.holdsFamily('tenant', 'EXAMPLE.APP')).toBe(true);
+    store.started('tenant', 'r1');
+    expect(store.activeAppIds('tenant')).toEqual([APP]);
+    expect(store.finish('tenant', 'r1', 'cancelled', 'staff@example.test')).toBe(true);
+    expect(store.finish('tenant', 'r1', 'deleted', 'staff@example.test')).toBe(false);
+    expect(() => job('allowed')).not.toThrow();
+    expect(store.latest('tenant', APP)).toMatchObject({ phase: 'cancelled', finished_by: 'staff@example.test' });
+  });
+  it('forgets a reservation Intune refused, but never one already uninstalling', () => {
+    store.reserve(base); store.release('tenant', 'r1'); expect(store.latest('tenant', APP)).toBeNull();
+    store.reserve(base); store.started('tenant', 'r1'); store.release('tenant', 'r1'); expect(store.active('tenant', APP)?.phase).toBe('uninstalling');
+  });
+  it('sets every update policy for the app to Ignore after deletion', () => {
+    db.prepare(`INSERT INTO app_update_policies (id,user_id,tenant_id,winget_id,policy_type) VALUES ('p1','staff','tenant','Example.App','auto_update'),('p2','other','tenant','example.app','notify'),('p3','staff','other','Example.App','auto_update')`).run();
+    expect(store.ignoreUpdates('tenant', 'Example.App')).toBe(2);
+    expect(db.prepare("SELECT id FROM app_update_policies WHERE policy_type = 'ignore' ORDER BY id").all()).toEqual([{ id: 'p1' }, { id: 'p2' }]);
+  });
+});
diff --git a/lib/hrm/__tests__/rollback.test.ts b/lib/hrm/__tests__/rollback.test.ts
