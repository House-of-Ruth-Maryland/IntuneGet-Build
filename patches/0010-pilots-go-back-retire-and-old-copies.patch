+    expect(apps.get(V1)!.assignments).toEqual([group(G1)]);
+    expect(createOldCopyStore(() => h.db).kept('tenant')).toEqual([]);
+  });
+
+  it("never deletes a copy another app supersedes, and says so on Home", async () => {
+    apps.set(OTHER, { displayName: 'Other tool', displayVersion: '1.0', assignments: [] });
+    links.set(OTHER, [V1]);
+    const result = await runSqliteOldCopyCleanup({ now: NOW });
+    expect(apps.has(V1)).toBe(true);
+    expect(links.get(OTHER)).toEqual([V1]);
+    expect(result.kept).toBe(1);
+    expect(createOldCopyStore(() => h.db).get('tenant', V1)).toMatchObject({ outcome: 'kept', reason: expect.stringMatching(/Other tool replaces or depends on this copy/) });
+  });
+
+  it('never touches apps added in Intune by hand, even when the newest copy supersedes them', async () => {
+    apps.set(OTHER, { displayName: 'PDF tool', displayVersion: '0.16.0', assignments: [group(G1)] });
