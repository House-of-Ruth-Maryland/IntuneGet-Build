diff --git a/lib/hrm/previous-copies.ts b/lib/hrm/previous-copies.ts
new file mode 100644
index 000000000..47493c6c6
--- /dev/null
+++ b/lib/hrm/previous-copies.ts
@@ -0,0 +1,61 @@
+/**
+ * HRM patch 0054: mark copies IntuneGet has replaced, so Inventory says why an older copy is still there.
+ *
+ * Every update deploys a new Intune copy that replaces the previous one (patch 0024; custom apps from
+ * patch 0050). The previous copy stays in Intune until old-copy cleanup (patch 0042) removes it at an
+ * update check at least 7 days after it was replaced, if it's safe. A copy cleanup is holding for a
+ * person carries its "kept" reason. Built from IntuneGet's own deployment history only: versions and
+ * dates, no Intune reads.
+ */
+import type { UploadHistoryRecord } from '@/lib/db/types';
+import { parseDeployedAt, SETTLE_MS } from '@/lib/hrm/old-copy-cleanup';
+import { REMOVAL_SUFFIX } from '@/lib/hrm/removal';
+import type { PreviousCopy } from '@/lib/hrm/previous-copy-text';
+
+export type { PreviousCopy };
+
+export interface PreviousCopyOptions {
+  /** False when old-copy cleanup never removes this app's copies (turned off, SQLite only, startup apps). */
+  autoRemove: (wingetId: string) => boolean;
+  /** Cleanup's "kept" reasons, by lowercase Intune app ID. */
+  kept: Map<string, string>;
+}
+
+const isRemoval = (name: string | null | undefined) => (name ?? '').toLowerCase().endsWith(REMOVAL_SUFFIX.toLowerCase());
+
+export function findPreviousCopies(history: UploadHistoryRecord[], tenantId: string, options: PreviousCopyOptions): PreviousCopy[] {
+  // One entry per Intune copy (its latest deployment row), per app, in this tenant.
+  const families = new Map<string, Map<string, UploadHistoryRecord>>();
+  for (const row of history) {
+    if (row.intune_tenant_id !== tenantId || !row.intune_app_id || !row.winget_id) continue;
+    const copies = families.get(row.winget_id) ?? new Map<string, UploadHistoryRecord>();
+    const key = row.intune_app_id.toLowerCase();
+    const seen = copies.get(key);
+    if (!seen || parseDeployedAt(row.deployed_at) > parseDeployedAt(seen.deployed_at)) copies.set(key, row);
+    families.set(row.winget_id, copies);
+  }
+
+  const result: PreviousCopy[] = [];
+  for (const [wingetId, copies] of families) {
+    const ordered = [...copies.values()].sort((a, b) =>
+      parseDeployedAt(a.deployed_at) - parseDeployedAt(b.deployed_at) || String(a.id).localeCompare(String(b.id)));
+    // An app being removed (patch 0040) has no previous copies to explain.
+    if (ordered.length < 2 || isRemoval(ordered[ordered.length - 1].display_name)) continue;
+    const auto = options.autoRemove(wingetId);
+    ordered.forEach((copy, i) => {
+      const next = ordered[i + 1];
+      if (!next || isRemoval(copy.display_name)) return;
+      const replaced = parseDeployedAt(next.deployed_at);
+      if (!Number.isFinite(replaced)) return;
+      result.push({
+        appId: copy.intune_app_id,
+        version: copy.version,
+        replacedByVersion: next.version,
+        replacedAt: new Date(replaced).toISOString(),
+        removeAfter: auto ? new Date(replaced + SETTLE_MS).toISOString() : null,
+        kept: auto ? options.kept.get(copy.intune_app_id.toLowerCase()) ?? null : null,
+      });
+    });
+  }
+  return result;
+}
diff --git a/lib/hrm/previous-copy-text.ts b/lib/hrm/previous-copy-text.ts
new file mode 100644
index 000000000..70532aa74
--- /dev/null
+++ b/lib/hrm/previous-copy-text.ts
@@ -0,0 +1,41 @@
+/**
+ * HRM patch 0054: what Inventory says about a copy IntuneGet has replaced (see previous-copies.ts).
+ * No server imports, so the Inventory screens can use it.
+ */
+
+export interface PreviousCopy {
+  appId: string;
+  version: string;
+  /** The version of the copy that replaced this one (the next copy IntuneGet deployed). */
+  replacedByVersion: string;
+  replacedAt: string;
+  /** When cleanup may first remove it; null when cleanup never removes this app's copies. */
+  removeAfter: string | null;
+  /** Why cleanup is holding it for a person, or null. */
+  kept: string | null;
+}
+
+/** A previous copy that cleanup is still due to remove: not also listed with the duplicates (patch 0025). */
+export function waitingForCleanup(copy: Pick<PreviousCopy, 'removeAfter' | 'kept'>): boolean {
+  return copy.removeAfter !== null && copy.kept === null;
+}
+
+const day = (iso: string) => new Date(iso).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
+
+/**
+ * The Inventory label: a title, then short sentences. Patch 0058: a copy cleanup is holding is titled
+ * Kept for review. "Newer copy" rather than "Replaced by", since a second copy deployed on purpose
+ * gets this label too and nothing replaced it.
+ */
+export function previousCopyText(copy: PreviousCopy): string[] {
+  const newer = `v${copy.replacedByVersion}`;
+  const lines = [previousCopyTitle(copy), `Newer copy ${newer} deployed ${day(copy.replacedAt)}.`];
+  if (copy.kept) lines.push(copy.kept);
+  else if (copy.removeAfter) lines.push('IntuneGet removes it 7 days after that if the newest copy installs well and has its groups.');
+  return lines;
+}
+
+/** Patch 0058: the tag and the note's title. */
+export function previousCopyTitle(copy: Pick<PreviousCopy, 'kept'>): string {
+  return copy.kept ? 'Kept for review' : 'Previous copy';
+}
