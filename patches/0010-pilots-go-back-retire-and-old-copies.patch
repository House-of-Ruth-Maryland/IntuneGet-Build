+describe('rules', () => {
+  it('compares target, group, filter and intent, ignoring case and assignment IDs', () => {
+    expect(assignmentKey(group(G1))).toBe(assignmentKey({ ...group(G1.toUpperCase()), id: 'x' }));
+    expect(assignmentKey(group(G1))).not.toBe(assignmentKey(group(G1, 'available')));
+    expect(assignmentKey(group(G1))).not.toBe(assignmentKey(group(G1, 'required', { deviceAndAppManagementAssignmentFilterId: G2, deviceAndAppManagementAssignmentFilterType: 'include' })));
+  });
+  it('needs at least one install and no more than 1 failure in 10', () => {
+    expect(installsSettled(null)).toBe(false);
+    expect(installsSettled({ installed: 0, failed: 0 })).toBe(false);
+    expect(installsSettled({ installed: 9, failed: 1 })).toBe(true);
+    expect(installsSettled({ installed: 8, failed: 2 })).toBe(false);
+  });
+  it('skips a copy the newest one does not supersede, and keeps one with groups the newest lacks', () => {
+    const newest = { assignments: [group(G1)], supersedes: new Set([V1]) };
+    expect(judgeOldCopy({ appId: V1.toUpperCase(), assignments: [group(G1)] }, newest)).toEqual({ action: 'remove' });
+    expect(judgeOldCopy({ appId: V1, assignments: [] }, newest)).toEqual({ action: 'remove' });
+    expect(judgeOldCopy({ appId: V2, assignments: [group(G1)] }, newest)).toEqual({ action: 'skip' });
+    expect(judgeOldCopy({ appId: V1, assignments: [group(G1), group(G2, 'available')] }, newest)).toMatchObject({ action: 'keep', reason: expect.stringMatching(/a group the newest copy doesn't/) });
+  });
+});
+
+describe('removing old copies at the update check', () => {
+  it('removes every older copy in the chain once the newest has settled, oldest first, and keeps the newest', async () => {
+    const result = await runSqliteOldCopyCleanup({ now: NOW });
+    expect(result).toMatchObject({ checked: 1, removed: 3, kept: 0, errors: 0 });
+    expect([...apps.keys()]).toEqual([V4]);
+    expect(apps.get(V4)!.assignments).toEqual([group(G1)]);
+    expect(links.get(V4)).toEqual([]);
+    const deletes = calls.filter((c) => c.startsWith('DELETE'));
+    expect(deletes).toEqual([V1, V2, V3].map((a) => `DELETE /deviceAppManagement/mobileApps/${a}`));
+    // Groups always come off before the delete, and never off the newest copy.
+    expect(calls.filter((c) => c.endsWith('/assign')).every((c) => !c.includes(V4))).toBe(true);
+    const store = createOldCopyStore(() => h.db);
+    expect(store.get('tenant', V1)).toMatchObject({ outcome: 'removed', newest_app_id: V4, newest_version: '0.19.0' });
+    expect(store.kept('tenant')).toEqual([]);
+    // The app's activity timeline says IntuneGet removed it.
+    const activity = createAppInsightsStore(() => h.db).activity('tenant', 'Example.PdfTool');
