+/**
+ * HRM patch 0024: Deploy again on a deployed app replaces it instead of adding a second copy.
+ * The new app supersedes the old one (update), gets the groups chosen in the panel (or, when none
+ * were chosen, the old app's current groups), and the old app's groups are removed so devices
+ * aren't targeted twice.
+ */
+
+const GUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
+
+export function replacementInputs(item: unknown) {
+  const id = (item as { replacesIntuneAppId?: unknown } | null)?.replacesIntuneAppId;
+  if (typeof id !== 'string' || !GUID.test(id)) return {};
+  const assignments = (item as { assignments?: unknown[] }).assignments;
+  return {
+    sourceIntuneAppId: id,
+    carryOverAssignments: !(Array.isArray(assignments) && assignments.length > 0),
+    removeAssignmentsFromPreviousApp: true,
+    autoSupersede: true,
+    supersedenceType: 'update',
+  };
+}
