+
+const job = (overrides: Partial<PackagingJob> = {}) => ({
+  id: 'job-1',
+  status: 'deployed',
+  display_name: 'Example App',
+  winget_id: 'Example.App',
+  version: '1.2.3',
+  architecture: 'x64',
+  publisher: 'Example Publisher',
+  user_email: 'attorney.one@example.test',
+  tenant_id: 'tenant-1',
+  intune_app_url: 'https://intune.example.test/app/1',
+  github_run_url: 'https://github.example.test/run/1',
+  error_message: null,
+  error_stage: null,
+  error_category: null,
+  completed_at: '2026-10-24T20:43:27.000Z',
+  ...overrides,
+}) as PackagingJob;
+
+const failed = (message: string) => job({ status: 'failed', error_message: message, error_stage: 'upload', error_category: 'intune_api' });
+
+describe('deployment webhook formatters', () => {
+  it('builds a completed event with the Intune link', () => {
+    const event = buildDeploymentData(job());
+    expect(event.event_type).toBe('deployment.completed');
+    expect(event.timestamp).toBe('2026-10-24T20:43:27.000Z');
+    expect(event.data).toMatchObject({ winget_id: 'Example.App', deployed_by: 'attorney.one@example.test', intune_app_url: 'https://intune.example.test/app/1', error: null });
+  });
+
+  it('builds a failed event with a truncated error and no Intune link', () => {
+    const event = buildDeploymentData(failed('x'.repeat(500)));
+    expect(event.event_type).toBe('deployment.failed');
+    expect(event.data.intune_app_url).toBeNull();
+    expect(event.data.error).toMatchObject({ stage: 'upload', category: 'intune_api' });
+    expect(event.data.error!.message).toHaveLength(301);
+  });
+
+  it('formats a Teams Adaptive Card, green for deployed and red for failed', () => {
+    const ok = formatDeploymentPayload('teams', job()) as any;
+    expect(ok.type).toBe('message');
+    const card = ok.attachments[0].content;
+    expect(ok.attachments[0].contentType).toBe('application/vnd.microsoft.card.adaptive');
+    expect(card.body[0]).toMatchObject({ text: 'Deployed: Example App 1.2.3', color: 'Good' });
+    expect(card.body[1].facts).toContainEqual({ title: 'Deployed by', value: 'attorney.one@example.test' });
+    expect(card.actions.map((a: any) => a.title)).toEqual(['Open in Intune', 'View GitHub run']);
+
+    const bad = (formatDeploymentPayload('teams', failed('Graph upload timed out')) as any).attachments[0].content;
+    expect(bad.body[0]).toMatchObject({ text: 'Failed: Example App 1.2.3', color: 'Attention' });
+    expect(bad.body[2].text).toBe('Stage: upload · Category: intune_api\nGraph upload timed out');
+    expect(bad.actions.map((a: any) => a.title)).toEqual(['View GitHub run']);
+  });
+
+  it('formats Slack blocks and escapes control characters', () => {
+    const payload = formatDeploymentPayload('slack', job({ winget_id: 'A<B>&C' })) as any;
+    expect(payload.blocks[0].text.text).toBe('Deployed: Example App 1.2.3');
+    expect(payload.blocks[1].fields[0].text).toBe('*App*\nA&lt;B&gt;&amp;C');
+    expect(payload.blocks.at(-1).elements[0].text).toContain('<https://intune.example.test/app/1|Open in Intune>');
+  });
+
+  it('formats a Discord embed coloured by result', () => {
+    const ok = (formatDeploymentPayload('discord', job()) as any).embeds[0];
+    const bad = (formatDeploymentPayload('discord', failed('boom')) as any).embeds[0];
+    expect(ok.url).toBe('https://intune.example.test/app/1');
+    expect(ok.color).not.toBe(bad.color);
+    expect(bad.fields.find((f: any) => f.name === 'Error').value).toContain('boom');
+  });
+
+  it('sends plain JSON to custom webhooks and omits missing links', () => {
+    const payload = formatDeploymentPayload('custom', job({ intune_app_url: null, github_run_url: null })) as any;
+    expect(payload.event_type).toBe('deployment.completed');
+    const card = (formatDeploymentPayload('teams', job({ intune_app_url: null, github_run_url: null })) as any).attachments[0].content;
+    expect(card.actions).toEqual([]);
+  });
+});
diff --git a/lib/webhooks/deployment-formatters.ts b/lib/webhooks/deployment-formatters.ts
new file mode 100644
index 000000000..03477b6eb
--- /dev/null
+++ b/lib/webhooks/deployment-formatters.ts
@@ -0,0 +1,205 @@
+/**
+ * Deployment Result Formatters (HRM patch)
+ * Format one finished packaging job (deployed or failed) for each webhook
+ * platform. Only app details, the deploying staff member, links and the
+ * error summary are sent.
+ */
+
+import type { PackagingJob } from '@/lib/db/types';
+import type { WebhookType } from '@/types/notifications';
+
+export type DeploymentEventType = 'deployment.completed' | 'deployment.failed';
+
+export interface DeploymentWebhookData {
+  event_type: DeploymentEventType;
+  timestamp: string;
+  data: {
+    job_id: string;
+    display_name: string;
+    winget_id: string;
+    version: string;
+    architecture: string | null;
+    publisher: string | null;
+    deployed_by: string | null;
+    tenant_id: string | null;
+    intune_app_url: string | null;
+    github_run_url: string | null;
+    error: { stage: string | null; category: string | null; message: string } | null;
+  };
+}
+
+const ERROR_TEXT_LIMIT = 300;
+const DISCORD_SUCCESS_COLOR = 0x22c55e;
+const DISCORD_FAILURE_COLOR = 0xdc2626;
+
+function truncate(text: string, limit: number): string {
+  return text.length > limit ? `${text.slice(0, limit)}…` : text;
+}
+
+function formatTime(iso: string): string {
+  return `${iso.replace('T', ' ').slice(0, 16)} UTC`;
+}
+
+// Slack mrkdwn treats &, < and > as control characters.
+function escapeSlack(text: string): string {
+  return text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
+}
+
+/**
+ * Build the machine-readable event for a finished job
+ */
+export function buildDeploymentData(job: PackagingJob): DeploymentWebhookData {
+  const failed = job.status === 'failed';
+  return {
+    event_type: failed ? 'deployment.failed' : 'deployment.completed',
+    timestamp: job.completed_at || new Date().toISOString(),
+    data: {
+      job_id: job.id,
+      display_name: job.display_name,
+      winget_id: job.winget_id,
+      version: job.version,
+      architecture: job.architecture,
+      publisher: job.publisher,
+      deployed_by: job.user_email,
+      tenant_id: job.tenant_id,
+      intune_app_url: failed ? null : job.intune_app_url,
+      github_run_url: job.github_run_url,
+      error: failed
+        ? {
+            stage: job.error_stage,
+            category: job.error_category,
+            message: truncate(job.error_message || 'Unknown error', ERROR_TEXT_LIMIT),
+          }
+        : null,
+    },
+  };
+}
+
+function title(event: DeploymentWebhookData): string {
+  const { display_name, version } = event.data;
+  return `${event.event_type === 'deployment.failed' ? 'Failed' : 'Deployed'}: ${display_name} ${version}`;
+}
+
+function facts(event: DeploymentWebhookData): Array<{ title: string; value: string }> {
+  const { data } = event;
+  const list = [
+    { title: 'App', value: data.winget_id },
+    { title: 'Version', value: data.version },
+  ];
+  if (data.architecture) list.push({ title: 'Architecture', value: data.architecture });
+  list.push({ title: 'Deployed by', value: data.deployed_by || 'Unknown' });
+  list.push({ title: 'Time', value: formatTime(event.timestamp) });
+  return list;
+}
+
+function errorLine(event: DeploymentWebhookData): string | null {
+  const error = event.data.error;
+  if (!error) return null;
+  const where = [error.stage && `Stage: ${error.stage}`, error.category && `Category: ${error.category}`]
+    .filter(Boolean)
+    .join(' · ');
+  return where ? `${where}\n${error.message}` : error.message;
+}
+
+function links(event: DeploymentWebhookData): Array<{ label: string; url: string }> {
+  const list: Array<{ label: string; url: string }> = [];
+  if (event.data.intune_app_url) list.push({ label: 'Open in Intune', url: event.data.intune_app_url });
+  if (event.data.github_run_url) list.push({ label: 'View GitHub run', url: event.data.github_run_url });
+  return list;
+}
+
+/**
+ * Format a deployment result for Microsoft Teams (Adaptive Card, as Teams
+ * Workflows expects)
+ */
+export function formatTeamsDeployment(event: DeploymentWebhookData) {
+  const failed = event.event_type === 'deployment.failed';
+  const error = errorLine(event);
+  const body: unknown[] = [
+    { type: 'TextBlock', text: title(event), size: 'Large', weight: 'Bolder', color: failed ? 'Attention' : 'Good', wrap: true },
+    { type: 'FactSet', facts: facts(event) },
+  ];
+  if (error) body.push({ type: 'TextBlock', text: error, wrap: true, color: 'Attention' });
+
+  return {
+    type: 'message',
+    data: event,
+    attachments: [
+      {
+        contentType: 'application/vnd.microsoft.card.adaptive',
+        content: {
+          $schema: 'http://adaptivecards.io/schemas/adaptive-card.json',
+          type: 'AdaptiveCard',
+          version: '1.4',
+          body,
+          actions: links(event).map((link) => ({ type: 'Action.OpenUrl', title: link.label, url: link.url })),
+        },
+      },
+    ],
+  };
+}
+
+/**
+ * Format a deployment result for Slack
+ */
+export function formatSlackDeployment(event: DeploymentWebhookData) {
+  const error = errorLine(event);
+  const blocks: unknown[] = [
+    { type: 'header', text: { type: 'plain_text', text: title(event), emoji: true } },
+    {
+      type: 'section',
+      fields: facts(event).map((fact) => ({ type: 'mrkdwn', text: `*${fact.title}*\n${escapeSlack(fact.value)}` })),
+    },
+  ];
+  if (error) blocks.push({ type: 'section', text: { type: 'mrkdwn', text: `:x: ${escapeSlack(error)}` } });
+  const linkList = links(event);
+  if (linkList.length > 0) {
+    blocks.push({ type: 'context', elements: [{ type: 'mrkdwn', text: linkList.map((link) => `<${link.url}|${link.label}>`).join(' | ') }] });
+  }
+  return { data: event, blocks };
+}
+
+/**
+ * Format a deployment result for Discord
+ */
+export function formatDiscordDeployment(event: DeploymentWebhookData) {
+  const failed = event.event_type === 'deployment.failed';
+  const error = errorLine(event);
+  const fields = facts(event).map((fact) => ({ name: fact.title, value: fact.value, inline: true }));
+  if (error) fields.push({ name: 'Error', value: error, inline: false });
+  const linkList = links(event);
+  if (linkList.length > 0) {
+    fields.push({ name: 'Links', value: linkList.map((link) => `[${link.label}](${link.url})`).join(' | '), inline: false });
+  }
+  return {
+    data: event,
+    embeds: [
+      {
+        title: title(event),
+        url: event.data.intune_app_url || undefined,
+        color: failed ? DISCORD_FAILURE_COLOR : DISCORD_SUCCESS_COLOR,
+        fields,
+        footer: { text: 'IntuneGet' },
+        timestamp: event.timestamp,
+      },
+    ],
+  };
+}
+
+/**
+ * Format a finished job for the given webhook type
+ */
+export function formatDeploymentPayload(webhookType: WebhookType, job: PackagingJob): unknown {
+  const event = buildDeploymentData(job);
+  switch (webhookType) {
+    case 'slack':
+      return formatSlackDeployment(event);
+    case 'teams':
+      return formatTeamsDeployment(event);
+    case 'discord':
+      return formatDiscordDeployment(event);
+    case 'custom':
+    default:
+      return event;
+  }
+}
