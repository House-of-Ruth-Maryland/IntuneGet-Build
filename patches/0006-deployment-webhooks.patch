+import { NextRequest } from 'next/server';
+import { beforeEach, describe, expect, it, vi } from 'vitest';
+
+const mocks = vi.hoisted(() => ({ getById: vi.fn(), update: vi.fn(), notify: vi.fn() }));
+vi.mock('@/lib/db', () => ({
+  getDatabase: () => ({ jobs: { getById: mocks.getById, update: mocks.update }, uploadHistory: { create: vi.fn().mockResolvedValue({}) } }),
+}));
+vi.mock('@/lib/callback-signature', () => ({ verifyCallbackSignature: () => true }));
+vi.mock('@/lib/msp/batch-orchestrator', () => ({ onJobCompleted: vi.fn().mockResolvedValue(undefined) }));
+vi.mock('@/lib/auto-update/cleanup', () => ({ handleAutoUpdateJobCompletion: vi.fn().mockResolvedValue(undefined) }));
+vi.mock('@/lib/update-policies/ensure-policy', () => ({ parseCartUpdatePolicy: () => null, ensureUpdatePolicy: vi.fn() }));
+vi.mock('@/lib/installer-preflight', () => ({ quarantineInstaller: vi.fn() }));
+vi.mock('@/lib/notifications/notify-deployment', () => ({ notifyDeploymentWebhooks: mocks.notify }));
+
+import { POST } from './route';
+
+const JOB_ID = '6f1b4f0e-2c1a-4b7e-9f4a-0d3c2b1a0e9f';
+const callback = (body: Record<string, unknown>) =>
+  new NextRequest('http://localhost/api/package/callback', { method: 'POST', body: JSON.stringify({ jobId: JOB_ID, ...body }), headers: { 'X-Signature': 'fixture' } });
+
+beforeEach(() => {
+  vi.clearAllMocks();
+  process.env.CALLBACK_SECRET = 'fixture-secret';
+  mocks.getById.mockResolvedValue({ id: JOB_ID, status: 'uploading', updated_at: '2026-10-24T20:00:00.000Z', package_config: null });
+  mocks.update.mockImplementation(async (_id: string, data: Record<string, unknown>) => ({ id: JOB_ID, ...data }));
+  mocks.notify.mockResolvedValue({ webhooksSent: 1, errors: [] });
+});
+
+describe('package callback deployment webhooks', () => {
+  it('notifies once for a deployed job, with the saved job', async () => {
+    const response = await POST(callback({ status: 'deployed', intuneAppId: 'app-1', intuneAppUrl: 'https://intune.example.test/app/1' }));
+    expect(response.status).toBe(200);
+    expect(mocks.notify).toHaveBeenCalledTimes(1);
+    expect(mocks.notify.mock.calls[0][0]).toMatchObject({ id: JOB_ID, status: 'deployed', intune_app_url: 'https://intune.example.test/app/1' });
+  });
+
+  it('notifies once for a failed job', async () => {
+    await POST(callback({ status: 'failed', message: 'Graph upload timed out', errorStage: 'upload' }));
+    expect(mocks.notify).toHaveBeenCalledTimes(1);
+    expect(mocks.notify.mock.calls[0][0]).toMatchObject({ status: 'failed', error_message: 'Graph upload timed out' });
+  });
+
+  it('does not notify for progress or duplicate_skipped callbacks', async () => {
+    await POST(callback({ status: 'uploading', progress: 50 }));
+    await POST(callback({ status: 'duplicate_skipped', intuneAppId: 'app-1' }));
+    expect(mocks.notify).not.toHaveBeenCalled();
+  });
+
+  it('does not notify again when a finished job gets a repeated callback', async () => {
+    mocks.getById.mockResolvedValue({ id: JOB_ID, status: 'deployed', updated_at: '2026-10-24T20:00:00.000Z', package_config: null });
+    const body = await (await POST(callback({ status: 'deployed', intuneAppId: 'app-1' }))).json();
+    expect(body.ignored).toBe(true);
+    expect(mocks.notify).not.toHaveBeenCalled();
+  });
+
+  it('answers the workflow normally when webhook delivery fails', async () => {
+    mocks.notify.mockRejectedValue(new Error('network down'));
+    const errorLog = vi.spyOn(console, 'error').mockImplementation(() => {});
+    const response = await POST(callback({ status: 'deployed', intuneAppId: 'app-1' }));
+    expect(response.status).toBe(200);
+    expect((await response.json()).success).toBe(true);
+    await new Promise((resolve) => setTimeout(resolve, 0));
+    expect(errorLog).toHaveBeenCalledWith('[Callback] Deployment webhook error:', expect.any(Error));
+    errorLog.mockRestore();
+  });
+});
