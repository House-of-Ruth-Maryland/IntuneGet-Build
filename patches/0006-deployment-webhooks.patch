+import { beforeEach, describe, expect, it, vi } from 'vitest';
+import type { PackagingJob } from '@/lib/db/types';
+import type { WebhookConfiguration } from '@/types/notifications';
+
+const mocks = vi.hoisted(() => ({ deliver: vi.fn(), sqliteMode: vi.fn() }));
+vi.mock('@/lib/webhooks/service', () => ({ deliverFormattedWebhook: mocks.deliver }));
+vi.mock('@/lib/db', () => ({ isSqliteMode: mocks.sqliteMode }));
+
+import { notifyDeploymentWebhooks } from './notify-deployment';
+
+const webhook = (id: string, user: string, type: WebhookConfiguration['webhook_type'] = 'teams') =>
+  ({ id, user_id: user, name: `Hook ${id}`, url: `https://hooks.example.test/${id}`, webhook_type: type, secret: null, headers: {}, is_enabled: true, failure_count: 0 }) as unknown as WebhookConfiguration;
+const job = (status: string) => ({ id: 'job-1', status, display_name: 'Example App', winget_id: 'Example.App', version: '1.0', user_email: 'attorney.one@example.test' }) as PackagingJob;
+const store = (hooks: WebhookConfiguration[]) => ({ listAllEnabled: vi.fn().mockResolvedValue(hooks), recordResult: vi.fn().mockResolvedValue(undefined) });
+
+beforeEach(() => {
+  vi.clearAllMocks();
+  mocks.sqliteMode.mockReturnValue(true);
+  mocks.deliver.mockResolvedValue({ success: true });
+});
+
+describe('notifyDeploymentWebhooks', () => {
+  it('sends to every enabled webhook across users and records each result', async () => {
+    const hooks = [webhook('a', 'user-1'), webhook('b', 'user-2', 'slack')];
+    const s = store(hooks);
+    mocks.deliver.mockResolvedValueOnce({ success: true }).mockResolvedValueOnce({ success: false, error: 'HTTP 404' });
+    const summary = await notifyDeploymentWebhooks(job('deployed'), s);
+    expect(mocks.deliver).toHaveBeenCalledTimes(2);
+    expect(mocks.deliver.mock.calls[0][1]).toMatchObject({ type: 'message' });
+    expect(mocks.deliver.mock.calls[1][1]).toHaveProperty('blocks');
+    expect(s.recordResult).toHaveBeenNthCalledWith(1, 'a', true);
+    expect(s.recordResult).toHaveBeenNthCalledWith(2, 'b', false);
+    expect(summary).toEqual({ webhooksSent: 1, errors: ['Webhook Hook b failed: HTTP 404'] });
+  });
+
+  it('sends failed jobs too', async () => {
+    const s = store([webhook('a', 'user-1')]);
+    await notifyDeploymentWebhooks(job('failed'), s);
+    expect(mocks.deliver).toHaveBeenCalledTimes(1);
+  });
+
+  it('ignores other statuses', async () => {
+    const s = store([webhook('a', 'user-1')]);
+    for (const status of ['duplicate_skipped', 'cancelled', 'packaging']) await notifyDeploymentWebhooks(job(status), s);
+    expect(s.listAllEnabled).not.toHaveBeenCalled();
+    expect(mocks.deliver).not.toHaveBeenCalled();
+  });
+
+  it('does nothing in hosted (Supabase) mode', async () => {
+    mocks.sqliteMode.mockReturnValue(false);
+    expect(await notifyDeploymentWebhooks(job('deployed'))).toEqual({ webhooksSent: 0, errors: [] });
+    expect(mocks.deliver).not.toHaveBeenCalled();
+  });
+});
diff --git a/lib/notifications/notify-deployment.ts b/lib/notifications/notify-deployment.ts
new file mode 100644
index 000000000..c89bb0d29
--- /dev/null
+++ b/lib/notifications/notify-deployment.ts
@@ -0,0 +1,53 @@
+/**
+ * Deployment result webhooks for self-hosted SQLite deployments (HRM patch).
+ *
+ * When a packaging job finishes as deployed or failed, post one message to
+ * every enabled webhook on this server, whoever owns it, so a shared channel
+ * sees every deployment. SQLite mode has no tenant table, so "every webhook"
+ * assumes the server serves one Intune tenant.
+ */
+
+import { isSqliteMode } from '@/lib/db';
+import type { PackagingJob } from '@/lib/db/types';
+import type { sqliteWebhooks as SqliteWebhooks } from '@/lib/db/sqlite';
+import { formatDeploymentPayload } from '@/lib/webhooks/deployment-formatters';
+import { deliverFormattedWebhook } from '@/lib/webhooks/service';
+
+export type DeploymentWebhookStore = Pick<typeof SqliteWebhooks, 'listAllEnabled' | 'recordResult'>;
+
+export interface DeploymentNotifySummary {
+  webhooksSent: number;
+  errors: string[];
+}
+
+/**
+ * Send a finished job to every enabled webhook. Hosted (Supabase) mode is
+ * left to upstream's MSP deployment events.
+ */
+export async function notifyDeploymentWebhooks(
+  job: PackagingJob,
+  store?: DeploymentWebhookStore
+): Promise<DeploymentNotifySummary> {
+  const summary: DeploymentNotifySummary = { webhooksSent: 0, errors: [] };
+  if (job.status !== 'deployed' && job.status !== 'failed') return summary;
+
+  if (!store) {
+    if (!isSqliteMode()) return summary;
+    store = (await import('@/lib/db/sqlite')).sqliteWebhooks;
+  }
+
+  for (const webhook of await store.listAllEnabled()) {
+    const result = await deliverFormattedWebhook(webhook, formatDeploymentPayload(webhook.webhook_type, job));
+    await store.recordResult(webhook.id, result.success);
+    if (result.success) {
+      summary.webhooksSent++;
+    } else {
+      summary.errors.push(`Webhook ${webhook.name} failed: ${result.error}`);
+    }
+  }
+
+  if (summary.errors.length > 0) {
+    console.warn(`[Deployment webhooks] ${summary.errors.length} delivery error(s) for job ${job.id}`, summary.errors);
+  }
+  return summary;
+}
