index 000000000..1853c2710
--- /dev/null
+++ b/app/api/status-report/route.ts
@@ -0,0 +1,73 @@
+// HRM patch: protected by STATUS_REPORT_KEY alone; the report path bypasses sign-in.
+import { createHash } from 'node:crypto';
+import { NextRequest, NextResponse } from 'next/server';
+import { readReportCounts, readReportServerStatus } from '@/lib/hrm/status-report-data';
+import { buildStatusReport, degradedReport, reportKeyMatches, type StatusReport } from '@/lib/hrm/status-report';
+import { serverHttpsOrigin } from '@/lib/hrm/site';
+import { adminAccessState } from '@/lib/hrm/admin-access';
+
+export const dynamic = 'force-dynamic';
+export const runtime = 'nodejs';
+const CACHE_MS = 60_000;
+const BUILD_MS = 2_250; // Leave headroom inside the dashboard contract's three-second budget.
+interface Cache {
+  key: string;
+  attemptedAt: number;
+  report?: StatusReport;
+  lastGood?: StatusReport;
+  pending?: Promise<StatusReport>;
+}
+let cache: Cache | undefined;
+
+async function rebuild(entry: Cache, now: Date): Promise<StatusReport> {
+  const controller = new AbortController();
+  let timer: ReturnType<typeof setTimeout> | undefined;
+  try {
+    const work = Promise.resolve().then(async () => {
+      const [server, counts] = await Promise.all([
+        readReportServerStatus(controller.signal, now),
+        readReportCounts(controller.signal, now),
+      ]);
+      // HRM patch 0036: same address as webhook links. Patch 0058: a to-do while sign-in isn't limited.
+      return buildStatusReport({ server, counts, jobs: [], deploys: [], origin: serverHttpsOrigin(), appAccess: adminAccessState(), now });
+    });
+    const deadline = new Promise<StatusReport>(resolve => {
+      timer = setTimeout(() => {
+        // Keep the original generatedAt when serving older numbers.
+        resolve(entry.lastGood ?? degradedReport(now));
+        controller.abort();
+      }, BUILD_MS);
+    });
+    entry.report = await Promise.race([work, deadline]);
+    if (!controller.signal.aborted && entry.report.health !== 'down') entry.lastGood = entry.report;
+  } catch {
+    entry.report = degradedReport(now);
+  } finally {
+    if (timer) clearTimeout(timer);
+    controller.abort();
+  }
+  return entry.report;
+}
+
+export async function GET(request: NextRequest) {
+  const authorization = request.headers.get('authorization');
+  // Invalid credentials never touch the cache or consume an authenticated request's allowance.
+  if (!reportKeyMatches(authorization, process.env.STATUS_REPORT_KEY)) {
+    return new NextResponse(null, { status: 401, headers: { 'Cache-Control': 'no-store' } });
+  }
+  try {
+    const key = createHash('sha256').update(process.env.STATUS_REPORT_KEY!).digest('hex');
+    const now = new Date();
+    if (!cache || cache.key !== key) cache = { key, attemptedAt: -Infinity };
+    const entry = cache;
+    if (!entry.pending && now.getTime() - entry.attemptedAt >= CACHE_MS) {
+      entry.attemptedAt = now.getTime();
+      entry.pending = rebuild(entry, now).finally(() => { entry.pending = undefined; });
+    }
+    const report = await (entry.pending ?? entry.report ?? degradedReport(now));
+    return NextResponse.json(report, { headers: { 'Cache-Control': 'no-store' } });
+  } catch {
+    // Includes factory/setup, malformed status, query, build and serialization failures. Never log errors or keys.
+    return NextResponse.json(degradedReport(), { headers: { 'Cache-Control': 'no-store' } });
+  }
+}
