+    await expect(getApp(context({}, 404), APP)).rejects.toMatchObject({ status: 404 });
+    await expect(getApp(context(graphApp(APP, 'Store app', { '@odata.type': '#microsoft.graph.winGetApp' })), APP)).rejects.toMatchObject({ status: 404 });
+    await expect(getApp(context(graphApp(APP2, 'Other')), APP)).rejects.toMatchObject({ status: 404 });
