+'use client';
+
+// HRM patch 0056: shown instead of the dashboard when the signed-in user isn't in HRM's IT admins
+// group, or when the server couldn't check.
+// HRM patch 0058 (David's choice 5B): the page says which account is signed in and offers Sign in with
+// another account, since the usual cause is the wrong account. The API keeps its own fixed message.
+
+import { Lock, RefreshCw, LogOut, UserRound } from 'lucide-react';
+import { Button } from '@/components/ui/button';
+
+export const HRM_SUPPORT_URL = 'https://support.hruthmd.org';
+
+function SupportLink() {
+  return (
+    <a href={HRM_SUPPORT_URL} target="_blank" rel="noopener noreferrer" className="text-accent-cyan underline-offset-2 hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-cyan rounded">
+      HRM Support<span className="sr-only"> (opens in a new tab)</span>
+    </a>
+  );
+}
+
+export function AccessDenied({ unavailable, account, onRetry, onSwitchAccount, onSignOut }: {
+  unavailable?: boolean;
+  /** The signed-in account's email, shown so staff can tell they used the wrong one. */
+  account?: string | null;
+  onRetry: () => void;
+  onSwitchAccount: () => void;
+  onSignOut: () => void;
+}) {
+  return (
+    <main className="min-h-screen flex items-center justify-center bg-bg-deepest px-4">
+      <section aria-labelledby="access-denied-title" className="glass-light rounded-xl p-6 max-w-md w-full text-center">
+        <Lock className="w-8 h-8 text-status-warning mx-auto mb-3" aria-hidden="true" />
+        <h1 id="access-denied-title" className="text-lg font-semibold text-text-primary">
+          {unavailable ? "Couldn't check your access" : 'No access to IntuneGet'}
+        </h1>
+        <p className="text-sm text-text-secondary mt-2">
+          {unavailable
+            ? <>Try again in a minute. If this keeps happening, tell <SupportLink />.</>
+            : <>Ask <SupportLink /> to add you to the IT admins group.</>}
+        </p>
+        {account && <p className="text-sm text-text-muted mt-3" data-testid="access-denied-account">Signed in as <span className="font-medium text-text-primary break-all">{account}</span></p>}
+        <div className="flex flex-col sm:flex-row sm:flex-wrap gap-2 justify-center mt-5">
+          {unavailable && (
+            <Button onClick={onRetry} className="focus-visible:ring-2 focus-visible:ring-accent-cyan">
+              <RefreshCw className="w-4 h-4 mr-2" aria-hidden="true" />
+              Try again
+            </Button>
+          )}
+          <Button variant={unavailable ? 'outline' : 'default'} onClick={onSwitchAccount} className="focus-visible:ring-2 focus-visible:ring-accent-cyan">
+            <UserRound className="w-4 h-4 mr-2" aria-hidden="true" />
+            Sign in with another account
+          </Button>
+          <Button variant="outline" onClick={onSignOut} className="focus-visible:ring-2 focus-visible:ring-accent-cyan">
+            <LogOut className="w-4 h-4 mr-2" aria-hidden="true" />
+            Sign out
+          </Button>
+        </div>
+      </section>
+    </main>
+  );
+}
