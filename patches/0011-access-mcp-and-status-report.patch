@@ -0,0 +1,474 @@
+/**
+ * HRM patch 0055: the read-only API behind HRM's MCP server (contract: IntuneGet-Build docs/mcp-api.md).
+ *
+ * Every answer is built here from fields picked one by one. Never added: staff emails or names,
+ * user IDs, tenant IDs, device names, installer or GitHub URLs, Intune descriptions, or raw error,
+ * status or reason text. Install errors become a normalized code plus HRM's own fixed category.
+ * Nothing here writes to the database or Intune.
+ */
+
+import { getDatabase, isSqliteMode } from '@/lib/db';
+import type { PackagingJob, UploadHistoryRecord, UpdateCheckResult } from '@/lib/db/types';
+import { getServicePrincipalToken } from '@/lib/intune/graph-client';
+import { inventoryPageUrl } from '@/lib/intune/inventory-list';
+import { resolveAssignmentGroupNames } from '@/lib/intune/assignment-group-names';
+import { compareVersions } from '@/lib/version-compare';
+import type { IntuneAppAssignment, IntuneWin32App } from '@/types/inventory';
+import { readTenantAttention } from './attention';
+import { effectiveCurrentVersion } from './deployed-version-sync';
+import { readServerStatus, type ServerStatus } from './home';
+import { installErrorGuidance, normalizeInstallCode } from './install-error-guidance';
+import type { InstallError, InstallStatusRecord } from './install-status';
+import { safeVersion } from './status-report';
+import { DAY_NAMES, UPDATE_TIME_ZONE, updateWindowState } from './update-window';
+
+/** A request the API answers with an empty body and this status. */
+export class McpError extends Error {
+  constructor(readonly status: 400 | 404 | 503) { super('MCP request failed'); }
+}
+
+export interface McpContext {
+  tenantId: string;
+  signal: AbortSignal;
+  now: Date;
+  graphToken?: (tenantId: string) => Promise<string | null>;
+  fetchImpl?: typeof fetch;
+}
+
+const GUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
+const GRAPH = 'https://graph.microsoft.com/beta/deviceAppManagement/mobileApps';
+
+// ---------- small, strict text helpers ----------
+
+/** Plain text without control characters, cut to max characters. */
+export function clean(value: unknown, max = 200): string | null {
+  if (typeof value !== 'string') return null;
+  const text = value.replace(/[\u0000-\u001f\u007f-\u009f\u2028\u2029]+/g, ' ').trim();
+  return text ? text.slice(0, max) : null;
+}
+/** An ISO timestamp, or null for anything that isn't a time. */
+export function isoTime(value: unknown): string | null {
+  if (typeof value !== 'string' || value.length > 40) return null;
+  const at = Date.parse(value);
+  return Number.isFinite(at) ? new Date(at).toISOString() : null;
+}
+const GENERIC_GUIDANCE = installErrorGuidance('').title;
+/** Install error code (0x hex) and HRM's fixed category for known codes. Intune's description is never used. */
+export function errorView(errors: InstallError[], max: number) {
+  const merged = new Map<string, { code: string; category: string | null; count: number }>();
+  for (const error of errors) {
+    const code = normalizeInstallCode(String(error.code ?? '')) ?? 'other';
+    const title = code === 'other' ? null : installErrorGuidance(code).title;
+    const entry = merged.get(code) ?? { code, category: title && title !== GENERIC_GUIDANCE ? title : null, count: 0 };
+    entry.count += Number.isSafeInteger(error.count) && error.count > 0 ? error.count : 0;
+    merged.set(code, entry);
+  }
+  return [...merged.values()].sort((a, b) => b.count - a.count).slice(0, max);
+}
+const JOB_STATUSES = new Set(['queued', 'packaging', 'uploading', 'deployed', 'failed', 'cancelled', 'awaiting_qa', 'qa_failed', 'duplicate_skipped']);
+export const MCP_JOB_STATUSES = [...JOB_STATUSES];
+const jobStatus = (value: unknown) => (typeof value === 'string' && JOB_STATUSES.has(value) ? value : 'other');
+const ERROR_CODE = /^[A-Z][A-Z0-9_]{1,39}$/;
+const ERROR_CATEGORY = /^[a-z][a-z_]{1,29}$/;
+
+// ---------- query parameters ----------
+
+function intParam(query: URLSearchParams, name: string, fallback: number, min: number, max: number): number {
+  const raw = query.get(name);
+  if (raw === null || raw === '') return fallback;
+  if (!/^\d{1,4}$/.test(raw)) throw new McpError(400);
+  const n = Number(raw);
+  if (n < min || n > max) throw new McpError(400);
+  return n;
+}
+function boolParam(query: URLSearchParams, name: string): boolean {
+  const raw = query.get(name);
+  if (raw === null || raw === '' || raw === 'false') return false;
+  if (raw === 'true') return true;
+  throw new McpError(400);
+}
+
+// ---------- GET /status ----------
+
+const CHECK_ORDER = ['deploy', 'offsiteBackup', 'disk', 'updateCheck', 'notifications', 'tunnel', 'tunnelUpdate', 'intuneReads', 'intuneSelfTest', 'scheduledUpdates', 'versionSync'] as const;
+type CheckState = 'ok' | 'warning' | 'failed' | 'unknown';
+
+export function serverStatusView(server: ServerStatus) {
+  if (!server.reported) {
+    return {
+      health: 'unknown' as const, statusFile: server.reason, version: null, generatedAt: isoTime(server.generatedAt),
+      lastUpdateCheckAt: null, lastBackupAt: null, lastOffsiteBackupAt: null, checks: [],
+    };
+  }
+  const run = (result: string | null | undefined): CheckState => (!result ? 'unknown' : result === 'success' ? 'ok' : 'failed');
+  const generated = isoTime(server.generatedAt);
+  const checks: Array<{ name: string; state: CheckState; checkedAt: string | null }> = [];
+  for (const name of CHECK_ORDER) {
+    let state: CheckState;
+    let at: unknown = server.generatedAt;
+    switch (name) {
+      case 'deploy':
+        state = !server.lastDeploy ? 'unknown' : server.problems.includes('deploy') ? 'failed' : 'ok';
+        at = server.lastDeploy?.time;
+        break;
+      case 'offsiteBackup':
+        if (server.offsiteBackup === undefined) continue; // not set up on this server
+        state = server.problems.includes('offsiteBackup') ? 'failed' : 'ok';
+        at = server.offsiteBackup?.at;
+        break;
+      case 'disk': state = server.diskWarning ? 'warning' : 'ok'; break;
+      case 'updateCheck': state = run(server.updateCheck?.result); at = server.updateCheck?.at; break;
+      case 'notifications': state = run(server.notifications?.result); at = server.notifications?.at; break;
+      case 'tunnel': state = server.tunnel?.running ? 'ok' : 'failed'; break;
+      case 'tunnelUpdate': state = run(server.tunnel?.lastUpdate?.result); at = server.tunnel?.lastUpdate?.at; break;
+      default: {
+        const check = server.checks?.[name];
+        state = !check ? 'unknown' : check.ok ? 'ok' : 'failed';
+        at = check?.at;
+      }
+    }
+    checks.push({ name, state, checkedAt: isoTime(at) });
+  }
+  return {
+    health: server.problems.length > 0 ? ('degraded' as const) : ('ok' as const),
+    version: safeVersion(server.version),
+    generatedAt: generated,
+    lastUpdateCheckAt: isoTime(server.updateCheck?.at),
+    lastBackupAt: isoTime(server.lastBackup?.at),
+    lastOffsiteBackupAt: isoTime(server.offsiteBackup?.at),
+    diskPercentUsed: Math.max(0, Math.min(100, Math.round(server.diskRatio * 100))),
+    checks,
+  };
+}
+
+// ---------- GET /attention and /install-failures ----------
+
+export function attentionView(data: Awaited<ReturnType<typeof readTenantAttention>>) {
+  const name = (value: string) => clean(value) ?? 'Unnamed app';
+  return {
+    counts: {
+      ...(data.attention ? { failedJobsLast7Days: data.attention.failedRecent, stuckJobs: data.attention.stuck } : {}),
+      appsWithInstallFailures: data.installFailures.length,
+      appsNotReached: data.unreached.length,
+      rollbackGaps: data.rollbackGaps.length,
+      oldCopiesKept: data.oldCopiesKept.length,
+    },
+    installFailures: data.installFailures.slice(0, 50).map((a) => ({ appName: name(a.displayName), intuneAppId: a.intuneAppId, failed: a.failed })),
+    unreached: data.unreached.slice(0, 50).map((a) => ({ appName: name(a.displayName), intuneAppId: a.intuneAppId, deployedAt: isoTime(a.deployedAt) })),
+    rollbackGaps: data.rollbackGaps.slice(0, 50).map((a) => ({ appName: name(a.displayName), intuneAppId: a.intuneAppId, previousVersion: clean(a.previousVersion, 60) })),
+    // The reason text is left out: it can hold Intune's own error text.
+    oldCopiesKept: data.oldCopiesKept.slice(0, 50).map((a) => ({ appName: name(a.displayName), intuneAppId: a.intuneAppId, version: clean(a.version, 60), newestAppId: a.newestAppId })),
+  };
+}
+
+export function installFailuresView(data: Awaited<ReturnType<typeof readTenantAttention>>, limit: number, now: Date) {
+  const failing = data.installs
+    .filter((a) => a.failed > 0 && !data.retiring.has(a.intune_app_id.toLowerCase()))
+    .sort((a, b) => b.failed - a.failed);
+  return {
+    apps: failing.slice(0, limit).map((a) => ({
+      appName: clean(a.display_name) ?? 'Unnamed app', intuneAppId: a.intune_app_id, failed: a.failed,
+      checkedAt: isoTime(a.checked_at), topErrors: errorView(a.topErrors ?? [], 5),
+    })),
+    total: failing.length,
+    generatedAt: now.toISOString(),
+  };
+}
+
+// ---------- GET /apps and /apps/{id} ----------
+
+function appSummary(app: Pick<IntuneWin32App, 'id' | 'displayName' | 'displayVersion' | 'publisher' | 'createdDateTime' | 'lastModifiedDateTime'>, wingetId: string | null) {
+  return {
+    intuneAppId: app.id,
+    displayName: clean(app.displayName) ?? 'Unnamed app',
+    version: clean(app.displayVersion, 60),
+    publisher: clean(app.publisher),
+    wingetId: clean(wingetId),
+    createdAt: isoTime(app.createdDateTime),
+    modifiedAt: isoTime(app.lastModifiedDateTime),
+  };
+}
+
+async function tenantHistory(tenantId: string): Promise<UploadHistoryRecord[]> {
+  return (await getDatabase().uploadHistory.listAll(2000)).filter((r) => r.intune_tenant_id === tenantId);
+}
+function wingetIds(history: UploadHistoryRecord[]): Map<string, string> {
+  const ids = new Map<string, string>();
+  for (const r of history) if (r.intune_app_id && !ids.has(r.intune_app_id.toLowerCase())) ids.set(r.intune_app_id.toLowerCase(), r.winget_id);
+  return ids;
+}
+
+async function token(ctx: McpContext): Promise<string> {
+  const value = await (ctx.graphToken ?? getServicePrincipalToken)(ctx.tenantId).catch(() => null);
+  if (!value) throw new McpError(503);
+  return value;
+}
+
+const MAX_PAGES = 20;
+const INVENTORY_CACHE_MS = 60_000;
+// The shared read has its own time limit: it never uses one request's signal, so one caller going
+// away can't fail the others waiting on the same read. Each request still keeps its own deadline.
+const INVENTORY_READ_MS = 6_000;
+let inventoryCache: { tenantId: string; at: number; apps: Promise<ReturnType<typeof appSummary>[]> } | undefined;
+
+/** Every Win32 app in the tenant (up to 2,000), cached for a minute. */
+async function readInventory(ctx: McpContext) {
+  if (inventoryCache && inventoryCache.tenantId === ctx.tenantId && ctx.now.getTime() - inventoryCache.at < INVENTORY_CACHE_MS) {
+    return inventoryCache.apps;
+  }
+  const apps = (async () => {
+    const graphToken = await token(ctx);
+    const fetchImpl = ctx.fetchImpl ?? fetch;
+    const signal = AbortSignal.timeout(INVENTORY_READ_MS);
+    const raw: IntuneWin32App[] = [];
+    let cursor: string | null = null;
+    for (let page = 0; page < MAX_PAGES; page++) {
+      const response = await fetchImpl(inventoryPageUrl(cursor), { headers: { Authorization: `Bearer ${graphToken}` }, cache: 'no-store', signal });
+      if (!response.ok) { await response.body?.cancel().catch(() => {}); throw new McpError(503); }
+      const data = await response.json() as { value?: IntuneWin32App[]; '@odata.nextLink'?: string };
+      raw.push(...(data.value ?? []));
+      cursor = data['@odata.nextLink'] ? new URL(data['@odata.nextLink']).searchParams.get('$skiptoken') : null;
+      if (!cursor) break;
+    }
+    const ids = wingetIds(await tenantHistory(ctx.tenantId).catch(() => []));
+    return raw.filter((a) => typeof a?.id === 'string' && GUID.test(a.id)).map((a) => appSummary(a, ids.get(a.id.toLowerCase()) ?? null));
+  })();
+  inventoryCache = { tenantId: ctx.tenantId, at: ctx.now.getTime(), apps };
+  // A failed read is never cached.
+  apps.catch(() => { if (inventoryCache?.apps === apps) inventoryCache = undefined; });
+  return apps;
+}
+export function resetMcpInventoryCache() { inventoryCache = undefined; }
+
+export async function listApps(ctx: McpContext, query: URLSearchParams) {
+  const search = (query.get('search') ?? '').trim().toLowerCase();
+  if (search.length > 100) throw new McpError(400);
+  const limit = intParam(query, 'limit', 50, 1, 100);
+  const cursorText = query.get('cursor') ?? '';
+  if (cursorText && !/^\d{1,5}$/.test(cursorText)) throw new McpError(400);
+  const offset = cursorText ? Number(cursorText) : 0;
+  const apps = (await readInventory(ctx)).filter((a) => !search
+    || [a.displayName, a.publisher, a.wingetId].some((field) => field?.toLowerCase().includes(search)));
+  const page = apps.slice(offset, offset + limit);
+  return { apps: page, total: apps.length, nextCursor: offset + limit < apps.length ? String(offset + limit) : null };
+}
+
+const INTENTS = new Set(['required', 'available', 'uninstall']);
+function assignmentView(assignment: IntuneAppAssignment, names: Record<string, string>) {
+  const type = assignment.target?.['@odata.type'] ?? '';
+  const group = typeof assignment.target?.groupId === 'string' ? names[assignment.target.groupId.toLowerCase()] : undefined;
+  const label = type === '#microsoft.graph.allDevicesAssignmentTarget' ? 'All devices'
+    : type === '#microsoft.graph.allLicensedUsersAssignmentTarget' ? 'All users'
+      : clean(group) ?? 'Group name not available';
+  const intent = assignment.intent === 'availableWithoutEnrollment' ? 'available' : INTENTS.has(assignment.intent) ? assignment.intent : 'unknown';
+  // An exclusion is said in the label so no reader takes it for an included group.
+  return { groupLabel: type === '#microsoft.graph.exclusionGroupAssignmentTarget' ? `Excluded: ${label}` : label, intent };
+}
+
+export async function getApp(ctx: McpContext, id: string) {
+  if (!GUID.test(id)) throw new McpError(400);
+  const graphToken = await token(ctx);
+  const fetchImpl = ctx.fetchImpl ?? fetch;
+  const headers = { Authorization: `Bearer ${graphToken}` };
+  const [appResponse, assignmentsResponse] = await Promise.all([
+    fetchImpl(`${GRAPH}/${id}`, { headers, cache: 'no-store', signal: ctx.signal }),
+    fetchImpl(`${GRAPH}/${id}/assignments`, { headers, cache: 'no-store', signal: ctx.signal }),
+  ]);
+  if (!appResponse.ok) {
+    await appResponse.body?.cancel().catch(() => {});
+    await assignmentsResponse.body?.cancel().catch(() => {});
+    throw new McpError(appResponse.status === 404 ? 404 : 503);
+  }
+  const app = await appResponse.json() as IntuneWin32App & { '@odata.type'?: string };
+  if ((app['@odata.type'] && app['@odata.type'] !== '#microsoft.graph.win32LobApp') || typeof app.id !== 'string' || app.id.toLowerCase() !== id.toLowerCase()) {
+    await assignmentsResponse.body?.cancel().catch(() => {});
+    throw new McpError(404);
+  }
+  let assignments: IntuneAppAssignment[] = [];
+  if (assignmentsResponse.ok) assignments = ((await assignmentsResponse.json()) as { value?: IntuneAppAssignment[] }).value ?? [];
+  else await assignmentsResponse.body?.cancel().catch(() => {});
+  const groups = await resolveAssignmentGroupNames(assignments, graphToken, ctx.signal).catch(() => ({ names: {} as Record<string, string> }));
+
+  const history = await tenantHistory(ctx.tenantId).catch(() => []);
+  const key = id.toLowerCase();
+  const detail: Record<string, unknown> = {
+    ...appSummary(app, wingetIds(history).get(key) ?? null),
+    assignments: assignments.slice(0, 100).map((a) => assignmentView(a, groups.names)),
+  };
+  if (isSqliteMode()) {
+    const sqlite = await import('@/lib/db/sqlite');
+    const install = (await sqlite.sqliteInstallStatus.listForTenant(ctx.tenantId).catch(() => [] as InstallStatusRecord[]))
+      .find((r) => r.intune_app_id.toLowerCase() === key);
+    if (install) {
+      detail.installCounts = { installed: install.installed, failed: install.failed, pending: install.pending, notApplicable: install.notApplicable, checkedAt: isoTime(install.checked_at) };
+      detail.topErrors = errorView(install.topErrors ?? [], 10);
+    }
+    try {
+      const readiness = sqlite.sqliteRollbackReadiness.get(ctx.tenantId, id);
+      if (readiness) detail.rollbackAvailable = readiness.status === 'ready' && readiness.checksum_status !== 'mismatch';
+    } catch { /* optional */ }
+    try { detail.retirementPhase = sqlite.sqliteRetirements.active(ctx.tenantId, id)?.phase ?? null; } catch { /* optional */ }
+    try {
+      const pilot = sqlite.sqlitePilotRollouts.list(ctx.tenantId)
+        .find((p) => p.phase !== 'complete' && [p.previous_app_id, p.new_app_id].some((a) => a?.toLowerCase() === key));
+      detail.pilotPhase = pilot?.phase ?? null;
+    } catch { /* optional */ }
+  }
+  return detail;
+}
+
+// ---------- GET /updates ----------
+
+export async function listUpdates(ctx: McpContext, query: URLSearchParams) {
+  const includeDismissed = boolParam(query, 'includeDismissed');
+  const db = getDatabase();
+  const history = await tenantHistory(ctx.tenantId);
+  // Detected updates are stored per staff member; read every deployer's rows for this tenant, once each.
+  const users = [...new Set(history.map((r) => r.user_id))].slice(0, 50);
+  const rows = (await Promise.all(users.map((user) => db.updateCheckResults.list(user, { tenantId: ctx.tenantId, includeDismissed })))).flat();
+  const newest = new Map<string, UpdateCheckResult>();
+  for (const row of rows) {
+    if (row.tenant_id !== ctx.tenantId) continue;
+    const id = `${row.winget_id.toLowerCase()}|${row.intune_app_id.toLowerCase()}`;
+    const seen = newest.get(id);
+    if (!seen || row.updated_at > seen.updated_at) newest.set(id, row);
+  }
+  const latestDeployment = new Map<string, UploadHistoryRecord>();
+  for (const r of history) if (!latestDeployment.has(r.winget_id)) latestDeployment.set(r.winget_id, r);
+  const policies = new Map<string, string>();
+  for (const policy of await db.updatePolicies.listAll().catch(() => [])) {
+    if (policy.tenant_id === ctx.tenantId && !policies.has(policy.winget_id)) policies.set(policy.winget_id, policy.policy_type);
+  }
+  const updates = [...newest.values()].flatMap((row) => {
+    const current = effectiveCurrentVersion(row, latestDeployment.get(row.winget_id) ?? null);
+    if (current === 'Unknown' || compareVersions(current, row.latest_version) >= 0) return [];
+    return [{
+      appName: clean(row.display_name) ?? 'Unnamed app',
+      wingetId: clean(row.winget_id),
+      intuneAppId: GUID.test(row.intune_app_id) ? row.intune_app_id : null,
+      currentVersion: clean(current, 60),
+      latestVersion: clean(row.latest_version, 60),
+      policy: policies.get(row.winget_id) ?? null,
+      dismissed: Boolean(row.dismissed_at),
+      detectedAt: isoTime(row.detected_at),
+    }];
+  }).sort((a, b) => a.appName.localeCompare(b.appName)).slice(0, 200);
+  const server = await readServerStatus(ctx.now);
+  return { updates, lastCheckedAt: server.reported ? isoTime(server.updateCheck?.at) : null };
+}
+
+// ---------- GET /update-schedule ----------
+
+const hour = (h: number) => `${String(h).padStart(2, '0')}:00`;
+export async function updateScheduleView(ctx: McpContext) {
+  if (!isSqliteMode()) return { supported: false, paused: false };
+  const { sqliteUpdateSchedule: store } = await import('@/lib/db/sqlite');
+  const schedule = store.get(ctx.tenantId);
+  const blackouts = store.blackouts(ctx.tenantId, ctx.now);
+  const state = updateWindowState(schedule, blackouts, ctx.now);
+  return {
+    supported: true,
+    enabled: schedule.enabled,
+    paused: Boolean(schedule.paused),
+    open: state.open,
+    window: schedule.enabled
+      ? { days: schedule.days.filter((d) => d >= 0 && d <= 6).map((d) => DAY_NAMES[d]), start: hour(schedule.startHour), end: hour(schedule.endHour), timeZone: UPDATE_TIME_ZONE }
+      : { days: [...DAY_NAMES], start: '00:00', end: '24:00', timeZone: UPDATE_TIME_ZONE },
+    blackouts: blackouts.slice(0, 50).map((b) => ({ start: b.startsOn, end: b.endsOn, label: clean(b.label, 60) })),
+    nextRunAt: isoTime(state.nextOpen),
+  };
+}
+
+// ---------- GET /jobs ----------
+
+const JOB_CURSOR = /^(\d{1,15})~([0-9A-Za-z-]{1,64})$/;
+export async function listJobs(ctx: McpContext, query: URLSearchParams) {
+  const status = query.get('status') || null;
+  if (status && !JOB_STATUSES.has(status)) throw new McpError(400);
+  const sinceText = query.get('since') || null;
+  const since = sinceText ? Date.parse(sinceText) : null;
+  if (sinceText && (sinceText.length > 40 || !Number.isFinite(since))) throw new McpError(400);
+  const limit = intParam(query, 'limit', 25, 1, 100);
+  const cursorText = query.get('cursor') || null;
+  const cursor = cursorText ? JOB_CURSOR.exec(cursorText) : null;
+  if (cursorText && !cursor) throw new McpError(400);
+
+  const created = (job: PackagingJob) => { const at = Date.parse(job.created_at); return Number.isFinite(at) ? at : 0; };
+  const jobs = (await getDatabase().jobs.getByTenantId(ctx.tenantId, 500))
+    .filter((job) => job.tenant_id === ctx.tenantId)
+    .filter((job) => !status || job.status === status)
+    .filter((job) => since === null || created(job) >= since)
+    .sort((a, b) => created(b) - created(a) || b.id.localeCompare(a.id))
+    .filter((job) => !cursor || created(job) < Number(cursor[1]) || (created(job) === Number(cursor[1]) && job.id.localeCompare(cursor[2]) < 0));
+  const page = jobs.slice(0, limit);
+  const last = page.at(-1);
+  return {
+    jobs: page.map((job) => ({
+      jobId: job.id,
+      appName: clean(job.display_name) ?? 'Unnamed app',
+      wingetId: clean(job.winget_id),
+      version: clean(job.version, 60),
+      status: jobStatus(job.status),
+      // Codes only, and only on jobs that didn't deploy; error and status messages are never sent.
+      errorCode: job.status !== 'deployed' && typeof job.error_code === 'string' && ERROR_CODE.test(job.error_code) ? job.error_code : null,
+      errorCategory: job.status !== 'deployed' && typeof job.error_category === 'string' && ERROR_CATEGORY.test(job.error_category) ? job.error_category : null,
+      intuneAppId: typeof job.intune_app_id === 'string' && GUID.test(job.intune_app_id) ? job.intune_app_id : null,
+      automatic: Boolean(job.is_auto_update),
+      createdAt: isoTime(job.created_at),
+      completedAt: isoTime(job.completed_at ?? job.cancelled_at),
+    })),
+    nextCursor: jobs.length > limit && last ? `${created(last)}~${last.id}` : null,
+  };
+}
+
+// ---------- GET /pilots ----------
+
+export async function listPilots(ctx: McpContext) {
+  if (!isSqliteMode()) return { pilots: [] };
+  const { sqlitePilotRollouts } = await import('@/lib/db/sqlite');
+  return {
+    pilots: sqlitePilotRollouts.list(ctx.tenantId).slice(0, 100).map((p) => ({
+      pilotId: p.id,
+      appName: clean(p.display_name) ?? 'Unnamed app',
+      wingetId: clean(p.winget_id),
+      phase: p.phase,
+      fromVersion: clean(p.previous_version, 60),
+      toVersion: clean(p.new_version, 60),
+      pilotGroupLabel: clean(p.group_name),
+      previousAppId: p.previous_app_id,
+      newAppId: p.new_app_id ?? null,
+      jobStatus: p.job_status ? jobStatus(p.job_status) : null,
+      startedAt: isoTime(p.created_at),
+      updatedAt: null,
+    })),
+  };
+}
+
+// ---------- routing ----------
+
+/** The endpoint for a path under /api/hrm/mcp, as a fixed name safe to log. */
+export function mcpEndpoint(path: string[]): string | null {
+  const [first, second, ...rest] = path;
+  if (rest.length > 0) return null;
+  if (first === 'apps' && second !== undefined) return 'apps/{id}';
+  if (second !== undefined) return null;
+  return ['status', 'attention', 'apps', 'updates', 'update-schedule', 'jobs', 'install-failures', 'pilots'].includes(first) ? first : null;
+}
+
+export async function handleMcpRequest(path: string[], query: URLSearchParams, ctx: McpContext): Promise<unknown> {
+  switch (mcpEndpoint(path)) {
+    case 'status': return serverStatusView(await readServerStatus(ctx.now));
+    case 'attention': return attentionView(await readTenantAttention(ctx.tenantId));
+    case 'apps': return listApps(ctx, query);
+    case 'apps/{id}': return getApp(ctx, path[1]);
+    case 'updates': return listUpdates(ctx, query);
+    case 'update-schedule': return updateScheduleView(ctx);
+    case 'jobs': return listJobs(ctx, query);
+    case 'install-failures': {
+      const limit = intParam(query, 'limit', 25, 1, 100);
+      return installFailuresView(await readTenantAttention(ctx.tenantId), limit, ctx.now);
+    }
+    case 'pilots': return listPilots(ctx);
+    default: throw new McpError(404);
+  }
+}
diff --git a/lib/hrm/mcp-auth.ts b/lib/hrm/mcp-auth.ts
new file mode 100644
index 000000000..f785b3321
--- /dev/null
+++ b/lib/hrm/mcp-auth.ts
@@ -0,0 +1,85 @@
+/**
+ * HRM patch 0055: who may call the MCP read API (GET /api/hrm/mcp/*).
+ *
+ * Both are required on every request:
+ *  1. Authorization: Bearer <MCP_API_KEY> (at least 32 characters, compared in constant time).
+ *  2. A Cloudflare Access JWT (Cf-Access-Jwt-Assertion) signed by the team's keys, for ACCESS_AUD,
+ *     whose common_name is the MCP Worker's service token client ID (MCP_ACCESS_CLIENT_ID).
+ * HRM_TENANT_ID names the one Intune tenant the API reads (patch 0056 shares it with sign-in;
+ * MCP_TENANT_ID is still read when it is unset). Missing settings turn the API off.
+ * Callers only ever learn "401"; the reason is never returned or logged.
+ */
+
+import { createRemoteJWKSet, jwtVerify, type JWTVerifyGetKey } from 'jose';
+import { reportKeyMatches } from './status-report';
+
+export interface McpConfig {
+  apiKey: string;
+  teamDomain: string;
+  audience: string;
+  clientId: string;
+  tenantId: string;
+}
+
+const GUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
+// Only a Cloudflare Access team domain is trusted for keys, so a bad setting can't point at other servers.
+const TEAM_DOMAIN = /^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\.cloudflareaccess\.com$/;
+
+/** The API's settings, or null when any is missing or malformed (the API is then off). */
+export function mcpConfig(env: Record<string, string | undefined> = process.env): McpConfig | null {
+  const apiKey = env.MCP_API_KEY ?? '';
+  const teamDomain = (env.ACCESS_TEAM_DOMAIN ?? '').trim().toLowerCase().replace(/^https:\/\//, '').replace(/\/+$/, '');
+  const audience = (env.ACCESS_AUD ?? '').trim();
+  const clientId = (env.MCP_ACCESS_CLIENT_ID ?? '').trim();
+  const tenantId = (env.HRM_TENANT_ID || env.MCP_TENANT_ID || '').trim().toLowerCase();
+  if (apiKey.length < 32 || !TEAM_DOMAIN.test(teamDomain) || audience.length < 16 || clientId.length < 8 || !GUID.test(tenantId)) return null;
+  return { apiKey, teamDomain, audience, clientId, tenantId };
+}
+
+const keySets = new Map<string, JWTVerifyGetKey>();
+function teamKeys(teamDomain: string): JWTVerifyGetKey {
+  let keys = keySets.get(teamDomain);
+  if (!keys) {
+    keys = createRemoteJWKSet(new URL(`https://${teamDomain}/cdn-cgi/access/certs`), { timeoutDuration: 2_000, cooldownDuration: 30_000 });
+    keySets.set(teamDomain, keys);
+  }
+  return keys;
+}
+
+/** True only for a valid, unexpired Access JWT issued to the MCP Worker's service token. */
+export async function accessTokenMatches(token: string | null, config: McpConfig, keys: JWTVerifyGetKey = teamKeys(config.teamDomain)): Promise<boolean> {
+  if (!token || token.length > 8192) return false;
+  try {
+    const { payload } = await jwtVerify(token, keys, {
+      issuer: `https://${config.teamDomain}`,
+      audience: config.audience,
+      algorithms: ['RS256'],
+      clockTolerance: 30,
+      requiredClaims: ['exp', 'iat'],
+    });
+    return typeof payload.common_name === 'string' && payload.common_name === config.clientId;
+  } catch {
+    return false;
+  }
+}
+
+/** The configured tenant when both checks pass, otherwise null. */
+export async function authorizeMcpRequest(
+  headers: Headers,
+  env: Record<string, string | undefined> = process.env,
+  keys?: JWTVerifyGetKey,
+): Promise<McpConfig | null> {
+  const config = mcpConfig(env);
+  if (!config) return null;
+  // The key is checked first: it is cheap and never makes a network call.
+  if (!reportKeyMatches(headers.get('authorization'), config.apiKey)) return null;
+  if (!(await accessTokenMatches(headers.get('cf-access-jwt-assertion'), config, keys))) return null;
+  return config;
+}
+
+const EMAIL = /^[A-Za-z0-9._%+'-]{1,64}@[A-Za-z0-9.-]{1,190}\.[A-Za-z]{2,24}$/;
+/** The requester header for the server log only: a plain email or "unknown", never other text. */
+export function requesterForLog(value: string | null): string {
+  const email = value?.trim() ?? '';
+  return email.length <= 254 && EMAIL.test(email) ? email.toLowerCase() : 'unknown';
+}
diff --git a/lib/hrm/status-report-data.ts b/lib/hrm/status-report-data.ts
new file mode 100644
index 000000000..10bb8f8fc
--- /dev/null
+++ b/lib/hrm/status-report-data.ts
@@ -0,0 +1,122 @@
+/** Counts only, using an isolated read-only SQLite connection so a slow query cannot block HTTP. */
+import { Worker } from 'node:worker_threads';
+import path from 'node:path';
+import { getDatabase, isSqliteMode } from '@/lib/db';
+import type { ReportCounts } from './status-report';
+import { countsFromRecords } from './status-report';
+
+// The worker has its own 200 ms busy timeout; no setting on the app's connection is changed.
+// Its inputs contain only the database path and time. Its output contains counts and timestamps.
+const QUERY = `
+const { parentPort, workerData } = require('node:worker_threads');
+let db;
+try {
+  // Resolve inside the worker: webpack must not rewrite a parent require.resolve into a bundle ID.
+  const Database = require('node:module').createRequire(workerData.packagePath)('better-sqlite3');
+  db = new Database(workerData.databasePath, { readonly: true, fileMustExist: true, timeout: 200 });
+  db.pragma('query_only = ON');
+  const now = workerData.now;
+  const day = 86400000;
+  const start = new Date(Math.floor(now / day) * day - 13 * day).toISOString();
+  const end = new Date(now).toISOString();
+  const failedSince = new Date(now - 7 * day).toISOString();
+  const stuckBefore = new Date(now - 2 * 3600000).toISOString();
+  const eventsSince = new Date(now - 2 * day).toISOString();
+  const failedRecent = db.prepare(\`SELECT COUNT(*) AS n FROM packaging_jobs WHERE archived_at IS NULL
+    AND status = 'failed' AND julianday(created_at) BETWEEN julianday(?) AND julianday(?)\`).get(failedSince, end).n;
+  const stuck = db.prepare(\`SELECT COUNT(*) AS n FROM packaging_jobs WHERE archived_at IS NULL
+    AND status IN ('queued', 'packaging', 'uploading') AND julianday(created_at) < julianday(?)\`).get(stuckBefore).n;
+  const days = Array(14).fill(0);
+  for (const row of db.prepare(\`SELECT date(deployed_at) AS date, COUNT(*) AS n FROM upload_history
+    WHERE julianday(deployed_at) BETWEEN julianday(?) AND julianday(?) GROUP BY date(deployed_at)\`).all(start, end)) {
+    const offset = Math.round((Date.parse(row.date + 'T00:00:00Z') - Date.parse(start)) / day);
+    if (offset >= 0 && offset < 14) days[offset] = row.n;
+  }
+  const groups = (table, time, condition) => db.prepare(\`SELECT MAX(julianday(\${time})) AS at, COUNT(*) AS count
+    FROM \${table} WHERE \${condition} AND julianday(\${time}) BETWEEN julianday(?) AND julianday(?)
+    GROUP BY strftime('%Y-%m-%dT%H', \${time})\`).all(eventsSince, end)
+    .map(row => ({ at: new Date(Math.round((row.at - 2440587.5) * day)).toISOString(), count: row.count }));
+  const failed = groups('packaging_jobs', 'COALESCE(updated_at, created_at)', "status = 'failed' AND archived_at IS NULL");
+  const deployed = groups('upload_history', 'deployed_at', '1 = 1');
+  let startup;
+  if (db.prepare("SELECT 1 FROM sqlite_master WHERE type='table' AND name='hrm_startup_reports'").get()) {
+    const snapshots = db.prepare(\`SELECT checked_at, error,
+      CASE WHEN json_valid(payload) THEN json_extract(payload, '$.summary.waiting') END AS waiting,
+      CASE WHEN json_valid(payload) THEN json_extract(payload, '$.summary.failed') END AS failed,
+      CASE WHEN json_valid(payload) THEN json_extract(payload, '$.summary.outdated') END AS outdated,
+      CASE WHEN json_valid(payload) THEN json_extract(payload, '$.unknownDevices') END AS unknown,
+      CASE WHEN json_valid(payload) THEN json_extract(payload, '$.omitted') END AS omitted
+      FROM hrm_startup_reports LIMIT 100\`).all();
+    if (snapshots.length) {
+      startup = { waiting: 0, failed: 0, outdated: 0, unknown: 0, omitted: 0 };
+      for (const row of snapshots) {
+        if (row.error || !Number.isFinite(Date.parse(row.checked_at)) || now - Date.parse(row.checked_at) > 6 * 3600000) { startup.outdated++; continue; }
+        for (const key of ['waiting','failed','outdated','unknown','omitted']) if (Number.isSafeInteger(row[key]) && row[key] >= 0 && row[key] <= 1000000) startup[key] += row[key];
+      }
+    }
+  }
+  parentPort.postMessage({ failedRecent, stuck, days, failed, deployed, ...(startup ? {startup} : {}) });
+} catch {
+  parentPort.postMessage(null);
+} finally {
+  if (db) db.close();
+}
+`;
+
+export function readSqliteReportCounts(signal: AbortSignal, now = new Date()): Promise<ReportCounts> {
+  return new Promise((resolve, reject) => {
+    signal.throwIfAborted();
+    const worker = new Worker(QUERY, {
+      eval: true,
+      workerData: {
+        packagePath: path.join(process.cwd(), 'package.json'),
+        databasePath: path.resolve(process.env.DATABASE_PATH || './data/intuneget.db'),
+        now: now.getTime(),
+      },
+    });
+    let finished = false;
+    const finish = (value?: ReportCounts) => {
+      if (finished) return;
+      finished = true;
+      signal.removeEventListener('abort', abort);
+      void worker.terminate();
+      if (value) resolve(value);
+      else reject(new Error('Report unavailable'));
+    };
+    const abort = () => finish();
+    signal.addEventListener('abort', abort, { once: true });
+    worker.once('message', (value: ReportCounts | null) => finish(value ?? undefined));
+    worker.once('error', () => finish());
+    worker.once('exit', () => finish());
+    // Covers cancellation between construction and listener registration.
+    if (signal.aborted) abort();
+  });
+}
+
+export async function readReportCounts(signal: AbortSignal, now = new Date()): Promise<ReportCounts> {
+  if (isSqliteMode()) return readSqliteReportCounts(signal, now);
+  // The shared adapter is asynchronous in Supabase mode. The route still enforces its deadline.
+  const db = getDatabase();
+  const [jobs, deploys] = await Promise.all([
+    Promise.all([
+      db.jobs.getByStatus('failed', 500, false),
+      ...['queued', 'packaging', 'uploading'].map(status => db.jobs.getByStatus(status, 200)),
+    ]).then(lists => lists.flat()),
+    db.uploadHistory.listAll(1000),
+  ]);
+  signal.throwIfAborted();
+  return countsFromRecords(jobs, deploys, now);
+}
+
+/** Bound file size before parsing; malformed or oversized status data becomes a sanitized degraded report. */
+export async function readReportServerStatus(signal: AbortSignal, now = new Date()) {
+  // HRM patch 0036: the 32 KB bounded read is shared with Home (readStatusFileText in ./home).
+  const { interpretServerStatus, readStatusFileText } = await import('./home');
+  const raw = await readStatusFileText(signal);
+  if (raw === null) return interpretServerStatus(null, now);
+  const value = JSON.parse(raw);
+  if (!value || typeof value.generatedAt !== 'string' || !Number.isFinite(Date.parse(value.generatedAt))
+    || !Number.isFinite(value.disk?.totalKb) || value.disk.totalKb < 0
+    || !Number.isFinite(value.disk?.usedKb) || value.disk.usedKb < 0) throw new Error('Report unavailable');
+  return interpretServerStatus(raw, now);
+}
diff --git a/lib/hrm/status-report.ts b/lib/hrm/status-report.ts
new file mode 100644
index 000000000..6ed6d256a
--- /dev/null
+++ b/lib/hrm/status-report.ts
@@ -0,0 +1,274 @@
+/**
+ * HRM patch: the IT dashboard's status report (hrm-it-dashboard
+ * docs/status-report.md, version 1), served at GET /api/status-report.
+ *
+ * Built from the server status file (lib/hrm/home.ts) and job and deploy
+ * counts the database already has. Counts and states only: never app names,
+ * staff names or emails, tenant IDs or error text.
+ */
+
+import { createHash, timingSafeEqual } from 'node:crypto';
+import type { PackagingJob, UploadHistoryRecord } from '@/lib/db/types';
+import { attentionCounts, type ServerStatus } from '@/lib/hrm/home';
+
+type Health = 'ok' | 'warn' | 'down';
+type Tone = 'ok' | 'warn' | 'down' | 'iris';
+
+export interface StatusReport {
+  version: 1;
+  tool: 'intuneget';
+  generatedAt: string;
+  health: Health;
+  status: string;
+  metric: { value: number; label: string };
+  series: { label: string; values: number[] };
+  foot: string[];
+  todos: { id: string; title: string; detail?: string; link?: string }[];
+  events: { at: string; text: string; tone: Tone }[];
+}
+
+export interface StatusReportInput {
+  server: ServerStatus;
+  /** Failed and pending jobs, or null when the database couldn't be read. */
+  jobs: Pick<PackagingJob, 'status' | 'created_at' | 'updated_at'>[] | null;
+  deploys: Pick<UploadHistoryRecord, 'deployed_at'>[] | null;
+  /** The server's public address (serverHttpsOrigin in lib/hrm/site); links are left out unless it is https. */
+  origin: string | undefined;
+  now?: Date;
+  counts?: ReportCounts;
+  /** Patch 0056's sign-in limit (adminAccessState); left out, no to-do is added. */
+  appAccess?: 'limited' | 'not_limited';
+}
+
+const HOUR = 3_600_000;
+const DAY = 24 * HOUR;
+const SERIES_DAYS = 14;
+const EVENT_HOURS = 48;
+const MAX_ITEMS = 20;
+
+/** Patch 0058: the sign-in limit to-do. Names the setting only, never its value. */
+export const APP_ACCESS_TODO = {
+  title: 'Limit IntuneGet sign-in to IT-Admins',
+  detail: 'Set HRM_ADMIN_GROUP_IDS on the server (CLAUDE.md, Access to the app)',
+} as const;
+
+// Summarizes the Home page status states; the watchdog also checks timer lateness and app health.
+const PROBLEMS: Record<string, { status: string; title: string }> = {
+  deploy: { status: 'Deploy failed', title: 'The last deploy did not finish' },
+  offsiteBackup: { status: 'Backup failed', title: 'The nightly off-site backup failed or is late' },
+  disk: { status: 'Disk low', title: 'Disk space is running low' },
+  updateCheck: { status: 'Update check failed', title: 'The scheduled update check failed' },
+  notifications: { status: 'Alerts failed', title: 'The scheduled update alerts failed' },
+  tunnel: { status: 'Tunnel down', title: 'The Cloudflare tunnel is not running' },
+  tunnelUpdate: { status: 'Tunnel update failed', title: 'The nightly cloudflared update failed' },
+  // HRM patch 0032
+  intuneReads: { status: 'Intune reads failing', title: 'Install results or app activity could not be read from Intune' },
+  intuneSelfTest: { status: 'Intune self-test failed', title: 'The daily Intune self-test failed' },
+  scheduledUpdates: { status: 'Scheduled updates failing', title: 'The hourly scheduled update run failed or is late' },
+  // HRM patch 0057
+  versionSync: { status: 'Version sync failing', title: "App updates wasn't corrected after 2 or more recent deploys" },
+};
+const PROBLEM_ORDER = Object.keys(PROBLEMS);
+
+const plural = (n: number, word: string) => `${n} ${word}${n === 1 ? '' : 's'}`;
+
+/** Compares the presented bearer key with STATUS_REPORT_KEY in constant time. */
+export function reportKeyMatches(authorization: string | null, expected: string | undefined): boolean {
+  const presented = authorization?.startsWith('Bearer ') ? authorization.slice(7) : undefined;
+  if (!presented || !expected || expected.length < 32) return false;
+  const digest = (value: string) => createHash('sha256').update(value).digest();
+  return timingSafeEqual(digest(presented), digest(expected));
+}
+
+/** Groups timestamps from the last 48 hours by hour, newest first: [{ at, count }]. */
+function byHour(times: string[], now: Date) {
+  const groups = new Map<number, { at: string; count: number }>();
+  for (const time of times) {
+    const at = Date.parse(time);
+    if (!Number.isFinite(at) || now.getTime() - at > EVENT_HOURS * HOUR || at > now.getTime()) continue;
+    const slot = Math.floor(at / HOUR);
+    const group = groups.get(slot);
+    if (!group) groups.set(slot, { at: new Date(at).toISOString(), count: 1 });
+    else {
+      group.count++;
+      if (at > Date.parse(group.at)) group.at = new Date(at).toISOString();
+    }
+  }
+  return [...groups.values()];
+}
+
+function recent(time: string | null | undefined, now: Date): string | null {
+  const at = Date.parse(time ?? '');
+  return Number.isFinite(at) && now.getTime() - at <= EVENT_HOURS * HOUR && at <= now.getTime()
+    ? new Date(at).toISOString()
+    : null;
+}
+
+export function buildStatusReport({ server, jobs, deploys, origin, counts, appAccess, now = new Date() }: StatusReportInput): StatusReport {
+  const base = httpsOrigin(origin);
+  const link = (path: string) => (base ? { link: `${base}${path}` } : {});
+  const todos: StatusReport['todos'] = [];
+  const events: StatusReport['events'] = [];
+  let health: Health = 'ok';
+  let status = 'Up';
+  const flag = (text: string, level: Health = 'warn') => {
+    if (health === 'ok' || (level === 'down' && health !== 'down')) {
+      health = level;
+      status = text;
+    }
+  };
+
+  if (!server.reported) {
+    flag(server.reason === 'stale' ? 'Status file stale' : 'No server status');
+    todos.push({ id: 'server-status', title: 'The server status file has stopped updating', detail: 'Check intuneget-status.timer on the VM' });
+  } else {
+    for (const key of PROBLEM_ORDER.filter((problem) => server.problems.includes(problem))) {
+      flag(key === 'disk' ? `Disk ${Math.round(server.diskRatio * 100)}% full` : PROBLEMS[key].status);
+      todos.push({ id: `server-${key}`, title: PROBLEMS[key].title, ...link('/dashboard') });
+    }
+  }
+  // Patch 0058: a to-do (not a pill change) until the IT admins group is set; it goes once it is.
+  if (appAccess === 'not_limited') {
+    todos.push({ id: 'app-access-not-limited', title: APP_ACCESS_TODO.title, detail: APP_ACCESS_TODO.detail, ...link('/dashboard') });
+  }
+
+  if (jobs === null || deploys === null) {
+    flag('Database error', 'down');
+  } else {
+    const { failedRecent, stuck } = counts ?? countsFromRecords(jobs, deploys, now);
+    if (failedRecent > 0) {
+      flag(`${failedRecent} failed`);
+      todos.push({ id: 'jobs-failed', title: `${plural(failedRecent, 'packaging job')} failed in the last 7 days`, ...link('/dashboard/uploads?status=failed') });
+    }
+    if (stuck > 0) {
+      flag(`${stuck} stuck`);
+      todos.push({ id: 'jobs-stuck', title: `${plural(stuck, 'packaging job')} waiting more than 2 hours`, ...link('/dashboard/uploads?status=pending') });
+    }
+    for (const group of (counts?.failed ?? byHour(jobs.filter((job) => job.status === 'failed').map((job) => job.updated_at ?? job.created_at), now))) {
+      events.push({ at: group.at, text: `${plural(group.count, 'packaging job')} failed`, tone: 'warn' });
+    }
+    for (const group of (counts?.deployed ?? byHour(deploys.map((deploy) => deploy.deployed_at), now))) {
+      events.push({ at: group.at, text: `${plural(group.count, 'app')} deployed to Intune`, tone: 'ok' });
+    }
+  }
+
+  // Startup Beta uses only cached aggregate counts; no app/device identifiers enter this report.
+  if (counts?.startup) {
+    const startup = counts.startup;
+    if (startup.waiting > 0) todos.push({ id: 'startup-waiting', title: `${plural(startup.waiting, 'startup installation')} waiting for restart`, detail: 'Beta: device reports, separate from deploying', ...link('/dashboard/updates#startup-installations') });
+    if (startup.failed > 0) { flag('Startup installs failed'); todos.push({ id: 'startup-failed', title: `${plural(startup.failed, 'startup installation')} failed`, detail: 'Beta: review the device reports', ...link('/dashboard/updates#startup-installations') }); }
+    if (startup.outdated > 0 || (startup.unknown ?? 0) > 0 || (startup.omitted ?? 0) > 0) { flag('Check startup reports'); todos.push({ id: 'startup-outdated', title: 'Startup installation reports need review', detail: 'Beta: outdated, unreadable or omitted results need a check', ...link('/dashboard/updates#startup-installations') }); }
+  }
+
+  const values = (counts ?? countsFromRecords(jobs ?? [], deploys ?? [], now)).days;
+
+  const foot: string[] = [];
+  if (server.reported) {
+    const deployAt = recent(server.lastDeploy?.time, now);
+    if (server.lastDeploy && deployAt && server.lastDeploy.result !== 'waiting') {
+      const version = safeVersion(server.lastDeploy.to);
+      if (server.lastDeploy.result === 'deployed') {
+        events.push({ at: deployAt, text: version ? `Server updated to ${version}` : 'Server updated', tone: 'ok' });
+      } else {
+        events.push({ at: deployAt, text: 'Server update did not finish', tone: 'down' });
+      }
+    }
+    const backupAt = recent(server.offsiteBackup?.at, now);
+    if (server.offsiteBackup && backupAt) {
+      events.push(server.offsiteBackup.result === 'success'
+        ? { at: backupAt, text: 'Off-site backup finished', tone: 'ok' }
+        : { at: backupAt, text: 'Off-site backup failed', tone: 'down' });
+    }
+    const version = safeVersion(server.version);
+    if (version) foot.push(`Running ${version}`);
+    foot.push(`Disk ${Math.round(server.diskRatio * 100)}% used`);
+  }
+
+  return constrainReport({
+    version: 1,
+    tool: 'intuneget',
+    generatedAt: now.toISOString(),
+    health,
+    status,
+    metric: { value: values.reduce((sum, n) => sum + n, 0), label: 'apps deployed in 14 days' },
+    series: { label: 'Apps deployed per UTC day, last 14 days', values },
+    foot,
+    todos: todos.slice(0, MAX_ITEMS),
+    events: events.sort((a, b) => b.at.localeCompare(a.at)).slice(0, MAX_ITEMS),
+  }, now);
+}
+
+
+export interface ReportCounts {
+  startup?: { waiting: number; failed: number; outdated: number; unknown?: number; omitted?: number };
+  failedRecent: number;
+  stuck: number;
+  days: number[];
+  failed: { at: string; count: number }[];
+  deployed: { at: string; count: number }[];
+}
+
+/** UTC calendar days, not moving 24-hour intervals; also used by the SQLite aggregate reader. */
+export function countsFromRecords(jobs: NonNullable<StatusReportInput['jobs']>, deploys: NonNullable<StatusReportInput['deploys']>, now: Date): ReportCounts {
+  const days = Array.from({ length: SERIES_DAYS }, () => 0);
+  const today = Math.floor(now.getTime() / DAY);
+  for (const deploy of deploys) {
+    const at = Date.parse(deploy.deployed_at);
+    const daysAgo = today - Math.floor(at / DAY);
+    if (at <= now.getTime() && daysAgo >= 0 && daysAgo < SERIES_DAYS) days[SERIES_DAYS - 1 - daysAgo]++;
+  }
+  return {
+    ...attentionCounts(jobs.filter(job => Date.parse(job.created_at) <= now.getTime()), now),
+    days,
+    failed: byHour(jobs.filter(job => job.status === 'failed').map(job => job.updated_at ?? job.created_at), now),
+    deployed: byHour(deploys.map(deploy => deploy.deployed_at), now),
+  };
+}
+
+/** Only release tags used by this build; no arbitrary status-file strings can become report text. Also used by the MCP read API (patch 0055). */
+export function safeVersion(value: unknown): string | null {
+  return typeof value === 'string' && /^v[0-9]{1,4}\.[0-9]{1,4}\.[0-9]{1,4}(?:-hrm\.[0-9]{1,6})?$/.exec(value)?.[0] === value ? value : null;
+}
+
+function httpsOrigin(value: string | undefined): string | null {
+  try {
+    const url = new URL(value ?? '');
+    return url.protocol === 'https:' && !url.username && !url.password ? url.origin : null;
+  } catch { return null; }
+}
+
+export function degradedReport(now = new Date()): StatusReport {
+  return {
+    version: 1, tool: 'intuneget', generatedAt: now.toISOString(), health: 'down', status: 'Report unavailable',
+    metric: { value: 0, label: 'apps deployed in 14 days' },
+    series: { label: 'Apps deployed per UTC day, last 14 days', values: Array(14).fill(0) },
+    foot: [], todos: [], events: [],
+  };
+}
+
+/** One output boundary enforces the contract, including UTF-8 bytes rather than JS string size. */
+export function constrainReport(report: StatusReport, now = new Date()): StatusReport {
+  const text = (value: string, limit: number) => value.slice(0, limit);
+  const link = (value: string | undefined) => {
+    if (!value || value.length > 2048) return {};
+    try {
+      const url = new URL(value);
+      return url.protocol === 'https:' && !url.username && !url.password ? { link: url.href } : {};
+    } catch { return {}; }
+  };
+  const result: StatusReport = {
+    version: 1, tool: 'intuneget', generatedAt: report.generatedAt,
+    health: report.health, status: text(report.status, 24) || 'Report unavailable',
+    metric: { value: report.metric.value, label: text(report.metric.label, 40) },
+    series: { label: text(report.series.label, 60), values: report.series.values.slice(0, 30) },
+    foot: report.foot.slice(0, 2).map(line => text(line, 60)),
+    todos: report.todos.slice(0, MAX_ITEMS).map(todo => ({
+      id: text(todo.id, 80), title: text(todo.title, 100),
+      ...(todo.detail ? { detail: text(todo.detail, 100) } : {}), ...link(todo.link),
+    })),
+    events: report.events.filter(event => recent(event.at, now)).slice(0, MAX_ITEMS).map(event => ({
+      at: recent(event.at, now)!, text: text(event.text, 80), tone: event.tone,
+    })),
+  };
+  return Buffer.byteLength(JSON.stringify(result), 'utf8') < 65_536 ? result : degradedReport(now);
+}
