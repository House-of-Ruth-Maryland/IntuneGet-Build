new file mode 100644
index 000000000..f29ccd30c
--- /dev/null
+++ b/app/api/hrm/mcp/[...path]/route.ts
@@ -0,0 +1,43 @@
+// HRM patch 0055: read-only API for HRM's MCP server (contract: IntuneGet-Build docs/mcp-api.md).
+// GET only. Needs MCP_API_KEY and the MCP Worker's Cloudflare Access service token; anything else is an empty 401.
+import { NextRequest, NextResponse } from 'next/server';
+import { authorizeMcpRequest, requesterForLog } from '@/lib/hrm/mcp-auth';
+import { handleMcpRequest, McpError, mcpEndpoint } from '@/lib/hrm/mcp-api';
+
+export const dynamic = 'force-dynamic';
+export const runtime = 'nodejs';
+const DEADLINE_MS = 6_000; // Inside the Worker's 8-second timeout.
+const MAX_BYTES = 256 * 1024;
+const NO_STORE = { 'Cache-Control': 'no-store' };
+const empty = (status: number) => new NextResponse(null, { status, headers: NO_STORE });
+
+export async function GET(request: NextRequest, { params }: { params: Promise<{ path?: string[] }> }) {
+  try {
+    const config = await authorizeMcpRequest(request.headers);
+    if (!config) return empty(401);
+    const path = (await params).path ?? [];
+    const endpoint = mcpEndpoint(path);
+    // Server log only: which endpoint and who asked. The requester is never returned.
+    console.info(`[mcp-api] GET ${endpoint ?? 'unknown'} for ${requesterForLog(request.headers.get('x-hrm-requested-by'))}`);
+    if (!endpoint) return empty(404);
+
+    const controller = new AbortController();
+    let timer: ReturnType<typeof setTimeout> | undefined;
+    const deadline = new Promise<never>((_, reject) => {
+      timer = setTimeout(() => { controller.abort(); reject(new McpError(503)); }, DEADLINE_MS);
+    });
+    try {
+      const signal = AbortSignal.any([controller.signal, request.signal]);
+      const body = await Promise.race([handleMcpRequest(path, request.nextUrl.searchParams, { tenantId: config.tenantId, signal, now: new Date() }), deadline]);
+      const text = JSON.stringify(body);
+      if (Buffer.byteLength(text, 'utf8') > MAX_BYTES) return empty(503);
+      return new NextResponse(text, { status: 200, headers: { ...NO_STORE, 'Content-Type': 'application/json' } });
+    } finally {
+      if (timer) clearTimeout(timer);
+      controller.abort();
+    }
+  } catch (error) {
+    // Never return or log error text.
+    return empty(error instanceof McpError ? error.status : 503);
+  }
+}
