@@ -0,0 +1,33 @@
+import { describe, expect, it, vi } from 'vitest';
+import { runIntuneSelfTest } from '../intune-self-test';
+const A = '11111111-1111-4111-8111-111111111111';
+const app = { tenantId: 'tenant', appId: A, wingetId: 'Example.App', displayName: 'Example', version: '1' };
+function graph(fail?: (url: string) => boolean) {
+  return vi.fn(async (url: string) => {
+    if (fail?.(url)) return new Response(JSON.stringify({ error: { code: 'BadRequest' } }), { status: 400 });
+    if (url.includes('retrieveDeviceAppInstallationStatusReport')) return Response.json({ Schema: [{ Column: 'AppInstallState' }], Values: [['Installed']], TotalRowCount: 1 });
+    if (url.endsWith('/assignments')) return Response.json({ value: [] });
+    if (url.includes(`mobileApps/${A}`)) return Response.json({ id: A, '@odata.type': '#microsoft.graph.win32LobApp', displayVersion: '1' });
+    return Response.json({ value: [{ id: A }] });
+  }) as unknown as typeof fetch;
+}
+describe('Intune self-test (HRM patch 0032)', () => {
+  it('passes when every read works, once per tenant', async () => {
+    const result = await runIntuneSelfTest([app, { ...app, appId: '22222222-2222-4222-8222-222222222222' }], { token: async () => 'token', fetchImpl: graph() });
+    expect(result).toMatchObject({ ok: true, tenants: 1 });
+    expect(result.checks.map((c) => c.name)).toEqual(['App list', 'App and groups', 'Install results', 'Pilot reads']);
+  });
+  it('names the read that Microsoft changed, with a status-only reason', async () => {
+    const result = await runIntuneSelfTest([app], { token: async () => 'token', fetchImpl: graph((url) => url.includes('reports/')) });
+    expect(result.ok).toBe(false);
+    expect(result.checks.find((c) => !c.ok)).toEqual({ name: 'Install results', ok: false, error: 'Intune install report returned 400' });
+  });
+  it('fails without a token, and passes with nothing to test yet', async () => {
+    expect(await runIntuneSelfTest([app], { token: async () => null, fetchImpl: graph() })).toMatchObject({ ok: false, checks: [{ name: 'Intune sign-in', ok: false }] });
+    expect(await runIntuneSelfTest([], { token: async () => 'token', fetchImpl: graph() })).toMatchObject({ ok: true, tenants: 0, checks: [] });
+  });
+  it('never returns IDs in reasons', async () => {
+    const result = await runIntuneSelfTest([app], { token: async () => 'token', fetchImpl: vi.fn(async () => { throw new Error(`boom ${A}`); }) as unknown as typeof fetch });
+    expect(JSON.stringify(result)).not.toContain(A);
+  });
+});
