@@ -0,0 +1,16 @@
+import { describe, expect, it } from 'vitest';
+import { formatInstallFailurePayload, type InstallFailureWebhookData } from './install-failure-formatters';
+const app = (id: string) => ({ display_name: 'Example', intune_app_id: id, failed: 1, previous_failed: 0, installed: 2, pending: 0, top_errors: [] });
+const data = (apps: InstallFailureWebhookData['apps']): InstallFailureWebhookData => ({ event: 'install_failures', timestamp: '2026-11-05T12:00:00Z', app_url: 'https://intuneget.example.test', apps });
+const teamsLink = (payload: unknown) => (payload as { attachments: Array<{ content: { actions: Array<{ title: string; url: string }> } }> }).attachments[0].content.actions[0];
+describe('alert links (HRM patch 0032)', () => {
+  it('links one app straight to its Inventory details', () => {
+    expect(teamsLink(formatInstallFailurePayload('teams', data([app('11111111-1111-4111-8111-111111111111')])))).toEqual({ type: 'Action.OpenUrl', title: 'Open in Inventory', url: 'https://intuneget.example.test/dashboard/inventory?app=11111111-1111-4111-8111-111111111111' });
+  });
+  it('links several apps to Inventory, and every webhook type keeps the same data', () => {
+    const many = data([app('a'), app('b')]);
+    expect(teamsLink(formatInstallFailurePayload('teams', many)).url).toBe('https://intuneget.example.test/dashboard/inventory');
+    for (const type of ['slack', 'discord'] as const) expect((formatInstallFailurePayload(type, many) as { data: unknown }).data).toEqual(many);
+    expect(formatInstallFailurePayload('custom', many)).toEqual(many);
+  });
+});
diff --git a/lib/webhooks/simple-alert.ts b/lib/webhooks/simple-alert.ts
new file mode 100644
index 000000000..23b879669
--- /dev/null
+++ b/lib/webhooks/simple-alert.ts
@@ -0,0 +1,55 @@
+/**
+ * HRM patch 0032: one alert layout for every webhook type: a title, a few lines and one link.
+ * Used by install-failure and paused auto-update alerts. Counts, app names and versions only.
+ */
+import type { WebhookType } from '@/types/notifications';
+
+export interface SimpleAlert<T> {
+  data: T;
+  title: string;
+  lines: string[];
+  link?: { label: string; url: string };
+  timestamp: string;
+  tone?: 'warning' | 'attention';
+}
+
+const DISCORD_COLOR = { warning: 0xf59e0b, attention: 0xef4444 };
+const escapeSlack = (text: string) => text.replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' })[c]!);
+
+export function formatSimpleAlert<T>(webhookType: WebhookType, alert: SimpleAlert<T>): unknown {
+  const { data, title, lines, link, timestamp, tone = 'warning' } = alert;
+  switch (webhookType) {
+    case 'teams':
+      return {
+        type: 'message',
+        data,
+        attachments: [{
+          contentType: 'application/vnd.microsoft.card.adaptive',
+          content: {
+            $schema: 'http://adaptivecards.io/schemas/adaptive-card.json',
+            type: 'AdaptiveCard',
+            version: '1.4',
+            body: [
+              { type: 'TextBlock', text: title, size: 'Large', weight: 'Bolder', color: tone === 'attention' ? 'Attention' : 'Warning', wrap: true },
+              ...lines.map((text) => ({ type: 'TextBlock', text, wrap: true })),
+            ],
+            actions: link ? [{ type: 'Action.OpenUrl', title: link.label, url: link.url }] : [],
+          },
+        }],
+      };
+    case 'slack':
+      return {
+        data,
+        blocks: [
+          { type: 'header', text: { type: 'plain_text', text: title, emoji: true } },
+          { type: 'section', text: { type: 'mrkdwn', text: escapeSlack(lines.join('\n')) } },
+          ...(link ? [{ type: 'context', elements: [{ type: 'mrkdwn', text: `<${link.url}|${link.label}>` }] }] : []),
+        ],
+      };
+    case 'discord':
+      return { data, embeds: [{ title, url: link?.url, description: lines.join('\n'), color: DISCORD_COLOR[tone], footer: { text: 'IntuneGet' }, timestamp }] };
+    case 'custom':
+    default:
+      return data;
+  }
+}
