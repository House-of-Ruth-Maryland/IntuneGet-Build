+/**
+ * HRM patch 0025: open an app's details from a link.
+ *
+ * /dashboard/inventory?app=<Intune app id> opens that app's details panel, so
+ * other tools can link straight to one Win32 app. Intune app ids are GUIDs;
+ * anything else is ignored and the page opens as usual.
+ */
+
+export const INVENTORY_PATH = '/dashboard/inventory';
+
+const GUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
+
+export function linkedAppId(value: string | null | undefined): string | null {
+  const id = value?.trim() ?? '';
+  return GUID.test(id) ? id.toLowerCase() : null;
+}
diff --git a/lib/hrm/paused-auto-update.ts b/lib/hrm/paused-auto-update.ts
new file mode 100644
index 000000000..819640892
--- /dev/null
+++ b/lib/hrm/paused-auto-update.ts
@@ -0,0 +1,64 @@
+/**
+ * HRM patch 0032: tell IT Ops when auto-update turns itself off for an app after repeated failures.
+ * Upstream silently disabled the policy (and, before 0032, never reached the limit). One alert per
+ * pause; turning auto-update back on clears it, so a later pause alerts again.
+ */
+import type Database from 'better-sqlite3';
+import type { DatabaseAdapter } from '@/lib/db/types';
+import { DEFAULT_SAFETY_CONFIG, type AppUpdatePolicy, type DeploymentConfig } from '@/types/update-policies';
+import { formatSimpleAlert } from '@/lib/webhooks/simple-alert';
+import { deliverFormattedWebhook } from '@/lib/webhooks/service';
+import { appUrl } from './site';
+
+export function createPausedAlertStore(getDb: () => Database.Database) {
+  return {
+    alerted(policyIds: string[]): Set<string> {
+      if (policyIds.length === 0) return new Set();
+      const rows = getDb().prepare(`SELECT policy_id FROM hrm_paused_auto_update_alerts WHERE policy_id IN (${policyIds.map(() => '?').join(',')})`).all(...policyIds) as Array<{ policy_id: string }>;
+      return new Set(rows.map((r) => r.policy_id));
+    },
+    mark(policyIds: string[], at: string) {
+      const db = getDb();
+      const insert = db.prepare('INSERT OR REPLACE INTO hrm_paused_auto_update_alerts (policy_id, alerted_at) VALUES (?, ?)');
+      db.transaction(() => { for (const id of policyIds) insert.run(id, at); })();
+    },
+    /** Forget every policy that isn't paused any more. */
+    keepOnly(pausedIds: string[]) {
+      const db = getDb();
+      if (pausedIds.length === 0) { db.prepare('DELETE FROM hrm_paused_auto_update_alerts').run(); return; }
+      db.prepare(`DELETE FROM hrm_paused_auto_update_alerts WHERE policy_id NOT IN (${pausedIds.map(() => '?').join(',')})`).run(...pausedIds);
+    },
+  };
+}
+
+export const isPausedByFailures = (p: AppUpdatePolicy) =>
+  p.policy_type === 'auto_update' && !p.is_enabled && p.consecutive_failures >= DEFAULT_SAFETY_CONFIG.maxConsecutiveFailures;
+
+export async function alertPausedAutoUpdates(db: DatabaseAdapter, now = new Date()) {
+  const { sqlitePausedAlerts: store, sqliteWebhooks: webhooks } = await import('@/lib/db/sqlite');
+  const paused = (await db.updatePolicies.listAll()).filter(isPausedByFailures);
+  store.keepOnly(paused.map((p) => p.id));
+  const done = store.alerted(paused.map((p) => p.id));
+  const fresh = paused.filter((p) => !done.has(p.id));
+  if (fresh.length === 0) return { paused: paused.length, alerted: 0 };
+  const names = fresh.map((p) => (p.deployment_config as DeploymentConfig | null)?.displayName || p.winget_id);
+  const base = appUrl();
+  const data = { event: 'auto_update_paused', timestamp: now.toISOString(), app_url: base, apps: fresh.map((p, i) => ({ display_name: names[i], winget_id: p.winget_id, failures: p.consecutive_failures })) };
+  let sent = 0;
+  for (const webhook of await webhooks.listAllEnabled()) {
+    const result = await deliverFormattedWebhook(webhook, formatSimpleAlert(webhook.webhook_type, {
+      data, timestamp: data.timestamp, tone: 'attention',
+      title: fresh.length === 1 ? `Auto-update turned off for ${names[0]}` : `Auto-update turned off for ${fresh.length} apps`,
+      lines: [
+        ...data.apps.map((a) => `${a.display_name}: ${a.failures} failed updates in a row`),
+        'Check the failed deployments, fix the cause, then turn auto-update back on in App updates.',
+      ],
+      link: base ? { label: 'Open Deployments', url: `${base}/dashboard/uploads?status=failed` } : undefined,
+    }));
+    await webhooks.recordResult(webhook.id, result.success);
+    if (result.success) sent++;
+  }
+  // Only a delivered alert counts; otherwise the next check tries again.
+  if (sent > 0) store.mark(fresh.map((p) => p.id), now.toISOString());
+  return { paused: paused.length, alerted: sent > 0 ? fresh.length : 0 };
+}
