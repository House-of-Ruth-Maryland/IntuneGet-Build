+import { NextRequest } from 'next/server';
+import { beforeEach, describe, expect, it, vi } from 'vitest';
+
+const mocks = vi.hoisted(() => ({ auth: vi.fn(), token: vi.fn() }));
+vi.mock('@/lib/auth-utils', () => ({ parseAccessToken: mocks.auth }));
+vi.mock('@/lib/intune/graph-client', () => ({ GRAPH_API_BASE: 'https://graph.example.test/v1.0', getServicePrincipalToken: mocks.token }));
+import { POST } from './route';
+
+const KEEP = '00000000-0000-0000-0000-00000000000a';
+const OTHER = '00000000-0000-0000-0000-00000000000b';
+const STRANGER = '00000000-0000-0000-0000-00000000000c';
+const group = (id: string, intent = 'required') => ({ id: `as-${id}`, intent, target: { '@odata.type': '#microsoft.graph.groupAssignmentTarget', groupId: id } });
+
+let apps: Record<string, { displayName: string; publisher: string; type?: string; assignments: unknown[] }>;
+let calls: Array<{ method: string; url: string; body?: unknown }>;
+
+beforeEach(() => {
+  mocks.auth.mockResolvedValue({ userId: 'user-1', tenantId: 'tenant-1' });
+  mocks.token.mockResolvedValue('token');
+  apps = {
+    [KEEP]: { displayName: 'Example Browser', publisher: 'Example', assignments: [group('g1')] },
+    [OTHER]: { displayName: 'Example Browser', publisher: 'Example', assignments: [group('g2', 'available')] },
+    [STRANGER]: { displayName: 'Something Else', publisher: 'Example', assignments: [] },
+  };
+  calls = [];
+  vi.stubGlobal('fetch', vi.fn(async (url: string, init?: RequestInit) => {
+    const method = init?.method ?? 'GET';
+    calls.push({ method, url, body: init?.body ? JSON.parse(String(init.body)) : undefined });
+    const m = /mobileApps\/([0-9a-f-]+)(\/(assignments|assign))?$/.exec(url)!;
+    const app = apps[m[1]];
+    if (!app) return new Response('', { status: 404 });
+    if (method === 'DELETE') return new Response(null, { status: 204 });
+    if (m[3] === 'assign') return new Response(null, { status: 204 });
+    if (m[3] === 'assignments') return Response.json({ value: app.assignments });
+    return Response.json({ id: m[1], displayName: app.displayName, publisher: app.publisher, '@odata.type': app.type ?? '#microsoft.graph.win32LobApp' });
+  }));
+});
+
+const post = (body: unknown) => POST(new NextRequest('http://localhost/api/hrm/duplicates', { method: 'POST', body: JSON.stringify(body) }));
+
+describe('duplicates route', () => {
+  it('requires sign-in and valid IDs', async () => {
+    mocks.auth.mockResolvedValue(null);
+    expect((await post({ action: 'keep', keepId: KEEP, otherIds: [OTHER] })).status).toBe(401);
+    mocks.auth.mockResolvedValue({ userId: 'user-1', tenantId: 'tenant-1' });
+    expect((await post({ action: 'keep', keepId: 'x', otherIds: [OTHER] })).status).toBe(400);
+    expect((await post({ action: 'keep', keepId: KEEP, otherIds: [KEEP] })).status).toBe(400);
+  });
+
+  it('moves every group onto the kept copy first, then empties the other copy', async () => {
+    const response = await post({ action: 'keep', keepId: KEEP, otherIds: [OTHER] });
+    expect(response.status).toBe(200);
+    const writes = calls.filter((c) => c.method === 'POST');
+    expect(writes.map((c) => c.url.split('/mobileApps/')[1])).toEqual([`${KEEP}/assign`, `${OTHER}/assign`]);
+    expect((writes[0].body as { mobileAppAssignments: unknown[] }).mobileAppAssignments).toHaveLength(2);
+    expect(writes[1].body).toEqual({ mobileAppAssignments: [] });
+    expect(await response.json()).toMatchObject({ kept: KEEP, groups: 2, cleared: [OTHER] });
+  });
+
+  it('refuses apps that are not copies of the same Win32 app', async () => {
+    expect((await post({ action: 'keep', keepId: KEEP, otherIds: [STRANGER] })).status).toBe(409);
+    apps[OTHER].type = '#microsoft.graph.winGetApp';
+    expect((await post({ action: 'keep', keepId: KEEP, otherIds: [OTHER] })).status).toBe(409);
+    expect(calls.some((c) => c.method === 'POST')).toBe(false);
+  });
+
+  it('deletes only an emptied copy of the same app', async () => {
+    expect((await post({ action: 'delete', keepId: KEEP, id: OTHER })).status).toBe(409);
+    apps[OTHER].assignments = [];
+    expect((await post({ action: 'delete', keepId: KEEP, id: STRANGER })).status).toBe(409);
+    expect((await post({ action: 'delete', keepId: KEEP, id: KEEP })).status).toBe(400);
+    const response = await post({ action: 'delete', keepId: KEEP, id: OTHER });
+    expect(response.status).toBe(200);
+    expect(calls.filter((c) => c.method === 'DELETE').map((c) => c.url)).toEqual([`https://graph.example.test/v1.0/deviceAppManagement/mobileApps/${OTHER}`]);
+  });
+});
diff --git a/app/api/hrm/duplicates/route.ts b/app/api/hrm/duplicates/route.ts
new file mode 100644
index 000000000..c4f1f633c
--- /dev/null
+++ b/app/api/hrm/duplicates/route.ts
@@ -0,0 +1,90 @@
+// HRM patch 0025: tidy up apps with more than one copy in Intune.
+//   { action: 'keep', keepId, otherIds }  move every group onto keepId; the others end up with none
+//   { action: 'delete', id, keepId }      delete an emptied copy (refused while it still has groups)
+// Everything is checked against Intune again here: the apps must be Win32 copies of the same app.
+
+import { NextRequest, NextResponse } from 'next/server';
+import { parseAccessToken } from '@/lib/auth-utils';
+import { GRAPH_API_BASE, getServicePrincipalToken } from '@/lib/intune/graph-client';
+import { duplicateKey, mergeAssignments, type GraphAssignment } from '@/lib/hrm/duplicates';
+
+const GUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
+const fail = (error: string, status = 400) => NextResponse.json({ error }, { status });
+
+interface GraphApp { id: string; displayName: string; publisher: string | null; '@odata.type'?: string }
+
+async function graph(token: string, path: string, init: RequestInit = {}) {
+  return fetch(`${GRAPH_API_BASE}${path}`, {
+    ...init,
+    headers: { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json', ...(init.headers ?? {}) },
+    cache: 'no-store',
+  });
+}
+
+async function loadCopy(token: string, id: string): Promise<{ app: GraphApp; assignments: GraphAssignment[] } | null> {
+  const [appResponse, assignmentsResponse] = await Promise.all([
+    graph(token, `/deviceAppManagement/mobileApps/${id}`),
+    graph(token, `/deviceAppManagement/mobileApps/${id}/assignments`),
+  ]);
+  if (!appResponse.ok || !assignmentsResponse.ok) return null;
+  const app = (await appResponse.json()) as GraphApp;
+  if (app['@odata.type'] !== '#microsoft.graph.win32LobApp') return null;
+  const assignments = ((await assignmentsResponse.json()) as { value?: GraphAssignment[] }).value ?? [];
+  return { app, assignments };
+}
+
+async function assign(token: string, id: string, assignments: GraphAssignment[]) {
+  const response = await graph(token, `/deviceAppManagement/mobileApps/${id}/assign`, {
+    method: 'POST',
+    body: JSON.stringify({ mobileAppAssignments: assignments }),
+  });
+  return response.ok;
+}
+
+export async function POST(request: NextRequest) {
+  const user = await parseAccessToken(request.headers.get('Authorization'));
+  if (!user) return fail('Authentication required', 401);
+  const body = (await request.json().catch(() => null)) as Record<string, unknown> | null;
+  const action = body?.action;
+  const keepId = typeof body?.keepId === 'string' ? body.keepId : '';
+  if (!GUID.test(keepId)) return fail('Invalid app');
+
+  const token = await getServicePrincipalToken(user.tenantId);
+  if (!token) return fail("Couldn't reach Intune. Try again.", 502);
+  const keep = await loadCopy(token, keepId);
+  if (!keep) return fail('That copy is no longer in Intune.', 404);
+
+  if (action === 'keep') {
+    const otherIds = Array.isArray(body?.otherIds) ? (body!.otherIds as unknown[]).filter((v): v is string => typeof v === 'string') : [];
+    if (otherIds.length === 0 || otherIds.length > 10 || !otherIds.every((id) => GUID.test(id) && id !== keepId)) return fail('Invalid copies');
+    const others = await Promise.all(otherIds.map((id) => loadCopy(token, id)));
+    if (others.some((o) => !o || duplicateKey(o.app) !== duplicateKey(keep.app))) {
+      return fail('Those apps are not copies of the same app.', 409);
+    }
+    const merged = mergeAssignments(keep.assignments, others.map((o) => o!.assignments));
+    // Groups go onto the kept copy first, so nothing is ever left unassigned in between.
+    if (!(await assign(token, keepId, merged))) return fail("Intune didn't accept the groups. Nothing was changed.", 502);
+    const cleared: string[] = [];
+    for (const id of otherIds) if (await assign(token, id, [])) cleared.push(id);
+    console.log(JSON.stringify({ route: '/api/hrm/duplicates', action, kept: keepId, cleared: cleared.length, of: otherIds.length }));
+    return NextResponse.json({ kept: keepId, groups: merged.length, cleared, notCleared: otherIds.filter((id) => !cleared.includes(id)) });
+  }
+
+  if (action === 'delete') {
+    const id = typeof body?.id === 'string' ? body.id : '';
+    if (!GUID.test(id) || id === keepId) return fail('Invalid copy');
+    const copy = await loadCopy(token, id);
+    if (!copy) return fail('That copy is no longer in Intune.', 404);
+    if (duplicateKey(copy.app) !== duplicateKey(keep.app)) return fail('Those apps are not copies of the same app.', 409);
+    if (copy.assignments.length > 0) return fail('This copy still has groups. Use Keep this copy on the other one first.', 409);
+    const response = await graph(token, `/deviceAppManagement/mobileApps/${id}`, { method: 'DELETE' });
+    if (!response.ok) {
+      const detail = response.status === 400 ? ' It may still be linked to another app (supersedence or a dependency); remove that link in Intune first.' : '';
+      return fail(`Intune didn't delete it.${detail}`, 502);
+    }
+    console.log(JSON.stringify({ route: '/api/hrm/duplicates', action, deleted: id }));
+    return NextResponse.json({ deleted: id });
+  }
+
+  return fail('Unknown action');
+}
