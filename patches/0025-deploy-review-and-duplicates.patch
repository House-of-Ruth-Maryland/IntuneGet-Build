+// @vitest-environment happy-dom
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { act, createElement } from 'react';
+import { createRoot, type Root } from 'react-dom/client';
+import { QueryClient, QueryClientProvider } from '@tanstack/react-query';
+
+vi.mock('@/components/hrm/AppGroupsLine', () => ({ AppGroupsLine: () => null }));
+vi.mock('@/hooks/useMicrosoftAuth', () => ({ useMicrosoftAuth: () => ({ getAccessToken: async () => 'token' }) }));
+import { DuplicatesPanel } from './DuplicatesPanel';
+
+let root: Root;
+(globalThis as typeof globalThis & { IS_REACT_ACT_ENVIRONMENT: boolean }).IS_REACT_ACT_ENVIRONMENT = true;
+const app = (id: string, created: string, version: string) =>
+  ({ id, displayName: 'Example Browser', publisher: 'Example', description: '', displayVersion: version, createdDateTime: created,
+    lastModifiedDateTime: created, installExperience: null, size: 0, hasIcon: false }) as never;
+const A = '00000000-0000-0000-0000-00000000000a';
+const B = '00000000-0000-0000-0000-00000000000b';
+const text = () => document.body.textContent ?? '';
+const button = (label: string) => [...document.querySelectorAll('button')].find((b) => b.textContent?.trim() === label);
+const fetchMock = vi.fn();
+
+async function render(apps: unknown[], onChanged = vi.fn()) {
+  const client = new QueryClient();
+  await act(async () => root.render(createElement(QueryClientProvider, { client }, createElement(DuplicatesPanel, { apps: apps as never, onOpen: vi.fn(), onChanged }))));
+}
+
+beforeEach(() => {
+  const el = document.createElement('div');
+  document.body.append(el);
+  root = createRoot(el);
+  fetchMock.mockReset();
+  vi.stubGlobal('fetch', fetchMock);
+});
+afterEach(async () => {
+  await act(async () => root.unmount());
+  document.body.innerHTML = '';
+});
+
+describe('DuplicatesPanel', () => {
+  it('shows nothing when every app has one copy', async () => {
+    await render([app(A, '2026-10-23T02:00:00Z', '1.0')]);
+    expect(text()).toBe('');
+  });
+
+  it('keeps a copy, then offers to delete the emptied one', async () => {
+    const onChanged = vi.fn();
+    await render([app(A, '2026-10-23T02:00:00Z', '1.0'), app(B, '2026-10-24T02:00:00Z', '1.0')], onChanged);
+    expect(text()).toContain('1 app has more than one copy in Intune');
+    fetchMock.mockResolvedValueOnce(Response.json({ kept: A, groups: 2, cleared: [B], notCleared: [] }));
+    const keepButtons = [...document.querySelectorAll('button')].filter((b) => b.textContent?.trim() === 'Keep this copy');
+    await act(async () => keepButtons[1].click()); // the older copy (copies are newest first)
+    await act(async () => [...document.querySelectorAll('[role="dialog"] button')].find((b) => b.textContent?.includes('Keep this copy'))!.click());
+    expect(JSON.parse(fetchMock.mock.calls[0][1].body)).toEqual({ action: 'keep', keepId: A, otherIds: [B] });
+    expect(text()).toContain('all groups are on the kept copy');
+    expect(text()).toContain('Kept');
+
+    fetchMock.mockResolvedValueOnce(Response.json({ deleted: B }));
+    await act(async () => button('Delete from Intune')!.click());
+    await act(async () => [...document.querySelectorAll('[role="dialog"] button')].find((b) => b.textContent?.includes('Delete from Intune'))!.click());
+    expect(JSON.parse(fetchMock.mock.calls[1][1].body)).toEqual({ action: 'delete', keepId: A, id: B });
+    expect(onChanged).toHaveBeenCalled();
+  });
+
+  it('shows why Intune refused', async () => {
+    await render([app(A, '2026-10-23T02:00:00Z', '1.0'), app(B, '2026-10-24T02:00:00Z', '1.0')]);
+    fetchMock.mockResolvedValueOnce(Response.json({ error: "Intune didn't accept the groups. Nothing was changed." }, { status: 502 }));
+    await act(async () => button('Keep this copy')!.click());
+    await act(async () => [...document.querySelectorAll('[role="dialog"] button')].find((b) => b.textContent?.includes('Keep this copy'))!.click());
+    expect(text()).toContain("Intune didn't accept the groups. Nothing was changed.");
+  });
+});
diff --git a/components/hrm/DuplicatesPanel.tsx b/components/hrm/DuplicatesPanel.tsx
new file mode 100644
index 000000000..399e306a8
--- /dev/null
+++ b/components/hrm/DuplicatesPanel.tsx
@@ -0,0 +1,165 @@
+'use client';
+
+// HRM patch 0025: apps with more than one copy in Intune, and a safe way to keep one.
+
+import { useState } from 'react';
+import { Copy, Loader2 } from 'lucide-react';
+import { useQueryClient } from '@tanstack/react-query';
+import {
+  AlertDialog,
+  AlertDialogCancel,
+  AlertDialogContent,
+  AlertDialogDescription,
+  AlertDialogFooter,
+  AlertDialogHeader,
+  AlertDialogTitle,
+} from '@/components/ui/alert-dialog';
+import { Button } from '@/components/ui/button';
+import { AppGroupsLine } from '@/components/hrm/AppGroupsLine';
+import { useMicrosoftAuth } from '@/hooks/useMicrosoftAuth';
+import { findDuplicateGroups, type DuplicateGroup } from '@/lib/hrm/duplicates';
+import type { InventoryListApp } from '@/types/inventory';
+
+type Pending =
+  | { kind: 'keep'; group: DuplicateGroup; copy: InventoryListApp }
+  | { kind: 'delete'; group: DuplicateGroup; copy: InventoryListApp; keep: InventoryListApp };
+
+const created = (iso: string) =>
+  new Date(iso).toLocaleString('en-US', { month: 'short', day: 'numeric', year: 'numeric', hour: 'numeric', minute: '2-digit' });
+
+export function DuplicatesPanel({ apps, onOpen, onChanged }: { apps: InventoryListApp[]; onOpen: (id: string) => void; onChanged: () => void }) {
+  const groups = findDuplicateGroups(apps);
+  const { getAccessToken } = useMicrosoftAuth();
+  const queryClient = useQueryClient();
+  const [pending, setPending] = useState<Pending | null>(null);
+  const [kept, setKept] = useState<Record<string, string>>({});
+  const [busy, setBusy] = useState(false);
+  const [message, setMessage] = useState<{ tone: 'ok' | 'error'; text: string } | null>(null);
+  if (groups.length === 0) return null;
+
+  const run = async () => {
+    if (!pending) return;
+    setBusy(true);
+    setMessage(null);
+    try {
+      const token = await getAccessToken();
+      if (!token) throw new Error('Sign in again and retry.');
+      const others = pending.group.copies.filter((c) => c.id !== pending.copy.id);
+      const body =
+        pending.kind === 'keep'
+          ? { action: 'keep', keepId: pending.copy.id, otherIds: others.map((c) => c.id) }
+          : { action: 'delete', keepId: pending.keep.id, id: pending.copy.id };
+      const response = await fetch('/api/hrm/duplicates', {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
+        body: JSON.stringify(body),
+      });
+      const result = await response.json().catch(() => ({}));
+      if (!response.ok) throw new Error(result.error || 'Intune refused the change.');
+      if (pending.kind === 'keep') {
+        setKept((k) => ({ ...k, [pending.group.key]: pending.copy.id }));
+        setMessage({
+          tone: result.notCleared?.length ? 'error' : 'ok',
+          text: result.notCleared?.length
+            ? `Groups moved to the kept copy, but ${result.notCleared.length} other ${result.notCleared.length === 1 ? 'copy' : 'copies'} still ${result.notCleared.length === 1 ? 'has' : 'have'} groups. Try again.`
+            : `${pending.group.displayName}: all groups are on the kept copy. You can now delete the other ${others.length === 1 ? 'copy' : 'copies'}.`,
+        });
+      } else {
+        setMessage({ tone: 'ok', text: `Deleted the other copy of ${pending.group.displayName} from Intune.` });
+        onChanged();
+      }
+      await queryClient.invalidateQueries({ queryKey: ['inventory', 'app'] });
+    } catch (error) {
+      setMessage({ tone: 'error', text: error instanceof Error ? error.message : 'Something went wrong.' });
+    } finally {
+      setBusy(false);
+      setPending(null);
+    }
+  };
+
+  return (
+    <section aria-labelledby="duplicates-title" className="rounded-xl border border-amber-500/30 bg-amber-500/5 p-5">
+      <h2 id="duplicates-title" className="flex items-center gap-2 text-sm font-semibold text-text-primary">
+        <Copy className="h-4 w-4 text-amber-600 dark:text-amber-400" aria-hidden="true" />
+        {groups.length === 1 ? '1 app has more than one copy in Intune' : `${groups.length} apps have more than one copy in Intune`}
+      </h2>
+      <p className="mt-1 text-sm text-text-secondary">
+        Keep one copy: every group moves onto it and the others are left with none, so nothing installs twice. Nothing is uninstalled from computers.
+      </p>
+      {message && (
+        <p role="status" className={`mt-3 text-sm ${message.tone === 'ok' ? 'text-emerald-700 dark:text-emerald-300' : 'text-red-700 dark:text-red-300'}`}>
+          {message.text}
+        </p>
+      )}
+      <div className="mt-4 space-y-4">
+        {groups.map((group) => {
+          const keptId = kept[group.key];
+          return (
+            <div key={group.key} className="rounded-lg border border-overlay/10 bg-bg-surface">
+              <p className="border-b border-overlay/10 px-4 py-2.5 text-sm font-medium text-text-primary">
+                {group.displayName} <span className="font-normal text-text-muted">· {group.copies.length} copies</span>
+              </p>
+              <ul className="divide-y divide-overlay/10">
+                {group.copies.map((copy) => (
+                  <li key={copy.id} className="flex flex-wrap items-center gap-3 px-4 py-3 text-sm">
+                    <div className="min-w-0 flex-1">
+                      <button type="button" onClick={() => onOpen(copy.id)} className="text-left text-text-primary hover:underline">
+                        Version {copy.displayVersion || 'unknown'} · added {created(copy.createdDateTime)}
+                      </button>
+                      <div className="mt-1">
+                        <AppGroupsLine intuneAppId={copy.id} />
+                      </div>
+                    </div>
+                    {keptId === copy.id ? (
+                      <span className="text-xs font-medium text-emerald-700 dark:text-emerald-300">Kept</span>
+                    ) : keptId ? (
+                      <Button
+                        size="sm"
+                        variant="outline"
+                        onClick={() => setPending({ kind: 'delete', group, copy, keep: group.copies.find((c) => c.id === keptId)! })}
+                      >
+                        Delete from Intune
+                      </Button>
+                    ) : (
+                      <Button size="sm" variant="outline" onClick={() => setPending({ kind: 'keep', group, copy })}>
+                        Keep this copy
+                      </Button>
+                    )}
+                  </li>
+                ))}
+              </ul>
+            </div>
+          );
+        })}
+      </div>
+
+      <AlertDialog open={pending !== null} onOpenChange={(open) => !open && !busy && setPending(null)}>
+        <AlertDialogContent>
+          {pending && (
+            <>
+              <AlertDialogHeader>
+                <AlertDialogTitle>
+                  {pending.kind === 'keep'
+                    ? `Keep this copy of ${pending.group.displayName}?`
+                    : `Delete this copy of ${pending.group.displayName} from Intune?`}
+                </AlertDialogTitle>
+                <AlertDialogDescription>
+                  {pending.kind === 'keep'
+                    ? `Version ${pending.copy.displayVersion || 'unknown'}, added ${created(pending.copy.createdDateTime)}. Every group from the other ${pending.group.copies.length - 1 === 1 ? 'copy' : 'copies'} moves onto this one, and the others are left with no groups. Nothing is uninstalled.`
+                    : `Version ${pending.copy.displayVersion || 'unknown'}, added ${created(pending.copy.createdDateTime)}. It has no groups, so no computer gets it from Intune any more. Deleting it can't be undone, and computers that already have it keep it.`}
+                </AlertDialogDescription>
+              </AlertDialogHeader>
+              <AlertDialogFooter>
+                <AlertDialogCancel disabled={busy}>Cancel</AlertDialogCancel>
+                <Button onClick={run} disabled={busy} className={pending.kind === 'delete' ? 'bg-red-600 hover:bg-red-700 text-white' : 'bg-accent-cyan hover:bg-accent-cyan-dim text-white'}>
+                  {busy && <Loader2 className="mr-2 h-4 w-4 animate-spin" aria-hidden="true" />}
+                  {pending.kind === 'keep' ? 'Keep this copy' : 'Delete from Intune'}
+                </Button>
+              </AlertDialogFooter>
+            </>
+          )}
+        </AlertDialogContent>
+      </AlertDialog>
+    </section>
+  );
+}
