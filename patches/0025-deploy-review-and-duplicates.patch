diff --git a/components/hrm/DeployReview.tsx b/components/hrm/DeployReview.tsx
new file mode 100644
index 000000000..376e46090
--- /dev/null
+++ b/components/hrm/DeployReview.tsx
@@ -0,0 +1,83 @@
+'use client';
+
+// HRM patch 0025: a review of the cart before anything reaches Intune.
+
+import { AlertTriangle, ArrowRight, Users } from 'lucide-react';
+import {
+  AlertDialog,
+  AlertDialogCancel,
+  AlertDialogContent,
+  AlertDialogDescription,
+  AlertDialogFooter,
+  AlertDialogHeader,
+  AlertDialogTitle,
+} from '@/components/ui/alert-dialog';
+import { Button } from '@/components/ui/button';
+import { reviewRow } from '@/lib/hrm/deploy-review';
+import type { CartItem } from '@/types/upload';
+
+interface DeployReviewProps {
+  items: CartItem[];
+  open: boolean;
+  onOpenChange: (open: boolean) => void;
+  onConfirm: () => void;
+  onEdit: (item: CartItem) => void;
+}
+
+export function DeployReview({ items, open, onOpenChange, onConfirm, onEdit }: DeployReviewProps) {
+  const rows = items.map(reviewRow);
+  const toCheck = rows.filter((r) => r.warnings.length > 0).length;
+  return (
+    <AlertDialog open={open} onOpenChange={onOpenChange}>
+      <AlertDialogContent className="max-w-xl">
+        <AlertDialogHeader>
+          <AlertDialogTitle>{items.length === 1 ? 'Ready to deploy 1 app' : `Ready to deploy ${items.length} apps`}</AlertDialogTitle>
+          <AlertDialogDescription>
+            {toCheck === 0
+              ? 'Check what will happen in Intune, then deploy.'
+              : toCheck === 1
+                ? '1 app needs a look before you deploy.'
+                : `${toCheck} apps need a look before you deploy.`}
+          </AlertDialogDescription>
+        </AlertDialogHeader>
+        <ul className="max-h-[55vh] overflow-y-auto rounded-lg border border-overlay/10 divide-y divide-overlay/10">
+          {rows.map((row, i) => (
+            <li key={row.id} className="px-4 py-3 text-sm">
+              <div className="flex items-start justify-between gap-3">
+                <p className="font-medium text-text-primary">{row.title}</p>
+                <button
+                  type="button"
+                  onClick={() => onEdit(items[i])}
+                  className="flex-shrink-0 text-xs text-accent-cyan hover:underline"
+                >
+                  Change
+                </button>
+              </div>
+              <p className="mt-1 text-text-secondary">{row.action}</p>
+              <p className="mt-1 flex items-start gap-1.5 text-text-secondary">
+                <Users className="mt-0.5 h-3.5 w-3.5 flex-shrink-0 text-text-muted" aria-hidden="true" />
+                <span>{row.groups}</span>
+              </p>
+              {(row.install || row.updates) && (
+                <p className="mt-1 text-xs text-text-muted">{[row.install, row.updates].filter(Boolean).join(' · ')}</p>
+              )}
+              {row.warnings.map((w) => (
+                <p key={w} className="mt-2 flex items-start gap-1.5 text-xs text-amber-700 dark:text-amber-300">
+                  <AlertTriangle className="mt-0.5 h-3.5 w-3.5 flex-shrink-0" aria-hidden="true" />
+                  {w}
+                </p>
+              ))}
+            </li>
+          ))}
+        </ul>
+        <AlertDialogFooter>
+          <AlertDialogCancel>Back</AlertDialogCancel>
+          <Button onClick={onConfirm} className="bg-accent-cyan hover:bg-accent-cyan-dim text-white">
+            {items.length === 1 ? 'Deploy now' : `Deploy ${items.length} apps now`}
+            <ArrowRight className="ml-2 h-4 w-4" aria-hidden="true" />
+          </Button>
+        </AlertDialogFooter>
+      </AlertDialogContent>
+    </AlertDialog>
+  );
+}
