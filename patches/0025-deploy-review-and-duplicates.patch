+import { describe, expect, it } from 'vitest';
+import type { CartItem } from '@/types/upload';
+import { describeAssignments, reviewRow } from '../deploy-review';
+
+const base = {
+  id: 'item-1', addedAt: '2026-11-02', appSource: 'win32', wingetId: 'Example.App', displayName: 'Example App', publisher: 'Example',
+  version: '2.0', architecture: 'x64', installScope: 'machine', installerType: 'msi', installerUrl: 'https://example.test/app.msi',
+  installerSha256: 'A'.repeat(64), installCommand: '', uninstallCommand: '', detectionRules: [],
+  psadtConfig: { deployMode: 'Silent', restartBehavior: 'Suppress' },
+  assignments: [{ type: 'group', groupId: 'g1', groupName: 'APP-Example', intent: 'required' }],
+} as unknown as CartItem;
+
+describe('deploy review', () => {
+  it('says what happens, who gets it and how it installs', () => {
+    expect(reviewRow(base)).toEqual({
+      id: 'item-1', title: 'Example App 2.0', action: 'Adds it to Intune', groups: 'APP-Example · Required',
+      install: "Installs silently, doesn't restart", updates: 'Tells you about new versions', warnings: [],
+    });
+  });
+
+  it('warns about no groups and about a second copy', () => {
+    const row = reviewRow({ ...base, assignments: [], forceCreate: true } as CartItem);
+    expect(row.action).toBe('Adds another copy to Intune');
+    expect(row.warnings).toHaveLength(2);
+    expect(row.groups).toBe('No groups');
+  });
+
+  it('counts only excluded groups as no groups', () => {
+    const row = reviewRow({ ...base, assignments: [{ type: 'exclusionGroup', groupId: 'g2', groupName: 'Lab', intent: 'required' }] } as CartItem);
+    expect(row.groups).toBe('Not Lab');
+    expect(row.warnings[0]).toContain('No groups');
+  });
+
+  it('explains replacing the current copy or a previous version', () => {
+    expect(reviewRow({ ...base, forceCreate: true, replacesIntuneAppId: '00000000-0000-0000-0000-00000000000a' } as CartItem).action)
+      .toBe('Replaces the current copy in Intune and moves its groups to this one');
+    expect(reviewRow({ ...base, forceCreate: true, relationships: [{ relationshipType: 'supersedence', targetId: 'x' }] } as unknown as CartItem).action)
+      .toBe('Replaces the previous version in Intune');
+    expect(reviewRow({ ...base, forceCreate: true, relationships: [{ relationshipType: 'supersedence', targetId: 'x' }] } as unknown as CartItem).warnings).toEqual([]);
+  });
+
+  it('describes all devices, all users and update choices', () => {
+    expect(describeAssignments([{ type: 'allDevices', intent: 'required' }, { type: 'allUsers', intent: 'available' }])).toBe('All devices · Required, All users · Available');
+    expect(reviewRow({ ...base, updatePolicy: 'auto_update' } as CartItem).updates).toBe('Updates automatically');
+    expect(reviewRow({ ...base, appSource: 'store' } as unknown as CartItem).install).toBe('From the Microsoft Store');
+  });
+});
