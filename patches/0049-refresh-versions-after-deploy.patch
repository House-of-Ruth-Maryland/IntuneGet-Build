+/**
+ * HRM patch 0049: keep detected updates true as soon as a deployment finishes.
+ *
+ * The update check (3:30 AM and 3:30 PM) records "app X is on v1, v2 is out" for the newest copy of
+ * each app in each tenant (patch 0024). A deployment of v2 used to leave that row saying v1 until the
+ * next check. These helpers decide what the row should say once a new copy is deployed, and whether a
+ * stored row is already out of date when it is read, so both database adapters behave the same.
+ */
+import { compareVersions } from '@/lib/version-compare';
+import type { DeployedCopy, UpdateCheckResult, UploadHistoryRecord } from '@/lib/db/types';
+
+export type { DeployedCopy };
+
+export interface DeployedVersionSyncPlan {
+  /** Rows to delete (every row for the app when the new copy is current). */
+  deleteIds: string[];
+  /** The single row that replaces them, on the new copy, or null when the app is up to date. */
+  replacement: UpdateCheckResult | null;
+}
+
+function isMajorBump(current: string, latest: string): boolean {
+  const currentMajor = Number.parseInt(current.split('.')[0] ?? '', 10);
+  const latestMajor = Number.parseInt(latest.split('.')[0] ?? '', 10);
+  return Number.isFinite(currentMajor) && Number.isFinite(latestMajor) && latestMajor > currentMajor;
+}
+
+/**
+ * Plan the change to one tenant's update rows for an app after a new copy of it is deployed.
+ * Rows already at or below the deployed version are removed. Otherwise one row is kept, moved to the
+ * new copy (patch 0024: only the newest copy has a row) with the deployed version as its current
+ * version. Its id, dismissed and notified state stay, because the version it offers did not change.
+ */
+export function planDeployedVersionSync(
+  rows: UpdateCheckResult[],
+  deployed: DeployedCopy,
+  now: string
+): DeployedVersionSyncPlan {
+  const matching = rows.filter((row) => row.tenant_id === deployed.tenantId && row.winget_id === deployed.wingetId);
+  if (matching.length === 0) return { deleteIds: [], replacement: null };
+
+  const reference = [...matching].sort((a, b) => {
+    const byVersion = compareVersions(b.latest_version, a.latest_version);
+    return byVersion !== 0 ? byVersion : String(b.updated_at).localeCompare(String(a.updated_at));
+  })[0];
+  const deleteIds = matching.map((row) => row.id);
+
+  if (compareVersions(reference.latest_version, deployed.version) <= 0) {
+    return { deleteIds, replacement: null };
+  }
+
+  return {
+    deleteIds,
+    replacement: {
+      ...reference,
+      user_id: deployed.userId,
+      intune_app_id: deployed.intuneAppId,
+      display_name: deployed.displayName || reference.display_name,
+      current_version: deployed.version,
+      is_critical: isMajorBump(deployed.version, reference.latest_version),
+      updated_at: now,
+    },
+  };
+}
+
+/**
+ * Read-time safety net: the version an update row should show, given the newest deployment of the
+ * app in its tenant. Only a deployment made after the row was last written counts, so a newer copy
+ * that was later deleted in Intune (and skipped by the check, patch 0023) never hides a real update.
+ */
+export function effectiveCurrentVersion(
+  row: Pick<UpdateCheckResult, 'current_version' | 'updated_at'>,
+  newest: Pick<UploadHistoryRecord, 'version' | 'deployed_at'> | null
+): string {
+  if (!newest?.version || !newest.deployed_at) return row.current_version;
+  const deployedAt = Date.parse(newest.deployed_at);
+  const writtenAt = Date.parse(row.updated_at);
+  if (!Number.isFinite(deployedAt) || !Number.isFinite(writtenAt) || deployedAt <= writtenAt) {
+    return row.current_version;
+  }
+  return compareVersions(newest.version, row.current_version) > 0 ? newest.version : row.current_version;
+}
