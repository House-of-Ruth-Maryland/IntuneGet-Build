+import { describe, expect, it } from 'vitest';
+import { effectiveCurrentVersion, planDeployedVersionSync } from '@/lib/hrm/deployed-version-sync';
+import type { UpdateCheckResult } from '@/lib/db/types';
+
+const row = (over: Partial<UpdateCheckResult>): UpdateCheckResult => ({
+  id: 'r1', user_id: 'u1', tenant_id: 't1', winget_id: 'Vendor.App', intune_app_id: 'app-1', display_name: 'Vendor App',
+  current_version: '1.0.0', latest_version: '2.0.0', is_critical: true, is_managed: true, large_icon_type: null,
+  large_icon_value: null, notified_at: null, dismissed_at: null, detected_at: '2026-01-01T00:00:00.000Z',
+  updated_at: '2026-01-01T00:00:00.000Z', ...over,
+});
+const deployed = { userId: 'u2', tenantId: 't1', wingetId: 'Vendor.App', intuneAppId: 'app-2', version: '2.0.0', displayName: 'Vendor App' };
+const NOW = '2026-02-01T00:00:00.000Z';
+
+describe('planDeployedVersionSync', () => {
+  it('deletes rows at or below the deployed version', () => {
+    expect(planDeployedVersionSync([row({}), row({ id: 'r2', latest_version: '1.5.0' })], deployed, NOW))
+      .toEqual({ deleteIds: ['r1', 'r2'], replacement: null });
+  });
+
+  it('keeps the row with the highest latest version on the new copy', () => {
+    const plan = planDeployedVersionSync(
+      [row({ latest_version: '3.0.0', dismissed_at: NOW }), row({ id: 'r2', latest_version: '2.5.0' })],
+      { ...deployed, version: '2.1.0' }, NOW);
+    expect(plan.deleteIds).toEqual(['r1', 'r2']);
+    expect(plan.replacement).toMatchObject({
+      id: 'r1', user_id: 'u2', intune_app_id: 'app-2', current_version: '2.1.0', latest_version: '3.0.0',
+      is_critical: true, dismissed_at: NOW, updated_at: NOW,
+    });
+  });
+
+  it('ignores rows of other apps and tenants', () => {
+    expect(planDeployedVersionSync([row({ tenant_id: 't2' }), row({ winget_id: 'Other' })], deployed, NOW))
+      .toEqual({ deleteIds: [], replacement: null });
+  });
+});
+
+describe('effectiveCurrentVersion', () => {
+  it('uses a newer deployment made after the row was written', () => {
+    expect(effectiveCurrentVersion(row({}), { version: '1.5.0', deployed_at: NOW })).toBe('1.5.0');
+  });
+
+  it('keeps the row when the deployment is older, lower or missing', () => {
+    expect(effectiveCurrentVersion(row({ updated_at: NOW }), { version: '1.5.0', deployed_at: '2026-01-15T00:00:00.000Z' })).toBe('1.0.0');
+    expect(effectiveCurrentVersion(row({}), { version: '0.9.0', deployed_at: NOW })).toBe('1.0.0');
+    expect(effectiveCurrentVersion(row({}), null)).toBe('1.0.0');
+  });
+});
