diff --git a/components/providers/__tests__/theme-context.test.ts b/components/providers/__tests__/theme-context.test.ts
new file mode 100644
index 000000000..ceca2c164
--- /dev/null
+++ b/components/providers/__tests__/theme-context.test.ts
@@ -0,0 +1,53 @@
+// @vitest-environment happy-dom
+import { afterEach, describe, expect, it, vi } from 'vitest';
+import { applyThemeClass, isThemeMode, resolveTheme } from '../theme-context';
+
+function mockSystem(dark: boolean) {
+  vi.stubGlobal('matchMedia', vi.fn().mockReturnValue({
+    matches: dark,
+    addEventListener: vi.fn(),
+    removeEventListener: vi.fn(),
+  }));
+}
+
+describe('theme (HRM patch: dark mode)', () => {
+  afterEach(() => {
+    vi.unstubAllGlobals();
+    document.documentElement.classList.remove('dark');
+  });
+
+  it('accepts light, dark and system only', () => {
+    expect(['light', 'dark', 'system'].every(isThemeMode)).toBe(true);
+    expect(isThemeMode('blue')).toBe(false);
+    expect(isThemeMode(undefined)).toBe(false);
+  });
+
+  it('follows the computer when the theme is system', () => {
+    mockSystem(true);
+    expect(resolveTheme('system')).toBe('dark');
+    mockSystem(false);
+    expect(resolveTheme('system')).toBe('light');
+  });
+
+  it('keeps an explicit choice whatever the computer says', () => {
+    mockSystem(true);
+    expect(resolveTheme('light')).toBe('light');
+    mockSystem(false);
+    expect(resolveTheme('dark')).toBe('dark');
+  });
+
+  it('sets the dark class on the page and tells the other provider', () => {
+    mockSystem(false);
+    const heard: unknown[] = [];
+    const listener = (event: Event) => heard.push((event as CustomEvent).detail);
+    window.addEventListener('intuneget:theme-change', listener);
+
+    applyThemeClass('dark');
+    expect(document.documentElement.classList.contains('dark')).toBe(true);
+    applyThemeClass('system');
+    expect(document.documentElement.classList.contains('dark')).toBe(false);
+
+    window.removeEventListener('intuneget:theme-change', listener);
+    expect(heard).toEqual(['dark', 'system']);
+  });
+});
