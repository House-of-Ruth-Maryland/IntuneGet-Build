--- /dev/null
+++ b/components/hrm/ThemeMenuItems.tsx
@@ -0,0 +1,40 @@
+'use client';
+
+// HRM patch: Light, Dark or System (follow the computer) in the account menu.
+
+import { Monitor, Moon, Sun } from 'lucide-react';
+import {
+  DropdownMenuLabel,
+  DropdownMenuRadioGroup,
+  DropdownMenuRadioItem,
+} from '@/components/ui/dropdown-menu';
+import { isThemeMode, useTheme } from '@/components/providers/theme-context';
+
+const OPTIONS = [
+  { value: 'light', label: 'Light', icon: Sun },
+  { value: 'dark', label: 'Dark', icon: Moon },
+  { value: 'system', label: 'Same as computer', icon: Monitor },
+] as const;
+
+export function ThemeMenuItems() {
+  const { theme, setTheme } = useTheme();
+
+  return (
+    <>
+      <DropdownMenuLabel className="text-xs font-normal text-text-muted">Theme</DropdownMenuLabel>
+      <DropdownMenuRadioGroup
+        value={theme}
+        onValueChange={(value) => {
+          if (isThemeMode(value)) void setTheme(value);
+        }}
+      >
+        {OPTIONS.map(({ value, label, icon: Icon }) => (
+          <DropdownMenuRadioItem key={value} value={value} onSelect={(event) => event.preventDefault()}>
+            <Icon className="w-4 h-4 mr-2" aria-hidden="true" />
+            {label}
+          </DropdownMenuRadioItem>
+        ))}
+      </DropdownMenuRadioGroup>
+    </>
+  );
+}
