+import { describe, expect, it } from 'vitest';
+import { deploymentCounts, deploymentFilter, matchesDeploymentFilter, isTerminalDeployment, clearableDeploymentStatuses, DEPLOYMENT_FINISHED_QUERY_KEYS, hasNewlyFinishedDeployment } from '../deployment-status';
+it('keeps cancellation out of failures while including failed installation tests', () => {
+  const statuses=['queued','awaiting_qa','deployed','failed','qa_failed','cancelled'];
+  expect(deploymentCounts(statuses.map(status=>({status})))).toEqual({total:6,active:2,completed:1,failed:2,cancelled:1});
+  expect(statuses.filter(status=>matchesDeploymentFilter(status,'failed'))).toEqual(['failed','qa_failed']);
+  expect(statuses.filter(status=>matchesDeploymentFilter(status,'cancelled'))).toEqual(['cancelled']);
+  expect(isTerminalDeployment('cancelled')).toBe(true);
+  expect(isTerminalDeployment('awaiting_qa')).toBe(false);
+});
+it('accepts cancelled bookmarks and preserves the old pending alias', () => {
+  expect(deploymentFilter('cancelled')).toBe('cancelled');
+  expect(deploymentFilter('pending')).toBe('active');
+  expect(deploymentFilter('unknown')).toBe('all');
+});
+
+it('limits clearing to the selected finished outcome and never active jobs',()=>{
+ expect(clearableDeploymentStatuses('cancelled')).toEqual(['cancelled']);
+ expect(clearableDeploymentStatuses('failed')).toEqual(['failed','qa_failed']);
+ expect(clearableDeploymentStatuses('active')).toEqual([]);
+});
+
+// HRM patch 0049
+describe('hasNewlyFinishedDeployment', () => {
+  it('is true only when a job that was active has finished', () => {
+    const active = [{ id: 'j1', status: 'uploading' }];
+    expect(hasNewlyFinishedDeployment(active, [{ id: 'j1', status: 'deployed' }])).toBe(true);
+    expect(hasNewlyFinishedDeployment(active, [{ id: 'j1', status: 'failed' }])).toBe(true);
+    expect(hasNewlyFinishedDeployment(active, [{ id: 'j1', status: 'cancelled' }])).toBe(true);
+    expect(hasNewlyFinishedDeployment(active, [{ id: 'j1', status: 'packaging' }])).toBe(false);
+    expect(hasNewlyFinishedDeployment([], [{ id: 'j1', status: 'deployed' }])).toBe(false);
+    expect(hasNewlyFinishedDeployment([{ id: 'j1', status: 'deployed' }], [{ id: 'j1', status: 'deployed' }])).toBe(false);
+  });
+  it('refreshes App updates, Home and Inventory', () => {
+    expect(DEPLOYMENT_FINISHED_QUERY_KEYS).toEqual(expect.arrayContaining([['availableUpdates'], ['inventory', 'apps'], ['hrm', 'home'], ['hrm', 'previous-copies']]));
+  });
+});
