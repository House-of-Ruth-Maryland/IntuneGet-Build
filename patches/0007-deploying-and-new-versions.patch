--- /dev/null
+++ b/components/hrm/DeployReview.tsx
@@ -0,0 +1,85 @@
+'use client';
+
+// HRM patch 0025: a review of the cart before anything reaches Intune.
+
+import { AlertTriangle, ArrowRight, Users } from 'lucide-react';
+import {
+  AlertDialog,
+  AlertDialogCancel,
+  AlertDialogContent,
+  AlertDialogDescription,
+  AlertDialogFooter,
+  AlertDialogHeader,
+  AlertDialogTitle,
+} from '@/components/ui/alert-dialog';
+import { Button } from '@/components/ui/button';
+import { AppDriftWarning } from '@/components/hrm/AppInsights';
+import { reviewRow } from '@/lib/hrm/deploy-review';
+import type { CartItem } from '@/types/upload';
+
+interface DeployReviewProps {
+  items: CartItem[];
+  open: boolean;
+  onOpenChange: (open: boolean) => void;
+  onConfirm: () => void;
+  onEdit: (item: CartItem) => void;
+}
+
+export function DeployReview({ items, open, onOpenChange, onConfirm, onEdit }: DeployReviewProps) {
+  const rows = items.map(reviewRow);
+  const toCheck = rows.filter((r) => r.warnings.length > 0).length;
+  return (
+    <AlertDialog open={open} onOpenChange={onOpenChange}>
+      <AlertDialogContent className="max-w-xl">
+        <AlertDialogHeader>
+          <AlertDialogTitle>{items.length === 1 ? 'Ready to deploy 1 app' : `Ready to deploy ${items.length} apps`}</AlertDialogTitle>
+          <AlertDialogDescription>
+            {toCheck === 0
+              ? 'Check what will happen in Intune, then deploy.'
+              : toCheck === 1
+                ? '1 app needs a look before you deploy.'
+                : `${toCheck} apps need a look before you deploy.`}
+          </AlertDialogDescription>
+        </AlertDialogHeader>
+        <ul className="max-h-[55vh] overflow-y-auto rounded-lg border border-overlay/10 divide-y divide-overlay/10">
+          {rows.map((row, i) => (
+            <li key={row.id} className="px-4 py-3 text-sm">
+              <div className="flex items-start justify-between gap-3">
+                <p className="font-medium text-text-primary">{row.title}</p>
+                <button
+                  type="button"
+                  onClick={() => onEdit(items[i])}
+                  className="flex-shrink-0 text-xs text-accent-cyan hover:underline"
+                >
+                  Change
+                </button>
+              </div>
+              <p className="mt-1 text-text-secondary">{row.action}</p>
+              <p className="mt-1 flex items-start gap-1.5 text-text-secondary">
+                <Users className="mt-0.5 h-3.5 w-3.5 flex-shrink-0 text-text-muted" aria-hidden="true" />
+                <span>{row.groups}</span>
+              </p>
+              {(row.install || row.updates) && (
+                <p className="mt-1 text-xs text-text-muted">{[row.install, row.updates].filter(Boolean).join(' · ')}</p>
+              )}
+              <AppDriftWarning appId={items[i].appSource === 'win32' ? (items[i].replacesIntuneAppId || items[i].relationships?.find((r) => r.relationshipType === 'supersedence')?.targetId) : undefined} />
+              {row.warnings.map((w) => (
+                <p key={w} className="mt-2 flex items-start gap-1.5 text-xs text-amber-700 dark:text-amber-300">
+                  <AlertTriangle className="mt-0.5 h-3.5 w-3.5 flex-shrink-0" aria-hidden="true" />
+                  {w}
+                </p>
+              ))}
+            </li>
+          ))}
+        </ul>
+        <AlertDialogFooter>
+          <AlertDialogCancel>Back</AlertDialogCancel>
+          <Button onClick={onConfirm} className="bg-accent-cyan hover:bg-accent-cyan-dim text-white">
+            {items.length === 1 ? 'Deploy now' : `Deploy ${items.length} apps now`}
+            <ArrowRight className="ml-2 h-4 w-4" aria-hidden="true" />
+          </Button>
+        </AlertDialogFooter>
+      </AlertDialogContent>
+    </AlertDialog>
+  );
+}
diff --git a/components/hrm/DuplicatesPanel.test.ts b/components/hrm/DuplicatesPanel.test.ts
new file mode 100644
index 000000000..9d7a1fb9b
--- /dev/null
+++ b/components/hrm/DuplicatesPanel.test.ts
@@ -0,0 +1,97 @@
+// @vitest-environment happy-dom
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { act, createElement } from 'react';
+import { createRoot, type Root } from 'react-dom/client';
+import { QueryClient, QueryClientProvider } from '@tanstack/react-query';
+
+vi.mock('@/components/hrm/AppGroupsLine', () => ({ AppGroupsLine: () => null }));
+vi.mock('@/hooks/useMicrosoftAuth', () => ({ useMicrosoftAuth: () => ({ getAccessToken: async () => 'token' }) }));
+// HRM patch 0054: previous copies IntuneGet replaced, by lowercase app ID.
+const previous = vi.hoisted(() => ({ copies: new Map<string, unknown>() }));
+vi.mock('@/hooks/usePreviousCopies', () => ({ usePreviousCopies: () => ({ data: previous.copies }) }));
+import { DuplicatesPanel } from './DuplicatesPanel';
+
+let root: Root;
+(globalThis as typeof globalThis & { IS_REACT_ACT_ENVIRONMENT: boolean }).IS_REACT_ACT_ENVIRONMENT = true;
+const app = (id: string, created: string, version: string) =>
+  ({ id, displayName: 'Example Browser', publisher: 'Example', description: '', displayVersion: version, createdDateTime: created,
+    lastModifiedDateTime: created, installExperience: null, size: 0, hasIcon: false }) as never;
+const A = '00000000-0000-0000-0000-00000000000a';
+const B = '00000000-0000-0000-0000-00000000000b';
+const text = () => document.body.textContent ?? '';
+const button = (label: string) => [...document.querySelectorAll('button')].find((b) => b.textContent?.trim() === label);
+const fetchMock = vi.fn();
+
+async function render(apps: unknown[], onChanged = vi.fn()) {
+  const client = new QueryClient();
+  await act(async () => root.render(createElement(QueryClientProvider, { client }, createElement(DuplicatesPanel, { apps: apps as never, onOpen: vi.fn(), onChanged }))));
+}
+
+beforeEach(() => {
+  const el = document.createElement('div');
+  document.body.append(el);
+  root = createRoot(el);
+  fetchMock.mockReset();
+  previous.copies = new Map();
+  vi.stubGlobal('fetch', fetchMock);
+});
+afterEach(async () => {
+  await act(async () => root.unmount());
+  document.body.innerHTML = '';
+});
+
+describe('DuplicatesPanel', () => {
+  it('shows nothing when every app has one copy', async () => {
+    await render([app(A, '2026-10-23T02:00:00Z', '1.0')]);
+    expect(text()).toBe('');
+  });
+
+  it('keeps a copy, then offers to delete the emptied one', async () => {
+    const onChanged = vi.fn();
+    await render([app(A, '2026-10-23T02:00:00Z', '1.0'), app(B, '2026-10-24T02:00:00Z', '1.0')], onChanged);
+    expect(text()).toContain('1 app has more than one copy in Intune');
+    fetchMock.mockResolvedValueOnce(Response.json({ kept: A, groups: 2, cleared: [B], notCleared: [] }));
+    const keepButtons = [...document.querySelectorAll('button')].filter((b) => b.textContent?.trim() === 'Keep this copy');
+    await act(async () => keepButtons[1].click()); // the older copy (copies are newest first)
+    await act(async () => [...document.querySelectorAll('[role="dialog"] button')].find((b) => b.textContent?.includes('Keep this copy'))!.click());
+    expect(JSON.parse(fetchMock.mock.calls[0][1].body)).toEqual({ action: 'keep', keepId: A, otherIds: [B] });
+    expect(text()).toContain('all groups are on the kept copy');
+    expect(text()).toContain('Kept');
+
+    fetchMock.mockResolvedValueOnce(Response.json({ deleted: B }));
+    await act(async () => button('Delete from Intune')!.click());
+    await act(async () => [...document.querySelectorAll('[role="dialog"] button')].find((b) => b.textContent?.includes('Delete from Intune'))!.click());
+    expect(JSON.parse(fetchMock.mock.calls[1][1].body)).toEqual({ action: 'delete', keepId: A, id: B, copyIds: [B, A] });
+    expect(onChanged).toHaveBeenCalled();
+  });
+
+  it('shows why Intune refused', async () => {
+    await render([app(A, '2026-10-23T02:00:00Z', '1.0'), app(B, '2026-10-24T02:00:00Z', '1.0')]);
+    fetchMock.mockResolvedValueOnce(Response.json({ error: "Intune didn't accept the groups. Nothing was changed." }, { status: 502 }));
+    await act(async () => button('Keep this copy')!.click());
+    await act(async () => [...document.querySelectorAll('[role="dialog"] button')].find((b) => b.textContent?.includes('Keep this copy'))!.click());
+    expect(text()).toContain("Intune didn't accept the groups. Nothing was changed.");
+  });
+
+  // HRM patch 0026
+  it('explains an expired sign-in instead of a bare network error', async () => {
+    await render([app(A, '2026-10-23T02:00:00Z', '1.0'), app(B, '2026-10-24T02:00:00Z', '1.0')]);
+    fetchMock.mockRejectedValueOnce(new TypeError('Failed to fetch'));
+    await act(async () => button('Keep this copy')!.click());
+    await act(async () => [...document.querySelectorAll('[role="dialog"] button')].find((b) => b.textContent?.includes('Keep this copy'))!.click());
+    expect(text()).toContain('Your sign-in to IntuneGet has expired. Reload the page');
+  });
+
+  // HRM patch 0054
+  it('leaves out a previous copy waiting for automatic removal, but lists one cleanup is keeping', async () => {
+    const copy = { appId: A, version: '1.0', replacedByVersion: '2.0', replacedAt: '2026-10-24T02:00:00.000Z', removeAfter: '2026-10-31T02:00:00.000Z', kept: null };
+    previous.copies = new Map([[A, copy]]);
+    await render([app(A, '2026-10-23T02:00:00Z', '1.0'), app(B, '2026-10-24T02:00:00Z', '2.0')]);
+    expect(text()).toBe('');
+    await act(async () => root.unmount());
+    root = createRoot(document.body.appendChild(document.createElement('div')));
+    previous.copies = new Map([[A, { ...copy, kept: "This copy has a group the newest copy doesn't." }]]);
+    await render([app(A, '2026-10-23T02:00:00Z', '1.0'), app(B, '2026-10-24T02:00:00Z', '2.0')]);
+    expect(text()).toContain('1 app has more than one copy in Intune');
+  });
+});
diff --git a/components/hrm/DuplicatesPanel.tsx b/components/hrm/DuplicatesPanel.tsx
new file mode 100644
index 000000000..b7ac206c2
--- /dev/null
+++ b/components/hrm/DuplicatesPanel.tsx
@@ -0,0 +1,184 @@
+'use client';
+
+// HRM patch 0025: apps with more than one copy in Intune, and a safe way to keep one.
+
+import { useState } from 'react';
+import { Copy, Loader2 } from 'lucide-react';
+import { useQueryClient } from '@tanstack/react-query';
+import {
+  AlertDialog,
+  AlertDialogCancel,
+  AlertDialogContent,
+  AlertDialogDescription,
+  AlertDialogFooter,
+  AlertDialogHeader,
+  AlertDialogTitle,
+} from '@/components/ui/alert-dialog';
+import { Button } from '@/components/ui/button';
+import { AppGroupsLine } from '@/components/hrm/AppGroupsLine';
+import { useMicrosoftAuth } from '@/hooks/useMicrosoftAuth';
+import { findDuplicateGroups, type DuplicateGroup } from '@/lib/hrm/duplicates';
+import { usePreviousCopies } from '@/hooks/usePreviousCopies';
+import { waitingForCleanup } from '@/lib/hrm/previous-copy-text';
+import type { InventoryListApp } from '@/types/inventory';
+
+type Pending =
+  | { kind: 'keep'; group: DuplicateGroup; copy: InventoryListApp }
+  | { kind: 'delete'; group: DuplicateGroup; copy: InventoryListApp; keep: InventoryListApp };
+
+const EXPIRED = 'Your sign-in to IntuneGet has expired. Reload the page, then try again. Nothing was changed.';
+
+const created = (iso: string) =>
+  new Date(iso).toLocaleString('en-US', { month: 'short', day: 'numeric', year: 'numeric', hour: 'numeric', minute: '2-digit' });
+
+export function DuplicatesPanel({ apps, onOpen, onChanged }: { apps: InventoryListApp[]; onOpen: (id: string) => void; onChanged: () => void }) {
+  // HRM patch 0054: previous copies waiting for automatic removal are labelled in the list instead.
+  const { data: previous } = usePreviousCopies();
+  const groups = findDuplicateGroups(apps, (id) => {
+    const copy = previous?.get(id.toLowerCase());
+    return copy ? waitingForCleanup(copy) : false;
+  });
+  const { getAccessToken } = useMicrosoftAuth();
+  const queryClient = useQueryClient();
+  const [pending, setPending] = useState<Pending | null>(null);
+  const [kept, setKept] = useState<Record<string, string>>({});
+  const [busy, setBusy] = useState(false);
+  const [message, setMessage] = useState<{ tone: 'ok' | 'error'; text: string } | null>(null);
+  if (groups.length === 0) return null;
+
+  const run = async () => {
+    if (!pending) return;
+    setBusy(true);
+    setMessage(null);
+    try {
+      const token = await getAccessToken();
+      if (!token) throw new Error('Sign in again and retry.');
+      const others = pending.group.copies.filter((c) => c.id !== pending.copy.id);
+      const body =
+        pending.kind === 'keep'
+          ? { action: 'keep', keepId: pending.copy.id, otherIds: others.map((c) => c.id) }
+          : { action: 'delete', keepId: pending.keep.id, id: pending.copy.id, copyIds: pending.group.copies.map((c) => c.id) };
+      // HRM patch 0026: an expired sign-in sends the request to the sign-in page instead; say so plainly.
+      const response = await fetch('/api/hrm/duplicates', {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
+        body: JSON.stringify(body),
+      }).catch(() => {
+        throw new Error(EXPIRED);
+      });
+      const isJson = (response.headers.get('content-type') ?? '').includes('application/json');
+      if (response.redirected || !isJson) throw new Error(EXPIRED);
+      const result = await response.json().catch(() => ({}));
+      if (!response.ok) throw new Error(result.error || 'Intune refused the change. Nothing was changed.');
+      if (pending.kind === 'keep') {
+        setKept((k) => ({ ...k, [pending.group.key]: pending.copy.id }));
+        setMessage({
+          tone: result.notCleared?.length ? 'error' : 'ok',
+          text: result.notCleared?.length
+            ? `Groups moved to the kept copy, but ${result.notCleared.length} other ${result.notCleared.length === 1 ? 'copy' : 'copies'} still ${result.notCleared.length === 1 ? 'has' : 'have'} groups. Try again.`
+            : `${pending.group.displayName}: all groups are on the kept copy. You can now delete the other ${others.length === 1 ? 'copy' : 'copies'}.`,
+        });
+      } else {
+        setMessage({
+          tone: 'ok',
+          text: result.unlinked?.length
+            ? `Removed the link from ${result.unlinked.join(', ')} and deleted the copy of ${pending.group.displayName} from Intune.`
+            : `Deleted the copy of ${pending.group.displayName} from Intune.`,
+        });
+        onChanged();
+      }
+      await queryClient.invalidateQueries({ queryKey: ['inventory', 'app'] });
+    } catch (error) {
+      setMessage({ tone: 'error', text: error instanceof Error ? error.message : 'Something went wrong.' });
+    } finally {
+      setBusy(false);
+      setPending(null);
+    }
+  };
+
+  return (
+    <section aria-labelledby="duplicates-title" className="rounded-xl border border-amber-500/30 bg-amber-500/5 p-5">
+      <h2 id="duplicates-title" className="flex items-center gap-2 text-sm font-semibold text-text-primary">
+        <Copy className="h-4 w-4 text-amber-600 dark:text-amber-400" aria-hidden="true" />
+        {groups.length === 1 ? '1 app has more than one copy in Intune' : `${groups.length} apps have more than one copy in Intune`}
+      </h2>
+      <p className="mt-1 text-sm text-text-secondary">
+        Keep one copy: every group moves onto it and the others are left with none, so nothing installs twice. Nothing is uninstalled from computers.
+      </p>
+      {message && (
+        <p role="status" className={`mt-3 text-sm ${message.tone === 'ok' ? 'text-emerald-700 dark:text-emerald-300' : 'text-red-700 dark:text-red-300'}`}>
+          {message.text}
+        </p>
+      )}
+      <div className="mt-4 space-y-4">
+        {groups.map((group) => {
+          const keptId = kept[group.key];
+          return (
+            <div key={group.key} className="rounded-lg border border-overlay/10 bg-bg-surface">
+              <p className="border-b border-overlay/10 px-4 py-2.5 text-sm font-medium text-text-primary">
+                {group.displayName} <span className="font-normal text-text-muted">· {group.copies.length} copies</span>
+              </p>
+              <ul className="divide-y divide-overlay/10">
+                {group.copies.map((copy) => (
+                  <li key={copy.id} className="flex flex-wrap items-center gap-3 px-4 py-3 text-sm">
+                    <div className="min-w-0 flex-1">
+                      <button type="button" onClick={() => onOpen(copy.id)} className="text-left text-text-primary hover:underline">
+                        Version {copy.displayVersion || 'unknown'} · added {created(copy.createdDateTime)}
+                      </button>
+                      <div className="mt-1">
+                        <AppGroupsLine intuneAppId={copy.id} />
+                      </div>
+                    </div>
+                    {keptId === copy.id ? (
+                      <span className="text-xs font-medium text-emerald-700 dark:text-emerald-300">Kept</span>
+                    ) : keptId ? (
+                      <Button
+                        size="sm"
+                        variant="outline"
+                        onClick={() => setPending({ kind: 'delete', group, copy, keep: group.copies.find((c) => c.id === keptId)! })}
+                      >
+                        Delete from Intune
+                      </Button>
+                    ) : (
+                      <Button size="sm" variant="outline" onClick={() => setPending({ kind: 'keep', group, copy })}>
+                        Keep this copy
+                      </Button>
+                    )}
+                  </li>
+                ))}
+              </ul>
+            </div>
+          );
+        })}
+      </div>
+
+      <AlertDialog open={pending !== null} onOpenChange={(open) => !open && !busy && setPending(null)}>
+        <AlertDialogContent>
+          {pending && (
+            <>
+              <AlertDialogHeader>
+                <AlertDialogTitle>
+                  {pending.kind === 'keep'
+                    ? `Keep this copy of ${pending.group.displayName}?`
+                    : `Delete this copy of ${pending.group.displayName} from Intune?`}
+                </AlertDialogTitle>
+                <AlertDialogDescription>
+                  {pending.kind === 'keep'
+                    ? `Version ${pending.copy.displayVersion || 'unknown'}, added ${created(pending.copy.createdDateTime)}. Every group from the other ${pending.group.copies.length - 1 === 1 ? 'copy' : 'copies'} moves onto this one, and the others are left with no groups. Nothing is uninstalled.`
+                    : `Version ${pending.copy.displayVersion || 'unknown'}, added ${created(pending.copy.createdDateTime)}. It has no groups, so no computer gets it from Intune any more. If another copy of this app replaces it, that link is removed first. Deleting it can't be undone, and computers that already have it keep it.`}
+                </AlertDialogDescription>
+              </AlertDialogHeader>
+              <AlertDialogFooter>
+                <AlertDialogCancel disabled={busy}>Cancel</AlertDialogCancel>
+                <Button onClick={run} disabled={busy} className={pending.kind === 'delete' ? 'bg-red-600 hover:bg-red-700 text-white' : 'bg-accent-cyan hover:bg-accent-cyan-dim text-white'}>
+                  {busy && <Loader2 className="mr-2 h-4 w-4 animate-spin" aria-hidden="true" />}
+                  {pending.kind === 'keep' ? 'Keep this copy' : 'Delete from Intune'}
+                </Button>
+              </AlertDialogFooter>
+            </>
+          )}
+        </AlertDialogContent>
+      </AlertDialog>
+    </section>
+  );
+}
diff --git a/components/hrm/ReplacementDeadlineReview.tsx b/components/hrm/ReplacementDeadlineReview.tsx
new file mode 100644
index 000000000..59ad29a06
--- /dev/null
+++ b/components/hrm/ReplacementDeadlineReview.tsx
@@ -0,0 +1,18 @@
+'use client';
+import {useState} from 'react';
+import {useMicrosoftAuth} from '@/hooks/useMicrosoftAuth';
+import {Button} from '@/components/ui/button';
+type Preview={token:string;assignments:{id:string;intent:string;target:Record<string,unknown>;settings?:{installTimeSettings?:{useLocalTime:boolean;startDateTime?:string;deadlineDateTime?:string}}}[];affectedIds:string[]};
+/** Confirmation resumes a held job; opening the review performs no writes. */
+export function ReplacementDeadlineReview({jobId}:{jobId:string}){
+ const {getAccessToken}=useMicrosoftAuth();
+ const [preview,setPreview]=useState<Preview|null>(null),[decision,setDecision]=useState<'retain'|'reschedule'|null>(null),[date,setDate]=useState(''),[busy,setBusy]=useState(false),[error,setError]=useState(''),[done,setDone]=useState(false);
+ async function request(confirm=false){setBusy(true);setError('');try{
+  const token=await getAccessToken();if(!token)throw Error('Sign in again to review this deployment.');
+  const response=await fetch('/api/hrm/replacement-deadline-review',{method:'POST',headers:{Authorization:`Bearer ${token}`,'Content-Type':'application/json'},body:JSON.stringify({jobId,action:confirm?'confirm':'review',token:preview?.token,decision,newDeadline:date?`${date}:00Z`:undefined})});
+  const body=await response.json();if(!response.ok)throw Error(body.error||'Could not review deadlines.');
+  if(confirm){if(!body.resumed)throw Error(body.result?.message||'The deployment is still held. Refresh the review.');setDone(true);}else{setPreview(body);setDecision(null);}
+ }catch(e){setError(e instanceof Error?e.message:'Could not review deadlines.');}finally{setBusy(false)}}
+ if(done)return <p role="status">Confirmation saved. Check the deployment for packaging progress.</p>;
+ return <div className="mt-3 space-y-3 text-sm"><p className="font-medium">Paused for IT · replacement deadlines</p><Button variant="outline" disabled={busy} onClick={()=>request()}>Review deadlines</Button>{preview&&<fieldset className="space-y-2"><legend className="font-medium">Current Intune assignment timing</legend>{preview.assignments.map(row=><p key={row.id} className="break-words">{row.intent} · {String(row.target.groupId||row.target['@odata.type'])} · Available {row.settings?.installTimeSettings?.startDateTime||'ASAP'} · Deadline {row.settings?.installTimeSettings?.deadlineDateTime||'ASAP'} · {row.settings?.installTimeSettings?.useLocalTime?'device local time':'UTC'}{preview.affectedIds.includes(row.id)?' · needs confirmation':''}</p>)}<p>Retaining an expired deadline can make installation due at the next Intune attempt. Other assignment settings stay unchanged.</p>{(['retain','reschedule'] as const).map(value=><label key={value} className="flex gap-2"><input type="radio" name={`deadline-${jobId}`} checked={decision===value} onChange={()=>setDecision(value)}/>{value==='retain'?'Retain the existing deadlines':'Choose a new deadline'}</label>)}{decision==='reschedule'&&<label className="block">New deadline (each assignment keeps its time zone)<input type="datetime-local" className="block rounded border bg-transparent p-2" value={date} onChange={event=>setDate(event.target.value)}/></label>}<p className="text-text-secondary">New deadlines must be in the future and after availability. Device-local deadlines need 14 hours of lead time. Assignments are checked again before packaging.</p><Button disabled={busy||!decision||(decision==='reschedule'&&!date)} onClick={()=>request(true)}>{busy?'Checking…':'Confirm and resume packaging'}</Button><Button variant="ghost" disabled={busy} onClick={()=>setPreview(null)}>Cancel review</Button></fieldset>}{error&&<p role="alert" className="text-status-error">{error}</p>}</div>;
+}
diff --git a/components/msp/CrossTenantJobsTable.tsx b/components/msp/CrossTenantJobsTable.tsx
