diff --git a/app/api/hrm/new-version/route.ts b/app/api/hrm/new-version/route.ts
new file mode 100644
index 000000000..092115fb3
--- /dev/null
+++ b/app/api/hrm/new-version/route.ts
@@ -0,0 +1,56 @@
+// HRM patch 0015: settings for the next version of a custom app, from the job that deployed it.
+
+import { NextRequest, NextResponse } from 'next/server';
+import { getDatabase, isSqliteMode } from '@/lib/db';
+import type { CustomRelease } from '@/lib/hrm/github-releases';
+import { parseAccessToken } from '@/lib/auth-utils';
+import { isCustomAppId, newVersionPrefill } from '@/lib/hrm/new-version';
+
+export async function GET(request: NextRequest) {
+  const user = await parseAccessToken(request.headers.get('Authorization'));
+  if (!user) return NextResponse.json({ error: 'Authentication required' }, { status: 401 });
+
+  const params = new URL(request.url).searchParams;
+  // HRM patch 0020: from App updates, the Intune app of a custom app with a newer GitHub release
+  const appId = params.get('appId');
+  let jobId = params.get('jobId') ?? '';
+  let release: CustomRelease | null = null;
+  if (appId !== null) {
+    if (!/^[0-9a-f-]{36}$/i.test(appId)) return NextResponse.json({ error: 'Invalid app' }, { status: 400 });
+    release = await findRelease(user.tenantId, appId);
+    if (!release) return NextResponse.json({ error: 'No new release found for this app' }, { status: 404 });
+    jobId = release.job_id;
+  }
+  if (!/^[0-9a-f-]{36}$/i.test(jobId)) return NextResponse.json({ error: 'Invalid job' }, { status: 400 });
+
+  const job = await getDatabase().jobs.getById(jobId);
+  // Only this tenant's deployed custom apps; anything else looks like "not found".
+  if (!job || job.tenant_id !== user.tenantId || job.status !== 'deployed' || !isCustomAppId(job.winget_id)) {
+    return NextResponse.json({ error: 'Not a custom app deployed from IntuneGet' }, { status: 404 });
+  }
+  // HRM patch 0021: only the newest version IntuneGet deployed offers "Deploy new version".
+  if (!(await isNewestDeployment(user.tenantId, job.winget_id, job.intune_app_id))) {
+    return NextResponse.json({ error: 'A newer version of this app is already deployed' }, { status: 404 });
+  }
+  release ??= job.intune_app_id ? await findRelease(user.tenantId, job.intune_app_id) : null;
+  const prefill = newVersionPrefill(job);
+  if (release && release.job_id === job.id) {
+    prefill.release = { version: release.version, installerUrl: release.installer_url, sha256: release.installer_sha256, releaseUrl: release.release_url };
+  }
+  return NextResponse.json(prefill, { headers: { 'Cache-Control': 'private, no-store' } });
+}
+
+async function findRelease(tenantId: string, intuneAppId: string): Promise<CustomRelease | null> {
+  if (!isSqliteMode()) return null;
+  const { sqliteCustomReleases } = await import('@/lib/db/sqlite');
+  return sqliteCustomReleases.get(tenantId, intuneAppId);
+}
+
+async function isNewestDeployment(tenantId: string, wingetId: string, intuneAppId: string | null): Promise<boolean> {
+  if (!intuneAppId) return true;
+  const history = await getDatabase().uploadHistory.listAll(2000).catch(() => null);
+  if (!history) return true;
+  // listAll is newest first; history from before upload records existed counts as newest.
+  const newest = history.find((h) => h.intune_tenant_id === tenantId && h.winget_id === wingetId);
+  return !newest || newest.intune_app_id === intuneAppId;
+}
