+import {createHash} from 'node:crypto';
+import {NextRequest,NextResponse} from 'next/server';
+import {parseAccessToken} from '@/lib/auth-utils';
+import {getDatabase,isSqliteMode} from '@/lib/db';
+import {getServicePrincipalToken} from '@/lib/intune/graph-client';
+import {pilotGraph} from '@/lib/hrm/pilot-graph';
+import {dispatchUpdateJob} from '@/lib/hrm/update-dispatch';
+import {assignmentSnapshot,deadlineAssignments,deadlineProblem,canonical,asObject,DEADLINE_HOLD_CODE,AssignmentSettingsReview,type AssignmentTimingReview} from '@/packager/src/assignment-settings';
+const reply=(body:unknown,status=200)=>NextResponse.json(body,{status,headers:{'Cache-Control':'private, no-store'}});
+/** Resume only an owned replacement held before any hosted run started. */
+export async function POST(request:NextRequest){
+ const user=await parseAccessToken(request.headers.get('Authorization'));
+ if(!user)return reply({error:'Authentication required'},401);
+ if(!isSqliteMode())return reply({error:'This review requires SQLite packaging mode.'},409);
+ const body=await request.json().catch(()=>null);
+ if(typeof body?.jobId!=='string')return reply({error:'Choose a held deployment.'},400);
+ const db=getDatabase(),job=await db.jobs.getById(body.jobId);
+ if(!job||job.user_id!==user.userId||job.tenant_id!==user.tenantId)return reply({error:'Deployment not found.'},404);
+ if(job.status!=='failed'||job.error_code!==DEADLINE_HOLD_CODE||job.github_run_id||job.intune_app_id||job.upload_started_at||job.intunewin_url)return reply({error:'This deployment cannot resume here. Use Retry safely to create a fresh review.'},409);
+ const config=asObject(job.package_config),source=config.sourceIntuneAppId||config.replacesIntuneAppId;
+ if(typeof source!=='string'||!source)return reply({error:'The replacement source is missing. Use Retry safely.'},409);
+ try{
+  const token=await getServicePrincipalToken(user.tenantId);if(!token)throw Error('Could not read current Intune assignments.');
+  const snapshot=assignmentSnapshot(await pilotGraph(token).assignments(source));
+  const affected=deadlineAssignments(snapshot);
+  if(!affected.length)return reply({error:'No expired required deadline is present. This is not a deadline confirmation; review assignment settings and create a fresh deployment review.'},409);
+  const reviewToken=createHash('sha256').update(canonical([job.id,job.updated_at,job.package_config,source,snapshot,affected.map(row=>row.id)])).digest('hex');
+  if(body.action!=='confirm')return reply({token:reviewToken,assignments:snapshot,affectedIds:affected.map(row=>row.id)});
+  if(body.token!==reviewToken)return reply({error:'Settings or assignments changed. Refresh the review.'},409);
+  const review:AssignmentTimingReview={sourceAppId:source,expected:snapshot,expiredDates:'keep',deadlineConfirmation:{decision:body.decision,assignmentIds:affected.map(row=>String(row.id)),...(body.decision==='reschedule'?{newDeadline:body.newDeadline}:{})}};
+  const problem=deadlineProblem(snapshot,source,review);if(problem)return reply({error:problem},400);
+  const updated=await db.jobs.update(job.id,{package_config:{...config,assignmentReview:review} as never,status:'queued',error_code:null,error_message:null,error_stage:null,error_category:null,completed_at:null,status_message:null,packager_id:null,packager_heartbeat_at:null,claimed_at:null,packaging_started_at:null},{status:'failed',error_code:DEADLINE_HOLD_CODE,updated_at:job.updated_at});
+  if(!updated)return reply({error:'This deployment changed. Refresh its status before continuing.'},409);
+  if(typeof config.autoUpdateHistoryId==='string')await db.autoUpdateHistory.update(config.autoUpdateHistoryId,{status:'pending',error_message:null,completed_at:null}).catch(()=>console.warn('Could not reopen replacement history; deployment status remains authoritative.'));
+  const result=await dispatchUpdateJob(db,job.id);
+  return reply({resumed:result.dispatched||result.reason==='local-packager',result});
+ }catch(error){return reply({error:error instanceof Error?error.message:'Could not review replacement deadlines.',...(error instanceof AssignmentSettingsReview?{code:error.code}:{})},424);}
+}
