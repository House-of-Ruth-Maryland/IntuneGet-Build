diff --git a/hooks/useNewVersionPrefill.ts b/hooks/useNewVersionPrefill.ts
new file mode 100644
index 000000000..aa092588b
--- /dev/null
+++ b/hooks/useNewVersionPrefill.ts
@@ -0,0 +1,29 @@
+'use client';
+
+// HRM patch 0015: settings for the next version of a custom app.
+
+import { useQuery } from '@tanstack/react-query';
+import { useMicrosoftAuth } from '@/hooks/useMicrosoftAuth';
+import type { NewVersionPrefill } from '@/lib/hrm/new-version';
+
+// HRM patch 0020: or by Intune app (App updates' "Deploy new version" for a new GitHub release)
+export function useNewVersionPrefill(jobId: string | null, appId: string | null = null) {
+  const { getAccessToken, isAuthenticated } = useMicrosoftAuth();
+  return useQuery<NewVersionPrefill | null>({
+    queryKey: ['hrm', 'new-version', jobId, appId],
+    queryFn: async () => {
+      const token = await getAccessToken();
+      if (!token || (!jobId && !appId)) return null;
+      const query = appId ? `appId=${encodeURIComponent(appId)}` : `jobId=${encodeURIComponent(jobId ?? '')}`;
+      const response = await fetch(`/api/hrm/new-version?${query}`, {
+        headers: { Authorization: `Bearer ${token}` },
+      });
+      // Not a custom app (or not ours): no "Deploy new version" offer.
+      if (response.status === 404) return null;
+      if (!response.ok) throw new Error('Could not load the previous version');
+      return response.json();
+    },
+    enabled: isAuthenticated && Boolean(jobId || appId),
+    staleTime: 60_000,
+  });
+}
