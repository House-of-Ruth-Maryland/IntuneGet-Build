+import { describe, expect, it } from 'vitest';
+import type { InventoryListApp } from '@/types/inventory';
+import { findDuplicateGroups, mergeAssignments } from '../duplicates';
+
+const app = (id: string, name: string, created: string, publisher = 'Example'): InventoryListApp => ({
+  id, displayName: name, publisher, description: '', displayVersion: '1.0', createdDateTime: created,
+  lastModifiedDateTime: created, installExperience: null, size: 0, hasIcon: false,
+} as unknown as InventoryListApp);
+
+describe('findDuplicateGroups', () => {
+  it('groups copies by name and publisher, newest first, and ignores single apps', () => {
+    const groups = findDuplicateGroups([
+      app('a', 'Example Browser', '2026-10-23T01:55:00Z'),
+      app('b', 'example  browser ', '2026-10-23T02:42:00Z'),
+      app('c', 'Example Zip', '2026-10-15T00:00:00Z'),
+      app('d', 'Example Browser', '2026-10-01T00:00:00Z', 'Someone Else'),
+    ]);
+    expect(groups).toHaveLength(1);
+    expect(groups[0].copies.map((c) => c.id)).toEqual(['b', 'a']);
+  });
+
+  // HRM patch 0054
+  it('leaves out previous copies waiting for automatic removal, so they are not counted twice', () => {
+    const apps = [app('a', 'Example Browser', '2026-10-01T00:00:00Z'), app('b', 'Example Browser', '2026-10-23T00:00:00Z'), app('c', 'Example Browser', '2026-10-24T00:00:00Z')];
+    expect(findDuplicateGroups(apps.slice(0, 2), (id) => id === 'a')).toEqual([]);
+    expect(findDuplicateGroups(apps, (id) => id === 'a')[0].copies.map((c) => c.id)).toEqual(['c', 'b']);
+  });
+});
+
+describe('mergeAssignments', () => {
+  const group = (id: string, intent: string, extra = {}) => ({
+    id: `assignment-${id}`, intent, target: { '@odata.type': '#microsoft.graph.groupAssignmentTarget', groupId: id }, ...extra,
+  });
+
+  it("keeps the kept copy's groups, adds the others' and drops read-only fields", () => {
+    const merged = mergeAssignments([group('g1', 'required')], [[group('G1', 'available'), group('g2', 'available', { source: 'direct' })]]);
+    expect(merged).toEqual([
+      { '@odata.type': '#microsoft.graph.mobileAppAssignment', intent: 'required', target: { '@odata.type': '#microsoft.graph.groupAssignmentTarget', groupId: 'g1' } },
+      { '@odata.type': '#microsoft.graph.mobileAppAssignment', intent: 'available', target: { '@odata.type': '#microsoft.graph.groupAssignmentTarget', groupId: 'g2' } },
+    ]);
+  });
+
+  it('treats an exclusion and an inclusion of the same group as different', () => {
+    const exclusion = { intent: 'required', target: { '@odata.type': '#microsoft.graph.exclusionGroupAssignmentTarget', groupId: 'g1' } };
+    expect(mergeAssignments([group('g1', 'required')], [[exclusion]])).toHaveLength(2);
+  });
+});
diff --git a/lib/hrm/__tests__/new-version.test.ts b/lib/hrm/__tests__/new-version.test.ts
