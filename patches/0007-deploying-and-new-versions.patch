+    const errorLog = vi.spyOn(console, 'error').mockImplementation(() => {});
+    const response = await POST(callback({ status: 'deployed', intuneAppId: 'app-1' }));
+    expect(response.status).toBe(200);
+    expect((await response.json()).success).toBe(true);
+    await new Promise((resolve) => setTimeout(resolve, 0));
+    expect(errorLog).toHaveBeenCalledWith('[Callback] Deployment webhook error:', expect.any(Error));
+    errorLog.mockRestore();
+  });
+});
+
+// HRM patch 0049: a deployed job corrects the detected updates straight away.
+describe('package callback detected updates', () => {
+  const job = { id: JOB_ID, status: 'uploading', updated_at: '2026-10-24T20:00:00.000Z', package_config: null, user_id: 'u1', tenant_id: 't1', winget_id: 'Vendor.App', version: '2.0.0', display_name: 'Vendor App' };
+
+  it('syncs the new copy and version for a deployed job', async () => {
+    mocks.getById.mockResolvedValue(job);
+    await POST(callback({ status: 'deployed', intuneAppId: 'app-2' }));
+    expect(mocks.syncDeployed).toHaveBeenCalledWith({ userId: 'u1', tenantId: 't1', wingetId: 'Vendor.App', intuneAppId: 'app-2', version: '2.0.0', displayName: 'Vendor App' });
+  });
+
+  it('does not sync for failed or repeated callbacks', async () => {
+    mocks.getById.mockResolvedValue(job);
+    await POST(callback({ status: 'failed', message: 'Upload failed' }));
+    mocks.getById.mockResolvedValue({ ...job, status: 'deployed' });
+    await POST(callback({ status: 'deployed', intuneAppId: 'app-2' }));
+    expect(mocks.syncDeployed).not.toHaveBeenCalled();
+  });
+
+  it('still answers the workflow when the sync fails', async () => {
+    mocks.getById.mockResolvedValue(job);
+    mocks.syncDeployed.mockRejectedValue(new Error('locked'));
+    const errorLog = vi.spyOn(console, 'error').mockImplementation(() => {});
+    const response = await POST(callback({ status: 'deployed', intuneAppId: 'app-2' }));
+    expect(response.status).toBe(200);
+    expect(errorLog).toHaveBeenCalledWith(`[Callback] Failed to refresh detected updates for ${JOB_ID}:`, expect.any(Error));
+    errorLog.mockRestore();
+  });
+
+  // HRM patch 0057
+  it('records a successful sync', async () => {
+    mocks.getById.mockResolvedValue(job);
+    await POST(callback({ status: 'deployed', intuneAppId: 'app-2' }));
+    expect(mocks.recordSync).toHaveBeenCalledWith({ at: expect.any(String), appId: 'Vendor.App', result: 'ok', code: null });
+  });
+
+  it('records a failed sync with a code, never the error text', async () => {
+    mocks.getById.mockResolvedValue(job);
+    mocks.syncDeployed.mockRejectedValue(Object.assign(new Error('database is locked: fixture detail'), { code: 'SQLITE_BUSY' }));
+    const errorLog = vi.spyOn(console, 'error').mockImplementation(() => {});
+    await POST(callback({ status: 'deployed', intuneAppId: 'app-2' }));
+    expect(mocks.recordSync).toHaveBeenCalledWith({ at: expect.any(String), appId: 'Vendor.App', result: 'failed', code: 'database_busy' });
+    expect(JSON.stringify(mocks.recordSync.mock.calls)).not.toContain('fixture detail');
+    errorLog.mockRestore();
+  });
+
+  it('still answers the workflow when recording the result fails', async () => {
+    mocks.getById.mockResolvedValue(job);
+    mocks.recordSync.mockRejectedValue(new Error('disk full'));
+    const errorLog = vi.spyOn(console, 'error').mockImplementation(() => {});
+    const response = await POST(callback({ status: 'deployed', intuneAppId: 'app-2' }));
+    expect(response.status).toBe(200);
+    expect(errorLog).toHaveBeenCalledWith(`[Callback] Failed to record the version sync result for ${JOB_ID}:`, expect.any(Error));
+    errorLog.mockRestore();
+  });
+});
