new file mode 100644
index 000000000..ab1734028
--- /dev/null
+++ b/components/PackageConfig.layout.test.ts
@@ -0,0 +1,125 @@
+// @vitest-environment happy-dom
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { act, createElement } from 'react';
+import { createRoot, type Root } from 'react-dom/client';
+import { DEFAULT_PSADT_CONFIG } from '@/types/psadt';
+import type { Win32CartItem } from '@/types/upload';
+
+vi.hoisted(() => {
+  const values = new Map<string, string>();
+  Object.defineProperty(globalThis, 'localStorage', { configurable: true, value: {
+    getItem: (key: string) => values.get(key) ?? null,
+    setItem: (key: string, value: string) => values.set(key, value),
+    removeItem: (key: string) => values.delete(key),
+  } });
+});
+
+const manifestState = vi.hoisted(() => ({ data: undefined, isFetching: false, error: null as Error | null }));
+vi.mock('@/hooks/use-packages', () => ({
+  useLocaleVariants: () => ({ data: { variants: [] }, isSuccess: true }),
+  usePackageManifest: () => manifestState,
+}));
+vi.mock('@/components/providers/UserSettingsProvider', () => ({ useUserSettings: () => ({ settings: { carryOverAssignments: false } }) }));
+// HRM patch 0024: Save to Intune also saves the new-version choice
+vi.mock('@/hooks/use-updates', () => ({ useUpdatePolicy: () => ({ updatePolicy: vi.fn() }) }));
+vi.mock('@/hooks/useMicrosoftAuth', () => ({ useMicrosoftAuth: () => ({ user: { tenantId: 'tenant-one' } }) }));
+vi.mock('@/hooks/use-update-app-settings', () => ({ useUpdateAppSettings: () => ({ isUpdating: false }) }));
+vi.mock('@/components/AppIcon', () => ({ AppIcon: () => null }));
+vi.mock('@/components/AssignmentConfig', () => ({ AssignmentConfig: () => null }));
+vi.mock('@/components/CategoryConfig', () => ({ CategoryConfig: () => null }));
+vi.mock('@/components/DependencyConfig', () => ({ DependencyConfig: () => null }));
+vi.mock('@/components/EspProfileSelector', () => ({
+  EspProfileSelector: ({ onChange }: { onChange: (v: unknown[]) => void }) =>
+    createElement('button', { onClick: () => onChange([{ id: 'esp-1', displayName: 'Example setup' }]) }, 'Pick setup profile'),
+}));
+vi.mock('@/components/updates/CartUpdatePolicyPicker', () => ({ CartUpdatePolicyPicker: () => null }));
+
+import { PackageConfig } from './PackageConfig';
+import { useCartStore } from '@/stores/cart-store';
+
+// HRM patch 0022: the deploy panel's layout. Fake data only.
+let root: Root;
+(globalThis as typeof globalThis & { IS_REACT_ACT_ENVIRONMENT: boolean }).IS_REACT_ACT_ENVIRONMENT = true;
+const installer = { architecture: 'x64' as const, type: 'msi' as const, url: 'https://example.test/app.msi', sha256: 'B'.repeat(64), scope: 'machine' as const };
+const deployed: Win32CartItem = {
+  id: 'deployed-id', addedAt: '2026-10-09', appSource: 'win32', wingetId: 'Example.App',
+  displayName: 'Example App', publisher: 'Example', version: '2.0', architecture: 'x64', installScope: 'machine',
+  installerType: 'msi', installerUrl: installer.url, installerSha256: 'B'.repeat(64),
+  installCommand: '', uninstallCommand: '', detectionRules: [],
+  psadtConfig: { ...DEFAULT_PSADT_CONFIG, allowDefer: true, deferTimes: 7, processesToClose: [] },
+  categories: [{ id: 'category-id', displayName: 'Productivity' }],
+};
+
+const text = () => document.body.textContent ?? '';
+const button = (label: string) => [...document.querySelectorAll('button')].find((b) => b.textContent?.includes(label));
+
+async function render(props: Record<string, unknown> = {}) {
+  await act(async () => root.render(createElement(PackageConfig, {
+    package: { id: 'Example.App', name: 'Example App', publisher: 'Example', version: '2.0' },
+    installers: [installer], versions: ['2.0'], onClose: vi.fn(), ...props,
+  } as Parameters<typeof PackageConfig>[0])));
+}
+
+beforeEach(() => {
+  useCartStore.setState({ items: [] });
+  const container = document.createElement('div');
+  document.body.append(container);
+  root = createRoot(container);
+});
+afterEach(async () => {
+  await act(async () => root?.unmount());
+  document.body.innerHTML = '';
+});
+
+describe('deploy panel layout', () => {
+  it('shows the main choices, then every other setting as a closed row with its current value', async () => {
+    await render();
+    for (const heading of ['Installs for', 'Who gets it', 'When a new version comes out', 'More settings', 'What staff see during install']) {
+      expect(text()).toContain(heading);
+    }
+    expect(text()).not.toMatch(/Quick|Advanced|more configuration sections/);
+    const rows = [...document.querySelectorAll('button[aria-expanded]')].map((b) => b.textContent);
+    expect(rows).toEqual(expect.arrayContaining([
+      "How Intune checks it's installedAutomatic",
+      'New computer setupNot required',
+      'Replaces or needs other appsNone',
+      'Installation timingSilent, no restart',
+      'Letting staff postponeOff',
+      'Install window brandingDefault',
+    ]));
+    expect(document.querySelectorAll('button[aria-expanded="true"]')).toHaveLength(0);
+  });
+
+  it('keeps every setting reachable: opening a row shows its options', async () => {
+    await render();
+    await act(async () => button('Letting staff postpone')!.click());
+    expect(text()).toContain('Let staff postpone the install');
+    await act(async () => button('Installation timing')!.click());
+    expect(text()).toContain('What staff see while it installs');
+    expect(text()).toContain('Remove existing installation first');
+  });
+
+  it("summarises a deployed app's current settings", async () => {
+    await render({ isDeployed: true, deployedConfig: deployed });
+    const rows = [...document.querySelectorAll('button[aria-expanded]')].map((b) => b.textContent);
+    expect(rows).toContain('Letting staff postponeUp to 7 times');
+    expect(rows).toContain('Company Portal categoryProductivity');
+    expect(text()).toContain('Editing a deployed app');
+  });
+
+  it('sends a new computer setup change through Deploy again, not Save to Intune', async () => {
+    await render({ isDeployed: true, deployedConfig: deployed, intuneAppId: '00000000-0000-0000-0000-00000000000a' });
+    await act(async () => button('New computer setup')!.click());
+    await act(async () => button('Pick setup profile')!.click());
+    expect((button('Save to Intune') as HTMLButtonElement).disabled).toBe(true);
+    expect(text()).toContain('These changes need the app deployed again');
+    expect(button('Deploy again')).toBeDefined();
+  });
+
+  // HRM patch 0024
+  it('makes Deploy again replace the current copy', async () => {
+    await render({ isDeployed: true, deployedConfig: deployed, intuneAppId: '00000000-0000-0000-0000-00000000000a' });
+    await act(async () => button('Deploy again')!.click());
+    expect(useCartStore.getState().items[0]).toMatchObject({ forceCreate: true, replacesIntuneAppId: '00000000-0000-0000-0000-00000000000a' });
+  });
+});
