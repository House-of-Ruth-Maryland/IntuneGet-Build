@@ -0,0 +1,88 @@
+import { describe, expect, it } from 'vitest';
+import { buildIntuneAppDescription } from '@/lib/intune-description';
+import { isCustomAppId, isNewerVersion, jobIdFromNotes, newVersionPrefill, newVersionReplacement, switchesFromInstallCommand } from '../new-version';
+
+const JOB_ID = '46f79300-d116-40c4-9650-a288efb35f42';
+const job = (over: Record<string, unknown> = {}) => ({
+  id: JOB_ID, tenant_id: 'tenant-1', winget_id: 'Custom.ContosoLtd.ContosoEditor', status: 'deployed',
+  display_name: 'Contoso Editor', publisher: 'Contoso Ltd', version: '1.2.0', architecture: 'x64',
+  installer_type: 'msi', install_scope: 'machine', intune_app_id: 'intune-app-1',
+  install_command: 'msiexec /i "contoso-editor-1.2.0-x64.msi" /qn /norestart DESKTOPSHORTCUT=0 ALLUSERS=1',
+  uninstall_command: 'REGISTRY_UNINSTALL:Contoso Editor',
+  package_config: {
+    description: 'Editor for example files.', iconPath: 'https://example.test/icon.png',
+    assignments: [{ type: 'group', groupId: 'group-1', groupName: 'USR-Example', intent: 'required' }],
+  },
+  ...over,
+}) as never;
+
+describe('new version of a custom app', () => {
+  it('reads the deploying job from the Intune app notes', () => {
+    expect(jobIdFromNotes(`IntuneGet deployment job: ${JOB_ID}`)).toBe(JOB_ID);
+    expect(jobIdFromNotes('Deployed by hand')).toBeNull();
+    expect(jobIdFromNotes(null)).toBeNull();
+  });
+
+  it('recovers the installer switches from the install command', () => {
+    expect(switchesFromInstallCommand('msiexec /i "app.msi" /qn /norestart X=0')).toBe('/qn /norestart X=0');
+    expect(switchesFromInstallCommand('"setup 1.0.exe" /S /D=C:\\Apps')).toBe('/S /D=C:\\Apps');
+    expect(switchesFromInstallCommand('setup.exe')).toBe('');
+    expect(switchesFromInstallCommand(null)).toBe('');
+  });
+
+  it('prefills everything but the version and link, and keeps the groups and supersedence', () => {
+    const prefill = newVersionPrefill(job());
+    expect(prefill).toMatchObject({
+      jobId: JOB_ID, previousVersion: '1.2.0',
+      input: { displayName: 'Contoso Editor', publisher: 'Contoso Ltd', installerType: 'msi', architecture: 'x64', installScope: 'machine',
+        silentSwitches: '/qn /norestart DESKTOPSHORTCUT=0 ALLUSERS=1', uninstallCommand: '', description: 'Editor for example files.',
+        iconUrl: 'https://example.test/icon.png' },
+      assignments: [{ groupName: 'USR-Example', intent: 'required' }],
+      supersede: { relationshipType: 'supersedence', supersedenceType: 'update', targetId: 'intune-app-1', targetVersion: '1.2.0' },
+    });
+    expect(prefill.input).not.toHaveProperty('version');
+    expect(newVersionPrefill(job({ uninstall_command: 'contoso.exe --remove' })).input.uninstallCommand).toBe('contoso.exe --remove');
+    expect(newVersionPrefill(job({ intune_app_id: null })).supersede).toBeNull();
+  });
+
+  it('tells a newer version from a real duplicate', () => {
+    expect(isNewerVersion('0.10.1', '0.15.0')).toBe(true);
+    expect(isNewerVersion('0.15.0', '0.15.0')).toBe(false);
+    expect(isNewerVersion('2.0', '1.9')).toBe(false);
+    expect(isNewerVersion(null, '1.0')).toBe(false);
+    expect(isCustomAppId('Custom.ContosoLtd.ContosoEditor')).toBe(true);
+    expect(isCustomAppId('Google.Chrome')).toBe(false);
+  });
+
+  it('describes custom apps as custom installers, not WinGet', () => {
+    expect(buildIntuneAppDescription({ fallback: 'Deployed via IntuneGet from Winget: Custom.ContosoLtd.ContosoEditor' }))
+      .toBe('Deployed via IntuneGet (custom installer): Custom.ContosoLtd.ContosoEditor\nSource: IntuneGet.com');
+    expect(buildIntuneAppDescription({ fallback: 'Deployed via IntuneGet from Winget: Google.Chrome' }))
+      .toBe('Deployed via IntuneGet from Winget: Google.Chrome\nSource: IntuneGet.com');
+  });
+});
+
+// HRM patch 0050: Deploy new version replaces the previous copy like Update and Deploy again.
+describe('new version replaces the previous copy', () => {
+  const INTUNE_ID = '00000000-0000-4000-8000-00000000000a';
+  it('sends the replace inputs: no groups listed, so the current groups move and the previous copy is superseded', async () => {
+    const { replacementInputs } = await import('../replacement');
+    const fields = newVersionReplacement(newVersionPrefill(job({ intune_app_id: INTUNE_ID })));
+    expect(fields).toEqual({ assignments: [], replacesIntuneAppId: INTUNE_ID, forceCreate: true });
+    // No explicit relationship: the workflow's own supersedence (update) covers it once.
+    expect(fields).not.toHaveProperty('relationships');
+    expect(replacementInputs(fields)).toEqual({
+      sourceIntuneAppId: INTUNE_ID, carryOverAssignments: true, removeAssignmentsFromPreviousApp: true, autoSupersede: true, supersedenceType: 'update',
+    });
+  });
+  it('keeps the saved groups and explicit supersedence when the previous ID is not an Intune app ID', () => {
+    expect(newVersionReplacement(newVersionPrefill(job()))).toMatchObject({
+      assignments: [{ groupId: 'group-1' }], relationships: [{ relationshipType: 'supersedence', targetId: 'intune-app-1' }], forceCreate: true,
+    });
+    expect(newVersionReplacement(newVersionPrefill(job()))).not.toHaveProperty('replacesIntuneAppId');
+  });
+  it('does nothing without a previous copy', () => {
+    expect(newVersionReplacement(newVersionPrefill(job({ intune_app_id: null })))).toBeNull();
+    expect(newVersionReplacement(undefined)).toBeNull();
+  });
+});
diff --git a/lib/hrm/deploy-review.ts b/lib/hrm/deploy-review.ts
new file mode 100644
index 000000000..ed76e5448
--- /dev/null
+++ b/lib/hrm/deploy-review.ts
@@ -0,0 +1,89 @@
+/**
+ * HRM patch 0025: what Deploy to Intune is about to do, one line per app.
+ * Plain words, worked out from the cart item only (no network).
+ */
+
+import type { CartItem, PackageAssignment } from '@/types/upload';
+import { removalGroupProblems, removalOf } from './removal';
+
+export interface ReviewRow {
+  id: string;
+  title: string;
+  /** What happens in Intune */
+  action: string;
+  /** Who gets it */
+  groups: string;
+  /** How it installs, for Win32 apps */
+  install?: string;
+  /** What happens with new versions, for Win32 apps */
+  updates?: string;
+  warnings: string[];
+}
+
+const INTENT: Record<PackageAssignment['intent'], string> = {
+  required: 'Required',
+  available: 'Available',
+  uninstall: 'Uninstall',
+  updateOnly: 'Update only',
+};
+
+function target(a: PackageAssignment): string {
+  if (a.type === 'allDevices') return 'All devices';
+  if (a.type === 'allUsers') return 'All users';
+  const name = a.groupName || 'a group';
+  return a.type === 'exclusionGroup' ? `Not ${name}` : name;
+}
+
+export function describeAssignments(assignments: PackageAssignment[] | undefined): string {
+  const list = assignments ?? [];
+  if (list.length === 0) return 'No groups';
+  return list.map((a) => (a.type === 'exclusionGroup' ? target(a) : `${target(a)} · ${INTENT[a.intent] ?? a.intent}`)).join(', ');
+}
+
+export function reviewRow(item: CartItem): ReviewRow {
+  // HRM patch 0040: a removal only uninstalls, so it gets its own plain description.
+  const removal = removalOf(item);
+  if (removal) {
+    const assignments = 'assignments' in item ? item.assignments : undefined;
+    return {
+      id: item.id, title: item.displayName,
+      action: `Adds it to Intune only to uninstall "${removal.discoveredName}"`,
+      groups: describeAssignments(assignments),
+      install: `Computers in these groups uninstall "${removal.discoveredName}". Nothing is installed. Inventory shows how many still have it.`,
+      updates: 'Updates: Ignore',
+      warnings: removalGroupProblems(assignments),
+    };
+  }
+  const warnings: string[] = [];
+  const version = 'version' in item && item.version ? ` ${item.version}` : '';
+  const assignments = 'assignments' in item ? item.assignments : undefined;
+  const includes = (assignments ?? []).filter((a) => a.type !== 'exclusionGroup');
+  const replaces = item.appSource === 'win32' && Boolean(item.replacesIntuneAppId);
+  // HRM patch 0050: a replacement with no groups listed takes the current copy's groups from Intune.
+  const takesCurrentGroups = replaces && (assignments ?? []).length === 0;
+  if (includes.length === 0 && !takesCurrentGroups) warnings.push("No groups: it won't install anywhere until a group is assigned.");
+
+  const supersedes = (item.relationships ?? []).some((r) => r.relationshipType === 'supersedence');
+  let action: string;
+  if (replaces) action = 'Replaces the current copy in Intune and moves its groups to this one';
+  else if (supersedes) action = 'Replaces the previous version in Intune';
+  else if (item.forceCreate) {
+    action = 'Adds another copy to Intune';
+    warnings.push('Intune will have two copies of this app. Later, press Keep this copy in Inventory to pick one.');
+  } else action = 'Adds it to Intune';
+
+  const row: ReviewRow = { id: item.id, title: `${item.displayName}${version}`, action, groups: takesCurrentGroups ? 'The groups the current copy has in Intune' : describeAssignments(assignments), warnings };
+  if (item.appSource === 'win32') {
+    const config = item.psadtConfig;
+    const mode = { Silent: 'Installs silently', NonInteractive: 'Shows a progress window', Auto: 'The installer decides what staff see' }[
+      config?.deployMode || 'Silent'
+    ];
+    const restart = { Suppress: "doesn't restart", Prompt: 'asks staff to restart', Force: 'restarts the computer' }[config?.restartBehavior ?? 'Suppress'];
+    row.install = `${mode ?? 'Installs silently'}, ${restart ?? "doesn't restart"}`;
+    // HRM patch 0036: the same policy names as the cart picker and App updates (UPDATE_POLICY_LABELS).
+    row.updates = item.updatePolicy === 'auto_update' ? 'Updates: Auto-update' : item.updatePolicy === 'ignore' ? 'Updates: Ignore' : 'Updates: Notify only';
+  } else {
+    row.install = 'From the Microsoft Store';
+  }
+  return row;
+}
diff --git a/lib/hrm/deployment-status.ts b/lib/hrm/deployment-status.ts
new file mode 100644
index 000000000..c4ad1c9ab
--- /dev/null
+++ b/lib/hrm/deployment-status.ts
@@ -0,0 +1,41 @@
+/** Shared display/archival groups. Cancellation is a distinct finished outcome. */
+export const DEPLOYMENT_FILTERS = ['all', 'active', 'completed', 'failed', 'cancelled'] as const;
+export type DeploymentFilter = typeof DEPLOYMENT_FILTERS[number];
+export const ACTIVE_DEPLOYMENT_STATUSES: readonly string[] = ['blocked_upstream', 'awaiting_qa', 'queued', 'packaging', 'uploading'];
+export const COMPLETED_DEPLOYMENT_STATUSES: readonly string[] = ['completed', 'deployed', 'duplicate_skipped'];
+export const FAILED_DEPLOYMENT_STATUSES: readonly string[] = ['failed', 'qa_failed'];
+export const TERMINAL_DEPLOYMENT_STATUSES: readonly string[] = [...COMPLETED_DEPLOYMENT_STATUSES, ...FAILED_DEPLOYMENT_STATUSES, 'cancelled'];
+export const isActiveDeployment = (status: string) => ACTIVE_DEPLOYMENT_STATUSES.includes(status);
+export const isTerminalDeployment = (status: string) => TERMINAL_DEPLOYMENT_STATUSES.includes(status);
+export function deploymentFilter(value: string | null): DeploymentFilter {
+  if (value === 'pending') return 'active';
+  return DEPLOYMENT_FILTERS.includes(value as DeploymentFilter) ? value as DeploymentFilter : 'all';
+}
+export function matchesDeploymentFilter(status: string, filter: DeploymentFilter): boolean {
+  if (filter === 'all') return true;
+  if (filter === 'active') return isActiveDeployment(status);
+  if (filter === 'completed') return COMPLETED_DEPLOYMENT_STATUSES.includes(status);
+  if (filter === 'failed') return FAILED_DEPLOYMENT_STATUSES.includes(status);
+  return status === 'cancelled';
+}
+export function deploymentCounts(jobs: { status: string }[]) {
+  return { total: jobs.length, active: jobs.filter(j => isActiveDeployment(j.status)).length,
+    completed: jobs.filter(j => COMPLETED_DEPLOYMENT_STATUSES.includes(j.status)).length,
+    failed: jobs.filter(j => FAILED_DEPLOYMENT_STATUSES.includes(j.status)).length,
+    cancelled: jobs.filter(j => j.status === 'cancelled').length };
+}
+/** Clearing a filtered list never hides a different finished outcome. */
+export const clearableDeploymentStatuses = (filter: DeploymentFilter) => TERMINAL_DEPLOYMENT_STATUSES.filter(status => matchesDeploymentFilter(status, filter));
+
+// HRM patch 0049: the cached screens a finished deployment changes (App updates, its sidebar badge,
+// Home, Inventory and App catalog's deployed marks). Deployments refreshes them when a job it was
+// watching finishes, so they show the new version without waiting for their own refresh.
+export const DEPLOYMENT_FINISHED_QUERY_KEYS: readonly (readonly string[])[] = [
+  ['availableUpdates'], ['autoUpdateHistory'], ['updatePolicies'], ['inventory', 'apps'], ['catalog', 'deployed'], ['hrm', 'home'],
+  // HRM patch 0054: the copy a deployment replaced is labelled "Previous copy" in Inventory.
+  ['hrm', 'previous-copies'],
+];
+export function hasNewlyFinishedDeployment(previous: { id: string; status: string }[], next: { id: string; status: string }[]): boolean {
+  const wasActive = new Set(previous.filter(job => isActiveDeployment(job.status)).map(job => job.id));
+  return next.some(job => wasActive.has(job.id) && isTerminalDeployment(job.status));
+}
diff --git a/lib/hrm/dispatch-failure.ts b/lib/hrm/dispatch-failure.ts
new file mode 100644
index 000000000..57e9b3a8e
--- /dev/null
+++ b/lib/hrm/dispatch-failure.ts
@@ -0,0 +1,14 @@
+import { InstallerPreflightError } from '@/lib/installer-preflight';
+
+/**
+ * HRM patch 0031: how a job that never started is recorded. Upstream recorded every failure to start
+ * as an authentication/network failure. An installer that failed its pre-packaging check (changed
+ * bytes, version withdrawn from WinGet) is a validation outcome with its own code, so the deployment
+ * card shows the real stage and reason.
+ */
+export function dispatchFailureFields(error: unknown): { error_stage: string; error_category: string; error_code: string } {
+  if (error instanceof InstallerPreflightError) {
+    return { error_stage: 'validation', error_category: error.retryable ? 'network' : 'validation', error_code: error.code };
+  }
+  return { error_stage: 'authenticate', error_category: 'network', error_code: 'WORKFLOW_DISPATCH_FAILED' };
+}
diff --git a/lib/hrm/duplicates.ts b/lib/hrm/duplicates.ts
new file mode 100644
index 000000000..5eb8d95b4
--- /dev/null
+++ b/lib/hrm/duplicates.ts
@@ -0,0 +1,78 @@
+/**
+ * HRM patch 0025: apps with more than one copy in Intune.
+ *
+ * Copies are Win32 apps with the same name and publisher (a second
+ * "Deploy as new app anyway", or a redeploy before patch 0024). "Keep this
+ * copy" moves every group from the other copies onto the kept one and leaves
+ * the others with no groups, so nothing is installed twice. Deleting an
+ * emptied copy is a separate, confirmed step.
+ */
+
+import type { InventoryListApp } from '@/types/inventory';
+
+export interface DuplicateGroup {
+  key: string;
+  displayName: string;
+  publisher: string;
+  /** Newest first */
+  copies: InventoryListApp[];
+}
+
+const norm = (value: string | null | undefined) => (value ?? '').trim().toLowerCase().replace(/\s+/g, ' ');
+
+export function duplicateKey(app: Pick<InventoryListApp, 'displayName' | 'publisher'>): string {
+  return `${norm(app.displayName)}|${norm(app.publisher)}`;
+}
+
+/**
+ * HRM patch 0054: `waiting` leaves out copies IntuneGet replaced and old-copy cleanup (patch 0042) is still
+ * due to remove. Inventory labels those "Previous copy", so they aren't listed here as well. A copy cleanup
+ * is keeping for a person stays here, because its reason points to Keep this copy.
+ */
+export function findDuplicateGroups(apps: InventoryListApp[], waiting?: (appId: string) => boolean): DuplicateGroup[] {
+  const byKey = new Map<string, InventoryListApp[]>();
+  for (const app of apps) {
+    if (!norm(app.displayName)) continue;
+    if (waiting?.(app.id)) continue;
+    const key = duplicateKey(app);
+    byKey.set(key, [...(byKey.get(key) ?? []), app]);
+  }
+  return [...byKey.entries()]
+    .filter(([, copies]) => copies.length > 1)
+    .map(([key, copies]) => ({
+      key,
+      displayName: copies[0].displayName,
+      publisher: copies[0].publisher ?? '',
+      copies: [...copies].sort((a, b) => Date.parse(b.createdDateTime) - Date.parse(a.createdDateTime)),
+    }))
+    .sort((a, b) => a.displayName.localeCompare(b.displayName));
+}
+
+/** An Intune app assignment as Graph returns it. */
+export interface GraphAssignment {
+  id?: string;
+  intent: string;
+  target: { '@odata.type'?: string; groupId?: string; [key: string]: unknown };
+  settings?: unknown;
+  [key: string]: unknown;
+}
+
+function targetKey(a: GraphAssignment): string {
+  return `${a.target?.['@odata.type'] ?? ''}|${(a.target?.groupId ?? '').toLowerCase()}`;
+}
+
+/**
+ * The kept copy's assignments plus any target only the other copies have.
+ * Where both target the same group, the kept copy's choice wins. Read-only
+ * fields are dropped so the list can be sent to Intune's assign action.
+ */
+export function mergeAssignments(keep: GraphAssignment[], others: GraphAssignment[][]): GraphAssignment[] {
+  const merged = new Map<string, GraphAssignment>();
+  for (const a of [...keep, ...others.flat()]) {
+    const key = targetKey(a);
+    if (merged.has(key)) continue;
+    const { id: _id, source: _source, sourceId: _sourceId, ...rest } = a as GraphAssignment & { source?: unknown; sourceId?: unknown };
+    merged.set(key, { ...rest, '@odata.type': '#microsoft.graph.mobileAppAssignment' });
+  }
+  return [...merged.values()];
+}
diff --git a/lib/hrm/new-version.ts b/lib/hrm/new-version.ts
new file mode 100644
index 000000000..818619504
--- /dev/null
+++ b/lib/hrm/new-version.ts
@@ -0,0 +1,101 @@
+/**
+ * HRM patch 0015: deploying a new version of a custom app.
+ *
+ * A custom app (an installer that isn't in WinGet) has no catalog entry to
+ * update from. Its last IntuneGet deployment has everything a new version
+ * needs except the version and download link: the installer settings, the
+ * groups, and the Intune app the new version should supersede.
+ */
+
+import type { PackagingJob } from '@/lib/db/types';
+import type { CustomAppInput, CustomInstallerType } from '@/lib/custom-app';
+import type { PackageAssignment } from '@/types/upload';
+import type { AppRelationship } from '@/types/intune';
+import { compareVersions } from '@/lib/version-compare';
+
+export interface NewVersionPrefill {
+  jobId: string;
+  previousVersion: string;
+  input: Omit<CustomAppInput, 'version' | 'installerUrl' | 'sha256'>;
+  assignments: PackageAssignment[];
+  supersede: AppRelationship | null;
+  // HRM patch 0020: a newer GitHub release, when the update check found one
+  release?: { version: string; installerUrl: string; sha256: string | null; releaseUrl: string };
+}
+
+const INSTALLER_TYPES: CustomInstallerType[] = ['exe', 'msi', 'inno', 'nullsoft', 'burn'];
+
+export function isCustomAppId(wingetId: string | null | undefined): boolean {
+  return /^Custom\./.test(wingetId ?? '');
+}
+
+/** The IntuneGet job an Intune app was deployed by, from the app's notes. */
+export function jobIdFromNotes(notes: string | null | undefined): string | null {
+  return /IntuneGet deployment job:\s*([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})/i.exec(notes ?? '')?.[1] ?? null;
+}
+
+/** The switches after the installer itself: `msiexec /i "x.msi" /qn` -> `/qn`, `"setup.exe" /S` -> `/S`. */
+export function switchesFromInstallCommand(command: string | null | undefined): string {
+  const text = (command ?? '').trim();
+  const msi = /^msiexec(?:\.exe)?\s+\/i\s+(?:"[^"]*"|\S+)\s*(.*)$/i.exec(text);
+  if (msi) return msi[1].trim();
+  const exe = /^(?:"[^"]*"|\S+)\s*(.*)$/.exec(text);
+  return exe ? exe[1].trim() : '';
+}
+
+/** IntuneGet's generated uninstall commands are left out so they are generated again for the new installer. */
+function customUninstall(command: string | null | undefined): string {
+  const text = (command ?? '').trim();
+  if (!text || /^REGISTRY_UNINSTALL:/i.test(text) || /^msiexec(?:\.exe)?\s+\/x\b/i.test(text)) return '';
+  return text;
+}
+
+export function newVersionPrefill(job: PackagingJob): NewVersionPrefill {
+  const config = (job.package_config ?? {}) as Record<string, unknown>;
+  const type = (job.installer_type ?? 'exe') as CustomInstallerType;
+  const assignments = Array.isArray(config.assignments) ? (config.assignments as PackageAssignment[]) : [];
+  return {
+    jobId: job.id,
+    previousVersion: job.version,
+    input: {
+      displayName: job.display_name,
+      publisher: job.publisher || '',
+      installerType: INSTALLER_TYPES.includes(type) ? type : 'exe',
+      architecture: (job.architecture || 'x64') as CustomAppInput['architecture'],
+      installScope: job.install_scope === 'user' ? 'user' : 'machine',
+      silentSwitches: switchesFromInstallCommand(job.install_command),
+      uninstallCommand: customUninstall(job.uninstall_command),
+      description: typeof config.description === 'string' ? config.description : '',
+      iconUrl: typeof config.iconPath === 'string' ? config.iconPath : '',
+    },
+    assignments,
+    supersede: job.intune_app_id
+      ? { relationshipType: 'supersedence', supersedenceType: 'update', targetId: job.intune_app_id,
+          targetDisplayName: job.display_name, targetVersion: job.version }
+      : null,
+  };
+}
+
+const GUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
+
+/**
+ * HRM patch 0050: the cart fields that make a new version replace the previous copy, with the same workflow
+ * inputs as Update and Deploy again (patch 0024): no groups listed, so the workflow moves the previous copy's
+ * current groups to the new copy and removes them from the previous one, then supersedes it (update).
+ * The supersedence comes from the replacement, so no separate relationship is sent.
+ */
+export function newVersionReplacement(prefill: Pick<NewVersionPrefill, 'assignments' | 'supersede'> | null | undefined):
+  { assignments: PackageAssignment[]; replacesIntuneAppId?: string; relationships?: AppRelationship[]; forceCreate: true } | null {
+  const supersede = prefill?.supersede;
+  if (!supersede?.targetId) return null;
+  // The previous version is meant to exist in Intune; don't stop at "duplicate found".
+  if (GUID.test(supersede.targetId)) return { assignments: [], replacesIntuneAppId: supersede.targetId, forceCreate: true };
+  // Not an Intune app ID: keep the saved groups and the explicit supersedence, as before.
+  return { assignments: prefill?.assignments ?? [], relationships: [supersede], forceCreate: true };
+}
+
+/** Whether a "duplicate" is really a newer version of the app already in Intune. */
+export function isNewerVersion(existingVersion: string | null | undefined, version: string | null | undefined): boolean {
+  if (!existingVersion || !version) return false;
+  return compareVersions(version, existingVersion) > 0;
+}
