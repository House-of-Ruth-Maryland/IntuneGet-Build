+import { NextRequest } from 'next/server';
+import { beforeEach, describe, expect, it, vi } from 'vitest';
+
+const mocks = vi.hoisted(() => ({ auth: vi.fn(), token: vi.fn(), insightsFamily: vi.fn(), insightsObserve: vi.fn() }));
+vi.mock('@/lib/auth-utils', () => ({ parseAccessToken: mocks.auth }));
+vi.mock('@/lib/intune/graph-client', () => ({ GRAPH_API_BASE: 'https://graph.example.test/v1.0', getServicePrincipalToken: mocks.token }));
+vi.mock('@/lib/db', () => ({ isSqliteMode: () => true }));
+vi.mock('@/lib/db/sqlite', () => ({ sqlitePilotRollouts: { holdsApp: () => false }, sqliteAppInsights: { family: mocks.insightsFamily, observe: mocks.insightsObserve } }));
+import { POST } from './route';
+
+const KEEP = '00000000-0000-0000-0000-00000000000a';
+const OTHER = '00000000-0000-0000-0000-00000000000b';
+const STRANGER = '00000000-0000-0000-0000-00000000000c';
+const group = (id: string, intent = 'required') => ({ id: `as-${id}`, intent, target: { '@odata.type': '#microsoft.graph.groupAssignmentTarget', groupId: id } });
+
+let apps: Record<string, { displayName: string; publisher: string; type?: string; assignments: unknown[] }>;
+let calls: Array<{ method: string; url: string; body?: unknown }>;
+let links: Record<string, Array<Record<string, unknown>>>;
+let deleteStatus: number;
+
+beforeEach(() => {
+  mocks.insightsObserve.mockClear();
+  mocks.insightsFamily.mockReturnValue('Example.App');
+  mocks.auth.mockResolvedValue({ userId: 'user-1', tenantId: 'tenant-1' });
+  mocks.token.mockResolvedValue('token');
+  apps = {
+    [KEEP]: { displayName: 'Example Browser', publisher: 'Example', assignments: [group('g1')] },
+    [OTHER]: { displayName: 'Example Browser', publisher: 'Example', assignments: [group('g2', 'available')] },
+    [STRANGER]: { displayName: 'Something Else', publisher: 'Example', assignments: [] },
+  };
+  calls = [];
+  links = {};
+  deleteStatus = 204;
+  vi.stubGlobal('fetch', vi.fn(async (url: string, init?: RequestInit) => {
+    const method = init?.method ?? 'GET';
+    calls.push({ method, url, body: init?.body ? JSON.parse(String(init.body)) : undefined });
+    const m = /mobileApps\/([0-9a-f-]+)(\/(assignments|assign|relationships|updateRelationships))?$/.exec(url)!;
+    const app = apps[m[1]];
+    if (!app) return new Response('', { status: 404 });
+    if (m[3] === 'relationships') return Response.json({ value: links[m[1]] ?? [] });
+    if (m[3] === 'updateRelationships') return new Response(null, { status: 204 });
+    if (method === 'DELETE') return deleteStatus === 204 ? new Response(null, { status: 204 }) : Response.json({ error: { message: 'Example refusal' } }, { status: deleteStatus });
+    if (m[3] === 'assign') return new Response(null, { status: 204 });
+    if (m[3] === 'assignments') return Response.json({ value: app.assignments });
+    return Response.json({ id: m[1], displayName: app.displayName, publisher: app.publisher, '@odata.type': app.type ?? '#microsoft.graph.win32LobApp' });
+  }));
+});
+
+const post = (body: unknown) => POST(new NextRequest('http://localhost/api/hrm/duplicates', { method: 'POST', body: JSON.stringify(body) }));
+
+describe('duplicates route', () => {
+  it('requires sign-in and valid IDs', async () => {
+    mocks.auth.mockResolvedValue(null);
+    expect((await post({ action: 'keep', keepId: KEEP, otherIds: [OTHER] })).status).toBe(401);
+    mocks.auth.mockResolvedValue({ userId: 'user-1', tenantId: 'tenant-1' });
+    expect((await post({ action: 'keep', keepId: 'x', otherIds: [OTHER] })).status).toBe(400);
+    expect((await post({ action: 'keep', keepId: KEEP, otherIds: [KEEP] })).status).toBe(400);
+  });
+
+  it('moves every group onto the kept copy first, then empties the other copy', async () => {
+    const response = await post({ action: 'keep', keepId: KEEP, otherIds: [OTHER] });
+    expect(response.status).toBe(200);
+    const writes = calls.filter((c) => c.method === 'POST');
+    expect(writes.map((c) => c.url.split('/mobileApps/')[1])).toEqual([`${KEEP}/assign`, `${OTHER}/assign`]);
+    expect((writes[0].body as { mobileAppAssignments: unknown[] }).mobileAppAssignments).toHaveLength(2);
+    expect(writes[1].body).toEqual({ mobileAppAssignments: [] });
+    expect(mocks.insightsObserve).toHaveBeenCalledWith('tenant-1', expect.objectContaining({ appId: KEEP, assignments: expect.any(Array) }), 'Saved in IntuneGet by a staff member', true);
+    expect(mocks.insightsObserve).toHaveBeenCalledWith('tenant-1', expect.objectContaining({ appId: OTHER, assignments: [] }), 'Saved in IntuneGet by a staff member', true);
+    expect(await response.json()).toMatchObject({ kept: KEEP, groups: 2, cleared: [OTHER] });
+  });
+
+  it('refuses apps that are not copies of the same Win32 app', async () => {
+    expect((await post({ action: 'keep', keepId: KEEP, otherIds: [STRANGER] })).status).toBe(409);
+    apps[OTHER].type = '#microsoft.graph.winGetApp';
+    expect((await post({ action: 'keep', keepId: KEEP, otherIds: [OTHER] })).status).toBe(409);
+    expect(calls.some((c) => c.method === 'POST')).toBe(false);
+  });
+
+  it('deletes only an emptied copy of the same app', async () => {
+    expect((await post({ action: 'delete', keepId: KEEP, id: OTHER })).status).toBe(409);
+    apps[OTHER].assignments = [];
+    expect((await post({ action: 'delete', keepId: KEEP, id: STRANGER })).status).toBe(409);
+    expect((await post({ action: 'delete', keepId: KEEP, id: KEEP })).status).toBe(400);
+    const response = await post({ action: 'delete', keepId: KEEP, id: OTHER });
+    expect(response.status).toBe(200);
+    expect(calls.filter((c) => c.method === 'DELETE').map((c) => c.url)).toEqual([`https://graph.example.test/v1.0/deviceAppManagement/mobileApps/${OTHER}`]);
+  });
+
+  // HRM patch 0026
+  const supersedes = (targetId: string, targetType: 'child' | 'parent', name = 'Example Browser') =>
+    ({ '@odata.type': '#microsoft.graph.mobileAppSupersedence', targetId, targetType, targetDisplayName: name, supersedenceType: 'update' });
+
+  it('removes the link from the copy that replaces it, then deletes', async () => {
+    apps[OTHER].assignments = [];
+    links[KEEP] = [supersedes(OTHER, 'child'), { '@odata.type': '#microsoft.graph.mobileAppDependency', targetId: 'dep', targetType: 'child', dependencyType: 'autoInstall' }];
+    links[OTHER] = [supersedes(KEEP, 'parent')];
+    const response = await post({ action: 'delete', keepId: KEEP, id: OTHER, copyIds: [KEEP, OTHER] });
+    expect(response.status).toBe(200);
+    const update = calls.find((c) => c.url.endsWith(`${KEEP}/updateRelationships`))!;
+    expect(update.url).toContain('/beta/');
+    expect(update.body).toEqual({ relationships: [{ '@odata.type': '#microsoft.graph.mobileAppDependency', targetId: 'dep', dependencyType: 'autoInstall' }] });
+    expect(calls.findIndex((c) => c.method === 'DELETE')).toBeGreaterThan(calls.indexOf(update));
+    expect(await response.json()).toMatchObject({ deleted: OTHER, unlinked: ['Example Browser'] });
+  });
+
+  it('refuses when a different app replaces or depends on the copy', async () => {
+    apps[OTHER].assignments = [];
+    links[OTHER] = [supersedes(STRANGER, 'parent', 'Something Else')];
+    const response = await post({ action: 'delete', keepId: KEEP, id: OTHER, copyIds: [KEEP, OTHER, STRANGER] });
+    expect(response.status).toBe(409);
+    expect((await response.json()).error).toContain('Something Else replaces or depends on this copy');
+    expect(calls.some((c) => c.method !== 'GET')).toBe(false);
+  });
+
+  it("passes on Intune's reason with a status Cloudflare doesn't replace", async () => {
+    apps[OTHER].assignments = [];
+    deleteStatus = 400;
+    const response = await post({ action: 'delete', keepId: KEEP, id: OTHER, copyIds: [KEEP, OTHER] });
+    expect(response.status).toBe(424);
+    expect((await response.json()).error).toBe("Intune didn't delete it. Intune said: Example refusal");
+  });
+});
diff --git a/app/api/hrm/duplicates/route.ts b/app/api/hrm/duplicates/route.ts
new file mode 100644
index 000000000..70887f0ad
--- /dev/null
+++ b/app/api/hrm/duplicates/route.ts
@@ -0,0 +1,105 @@
+// HRM patch 0025: tidy up apps with more than one copy in Intune.
+//   { action: 'keep', keepId, otherIds }  move every group onto keepId; the others end up with none
+//   { action: 'delete', id, keepId, copyIds }  delete an emptied copy (refused while it still has groups)
+// Everything is checked against Intune again here: the apps must be Win32 copies of the same app.
+// HRM patch 0026: Intune won't delete an app that another app supersedes or depends on, so delete first
+// removes the links between copies of this same app (only those), and refuses if any other app links to
+// it. Failures use 409/424: Cloudflare replaces 502 replies with its own page, which hid the reason.
+
+import { NextRequest, NextResponse } from 'next/server';
+import { isSqliteMode } from '@/lib/db';
+import { summarizeAssignments } from '@/lib/hrm/app-insights';
+import { parseAccessToken } from '@/lib/auth-utils';
+import { getServicePrincipalToken } from '@/lib/intune/graph-client';
+// HRM patch 0042: the Intune calls moved to a shared module, used by the automatic old-copy removal too.
+import { assign, loadCopy, unlinkAndDelete, type GraphApp } from '@/lib/hrm/intune-copies';
+import { duplicateKey, mergeAssignments, type GraphAssignment } from '@/lib/hrm/duplicates';
+
+const GUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
+const fail = (error: string, status = 400) => NextResponse.json({ error }, { status });
+
+export async function POST(request: NextRequest) {
+  const user = await parseAccessToken(request.headers.get('Authorization'));
+  if (!user) return fail('Authentication required', 401);
+  const body = (await request.json().catch(() => null)) as Record<string, unknown> | null;
+  const action = body?.action;
+  const keepId = typeof body?.keepId === 'string' ? body.keepId : '';
+  if (!GUID.test(keepId)) return fail('Invalid app');
+
+  if (process.env.DATABASE_MODE?.toLowerCase() === 'sqlite') {
+    const { sqlitePilotRollouts, sqliteRetirements } = await import('@/lib/db/sqlite');
+    if ([keepId, typeof body?.id === 'string' ? body.id : '', ...(Array.isArray(body?.otherIds) ? body.otherIds.filter((v): v is string => typeof v === 'string') : [])].some((id) => sqlitePilotRollouts.holdsApp(user.tenantId,id))) return NextResponse.json({ error: 'This app is part of an active pilot. Review it in App updates first.' },{ status: 409 });
+    // HRM patch 0038: copies of an app being retired keep their Uninstall groups until it is cancelled or deleted.
+    if ([keepId, typeof body?.id === 'string' ? body.id : '', ...(Array.isArray(body?.otherIds) ? body.otherIds.filter((v): v is string => typeof v === 'string') : [])].some((id) => sqliteRetirements.holdsApp(user.tenantId,id))) return NextResponse.json({ error: 'This app is being retired. Finish or cancel that in its Inventory details first.' },{ status: 409 });
+  }
+
+  const token = await getServicePrincipalToken(user.tenantId);
+  if (!token) return fail("Couldn't reach Intune. Try again.", 424);
+  const keep = await loadCopy(token, keepId);
+  if (!keep) return fail('That copy is no longer in Intune.', 404);
+
+  // These reads already succeeded in this route. Recording them needs no extra
+  // Graph calls, and an optional history failure must never change the outcome.
+  const note = async (app: GraphApp, assignments: GraphAssignment[], knownChange = false, exists = true) => {
+    if (!isSqliteMode()) return;
+    try {
+      const { sqliteAppInsights: store } = await import('@/lib/db/sqlite');
+      const family = store.family(user.tenantId, app.id);
+      if (!family) return;
+      store.observe(user.tenantId, { appId: app.id, wingetId: family, displayName: app.displayName,
+        version: app.displayVersion ?? '', exists, assignments: summarizeAssignments(assignments), checkedAt: new Date().toISOString() },
+        knownChange ? `Saved in IntuneGet by ${user.userEmail || 'a staff member'}` : undefined, knownChange);
+    } catch { /* Activity is optional; the checked Intune operation still stands. */ }
+  };
+
+  if (action === 'keep') {
+    const otherIds = Array.isArray(body?.otherIds) ? (body!.otherIds as unknown[]).filter((v): v is string => typeof v === 'string') : [];
+    if (otherIds.length === 0 || otherIds.length > 10 || !otherIds.every((id) => GUID.test(id) && id !== keepId)) return fail('Invalid copies');
+    const others = await Promise.all(otherIds.map((id) => loadCopy(token, id)));
+    if (others.some((o) => !o || duplicateKey(o.app) !== duplicateKey(keep.app))) {
+      return fail('Those apps are not copies of the same app.', 409);
+    }
+    await note(keep.app, keep.assignments);
+    for (const other of others) await note(other!.app, other!.assignments);
+    const merged = mergeAssignments(keep.assignments, others.map((o) => o!.assignments));
+    // Groups go onto the kept copy first, so nothing is ever left unassigned in between.
+    if (!(await assign(token, keepId, merged))) return fail("Intune didn't accept the groups. Nothing was changed.", 424);
+    await note(keep.app, merged, true);
+    const cleared: string[] = [];
+    for (const id of otherIds) if (await assign(token, id, [])) {
+      cleared.push(id);
+      await note(others.find((o) => o!.app.id === id)!.app, [], true);
+    }
+    console.log(JSON.stringify({ route: '/api/hrm/duplicates', action, kept: keepId, cleared: cleared.length, of: otherIds.length }));
+    return NextResponse.json({ kept: keepId, groups: merged.length, cleared, notCleared: otherIds.filter((id) => !cleared.includes(id)) });
+  }
+
+  if (action === 'delete') {
+    const id = typeof body?.id === 'string' ? body.id : '';
+    if (!GUID.test(id) || id === keepId) return fail('Invalid copy');
+    const copy = await loadCopy(token, id);
+    if (!copy) return fail('That copy is no longer in Intune.', 404);
+    if (duplicateKey(copy.app) !== duplicateKey(keep.app)) return fail('Those apps are not copies of the same app.', 409);
+    if (copy.assignments.length > 0) return fail('This copy still has groups. Use Keep this copy on the other one first.', 409);
+
+    // The copies of this app, each checked again: links between them are the only ones removed.
+    const requested = Array.isArray(body?.copyIds) ? (body!.copyIds as unknown[]).filter((v): v is string => typeof v === 'string' && GUID.test(v)) : [];
+    const copyIds = new Set([keepId, id, ...requested.slice(0, 10)].map((v) => v.toLowerCase()));
+    for (const other of copyIds) {
+      if (other === keepId.toLowerCase() || other === id.toLowerCase()) continue;
+      const loaded = await loadCopy(token, other);
+      if (!loaded || duplicateKey(loaded.app) !== duplicateKey(keep.app)) copyIds.delete(other);
+    }
+
+    const deleted = await unlinkAndDelete(token, id, copyIds);
+    if (!deleted.ok) return fail(deleted.reason, deleted.status);
+    const unlinked = deleted.unlinked;
+    await note(copy.app, [], true, false);
+    // HRM patch 0042: an old copy Home listed as needing a look is gone now.
+    if (isSqliteMode()) { try { const { sqliteOldCopies } = await import('@/lib/db/sqlite'); sqliteOldCopies.clear(user.tenantId, id); } catch { /* optional */ } }
+    console.log(JSON.stringify({ route: '/api/hrm/duplicates', action, deleted: id, unlinked: unlinked.length }));
+    return NextResponse.json({ deleted: id, unlinked });
+  }
+
+  return fail('Unknown action');
+}
