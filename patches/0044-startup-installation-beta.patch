@@ -0,0 +1,10 @@
+'use client';
+import { STARTUP_BETA_LABEL } from '@/lib/hrm/startup-installation';
+export function StartupInstallChoice({ value, onChange, problem }: { value: boolean; onChange: (value: boolean) => void; problem: string | null }) {
+  return <div className="space-y-2 rounded-lg border border-status-warning/25 bg-status-warning/5 p-3">
+    <label className="flex items-start gap-2 text-sm font-medium text-text-primary"><input type="checkbox" className="mt-1" checked={value} disabled={!!problem && !value} onChange={e => onChange(e.target.checked)} /><span>{STARTUP_BETA_LABEL}</span></label>
+    <p className="text-xs text-text-secondary">Beta: Windows pilot testing required. When deployed, Intune stages the package for silent installation after a later Windows startup. Does not force a restart or block sign-in. The three-day postponement policy does not apply. This sets the current deployment; future automatic updates follow the shared policy or app exception in App updates.</p>
+    {value && <p className="text-xs text-status-warning">Intune may show retry or failure while waiting. App updates shows separate startup reports when reporting is configured. Use a Required assignment to a small pilot device group.</p>}
+    {problem && <p className="text-xs text-text-muted">{problem}</p>}
+  </div>;
+}
