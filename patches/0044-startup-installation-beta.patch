diff --git a/packager/src/startup-install.ts b/packager/src/startup-install.ts
new file mode 100644
index 000000000..db00cacf7
--- /dev/null
+++ b/packager/src/startup-install.ts
@@ -0,0 +1,28 @@
+import * as fs from 'fs';
+import * as path from 'path';
+import { createHash } from 'crypto';
+import type { PackagingJob } from './job-poller.js';
+const record = (value: unknown): Record<string, unknown> => value && typeof value === 'object' && !Array.isArray(value) ? value as Record<string, unknown> : {};
+export function startupEnabled(job: PackagingJob): boolean { return record(record(job.package_config).psadtConfig).installAfterRestartBeta === true; }
+export function startupPackageProblem(job: PackagingJob): string | null {
+  const config = record(job.package_config), psadt = record(config.psadtConfig);
+  if (psadt.installAfterRestartBeta !== undefined && typeof psadt.installAfterRestartBeta !== 'boolean') return 'Invalid startup installer Beta setting.';
+  if (!startupEnabled(job)) return null;
+  if (job.install_scope !== 'machine') return 'The startup installer Beta supports machine-wide apps only.';
+  if (!['msi','wix','exe','inno','nullsoft','burn'].includes(job.installer_type.toLowerCase())) return 'The startup installer Beta supports MSI and EXE installers only.';
+  if (psadt.restartBehavior && psadt.restartBehavior !== 'Suppress') return 'The startup installer Beta requires suppressed restarts.';
+  if (psadt.customDetection || (Array.isArray(config.espProfiles) && config.espProfiles.length) || (config.supersedenceType === 'replace' || (Array.isArray(config.relationships) && config.relationships.some(r => record(r).relationshipType === 'supersedence' && record(r).supersedenceType === 'replace')))) return 'The startup installer Beta requires automatic detection, no setup profiles and update supersedence.';
+  return null;
+}
+export async function prepareStartupPackage(job: PackagingJob, directory: string, markerRoot: string): Promise<void> {
+  const problem = startupPackageProblem(job); if (problem) throw new Error(problem);
+  if (!startupEnabled(job)) return;
+  if (!/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(job.id) || !/^[A-Za-z0-9_.-]{1,256}$/.test(job.winget_id)) throw new Error('Invalid startup package identity.');
+  if (!/^SOFTWARE\\/i.test(markerRoot)) throw new Error('The startup installer Beta requires a SOFTWARE registry marker.');
+  if (!Number.isFinite(Date.parse(job.created_at))) throw new Error('Startup packages require the original deployment creation time.');
+  const metadata = { v: 1, createdAt: new Date(job.created_at).toISOString(), jobId: job.id.toLowerCase(), appKey: createHash('sha256').update(job.winget_id.toLowerCase()).digest('hex'), version: job.version,
+    marker: `${markerRoot}\\${job.winget_id.replace(/[.\-]/g, '_')}` };
+  await fs.promises.copyFile(path.join(__dirname, '..', 'scripts', 'IntuneGet-StartupInstall.ps1'), path.join(directory, 'IntuneGet-StartupInstall.ps1'));
+  await fs.promises.writeFile(path.join(directory, 'startup-config.json'), JSON.stringify(metadata), 'utf8');
+  await fs.promises.writeFile(path.join(directory, 'Uninstall-AfterRestart.cmd'), '@echo off\r\n"%SystemRoot%\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" -NoProfile -NonInteractive -ExecutionPolicy Bypass -File "%~dp0IntuneGet-StartupInstall.ps1" -Mode Cancel\r\nif errorlevel 1 exit /b %errorlevel%\r\n"%~dp0Invoke-AppDeployToolkit.exe" -DeploymentType Uninstall -DeployMode Silent\r\nexit /b %errorlevel%\r\n', 'ascii');
+}
