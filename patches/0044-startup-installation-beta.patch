diff --git a/.github/scripts/Prepare-StartupPackage.ps1 b/.github/scripts/Prepare-StartupPackage.ps1
new file mode 100644
index 000000000..10d83cc0a
--- /dev/null
+++ b/.github/scripts/Prepare-StartupPackage.ps1
@@ -0,0 +1,37 @@
+# Packages the opt-in startup installer Beta using the existing reviewed PSADT package.
+[CmdletBinding()]
+param([Parameter(Mandatory=$true)][string]$PackageDirectory)
+$ErrorActionPreference='Stop'
+$config=if ($env:PSADT_CONFIG) { $env:PSADT_CONFIG | ConvertFrom-Json } else { [pscustomobject]@{} }
+$flag=$config.PSObject.Properties['installAfterRestartBeta']
+if (-not $flag -or $flag.Value -eq $false) { return }
+if ($flag.Value -isnot [bool]) { throw 'Invalid startup installer Beta setting.' }
+if ($env:INSTALL_SCOPE -ne 'machine' -or $env:INSTALLER_TYPE -notin @('msi','wix','exe','inno','nullsoft','burn')) { throw 'Startup installer Beta supports machine-wide MSI and EXE apps only.' }
+if ($config.customDetection -eq $true -or ($env:ESP_PROFILES -and @($env:ESP_PROFILES | ConvertFrom-Json).Count -gt 0) -or $env:SUPERSEDENCE_TYPE -eq 'replace') { throw 'Startup installer Beta requires automatic detection, no setup profiles and update supersedence.' }
+if ($config.restartBehavior -and $config.restartBehavior -ne 'Suppress') { throw 'Startup installer Beta requires suppressed restarts.' }
+if ($env:RELATIONSHIPS) { foreach ($relationship in @($env:RELATIONSHIPS | ConvertFrom-Json)) { if ($relationship.relationshipType -eq 'supersedence' -and $relationship.supersedenceType -eq 'replace') { throw 'Startup installer Beta requires update supersedence.' } } }
+$job=[guid]::Empty
+if (-not [guid]::TryParse($env:JOB_ID,[ref]$job) -or $env:WINGET_ID -notmatch '^[A-Za-z0-9_.-]{1,256}$') { throw 'Invalid startup package identity.' }
+$root=if ($config.registryMarkerPath) { [string]$config.registryMarkerPath } else { 'SOFTWARE\IntuneGet\Apps' }
+$root=$root.Trim().Replace('/','\') -replace '\\+', '\'
+$root=$root.Trim('\') -replace '^(HKLM|HKCU|HKEY_LOCAL_MACHINE|HKEY_CURRENT_USER):?(\\|$)', ''
+$root=$root -replace '[*?"''<>|\x00-\x1f]', ''
+$root=(@($root.Split('\') | ForEach-Object {$_.Trim()} | Where-Object {$_}) -join '\')
+if ($root -notmatch '^SOFTWARE\\') { throw 'Startup installer Beta requires a SOFTWARE registry marker.' }
+$sha=[Security.Cryptography.SHA256]::Create()
+try {$appKey=([BitConverter]::ToString($sha.ComputeHash([Text.Encoding]::UTF8.GetBytes($env:WINGET_ID.ToLowerInvariant())))).Replace('-','').ToLowerInvariant()} finally {$sha.Dispose()}
+$created=[DateTimeOffset]::MinValue
+if (-not [DateTimeOffset]::TryParse($env:JOB_CREATED_AT,[ref]$created)) { throw 'Startup packages require the original deployment creation time.' }
+$metadata=[ordered]@{v=1;createdAt=$created.UtcDateTime.ToString('yyyy-MM-ddTHH:mm:ss.fffZ');jobId=$job.ToString();appKey=$appKey;version=$env:VERSION;marker=$root+'\'+($env:WINGET_ID -replace '[.\-]','_')}
+$runner=Join-Path $PSScriptRoot 'IntuneGet-StartupInstall.ps1'
+if (-not (Test-Path -LiteralPath $runner)) { $runner=Join-Path $PSScriptRoot '..\..\packager\scripts\IntuneGet-StartupInstall.ps1' }
+Copy-Item -LiteralPath $runner -Destination (Join-Path $PackageDirectory 'IntuneGet-StartupInstall.ps1') -Force
+[IO.File]::WriteAllText((Join-Path $PackageDirectory 'startup-config.json'),($metadata | ConvertTo-Json -Compress),[Text.UTF8Encoding]::new($false))
+$uninstall=@'
+@echo off
+"%SystemRoot%\System32\WindowsPowerShell\v1.0\powershell.exe" -NoProfile -NonInteractive -ExecutionPolicy Bypass -File "%~dp0IntuneGet-StartupInstall.ps1" -Mode Cancel
+if errorlevel 1 exit /b %errorlevel%
+"%~dp0Invoke-AppDeployToolkit.exe" -DeploymentType Uninstall -DeployMode Silent
+exit /b %errorlevel%
+'@
+[IO.File]::WriteAllText((Join-Path $PackageDirectory 'Uninstall-AfterRestart.cmd'),($uninstall -replace "`r?`n","`r`n"),[Text.Encoding]::ASCII)
