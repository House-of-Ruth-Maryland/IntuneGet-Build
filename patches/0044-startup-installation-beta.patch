new file mode 100644
index 000000000..765fbdbbe
--- /dev/null
+++ b/lib/hrm/startup-report-check.ts
@@ -0,0 +1,29 @@
+import { getServicePrincipalToken } from '@/lib/intune/graph-client';
+import { collectStartupReport, GUID } from './startup-report';
+/** Read-only Graph collection. Credentials never go to devices or pagination hosts. */
+export async function refreshStartupReport(tenant: string) {
+  const { sqliteStartupReports: store } = await import('@/lib/db/sqlite');
+  const script = process.env.HRM_STARTUP_REPORT_SCRIPT_ID;
+  if (!script || !GUID.test(script)) return;
+  try {
+    const token = await getServicePrincipalToken(tenant);
+    if (!token) throw new Error('Token unavailable');
+    const base = `https://graph.microsoft.com/beta/deviceManagement/deviceHealthScripts/${script}/deviceRunStates`;
+    let url: string | undefined = `${base}?$select=id,preRemediationDetectionScriptOutput&$top=500`;
+    const states: { id?: string; preRemediationDetectionScriptOutput?: string }[] = [];
+    const deadline = Date.now() + 90000;
+    for (let page = 0; url && page < 40; page++) {
+      if (Date.now() > deadline) throw new Error('Collection timeout');
+      const next = new URL(url);
+      if (next.origin !== 'https://graph.microsoft.com' || next.pathname !== new URL(base).pathname || next.username || next.password) throw new Error('Invalid pagination');
+      const response: Response = await fetch(url, { headers: { Authorization: `Bearer ${token}` }, signal: AbortSignal.timeout(15000), cache: 'no-store' });
+      if (!response.ok) { store.save(tenant, null, response.status === 403 || response.status === 401 ? 'access_denied' : 'read_failed'); return; }
+      const body: { value?: unknown; '@odata.nextLink'?: string } = await response.json();
+      if (!Array.isArray(body.value) || states.length + body.value.length > 20000) throw new Error('Report limit');
+      states.push(...body.value as { id?: string; preRemediationDetectionScriptOutput?: string }[]);
+      url = body['@odata.nextLink'];
+    }
+    if (url) throw new Error('Incomplete report');
+    store.save(tenant, collectStartupReport(states, store.jobs(tenant)));
+  } catch { store.save(tenant, null, 'read_failed'); }
+}
