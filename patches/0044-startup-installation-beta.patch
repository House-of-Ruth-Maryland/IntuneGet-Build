+++ b/components/hrm/StartupInstallations.tsx
@@ -0,0 +1,32 @@
+'use client';
+import { Button } from '@/components/ui/button';
+import { useStartupInstallations } from '@/hooks/useStartupInstallations';
+import { emptyStartupCounts, startupReportNeedsReview, type StartupState } from '@/lib/hrm/startup-report';
+const columns: { key: StartupState; label: string }[] = [{key:'waiting',label:'Waiting for restart'},{key:'installing',label:'Installing'},{key:'installed',label:'Installed'},{key:'failed',label:'Failed'},{key:'cancelled',label:'Cancelled'},{key:'outdated',label:'Status out of date'}];
+export function StartupInstallations() {
+  const { data, error, isLoading, refresh, cancellation } = useStartupInstallations();
+  if (data?.supported === false) return null;
+  const rows = data?.packages?.map(job => data.report?.rows.find(row => row.id === job.id) ?? { ...job, ...emptyStartupCounts(), lastActivityAt: undefined }) ?? data?.report?.rows ?? [];
+  return <section id="startup-installations" aria-label="Startup installations · Beta" className="space-y-4 rounded-xl border border-overlay/10 bg-bg-surface p-5">
+    <p className="text-xs text-status-warning">Beta: Windows pilot testing required. Validate staging, restart installation and cancellation on a pilot computer before wider rollout.</p>
+    <details><summary className="flex cursor-pointer flex-wrap items-center justify-between gap-2 text-sm text-text-primary"><span className="font-semibold">Startup installations · Beta</span><span className="text-xs text-text-muted">{isLoading ? 'Loading reports…' : data && startupReportNeedsReview(data) ? 'Reports need review' : data?.report ? `${data.report.summary.waiting} waiting for restart · ${data.report.summary.failed} failed` : data?.configured ? 'View device reports' : 'Reporting not configured'}</span></summary><div className="mt-4 space-y-4">
+    <div className="flex flex-wrap items-center justify-between gap-3"><div><h2 className="font-semibold text-text-primary">Device installation results</h2><p className="mt-1 text-xs text-text-muted">Device-reported startup results, separate from publishing history.</p></div><Button variant="outline" disabled={!data?.configured || refresh.isPending} onClick={() => refresh.mutate()}>{refresh.isPending ? 'Checking Intune…' : 'Check startup reports'}</Button></div>
+    {cancellation?.error && <p role="alert" className="text-sm text-status-error">Could not download the cancellation script. Try again.</p>}
+    {isLoading && <p className="text-sm text-text-muted">Loading startup installation reports…</p>}
+    {(error || refresh.error) && <p role="alert" className="text-sm text-status-error">Could not load startup installation reports. Try Check startup reports again.</p>}
+    {data && !data.configured && <p className="text-sm text-status-warning">Reporting not configured. Startup installation results will appear after the reporting script is assigned and connected.</p>}
+    {data?.error && <p role="alert" className="text-sm text-status-warning">{data.error === 'access_denied' ? 'Intune denied access to startup reports. Check the reporting permission and Remediations licensing.' : 'Could not refresh reports from Intune. The last successful snapshot, if available, is shown below.'}</p>}
+    {data?.configured && !data.report && !data.error && <p className="text-sm text-text-muted">No reports collected yet. Check startup reports after the reporting script has run on a pilot computer.</p>}
+    {data?.report && data.checkedAt && <p className="text-xs text-text-muted">Last successful collection: {new Date(data.checkedAt).toLocaleString()}.{data.stale ? ' This snapshot is out of date. Refresh before relying on its counts.' : ''} Checking reports does not force computers to check in.</p>}
+    {data?.report && <>
+      <p className="text-xs text-text-secondary">Counts cover received reports only. Computers that have not reported are not assumed installed. {data.report.reportingDevices} reporting computers; {data.report.unknownDevices} reports need review.{data.report.omitted ? ` ${data.report.omitted} additional local records were omitted to fit Intune’s output limit.` : ''}</p>
+      <div className="grid grid-cols-2 gap-3 sm:grid-cols-6">{columns.map(column => <div key={column.key} className="rounded-lg border border-overlay/10 p-3"><p className="text-xl font-semibold tabular-nums text-text-primary">{data.report!.summary[column.key]}</p><p className="mt-1 text-xs text-text-muted">{column.label}</p></div>)}</div>
+    </>}
+      {data && (rows.length > 0 ? <div className="overflow-x-auto"><table className="w-full min-w-[56rem] text-left text-xs"><thead><tr className="border-b border-overlay/10 text-text-muted"><th className="py-3 pr-3 font-medium">App / version</th><th className="p-3 font-medium">Last device activity</th>{columns.map(c => <th key={c.key} className="p-3 font-medium">{c.label}</th>)}</tr></thead><tbody>{rows.map(row => {
+        const anyReports=columns.some(c => row[c.key] > 0);
+        return <tr key={row.id} className="border-b border-overlay/10"><td className="py-3 pr-3 text-text-primary">{row.name}<span className="mt-1 block text-text-muted">{row.version}{!anyReports ? ' · No reports yet' : ''}</span><details className="mt-2 text-xs"><summary className="cursor-pointer text-accent-cyan">Cancel before installation</summary><p className="mt-2 text-text-secondary">Remove the Required assignment first. Download this package’s cancellation script and deploy it as a SYSTEM platform script to the pilot group. It stops pending installation, including later retries, without uninstalling an installed app. If installation is already running, retry after it finishes.</p><Button size="sm" variant="outline" className="mt-2" disabled={cancellation?.isPending} onClick={() => cancellation.mutate(row.id)}>Download cancellation script</Button></details></td><td className="p-3 text-text-muted">{row.lastActivityAt ? new Date(row.lastActivityAt).toLocaleString() : 'No report'}</td>{columns.map(c => <td key={c.key} className="p-3 tabular-nums text-text-secondary">{anyReports ? row[c.key] : '—'}</td>)}</tr>;
+      })}</tbody></table></div> : <p className="text-sm text-text-muted">No startup Beta packages are recorded for this tenant.</p>)}
