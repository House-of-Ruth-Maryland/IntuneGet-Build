diff --git a/packager/scripts/IntuneGet-StartupInstall.ps1 b/packager/scripts/IntuneGet-StartupInstall.ps1
new file mode 100644
index 000000000..918da9776
--- /dev/null
+++ b/packager/scripts/IntuneGet-StartupInstall.ps1
@@ -0,0 +1,235 @@
+# IntuneGet: Install after next restart (Beta). Runs as SYSTEM in Windows PowerShell 5.1.
+[CmdletBinding()]
+param([ValidateSet('Stage','Run','Cancel')][string]$Mode = 'Stage')
+$ErrorActionPreference = 'Stop'
+Set-StrictMode -Version 2
+
+function Test-IntuneGetNewBoot([string]$Before, [string]$Now) {
+    return -not [string]::IsNullOrWhiteSpace($Before) -and -not [string]::IsNullOrWhiteSpace($Now) -and $Before -ne $Now
+}
+function Get-IntuneGetBoot {
+    return (Get-CimInstance -ClassName Win32_OperatingSystem -ErrorAction Stop).LastBootUpTime.ToUniversalTime().ToString('o')
+}
+function Assert-IntuneGetSystem {
+    if ([Security.Principal.WindowsIdentity]::GetCurrent().User.Value -ne 'S-1-5-18') { throw 'Startup installation requires SYSTEM.' }
+}
+function Assert-IntuneGetPlainPath([string]$Path) {
+    $current = [IO.Path]::GetFullPath($Path)
+    while ($current) {
+        if (Test-Path -LiteralPath $current) {
+            if ((Get-Item -LiteralPath $current -Force).Attributes -band [IO.FileAttributes]::ReparsePoint) { throw 'Reparse points are not allowed.' }
+        }
+        $parent = [IO.Directory]::GetParent($current)
+        $current = if ($parent) { $parent.FullName } else { $null }
+    }
+}
+function Assert-IntuneGetOwnedPath([string]$Path) {
+    Assert-IntuneGetPlainPath $Path
+    $acl = Get-Acl -LiteralPath $Path
+    if ($acl.GetOwner([Security.Principal.SecurityIdentifier]).Value -ne 'S-1-5-18') { throw 'Startup cache must be owned by SYSTEM.' }
+    foreach ($rule in $acl.GetAccessRules($true, $true, [Security.Principal.SecurityIdentifier])) {
+        if ($rule.AccessControlType -eq 'Allow' -and $rule.IdentityReference.Value -notin @('S-1-5-18','S-1-5-32-544')) { throw 'Startup cache grants access to an unexpected principal.' }
+    }
+}
+function New-IntuneGetSecureDirectory([string]$Path) {
+    Assert-IntuneGetPlainPath $Path
+    if (-not (Test-Path -LiteralPath $Path)) {
+        $acl = New-Object Security.AccessControl.DirectorySecurity
+        $acl.SetAccessRuleProtection($true, $false)
+        $acl.SetOwner([Security.Principal.SecurityIdentifier]::new('S-1-5-18'))
+        foreach ($sid in @('S-1-5-18','S-1-5-32-544')) {
+            $rule = [Security.AccessControl.FileSystemAccessRule]::new([Security.Principal.SecurityIdentifier]::new($sid), 'FullControl', 'ContainerInherit,ObjectInherit', 'None', 'Allow')
+            $acl.AddAccessRule($rule)
+        }
+        # Windows PowerShell 5.1 / .NET Framework creates the directory with its DACL atomically.
+        $null = [IO.Directory]::CreateDirectory($Path, $acl)
+    }
+    Assert-IntuneGetOwnedPath $Path
+}
+function Copy-IntuneGetPlainTree([string]$Source, [string]$Destination) {
+    foreach ($entry in Get-ChildItem -LiteralPath $Source -Force) {
+        if ($entry.Attributes -band [IO.FileAttributes]::ReparsePoint) { throw 'Package links are not allowed.' }
+        $target = Join-Path $Destination $entry.Name
+        if ($entry.PSIsContainer) {
+            New-IntuneGetSecureDirectory $target
+            Copy-IntuneGetPlainTree $entry.FullName $target
+        } else { [IO.File]::Copy($entry.FullName, $target, $false) }
+    }
+}
+function Read-IntuneGetJson([string]$Path) {
+    Assert-IntuneGetPlainPath $Path
+    if ((Get-Item -LiteralPath $Path).Length -gt 1048576) { throw 'Startup metadata exceeds its limit.' }
+    return Get-Content -LiteralPath $Path -Raw | ConvertFrom-Json
+}
+function Write-IntuneGetJson([string]$Path, $Value) {
+    $temporary = $Path + '.new'
+    Assert-IntuneGetPlainPath $temporary
+    [IO.File]::WriteAllText($temporary, ($Value | ConvertTo-Json -Depth 8 -Compress), [Text.UTF8Encoding]::new($false))
+    Move-Item -LiteralPath $temporary -Destination $Path -Force
+}
+function Write-IntuneGetState([string]$Directory, $Config, [string]$State, [string]$Boot, [int]$Attempts, $Code = $null) {
+    Write-IntuneGetJson (Join-Path $Directory 'state.json') ([ordered]@{ v=1; job=$Config.jobId; app=$Config.appKey; version=$Config.version; createdAt=$Config.createdAt; state=$State; boot=$Boot; attempts=$Attempts; updated=[DateTime]::UtcNow.ToString('o'); code=$Code })
+}
+# Compare immutable server deployment order, never arrival time or vendor version syntax.
+function Compare-IntuneGetIntent($Left, $Right) {
+    $leftDate=[DateTimeOffset]::Parse([string]$Left.createdAt).UtcDateTime.Ticks
+    $rightDate=[DateTimeOffset]::Parse([string]$Right.createdAt).UtcDateTime.Ticks
+    if ($leftDate -lt $rightDate) { return -1 }
+    if ($leftDate -gt $rightDate) { return 1 }
+    return [StringComparer]::Ordinal.Compare([string]$Left.jobId,[string]$Right.jobId)
+}
+function Set-IntuneGetSuperseded([string]$App, [string]$Directory) {
+    foreach ($old in Get-ChildItem -LiteralPath $App -Directory) {
+        if ($old.FullName -eq $Directory) { continue }
+        Assert-IntuneGetOwnedPath $old.FullName
+        $oldFile = Join-Path $old.FullName 'state.json'
+        if (Test-Path -LiteralPath $oldFile) {
+            $oldState = Read-IntuneGetJson $oldFile
+            if ($oldState.state -in @('waiting','installing')) {
+                $oldState.state='superseded';$oldState.updated=[DateTime]::UtcNow.ToString('o')
+                Write-IntuneGetJson $oldFile $oldState
+            }
+        }
+    }
+}
+function Test-IntuneGetInstalled($Config) {
+    $base = [Microsoft.Win32.RegistryKey]::OpenBaseKey('LocalMachine', 'Registry64')
+    try {
+        $key = $base.OpenSubKey([string]$Config.marker)
+        if (-not $key) { return $false }
+        try {
+            $actual = [string]$key.GetValue('Version','')
+            if ($actual -eq [string]$Config.version) { return $true }
+            $left = $null; $right = $null
+            return [version]::TryParse($actual,[ref]$left) -and [version]::TryParse([string]$Config.version,[ref]$right) -and $left -ge $right
+        } finally { $key.Dispose() }
+    } finally { $base.Dispose() }
+}
+function Register-IntuneGetStartupTask($Config, [string]$Directory) {
+    $exe = Join-Path $env:SystemRoot 'System32\WindowsPowerShell\v1.0\powershell.exe'
+    $script = Join-Path $Directory 'payload\IntuneGet-StartupInstall.ps1'
+    $action = New-ScheduledTaskAction -Execute $exe -Argument ('-NoProfile -NonInteractive -ExecutionPolicy Bypass -File "' + $script + '" -Mode Run') -WorkingDirectory (Join-Path $Directory 'payload')
+    $trigger = New-ScheduledTaskTrigger -AtStartup
+    $trigger.Delay = 'PT1M'
+    $principal = New-ScheduledTaskPrincipal -UserId 'S-1-5-18' -LogonType ServiceAccount -RunLevel Highest
+    $settings = New-ScheduledTaskSettingsSet -MultipleInstances IgnoreNew -ExecutionTimeLimit ([TimeSpan]::Zero) -AllowStartIfOnBatteries -DontStopIfGoingOnBatteries
+    # No StartWhenAvailable, immediate start, logon trigger, or forced restart.
+    Register-ScheduledTask -TaskName ('IntuneGet-Startup-Beta-' + $Config.appKey) -Action $action -Trigger $trigger -Principal $principal -Settings $settings -Force | Out-Null
+}
+function Remove-IntuneGetStartupTask($Config) {
+    Unregister-ScheduledTask -TaskName ('IntuneGet-Startup-Beta-' + $Config.appKey) -Confirm:$false -ErrorAction SilentlyContinue
+}
+function Assert-IntuneGetManifest([string]$Payload, $Manifest) {
+    foreach ($entry in $Manifest.files) {
+        $path = [IO.Path]::GetFullPath((Join-Path $Payload ([string]$entry.path)))
+        if (-not $path.StartsWith($Payload.TrimEnd('\') + '\', [StringComparison]::OrdinalIgnoreCase)) { throw 'Invalid package manifest path.' }
+        Assert-IntuneGetPlainPath $path
+        if ((Get-FileHash -LiteralPath $path -Algorithm SHA256).Hash -ne $entry.sha256) { throw 'Staged package failed integrity verification.' }
+    }
+}
+function Invoke-IntuneGetStartup {
+    Assert-IntuneGetSystem
+    $config = Read-IntuneGetJson (Join-Path $PSScriptRoot 'startup-config.json')
+    if ($config.v -ne 1 -or $config.jobId -notmatch '^[0-9a-f-]{36}$' -or $config.appKey -notmatch '^[0-9a-f]{64}$') { throw 'Invalid startup package identity.' }
+    $created=[DateTimeOffset]::MinValue
+    if (-not $config.PSObject.Properties['createdAt'] -or -not [DateTimeOffset]::TryParse([string]$config.createdAt,[ref]$created)) { throw 'Missing deployment order.' }
+    $root = Join-Path $env:ProgramData 'IntuneGet-Startup-Beta'
+    New-IntuneGetSecureDirectory $root
+    $app = Join-Path $root $config.appKey
+    New-IntuneGetSecureDirectory $app
+    $directory = Join-Path $app $config.jobId
+    $mutex = [Threading.Mutex]::new($false, ('Global\IntuneGetStartup-' + $config.appKey))
+    $locked = $false
+    try {
+        try { $locked = $mutex.WaitOne(0) } catch [Threading.AbandonedMutexException] { $locked = $true }
+        if (-not $locked) { return 1618 }
+        if ($Mode -eq 'Cancel') {
+            if (Test-Path -LiteralPath $directory) {
+                Assert-IntuneGetOwnedPath $directory
+                $state = Read-IntuneGetJson (Join-Path $directory 'state.json')
+                Write-IntuneGetState $directory $config 'cancelled' $state.boot $state.attempts
+                # Do not cancel a newer version's task when Intune uninstalls an older copy.
+                $task = Get-ScheduledTask -TaskName ('IntuneGet-Startup-Beta-' + $config.appKey) -ErrorAction SilentlyContinue
+                if ($task -and ($task.Actions.Arguments -like ('*' + $config.jobId + '*'))) { Remove-IntuneGetStartupTask $config }
+            }
+            return 0
+        }
+        $intentFile = Join-Path $app 'intent.json'
+        $intent = if (Test-Path -LiteralPath $intentFile) { Read-IntuneGetJson $intentFile } else { $null }
+        if ($intent -and (Compare-IntuneGetIntent $config $intent) -lt 0) {
+            New-IntuneGetSecureDirectory $directory
+            Write-IntuneGetState $directory $config 'superseded' (Get-IntuneGetBoot) 0
+            return 60010
+        }
+        if ($Mode -eq 'Stage') {
+            if (Test-IntuneGetInstalled $config) { Set-IntuneGetSuperseded $app $directory; New-IntuneGetSecureDirectory $directory; Write-IntuneGetState $directory $config 'installed' (Get-IntuneGetBoot) 0 0; Write-IntuneGetJson $intentFile @{jobId=$config.jobId;createdAt=$config.createdAt}; Remove-IntuneGetStartupTask $config; return 0 }
+            if (Test-Path -LiteralPath $directory) {
+                Assert-IntuneGetOwnedPath $directory
+                $state = Read-IntuneGetJson (Join-Path $directory 'state.json')
+                if ($state.state -in @('failed','cancelled','superseded')) { return 60010 }
+                # Retries keep the original boot boundary and never execute the installer.
+                Set-IntuneGetSuperseded $app $directory
+                Write-IntuneGetJson $intentFile @{jobId=$config.jobId;createdAt=$config.createdAt}
+                Register-IntuneGetStartupTask $config $directory
+                return 1618
+            }
+            New-IntuneGetSecureDirectory $directory
+            try {
+                $payload = Join-Path $directory 'payload'
+                New-IntuneGetSecureDirectory $payload
+                Copy-IntuneGetPlainTree $PSScriptRoot $payload
+                $files = @(Get-ChildItem -LiteralPath $payload -Recurse -File | ForEach-Object { [ordered]@{path=$_.FullName.Substring($payload.Length+1);sha256=(Get-FileHash -LiteralPath $_.FullName -Algorithm SHA256).Hash} })
+                Write-IntuneGetJson (Join-Path $directory 'manifest.json') @{v=1;files=$files}
+                Set-IntuneGetSuperseded $app $directory
+                Write-IntuneGetState $directory $config 'waiting' (Get-IntuneGetBoot) 0
+                Write-IntuneGetJson $intentFile @{jobId=$config.jobId;createdAt=$config.createdAt}
+                Register-IntuneGetStartupTask $config $directory
+                return 1618
+            } catch {
+                Write-IntuneGetState $directory $config 'failed' (Get-IntuneGetBoot) 0 60010
+                throw
+            }
+        }
+        Assert-IntuneGetOwnedPath $directory
+        $expectedPayload = Join-Path $directory 'payload'
+        if ([IO.Path]::GetFullPath($PSScriptRoot) -ne [IO.Path]::GetFullPath($expectedPayload)) { throw 'Startup execution must use the protected cache.' }
+        $state = Read-IntuneGetJson (Join-Path $directory 'state.json')
+        if ($state.state -in @('cancelled','superseded')) { return 60010 }
+        if (-not (Test-IntuneGetNewBoot $state.boot (Get-IntuneGetBoot))) { return 1618 }
+        if (Test-IntuneGetInstalled $config) {
+            Write-IntuneGetState $directory $config 'installed' $state.boot $state.attempts 0
+            Remove-IntuneGetStartupTask $config
+            return 0
+        }
+        if ($state.attempts -ge 3) { Write-IntuneGetState $directory $config 'failed' $state.boot $state.attempts 60010;Remove-IntuneGetStartupTask $config;return 60010 }
+        $global = [Threading.Mutex]::new($false, 'Global\IntuneGetStartupInstaller')
+        $globalLocked = $false
+        try {
+            try { $globalLocked=$global.WaitOne([TimeSpan]::FromMinutes(30)) } catch [Threading.AbandonedMutexException] { $globalLocked=$true }
+            if (-not $globalLocked) { return 1618 }
+            $manifest = Read-IntuneGetJson (Join-Path $directory 'manifest.json')
+            Assert-IntuneGetManifest $expectedPayload $manifest
+            $attempts = [int]$state.attempts + 1
+            Write-IntuneGetState $directory $config 'installing' $state.boot $attempts
+            $process = Start-Process -FilePath (Join-Path $expectedPayload 'Invoke-AppDeployToolkit.exe') -ArgumentList @('-DeploymentType','Install','-DeployMode','Silent','-SuppressRebootPassThru') -WorkingDirectory $expectedPayload -PassThru
+            # Never kill just the launcher and release locks while its installer may still run.
+            # The task has no execution time limit. Keep both mutexes until PSADT completes;
+            # reporting flags an Installing record older than 2 hours for investigation.
+            while (-not $process.WaitForExit(60000)) { }
+            $code=$process.ExitCode
+            $installed=($code -in @(0,1707,3010,1641)) -and (Test-IntuneGetInstalled $config)
+            Write-IntuneGetState $directory $config $(if ($installed) {'installed'} else {'failed'}) $state.boot $attempts $code
+            if ($installed -or $attempts -ge 3) { Remove-IntuneGetStartupTask $config }
+            if ($installed) { try { Assert-IntuneGetOwnedPath $expectedPayload; Remove-Item -LiteralPath $expectedPayload -Recurse -Force } catch { } }
+            return $(if ($installed) {0} else {60010})
+        } catch {
+            Write-IntuneGetState $directory $config 'failed' $state.boot ([int]$state.attempts+1) 60010
+            Remove-IntuneGetStartupTask $config
+            throw
+        } finally { if ($globalLocked) {$global.ReleaseMutex()};$global.Dispose() }
+    } finally { if ($locked) {$mutex.ReleaseMutex()};$mutex.Dispose() }
+}
+# Dot-sourcing is reserved for the local test harness; no installation is started.
+if ($MyInvocation.InvocationName -ne '.') {
+    try { exit (Invoke-IntuneGetStartup) } catch { [Console]::Error.WriteLine('IntuneGet startup installation Beta failed. Review the protected local state and installer logs.');exit 60010 }
+}
