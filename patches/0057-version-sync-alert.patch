@@ -0,0 +1,47 @@
+// HRM patch 0057: the verdict the VM status script copies into hrm-status.json.
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+
+const mocks = vi.hoisted(() => ({ listRecent: vi.fn() }));
+vi.mock('@/lib/db', () => ({ getDatabase: () => ({ versionSyncEvents: { listRecent: mocks.listRecent } }) }));
+
+import { GET } from './route';
+
+const request = (auth?: string) => new Request('http://localhost/api/cron/version-sync-status', { headers: auth ? { authorization: auth } : {} });
+const minutesAgo = (m: number) => new Date(Date.now() - m * 60_000).toISOString();
+
+beforeEach(() => {
+  process.env.CRON_SECRET = 'fixture-cron-secret';
+  mocks.listRecent.mockReset();
+});
+afterEach(() => { delete process.env.CRON_SECRET; });
+
+describe('GET /api/cron/version-sync-status', () => {
+  it('needs the cron secret', async () => {
+    expect((await GET(request())).status).toBe(401);
+    expect((await GET(request('Bearer wrong'))).status).toBe(401);
+    delete process.env.CRON_SECRET;
+    expect((await GET(request('Bearer '))).status).toBe(401);
+    expect(mocks.listRecent).not.toHaveBeenCalled();
+  });
+
+  it('answers the verdict', async () => {
+    mocks.listRecent.mockResolvedValue([
+      { at: minutesAgo(5), appId: 'Vendor.App', result: 'failed', code: 'database_busy' },
+      { at: minutesAgo(60), appId: 'Vendor.Other', result: 'failed', code: 'unknown' },
+    ]);
+    const response = await GET(request('Bearer fixture-cron-secret'));
+    expect(response.status).toBe(200);
+    expect(response.headers.get('Cache-Control')).toBe('no-store');
+    const body = await response.json();
+    expect(body.versionSync).toMatchObject({ ok: false, at: expect.any(String) });
+    expect(body.versionSync.detail).toContain('database busy');
+    expect(JSON.stringify(body)).not.toContain('Vendor.');
+  });
+
+  it('answers 503 without error text when the database fails', async () => {
+    mocks.listRecent.mockRejectedValue(new Error('FORBIDDEN detail'));
+    const response = await GET(request('Bearer fixture-cron-secret'));
+    expect(response.status).toBe(503);
+    expect(await response.text()).not.toContain('FORBIDDEN');
+  });
+});
