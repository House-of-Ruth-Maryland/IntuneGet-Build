diff --git a/lib/hrm/__tests__/version-sync-health.test.ts b/lib/hrm/__tests__/version-sync-health.test.ts
new file mode 100644
index 000000000..89bd65af6
--- /dev/null
+++ b/lib/hrm/__tests__/version-sync-health.test.ts
@@ -0,0 +1,71 @@
+// HRM patch 0057: the "Version sync after deploy" verdict.
+import { describe, expect, it } from 'vitest';
+import {
+  recentVersionSyncEvents,
+  versionSyncErrorCode,
+  versionSyncVerdict,
+  VERSION_SYNC_KEEP,
+  type VersionSyncEvent,
+} from '@/lib/hrm/version-sync-health';
+
+const now = new Date('2026-11-03T12:00:00.000Z');
+const hoursAgo = (h: number) => new Date(now.getTime() - h * 3_600_000).toISOString();
+const failed = (h: number, code: VersionSyncEvent['code'] = 'database_busy'): VersionSyncEvent => ({ at: hoursAgo(h), appId: 'Vendor.App', result: 'failed', code });
+const ok = (h: number): VersionSyncEvent => ({ at: hoursAgo(h), appId: 'Vendor.App', result: 'ok', code: null });
+
+describe('versionSyncVerdict', () => {
+  it('works with nothing recorded', () => {
+    expect(versionSyncVerdict([], now)).toEqual({ ok: true, at: null, detail: null });
+  });
+
+  it('stays working after one failure', () => {
+    expect(versionSyncVerdict([failed(1)], now)).toEqual({ ok: true, at: hoursAgo(1), detail: null });
+  });
+
+  it('fails at 2 failures in the last 24 hours, with a plain reason', () => {
+    const verdict = versionSyncVerdict([failed(1, 'timeout'), failed(20)], now);
+    expect(verdict.ok).toBe(false);
+    expect(verdict.at).toBe(hoursAgo(1));
+    expect(verdict.detail).toBe("2 deploys didn't update App updates in the last 24 hours (timed out). The 3:30 AM or 3:30 PM check corrects them. Tell HRM Support if this lasts.");
+  });
+
+  it('does not count failures older than 24 hours', () => {
+    expect(versionSyncVerdict([failed(1), failed(25)], now).ok).toBe(true);
+  });
+
+  it('clears when a later sync succeeds', () => {
+    expect(versionSyncVerdict([ok(0.5), failed(1), failed(2)], now)).toEqual({ ok: true, at: hoursAgo(0.5), detail: null });
+  });
+
+  it('fails again after 2 more failures following that success', () => {
+    expect(versionSyncVerdict([failed(0.1), ok(0.5), failed(1), failed(2)], now).ok).toBe(true);
+    expect(versionSyncVerdict([failed(0.1), failed(0.2), ok(0.5), failed(1)], now).ok).toBe(false);
+  });
+
+  it('reads entries in any order', () => {
+    expect(versionSyncVerdict([failed(2), ok(0.5), failed(1)], now).ok).toBe(true);
+  });
+});
+
+describe('recentVersionSyncEvents', () => {
+  it('keeps only the newest entries from the last 7 days', () => {
+    const many = Array.from({ length: VERSION_SYNC_KEEP + 10 }, (_, i) => failed(i));
+    const kept = recentVersionSyncEvents([...many, failed(24 * 8), { ...ok(1), at: 'not a time' }], now);
+    expect(kept).toHaveLength(VERSION_SYNC_KEEP);
+    expect(kept[0].at).toBe(hoursAgo(0));
+  });
+});
+
+describe('versionSyncErrorCode', () => {
+  it('maps errors to fixed codes', () => {
+    expect(versionSyncErrorCode(Object.assign(new Error('x'), { code: 'SQLITE_BUSY' }))).toBe('database_busy');
+    expect(versionSyncErrorCode(Object.assign(new Error('x'), { code: 'SQLITE_LOCKED_SHAREDCACHE' }))).toBe('database_busy');
+    expect(versionSyncErrorCode(Object.assign(new Error('x'), { code: 'SQLITE_CONSTRAINT' }))).toBe('database_error');
+    expect(versionSyncErrorCode({ code: 'PGRST301', message: 'x' })).toBe('database_error');
+    expect(versionSyncErrorCode({ code: '23505', message: 'x' })).toBe('database_error');
+    expect(versionSyncErrorCode(Object.assign(new Error('x'), { name: 'TimeoutError' }))).toBe('timeout');
+    expect(versionSyncErrorCode(new Error('fixture detail'))).toBe('unknown');
+    expect(versionSyncErrorCode(null)).toBe('unknown');
+    expect(versionSyncErrorCode('text')).toBe('unknown');
+  });
+});
