@@ -0,0 +1,58 @@
+// @vitest-environment happy-dom
+import { act, createElement } from 'react';
+import { createRoot, type Root } from 'react-dom/client';
+import { afterEach, expect, it, vi } from 'vitest';
+import { TimingEditor } from './AppTimingPanel';
+import type { TimingRow } from '@/lib/hrm/app-timing';
+let root: Root;
+(globalThis as typeof globalThis & { IS_REACT_ACT_ENVIRONMENT: boolean }).IS_REACT_ACT_ENVIRONMENT = true;
+afterEach(async () => { await act(async () => root?.unmount()); document.body.innerHTML = ''; });
+const initial: TimingRow = { id: 'one', label: 'All devices · Required', intent: 'required', token: 'review', restartSupported: true, installTimeSettings: { useLocalTime: true, startDateTime: '2026-12-01T18:00:00Z', deadlineDateTime: '2026-12-01T20:00:00Z' }, restartSettings: null };
+const button = (text: string) => [...document.querySelectorAll('button')].find(b => b.textContent === text)!;
+async function render(row = initial, fail = false) {
+  const request = vi.fn(async (body?: Record<string, unknown>) => { if (body && fail) throw new Error('The assignment changed. Reload timing.'); return body ? { success: true } : { rows: [row] }; });
+  const node = document.createElement('div'); document.body.append(node); root = createRoot(node);
+  await act(async () => root.render(createElement(TimingEditor, { appId: 'app', groupNames: {}, request })));
+  await act(async () => button('Reload timing').click());
+  return request;
+}
+it('loads live dates without browser timezone shifts and saves a changed grace period', async () => {
+  const request = await render();
+  expect(document.querySelector<HTMLInputElement>('[aria-label="App availability"]')!.value).toBe('2026-12-01T18:00');
+  expect(document.querySelector<HTMLInputElement>('[aria-label="Installation deadline"]')!.value).toBe('2026-12-01T20:00');
+  expect((button('Save timing to Intune') as HTMLButtonElement).disabled).toBe(true);
+  await act(async () => document.querySelector<HTMLInputElement>('[aria-label="Restart grace period"]')!.click());
+  await act(async () => button('Save timing to Intune').click());
+  expect(request).toHaveBeenLastCalledWith({ assignmentId: 'one', token: 'review', edit: { installTimeSettings: initial.installTimeSettings, restartSettings: { gracePeriodInMinutes: 1440, countdownDisplayBeforeRestartInMinutes: 15, restartNotificationSnoozeDurationInMinutes: 240 } } });
+  expect(document.body.textContent).toContain('Timing saved to Intune');
+  expect((button('Save timing to Intune') as HTMLButtonElement).disabled || button('Save timing to Intune').closest('fieldset')?.disabled).toBe(true);
+});
+it('does not offer deadlines for Available groups and disables unsupported grace periods', async () => {
+  await render({ ...initial, intent: 'available', label: 'All users · Available', restartSupported: false, installTimeSettings: null });
+  expect(document.querySelector('[aria-label="Installation deadline"]')).toBeNull();
+  expect(document.querySelector<HTMLInputElement>('[aria-label="Restart grace period"]')!.disabled).toBe(true);
+  expect(document.body.textContent).toContain('does not support a grace period');
+});
+it('requires a fresh read after a failed save and never shows success', async () => {
+  await render(initial, true);
+  await act(async () => document.querySelector<HTMLInputElement>('[aria-label="Restart grace period"]')!.click());
+  await act(async () => button('Save timing to Intune').click());
+  expect(document.body.textContent).toContain('The assignment changed');
+  expect(document.body.textContent).not.toContain('Timing saved to Intune');
+  expect(button('Save timing to Intune').closest('fieldset')!.disabled).toBe(true);
+  expect((button('Reload timing') as HTMLButtonElement).disabled).toBe(false);
+});
+it('keeps clock times when changing timezone and blocks a deadline before availability', async () => {
+  const request = await render();
+  const select = document.querySelector<HTMLSelectElement>('[aria-label="Timing time zone"]')!;
+  await act(async () => { select.value = 'utc'; select.dispatchEvent(new Event('change', { bubbles: true })); });
+  expect(document.querySelector<HTMLInputElement>('[aria-label="App availability"]')!.value).toBe('2026-12-01T18:00');
+  const deadline = document.querySelector<HTMLInputElement>('[aria-label="Installation deadline"]')!;
+  await act(async () => {
+    Object.getOwnPropertyDescriptor(HTMLInputElement.prototype, 'value')!.set!.call(deadline, '2026-12-01T17:00');
+    deadline.dispatchEvent(new Event('input', { bubbles: true }));
+  });
+  expect(document.body.textContent).toContain('at or after availability');
+  expect((button('Save timing to Intune') as HTMLButtonElement).disabled).toBe(true);
+  expect(request).toHaveBeenCalledTimes(1);
+});
