+const edit: TimingEdit = { installTimeSettings: { useLocalTime: true, startDateTime: '2026-12-01T18:00:00Z', deadlineDateTime: '2026-12-01T20:00:00Z' }, restartSettings: { gracePeriodInMinutes: 1440, countdownDisplayBeforeRestartInMinutes: 15, restartNotificationSnoozeDurationInMinutes: 240 } };
+const row = { id: 'assignment', intent: 'required', target: { '@odata.type': '#microsoft.graph.allDevicesAssignmentTarget', deviceAndAppManagementAssignmentFilterId: 'filter' }, settings: { '@odata.type': TIMING_SETTINGS, notifications: 'hideAll', deliveryOptimizationPriority: 'foreground', autoUpdateSettings: { custom: 'keep' } } };
+describe('assignment timing', () => {
+  it('preserves settings and targets, and ignores injected properties', () => {
+    expect(applyTiming(row, { ...edit, notifications: 'showAll', target: {} } as TimingEdit)).toEqual({ ...row.settings, ...edit });
+    expect(row.settings).not.toHaveProperty('installTimeSettings');
+  });
+  it('clears timing explicitly without clearing other settings', () => {
+    expect(applyTiming(row, { installTimeSettings: null, restartSettings: null })).toEqual({ ...row.settings, installTimeSettings: null, restartSettings: null });
+  });
+  it('accepts supported timing and an explicitly disabled snooze', () => {
+    expect(timingProblem(edit, 'required', true)).toBeNull();
+    expect(timingProblem({ ...edit, restartSettings: { ...edit.restartSettings, restartNotificationSnoozeDurationInMinutes: 0 } }, 'required', true)).toBeNull();
+  });
+  it.each(['2026-02-30T20:00:00Z', '2026-12-01T25:00:00Z', '2026-12-01', 123, undefined])('rejects malformed dates %s', value => {
+    expect(timingProblem({ ...edit, installTimeSettings: { ...edit.installTimeSettings, startDateTime: value } }, 'required', true)).toMatch(/valid/);
+  });
+  it('refuses deadlines before availability and deadlines for Available', () => {
+    expect(timingProblem({ ...edit, installTimeSettings: { ...edit.installTimeSettings, deadlineDateTime: '2026-11-01T20:00:00Z' } }, 'required', true)).toMatch(/at or after/);
+    expect(timingProblem(edit, 'available', true)).toMatch(/Only Required/);
+  });
+  it.each([0, 20161, -1, 1.5, '60', NaN])('rejects invalid grace minutes %s', value => {
+    expect(timingProblem({ ...edit, restartSettings: { ...edit.restartSettings, gracePeriodInMinutes: value } }, 'required', true)).toMatch(/whole minutes/);
+  });
+  it('rejects countdown and snooze longer than grace, missing objects and unsupported restarts', () => {
+    for (const key of ['countdownDisplayBeforeRestartInMinutes', 'restartNotificationSnoozeDurationInMinutes']) {
+      expect(timingProblem({ ...edit, restartSettings: { ...edit.restartSettings, [key]: 1441 } }, 'required', true)).toMatch(/whole minutes/);
+    }
+    expect(timingProblem({}, 'required', true)).toMatch(/Review/);
+    expect(timingProblem(edit, 'required', false)).toMatch(/does not support/);
+  });
+  it('keeps entered clock times independent of browser timezone', () => {
+    expect(timingTimestamp('2026-12-01T18:00')).toBe('2026-12-01T18:00:00Z');
+    expect(timingInput('2026-12-01T18:00:00Z')).toBe('2026-12-01T18:00');
+    expect(timingTimestamp('')).toBeNull();
+  });
+  it('only edits direct Required and Available inclusions', () => {
+    expect(timingEditable(row)).toBe(true);
+    for (const changed of [{ intent: 'uninstall' }, { source: 'policySets' }, { target: { '@odata.type': '#microsoft.graph.exclusionGroupAssignmentTarget' } }, { settings: { '@odata.type': '#microsoft.graph.winGetAppAssignmentSettings' } }]) expect(timingEditable({ ...row, ...changed })).toBe(false);
+  });
+  it('keeps live timing when the general settings form changes a filter or notifications', () => {
+    const live = { ...row, settings: { ...row.settings, ...edit } };
+    const changed = { ...row, target: { ...row.target, deviceAndAppManagementAssignmentFilterId: 'different' }, settings: { ...row.settings, notifications: 'showAll' } };
+    expect(preserveTiming([changed], [live])[0]).toEqual({ ...changed, settings: { ...changed.settings, ...edit } });
+    expect(preserveTiming([{ ...changed, intent: 'available' }], [live])[0].settings).not.toHaveProperty('installTimeSettings');
+  });
+});
+
+it('reads Graph offsets and fractional seconds as explicit UTC or device clock times', () => {
+  const settings = { useLocalTime: false, startDateTime: '2026-12-01T18:00:00.0000000-05:00', deadlineDateTime: null };
+  expect(readInstallTiming(settings)).toEqual({ ...settings, startDateTime: '2026-12-01T23:00:00.000Z' });
+  expect(readInstallTiming({ ...settings, useLocalTime: true })).toEqual({ ...settings, useLocalTime: true, startDateTime: '2026-12-01T18:00:00Z' });
+});
+
+it('matches group IDs without case differences and refuses ambiguous live timing', () => {
+  const target = { '@odata.type': '#microsoft.graph.groupAssignmentTarget', groupId: 'AAAA' };
+  const live = { ...row, target: { ...target, groupId: 'aaaa' }, settings: { ...row.settings, ...edit } };
+  expect(preserveTiming([{ ...row, target }], [live])[0].settings).toEqual(live.settings);
+  expect(() => preserveTiming([{ ...row, target }], [live, live])).toThrow(/safely match/);
