diff --git a/lib/hrm/app-timing.ts b/lib/hrm/app-timing.ts
new file mode 100644
index 000000000..ac739316b
--- /dev/null
+++ b/lib/hrm/app-timing.ts
@@ -0,0 +1,94 @@
+/** Timing of existing Win32 assignments. Browser-safe validation and editing helpers. */
+import type { GraphAssignment } from './duplicates';
+export const TIMING_SETTINGS = '#microsoft.graph.win32LobAppAssignmentSettings';
+export interface InstallTiming {
+  useLocalTime: boolean;
+  startDateTime: string | null;
+  deadlineDateTime: string | null;
+}
+export interface RestartTiming {
+  gracePeriodInMinutes: number;
+  countdownDisplayBeforeRestartInMinutes: number;
+  restartNotificationSnoozeDurationInMinutes: number;
+}
+export interface TimingEdit { installTimeSettings: InstallTiming | null; restartSettings: RestartTiming | null }
+export interface TimingRow extends TimingEdit { id: string; label: string; intent: string; token: string; restartSupported: boolean }
+export function record(value: unknown): Record<string, unknown> {
+  return value && typeof value === 'object' && !Array.isArray(value) ? value as Record<string, unknown> : {};
+}
+export function timingEditable(row: GraphAssignment) {
+  return (row.source == null || row.source === 'direct') && ['required', 'available'].includes(row.intent) &&
+    !String(row.target['@odata.type']).includes('exclusionGroup') &&
+    (row.settings == null || record(row.settings)['@odata.type'] === TIMING_SETTINGS);
+}
+const dateValid = (v: unknown) => {
+  if (v === null) return true;
+  if (typeof v !== 'string' || !/^\d{4}-\d\d-\d\dT(?:[01]\d|2[0-3]):[0-5]\d:[0-5]\d(?:\.\d{1,7})?(?:Z|[+-](?:[01]\d|2[0-3]):[0-5]\d)$/.test(v) || !Number.isFinite(Date.parse(v))) return false;
+  return new Date(`${v.slice(0, 10)}T00:00:00Z`).toISOString().slice(0, 10) === v.slice(0, 10);
+};
+/** Graph may return fractional seconds and offsets; make the editor's clock unambiguous. */
+export function readInstallTiming(value: unknown): InstallTiming | null {
+  if (value == null) return null;
+  const t = record(value);
+  const local = t.useLocalTime === true;
+  const normalize = (v: unknown) => {
+    if (v == null) return null;
+    if (!dateValid(v)) throw new Error('Unsupported date from Intune');
+    return local ? `${String(v).slice(0, 19)}Z` : new Date(String(v)).toISOString();
+  };
+  return { useLocalTime: local, startDateTime: normalize(t.startDateTime), deadlineDateTime: normalize(t.deadlineDateTime) };
+}
+export function timingProblem(edit: unknown, intent: string, restartSupported: boolean, existingRestart: unknown = null): string | null {
+  const e = record(edit);
+  if (!Object.hasOwn(e, 'installTimeSettings') || !Object.hasOwn(e, 'restartSettings')) return 'Review the timing settings first.';
+  if (e.installTimeSettings !== null) {
+    const t = record(e.installTimeSettings);
+    if (typeof t.useLocalTime !== 'boolean' || !dateValid(t.startDateTime) || !dateValid(t.deadlineDateTime)) return 'Enter valid availability and deadline dates.';
+    if (intent !== 'required' && t.deadlineDateTime !== null) return 'Only Required groups can have an installation deadline.';
+    if (t.startDateTime && t.deadlineDateTime && Date.parse(String(t.deadlineDateTime)) < Date.parse(String(t.startDateTime))) return 'The installation deadline must be at or after availability.';
+  }
+  if (e.restartSettings !== null) {
+    if (!restartSupported && JSON.stringify(e.restartSettings) !== JSON.stringify(existingRestart)) return 'This app does not support a restart grace period. Check its restart behavior in Intune.';
+    const r = record(e.restartSettings);
+    const grace = r.gracePeriodInMinutes, countdown = r.countdownDisplayBeforeRestartInMinutes, snooze = r.restartNotificationSnoozeDurationInMinutes;
+    if (![grace, countdown, snooze].every(Number.isInteger) || (grace as number) < 1 || (grace as number) > 20160 ||
+        (countdown as number) < 1 || (countdown as number) > (grace as number) || (snooze as number) < 0 || (snooze as number) > (grace as number)) {
+      return 'Use whole minutes: grace 1 to 20160, countdown 1 to grace, and snooze 0 to grace (0 disables snooze).';
+    }
+  }
+  return null;
+}
+export function applyTiming(row: GraphAssignment, edit: TimingEdit): Record<string, unknown> {
+  // Explicit allowlist: callers cannot alter notifications, filters, targets or intent.
+  const t = edit.installTimeSettings, r = edit.restartSettings;
+  return { ...record(row.settings), '@odata.type': TIMING_SETTINGS,
+    installTimeSettings: t === null ? null : { useLocalTime: t.useLocalTime, startDateTime: t.startDateTime, deadlineDateTime: t.deadlineDateTime },
+    restartSettings: r === null ? null : { gracePeriodInMinutes: r.gracePeriodInMinutes, countdownDisplayBeforeRestartInMinutes: r.countdownDisplayBeforeRestartInMinutes, restartNotificationSnoozeDurationInMinutes: r.restartNotificationSnoozeDurationInMinutes },
+  };
+}
+// The browser's timezone must never shift a device-local wall clock or a UTC input.
+export const timingInput = (value: string | null | undefined) => value?.slice(0, 16) ?? '';
+export const timingTimestamp = (value: string) => value ? `${value}:00Z` : null;
+
+/** Preserve live timing when the older general settings form saves groups/categories. */
+export function preserveTiming<T extends { intent: string; target: unknown; settings?: unknown }>(rows: T[], live: GraphAssignment[]): T[] {
+  const key = (r: { intent: string; target: unknown }) => {
+    const t = record(r.target);
+    // Filters may change independently; timing belongs to the same group and intent.
+    return JSON.stringify([r.intent, t['@odata.type'], typeof t.groupId === 'string' ? t.groupId.toLowerCase() : '']);
+  };
+  return rows.map(row => {
+    let matches = live.filter(r => key(r) === key(row));
+    if (matches.length > 1) {
+      const target = record(row.target);
+      matches = matches.filter(r => r.target.deviceAndAppManagementAssignmentFilterId === target.deviceAndAppManagementAssignmentFilterId && r.target.deviceAndAppManagementAssignmentFilterType === target.deviceAndAppManagementAssignmentFilterType);
+      if (matches.length !== 1) throw new Error('Cannot safely match live assignment timing. Review the groups in Intune before saving.');
+    }
+    if (matches.length !== 1 || String(record(row.target)['@odata.type']).includes('exclusionGroup')) return row;
+    const old = record(matches[0].settings);
+    return { ...row, settings: { ...record(row.settings),
+      ...(Object.hasOwn(old, 'installTimeSettings') ? { installTimeSettings: old.installTimeSettings } : {}),
+      ...(Object.hasOwn(old, 'restartSettings') ? { restartSettings: old.restartSettings } : {}),
+    } };
+  });
+}
