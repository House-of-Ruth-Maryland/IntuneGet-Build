@@ -841,3 +842,8 @@ export async function applyAppRelationships(
 export function getIntunePortalUrl(appId: string): string {
   return `https://intune.microsoft.com/#view/Microsoft_Intune_Apps/SettingsBlade/appId/${appId}`;
 }
+
