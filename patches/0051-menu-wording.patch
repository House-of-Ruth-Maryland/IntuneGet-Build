diff --git a/components/hrm/UpdateBehaviorSettings.test.ts b/components/hrm/UpdateBehaviorSettings.test.ts
new file mode 100644
index 000000000..b4e5c9012
--- /dev/null
+++ b/components/hrm/UpdateBehaviorSettings.test.ts
@@ -0,0 +1,54 @@
+// @vitest-environment happy-dom
+// HRM patch 0051: Settings' update switches only where they take effect; a link to App updates on SQLite.
+import { afterEach, describe, expect, it, vi } from 'vitest';
+import { act, createElement } from 'react';
+import { createRoot, type Root } from 'react-dom/client';
+
+(globalThis as { IS_REACT_ACT_ENVIRONMENT?: boolean }).IS_REACT_ACT_ENVIRONMENT = true;
+
+let root: Root | null = null;
+let container: HTMLDivElement | null = null;
+
+afterEach(() => {
+  act(() => root?.unmount());
+  container?.remove();
+  root = null;
+  container = null;
+  vi.unstubAllGlobals();
+  vi.resetModules();
+});
+
+async function renderWithMode(databaseMode: string | null) {
+  vi.stubGlobal('fetch', vi.fn(async () => (databaseMode === null
+    ? Promise.reject(new Error('offline'))
+    : new Response(JSON.stringify({ databaseMode }), { status: 200 }))));
+  const { UpdateBehaviorSettings } = await import('./UpdateBehaviorSettings');
+  container = document.createElement('div');
+  document.body.appendChild(container);
+  root = createRoot(container);
+  await act(async () => {
+    root!.render(createElement(UpdateBehaviorSettings, null, createElement('p', null, 'Carry over assignments')));
+  });
+  await act(async () => { await new Promise((r) => setTimeout(r, 0)); });
+  return container;
+}
+
+describe('UpdateBehaviorSettings', () => {
+  it('replaces the switches with a link to App updates on a SQLite server', async () => {
+    const el = await renderWithMode('sqlite');
+    expect(el.textContent).not.toContain('Carry over assignments');
+    expect(el.textContent).toContain('Update behavior is set on App updates.');
+    const link = el.querySelector('a');
+    expect(link?.getAttribute('href')).toBe('/dashboard/updates');
+    expect(link?.textContent).toBe('App updates');
+  });
+
+  it('shows the switches on a Supabase server, where they take effect', async () => {
+    const el = await renderWithMode('supabase');
+    expect(el.textContent).toBe('Carry over assignments');
+  });
+
+  it('shows nothing while the mode cannot be read', async () => {
+    expect((await renderWithMode(null)).textContent).toBe('');
+  });
+});
diff --git a/components/hrm/UpdateBehaviorSettings.tsx b/components/hrm/UpdateBehaviorSettings.tsx
new file mode 100644
index 000000000..4aa0bf0ca
--- /dev/null
+++ b/components/hrm/UpdateBehaviorSettings.tsx
@@ -0,0 +1,25 @@
+'use client';
+
+import type { ReactNode } from 'react';
+import Link from 'next/link';
+import { useDatabaseMode } from '@/hooks/use-database-mode';
+
+// HRM patch 0051: Settings > General's "Carry over assignments" and "Supersede previous version on
+// update" take effect only in Supabase mode (same gate as patch 0035). On a SQLite server, Update and
+// automatic updates always replace the previous version and keep its groups, so the switches are
+// replaced by one line pointing to App updates, where update behavior is set. Nothing shows until the
+// mode is known.
+export function UpdateBehaviorSettings({ children }: { children: ReactNode }) {
+  const mode = useDatabaseMode();
+  if (mode === 'supabase') return <>{children}</>;
+  if (mode !== 'sqlite') return null;
+  return (
+    <section className="glass-light rounded-xl p-6 border border-overlay/5">
+      <p className="text-text-primary font-medium">Update behavior</p>
+      <p className="text-sm text-text-muted">
+        Update behavior is set on{' '}
+        <Link href="/dashboard/updates" className="text-accent-cyan hover:underline">App updates</Link>.
+      </p>
+    </section>
+  );
+}
