diff --git a/lib/hrm/intune-app-ids.ts b/lib/hrm/intune-app-ids.ts
new file mode 100644
index 000000000..93a518ba2
--- /dev/null
+++ b/lib/hrm/intune-app-ids.ts
@@ -0,0 +1,40 @@
+/**
+ * HRM patch 0023: which Win32 apps still exist in Intune.
+ *
+ * IntuneGet keeps its own deployment history, so a copy deleted in Intune
+ * still looked like a deployed app: App updates listed it and auto-update
+ * could act on it. The update check asks Intune for the current list and
+ * skips copies that are gone. If Intune can't be asked, nothing is skipped.
+ */
+
+import { inventoryPageUrl } from '@/lib/intune/inventory-list';
+import { getServicePrincipalToken } from '@/lib/intune/graph-client';
+
+const MAX_PAGES = 50;
+
+// IDs are lower-case.
+export type ExistingAppIds = (tenantId: string) => Promise<Set<string> | null>;
+
+/** Every Win32 app ID in the tenant, or null when Intune couldn't be read completely. */
+export async function listWin32AppIds(
+  tenantId: string,
+  deps: { token?: (tenantId: string) => Promise<string | null>; fetchImpl?: typeof fetch } = {}
+): Promise<Set<string> | null> {
+  if (!tenantId) return null;
+  const token = await (deps.token ?? getServicePrincipalToken)(tenantId).catch(() => null);
+  if (!token) return null;
+  const doFetch = deps.fetchImpl ?? fetch;
+  const ids = new Set<string>();
+  let url: string | null = `${inventoryPageUrl(null)}&$select=id`;
+  for (let page = 0; url && page < MAX_PAGES; page++) {
+    const response = await doFetch(url, { headers: { Authorization: `Bearer ${token}` }, cache: 'no-store' }).catch(() => null);
+    if (!response?.ok) return null;
+    const body = (await response.json().catch(() => null)) as { value?: Array<{ id?: string }>; '@odata.nextLink'?: string } | null;
+    if (!body || !Array.isArray(body.value)) return null;
+    for (const app of body.value) if (app.id) ids.add(app.id.toLowerCase());
+    const next = body['@odata.nextLink'];
+    url = typeof next === 'string' && next.startsWith('https://graph.microsoft.com/') ? next : null;
+  }
+  // Stopped at the page limit: the list may be incomplete, so don't skip anything.
+  return url ? null : ids;
+}
