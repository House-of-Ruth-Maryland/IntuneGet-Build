+// @vitest-environment happy-dom
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { act, createElement } from 'react';
+import { createRoot, type Root } from 'react-dom/client';
+
+const state = vi.hoisted(() => ({ value: {} as { data?: unknown; isLoading?: boolean; error?: Error | null } }));
+vi.mock('@/hooks/use-inventory', () => ({ useAppDetails: () => state.value }));
+import { AppGroupsLine } from './AppGroupsLine';
+
+let root: Root;
+(globalThis as typeof globalThis & { IS_REACT_ACT_ENVIRONMENT: boolean }).IS_REACT_ACT_ENVIRONMENT = true;
+const group = (id: string, intent: string) => ({ intent, target: { '@odata.type': '#microsoft.graph.groupAssignmentTarget', groupId: id } });
+
+async function render(id: string | null = 'app-1') {
+  await act(async () => root.render(createElement(AppGroupsLine, { intuneAppId: id })));
+  return document.body.textContent ?? '';
+}
+
+beforeEach(() => {
+  const el = document.createElement('div');
+  document.body.append(el);
+  root = createRoot(el);
+});
+afterEach(async () => {
+  await act(async () => root.unmount());
+  document.body.innerHTML = '';
+});
+
+describe('AppGroupsLine', () => {
+  it('names each group and how it is assigned', async () => {
+    state.value = { data: { app: { assignments: [group('g1', 'required'), group('g2', 'available')],
+      assignmentGroupNames: { g1: 'APP-Example', g2: 'Staff-Example' } } } };
+    expect(await render()).toBe('APP-Example · Required, Staff-Example · Available');
+  });
+
+  it('shortens a long list', async () => {
+    state.value = { data: { app: { assignments: ['a', 'b', 'c', 'd', 'e'].map((g) => group(g, 'required')),
+      assignmentGroupNames: { a: 'A', b: 'B', c: 'C', d: 'D', e: 'E' } } } };
+    expect(await render()).toContain('and 2 more');
+  });
+
+  it('warns when the copy has no groups or is gone from Intune', async () => {
+    state.value = { data: { app: { assignments: [] } } };
+    expect(await render()).toContain('No groups. This copy installs nowhere.');
+    state.value = { error: new Error('App not found') };
+    expect(await render()).toContain('Not in Intune any more');
+  });
+
+  it('shows nothing for other errors or without an app ID', async () => {
+    state.value = { error: new Error('Failed to fetch app details') };
