@@ -0,0 +1,49 @@
+'use client';
+
+// HRM patch 0023: which groups an Intune app is assigned to, in one line, read live from Intune.
+
+import { AlertTriangle, Users } from 'lucide-react';
+import { useAppDetails } from '@/hooks/use-inventory';
+import { assignmentTargetLabel } from '@/lib/intune/assignment-group-names';
+
+const INTENT: Record<string, string> = { required: 'Required', available: 'Available', uninstall: 'Uninstall', availableWithoutEnrollment: 'Available' };
+const SHOWN = 3;
+
+export function AppGroupsLine({ intuneAppId }: { intuneAppId: string | null | undefined }) {
+  const { data, isLoading, error } = useAppDetails(intuneAppId || null);
+  if (!intuneAppId) return null;
+  if (isLoading) return <p className="text-xs text-text-muted">Checking groups…</p>;
+  if (error) {
+    const gone = error instanceof Error && /not found/i.test(error.message);
+    return gone ? (
+      <p className="flex items-center gap-1.5 text-xs text-amber-600 dark:text-amber-400">
+        <AlertTriangle className="h-3.5 w-3.5 flex-shrink-0" aria-hidden="true" />
+        Not in Intune any more. Don&apos;t update this copy.
+      </p>
+    ) : null;
+  }
+  const app = data?.app;
+  if (!app) return null;
+  const assignments = app.assignments ?? [];
+  if (assignments.length === 0) {
+    return (
+      <p className="flex items-center gap-1.5 text-xs text-amber-600 dark:text-amber-400">
+        <AlertTriangle className="h-3.5 w-3.5 flex-shrink-0" aria-hidden="true" />
+        No groups. This copy installs nowhere.
+      </p>
+    );
+  }
+  const labels = assignments.map((a) => {
+    const target = assignmentTargetLabel(a.target, app.assignmentGroupNames, app.assignmentGroupLookupFailures).replace(/^Group: /, '');
+    return `${target} · ${INTENT[a.intent] ?? a.intent}`;
+  });
+  return (
+    <p className="flex items-start gap-1.5 text-xs text-text-secondary">
+      <Users className="mt-0.5 h-3.5 w-3.5 flex-shrink-0 text-text-muted" aria-hidden="true" />
+      <span>
+        {labels.slice(0, SHOWN).join(', ')}
+        {labels.length > SHOWN && <span className="text-text-muted"> and {labels.length - SHOWN} more</span>}
+      </span>
+    </p>
+  );
+}
