@@ -0,0 +1,19 @@
+import { NextRequest } from 'next/server';
+import { beforeEach, describe, expect, it, vi } from 'vitest';
+const mocks = vi.hoisted(() => ({ auth: vi.fn(), jobs: vi.fn() }));
+vi.mock('@/lib/auth-utils', () => ({ parseAccessToken: mocks.auth }));
+vi.mock('@/lib/db', () => ({ getDatabase: () => ({ jobs: { getByUserId: mocks.jobs } }) }));
+import { GET } from './route';
+const today = new Date().toISOString();
+const job = (id: string, status: string) => ({ id, status, winget_id: 'Example.App', display_name: 'Example', publisher: 'Example Publisher', error_message: status === 'failed' ? 'fixture error' : null, created_at: today, completed_at: today });
+const request = () => new NextRequest('http://localhost/api/analytics?days=7');
+beforeEach(() => { vi.clearAllMocks(); mocks.auth.mockResolvedValue({ userId: 'caller' }); });
+describe('deployment analytics', () => {
+  it('counts deployed jobs from GitHub-mode packaging as successful', async () => {
+    mocks.jobs.mockResolvedValue([job('a', 'deployed'), job('b', 'deployed'), job('c', 'completed'), job('d', 'failed'), job('e', 'queued')]);
+    const v = await (await GET(request())).json();
+    expect(v.summary).toMatchObject({ totalJobs: 5, completedJobs: 3, failedJobs: 1, pendingJobs: 1, successRate: 75 });
+    expect(v.dailyDeployments.reduce((n: number, d: { completed: number }) => n + d.completed, 0)).toBe(3);
+    expect(v.topApps).toEqual([{ wingetId: 'Example.App', displayName: 'Example', publisher: 'Example Publisher', count: 3 }]);
+  });
+});
