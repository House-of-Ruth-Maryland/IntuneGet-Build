diff --git a/app/api/intune/apps/[id]/win32-only.test.ts b/app/api/intune/apps/[id]/win32-only.test.ts
new file mode 100644
index 000000000..78d2968b3
--- /dev/null
+++ b/app/api/intune/apps/[id]/win32-only.test.ts
@@ -0,0 +1,35 @@
+import { NextRequest } from 'next/server';
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+const mocks = vi.hoisted(() => ({ auth: vi.fn(), token: vi.fn() }));
+vi.mock('@/lib/auth-utils', () => ({ parseAccessToken: mocks.auth }));
+vi.mock('@/lib/intune/graph-client', () => ({ getServicePrincipalToken: mocks.token }));
+vi.mock('@/lib/supabase', () => ({ getServerClientOrNull: () => null }));
+vi.mock('@/lib/msp/tenant-resolution', () => ({ resolveTargetTenantId: vi.fn() }));
+import { GET } from './route';
+
+// HRM patch 0025: Inventory links open Win32 apps only; any other app type reads as not found.
+const id = '11111111-1111-4111-8111-111111111111';
+const request = () => new NextRequest(`http://localhost/api/intune/apps/${id}`);
+const params = { params: Promise.resolve({ id }) };
+const graph = (type: string) => vi.fn(async (url: string) =>
+  Response.json(url.endsWith('/assignments') ? { value: [] } : { '@odata.type': type, id, displayName: 'Fixture' }));
+beforeEach(() => { vi.clearAllMocks(); mocks.auth.mockResolvedValue({ userId: 'user', tenantId: 'self' }); mocks.token.mockResolvedValue('token'); });
+afterEach(() => vi.unstubAllGlobals());
+
+describe('app details for linked ids', () => {
+  it('returns a Win32 app', async () => {
+    vi.stubGlobal('fetch', graph('#microsoft.graph.win32LobApp'));
+    const response = await GET(request(), params);
+    expect(response.status).toBe(200);
+    expect((await response.json()).app.displayName).toBe('Fixture');
+  });
+
+  it('answers App not found for other app types', async () => {
+    for (const type of ['#microsoft.graph.iosStoreApp', '#microsoft.graph.winGetApp', '#microsoft.graph.officeSuiteApp']) {
+      vi.stubGlobal('fetch', graph(type));
+      const response = await GET(request(), params);
+      expect(response.status).toBe(404);
+      expect(await response.json()).toEqual({ error: 'App not found' });
+    }
+  });
+});
diff --git a/components/inventory/inventory-app-link.test.ts b/components/inventory/inventory-app-link.test.ts
