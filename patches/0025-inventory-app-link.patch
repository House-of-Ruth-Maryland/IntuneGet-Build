+
+// HRM patch 0025: a link to an unknown or non-Win32 app shows the panel's error, not a blank panel.
+vi.mock('@/hooks/use-inventory', () => ({
+  useAppDetails: () => ({ data: undefined, isLoading: false, error: new Error('App not found'), refetch: vi.fn() }),
+}));
+vi.mock('@/hooks/useNewVersionPrefill', () => ({ useNewVersionPrefill: () => ({ data: null }) }));
+vi.mock('@/hooks/useInstallStatus', () => ({ useInstallStatus: () => ({ data: null }) }));
+vi.mock('@/components/dashboard/animations/SlidePanel', () => ({
+  SlidePanel: ({ children, isOpen }: { children: React.ReactNode; isOpen: boolean }) => (isOpen ? children : null),
+}));
+import { InventoryAppDetails } from './InventoryAppDetails';
+
+let root: Root;
+(globalThis as typeof globalThis & { IS_REACT_ACT_ENVIRONMENT: boolean }).IS_REACT_ACT_ENVIRONMENT = true;
+afterEach(async () => { await act(async () => root?.unmount()); document.body.innerHTML = ''; });
+
+describe('inventory details for an app that is not found', () => {
+  it('shows the not-found error', async () => {
+    const container = document.createElement('div');
+    document.body.append(container);
+    root = createRoot(container);
+    await act(async () => root.render(createElement(InventoryAppDetails, { appId: '11111111-1111-4111-8111-111111111111', onClose: vi.fn() })));
+    expect(container.textContent).toContain('Failed to load app');
+    expect(container.textContent).toContain('App not found');
+    expect(container.textContent).toContain('Try Again');
+  });
+});
