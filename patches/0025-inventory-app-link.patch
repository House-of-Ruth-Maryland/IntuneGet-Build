+++ b/components/inventory/inventory-app-link.test.ts
@@ -0,0 +1,101 @@
+// @vitest-environment happy-dom
+import { act, createElement, type ReactNode } from 'react';
+import { createRoot, type Root } from 'react-dom/client';
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+
+// HRM patch 0025: /dashboard/inventory?app=<Intune app id> opens that app's details.
+const state = vi.hoisted(() => ({ search: '', replace: vi.fn(), push: vi.fn() }));
+vi.mock('next/navigation', () => ({
+  useRouter: () => ({ replace: state.replace, push: state.push }),
+  useSearchParams: () => new URLSearchParams(state.search),
+}));
+vi.mock('gt-next', () => ({ T: ({ children }: { children: ReactNode }) => children }));
+vi.mock('framer-motion', () => ({
+  motion: { div: ({ children }: { children: ReactNode }) => createElement('div', null, children) },
+  useReducedMotion: () => true,
+}));
+vi.mock('@/hooks/use-inventory', () => ({
+  useInventoryApps: () => ({
+    data: { apps: [{ id: 'listed', displayName: 'Fixture', publisher: 'Example', createdDateTime: '2026-01-01T00:00:00Z', lastModifiedDateTime: '2026-01-01T00:00:00Z' }] },
+    isLoading: false, error: null, refetch: vi.fn(), isFetching: false, isComplete: true,
+  }),
+}));
+vi.mock('@/components/providers/UserSettingsProvider', () => ({
+  useUserSettings: () => ({ settings: { viewMode: 'grid' }, setViewMode: vi.fn() }),
+}));
+vi.mock('@/components/dashboard', () => ({
+  PageHeader: () => null, AnimatedEmptyState: () => null, SkeletonGrid: () => null,
+  AnimatedStatCard: () => null, StatCardGrid: () => null,
+}));
+vi.mock('@/components/inventory', () => ({
+  InventoryAppCard: ({ app, onClick }: { app: { id: string }; onClick: () => void }) =>
+    createElement('button', { 'data-card': app.id, onClick }),
+  InventoryAppDetails: ({ appId, onClose }: { appId: string | null; onClose: () => void }) =>
+    createElement('div', { 'data-details': appId ?? '' }, createElement('button', { 'data-close': '', onClick: onClose })),
+  InventoryFilters: () => null, InventoryListRow: () => null,
+  InventoryPagination: () => null, InventoryListHeader: () => null,
+}));
+
+import InventoryPage from '@/app/(app)/dashboard/inventory/page';
+import { linkedAppId } from '@/lib/hrm/inventory-link';
+
+const id = '11111111-1111-4111-8111-111111111111';
+let root: Root;
+let container: HTMLDivElement;
+(globalThis as typeof globalThis & { IS_REACT_ACT_ENVIRONMENT: boolean }).IS_REACT_ACT_ENVIRONMENT = true;
+
+async function render(search: string) {
+  state.search = search;
+  container = document.createElement('div');
+  document.body.append(container);
+  root = createRoot(container);
+  await act(async () => root.render(createElement(InventoryPage)));
+}
+const openApp = () => container.querySelector('[data-details]')?.getAttribute('data-details');
+const click = (selector: string) => act(async () => (container.querySelector(selector) as HTMLElement).click());
+
+beforeEach(() => { state.replace.mockReset(); state.push.mockReset(); });
+afterEach(async () => { await act(async () => root?.unmount()); document.body.innerHTML = ''; });
+
+describe('linkedAppId', () => {
+  it('accepts an Intune app id in any case', () => {
+    expect(linkedAppId(id)).toBe(id);
+    expect(linkedAppId(` ${id.toUpperCase()} `)).toBe(id);
+  });
+  it('ignores anything that is not a GUID', () => {
+    for (const value of [null, undefined, '', 'listed', `${id}x`, `${id}/assignments`, '../settings', '11111111111141118111111111111111']) {
+      expect(linkedAppId(value)).toBeNull();
+    }
+  });
+});
+
+describe('inventory link to an app', () => {
+  it('opens the linked app\'s details', async () => {
+    await render(`app=${id}`);
+    expect(openApp()).toBe(id);
+  });
+
+  it('opens nothing without a link or with an id that is not a GUID', async () => {
+    await render('');
+    expect(openApp()).toBe('');
+    await act(async () => root.unmount());
+    await render('app=..%2Fsettings');
+    expect(openApp()).toBe('');
+  });
+
+  it('clears the link when the details close, so a refresh does not reopen them', async () => {
+    await render(`app=${id}&q=keep`);
+    await click('[data-close]');
+    expect(openApp()).toBe('');
+    expect(state.replace).toHaveBeenCalledWith('/dashboard/inventory');
+  });
+
+  it('leaves the address alone when there was no link', async () => {
+    await render('');
+    await click('[data-card="listed"]');
+    expect(openApp()).toBe('listed');
+    await click('[data-close]');
+    expect(openApp()).toBe('');
+    expect(state.replace).not.toHaveBeenCalled();
+  });
+});
