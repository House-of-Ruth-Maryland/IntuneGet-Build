diff --git a/lib/hrm/inventory-link.ts b/lib/hrm/inventory-link.ts
new file mode 100644
index 000000000..2abe88545
--- /dev/null
+++ b/lib/hrm/inventory-link.ts
@@ -0,0 +1,16 @@
+/**
+ * HRM patch 0025: open an app's details from a link.
+ *
+ * /dashboard/inventory?app=<Intune app id> opens that app's details panel, so
+ * other tools can link straight to one Win32 app. Intune app ids are GUIDs;
+ * anything else is ignored and the page opens as usual.
+ */
+
+export const INVENTORY_PATH = '/dashboard/inventory';
+
+const GUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
+
+export function linkedAppId(value: string | null | undefined): string | null {
+  const id = value?.trim() ?? '';
+  return GUID.test(id) ? id.toLowerCase() : null;
+}
