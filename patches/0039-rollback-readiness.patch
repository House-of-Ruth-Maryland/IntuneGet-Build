diff --git a/lib/hrm/installer-check.ts b/lib/hrm/installer-check.ts
new file mode 100644
index 000000000..28e04d640
--- /dev/null
+++ b/lib/hrm/installer-check.ts
@@ -0,0 +1,160 @@
+/**
+ * HRM patch 0039: does a saved installer still download?
+ *
+ * Going back to a previous version (patch 0037) reuses the installer IntuneGet used before, and
+ * vendors sometimes delete old downloads. These checks run on the server, so they only fetch https
+ * addresses on public hosts: every hop of a redirect is checked again, credentials and other ports
+ * are refused, and a host that resolves to a private, loopback or link-local address is refused, so a
+ * each connection resolves and validates its destination again before connecting.
+ */
+import { lookup as dnsLookup } from 'node:dns/promises';
+import { createHash } from 'node:crypto';
+import { isIP } from 'node:net';
+import { request as httpsRequest } from 'node:https';
+import { Readable } from 'node:stream';
+
+export type Reachability = { status: 'ready' | 'missing' | 'unreachable'; detail: string | null; finalUrl: string | null };
+type Lookup = (host: string) => Promise<Array<{ address: string }>>;
+export interface CheckOptions { fetchImpl?: typeof fetch; lookup?: Lookup; timeoutMs?: number }
+
+const MAX_REDIRECTS = 5;
+const defaultLookup: Lookup = (host) => dnsLookup(host, { all: true, verbatim: true });
+
+/** True only for addresses on the public internet. */
+export function isPublicAddress(address: string): boolean {
+  const v = isIP(address);
+  if (v === 4) {
+    const [a, b] = address.split('.').map(Number);
+    if (a === 0 || a === 10 || a === 127 || a >= 224) return false;
+    if (a === 169 && b === 254) return false;
+    if (a === 172 && b >= 16 && b <= 31) return false;
+    if (a === 192 && b === 168) return false;
+    if (a === 100 && b >= 64 && b <= 127) return false; // carrier-grade NAT
+    if (a === 192 && b === 0) return false;
+    if (a === 198 && (b === 18 || b === 19)) return false;
+    return true;
+  }
+  if (v === 6) {
+    const x = address.toLowerCase();
+    if (x === '::' || x === '::1') return false;
+    if (x.startsWith('::ffff:')) return isPublicAddress(x.slice(7));
+    if (/^f[cd]/.test(x) || /^fe[89ab]/.test(x) || x.startsWith('ff')) return false;
+    // Only global unicast; refuse transition, documentation and special-use ranges.
+    return /^[23]/.test(x) && !x.startsWith('2001:') && !x.startsWith('2002:');
+  }
+  return false;
+}
+
+/** An https address on port 443 with no credentials, or null. */
+export function safeHttpsUrl(raw: string): URL | null {
+  let url: URL;
+  try { url = new URL(raw); } catch { return null; }
+  if (url.protocol !== 'https:' || url.username || url.password || (url.port && url.port !== '443')) return null;
+  return url;
+}
+
+async function publicHost(url: URL, lookup: Lookup): Promise<boolean> {
+  const host = url.hostname.replace(/^\[|\]$/g, '');
+  if (isIP(host)) return isPublicAddress(host);
+  const answers = await lookup(host).catch(() => []);
+  return answers.length > 0 && answers.every((a) => isPublicAddress(a.address));
+}
+
+/** Native HTTPS keeps the validated DNS answer bound to the actual socket. */
+const publicFetch: typeof fetch = async (input, init) => {
+  const url = new URL(String(input));
+  if (!safeHttpsUrl(url.href)) throw new Error('Unsafe download address');
+  if (isIP(url.hostname.replace(/^\[|\]$/g, '')) && !isPublicAddress(url.hostname.replace(/^\[|\]$/g, ''))) throw new Error('Private address');
+  return new Promise<Response>((resolve, reject) => {
+    const req = httpsRequest(url, {
+      method: init?.method ?? 'GET', signal: init?.signal ?? undefined,
+      headers: Object.fromEntries(new Headers(init?.headers).entries()),
+      lookup(host, _options, callback) {
+        defaultLookup(host).then((answers) => {
+          if (!answers.length || answers.some(a => !isPublicAddress(a.address))) return callback(new Error('Private address'), '', 4);
+          // Node requests all answers when automatic family selection is enabled.
+          if (_options.all) callback(null, answers.map(a => ({ address: a.address, family: isIP(a.address) })) as never, 4);
+          else callback(null, answers[0].address, isIP(answers[0].address));
+        }).catch(error => callback(error, '', 4));
+      },
+    }, response => {
+      const headers = new Headers();
+      for (const [name, value] of Object.entries(response.headers)) {
+        if (value !== undefined) headers.set(name, Array.isArray(value) ? value.join(', ') : value);
+      }
+      const status = response.statusCode ?? 500;
+      if (init?.method === 'HEAD' || [204, 205, 304].includes(status)) {
+        response.resume(); resolve(new Response(null, { status, headers }));
+      } else {
+        resolve(new Response(Readable.toWeb(response) as ReadableStream<Uint8Array>, { status, headers }));
+      }
+    });
+    req.on('error', reject); req.end();
+  });
+};
+
+/** Follow up to 5 redirects with HEAD (or a 1-byte GET where HEAD isn't allowed). Never downloads the file. */
+export async function checkInstallerReachable(raw: string, options: CheckOptions = {}): Promise<Reachability> {
+  const fetchImpl = options.fetchImpl ?? publicFetch;
+  const lookup = options.lookup ?? defaultLookup;
+  let current = raw;
+  for (let hop = 0; hop <= MAX_REDIRECTS; hop++) {
+    const url = safeHttpsUrl(current);
+    if (!url) return { status: 'unreachable', detail: 'The saved download link is not an https address IntuneGet can check.', finalUrl: null };
+    if (!(await publicHost(url, lookup))) return { status: 'unreachable', detail: `${url.hostname} could not be found, or is not a public address.`, finalUrl: null };
+    let response: Response;
+    try {
+      const signal = AbortSignal.timeout(options.timeoutMs ?? 15000);
+      response = await fetchImpl(url, { method: 'HEAD', redirect: 'manual', cache: 'no-store', signal });
+      if ([403, 405, 501].includes(response.status)) {
+        response = await fetchImpl(url, { method: 'GET', redirect: 'manual', cache: 'no-store', signal, headers: { Range: 'bytes=0-0' } });
+        await response.body?.cancel().catch(() => undefined);
+      }
+    } catch {
+      return { status: 'unreachable', detail: `${url.hostname} did not answer.`, finalUrl: null };
+    }
+    await response.body?.cancel().catch(() => undefined);
+    if (response.status >= 300 && response.status < 400) {
+      const location = response.headers.get('location');
+      if (!location) return { status: 'unreachable', detail: `${url.hostname} sent a redirect with no address.`, finalUrl: null };
+      try { current = new URL(location, url).href; } catch { return { status: 'unreachable', detail: 'The download sent an invalid redirect.', finalUrl: null }; }
+      continue;
+    }
+    if (response.ok) return { status: 'ready', detail: null, finalUrl: url.href };
+    if (response.status === 404 || response.status === 410) return { status: 'missing', detail: `${url.hostname} says the file is gone (${response.status}).`, finalUrl: null };
+    return { status: 'unreachable', detail: `${url.hostname} answered ${response.status}.`, finalUrl: null };
+  }
+  return { status: 'unreachable', detail: 'The download link redirects too many times.', finalUrl: null };
+}
+
+/** Download once (never saved) and compare the SHA-256 with the one IntuneGet recorded. */
+export async function verifyInstallerChecksum(raw: string, expectedSha256: string, options: CheckOptions & { maxBytes?: number } = {}):
+  Promise<{ status: 'match' | 'mismatch' | 'missing' | 'unreachable'; detail: string | null }> {
+  const reach = await checkInstallerReachable(raw, options);
+  if (reach.status !== 'ready' || !reach.finalUrl) return { status: reach.status === 'missing' ? 'missing' : 'unreachable', detail: reach.detail };
+  const fetchImpl = options.fetchImpl ?? publicFetch;
+  const maxBytes = options.maxBytes ?? 4 * 1024 ** 3;
+  try {
+    const response = await fetchImpl(reach.finalUrl, { redirect: 'error', cache: 'no-store', signal: AbortSignal.timeout(options.timeoutMs ?? 15 * 60000) });
+    if (!response.ok || !response.body) {
+      await response.body?.cancel().catch(() => undefined);
+      return { status: [404, 410].includes(response.status) ? 'missing' : 'unreachable', detail: `The download answered ${response.status}.` };
+    }
+    const hash = createHash('sha256');
+    let bytes = 0;
+    const reader = response.body.getReader();
+    for (;;) {
+      const { done, value } = await reader.read();
+      if (done) break;
+      bytes += value.byteLength;
+      if (bytes > maxBytes) { await reader.cancel(); return { status: 'unreachable', detail: 'The download is larger than IntuneGet checks (4 GB).' }; }
+      hash.update(value);
+    }
+    const actual = hash.digest('hex');
+    return actual.toLowerCase() === expectedSha256.trim().toLowerCase()
+      ? { status: 'match', detail: null }
+      : { status: 'mismatch', detail: 'The file at the saved link has changed since IntuneGet used it.' };
+  } catch {
+    return { status: 'unreachable', detail: 'The download stopped before it finished.' };
+  }
+}
diff --git a/lib/hrm/rollback-readiness-store.ts b/lib/hrm/rollback-readiness-store.ts
new file mode 100644
index 000000000..be2fb45f9
--- /dev/null
+++ b/lib/hrm/rollback-readiness-store.ts
@@ -0,0 +1,36 @@
+/** HRM patch 0039: the last check of each copy's previous installer (one row per Intune app copy). */
+import type Database from 'better-sqlite3';
+
+export type ReadinessStatus = 'ready' | 'missing' | 'unreachable';
+export type ChecksumStatus = 'checking' | 'match' | 'mismatch' | 'missing' | 'unreachable';
+export interface Readiness {
+  tenant_id: string; app_id: string; previous_job_id: string; previous_version: string;
+  status: ReadinessStatus; detail: string | null; checked_at: string;
+  checksum_status: ChecksumStatus | null; checksum_checked_at: string | null;
+}
+
+export function createRollbackReadinessStore(getDb: () => Database.Database) {
+  return {
+    get(tenant: string, appId: string): Readiness | null {
+      return (getDb().prepare('SELECT * FROM hrm_rollback_readiness WHERE tenant_id = ? AND app_id = ?').get(tenant, appId) as Readiness) ?? null;
+    },
+    /** A new previous installer clears the old checksum result. */
+    record(row: Omit<Readiness, 'checksum_status' | 'checksum_checked_at'>) {
+      getDb().prepare(`INSERT INTO hrm_rollback_readiness (tenant_id, app_id, previous_job_id, previous_version, status, detail, checked_at) VALUES (?,?,?,?,?,?,?)
+        ON CONFLICT (tenant_id, app_id) DO UPDATE SET status = excluded.status, detail = excluded.detail, checked_at = excluded.checked_at,
+          checksum_status = CASE WHEN previous_job_id = excluded.previous_job_id THEN checksum_status END,
+          checksum_checked_at = CASE WHEN previous_job_id = excluded.previous_job_id THEN checksum_checked_at END,
+          previous_job_id = excluded.previous_job_id, previous_version = excluded.previous_version`)
+        .run(row.tenant_id, row.app_id, row.previous_job_id, row.previous_version, row.status, row.detail, row.checked_at);
+    },
+    checksum(tenant: string, appId: string, previousJobId: string, status: ChecksumStatus, detail: string | null) {
+      const now = new Date().toISOString();
+      return getDb().prepare(`UPDATE hrm_rollback_readiness SET checksum_status = ?, checksum_checked_at = ?,
+          status = CASE WHEN ? = 'missing' THEN 'missing' WHEN ? IN ('match','mismatch') THEN 'ready' ELSE status END,
+          detail = CASE WHEN ? = 'checking' THEN detail ELSE ? END, checked_at = CASE WHEN ? = 'checking' THEN checked_at ELSE ? END
+        WHERE tenant_id = ? AND app_id = ? AND previous_job_id = ?`)
+        .run(status, now, status, status, status, detail, status, now, tenant, appId, previousJobId).changes === 1;
+    },
+    remove(tenant: string, appId: string) { getDb().prepare('DELETE FROM hrm_rollback_readiness WHERE tenant_id = ? AND app_id = ?').run(tenant, appId); },
+  };
+}
diff --git a/lib/hrm/rollback-readiness.ts b/lib/hrm/rollback-readiness.ts
new file mode 100644
index 000000000..8a13ea0b2
--- /dev/null
+++ b/lib/hrm/rollback-readiness.ts
@@ -0,0 +1,33 @@
+/**
+ * HRM patch 0039: at each update check (3:30 AM and 3:30 PM), confirm that every app's previous
+ * installer still downloads, so Go back to previous version (patch 0037) works when it's needed.
+ * A light check only (no download); Check installer now compares the checksum on request.
+ */
+import { checkInstallerReachable, type CheckOptions } from './installer-check';
+
+const CONCURRENCY = 4;
+const RUN_BUDGET_MS = 60000;
+
+export async function runSqliteRollbackReadinessCheck(options: CheckOptions = {}): Promise<{ checked: number; missing: number; unreachable: number }> {
+  const { sqliteAppInsights, sqliteRollbacks, sqliteRollbackReadiness, sqliteRetirements } = await import('@/lib/db/sqlite');
+  // Copies retired and deleted from Intune (patch 0038) can't go back.
+  const deployments = sqliteAppInsights.tracked().filter((d) => sqliteRetirements.latest(d.tenantId, d.appId)?.phase !== 'deleted').sort((a, b) => (sqliteRollbackReadiness.get(a.tenantId, a.appId)?.checked_at ?? '').localeCompare(sqliteRollbackReadiness.get(b.tenantId, b.appId)?.checked_at ?? ''));
+  const result = { checked: 0, missing: 0, unreachable: 0 };
+  let next = 0;
+  const deadline = Date.now() + RUN_BUDGET_MS;
+  const worker = async () => {
+    while (next < deployments.length && Date.now() < deadline) {
+      const d = deployments[next++];
+      const previous = sqliteRollbacks.previousJob(d.tenantId, d.wingetId, d.version, d.appId);
+      if (!previous?.installer_url) { sqliteRollbackReadiness.remove(d.tenantId, d.appId); continue; }
+      const reach = await checkInstallerReachable(previous.installer_url, { timeoutMs: 5000, ...options });
+      sqliteRollbackReadiness.record({ tenant_id: d.tenantId, app_id: d.appId, previous_job_id: previous.id, previous_version: previous.version,
+        status: reach.status, detail: reach.detail, checked_at: new Date().toISOString() });
+      result.checked++;
+      if (reach.status === 'missing') result.missing++;
+      if (reach.status === 'unreachable') result.unreachable++;
+    }
+  };
+  await Promise.all(Array.from({ length: CONCURRENCY }, worker));
+  return result;
+}
