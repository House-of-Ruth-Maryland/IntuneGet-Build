+    const fetchImpl = vi.fn().mockResolvedValue(new Response(null, { status: 302, headers: { location: 'https://127.0.0.1/secret' } }));
+    expect((await checkInstallerReachable(url, { lookup, fetchImpl })).status).toBe('unreachable');
+    expect(fetchImpl).toHaveBeenCalledTimes(1);
+    expect((await checkInstallerReachable('http://download.example.test/app', { lookup, fetchImpl })).status).toBe('unreachable');
+    expect(fetchImpl).toHaveBeenCalledTimes(1);
+  });
+  it('distinguishes gone files from temporary failures and falls back from HEAD', async () => {
+    const fetchImpl = vi.fn().mockResolvedValueOnce(new Response(null, { status: 405 })).mockResolvedValueOnce(new Response('x', { status: 206 }));
+    expect((await checkInstallerReachable(url, { lookup, fetchImpl })).status).toBe('ready');
+    expect(fetchImpl.mock.calls[1][1]).toMatchObject({ method: 'GET', headers: { Range: 'bytes=0-0' } });
+    for (const [status, result] of [[404, 'missing'], [410, 'missing'], [503, 'unreachable']] as const) {
+      expect((await checkInstallerReachable(url, { lookup, fetchImpl: vi.fn().mockResolvedValue(new Response(null, { status })) })).status).toBe(result);
+    }
+  });
+  it('compares actual bytes and stops oversized downloads', async () => {
+    const digest = createHash('sha256').update('installer').digest('hex');
+    const fetchImpl = vi.fn(async (_url, init) => new Response(init?.method === 'HEAD' ? null : 'installer')) as typeof fetch;
+    expect((await verifyInstallerChecksum(url, digest, { lookup, fetchImpl })).status).toBe('match');
+    expect((await verifyInstallerChecksum(url, 'a'.repeat(64), { lookup, fetchImpl })).status).toBe('mismatch');
+    expect((await verifyInstallerChecksum(url, digest, { lookup, fetchImpl, maxBytes: 2 })).status).toBe('unreachable');
+  });
+  it('does not let a bad redirect throw out the scheduled run', async () => {
+    expect((await checkInstallerReachable(url, { lookup, fetchImpl: vi.fn().mockResolvedValue(new Response(null, { status: 302, headers: { location: 'https://[' } })) })).status).toBe('unreachable');
+  });
+});
