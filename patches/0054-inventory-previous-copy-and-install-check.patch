diff --git a/lib/hrm/__tests__/previous-copies.test.ts b/lib/hrm/__tests__/previous-copies.test.ts
new file mode 100644
index 000000000..a2d030d5d
--- /dev/null
+++ b/lib/hrm/__tests__/previous-copies.test.ts
@@ -0,0 +1,51 @@
+// HRM patch 0054: Inventory's "Previous copy" label.
+import { describe, expect, it } from 'vitest';
+import type { UploadHistoryRecord } from '@/lib/db/types';
+import { findPreviousCopies } from '../previous-copies';
+import { previousCopyText, waitingForCleanup } from '../previous-copy-text';
+
+const A = '00000000-0000-0000-0000-00000000000a';
+const B = '00000000-0000-0000-0000-00000000000b';
+const C = '00000000-0000-0000-0000-00000000000c';
+const row = (id: string, appId: string, version: string, deployedAt: string, extra: Partial<UploadHistoryRecord> = {}): UploadHistoryRecord => ({
+  id, packaging_job_id: null, user_id: 'staff', winget_id: 'Example.Reader', version, display_name: 'Example Reader', publisher: null,
+  intune_app_id: appId, intune_app_url: null, intune_tenant_id: 'tenant-one', app_source: null, deployed_at: deployedAt, ...extra,
+});
+const options = { autoRemove: () => true, kept: new Map<string, string>() };
+
+describe('previous copies', () => {
+  it('marks each older copy with the copy that replaced it and when cleanup may remove it', () => {
+    const copies = findPreviousCopies([
+      row('3', C, '3.0', '2026-11-05T10:00:00Z'),
+      row('2', B, '2.0', '2026-11-01 10:00:00'),
+      row('1', A, '1.0', '2026-10-01T10:00:00Z'),
+      row('0', A, '1.0', '2026-09-01T10:00:00Z'),
+    ], 'tenant-one', options);
+    expect(copies).toEqual([
+      { appId: A, version: '1.0', replacedByVersion: '2.0', replacedAt: '2026-11-01T10:00:00.000Z', removeAfter: '2026-11-08T10:00:00.000Z', kept: null },
+      { appId: B, version: '2.0', replacedByVersion: '3.0', replacedAt: '2026-11-05T10:00:00.000Z', removeAfter: '2026-11-12T10:00:00.000Z', kept: null },
+    ]);
+  });
+
+  it('only looks at this tenant, and leaves out apps being removed and removal copies', () => {
+    expect(findPreviousCopies([row('2', B, '2.0', '2026-11-01T10:00:00Z', { intune_tenant_id: 'other' }), row('1', A, '1.0', '2026-10-01T10:00:00Z')], 'tenant-one', options)).toEqual([]);
+    expect(findPreviousCopies([row('2', B, '2.0', '2026-11-01T10:00:00Z', { display_name: 'Example Reader (uninstall only)' }), row('1', A, '1.0', '2026-10-01T10:00:00Z')], 'tenant-one', options)).toEqual([]);
+  });
+
+  it('carries cleanup\'s kept reason, and says nothing about removal when cleanup never removes the app', () => {
+    const history = [row('2', B, '2.0', '2026-11-01T10:00:00Z'), row('1', A, '1.0', '2026-10-01T10:00:00Z')];
+    const [kept] = findPreviousCopies(history, 'tenant-one', { autoRemove: () => true, kept: new Map([[A, 'This copy has a group the newest copy doesn\'t.']]) });
+    expect(waitingForCleanup(kept)).toBe(false);
+    expect(previousCopyText(kept).join(' ')).toMatch(/^Previous copy\. Replaced by v2\.0 on (Oct 31|Nov 1), 2026\. Kept: This copy has a group/);
+    const [manual] = findPreviousCopies(history, 'tenant-one', { autoRemove: () => false, kept: new Map([[A, 'ignored']]) });
+    expect(manual).toMatchObject({ removeAfter: null, kept: null });
+    expect(waitingForCleanup(manual)).toBe(false);
+    expect(previousCopyText(manual)).toHaveLength(2);
+  });
+
+  it('says the copy is removed automatically when cleanup is due to remove it', () => {
+    const [copy] = findPreviousCopies([row('2', B, '2.0', '2026-11-01T10:00:00Z'), row('1', A, '1.0', '2026-10-01T10:00:00Z')], 'tenant-one', options);
+    expect(waitingForCleanup(copy)).toBe(true);
+    expect(previousCopyText(copy)[2]).toBe("Removed automatically after 7 days if it's safe.");
+  });
+});
