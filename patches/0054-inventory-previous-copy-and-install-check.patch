+// HRM patch 0054: copies IntuneGet has replaced in this tenant, for Inventory's "Previous copy" label.
+// Versions, dates and cleanup's kept reason only. Read-only: no Intune calls.
+
+import { NextRequest, NextResponse } from 'next/server';
+import { parseAccessToken } from '@/lib/auth-utils';
+import { getDatabase, isSqliteMode } from '@/lib/db';
+import { findPreviousCopies } from '@/lib/hrm/previous-copies';
+
+const reply = (body: unknown, status = 200) => NextResponse.json(body, { status, headers: { 'Cache-Control': 'private, no-store' } });
+
+export async function GET(request: NextRequest) {
+  const user = await parseAccessToken(request.headers.get('Authorization'));
+  if (!user) return reply({ error: 'Authentication required' }, 401);
+  try {
+    const history = await getDatabase().uploadHistory.listAll(2000);
+    // Old-copy cleanup (patch 0042) runs in SQLite mode only, unless HRM_OLD_COPY_CLEANUP=off.
+    const cleanup = isSqliteMode() && process.env.HRM_OLD_COPY_CLEANUP?.trim().toLowerCase() !== 'off';
+    const store = cleanup ? (await import('@/lib/db/sqlite')).sqliteOldCopies : null;
+    const kept = new Map((store?.kept(user.tenantId) ?? []).map((row) => [row.app_id.toLowerCase(), row.reason || 'Listed under Needs attention on Home.']));
+    const copies = findPreviousCopies(history, user.tenantId, {
+      autoRemove: (wingetId) => Boolean(store) && !store!.startupFamily(user.tenantId, wingetId),
+      kept,
+    });
+    return reply({ copies });
+  } catch {
+    return reply({ error: 'Could not load previous copies. Try again.' }, 500);
+  }
+}
