+import { GET } from './route';
+
+const A = '00000000-0000-0000-0000-00000000000a';
+const B = '00000000-0000-0000-0000-00000000000b';
+const row = (id: string, appId: string, version: string, deployedAt: string) => ({
+  id, user_id: 'staff', winget_id: 'Example.Reader', version, display_name: 'Example Reader', intune_app_id: appId, intune_tenant_id: 'tenant-one', deployed_at: deployedAt,
