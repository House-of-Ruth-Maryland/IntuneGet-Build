diff --git a/hooks/usePreviousCopies.ts b/hooks/usePreviousCopies.ts
new file mode 100644
index 000000000..76b441bc1
--- /dev/null
+++ b/hooks/usePreviousCopies.ts
@@ -0,0 +1,30 @@
+'use client';
+
+// HRM patch 0054: copies IntuneGet has replaced, by lowercase Intune app ID, from /api/hrm/previous-copies.
+
+import { useQuery } from '@tanstack/react-query';
+import { useMicrosoftAuth } from '@/hooks/useMicrosoftAuth';
+import type { PreviousCopy } from '@/lib/hrm/previous-copy-text';
+
+export function usePreviousCopies() {
+  const { getAccessToken, isAuthenticated } = useMicrosoftAuth();
+  return useQuery<Map<string, PreviousCopy>>({
+    queryKey: ['hrm', 'previous-copies'],
+    queryFn: async () => {
+      const token = await getAccessToken();
+      if (!token) throw new Error('Not authenticated');
+      const response = await fetch('/api/hrm/previous-copies', { headers: { Authorization: `Bearer ${token}` } });
+      if (!response.ok) throw new Error('Failed to load previous copies');
+      const { copies } = (await response.json()) as { copies: PreviousCopy[] };
+      return new Map(copies.map((copy) => [copy.appId.toLowerCase(), copy]));
+    },
+    enabled: Boolean(isAuthenticated),
+    staleTime: 60 * 1000,
+  });
+}
+
+/** One app's entry, or undefined when it isn't a previous copy (or the list hasn't loaded). */
+export function usePreviousCopy(appId: string | null | undefined) {
+  const { data } = usePreviousCopies();
+  return appId ? data?.get(appId.toLowerCase()) : undefined;
+}
